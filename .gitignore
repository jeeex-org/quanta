# Quanta repo: ignore EVERYTHING unless explicitly allowed.
#
# Only these are tracked on the remote:
#   README.md   - project readme (root only)
#   .gitignore  - this file
#   compiler/   - the Quanta self-hosting source + promoted binaries
#   docs/       - documentation
#   lib/        - standard library source
#
# Everything else is internal/local and must NOT be pushed:
#   systems/ agents/ bootstrap/ test_suites/ tools/ scripts/ bin/ src/
#   .github/ .hyperresearch/ .claude/ scratch/ temp/ and all junk.

/*

# --- explicitly ALLOWED ---
!.gitignore
!README.md
!/compiler/
!/docs/
!/lib/
!/tree-sitter-quanta/

# --- internal / local-only (never pushed) ---
systems/
agents/
bootstrap/
test_suites/
tools/
scripts/
.hyperresearch/
.claude/
scratch/
temp/

# --- EXCEPTIONS: CI gate inputs must be tracked (blanket-ignore landmine fix) ---
# The gate (test_suites/scripts/run_tests.sh, invoked by ci.yml) reads these paths.
# Previously force-added ad-hoc per regression (c899044, e5173a4, 350a4a9); now
# permanently allowed so a new test source can never be silently dropped from CI.
!test_suites/codes/
!test_suites/EXPECTED.tsv
!test_suites/EXTERN_EXPECTED.tsv
!test_suites/EXPECTED_STDLIB.tsv
!test_suites/scripts/
!scripts/quanta_run.sh
!tools/fuzz/fuzz_qc.py
!tools/diff_test/diff_qc.py

# --- junk ---
vgcore.*
*.core
*.bin
qfio_test.bin
raw.txt
rt.txt
ergz_pass_placeholder

# compiler-specific: keep compiler/<VER>/src/ (SOURCE ONLY) + STATE.md + bin/ tracked.
# src/ must contain SOURCE ONLY — never binaries. bin/ holds the promoted seed
# (rebuilt by CI from src/) and IS tracked. debug/ is in /tmp, never in repo.
# STATE.md is the per-version release record — TRACKED (do NOT ignore).
compiler/**/debug/      # debug is in /tmp, never in repo; removed after problem solved
qc_boot
qc_self
qc_boot_n
qc_self2
qc_a
qc_b
qc055
qc055b
qc_dbg*
*.sym
*.log
s1.log
s2.log
s3.log
