// lib/std/gguf_mm.quanta -- bounded, descriptor-driven matvec for LFM2.
//
// WHY THIS FILE EXISTS
// --------------------
// The obvious implementation -- dequantize a weight tensor to f64, then matvec --
// needs 20.1 GB for this model, and the binary runs under MemoryMax=6G. So the
// weights are NEVER fully materialised. Every matvec here walks the tensor ROW BY
// ROW, dequantizes one row, accumulates, and reuses the same buffer.
//
// Peak cost is set by the widest single row, not by the tensor:
//
//     ffn_gate/up   2048 x 10752   row = 10752 f64 =  84 KB
//     attn_q/out    2048 x  2048   row =  2048 f64 =  16 KB
//     token_embd       1 x 128000  row = 128000 f64 = 1 MB
//
// 1 MB worst case, paid once, not per layer.
//
// MEMORY ACCESS CONVENTION (the part that is easy to get wrong)
// -------------------------------------------------------------
// A Quanta pointer is a raw address, not an array. Pointer arguments are read
// with mem_load(p + i * 8) wrapped in f64of(), and written with
// mem_store(p + i * 8, v). Writing `p[i]` -- or indexing a module GLOBAL this
// module allocated -- compiles to something that faults at run time. Every
// function below follows the shape of gguf_matvec() in gguf.quanta, which is the
// reference implementation.
//
// mem_alloc inside a loop is unsafe: the next iteration clobbers the pointer, so
// every buffer is allocated once in mm_init() and reused.

import std/gguf
// The folded fused Q4_K dequant-dot kernel (opt-in, see mm_fused_q4k below).
// jit_x86_fused.quanta does NOT import jit_x86 itself -- every TU that uses it
// imports both (see tests/jit_fold_dispatch_test.quanta), so both are imported
// here. Importing jit_x86 pulls in its emitter cursor globals; imports are
// deduped per module path, so a TU that also imports std/jit_x86 directly gets
// one copy.
import std/jit_x86
import std/jit_x86_fused

let mm_rowcap = 0       // f64 elements per row, rounded up to a power of two
let mm_rowbuf = 0       // f64 scratch for one dequantized row
let mm_rowraw = 0       // raw quantized bytes for one row
let mm_rowraw_cap = 0

// Element ceiling for mm_load_small(), i.e. the largest tensor that may be
// materialized whole. Kept small on purpose: the point of the row-wise path is
// that nothing this big is ever dequantized at once.
let mm_small_cap = 8388608

fn mm_init(maxcols) {
    if mm_rowbuf != 0 { return 0 }
    let c = 1024
    while c < maxcols { c = c * 2 }
    mm_rowcap = c
    mm_rowbuf = mem_alloc(c * 8)
    // Raw buffer must hold the WIDEST per-element encoding: Q8_K is 292 bytes per
    // 256 elements (1.14 bytes/elem). 2 bytes/elem truncates a Q8_K row.
    mm_rowraw = mem_alloc(c * 2 + 4096)
    mm_rowraw_cap = c * 2 + 4096
    return 0
}

// Bytes for one row of `ncols` elements at `dtype`.
//
// (elements_per_block, bytes_per_block) from the table in gguf.quanta, itself
// derived from upstream ggml-common.h's static_asserts. The K-quants are NOT
// 18/22 per 256 elements: Q4_K is 144 and Q5_K is 176. A wrong size reads a
// fraction of the row, or past it.
fn mm_row_bytes(dtype, ncols) {
    if dtype == 0  { return ncols * 4 }        // F32
    if dtype == 1  { return ncols * 2 }        // F16
    if dtype == 30 { return ncols * 2 }        // BF16: 2 bytes/elem, not a 256 block
    if dtype == 2  { return (ncols / 32) * 18 }
    if dtype == 3  { return (ncols / 32) * 20 }
    if dtype == 6  { return (ncols / 32) * 22 }
    if dtype == 7  { return (ncols / 32) * 24 }
    if dtype == 8  { return (ncols / 32) * 34 }
    if dtype == 10 { return (ncols / 256) * 84 }
    if dtype == 11 { return (ncols / 256) * 110 }
    if dtype == 12 { return (ncols / 256) * 144 }
    if dtype == 13 { return (ncols / 256) * 176 }
    if dtype == 14 { return (ncols / 256) * 210 }
    if dtype == 15 { return (ncols / 256) * 292 }
    return 0
}

// Read + dequantize row `r` of tensor `idx` into mm_rowbuf. 0 on success.
fn mm_load_row(idx, r, row_elems) {
    let dtype = gguf_tensor_dtype(idx)
    let rb = mm_row_bytes(dtype, row_elems)
    if rb <= 0 || rb > mm_rowraw_cap { return -1 }
    // gguf_read_tensor_bytes_at returns the BYTE COUNT, not a status. Requiring an
    // exact match distinguishes a whole row from a short read; accepting a short
    // one dequantizes a partly-stale buffer into a plausible wrong answer.
    if gguf_read_tensor_bytes_at(idx, r * rb, mm_rowraw, rb) != rb { return -2 }
    if read_block_f64(dtype, mm_rowraw, row_elems, mm_rowbuf) == 0 { return -3 }
    return 0
}

// ---- chunked reads: TRIED, MEASURED SLOWER, NOT USED -------------------------
//
// Hypothesis: the row-at-a-time path costs ~99 s/token because a 2048x2048
// tensor is 2048 separate pread() calls of 2 KB each (~600k syscalls per token),
// so reading blocks of rows should amortise the syscall overhead.
//
// MEASURED: it does not help. Block reads made a token SLOWER (114 s vs 99-103 s
// baseline), because a 256 KB f64 block thrashes L2 where a 16 KB single row
// stays resident in L1.
//
// The real bottleneck is neither syscalls nor dequantisation:
//   - dequantising a whole 4.2M-element tensor takes 0.63 s
//   - one [2048 x 10752] ffn_gate matvec takes 1.51 s, of which ~0.9 s is the
//     inner dot-product loop: 22M MACs at ~25M MACs/s
// So the cost is the SCALAR f64 inner loop in the matvec, and llama.cpp runs the
// same model at ~110 tok/s because its dot products are vectorised.
//
// The fix is therefore SIMD/blocked dot products, not I/O. This function is kept
// because it is correct and bit-identical to mm_matvec (verified: mismatches=0 on
// a real Q4_K tensor), and it is the right shape for a vectorised dequant+dot --
// but do NOT switch the forward pass onto it expecting a speedup; that was tried
// and measured negative.
//
// Dequantization is bit-identical to the row path: both call the same
// read_block_f64 on the same bytes. That is what lets the existing
// mm test (which compares against the full-dequantize reference) still hold.

let mm_blk_elems = 32768      // elements per block, must be >= widest row
let mm_blk_raw = 0            // raw bytes for one block
let mm_blk_raw_cap = 0
let mm_blk_f64 = 0            // dequantized block, f64
let mm_blk_ready = 0

fn mm_blk_init(cols) {
    if mm_blk_ready != 0 && mm_blk_elems >= cols { return 0 }
    // block size = a whole number of rows where possible, so a block never
    // splits a row across two reads.
    let e = cols
    while e < 32768 { e = e + cols }
    mm_blk_elems = e
    mm_blk_raw = mem_alloc(e * 2 + 4096)
    mm_blk_raw_cap = e * 2 + 4096
    mm_blk_f64 = mem_alloc(e * 8)
    mm_blk_ready = 1
    return 0
}

// y = W x, reading `cols`-wide rows in blocks of mm_blk_elems.
//
// Same contract as mm_matvec. Falls back to the row path if the block buffers
// cannot be sized (a row wider than the cap).
fn mm_matvec_blk(idx: u64, x: u64, rows: i64, cols: i64, y: u64) {
    let dtype = gguf_tensor_dtype(idx)
    if gguf_dtype_supported(dtype) == 0 { return -1 }
    if mm_rowcap < cols { return -1 }
    let row_elems = gguf_tensor_nelements(idx) / rows
    if row_elems != cols { return -1 }
    if mm_blk_init(cols) != 0 { return mm_matvec(idx, x, rows, cols, y) }

    let rb = mm_row_bytes(dtype, cols)          // bytes per row
    if rb <= 0 { return -1 }
    let rows_per_blk = mm_blk_elems / cols
    if rows_per_blk <= 0 { return mm_matvec(idx, x, rows, cols, y) }

    let r0 = 0
    while r0 < rows {
        let nb = rows - r0
        let n = 0
        if nb < rows_per_blk { n = nb } else { n = rows_per_blk }
        let want = n * rb
        if want > mm_blk_raw_cap { return mm_matvec(idx, x, rows, cols, y) }
        // ONE pread for the whole block
        if gguf_read_tensor_bytes_at(idx, r0 * rb, mm_blk_raw, want) != want { return -2 }
        // ONE dequantize call for the whole block
        let elems = n * cols
        if read_block_f64(dtype, mm_blk_raw, elems, mm_blk_f64) == 0 { return -3 }

        let k = 0
        while k < n {
            let base = k * cols
            mem_store(y + (r0 + k) * 8, mm_dot4(mm_blk_f64 + base * 8, x, cols))
            k = k + 1
        }
        r0 = r0 + n
    }
    return 0
}

// ---- row-parallel matvec -------------------------------------------------
//
// Workers take DISJOINT STATIC ROW SLICES. That is not a convenience: Quanta has
// no atomics, so a work-stealing counter would race (measured 931/2048 rows
// wrong). Static slices make the partition contention-free and deterministic.
//
// Every worker uses mm_load_row_s / mm_dot4_s, which touch no module global, so
// the only shared state is `y`, and each row of `y` is written by exactly one
// worker.
//
// State is read from module globals here because the parent fills them BEFORE
// creating any thread; the workers only read. That ordering is what makes it
// safe -- there is no concurrent writer.
let pm_idx = 0
let pm_x = 0
let pm_rows = 0
let pm_cols = 0
let pm_y = 0
let pm_nworkers = 0

fn pm_worker(t: i64) -> i64 {
    // one scratch set per worker, allocated once and reused for every row
    let cell = mm_scratch_new(pm_cols)
    let per = pm_rows / pm_nworkers
    let lo = t * per
    let hi = lo + per
    // the last worker absorbs the remainder so no row is left unowned
    if t == pm_nworkers - 1 { hi = pm_rows }
    if hi > pm_rows { hi = pm_rows }

    let r = lo
    while r < hi {
        if mm_load_row_s(pm_idx, r, pm_cols, cell) != 0 { return -1 }
        mem_store(pm_y + r * 8, mm_dot4_s(mem_load(cell + 8), pm_x, pm_cols, mem_load(cell + 16)))
        r = r + 1
    }
    return hi - lo
}

// mm_matvec_par(idx, x, rows, cols, y, nworkers) -> 0 on success.
// One output element per row, exactly as the serial path.
//
// WORKER POOL, NOT PER-CALL THREADS (see the pool section below for why):
// thread_create() maps a fresh 1 MB child stack per call and thread_join()
// never unmaps it, so one thread per worker per matvec leaked ~1 MB per worker
// per matvec -- measured 2329 clone() calls inside ONE 30-layer forward, i.e.
// ~2.3 GB of address space. The pool spawns the workers ONCE and feeds them
// jobs, so a forward costs one set of stacks instead of thousands.
fn mm_matvec_par(idx: u64, x: u64, rows: i64, cols: i64, y: u64, nworkers: i64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if rows <= 0 || cols <= 0 { return -1 }
    if nworkers <= 1 { return mm_matvec_blk(idx, x, rows, cols, y) }
    let per = rows / nworkers
    if per < 1 { return mm_matvec_blk(idx, x, rows, cols, y) }

    // FAIL CLOSED for the opt-in fused route: emit the folded kernel ONCE here
    // (main thread, before any worker sees the flag) and clear mm_fused_q4k if
    // the RWX mapping is refused, so pl_run_rows_map never dispatches into a
    // null code pointer on a box without executable anonymous memory.
    if mm_fused_q4k != 0 {
        if jit_f_setup_folded() != 0 { mm_fused_q4k = 0 }
    }
    if mm_fused_q6k != 0 {
        if jit_f_setup_folded_q6k() != 0 { mm_fused_q6k = 0 }
    }

    // zero y so a worker that fails leaves a detectable value rather than
    // whatever was there before
    let r = 0
    while r < rows { mem_store(y + r * 8, 0.0); r = r + 1 }

    // kind 4 = the mmap row path (bit-identical to kind 0, no pread): used only
    // when mm_attach_mmap() has mapped the file and the dtype is one the raw
    // dequantiser supports (Q4_K / Q6_K -- the only matvec dtypes in this model).
    let mmdt = gguf_tensor_dtype(idx)
    if mm_map_base != 0 && (mmdt == 12 || mmdt == 14) { pl_kind = 4 } else { pl_kind = 0 }
    pl_idx = idx
    pl_x = x
    pl_rows = rows
    pl_cols = cols
    pl_y = y
    pl_nw = nworkers
    pl_active = nworkers
    // pl_cols MUST be set before mm_pool_ensure(): a worker allocates its
    // scratch cell from it at spawn time (mm_scratch_new(pl_cell_cols)).
    pl_cell_cols = cols
    if mm_pool_ensure(nworkers, cols) != 0 { return -1 }
    if pl_submit() != 0 { pl_kill(); return -1 }
    if pl_depth == 0 { mm_pool_end() }
    return 0
}

// y = W x. W is `rows` x `cols`; x holds cols f64 values, y receives rows.
// Worker count for mm_matvec. 0 or 1 means the serial path, which is the
// default so nothing changes for callers that do not opt in.
//
// Set this once at startup (e.g. mm_set_workers(8)) and every mm_matvec call
// site in the forward pass benefits at once -- there are ten of them and they
// all funnel through here. Leaving it 0 keeps the serial path byte-identical to
// before, which is what makes this safe to land first and tune later.
//
// RESOURCE POLITENESS: mm_set_workers now CLAMPS to a polite ceiling -- see the
// block below. A caller that asks for every core gets half of them (at most 8)
// unless it takes one of the explicit escapes. The escape for a benchmark is
// mm_set_workers_uncapped(n) or the QUANTA_MM_* env vars; the escape for the
// per-call row matvec is mm_matvec_par(idx,x,rows,cols,y,nw) itself, whose
// explicit `nw` is deliberately NOT clamped (the A9 gate row depends on it).
let mm_workers = 0
let mm_embed_workers = 0

// ===========================================================================
// FUSED Q4_K DEQUANT-DOT ROUTE -- opt-in, DEFAULT OFF
// ===========================================================================
// When mm_fused_q4k != 0, the mmap row-workers (pool kind 4, pl_run_rows_map --
// the route the decode path actually takes, see the note there) compute a Q4_K
// row dot with the JIT'd register-resident kernel `jit_f_apply_folded()`
// instead of `mm_deq_row_raw` + `mm_dot4_s`. The f64 dequantised row is never
// materialised. Bit-identical to the existing pair by construction (same four
// lanes, same accumulation order, same in-kernel factor arithmetic) and diffed
// element-wise per tensor in tests/lfm2_fused_route_probe.quanta.
//
// COVERAGE, stated not implied: only dtype 12 (Q4_K) rows are fused by THIS
// flag. Q6_K (14) has its own twin and its own flag (mm_fused_q6k below), and
// the tied output projection (token_embd.weight, Q6_K, pool kind 5) is fused by
// NEITHER -- see the coverage note beside mm_fused_q6k. From the model's own
// GGUF header, per-token matvec elements are Q4_K 2,122,317,824 (78.69%) and
// Q6_K 574,619,648 (21.30%).
//
// FAIL CLOSED: mm_matvec_par calls jit_f_setup_folded() before any worker runs
// and clears this flag if the RWX mapping is refused, so a box without
// executable anonymous memory silently keeps the existing path rather than
// trapping in a worker.
let mm_fused_q4k = 0
// Sticky evidence flag: set (to 1) by any worker that took the fused branch.
// All writers store the same value, so the racy multi-writer store is benign
// and reading it after pl_submit() proves the fused route actually executed.
let mm_fused_used = 0

fn mm_set_fused_q4k(n) {
    if n < 0 { n = 0 }
    if n != 0 { n = 1 }
    mm_fused_q4k = n
    // reset the witness so the next mm_matvec call reports whether THAT call
    // took the fused branch, not whether any earlier call did.
    mm_fused_used = 0
    return 0
}

fn mm_get_fused_q4k() { return mm_fused_q4k }
fn mm_get_fused_used() { return mm_fused_used }

// ===========================================================================
// FUSED Q6_K DEQUANT-DOT ROUTE -- opt-in, DEFAULT OFF, INDEPENDENT of Q4_K
// ===========================================================================
// The folded Q6_K twin (jit_f_build_folded_q6k) is wired into the SAME pool
// kind 4 / pl_run_rows_map branch, for dtype 14. It is a SEPARATE flag rather
// than folded into mm_fused_q4k for three reasons:
//   1. A/B: the measurement that matters is "Q4_K only" vs "Q4_K + Q6_K", and
//      one flag cannot express that (tests/lfm2_decode_bench.conf field 9).
//   2. Fail-closed is per kernel: each flag is cleared only if ITS OWN kernel
//      is refused an RWX region, so a box that can run one is never silently
//      recorded as running the other.
//   3. A defect confined to one dtype can be disabled without losing the other.
//
// COVERAGE, stated not implied. This route fuses the EIGHTEEN Q6_K tensors that
// go through mm_matvec (14 ffn_down [10752,2048] + 4 attn_v [2048,512]) =
// 312,475,648 elements. It does NOT touch token_embd.weight [2048,128000]
// (262,144,000 elements), the tied output projection: that is pool kind 5
// (pl_run_embed_map), whose reference dot is a strict left-to-right SCALAR
// chain, not mm_dot4_s's four lanes, so fusing it bit-exactly would first have
// to reproduce that chain. It stays on the existing path and is named here.
// With Q4_K also on, the fused pair covers 2,122,317,824 + 312,475,648 =
// 2,434,793,472 of 2,696,937,472 per-token matvec elements (90.28%); the
// un-fused remainder is token_embd (9.72%) plus the embedding lookup itself.
let mm_fused_q6k = 0
let mm_fused_q6k_used = 0

fn mm_set_fused_q6k(n) {
    if n < 0 { n = 0 }
    if n != 0 { n = 1 }
    mm_fused_q6k = n
    // reset the witness so the next mm_matvec call reports whether THAT call
    // took the fused Q6_K branch, not whether any earlier call did.
    mm_fused_q6k_used = 0
    return 0
}

fn mm_get_fused_q6k() { return mm_fused_q6k }
fn mm_get_fused_q6k_used() { return mm_fused_q6k_used }

// ===========================================================================
// RESOURCE POLITENESS -- the loader must never saturate the box unattended
// ===========================================================================
// THE COMPLAINT, as a design requirement: the SI loop runs this loader with no
// one watching. An unattended process that takes the whole machine makes it
// unusable for everything else -- llama.cpp does not, and this loader must not.
//
// MEASURED FIRST (tests/park_cpu_probe.quanta): a PARKED pool does NOT spin. With
// 8 workers spawned and no job ever submitted, every worker thread is in state S
// with wchan=futex_do_wait (/proc/<pid>/task/*/wchan), the process has 9 threads,
// and it costs 0.00% CPU over an 8 s park (external /proc/<pid>/stat sample: 0
// ticks; the probe's own read agrees). So the CPU a run takes is the CPU its
// workers SPEND, not CPU they burn waiting; the lever is the worker COUNT, not a
// wait loop.
//
// THE RULE. Any worker count the loader will USE through mm_set_workers /
// mm_set_embed_workers is capped at
//
//     min(cores/2, 8), floored at 1        -- the "polite ceiling"
//
// so an unattended caller that asks for every core gets half of them and never
// more than eight. cores is the process's AFFINITY mask (sched_getaffinity),
// which is right under a cpuset / taskset where /sys/devices/.../online is not.
//
// THE EXPLICIT ESCAPES (for a benchmark that genuinely wants the whole box):
//     mm_set_workers_uncapped(n)          -- set exactly n, no clamp
//     mm_set_embed_workers_uncapped(n)    -- ditto
//     QUANTA_MM_WORKERS=<n>               -- ceiling becomes n
//     QUANTA_MM_ALL_CORES=1               -- ceiling becomes every online core
// The env vars are read from /proc/self/environ BY HAND: getenv() is a STUB in
// this compiler (emitter.quanta:3879 -- "getenv is complex - for now return 0"),
// so it always returns 0 and cannot be used (this is the same reason
// lib/std/config.quanta reads a file instead).
//
// A HARD SANITY CEILING (MM_MAX_WORKERS) also guards mm_pool_ensure: no caller,
// clamped or not, can ask the pool to spawn an absurd number of threads.
let MM_MAX_WORKERS = 512

const MM_ENV_WORKERS = "QUANTA_MM_WORKERS"
const MM_ENV_ALL     = "QUANTA_MM_ALL_CORES"

let mm_hw_cores_cache = 0
let mm_ceiling_cache = 0

// CPUs this process may run on: popcount of sched_getaffinity(0, len, mask)
// (syscall 204). Falls back to /sys/devices/system/cpu/online, then to 8.
fn mm_hw_cores() -> i64 {
    if mm_hw_cores_cache > 0 { return mm_hw_cores_cache }
    let n = 0
    let mask = mem_alloc(128)
    if mask != 0 {
        let i = 0
        while i < 128 { mem_store8(mask + i, 0); i = i + 1 }
        if syscall(204, 0, 128, mask) > 0 {
            i = 0
            while i < 128 {
                let b = mem_load8(mask + i)
                let j = 0
                while j < 8 { if (b & (1 << j)) != 0 { n = n + 1 }; j = j + 1 }
                i = i + 1
            }
        }
    }
    if n < 1 {
        let fd = file_open("/sys/devices/system/cpu/online", 0)
        if fd >= 0 {
            let buf = mem_alloc(256)
            let got = read_raw(fd, buf, 256)
            file_close(fd)
            let hi = 0 - 1
            let k = 0
            while k < got {
                if mem_load8(buf + k) >= 48 && mem_load8(buf + k) <= 57 {
                    let v = 0
                    while k < got && mem_load8(buf + k) >= 48 && mem_load8(buf + k) <= 57 {
                        v = v * 10 + (mem_load8(buf + k) - 48); k = k + 1
                    }
                    if v > hi { hi = v }
                } else { k = k + 1 }
            }
            n = hi + 1
        }
    }
    if n < 1 { n = 8 }
    mm_hw_cores_cache = n
    return n
}

// Integer value of env var `key` (klen bytes; the string's bytes start at
// key + 8, past the 8-byte length header), or -1 if absent/unparseable. Reads
// /proc/self/environ directly because getenv is a stub.
fn mm_env_int(key, klen) -> i64 {
    let fd = file_open("/proc/self/environ", 0)
    if fd < 0 { return 0 - 1 }
    let buf = mem_alloc(32768)
    if buf == 0 { file_close(fd); return 0 - 1 }
    let got = read_raw(fd, buf, 32768)
    file_close(fd)
    if got <= 0 { return 0 - 1 }
    let i = 0
    while i + klen + 1 <= got {
        let ok = 1
        let j = 0
        while j < klen {
            if mem_load8(buf + i + j) != mem_load8(key + 8 + j) { ok = 0 }
            j = j + 1
        }
        if ok == 1 && mem_load8(buf + i + klen) == 61 {   // '='
            let p = i + klen + 1
            let v = 0
            let any = 0
            while p < got && mem_load8(buf + p) >= 48 && mem_load8(buf + p) <= 57 {
                v = v * 10 + (mem_load8(buf + p) - 48); any = 1; p = p + 1
            }
            if any == 1 { return v }
            return 0 - 1
        }
        i = i + 1
    }
    return 0 - 1
}

// The ceiling mm_set_workers applies. Computed once and cached (the env does not
// change mid-process, and the read allocates).
fn mm_worker_ceiling() -> i64 {
    if mm_ceiling_cache > 0 { return mm_ceiling_cache }
    let h = 0
    let w = mm_env_int(MM_ENV_WORKERS, 17)       // "QUANTA_MM_WORKERS" = 17 bytes
    if w > 0 {
        h = w
    } else {
        let a = mm_env_int(MM_ENV_ALL, 19)       // "QUANTA_MM_ALL_CORES" = 19 bytes
        if a > 0 {
            h = mm_hw_cores()
        } else {
            h = mm_hw_cores() / 2
            if h > 8 { h = 8 }
        }
    }
    if h < 1 { h = 1 }
    if h > MM_MAX_WORKERS { h = MM_MAX_WORKERS }
    mm_ceiling_cache = h
    return h
}

// The polite ceiling, exposed for tests and for a caller that wants to enable
// parallelism "as much as is polite": mm_set_workers(mm_polite_ceiling()).
fn mm_polite_ceiling() -> i64 { return mm_worker_ceiling() }

fn mm_set_workers(n) {
    if n < 0 { n = 0 }
    if n > 1 {
        let cap = mm_worker_ceiling()
        if n > cap { n = cap }
    }
    mm_workers = n
    return 0
}

fn mm_set_embed_workers(n) {
    if n < 0 { n = 0 }
    if n > 1 {
        let cap = mm_worker_ceiling()
        if n > cap { n = cap }
    }
    mm_embed_workers = n
    return 0
}

// Explicit escape: set the worker count with NO politeness clamp (still bounded
// by the hard sanity ceiling). For a benchmark that wants the whole box.
fn mm_set_workers_uncapped(n) {
    if n < 0 { n = 0 }
    if n > MM_MAX_WORKERS { n = MM_MAX_WORKERS }
    mm_workers = n
    return 0
}

fn mm_set_embed_workers_uncapped(n) {
    if n < 0 { n = 0 }
    if n > MM_MAX_WORKERS { n = MM_MAX_WORKERS }
    mm_embed_workers = n
    return 0
}

fn mm_get_workers() { return mm_workers }

fn mm_matvec(idx: u64, x: u64, rows: i64, cols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < cols { return -1 }
    let row_elems = gguf_tensor_nelements(idx) / rows
    if row_elems != cols { return -1 }

    // Route to the row-parallel path when workers are enabled. It uses
    // mm_load_row_s / mm_dot4_s, which are the same reads and the same
    // arithmetic as the loop below -- same summation order, so results are
    // bit-identical, not merely close. Measured: 0 mismatches over all 10752
    // output rows at 1/2/4/8/16/20 workers, 5 repeat runs.
    if mm_workers > 1 {
        if rows / mm_workers >= 1 {
            return mm_matvec_par(idx, x, rows, cols, y, mm_workers)
        }
    }

    let r = 0
    while r < rows {
        if mm_load_row(idx, r, row_elems) != 0 { return -1 }
        // 4-wide via the AVX2 builtins. NOTE the summation order changes (4
        // partial lanes combined at the end) so this is not bit-identical to a
        // scalar left-to-right sum in general; see mm_dot4.
        mem_store(y + r * 8, mm_dot4(mm_rowbuf, x, cols))
        r = r + 1
    }
    return 0
}

// One embedding row -> y, as f64 values of length ncols.
//
// This MUST copy out of mm_rowbuf. mm_load_row() fills the SHARED scratch
// buffer mm_rowbuf and returns 0; it does not write the caller's destination.
// An earlier version returned mm_load_row()'s status directly, so `y` was never
// populated: every embedding came back as whatever the caller's buffer held
// (zeros), the whole stack then ran on a zero activation, and the logits came
// out all 0.000000 -- which looks like "the model produced nothing" rather than
// like a missing copy.
fn mm_lookup_row(idx: u64, row: i64, ncols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if mm_load_row(idx, row, ncols) != 0 { return -2 }
    let i = 0
    while i < ncols {
        mem_store(y + i * 8, f64of(mem_load(mm_rowbuf + i * 8)))
        i = i + 1
    }
    return 0
}

// y[v] = dot(embd_row(v0 + v), x) for v in [0, vcount).
//
// Reading all 128000 rows per token would dominate generation cost, so the caller
// chooses the window: a sampled shortlist while sampling, or the full vocabulary
// once a token is settled.
//
// When mm_embed_workers > 1, this routes to the parallel implementation
// (mm_embed_logits_par). The default is 0 (serial, byte-identical to before).
fn mm_embed_logits(idx: u64, x: u64, v0: i64, vcount: i64, ncols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if mm_embed_workers > 1 && vcount / mm_embed_workers >= 1 {
        return mm_embed_logits_par(idx, x, v0, vcount, ncols, y, mm_embed_workers)
    }

    let v = 0
    while v < vcount {
        if mm_load_row(idx, v0 + v, ncols) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < ncols {
            acc = acc + f64of(mem_load(mm_rowbuf + c * 8)) * f64of(mem_load(x + c * 8))
            c = c + 1
        }
        mem_store(y + v * 8, acc)
        v = v + 1
    }
    return 0
}

// ===========================================================================
// BATCHED EMBED-LOGITS -- B normed hidden vectors against ONE embedding row
// ===========================================================================
//
// Same idea as mm_matmul, and for the same reason: during prefill the tied
// output projection is only needed at the LAST position, so a batched prefill
// normally computes it once. A PROBE that wants the logits at EVERY position
// (tests/lfm2_prefill_probe.quanta does, to locate divergence) would otherwise
// pay 128000 row dequantisations per position.
//
// THE SUMMATION ORDER IS THE POINT. mm_embed_logits accumulates LEFT TO RIGHT
// (`acc = acc + a*b`), NOT through mm_dot4's 4-lane reduction. A batched version
// that used mm_dot4 would produce slightly different bits and the per-position
// logits would no longer be comparable, element for element, to the one-token
// path. So this keeps the scalar loop verbatim and only amortises the
// dequantisation -- the result is BIT-IDENTICAL to B calls of mm_embed_logits.

// y[(b * vcount + v)] = dot(embd_row(v0 + v), x_b)
fn mm_embed_logits_batch_ser(idx, x, v0, vcount, ncols, B, y) -> i64 {
    let v = 0
    while v < vcount {
        if mm_load_row(idx, v0 + v, ncols) != 0 { return -1 }
        let b = 0
        while b < B {
            let xb = x + b * ncols * 8
            let acc: f64 = 0.0
            let c = 0
            while c < ncols {
                acc = acc + f64of(mem_load(mm_rowbuf + c * 8)) * f64of(mem_load(xb + c * 8))
                c = c + 1
            }
            mem_store(y + (b * vcount + v) * 8, acc)
            b = b + 1
        }
        v = v + 1
    }
    return 0
}

// Worker slice for the batched embed-logits: byte-identical arithmetic to
// pl_run_embed, repeated for every activation vector in the batch.
fn pl_run_embed_b(t: i64, cell) {
    let per = pl_vcount / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_vcount }
    if hi > pl_vcount { hi = pl_vcount }
    let v = lo
    while v < hi {
        if mm_load_row_s(pl_idx, pl_v0 + v, pl_ncols, cell) != 0 { return -1 }
        let b = 0
        while b < pl_b {
            let xb = pl_x + b * pl_ncols * 8
            let acc: f64 = 0.0
            let c = 0
            while c < pl_ncols {
                acc = acc + f64of(mem_load(mem_load(cell + 8) + c * 8)) * f64of(mem_load(xb + c * 8))
                c = c + 1
            }
            mem_store(pl_y + (b * pl_vcount + v) * 8, acc)
            b = b + 1
        }
        v = v + 1
    }
    return hi - lo
}

fn mm_embed_logits_batch(idx, x, v0, vcount, ncols, B, y) -> i64 {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if B <= 0 || vcount <= 0 { return -1 }
    if B == 1 { return mm_embed_logits(idx, x, v0, vcount, ncols, y) }
    // Same guard-before-divide as mm_matmul: mm_embed_workers == 0 divides by zero.
    if mm_embed_workers <= 1 {
        return mm_embed_logits_batch_ser(idx, x, v0, vcount, ncols, B, y)
    }
    let per = vcount / mm_embed_workers
    if per < 1 {
        return mm_embed_logits_batch_ser(idx, x, v0, vcount, ncols, B, y)
    }

    let v = 0
    while v < vcount {
        let b0 = 0
        while b0 < B { mem_store(y + (b0 * vcount + v) * 8, 0.0); b0 = b0 + 1 }
        v = v + 1
    }

    pl_kind = 3
    pl_idx = idx
    pl_x = x
    pl_v0 = v0
    pl_vcount = vcount
    pl_ncols = ncols
    pl_b = B
    pl_y = y
    pl_nw = mm_embed_workers
    pl_active = mm_embed_workers
    pl_cell_cols = ncols
    if mm_pool_ensure(mm_embed_workers, ncols) != 0 { return -1 }
    if pl_submit() != 0 { pl_kill(); return -1 }
    if pl_depth == 0 { mm_pool_end() }
    return 0
}

// y[v] = dot(embd_row(v0 + v), x) for v in [0, vcount). PARALLEL version.
// Static row partitioning, same as mm_matvec_par. Each worker owns [lo, hi)
// and uses its own scratch so there is no shared state.
// The caller sets the global mm_embed_workers (default 0 = serial).
fn mm_embed_logits_par(idx: u64, x: u64, v0: i64, vcount: i64, ncols: i64, y: u64, nworkers: i64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if nworkers <= 1 || vcount <= 0 {
        return mm_embed_logits(idx, x, v0, vcount, ncols, y)
    }
    let per = vcount / nworkers
    if per < 1 {
        return mm_embed_logits(idx, x, v0, vcount, ncols, y)
    }

    // zero y so a worker failure leaves a detectable value
    let v = 0
    while v < vcount { mem_store(y + v * 8, 0.0); v = v + 1 }

    // job descriptor for the shared pool worker (module-level; the driver fills
    // it BEFORE the generation bump, and the fence in pl_submit orders the two)
    // kind 5 = mmap embed path: same left-to-right scalar dot (bit-identical),
    // rows read straight from the mapping.
    if mm_map_base != 0 && gguf_tensor_dtype(idx) == 14 { pl_kind = 5 } else { pl_kind = 1 }
    pl_idx = idx
    pl_x = x
    pl_v0 = v0
    pl_vcount = vcount
    pl_ncols = ncols
    pl_y = y
    pl_nw = nworkers
    pl_active = nworkers
    pl_cell_cols = ncols
    if mm_pool_ensure(nworkers, ncols) != 0 { return -1 }
    if pl_submit() != 0 { pl_kill(); return -1 }
    if pl_depth == 0 { mm_pool_end() }
    return 0
}

// Worker for mm_embed_logits_par: computes a slice of [v0, v0+vcount).
fn pem_worker(t: i64) -> i64 {
    let cell = mm_scratch_new(pem_ncols)
    let per = pem_vcount / pem_nworkers
    let lo = t * per
    let hi = lo + per
    if t == pem_nworkers - 1 { hi = pem_vcount }
    if hi > pem_vcount { hi = pem_vcount }

    let v = lo
    while v < hi {
        if mm_load_row_s(pem_idx, pem_v0 + v, pem_ncols, cell) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < pem_ncols {
            acc = acc + f64of(mem_load(mem_load(cell + 8) + c * 8)) * f64of(mem_load(pem_x + c * 8))
            c = c + 1
        }
        mem_store(pem_y + (pem_v0 + v) * 8, acc)
        v = v + 1
    }
    return hi - lo
}

// module globals for pem_worker
let pem_idx = 0
let pem_x = 0
let pem_v0 = 0
let pem_vcount = 0
let pem_ncols = 0
let pem_y = 0
let pem_nworkers = 0

// Load a WHOLE small tensor into `dst` as f64, using read_tensor_f64.
//
// For a tensor small enough to hold (the short-conv kernel is [3, 2048] = 6144
// elements, and out_proj is 4.2 M) this is simpler and cheaper than a matvec per
// output element. It is NOT a general escape hatch: read_tensor_f64 materializes
// the whole tensor, so calling it on an FFN weight is exactly the 20 GB problem
// this file exists to avoid. The caller must size-check first.
fn mm_load_small(idx: u64, expect: i64, dst: u64) {
    if expect <= 0 { return -1 }
    if gguf_tensor_nelements(idx) != expect { return -1 }
    if expect > mm_small_cap { return -1 }
    read_tensor_f64(idx, dst)
    return expect
}

// ===========================================================================
// 4-wide dot product using the AVX2 f64 builtins.
//
// MEASURED: 67.1 ms -> 22.7 ms over 2048x2048 (2.95x), and the accumulated sum
// came out BIT-IDENTICAL to the scalar path on this data.
//
// ⚠️ It is NOT bit-identical in general. The 4 partial lanes are summed at the
// end, which is a different summation ORDER from a left-to-right scalar sum, and
// float addition is not associative. It matched here because the values happen to
// be benign. Any test asserting exact equality against a scalar reference must
// tolerate this, and the comparison against llama.cpp (which also uses SIMD) is
// the real oracle.
//
// The accumulator must live in MEMORY, not a local: the builtins take pointers.
// Scratch is a module global allocated once -- mem_alloc inside the loop would be
// clobbered by the next iteration.
let mm_dot_acc = 0
let mm_dot_tmp = 0

// ---- per-thread scratch --------------------------------------------------
//
// mm_load_row, mm_dot4 and mm_matvec_blk all use the module globals above
// (mm_rowraw, mm_rowbuf, mm_blk_raw, mm_blk_f64, mm_dot_acc, mm_dot_tmp).
// That is fine for one thread and a race by construction for several: two
// workers dequantising into mm_rowbuf would interleave and every row would be a
// mix of both. Static partitioning does NOT help -- the buffers are shared even
// when the rows are not.
//
// So the *_s variants below take their scratch explicitly and touch no global.
// Each worker allocates its own set once and reuses it for every row, which is
// what makes them cheap enough to call per row.
//
// mm_scratch is a 4-word cell: [0]=raw, [8]=f64 row, [16]=dot acc/tmp pair,
// [24]=args area for the fused Q4_K kernel. Keeping it flat avoids a struct
// type in the calling convention.
//
// ONE ARGS AREA PER WORKER, NOT PER WORK ITEM -- and allocated HERE, at pool
// spawn, not per row. The fused kernel takes one row per call and reads a
// 4-qword argument area (W, X, DMD, nsuper) from rdi; W changes every row, X
// and nsuper are fixed for a whole matvec. So the worker owns one 32-byte area
// and rewrites W (one store) per row. A mem_alloc per row is the documented
// anti-pattern (the pointer is clobbered / it costs an allocation on ~1M rows
// per token) and a SHARED area would be exactly the cross-worker scratch race
// this file's *_s variants exist to avoid; an area per work item buys nothing
// because the worker is single-threaded and reuses its own area in sequence.
fn mm_scratch_new(maxcols) {
    let c = 1024
    while c < maxcols { c = c * 2 }
    let raw = mem_alloc(c * 2 + 4096)
    let f64b = mem_alloc(c * 8)
    // 512 bytes: mm_dot4_s needs 64 (4 lanes + tmp at +32); mm_dot8_s needs 128
    // (8 lanes at +0..63, 8 temps at +64..127). One region serves both -- only
    // one dot runs at a time per cell.
    let acc = mem_alloc(512)
    let cell = mem_alloc(32)
    let argp = mem_alloc(32)         // fused kernel args: [W, X, DMD, nsuper]
    mem_store(cell, raw)
    mem_store(cell + 8, f64b)
    mem_store(cell + 16, acc)
    mem_store(cell + 24, argp)
    return cell
}

// ---- scratch-taking variants of the hot primitives ----------------------

// mm_load_row_s(idx, r, row_elems, cell) == mm_load_row, using `cell` scratch.
// Byte-for-byte the same reads and the same dequant call as mm_load_row, so the
// output is identical -- only the destination buffer differs.
fn mm_load_row_s(idx, r, row_elems, cell) {
    let dtype = gguf_tensor_dtype(idx)
    let rb = mm_row_bytes(dtype, row_elems)
    let raw = mem_load(cell)
    let cap = row_elems * 2 + 4096
    if rb <= 0 || rb > cap { return -1 }
    if gguf_read_tensor_bytes_at(idx, r * rb, raw, rb) != rb { return -2 }
    if read_block_f64(dtype, raw, row_elems, mem_load(cell + 8)) == 0 { return -3 }
    return 0
}

// mm_dot4_s(a, b, n, acc) == mm_dot4 with an explicit accumulator buffer.
// Identical arithmetic and summation order -- the AVX2 builtin calls take
// pointers, so the only thing that changes is WHERE the lanes live.
fn mm_dot4_s(a: u64, b: u64, n: i64, acc) -> f64 {
    mem_store(acc, 0.0)
    mem_store(acc + 8, 0.0)
    mem_store(acc + 16, 0.0)
    mem_store(acc + 24, 0.0)

    let c = 0
    while c + 4 <= n {
        fmulf_avx2(acc + 32, a + c * 8, b + c * 8)
        faddf_avx2(acc, acc, acc + 32)
        c = c + 4
    }
    let s0: f64 = f64of(mem_load(acc)) + f64of(mem_load(acc + 8))
    let s1: f64 = f64of(mem_load(acc + 16)) + f64of(mem_load(acc + 24))
    let total: f64 = s0 + s1
    let t: f64 = total
    while c < n {
        t = t + f64of(mem_load(a + c * 8)) * f64of(mem_load(b + c * 8))
        c = c + 1
    }
    return t
}

fn mm_dot4(a: u64, b: u64, n: i64) -> f64 {
    if mm_dot_acc == 0 {
        mm_dot_acc = mem_alloc(32)
        mm_dot_tmp = mem_alloc(32)
    }
    mem_store(mm_dot_acc, 0.0)
    mem_store(mm_dot_acc + 8, 0.0)
    mem_store(mm_dot_acc + 16, 0.0)
    mem_store(mm_dot_acc + 24, 0.0)

    let c = 0
    while c + 4 <= n {
        fmulf_avx2(mm_dot_tmp, a + c * 8, b + c * 8)
        faddf_avx2(mm_dot_acc, mm_dot_acc, mm_dot_tmp)
        c = c + 4
    }
    // horizontal sum of the 4 lanes
    let s0: f64 = f64of(mem_load(mm_dot_acc)) + f64of(mem_load(mm_dot_acc + 8))
    let s1: f64 = f64of(mem_load(mm_dot_acc + 16)) + f64of(mem_load(mm_dot_acc + 24))
    let acc: f64 = s0 + s1
    // tail
    let t: f64 = acc
    while c < n {
        t = t + f64of(mem_load(a + c * 8)) * f64of(mem_load(b + c * 8))
        c = c + 1
    }
    return t
}

// ===========================================================================
// PERSISTENT WORKER POOL for the row-parallel matvecs
// ===========================================================================
//
// WHY THIS EXISTS (measured, not assumed)
// --------------------------------------
// The per-call design -- thread_create() nworkers times, then thread_join() --
// is CORRECT but leaks address space: thread_create() mmaps a fresh 1 MB child
// stack (plus a 24-byte, page-rounded join slot) per call and thread_join()
// never unmaps either. `strace -f -e trace=mmap,clone` over ONE 30-layer
// forward at 20 workers counted **2329 clone() calls** = ~2.3 GB of address
// space leaked per forward, and 20 worker scratch cells per matvec on top.
// Under a 4 GB address-space cap (1.67 GB model + heap) the leak exhausts the
// space mid-forward; the NEXT thread_create's 1 MB mmap returns ENOMEM, and the
// emitter's MAP_FAILED guard runs `mov edi,1; mov eax,60; syscall` -- exit(1)
// ON THE MAIN THREAD -- so the forward dies before the caller's next statement,
// silently: the process is reported as exited 0 (the worker threads of the
// group keep running and the group's final status comes out 0). That is the
// "dies after exactly one threaded forward, rc=0" defect.
//
// THE FIX: spawn the workers ONCE and feed them jobs. A forward then costs one
// set of stacks (nworkers) instead of 2329, and each worker allocates its
// scratch cell once instead of per matvec.
//
// PROTOCOL -- one job in flight; the driver (main thread) is the only writer of
// pl_gen, so no compare-and-swap is needed anywhere:
//
//   driver                         worker t
//   ------                         --------
//   fill pl_* job globals          loop:
//   fence()                          if *stop: exit loop
//   *gen = gen+1  (atomic_store)     g = *gen (atomic_load)
//   futex_wake(*gen)                 if g == last: futex_wait(*gen, last)
//   for each t:                      else: run its static slice;
//     wait done[t] == gen                  atomic_store(done[t], g); wake;
//                                          last = g
//
// done[t] is written by worker t ONLY and read by the driver, so there is no
// shared counter to race on. The driver sleeps in futex_wait (it does not spin,
// so it does not steal a core from the workers). futex_wait re-reads the word
// inside the kernel, so a wake that lands between the driver's load and a
// worker's wait is never lost.
//
// LIFETIME. `mm_pool_begin()` / `mm_pool_end()` nest by depth. The forward
// brackets one forward with them, so a caller that forgets anything still tears
// the pool down at the end of every forward and never hangs at process exit
// (the runtime ends main with exit(60), NOT exit_group(231), so a surviving
// worker thread WOULD hang the process). A generation loop can hold the pool
// across many forwards by calling mm_pool_begin() before the loop and
// mm_pool_end() after it -- then the stacks are paid once per process.
let pl_genp = 0          // ptr: job generation (driver writes, workers read)
let pl_stopp = 0         // ptr: 1 = tear the pool down
let pl_donep = 0         // ptr: nworkers completion stamps (done[t] = gen)
let pl_slots = 0         // ptr: nworkers join slots from thread_create
let pl_size = 0          // workers currently alive (0 = no pool)
let pl_depth = 0         // begin/end nesting depth
let pl_cell_cols = 0     // cols the live workers' scratch cells were sized for
let pl_kind = 0          // 0 = matvec rows, 1 = embedding logits
let pl_idx = 0
let pl_x = 0
let pl_rows = 0
let pl_cols = 0
let pl_y = 0
let pl_v0 = 0
let pl_vcount = 0
let pl_ncols = 0
let pl_b = 1              // matmul batch (tokens per row) -- pl_run_mm only
let pl_nw = 0            // active worker count for the current job
let pl_active = 0

// Static row slice, BYTE-IDENTICAL arithmetic to the old pm_worker: same reads
// (mm_load_row_s), same summation order (mm_dot4_s), same partition rule (the
// last worker absorbs the remainder).
fn pl_run_rows(t: i64, cell) {
    let per = pl_rows / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_rows }
    if hi > pl_rows { hi = pl_rows }
    let r = lo
    while r < hi {
        if mm_load_row_s(pl_idx, r, pl_cols, cell) != 0 { return -1 }
        mem_store(pl_y + r * 8, mm_dot4_s(mem_load(cell + 8), pl_x, pl_cols, mem_load(cell + 16)))
        r = r + 1
    }
    return hi - lo
}

// Static slice of [v0, v0+vcount), byte-identical to the old pem_worker.
fn pl_run_embed(t: i64, cell) {
    let per = pl_vcount / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_vcount }
    if hi > pl_vcount { hi = pl_vcount }
    let v = lo
    while v < hi {
        if mm_load_row_s(pl_idx, pl_v0 + v, pl_ncols, cell) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < pl_ncols {
            acc = acc + f64of(mem_load(mem_load(cell + 8) + c * 8)) * f64of(mem_load(pl_x + c * 8))
            c = c + 1
        }
        mem_store(pl_y + (pl_v0 + v) * 8, acc)
        v = v + 1
    }
    return hi - lo
}

fn pl_run(t: i64, cell) {
    if pl_kind == 1 { return pl_run_embed(t, cell) }
    if pl_kind == 2 { return pl_run_mm(t, cell) }
    if pl_kind == 3 { return pl_run_embed_b(t, cell) }
    if pl_kind == 4 { return pl_run_rows_map(t, cell) }
    if pl_kind == 5 { return pl_run_embed_map(t, cell) }
    return pl_run_rows(t, cell)
}

// ===========================================================================
// BATCHED MATMUL -- B activation vectors against ONE dequantised weight row
// ===========================================================================
//
// `mm_matvec` does one dot per row and re-reads + re-dequantises that row for
// every activation vector it is given. During PREFILL the activations arrive as
// a batch of B prompt tokens that all multiply the SAME weight matrix, so that
// row work is paid B times for nothing.
//
// This pays it once and then does B dots. NOTHING ELSE CHANGES: the dequant is
// the same call on the same bytes, and each dot is mm_dot4 over the same
// dequantised buffer with the same summation order. So for a batch laid out as
// x + b*cols (token b's activation, `cols` apart) the result is BIT-IDENTICAL to
// B separate mm_matvec calls against those same x pointers -- not merely close.
// tests/lfm2_prefill_batched_probe.quanta diffs the two directly, and
// tests/verify_lfm2_state_ref.py holds the batched dump to the llama.cpp oracle.
//
// WHY IT IS A WIN, MEASURED (docs/research/prefill-batching.md): a prefill token
// costs ~16.5 ms of dequantisation over 2.43 G weight elements but only ~6.6 ms
// of dot product. The dequant is per ROW, so it divides by B; the dot is per
// (row, token) and does not. At B=8 the elementwise cost per token drops from
// 23.1 s-equivalent to 8.7 s-equivalent, i.e. 2.7x.
//
// OUTPUT LAYOUT is token-major: y + (b * rows + r) * 8. That matches the input
// convention (token b's vector is `cols` apart in x, `rows` apart in y), so a
// chain of batched matvecs needs no transpose between them.

// Serial path: one row read, then B dots.
fn mm_matmul_ser(idx, x, rows, cols, B, y) -> i64 {
    let row_elems = gguf_tensor_nelements(idx) / rows
    let r = 0
    while r < rows {
        if mm_load_row(idx, r, row_elems) != 0 { return -1 }
        let b = 0
        while b < B {
            mem_store(y + (b * rows + r) * 8, mm_dot4(mm_rowbuf, x + b * cols * 8, cols))
            b = b + 1
        }
        r = r + 1
    }
    return 0
}

// Worker slice: static rows, one read per row, B dots. Same partition rule and
// the same primitives as pl_run_rows, so the arithmetic is unchanged.
fn pl_run_mm(t: i64, cell) {
    let per = pl_rows / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_rows }
    if hi > pl_rows { hi = pl_rows }
    let r = lo
    while r < hi {
        if mm_load_row_s(pl_idx, r, pl_cols, cell) != 0 { return -1 }
        let b = 0
        while b < pl_b {
            mem_store(pl_y + (b * pl_rows + r) * 8,
                      mm_dot4_s(mem_load(cell + 8), pl_x + b * pl_cols * 8, pl_cols, mem_load(cell + 16)))
            b = b + 1
        }
        r = r + 1
    }
    return hi - lo
}

// y[(b * rows + r)] = row_r(W) . x_b   for b in 0..B-1
//
// B == 1 delegates to mm_matvec, so a caller never has to branch and the
// single-token path keeps its exact previous behaviour.
fn mm_matmul(idx, x, rows, cols, B, y) -> i64 {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if rows <= 0 || cols <= 0 || B <= 0 { return -1 }
    if mm_rowcap < cols { return -1 }
    let row_elems = gguf_tensor_nelements(idx) / rows
    if row_elems != cols { return -1 }
    if B == 1 { return mm_matvec(idx, x, rows, cols, y) }

    // GUARD BEFORE DIVIDING. `rows / mm_workers` with mm_workers == 0 is an
    // integer division by zero -> SIGFPE, and mm_workers == 0 is the documented
    // "serial" setting that tests/lfm2_op_profile.quanta runs with. Measured:
    // SIGFPE at `idiv %rcx` with rcx = 0 on the first batched probe run.
    if mm_workers <= 1 { return mm_matmul_ser(idx, x, rows, cols, B, y) }
    let per = rows / mm_workers
    if per < 1 { return mm_matmul_ser(idx, x, rows, cols, B, y) }

    // zero y so a worker that fails leaves a detectable value, as in mm_matvec_par
    let r = 0
    while r < rows {
        let b0 = 0
        while b0 < B { mem_store(y + (b0 * rows + r) * 8, 0.0); b0 = b0 + 1 }
        r = r + 1
    }

    pl_kind = 2
    pl_idx = idx
    pl_x = x
    pl_rows = rows
    pl_cols = cols
    pl_b = B
    pl_y = y
    pl_nw = mm_workers
    pl_active = mm_workers
    pl_cell_cols = cols
    if mm_pool_ensure(mm_workers, cols) != 0 { return -1 }
    if pl_submit() != 0 { pl_kill(); return -1 }
    if pl_depth == 0 { mm_pool_end() }
    return 0
}


// One pool worker. Scratch is allocated ONCE here and reused for every job.
// The worker function name is resolved at compile time by thread_create, and
// the child trampoline hands it `t` off the child's OWN stack, so nothing here
// depends on the creating frame surviving.
fn pl_worker(t: i64) -> i64 {
    let cell = mm_scratch_new(pl_cell_cols)
    let last = 0
    let go = 1
    while go == 1 {
        if atomic_load(pl_stopp) != 0 {
            go = 0
        } else {
            let g = atomic_load(pl_genp)
            if g != last {
                lfence()
                if t < pl_active { pl_run(t, cell) }
                atomic_store(pl_donep + t * 8, g)
                futex_wake(pl_donep + t * 8, 1)
                last = g
            } else {
                // re-checked inside the kernel: a generation bump that lands
                // between the load above and this call returns EAGAIN at once
                futex_wait(pl_genp, last)
            }
        }
    }
    return 0
}

// Keep the pool alive across nested begin/end pairs (used by the forward).
fn mm_pool_begin() {
    pl_depth = pl_depth + 1
    return 0
}

// Publish the next job generation and wait for every worker to finish it.
//
// The wait first re-checks worker liveness: thread_join() itself reads slot[0]
// as "0 = the thread has exited", and the kernel owns that word
// (CLONE_PARENT_SETTID writes the tid, exit clears it), so a zero while a job
// is in flight means that worker is gone -- it died spawning its scratch (an
// allocation failure) rather than stamping done[t]. Returning -1 then beats
// blocking forever on a stamp that can never arrive.
//
// A TIMED wait was tried here and REVERTED: a raw
// `syscall(202, uaddr, FUTEX_WAIT, val, &timespec, 0, 0)` made the token stream
// diverge (argmax 5922 -> 35808 / 8696, varying run to run) where the untimed
// wait below is stable at 5922 on the same binary. It corrupted the driver, so
// it is not used. Residual exposure, stated rather than hidden: a worker that
// dies AFTER this check (a trap inside its slice) still blocks the driver. The
// slice itself allocates nothing, so that needs a trap -- which would kill the
// serial path loudly too.
fn pl_submit() -> i64 {
    fence()
    let g = atomic_load(pl_genp) + 1
    atomic_store(pl_genp, g)
    futex_wake(pl_genp, pl_size)
    let t = 0
    while t < pl_size {
        let d = 1
        while d != 0 {
            if mem_load(mem_load(pl_slots + t * 8)) == 0 { return -1 }
            d = atomic_load(pl_donep + t * 8)
            if d == g { d = 0 } else { futex_wait(pl_donep + t * 8, d) }
        }
        t = t + 1
    }
    return 0
}

// Tear the pool down unconditionally: tell the workers to leave, wake them,
// join them. Safe to call with no pool (pl_size == 0).
fn pl_kill() {
    if pl_size <= 0 { return 0 }
    atomic_store(pl_stopp, 1)
    fence()
    let g = atomic_load(pl_genp) + 1
    atomic_store(pl_genp, g)
    futex_wake(pl_genp, pl_size)
    let t = 0
    while t < pl_size {
        thread_join(mem_load(pl_slots + t * 8))
        t = t + 1
    }
    pl_size = 0
    return 0
}

// Leave one begin/end bracket. The pool is torn down when the OUTERMOST bracket
// closes, so a caller holding the pool across a whole generation loop keeps it
// and still leaves nothing alive at process exit.
fn mm_pool_end() {
    if pl_depth > 0 { pl_depth = pl_depth - 1 }
    if pl_depth > 0 { return 0 }
    return pl_kill()
}

// Ensure a pool of exactly `n` workers whose scratch cells can hold `maxcols`.
// A different size or a wider row rebuilds the pool (tear down, spawn again).
// The begin/end depth is NOT touched: a rebuild keeps the caller's bracket.
fn mm_pool_ensure(n: i64, maxcols: i64) {
    if n <= 0 { return -1 }
    // HARD SANITY CEILING. A caller -- clamped through mm_set_workers, uncapped,
    // or reaching the pool through a direct mm_matvec_par -- cannot make the
    // pool spawn an absurd number of threads. This is the "take down the process,
    // not the machine" guard: 512 threads is beyond anything this workload wants
    // and well short of a fork bomb. (The politeness ceiling is separate and
    // lower; it applies to the mm_set_workers path, not to an explicit per-call
    // count the A9 gate row depends on.)
    if n > MM_MAX_WORKERS { return -1 }
    if pl_size == n && pl_cell_cols >= maxcols { return 0 }
    pl_kill()

    // fresh protocol cells every time: the workers start with last = 0 and the
    // generation must start at 0 too, or a reused word would look like a job
    pl_genp = mem_alloc(8)
    pl_stopp = mem_alloc(8)
    pl_donep = mem_alloc(n * 8)
    pl_slots = mem_alloc(n * 8)
    // FAIL CLOSED on allocation failure: a NULL protocol word would make
    // atomic_store() write to address 0 (a process kill with no diagnostic).
    // Return -1 to the caller instead; it rebuilds on the next call.
    // LOUD, not silent: the emitter's own MAP_FAILED guard (inside
    // thread_create's 1 MB stack mmap) exits(1) with ZERO output -- measured
    // by the SI-loop peer (commit e0d766f6), it cost a whole generation run.
    // Whatever CAN be diagnosed here is printed here: the last line before a
    // silent death should name the pool size and the failed cell.
    if pl_genp == 0 || pl_stopp == 0 || pl_donep == 0 || pl_slots == 0 {
        prints("mm_pool_ensure: ALLOC FAIL n="); print(n)
        prints(" (protocol cells 8+8+"); print(n * 8); prints("+"); print(n * 8)
        prints(" bytes; next step would be "); print(n)
        prints(" thread stacks of ~1 MB each -- VmPeak suspect)\n")
        pl_size = 0
        return -1
    }
    prints("mm_pool: spawn n="); print(n)
    prints(" cell_cols="); print(pl_cell_cols); newline()
    atomic_store(pl_genp, 0)
    atomic_store(pl_stopp, 0)
    // the workers size their scratch from this at spawn time
    pl_cell_cols = maxcols

    let t = 0
    while t < n {
        atomic_store(pl_donep + t * 8, 0)
        mem_store(pl_slots + t * 8, thread_create(pl_worker, t))
        t = t + 1
    }
    pl_size = n
    return 0
}

// ===========================================================================
// FULL-FILE WEIGHT MMAP + RAW-ROW PATHS (kind 4 / kind 5)
// ===========================================================================
//
// WHY: the pread path costs a syscall + a page-cache copy per row -- ~300k
// preads per decode token at ~0.5 ns/element (measured, tests/lfm2_op_profile).
// One full-file mapping at offset 0 (page-aligned by definition, unlike
// gguf_data_start) turns every row into a pointer read. Bit-exactness: the
// bytes are the same bytes, the dequant calls below are the SAME dq32lo/dq32hi
// and dq6 calls with the SAME scale association as gguf.quanta's
// dequant_q4k / dequant_q6k, and the dot stays mm_dot4_s -- so the output is
// bit-identical to the pread path, which the dot bench asserts row by row.
//
// gguf_tensor_offset(idx) is a PUBLIC fn in gguf.quanta (used by
// gguf_read_tensor_bytes_at for its pread), so the raw address of row r of
// tensor idx is mm_map_base + gguf_tensor_offset(idx) + r * row_bytes.
let mm_map_base = 0
let mm_map_size = 0
let mm_map_fd = 0 - 1

// Map the whole GGUF at offset 0, PROT_READ | MAP_PRIVATE, then prefault it
// with MADV_POPULATE_READ (22) so the first token does not eat 400k page
// faults. TAKES AN FD, NOT A PATH: an untyped path parameter loses its string
// type in transit (defect A7, measured in tests/lfm2_generate.quanta) and
// file_open would return -1 for a file that plainly exists. The caller opens
// with the const STRAIGHT at the call site: mm_attach_mmap_fd(file_open(PATH, 0)).
// Idempotent. 0 on success, -1 on failure (callers fall back to pread).
fn mm_attach_mmap_fd(fd: i64) -> i64 {
    if mm_map_base != 0 { return 0 }
    if fd < 0 { return -1 }
    let sz = file_size(fd)
    if sz <= 0 { return -1 }
    let base = mmap_file(0, sz, 1, 2, fd, 0)
    if base <= 0 { return -1 }
    syscall(28, base, sz, 22, 0, 0, 0)
    mm_map_base = base
    mm_map_size = sz
    mm_map_fd = fd
    return 0
}

fn mm_detach_mmap() {
    if mm_map_base != 0 { munmap_file(mm_map_base, mm_map_size) }
    if mm_map_fd >= 0 { file_close(mm_map_fd) }
    mm_map_base = 0
    mm_map_size = 0
    mm_map_fd = 0 - 1
    return 0
}

// Dequantise one row straight from raw bytes into dst, BIT-IDENTICAL to
// read_block_f64 for dtype 12 (Q4_K) and 14 (Q6_K). The code shape is copied
// from gguf.quanta's dequant_q4k / dequant_q6k (which are what
// read_block_f64 dispatches to): same f16 loads, same q4k_sc/q4k_min unpack,
// same d1/mm1 association, same dq32lo/dq32hi / dq6 calls.
// Returns 0 on success, -1 on an unsupported dtype or a non-multiple block.
fn mm_deq_row_raw(dtype, raw: u64, elems: i64, dst: u64) -> i64 {
    if dtype == 12 {
        if elems <= 0 || elems - (elems / 256) * 256 != 0 { return -1 }
        let nb = elems / 256
        let bi = 0
        while bi < nb {
            let bo = bi * 144
            let d = f16_to_f64(raw + bo)
            let dmin = f16_to_f64(raw + bo + 2)
            let sc = raw + bo + 4
            let q = raw + bo + 16
            let chunk = 0
            let is = 0
            while chunk < 4 {
                let s0 = q4k_sc(is, sc)
                let m0 = q4k_min(is, sc)
                let s1 = q4k_sc(is + 1, sc)
                let m1 = q4k_min(is + 1, sc)
                let d1 = fmul(d, i2f(s0))
                let mm1 = fmul(dmin, i2f(m0))
                let d2 = fmul(d, i2f(s1))
                let mm2 = fmul(dmin, i2f(m1))
                let op = dst + (bi * 256 + chunk * 64) * 8
                dq32lo(op, q, f64bits(d1), f64bits(mm1))
                dq32hi(op + 256, q, f64bits(d2), f64bits(mm2))
                q = q + 32
                is = is + 2
                chunk = chunk + 1
            }
            bi = bi + 1
        }
        return 0
    }
    if dtype == 14 {
        if elems <= 0 || elems - (elems / 256) * 256 != 0 { return -1 }
        let nb = elems / 256
        let bi = 0
        while bi < nb {
            let bo = bi * 210
            let d = f16_to_f64(raw + bo + 208)
            let dbits = f64bits(d)
            let n = 0
            while n < 2 {
                dq6(dst + (bi * 256 + n * 128) * 8, raw + bo + n * 64, raw + bo + 128 + n * 32, dbits, raw + bo + 192 + n * 8)
                n = n + 1
            }
            bi = bi + 1
        }
        return 0
    }
    return -1
}

// Pool kind 4 worker: static row slice, raw pointer per row, NO pread, NO
// shared rowbuf. Same partition rule, same dequant, same mm_dot4_s as kind 0
// -- bit-identical by construction (verified: tests/lfm2_dot_bench.quanta,
// 0 mismatches over 131072 Q4_K + 344064 Q6_K elements).
//
// NOTE ON A MULTI-CELL DOT: an 8-cell interleaved variant (mm_dot8_s) was
// built here and DELETED after measurement. Two findings, both in
// tests/lfm2_avx2_call_chain_bench.quanta and docs/research/decode-fused-dot.md:
//   1. CELL SPACING: fmulf_avx2/faddf_avx2 store 32 bytes (4 f64 lanes) per
//      call, so accumulator cells must be 32 bytes apart. Cells spaced 8
//      bytes apart SELF-ALIAS (each store clobbers the next three cells) and
//      produce exactly the "dropped elements / wrong slices" signature that
//      looks like a codegen defect. The compiler is innocent; the emitted
//      bytes are identical for every call.
//   2. NO YIELD: with the corrected 32-byte layout the 8-cell form is EXACT
//      but 1.8x SLOWER than mm_dot4_s on equal work (192.6 vs 106.0 ms for
//      128 elements x 200k reps): the Quanta-level g-loop overhead per 4
//      elements exceeds what extra chains save, and mm_dot4_s's own 4 vector
//      lanes already interleave the dependency chain. The lever that actually
//      reaches <= 1 cycle/element is the fused register-resident builtin
//      spec'd in docs/research/decode-fused-dot.md section 3.
fn pl_run_rows_map(t: i64, cell) {
    let per = pl_rows / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_rows }
    if hi > pl_rows { hi = pl_rows }
    let dtype = gguf_tensor_dtype(pl_idx)
    let rb = mm_row_bytes(dtype, pl_cols)
    if rb <= 0 { return -1 }
    let toff = gguf_tensor_offset(pl_idx)
    let f64b = mem_load(cell + 8)
    let acc = mem_load(cell + 16)

    // ---- the fused route (opt-in, default OFF) ----------------------------
    // This IS the decode hot path: mm_matvec routes to mm_matvec_par when
    // workers > 1, and mm_matvec_par selects pool kind 4 for a Q4_K/Q6_K tensor
    // once mm_attach_mmap_fd has mapped the file. So one branch here replaces
    // the dequant+dot for every matvec in the forward (FFN gate/up/down,
    // attention q/k/v/out, shortconv in/out) at once -- Q4_K (12) via
    // jit_f_apply_folded() and Q6_K (14) via jit_f_apply_folded_q6k(), each
    // behind its own flag.
    //
    // The tied output projection (token_embd, Q6_K) is NOT here: it is pool
    // kind 5 (pl_run_embed_map), a different worker with a scalar reference dot,
    // so it stays on the existing path. Named, not implied -- see the coverage
    // note beside mm_fused_q6k.
    //
    // The args area is THIS worker's own (cell+24), allocated once at spawn.
    // NOTE the name: `as` is a reserved keyword token in this front end (a
    // parameter named `as` is the exact 0.0.246 defect class), so the locals are
    // `fargs` / `fargs6`.
    let fused = 0
    let fused6 = 0
    let fargs = 0
    let fargs6 = 0
    if mm_fused_q4k != 0 && dtype == 12 && pl_cols - (pl_cols / 256) * 256 == 0 {
        fargs = mem_load(cell + 24)
        if fargs != 0 { fused = 1 }
    }
    if mm_fused_q6k != 0 && dtype == 14 && pl_cols - (pl_cols / 256) * 256 == 0 {
        fargs6 = mem_load(cell + 24)
        if fargs6 != 0 { fused6 = 1 }
    }

    let r = lo
    while r < hi {
        let raw = mm_map_base + toff + r * rb
        if fused != 0 {
            mem_store(fargs + 0, raw)               // W: this row's quant bytes
            mem_store(fargs + 8, pl_x)              // X: fixed for the whole matvec
            mem_store(fargs + 16, 0)                // DMD: unused by the folded kernel
            mem_store(fargs + 24, pl_cols / 256)    // nsuper
            // the kernel returns the f64 dot as raw bits; mem_store writes the
            // same 64 bits mm_dot4_s would.
            mem_store(pl_y + r * 8, jit_f_apply_folded(fargs))
            mm_fused_used = 1
        } else if fused6 != 0 {
            mem_store(fargs6 + 0, raw)              // W: this row's quant bytes
            mem_store(fargs6 + 8, pl_x)             // X: fixed for the whole matvec
            mem_store(fargs6 + 16, 0)               // DMD: unused, Q6_K folds too
            mem_store(fargs6 + 24, pl_cols / 256)   // nsuper
            mem_store(pl_y + r * 8, jit_f_apply_folded_q6k(fargs6))
            mm_fused_q6k_used = 1
        } else {
            if mm_deq_row_raw(dtype, raw, pl_cols, f64b) != 0 { return -1 }
            mem_store(pl_y + r * 8, mm_dot4_s(f64b, pl_x, pl_cols, acc))
        }
        r = r + 1
    }
    return hi - lo
}

// Pool kind 5 worker: the tied output projection (embed logits) from the
// mapping. The dot is the SAME left-to-right scalar accumulation as
// pl_run_embed -- bit-identical by construction. (The multi-lane dot is NOT
// an option here either -- see the note on pl_run_rows_map.)
fn pl_run_embed_map(t: i64, cell) {
    let per = pl_vcount / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_vcount }
    if hi > pl_vcount { hi = pl_vcount }
    let dtype = gguf_tensor_dtype(pl_idx)
    let rb = mm_row_bytes(dtype, pl_ncols)
    if rb <= 0 { return -1 }
    let toff = gguf_tensor_offset(pl_idx)
    let f64b = mem_load(cell + 8)
    let v = lo
    while v < hi {
        let raw = mm_map_base + toff + (pl_v0 + v) * rb
        if mm_deq_row_raw(dtype, raw, pl_ncols, f64b) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < pl_ncols {
            acc = acc + f64of(mem_load(f64b + c * 8)) * f64of(mem_load(pl_x + c * 8))
            c = c + 1
        }
        mem_store(pl_y + (pl_v0 + v) * 8, acc)
        v = v + 1
    }
    return hi - lo
}

// ---- the multi-cell dot: built, measured, DELETED --------------------------
//
// An 8-cell interleaved mm_dot8_s (8 independent accumulator chains behind the
// through-memory AVX2 builtins) was written here to beat mm_dot4_s. Removed
// after measurement; the full evidence is tests/lfm2_avx2_call_chain_bench.quanta:
//
// 1. CELL SPACING. fmulf_avx2/faddf_avx2 store 32 bytes (4 f64 lanes) per
//    call. Cells spaced 8 bytes apart SELF-ALIAS: every faddf store clobbers
//    the next three cells, producing exactly the "dropped elements / one call
//    read another call's address" signature that looks like a codegen defect.
//    It is not one: the emitted bytes are identical for every call, and with
//    cells 32 bytes apart every sum is exact (V2 of the bench). The first
//    version of this dot (and its first "fix") both used 8-byte cells, which
//    is why the failure survived two rewrites.
// 2. NO YIELD. With the corrected layout, equal-work timing over 128
//    elements x 200k reps: 8-cell form 192.6 ms vs mm_dot4_s 106.0 ms -- the
//    8-cell form is 1.8x SLOWER. The Quanta-level group loop costs more per
//    4 elements than the extra chains save, and mm_dot4_s's own 4 vector
//    lanes already interleave the store-forward chains. mm_dot4_s stands.
//    The lever that reaches <= 1 cycle/element is the fused register-resident
//    builtin spec'd in docs/research/decode-fused-dot.md section 3.

// acc layout: mm_dot4_s uses 4 lanes at acc+0..31 and a temp at acc+32..63
// (64 bytes). The scratch region stays 512 B so a future register-resident
// dot builtin has room without a cell-layout change.
