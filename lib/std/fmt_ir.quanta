// std/fmt_ir.quanta - IR printer / Quanta emitter
// Converts IR to .quanta source code

module std_fmt_ir;

import std.ir;

fn emit_ir(ir) {
    let out = "";
    let i = 0;
    while i < ir.len() {
        let inst = ir[i];
        let op = inst["op"];
        
        if op == IR_CONST {
            out = out + "    const v" + inst["result"] + " = " + inst["a0"] + ";\n";
        } else if op == IR_PARAM {
            out = out + "    param v" + inst["result"] + " = arg" + inst["a0"] + ";\n";
        } else if op == IR_MOV {
            out = out + "    v" + inst["result"] + " = v" + inst["a0"] + ";\n";
        } else if op == IR_ADD {
            out = out + "    v" + inst["result"] + " = v" + inst["a0"] + " + v" + inst["a1"] + ";\n";
        } else if op == IR_SUB {
            out = out + "    v" + inst["result"] + " = v" + inst["a0"] + " - v" + inst["a1"] + ";\n";
        } else if op == IR_MUL {
            out = out + "    v" + inst["result"] + " = v" + inst["a0"] + " * v" + inst["a1"] + ";\n";
        } else if op == IR_DIV {
            out = out + "    v" + inst["result"] + " = v" + inst["a0"] + " / v" + inst["a1"] + ";\n";
        } else if op == IR_RET {
            out = out + "    return v" + inst["a0"] + ";\n";
        } else if op == IR_CALL {
            out = out + "    v" + inst["result"] + " = " + inst["a0"] + "(...\n";
        } else if op == IR_LABEL {
            out = out + "L" + inst["a0"] + ":\n";
        } else if op == IR_JMP {
            out = out + "    jmp L" + inst["a0"] + ";\n";
        } else if op == IR_BR {
            out = out + "    br v" + inst["a0"] + " L" + inst["a1"] + ";\n";
        } else if op == IR_STR {
            out = out + "    v" + inst["result"] + " = \"" + inst["a0"] + "\";\n";
        } else {
            out = out + "    // " + opcode_name(op) + "\n";
        }
        
        i = i + 1;
    }
    return out;
}

fn emit_module(name, ir) {
    let out = "module " + name + ";\n\n";
    out = out + "fn main() -> i64 {\n";
    out = out + emit_ir(ir);
    out = out + "}\n";
    return out;
}

fn init() -> i64 {
    return 0;
}