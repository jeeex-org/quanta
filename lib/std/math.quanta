// std/math — numeric helpers (pure Quanta; builtins wrap syscalls/asm).
// Import with:  import std/math

// Absolute value of a signed i64 (two's-complement safe).
fn abs(x) {
  if x < 0 { return 0 - x }
  return x
}

// Minimum of two i64.
fn min(a, b) {
  if a < b { return a }
  return b
}

// Maximum of two i64.
fn max(a, b) {
  if a > b { return a }
  return b
}

// Clamp x into [lo, hi].
fn clamp(x, lo, hi) {
  if x < lo { return lo }
  if x > hi { return hi }
  return x
}

// Integer power: base^exp (exp >= 0). 0^0 = 1.
fn pow(base, exp) {
  let r = 1
  let i = 0
  while i < exp { r = r * base; i = i + 1 }
  return r
}

// Greatest common divisor (Euclidean).
fn gcd(a, b) {
  let x = abs(a)
  let y = abs(b)
  while y != 0 {
    let t = y
    y = x % y
    x = t
  }
  return x
}

// Least common multiple.
fn lcm(a, b) {
  let g = gcd(a, b)
  if g == 0 { return 0 }
  return abs(a) / g * abs(b)
}
