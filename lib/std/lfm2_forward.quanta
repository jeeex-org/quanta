// lib/std/lfm2_forward.quanta -- native LFM2 forward pass, one token at a time.
//
// Configuration is read from the model, never hardcoded. Measured from
// QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf:
//
//   lfm2.embedding_length                    2048      d_model
//   lfm2.feed_forward_length                 10752     d_ff
//   lfm2.block_count                         30
//   lfm2.vocab_size                          128000
//   lfm2.attention.head_count                32        query heads
//   lfm2.attention.head_count_kv             per layer: 8 on attention layers
//   lfm2.rope.freq_base                      1e7
//   lfm2.attention.layer_norm_rms_epsilon    1e-5
//   lfm2.shortconv.l_cache                   3         causal conv width
//   general.file_type                        15        Q4_K_M
//
// head_dim = d_model / head_count = 64. The attention layers run 32 query heads
// over 8 KV heads, so 4 queries share each KV head. Conv layers have no
// attention at all.
//
// Memory: no weight is ever fully materialised. Every matvec goes through
// lfm2_mm, which reads one row at a time, so peak cost is the widest single row
// (1 MB for the embedding) rather than the 20 GB of weights.
//
// MEMORY ACCESS CONVENTION
// ------------------------
// A Quanta pointer is a raw address. Read f64 with f64of(mem_load(p + i * 8)),
// write with mem_store(p + i * 8, v). Indexing p[i] faults. A typed `f64` local
// holds a float bit-pattern; an UNTYPED `acc` turns arithmetic into integer
// operations and trips the overflow trap (SIGILL, exit 132). print() shows the
// bit pattern -- use pf64() from std/math to see a float.

import std/gguf
import std/lfm2_model
import std/lfm2_mm
import std/math

// f32 metadata (rope.freq_base, layer_norm_rms_epsilon) comes back through
// gguf_kv_float(), which already widens f32 to f64. Do NOT hand-roll this: an
// earlier version read the raw bytes out of gguf_kv_int(), which is documented to
// return -1 for a non-integer KV, and crashed.

// ---- configuration ---------------------------------------------------------
let fc_d_model = 0
let fc_d_ff = 0
let fc_n_layers = 0
let fc_n_heads = 0
let fc_head_dim = 0
let fc_n_ctx = 0
let fc_rope_base = 0.0
let fc_rms_eps = 0.0
let fc_conv_width = 0
let fc_n_vocab = 0
let fc_nkv_max = 0
let fc_ready = 0

let fc_nkv = 0            // per-layer KV head count, 0 = no attention

// short-conv scratch, allocated once on first use (mem_alloc in a loop is unsafe)
let fc_sc_ip = 0
let fc_sc_bx = 0
let fc_sc_g = 0
let fc_sc_k = 0
let fc_sc_y = 0
let fc_sc_kw = 0


fn fc_read_config() {
    if fc_ready != 0 { return 0 }

    fc_d_model = gguf_kv_int(gguf_kv_find("lfm2.embedding_length"))
    fc_d_ff = gguf_kv_int(gguf_kv_find("lfm2.feed_forward_length"))
    fc_n_layers = gguf_kv_int(gguf_kv_find("lfm2.block_count"))
    fc_n_heads = gguf_kv_int(gguf_kv_find("lfm2.attention.head_count"))
    fc_n_ctx = gguf_kv_int(gguf_kv_find("lfm2.context_length"))
    fc_n_vocab = gguf_kv_int(gguf_kv_find("lfm2.vocab_size"))
    fc_conv_width = gguf_kv_int(gguf_kv_find("lfm2.shortconv.l_cache"))

    fc_rope_base = gguf_kv_float(gguf_kv_find("lfm2.rope.freq_base"))
    fc_rms_eps = gguf_kv_float(gguf_kv_find("lfm2.attention.layer_norm_rms_epsilon"))

    if fc_d_model <= 0 || fc_n_heads <= 0 || fc_n_layers <= 0 { return -1 }
    fc_head_dim = fc_d_model / fc_n_heads
    if fc_head_dim * fc_n_heads != fc_d_model { return -1 }
    if fc_rope_base <= 0.0 { return -1 }
    if fc_rms_eps <= 0.0 { return -1 }

    if lfm2_build_table(fc_n_layers) <= 0 { return -1 }

    // n_kv is per layer in LFM2. Cross-check it against the descriptor table: a
    // layer claiming KV heads must actually have attn_k/attn_v tensors, and one
    // with no KV heads must not. If the two sources disagree, every attention
    // result would be garbage, so refuse rather than guess.
    fc_nkv = mem_alloc(fc_n_layers * 8)
    let kv = gguf_kv_find("lfm2.attention.head_count_kv")
    let i = 0
    while i < fc_n_layers { mem_store(fc_nkv + i * 8, 0); i = i + 1 }
    if kv >= 0 {
        // head_count_kv is an i32 array, NOT a string array: 4 bytes per element
        // with no length prefix. gguf_kv_arr_elem_bytes() walks length-prefixed
        // records and would read nonsense here, so slurp it as a fixed-stride i32
        // block starting at the array's own offset.
        let cnt = gguf_kv_arr_count_any(kv)
        if cnt > 0 && gguf_kv_arr_etype(kv) == 5 {
            // ONE cell for the whole loop: mem_alloc inside a loop is unsafe
            // because the next iteration clobbers the pointer.
            let cell = mem_alloc(8)
            i = 0
            while i < cnt && i < fc_n_layers {
                if gguf_kv_arr_elem_num(kv, i, cell) != 4 { return -1 }
                let v = mem_load(cell)
                mem_store(fc_nkv + i * 8, v)
                if v > fc_nkv_max { fc_nkv_max = v }
                i = i + 1
            }
        }
    }
    i = 0
    while i < fc_n_layers {
        let want = mem_load(fc_nkv + i * 8)
        let has = lfm2_layer_is_attn(i)
        if want > 0 && has == 0 { return -1 }
        if want == 0 && has != 0 { return -1 }
        i = i + 1
    }
    if fc_nkv_max <= 0 { return -1 }

    mm_init(fc_n_vocab)
    fc_ready = 1
    return 0
}

fn fc_nkv_of(L) { return mem_load(fc_nkv + L * 8) }

// ---- RMSNorm WITH epsilon --------------------------------------------------
// gguf.quanta's rms_norm(out, x, w, n) computes x * rsqrt(mean(x^2)) * w with NO
// epsilon. Verified: on x = all 1e-3 it returns 1.000000, where an eps of 1e-5
// would give 0.952379. Upstream applies
// lfm2.attention.layer_norm_rms_epsilon, so on a small activation the missing
// term is a 5% error. This version adds it.
fn fc_rms_norm(out: u64, x: u64, w: u64, n: i64) {
    if n <= 0 { return 0 }
    let ss: f64 = 0.0
    let i = 0
    while i < n {
        let v = f64of(mem_load(x + i * 8))
        ss = ss + v * v
        i = i + 1
    }
    let inv: f64 = 1.0 / sqrt(ss / i2f(n) + fc_rms_eps)
    i = 0
    while i < n {
        let xv = f64of(mem_load(x + i * 8))
        let wv = f64of(mem_load(w + i * 8))
        mem_store(out + i * 8, xv * inv * wv)
        i = i + 1
    }
    return 0
}
// ===========================================================================
// SHORT CONVOLUTION PATH (the 22 conv layers)
//
// Transcribed from llama.cpp src/models/lfm2.cpp, build_shortconv_block(),
// which is authoritative:
//
//   d_conv = l_cache - 1 = 2                  STATE width
//   bcx    = in_proj @ x                      [d_model, 3 * d_model]
//   split  bcx into b, c, x                   each d_model wide
//   bx     = transpose(b * x)                the gated pre-activation
//   bx     = concat(conv_state, bx)           causal: state PREPENDED -> 3 wide
//   state' = the last 2 positions of bx
//   out    = ssm_conv(bx, conv.weight)
//   y      = c * out
//   y      = out_proj @ y
//
// The three details that are easy to get wrong:
//
//   - The state is PREPENDED, not appended. Getting that backwards shifts the
//     convolution by one position, which is a plausible-looking but wrong answer.
//
//   - b and x are MULTIPLIED before the convolution, and c gates the OUTPUT.
//     Both gates are separate tensors; applying only one leaves the layer
//     roughly half-right, which is very hard to spot.
//
//   - conv.weight is [l_cache, d_model] = [3, 2048], NOT [d_conv, d_model].
//     d_conv = 2 is the STATE width; the kernel has all 3 taps. Verified in
//     llama.cpp: create_tensor(..., {n_shortconv_l_cache, n_embd}, 0).
//     A version here that sized the kernel by d_conv silently loaded the wrong
//     number of elements; mm_load_small()'s element-count check caught it.
//
// The kernel is applied as a CORRELATION with taps in increasing time order
// (ggml_compute_forward_ssm_conv_f32: `sumf += s[i0] * c[i0]` over nc taps).
// With the causal window [s0, s1, g] the output is
//   k0*s0 + k1*s1 + k2*g
// and the new state is (s1, g).

// One short-conv layer. `x` is d_model values, `state` holds 2 * d_model values
// (state[k * d_model + c] is token t-1-k for channel c). Returns 0 on success.
fn fc_short_conv(L, x: u64, state: u64, out: u64) {
    let dm = fc_d_model
    let dc = fc_conv_width - 1          // 2: STATE width
    let kw = fc_conv_width               // 3: KERNEL width (l_cache, not d_conv)
    let cin = lfm2_conv_in_proj(L)
    let cwt = lfm2_conv_conv(L)
    let cout = lfm2_conv_out_proj(L)
    if cin < 0 || cwt < 0 || cout < 0 { return -1 }

    if fc_sc_ip == 0 {
        // in_proj is [d_model, 3*d_model], so in_proj @ x yields 3 * d_model
        // values -- NOT d_model * 3 * d_model. The output is one column.
        fc_sc_ip = mem_alloc(3 * dm * 8)
        fc_sc_bx = mem_alloc(kw * dm * 8)         // state + current, time-major
        fc_sc_kw = mem_alloc(kw * dm * 8)         // dequantized kernel
        fc_sc_g = mem_alloc(dm * 8)               // b * x
        fc_sc_k = mem_alloc(dm * 8)               // conv output
        fc_sc_y = mem_alloc(dm * 8)
    }

    // bcx = in_proj @ x  -> [3 * d_model]
    if mm_matvec(cin, x, dm * 3, dm, fc_sc_ip) != 0 { return -1 }

    // Gate: bx[t] = b[t] * x[t], reading the three chunks in order.
    let cs = dm
    let t = 0
    while t < dm {
        let bv = f64of(mem_load(fc_sc_ip + t * 8))
        let xv = f64of(mem_load(fc_sc_ip + (2 * cs + t) * 8))
        mem_store(fc_sc_g + t * 8, bv * xv)
        t = t + 1
    }

    // Prepend the causal state: bx = [state[0..dc), g[0..dm)] along time.
    t = 0
    while t < dc {
        let c = 0
        while c < dm {
            mem_store(fc_sc_bx + (t * dm + c) * 8, f64of(mem_load(state + (t * dm + c) * 8)))
            c = c + 1
        }
        t = t + 1
    }
    t = 0
    while t < dm {
        mem_store(fc_sc_bx + (dc * dm + t) * 8, f64of(mem_load(fc_sc_g + t * 8)))
        t = t + 1
    }

    // conv_out[c] = sum_k conv[k][c] * bx[t_last - k][c]
    //
    // The kernel is [l_cache, d_model] = [3, 2048] = 6144 elements, small enough
    // to dequantize whole. out_proj is [d_model, d_model] = 4.2 M elements and
    // goes through the row-wise matvec instead. Both are under mm_small_cap; a
    // weight that were not returns -1 rather than silently materializing 20 GB.
    if mm_load_small(cwt, kw * dm, fc_sc_kw) != kw * dm { return -1 }

    // One output time step, correlation with taps in increasing time order:
    //   k0*s0 + k1*s1 + k2*g
    //
    // KERNEL INDEXING: shortconv.conv is [3, 2048] in ggml order, so ne[0]=3 is
    // the CONTIGUOUS dimension. ggml_compute_forward_ssm_conv_f32 reads it as
    //     sumf += s[i0 + i1*ncs] * c[i0 + i1*nc];
    // i.e. element (channel i1, tap i0) is at flat index i0 + i1*nc = tap + ch*3.
    // Reading it as (k*dm + c) -- channel-major, stride 2048 -- gives the right
    // answer only for channel 0 and the wrong tap for every other channel, which
    // flattens the logits and changes the argmax.
    let c = 0
    while c < dm {
        let acc: f64 = 0.0
        let k = 0
        while k < kw {
            let w = f64of(mem_load(fc_sc_kw + (c * kw + k) * 8))
            acc = acc + w * f64of(mem_load(fc_sc_bx + (k * dm + c) * 8))
            k = k + 1
        }
        mem_store(fc_sc_k + c * 8, acc)
        c = c + 1
    }

    // New state: the LAST dc positions of the 3-wide window, i.e. (s1, g).
    // Positions dc-1 .. kw-1, so the oldest retained token drops out each call.
    t = 0
    while t < dc {
        let c = 0
        while c < dm {
            mem_store(state + (t * dm + c) * 8, f64of(mem_load(fc_sc_bx + ((dc - 1 + t) * dm + c) * 8)))
            c = c + 1
        }
        t = t + 1
    }

    // y = c * conv_out, then out_proj @ y
    t = 0
    while t < dm {
        let cv = f64of(mem_load(fc_sc_ip + (cs + t) * 8))
        mem_store(fc_sc_y + t * 8, cv * f64of(mem_load(fc_sc_k + t * 8)))
        t = t + 1
    }
    return mm_matvec(cout, fc_sc_y, dm, dm, out)
}

// ===========================================================================
// GQA ATTENTION PATH (the 8 attention layers)
//
// Transcribed from llama.cpp src/models/lfm2.cpp build_attn_block():
//
//   q = q_proj @ x        [d_model, n_head * head_dim]  = [2048, 2048]
//   k = k_proj @ x        [d_model, n_kv  * head_dim]  = [2048,  512]
//   v = v_proj @ x        [d_model, n_kv  * head_dim]  = [2048,  512]
//   q = rms_norm(q, attn_q_norm)     per HEAD, over head_dim
//   k = rms_norm(k, attn_k_norm)     per HEAD, over head_dim
//   q = rope(q, pos);  k = rope(k, pos)
//   k,v are appended to the per-layer KV cache
//   scores[h] = q[h] . k[t]/sqrt(head_dim)   for every cached t <= pos
//   softmax over t
//   out[h] = sum_t scores[h][t] * v[t]
//   y = out_proj @ concat(out[0..n_head))
//
// n_head = 32, n_kv = 8, head_dim = 64, so the GQA group is 4: query heads
// 4h..4h+3 share KV head h.
//
// Three details that each produce a plausible but wrong result:
//
//   - attn_q_norm / attn_k_norm are PER HEAD over head_dim (64 elements each),
//     NOT over d_model. Normalizing the whole 2048-wide vector at once gives a
//     different scale and silently wrecks every score.
//   - The RMSNorm here carries the epsilon (fc_rms_norm), like the others.
//   - No RoPE scaling: the model has NO lfm2.rope.scaling.* keys and no
//     lfm2.rope.dimension_count, so n_rot is the full head_dim and the only
//     parameter is freq_base = 1e7. Verified against the model's own metadata.
//
// RoPE convention is NEOX, and the pairing is HALF-SPLIT, not adjacent.
// From ggml's rotate_pairs():
//   for i0 in 0..n step 2:  ic = i0/2
//     x0 = src[ic],  x1 = src[ic + head_dim/2]
//     dst[ic]               = x0*cos - x1*sin
//     dst[ic + head_dim/2]  = x0*sin + x1*cos
// and from ggml_rope_cache_init():
//   theta starts at 1.0 and is multiplied by theta_scale = base^(-2/head_dim)
//   once per PAIR, so pair i uses theta = base^(-2i/head_dim)
// with cache[i0] = cos, cache[i0+1] = sin.
//
// Pairing element 0 with element 32 (head_dim/2) rather than element 0 with
// element 1 is the difference between a correct rotation and one that looks
// plausible but scrambles every head. head_dim = 64 is even, so all components
// are rotated.

// ---- KV cache -------------------------------------------------------------
// One contiguous block for every attention layer: layer L owns
//   kcache: n_kv * head_dim * n_ctx
//   vcache: n_kv * head_dim * n_ctx
// f64, NOT f32. Storing f32 would halve the footprint (1 GB vs 2 GB for the K
// cache of one attention layer at 131072 context), but there is no f64->f32
// narrowing conversion in the language -- only f32_to_f64() -- so an f32 cache
// needs a hand-rolled pack that is exactly where the f32_to_f64 bug came from.
// f64 is correct, simple and verifiable; narrowing can come later with a real
// conversion and a test that pins the rounding.

let fc_kvbuf = 0
let fc_kv_cap = 0        // max positions per layer
let fc_kv_len = 0        // positions currently filled

// Bytes one layer's K cache needs: n_kv * head_dim * 4 bytes in f32.
fn fc_kv_layer_stride() { return fc_nkv_max * fc_head_dim * 8 }

fn fc_kv_init(nctx) {
    if fc_kvbuf != 0 { return 0 }
    if fc_nkv_max <= 0 || fc_head_dim <= 0 { return -1 }
    fc_kv_cap = nctx
    // The allocation MUST match the index expression in fc_kv_at exactly. That
    // expression steps by fc_kv_cap positions, so the per-layer stride has to
    // include the context length:
    //
    //     per layer = fc_kv_cap * fc_nkv_max * fc_head_dim * 8
    //
    // This version allocated only nkv_max * head_dim * 8 per layer -- one
    // POSITION, not a whole context -- while the index multiplied in
    // fc_kv_cap. Measured on this model (cap 2048, 30 layers, nkv 8, hd 64):
    // the index expression reaches byte 503,315,968 of a 249,856-byte buffer,
    // a 503 MB overshoot, exactly 2048x too far.
    //
    // pos 0 was the only case that worked, because its position term is zero --
    // which is why generation looked fine at the first token and then corrupted
    // memory. Every store past pos 0 wrote outside its own layer slot and
    // eventually outside the allocation entirely.
    fc_kvbuf = mem_alloc(fc_kv_cap * fc_nkv_max * fc_head_dim * 8 * fc_n_layers * 2 + 4096)
    if fc_kvbuf == 0 { return -1 }
    fc_kv_len = 0
    return 0
}

fn fc_kv_reset() { fc_kv_len = 0 }

// K (or V) cache base for layer L: 0 = K, 1 = V.
// Absolute byte address of position `pos` of KV head `h` in layer L.
// The layer stride is fc_kv_cap * fc_nkv_max * fc_head_dim * 8 and the position
// offset is (pos * nkv_max + h) * fc_head_dim * 8 -- they must use the SAME
// per-layer head count or a write at pos>0 lands outside the slot.
//
// The first version mixed them: the stride omitted the nkv factor while the
// offset included it, so every store past pos 0 ran off the end of the buffer.
// This is the same out-of-bounds class as the earlier conv-path bug, and the same
// lesson: when two expressions index into one allocation, check that they agree
// on the unit stride, do not eyeball each one.
fn fc_kv_at(L, which, pos, h) {
    return fc_kvbuf + (which * fc_n_layers + L) * fc_kv_cap * fc_nkv_max * fc_head_dim * 8
           + ((pos * fc_nkv_max + h) * fc_head_dim) * 8
}

// Write one value into the KV cache.
fn fc_kv_put(L, which, pos, h, j, v) {
    mem_store(fc_kv_at(L, which, pos, h) + j * 8, v)
    return 0
}

// Read one value back out of the KV cache.
//
// The `-> f64` is REQUIRED, not decoration. An untyped return carries the value
// as a raw bit pattern, and a caller doing `want - got` against it gets INTEGER
// subtraction: verified, two identical float bit patterns subtracted to inf
// rather than 0.0. That silently turns a correct comparison into a garbage one,
// and the value only shows up as a wrong answer far downstream.
fn fc_kv_get(L, which, pos, h, j) -> f64 {
    return f64of(mem_load(fc_kv_at(L, which, pos, h) + j * 8))
}

// ---- RoPE -----------------------------------------------------------------

// Fill the cos/sin cache for one head position. `theta` accumulates the
// base^(-2i/head_dim) progression exactly as ggml_rope_cache_init does, rather
// than calling pow() per pair: one power and a multiply per pair instead of 32
// powers, and it matches ggml's own loop order.
fn fc_rope_cache(pos) {
    let hd = fc_head_dim
    let half = hd / 2
    if fc_cos == 0 {
        fc_cos = mem_alloc(hd * 8)
        fc_sin = mem_alloc(hd * 8)
    }
    let base: f64 = f64of(fc_rope_base)
    let hd2: f64 = i2f(hd)
    let theta_scale: f64 = pow(base, (0.0 - 2.0) / hd2)
    // theta_scale is TYPED f64 on purpose. An untyped accumulator makes
    // `theta * theta_scale` an integer multiply over the bit patterns, which
    // corrupts theta after the first pair: pair 0 came out right and every later
    // pair was garbage. Verified against Python for pos=100.
    let theta: f64 = i2f(pos)
    let p = 0
    while p < half {
        mem_store(fc_cos + p * 8, cos(theta))
        mem_store(fc_sin + p * 8, sin(theta))
        theta = theta * theta_scale
        p = p + 1
    }
    return 0
}

// Rotate one head's worth of values in place. `v` holds head_dim f64 values.
fn fc_rope_apply(v: u64) {
    let hd = fc_head_dim
    let half = hd / 2
    let p = 0
    while p < half {
        let x0 = f64of(mem_load(v + p * 8))
        let x1 = f64of(mem_load(v + (p + half) * 8))
        let c = f64of(mem_load(fc_cos + p * 8))
        let s = f64of(mem_load(fc_sin + p * 8))
        mem_store(v + p * 8, x0 * c - x1 * s)
        mem_store(v + (p + half) * 8, x0 * s + x1 * c)
        p = p + 1
    }
    return 0
}

let fc_cos = 0
let fc_sin = 0

// ===========================================================================
// GQA ATTENTION PATH (the 8 attention layers)
//
// Transcribed from llama.cpp src/models/lfm2.cpp build_attn_block():
//
//   q = q_proj @ x                    [d_model, n_head * head_dim] = [2048, 2048]
//   k = k_proj @ x                    [d_model, n_kv  * head_dim] = [2048,  512]
//   v = v_proj @ x                    [d_model, n_kv  * head_dim] = [2048,  512]
//   q = rms_norm(q, attn_q_norm)      PER HEAD, over head_dim (64 elements)
//   k = rms_norm(k, attn_k_norm)      PER HEAD, over head_dim (64 elements)
//   q = rope(q, pos) ; k = rope(k, pos)
//   k, v are appended to the per-layer KV cache at `pos`
//   scores[h][t] = q[h] . k[t] / sqrt(head_dim)      for t in 0..pos
//   softmax over t
//   out[h] = sum_t scores[h][t] * v[t]
//   y = wo @ concat(out[0..n_head))
//
// n_head = 32, n_kv = 8, head_dim = 64, so 4 query heads share each KV head:
// query head h reads KV head h / 4. That mapping is the GQA group and getting it
// wrong still produces plausible numbers, just the wrong ones.
//
// Three details that each produce a plausible-but-wrong layer:
//
//   - q_norm/k_norm are PER HEAD over head_dim. attn_q_norm has 64 elements, not
//     2048, so normalizing the whole concatenated vector at once is a different
//     computation -- different scale, every score wrong.
//   - the scale is 1/sqrt(head_dim) = 1/8, applied to the scores BEFORE softmax,
//     not to q. Slightly wrong scale, plausible output.
//   - the softmax is over CACHED positions 0..pos inclusive, causal: never look
//     at a position that has not been written yet.

// scratch, allocated once (mem_alloc inside a loop is unsafe)
let fc_at_qn = 0
let fc_at_kn = 0
let fc_at_q = 0
let fc_at_k = 0
let fc_at_v = 0
let fc_at_sc = 0
let fc_at_h = 0
let fc_at_out = 0
// Which layer's attn_q_norm / attn_k_norm are currently in fc_at_qn / fc_at_kn.
// -1 = nothing loaded yet.
let fc_at_qn_L = 0 - 1

// Per-head RMSNorm over head_dim values. This is the shape attn_q_norm and
// attn_k_norm actually have (64 elements), NOT a whole-vector norm.
fn fc_rms_norm_head(out: u64, x: u64, w: u64, hd: i64) {
    if hd <= 0 { return 0 }
    let ss: f64 = 0.0
    let i = 0
    while i < hd {
        let v = f64of(mem_load(x + i * 8))
        ss = ss + v * v
        i = i + 1
    }
    let inv: f64 = 1.0 / sqrt(ss / i2f(hd) + fc_rms_eps)
    i = 0
    while i < hd {
        let xv = f64of(mem_load(x + i * 8))
        let wv = f64of(mem_load(w + i * 8))
        mem_store(out + i * 8, xv * inv * wv)
        i = i + 1
    }
    return 0
}

// One GQA attention layer at position `pos`.
//   x     d_model values (already attn_norm'd)
//   out   d_model values
//   state the KV cache, which must already be fc_kv_init()ed
fn fc_attention(L, pos, x: u64, out: u64) {
    let dm = fc_d_model
    let nh = fc_n_heads
    let nkv = fc_nkv_of(L)
    let hd = fc_head_dim
    if nkv <= 0 || hd <= 0 { return -1 }
    let qt = lfm2_attn_q(L)
    let kt = lfm2_attn_k(L)
    let vt = lfm2_attn_v(L)
    let qn = lfm2_attn_q_norm(L)
    let kn = lfm2_attn_k_norm(L)
    let wo = lfm2_attn_output(L)
    if qt < 0 || kt < 0 || vt < 0 || qn < 0 || kn < 0 || wo < 0 { return -1 }

    if fc_at_q == 0 {
        // The q_norm / k_norm accessors return a TENSOR INDEX, not a data
        // pointer -- mm_matvec takes an index, fc_rms_norm takes a pointer, and
        // passing the index straight through dereferences address 23 and faults.
        // Measured: lfm2_attn_q_norm(2) = 23; fc_rms_norm(..., 23, 64) segfaults,
        // while the same call with read_tensor_f64(23, buf) succeeds.
        fc_at_qn = mem_alloc(hd * 8)
        fc_at_kn = mem_alloc(hd * 8)
        read_tensor_f64(qn, fc_at_qn)
        read_tensor_f64(kn, fc_at_kn)
        fc_at_q = mem_alloc(nh * hd * 8)
        fc_at_k = mem_alloc(nkv * hd * 8)
        fc_at_v = mem_alloc(nkv * hd * 8)
        fc_at_h = mem_alloc(hd * 8)
        // Sized for the whole CONTEXT, not the current position. The buffers are
        // allocated once, on the first call, which is position 0 -- sizing this
        // (pos + 2) gave 2 entries, and the score loop then wrote and read indices
        // 0..pos for every later position, running off the end.
        //
        // That was invisible at pos 0, where the two agree, and showed up only
        // from pos 1 on: cos against a reference fell to ~0.46-0.57 instead of
        // 1.0. fc_kv_cap is set by fc_kv_init and is the right bound -- the score
        // vector can never be longer than the number of cached positions.
        fc_at_sc = mem_alloc(nh * (fc_kv_cap + 2) * 8)
        fc_at_out = mem_alloc(nh * hd * 8)
    }

    // ---- attn_q_norm / attn_k_norm: RELOAD whenever the layer changes --------
    //
    // These are PER-LAYER tensors (blk.L.attn_q_norm / blk.L.attn_k_norm, 64
    // values each) and every attention layer's pair is different. The BUFFERS are
    // allocated once above, but the DATA must be re-read for each layer. Reading
    // them only inside the `fc_at_q == 0` allocation block meant every attention
    // layer reused the FIRST attention layer's weights (layer 2).
    //
    // Measured on the 23-id prompt (tests/lfm2_prefill_probe.quanta +
    // tests/verify_lfm2_state_ref.py; the reference K row is reconstructed from the dumped
    // layer input with the real ggml row kernels):
    //   K row layer 2, pos 0: |native - correct ref|                = 9.8e-15
    //   K row layer 5, pos 0: |native - correct ref|                = 1.60e+01
    //   K row layer 5, pos 0: |native - ref built with LAYER 2's k_norm| = 5.3e-15
    // i.e. the stored keys were bit-for-bit what layer 2's k_norm produces.
    //
    // It is INVISIBLE at position 0: the softmax is over one cached position, so
    // the weight is 1 whatever q and k are and the attention output is just v.
    // From position 1 on it grows, because the wrongly-normed keys accumulate in
    // the K cache -- the "error grows with sequence position" signature.
    if fc_at_qn_L != L {
        read_tensor_f64(qn, fc_at_qn)
        read_tensor_f64(kn, fc_at_kn)
        fc_at_qn_L = L
    }

    // ---- projections -------------------------------------------------------
    // mm_matvec is column-major over [rows, cols], so row j of a [dm, N] tensor
    // is elements [j*dm, (j+1)*dm).
    if mm_matvec(qt, x, nh * hd, dm, fc_at_q) != 0 { return -1 }
    if mm_matvec(kt, x, nkv * hd, dm, fc_at_k) != 0 { return -1 }
    if mm_matvec(vt, x, nkv * hd, dm, fc_at_v) != 0 { return -1 }

    // ---- q_norm / k_norm, per head, BEFORE RoPE -----------------------------
    let h = 0
    while h < nh {
        if fc_rms_norm_head(fc_at_h, fc_at_q + h * hd * 8, fc_at_qn, hd) != 0 { return -1 }
        let c = 0
        while c < hd {
            mem_store(fc_at_q + (h * hd + c) * 8, f64of(mem_load(fc_at_h + c * 8)))
            c = c + 1
        }
        h = h + 1
    }
    h = 0
    while h < nkv {
        if fc_rms_norm_head(fc_at_h, fc_at_k + h * hd * 8, fc_at_kn, hd) != 0 { return -1 }
        let c = 0
        while c < hd {
            mem_store(fc_at_k + (h * hd + c) * 8, f64of(mem_load(fc_at_h + c * 8)))
            c = c + 1
        }
        h = h + 1
    }

    // ---- RoPE ---------------------------------------------------------------
    fc_rope_cache(pos)
    h = 0
    while h < nh {
        fc_rope_apply(fc_at_q + h * hd * 8)
        h = h + 1
    }
    h = 0
    while h < nkv {
        fc_rope_apply(fc_at_k + h * hd * 8)
        h = h + 1
    }

    // ---- append k, v to the cache -------------------------------------------
    h = 0
    while h < nkv {
        let c = 0
        while c < hd {
            fc_kv_put(L, 0, pos, h, c, f64of(mem_load(fc_at_k + (h * hd + c) * 8)))
            fc_kv_put(L, 1, pos, h, c, f64of(mem_load(fc_at_v + (h * hd + c) * 8)))
            c = c + 1
        }
        h = h + 1
    }

    // ---- scores, softmax, accumulate ----------------------------------------
    // 1/sqrt(head_dim) applied to the SCORES, before softmax.
    let scale: f64 = 1.0 / sqrt(i2f(hd))

    // Zero the per-head output accumulator before use.
    //
    // fc_at_out is a module-global scratch buffer allocated ONCE, and the
    // accumulation below reads it (`cur + w * v`). Nothing cleared it between
    // calls, so every call after the first returned the previous call's output
    // plus a second accumulation.
    //
    // Measured: calling fc_attention twice at pos 0 gave cos = 1.000000 on the
    // first and 0.498269 on the second against the same reference. Every
    // multi-position test disagreed from pos 1 onward for this reason, and a
    // single-call test cannot see it at all.
    //
    // Same class as the conv-state buffer earlier in this file, which IS
    // advanced per call -- here the buffer is reused accumulation state, not
    // carried state, so it must start at zero every time.
    h = 0
    while h < nh {
        let c = 0
        while c < hd {
            mem_store(fc_at_out + (h * hd + c) * 8, 0.0)
            c = c + 1
        }
        h = h + 1
    }
    h = 0
    while h < nh {
        // GQA: query heads 4h..4h+3 share KV head h.
        let kvh = h / (nh / nkv)
        let qb = fc_at_q + h * hd * 8

        // max, for a stable softmax
        let t = 0
        let mx: f64 = 0.0 - 1e300
        while t <= pos {
            let acc: f64 = 0.0
            let c = 0
            while c < hd {
                acc = acc + f64of(mem_load(qb + c * 8)) * fc_kv_get(L, 0, t, kvh, c)
                c = c + 1
            }
            let sc = acc * scale
            mem_store(fc_at_sc + t * 8, sc)
            if sc > mx { mx = sc }
            t = t + 1
        }

        // exp and sum
        let sum: f64 = 0.0
        t = 0
        while t <= pos {
            let e = expf(f64of(mem_load(fc_at_sc + t * 8)) - mx)
            mem_store(fc_at_sc + t * 8, e)
            sum = sum + e
            t = t + 1
        }
        if sum == 0.0 { return -1 }

        // weighted sum of v
        t = 0
        while t <= pos {
            let w = f64of(mem_load(fc_at_sc + t * 8)) / sum
            let c = 0
            while c < hd {
                let cur = f64of(mem_load(fc_at_out + (h * hd + c) * 8))
                mem_store(fc_at_out + (h * hd + c) * 8, cur + w * fc_kv_get(L, 1, t, kvh, c))
                c = c + 1
            }
            t = t + 1
        }
        h = h + 1
    }

    // ---- out projection -----------------------------------------------------
    return mm_matvec(wo, fc_at_out, dm, nh * hd, out)
}

// ===========================================================================
// PARALLEL ATTENTION BODY (scores/softmax/accumulate per query head)
//
// The 24 query heads are independent. Split across workers.
// Each worker processes a slice of heads: computes scores, softmax, and
// weighted sum for its assigned heads. Requires the Q/K/V projections
// and q_norm/k_norm/RoPE/KV append to already be done.
//
// Worker function: processes heads [lo, hi)
fn patt_worker(t: i64) -> i64 {
    let lo = patt_lo + t * patt_per
    let hi = lo + patt_per
    if t == patt_nworkers - 1 { hi = patt_nh }
    if hi > patt_nh { hi = patt_nh }

    let dm = patt_dm
    let nh = patt_nh
    let nkv = patt_nkv
    let hd = patt_hd
    let pos = patt_pos
    
    let L = patt_L

    let scale: f64 = 1.0 / sqrt(i2f(hd))
    let h = lo
    while h < hi {
        let kvh = h / (nh / nkv)
        let qb = fc_at_q + h * hd * 8
        let ob = fc_at_out + h * hd * 8
        // Per-head score buffer: fc_at_sc is shared but we use head's slice
        let sc_base = fc_at_sc + h * (patt_kv_cap + 2) * 8

        // max for stable softmax
        let t_idx = 0
        let mx: f64 = 0.0 - 1e300
        while t_idx <= pos {
            let acc: f64 = 0.0
            let c = 0
            while c < hd {
                acc = acc + f64of(mem_load(qb + c * 8)) * fc_kv_get(L, 0, t_idx, kvh, c)
                c = c + 1
            }
            let sc = acc * scale
            mem_store(sc_base + t_idx * 8, sc)
            if sc > mx { mx = sc }
            t_idx = t_idx + 1
        }

        // exp and sum
        let sum: f64 = 0.0
        t_idx = 0
        while t_idx <= pos {
            let e = expf(f64of(mem_load(sc_base + t_idx * 8)) - mx)
            mem_store(sc_base + t_idx * 8, e)
            sum = sum + e
            t_idx = t_idx + 1
        }
        if sum == 0.0 { return -1 }

        // weighted sum of v
        t_idx = 0
        while t_idx <= pos {
            let w = f64of(mem_load(sc_base + t_idx * 8)) / sum
            let c = 0
            while c < hd {
                let cur = f64of(mem_load(ob + c * 8))
                mem_store(ob + c * 8, cur + w * fc_kv_get(L, 1, t_idx, kvh, c))
                c = c + 1
            }
            t_idx = t_idx + 1
        }
        h = h + 1
    }
    return 0
}

// Parallel attention body: q_norm, k_norm, RoPE, KV append, scores/softmax/accumulate
fn fc_attention_par(L, pos, x: u64, out: u64) {
    let dm = fc_d_model
    let nh = fc_n_heads
    let nkv = fc_nkv_of(L)
    let hd = fc_head_dim
    if nkv <= 0 || hd <= 0 { return -1 }
    let qt = lfm2_attn_q(L)
    let kt = lfm2_attn_k(L)
    let vt = lfm2_attn_v(L)
    let qn = lfm2_attn_q_norm(L)
    let kn = lfm2_attn_k_norm(L)
    let wo = lfm2_attn_output(L)
    if qt < 0 || kt < 0 || vt < 0 || qn < 0 || kn < 0 || wo < 0 { return -1 }

    if fc_at_q == 0 {
        fc_at_qn = mem_alloc(hd * 8)
        fc_at_kn = mem_alloc(hd * 8)
        read_tensor_f64(qn, fc_at_qn)
        read_tensor_f64(kn, fc_at_kn)
        fc_at_q = mem_alloc(nh * hd * 8)
        fc_at_k = mem_alloc(nkv * hd * 8)
        fc_at_v = mem_alloc(nkv * hd * 8)
        fc_at_h = mem_alloc(hd * 8)
        fc_at_sc = mem_alloc(nh * (fc_kv_cap + 2) * 8)
        fc_at_out = mem_alloc(nh * hd * 8)
    }

    // Per-layer norm weights: reload when the layer changes. See the long note in
    // fc_attention; the same defect was here.
    if fc_at_qn_L != L {
        read_tensor_f64(qn, fc_at_qn)
        read_tensor_f64(kn, fc_at_kn)
        fc_at_qn_L = L
    }

    // ---- projections (already parallel via mm_matvec) -----------------------
    if mm_matvec(qt, x, nh * hd, dm, fc_at_q) != 0 { return -1 }
    if mm_matvec(kt, x, nkv * hd, dm, fc_at_k) != 0 { return -1 }
    if mm_matvec(vt, x, nkv * hd, dm, fc_at_v) != 0 { return -1 }

    // ---- q_norm / k_norm, per head, BEFORE RoPE -----------------------------
    let h = 0
    while h < nh {
        if fc_rms_norm_head(fc_at_h, fc_at_q + h * hd * 8, fc_at_qn, hd) != 0 { return -1 }
        let c = 0
        while c < hd {
            mem_store(fc_at_q + (h * hd + c) * 8, f64of(mem_load(fc_at_h + c * 8)))
            c = c + 1
        }
        h = h + 1
    }
    h = 0
    while h < nkv {
        if fc_rms_norm_head(fc_at_h, fc_at_k + h * hd * 8, fc_at_kn, hd) != 0 { return -1 }
        let c = 0
        while c < hd {
            mem_store(fc_at_k + (h * hd + c) * 8, f64of(mem_load(fc_at_h + c * 8)))
            c = c + 1
        }
        h = h + 1
    }

    // ---- RoPE ---------------------------------------------------------------
    fc_rope_cache(pos)
    h = 0
    while h < nh {
        fc_rope_apply(fc_at_q + h * hd * 8)
        h = h + 1
    }
    h = 0
    while h < nkv {
        fc_rope_apply(fc_at_k + h * hd * 8)
        h = h + 1
    }

    // ---- append k, v to the cache -------------------------------------------
    h = 0
    while h < nkv {
        let c = 0
        while c < hd {
            fc_kv_put(L, 0, pos, h, c, f64of(mem_load(fc_at_k + (h * hd + c) * 8)))
            fc_kv_put(L, 1, pos, h, c, f64of(mem_load(fc_at_v + (h * hd + c) * 8)))
            c = c + 1
        }
        h = h + 1
    }

    // ---- scores, softmax, accumulate (PARALLEL) -----------------------------
    let scale: f64 = 1.0 / sqrt(i2f(hd))

    // Zero the per-head output accumulator before use.
    h = 0
    while h < nh {
        let c = 0
        while c < hd {
            mem_store(fc_at_out + (h * hd + c) * 8, 0.0)
            c = c + 1
        }
        h = h + 1
    }

    if fc_attn_workers > 1 && nh / fc_attn_workers >= 1 {
        // Static partitioning across workers
        patt_lo = 0
        patt_per = nh / fc_attn_workers
        patt_nh = nh
        patt_nworkers = fc_attn_workers
        patt_dm = dm
        patt_nkv = nkv
        patt_hd = hd
        patt_pos = pos
        
        patt_L = L
        patt_kv_cap = fc_kv_cap

        let slots = mem_alloc(fc_attn_workers * 8)
        let t = 0
        while t < fc_attn_workers {
            mem_store(slots + t * 8, thread_create(patt_worker, t))
            t = t + 1
        }
        t = 0
        while t < fc_attn_workers {
            if thread_join(mem_load(slots + t * 8)) < 0 { return -1 }
            t = t + 1
        }
    } else {
        // Serial fallback (the original loop)
        let scale: f64 = 1.0 / sqrt(i2f(hd))
        h = 0
        while h < nh {
            let kvh = h / (nh / nkv)
            let qb = fc_at_q + h * hd * 8

            let t_idx = 0
            let mx: f64 = 0.0 - 1e300
            while t_idx <= pos {
                let acc: f64 = 0.0
                let c = 0
                while c < hd {
                    acc = acc + f64of(mem_load(qb + c * 8)) * fc_kv_get(L, 0, t_idx, kvh, c)
                    c = c + 1
                }
                let sc = acc * scale
                mem_store(fc_at_sc + t_idx * 8, sc)
                if sc > mx { mx = sc }
                t_idx = t_idx + 1
            }

            let sum: f64 = 0.0
            t_idx = 0
            while t_idx <= pos {
                let e = expf(f64of(mem_load(fc_at_sc + t_idx * 8)) - mx)
                mem_store(fc_at_sc + t_idx * 8, e)
                sum = sum + e
                t_idx = t_idx + 1
            }
            if sum == 0.0 { return -1 }

            t_idx = 0
            while t_idx <= pos {
                let w = f64of(mem_load(fc_at_sc + t_idx * 8)) / sum
                let c = 0
                while c < hd {
                    let cur = f64of(mem_load(fc_at_out + (h * hd + c) * 8))
                    mem_store(fc_at_out + (h * hd + c) * 8, cur + w * fc_kv_get(L, 1, t_idx, kvh, c))
                    c = c + 1
                }
                t_idx = t_idx + 1
            }
            h = h + 1
        }
    }

    // ---- out projection -----------------------------------------------------
    return mm_matvec(wo, fc_at_out, dm, nh * hd, out)
}

// Globals for patt_worker
let patt_lo = 0
let patt_per = 0
let patt_nh = 0
let patt_nworkers = 0
let patt_dm = 0
let patt_nkv = 0
let patt_hd = 0
let patt_pos = 0

let patt_L = 0
let patt_kv_cap = 0

// ===========================================================================
// LAYER FORWARD + TOKEN GENERATION
//
// Composed from llama.cpp src/models/lfm2.cpp (the graph loop). The block is:
//
//   inp  = cur
//   cur  = attn_norm(cur)                          (RMS, eps)
//   cur  = is_recr ? shortconv(cur) : attention(cur, pos)
//   cur  = inp + cur                               residual
//   fn   = ffn_norm(cur)                           (RMS, eps)
//   fn   = ffn_down(silu(ffn_gate(fn)) * ffn_up(fn))
//   cur  = cur + fn                                residual
//
// then output_norm, then the (TIED) output projection.
//
// TENSOR FACTS, measured from this checkpoint (266 tensors):
//   - token_embd.weight and token_embd_norm.weight are the ONLY global tensors.
//   - There is NO output.weight and NO output_norm.weight. LFM2 ties the output
//     projection to token_embd, and the final norm is token_embd_norm -- the
//     comment in llama.cpp's arch table says "fix for wrong tensor name".
//     Looking for output_norm.weight finds nothing and the run dies at step one.
// ===========================================================================

let fc_fw_x = 0        // current hidden state [d_model]
let fc_fw_n = 0        // normed scratch      [d_model]
let fc_fw_a = 0        // branch output       [d_model]
let fc_fw_f = 0        // ffn intermediate    [d_ff]
let fc_fw_ff = 0       // ffn output          [d_model]
let fc_fw_logits = 0   // logits              [n_vocab]
let fc_fw_conv = 0     // per-layer conv state [dc * d_model]
let fc_fw_ready = 0
let fc_fw_last = 0     // last hidden state produced (for callers skipping logits)
let fc_attn_workers = 0  // worker count for parallel attention body

fn fc_fw_init() {
    if fc_fw_ready != 0 { return 0 }
    if fc_ready == 0 { return -1 }
    let dm = fc_d_model
    let dff = fc_d_ff
    let dc = fc_conv_width - 1
    fc_fw_x = mem_alloc(dm * 8)
    fc_fw_n = mem_alloc(dm * 8)
    fc_fw_a = mem_alloc(dm * 8)
    fc_fw_ff = mem_alloc(dm * 8)
    fc_fw_f = mem_alloc(dff * 8)
    fc_fw_logits = mem_alloc(fc_n_vocab * 8)
    // ONE conv-state buffer per layer, allocated up front. mem_alloc inside a
    // loop is unsafe (the next iteration clobbers the pointer), so this is a
    // single flat block indexed by layer.
    fc_fw_conv = mem_alloc(fc_n_layers * dc * dm * 8)
    fc_fw_ready = 1
    return 0
}

fn fc_fw_conv_state(L) {
    let dc = fc_conv_width - 1
    return fc_fw_conv + L * dc * fc_d_model * 8
}

// Zero every recurrent conv state. Must be called before a fresh sequence:
// the state is carried across positions, so a stale one from a previous run
// silently contaminates the first tokens.
fn fc_fw_reset() {
    if fc_fw_ready == 0 { return -1 }
    let dc = fc_conv_width - 1
    let total = fc_n_layers * dc * fc_d_model
    let i = 0
    while i < total { mem_store(fc_fw_conv + i * 8, 0.0); i = i + 1 }
    fc_kv_reset()
    return 0
}

// One layer. `pos` is the sequence position (drives RoPE and the KV append).
fn fc_layer(L, pos, inp: u64, out: u64) -> i64 {
    let dm = fc_d_model
    let dff = fc_d_ff

    // ---- pre-norm ----
    let an = lfm2_attn_norm(L)
    if an < 0 { return -1 }
    // lfm2_attn_norm returns a TENSOR INDEX; fc_rms_norm wants a POINTER.
    // Passing the index straight through dereferences a low address and faults.
    // read_tensor_f64 materialises it once, into the shared scratch.
    if fc_fw_normbuf == 0 { fc_fw_normbuf = mem_alloc(2 * dm * 8) }
    if read_tensor_f64(an, fc_fw_normbuf) < 0 { return -1 }
    if fc_rms_norm(fc_fw_n, inp, fc_fw_normbuf, dm) != 0 { return -1 }

    // ---- branch: short conv or attention ----
    if lfm2_layer_is_attn(L) != 0 {
        if fc_attn_workers > 1 {
            if fc_attention_par(L, pos, fc_fw_n, fc_fw_a) != 0 { return -1 }
        } else {
            if fc_attention(L, pos, fc_fw_n, fc_fw_a) != 0 { return -1 }
        }
    } else {
        if fc_short_conv(L, fc_fw_n, fc_fw_conv_state(L), fc_fw_a) != 0 { return -1 }
    }

    // ---- residual ----
    let i = 0
    while i < dm {
        let p = f64of(mem_load(inp + i * 8))
        let a = f64of(mem_load(fc_fw_a + i * 8))
        mem_store(fc_fw_x + i * 8, p + a)
        i = i + 1
    }

    // ---- ffn pre-norm ----
    let fnt = lfm2_ffn_norm(L)
    if fnt < 0 { return -1 }
    if read_tensor_f64(fnt, fc_fw_normbuf) < 0 { return -1 }
    if fc_rms_norm(fc_fw_n, fc_fw_x, fc_fw_normbuf, dm) != 0 { return -1 }

    // ---- ffn: down(silu(gate(x)) * up(x)) ----
    let gt = lfm2_ffn_gate(L)
    let ut = lfm2_ffn_up(L)
    let dt = lfm2_ffn_down(L)
    if gt < 0 || ut < 0 || dt < 0 { return -1 }
    if fc_ffn_f_gate == 0 {
        fc_ffn_f_gate = mem_alloc(dff * 8)
        fc_ffn_f_up = mem_alloc(dff * 8)
    }
    if mm_matvec(gt, fc_fw_n, dff, dm, fc_ffn_f_gate) != 0 { return -1 }
    if mm_matvec(ut, fc_fw_n, dff, dm, fc_ffn_f_up) != 0 { return -1 }
    i = 0
    while i < dff {
        let g = f64of(mem_load(fc_ffn_f_gate + i * 8))
        // silu(g) = g * sigmoid(g)
        let sg: f64 = 1.0 / (1.0 + expf(0.0 - g))
        let uv = f64of(mem_load(fc_ffn_f_up + i * 8))
        mem_store(fc_fw_f + i * 8, g * sg * uv)
        i = i + 1
    }
    if mm_matvec(dt, fc_fw_f, dm, dff, fc_fw_ff) != 0 { return -1 }

    // ---- second residual ----
    i = 0
    while i < dm {
        let c = f64of(mem_load(fc_fw_x + i * 8))
        let f = f64of(mem_load(fc_fw_ff + i * 8))
        mem_store(out + i * 8, c + f)
        i = i + 1
    }
    return 0
}

let fc_fw_normbuf = 0
let fc_ffn_f_gate = 0
let fc_ffn_f_up = 0

// One token's embedding row -> fc_fw_x, then the whole stack.
// Returns 0 on success. Logits land in fc_fw_logits (n_vocab values).
//
// `want_logits` = 0 skips the final norm and the tied output projection.
//
// WHY THIS EXISTS: the output projection is 128000 rows per call, which is by
// far the most expensive single step -- and during PREFILL only the LAST
// position's logits are ever read. Computing them at every prompt position is
// pure waste: a 46-token prompt was doing 46 full-vocab projections instead of
// one, which is why a templated prefill could not finish inside a 870 s cap.
// Decode must pass 1; prefill passes 0 except on the final token.
fn fc_forward_token_body(tok: i64, pos: i64, want_logits: i64) -> i64 {
    if fc_fw_init() != 0 { return -1 }
    let dm = fc_d_model
    let emb = lfm2_token_embd()
    if emb < 0 { return -1 }

    // embedding lookup: row `tok` of token_embd.weight, which is [n_vocab, dm]
    if mm_lookup_row(emb, tok, dm, fc_fw_x) != 0 { return -1 }

    // layer stack: ping-pong between two buffers
    let L = 0
    let src = fc_fw_x
    let dst = fc_fw_ff
    while L < fc_n_layers {
        if fc_layer(L, pos, src, dst) != 0 { return -1 }
        // swap
        let t = src
        src = dst
        dst = t
        L = L + 1
    }

    if want_logits == 0 {
        // The caller only needs the recurrent/KV state advanced. The final
        // hidden state stays in `src`, which is fc_fw_x or fc_fw_ff depending on
        // parity -- callers that skip logits must not read fc_fw_logits.
        fc_fw_last = src
        return 0
    }

    // final norm: token_embd_norm (NOT output_norm -- see the note above)
    let on = lfm2_token_embd_norm()
    if on < 0 { return -1 }
    if read_tensor_f64(on, fc_fw_normbuf) < 0 { return -1 }
    if fc_rms_norm(fc_fw_n, src, fc_fw_normbuf, dm) != 0 { return -1 }

    // TIED output projection: logits = token_embd @ normed. Over the full
    // vocabulary this is 128000 rows per token, which dominates generation, so
    // the caller may instead sample from a window (mm_embed_logits).
    if mm_embed_logits(emb, fc_fw_n, 0, fc_n_vocab, dm, fc_fw_logits) != 0 { return -1 }
    fc_fw_last = fc_fw_n
    return 0
}

// One token's forward, with the parallel worker pool held for the call.
//
// The pool is bracketed here so a caller gets the amortisation automatically
// and the pool is torn down before this returns: the runtime ends main with
// exit(60), not exit_group(231), so a worker thread left alive WOULD hang the
// process. A generation loop that wants the stacks paid once per process wraps
// its loop in mm_pool_begin()/mm_pool_end() -- begin/end nest by depth, so the
// bracket here then costs nothing.
fn fc_forward_token_ex(tok: i64, pos: i64, want_logits: i64) -> i64 {
    mm_pool_begin()
    let r = fc_forward_token_body(tok, pos, want_logits)
    mm_pool_end()
    return r
}

fn fc_forward_token(tok: i64, pos: i64) -> i64 {
    return fc_forward_token_ex(tok, pos, 1)
}
// Argmax over the first `n` logits. Returns the winning index.
fn fc_argmax(n: i64) -> i64 {
    let best = 0
    let bestv: f64 = f64of(mem_load(fc_fw_logits))
    let i = 1
    while i < n {
        let v: f64 = f64of(mem_load(fc_fw_logits + i * 8))
        if v > bestv { bestv = v; best = i }
        i = i + 1
    }
    return best
}
