// lib/std/lfm2_forward.quanta -- native LFM2 forward pass, one token at a time.
//
// Configuration is read from the model, never hardcoded. Measured from
// QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf:
//
//   lfm2.embedding_length                    2048      d_model
//   lfm2.feed_forward_length                 10752     d_ff
//   lfm2.block_count                         30
//   lfm2.vocab_size                          128000
//   lfm2.attention.head_count                32        query heads
//   lfm2.attention.head_count_kv             per layer: 8 on attention layers
//   lfm2.rope.freq_base                      1e7
//   lfm2.attention.layer_norm_rms_epsilon    1e-5
//   lfm2.shortconv.l_cache                   3         causal conv width
//   general.file_type                        15        Q4_K_M
//
// head_dim = d_model / head_count = 64. The attention layers run 32 query heads
// over 8 KV heads, so 4 queries share each KV head. Conv layers have no
// attention at all.
//
// Memory: no weight is ever fully materialised. Every matvec goes through
// lfm2_mm, which reads one row at a time, so peak cost is the widest single row
// (1 MB for the embedding) rather than the 20 GB of weights.
//
// MEMORY ACCESS CONVENTION
// ------------------------
// A Quanta pointer is a raw address. Read f64 with f64of(mem_load(p + i * 8)),
// write with mem_store(p + i * 8, v). Indexing p[i] faults. A typed `f64` local
// holds a float bit-pattern; an UNTYPED `acc` turns arithmetic into integer
// operations and trips the overflow trap (SIGILL, exit 132). print() shows the
// bit pattern -- use pf64() from std/math to see a float.

import std/gguf
import std/lfm2_model
import std/lfm2_mm
import std/math

// f32 metadata (rope.freq_base, layer_norm_rms_epsilon) comes back through
// gguf_kv_float(), which already widens f32 to f64. Do NOT hand-roll this: an
// earlier version read the raw bytes out of gguf_kv_int(), which is documented to
// return -1 for a non-integer KV, and crashed.

// ---- configuration ---------------------------------------------------------
let fc_d_model = 0
let fc_d_ff = 0
let fc_n_layers = 0
let fc_n_heads = 0
let fc_head_dim = 0
let fc_n_ctx = 0
let fc_rope_base = 0.0
let fc_rms_eps = 0.0
let fc_conv_width = 0
let fc_n_vocab = 0
let fc_nkv_max = 0
let fc_ready = 0

let fc_nkv = 0            // per-layer KV head count, 0 = no attention

// short-conv scratch, allocated once on first use (mem_alloc in a loop is unsafe)
let fc_sc_ip = 0
let fc_sc_bx = 0
let fc_sc_g = 0
let fc_sc_k = 0
let fc_sc_y = 0
let fc_sc_kw = 0


fn fc_read_config() {
    if fc_ready != 0 { return 0 }

    fc_d_model = gguf_kv_int(gguf_kv_find("lfm2.embedding_length"))
    fc_d_ff = gguf_kv_int(gguf_kv_find("lfm2.feed_forward_length"))
    fc_n_layers = gguf_kv_int(gguf_kv_find("lfm2.block_count"))
    fc_n_heads = gguf_kv_int(gguf_kv_find("lfm2.attention.head_count"))
    fc_n_ctx = gguf_kv_int(gguf_kv_find("lfm2.context_length"))
    fc_n_vocab = gguf_kv_int(gguf_kv_find("lfm2.vocab_size"))
    fc_conv_width = gguf_kv_int(gguf_kv_find("lfm2.shortconv.l_cache"))

    fc_rope_base = gguf_kv_float(gguf_kv_find("lfm2.rope.freq_base"))
    fc_rms_eps = gguf_kv_float(gguf_kv_find("lfm2.attention.layer_norm_rms_epsilon"))

    if fc_d_model <= 0 || fc_n_heads <= 0 || fc_n_layers <= 0 { return -1 }
    fc_head_dim = fc_d_model / fc_n_heads
    if fc_head_dim * fc_n_heads != fc_d_model { return -1 }
    if fc_rope_base <= 0.0 { return -1 }
    if fc_rms_eps <= 0.0 { return -1 }

    if lfm2_build_table(fc_n_layers) <= 0 { return -1 }

    // n_kv is per layer in LFM2. Cross-check it against the descriptor table: a
    // layer claiming KV heads must actually have attn_k/attn_v tensors, and one
    // with no KV heads must not. If the two sources disagree, every attention
    // result would be garbage, so refuse rather than guess.
    fc_nkv = mem_alloc(fc_n_layers * 8)
    let kv = gguf_kv_find("lfm2.attention.head_count_kv")
    let i = 0
    while i < fc_n_layers { mem_store(fc_nkv + i * 8, 0); i = i + 1 }
    if kv >= 0 {
        // head_count_kv is an i32 array, NOT a string array: 4 bytes per element
        // with no length prefix. gguf_kv_arr_elem_bytes() walks length-prefixed
        // records and would read nonsense here, so slurp it as a fixed-stride i32
        // block starting at the array's own offset.
        let cnt = gguf_kv_arr_count_any(kv)
        if cnt > 0 && gguf_kv_arr_etype(kv) == 5 {
            // ONE cell for the whole loop: mem_alloc inside a loop is unsafe
            // because the next iteration clobbers the pointer.
            let cell = mem_alloc(8)
            i = 0
            while i < cnt && i < fc_n_layers {
                if gguf_kv_arr_elem_num(kv, i, cell) != 4 { return -1 }
                let v = mem_load(cell)
                mem_store(fc_nkv + i * 8, v)
                if v > fc_nkv_max { fc_nkv_max = v }
                i = i + 1
            }
        }
    }
    i = 0
    while i < fc_n_layers {
        let want = mem_load(fc_nkv + i * 8)
        let has = lfm2_layer_is_attn(i)
        if want > 0 && has == 0 { return -1 }
        if want == 0 && has != 0 { return -1 }
        i = i + 1
    }
    if fc_nkv_max <= 0 { return -1 }

    mm_init(fc_n_vocab)
    fc_ready = 1
    return 0
}

fn fc_nkv_of(L) { return mem_load(fc_nkv + L * 8) }

// ---- RMSNorm WITH epsilon --------------------------------------------------
// gguf.quanta's rms_norm(out, x, w, n) computes x * rsqrt(mean(x^2)) * w with NO
// epsilon. Verified: on x = all 1e-3 it returns 1.000000, where an eps of 1e-5
// would give 0.952379. Upstream applies
// lfm2.attention.layer_norm_rms_epsilon, so on a small activation the missing
// term is a 5% error. This version adds it.
fn fc_rms_norm(out: u64, x: u64, w: u64, n: i64) {
    if n <= 0 { return 0 }
    let ss: f64 = 0.0
    let i = 0
    while i < n {
        let v = f64of(mem_load(x + i * 8))
        ss = ss + v * v
        i = i + 1
    }
    let inv: f64 = 1.0 / sqrt(ss / i2f(n) + fc_rms_eps)
    i = 0
    while i < n {
        let xv = f64of(mem_load(x + i * 8))
        let wv = f64of(mem_load(w + i * 8))
        mem_store(out + i * 8, xv * inv * wv)
        i = i + 1
    }
    return 0
}
// ===========================================================================
// SHORT CONVOLUTION PATH (the 22 conv layers)
//
// Transcribed from llama.cpp src/models/lfm2.cpp, build_shortconv_block(),
// which is authoritative:
//
//   d_conv = l_cache - 1 = 2                  STATE width
//   bcx    = in_proj @ x                      [d_model, 3 * d_model]
//   split  bcx into b, c, x                   each d_model wide
//   bx     = transpose(b * x)                the gated pre-activation
//   bx     = concat(conv_state, bx)           causal: state PREPENDED -> 3 wide
//   state' = the last 2 positions of bx
//   out    = ssm_conv(bx, conv.weight)
//   y      = c * out
//   y      = out_proj @ y
//
// The three details that are easy to get wrong:
//
//   - The state is PREPENDED, not appended. Getting that backwards shifts the
//     convolution by one position, which is a plausible-looking but wrong answer.
//
//   - b and x are MULTIPLIED before the convolution, and c gates the OUTPUT.
//     Both gates are separate tensors; applying only one leaves the layer
//     roughly half-right, which is very hard to spot.
//
//   - conv.weight is [l_cache, d_model] = [3, 2048], NOT [d_conv, d_model].
//     d_conv = 2 is the STATE width; the kernel has all 3 taps. Verified in
//     llama.cpp: create_tensor(..., {n_shortconv_l_cache, n_embd}, 0).
//     A version here that sized the kernel by d_conv silently loaded the wrong
//     number of elements; mm_load_small()'s element-count check caught it.
//
// The kernel is applied as a CORRELATION with taps in increasing time order
// (ggml_compute_forward_ssm_conv_f32: `sumf += s[i0] * c[i0]` over nc taps).
// With the causal window [s0, s1, g] the output is
//   k0*s0 + k1*s1 + k2*g
// and the new state is (s1, g).

// One short-conv layer. `x` is d_model values, `state` holds 2 * d_model values
// (state[k * d_model + c] is token t-1-k for channel c). Returns 0 on success.
fn fc_short_conv(L, x: u64, state: u64, out: u64) {
    let dm = fc_d_model
    let dc = fc_conv_width - 1          // 2: STATE width
    let kw = fc_conv_width               // 3: KERNEL width (l_cache, not d_conv)
    let cin = lfm2_conv_in_proj(L)
    let cwt = lfm2_conv_conv(L)
    let cout = lfm2_conv_out_proj(L)
    if cin < 0 || cwt < 0 || cout < 0 { return -1 }

    if fc_sc_ip == 0 {
        // in_proj is [d_model, 3*d_model], so in_proj @ x yields 3 * d_model
        // values -- NOT d_model * 3 * d_model. The output is one column.
        fc_sc_ip = mem_alloc(3 * dm * 8)
        fc_sc_bx = mem_alloc(kw * dm * 8)         // state + current, time-major
        fc_sc_kw = mem_alloc(kw * dm * 8)         // dequantized kernel
        fc_sc_g = mem_alloc(dm * 8)               // b * x
        fc_sc_k = mem_alloc(dm * 8)               // conv output
        fc_sc_y = mem_alloc(dm * 8)
    }

    // bcx = in_proj @ x  -> [3 * d_model]
    if mm_matvec(cin, x, dm * 3, dm, fc_sc_ip) != 0 { return -1 }

    // Gate: bx[t] = b[t] * x[t], reading the three chunks in order.
    let cs = dm
    let t = 0
    while t < dm {
        let bv = f64of(mem_load(fc_sc_ip + t * 8))
        let xv = f64of(mem_load(fc_sc_ip + (2 * cs + t) * 8))
        mem_store(fc_sc_g + t * 8, bv * xv)
        t = t + 1
    }

    // Prepend the causal state: bx = [state[0..dc), g[0..dm)] along time.
    t = 0
    while t < dc {
        let c = 0
        while c < dm {
            mem_store(fc_sc_bx + (t * dm + c) * 8, f64of(mem_load(state + (t * dm + c) * 8)))
            c = c + 1
        }
        t = t + 1
    }
    t = 0
    while t < dm {
        mem_store(fc_sc_bx + (dc * dm + t) * 8, f64of(mem_load(fc_sc_g + t * 8)))
        t = t + 1
    }

    // conv_out[c] = sum_k conv[k][c] * bx[t_last - k][c]
    //
    // The kernel is [l_cache, d_model] = [3, 2048] = 6144 elements, small enough
    // to dequantize whole. out_proj is [d_model, d_model] = 4.2 M elements and
    // goes through the row-wise matvec instead. Both are under mm_small_cap; a
    // weight that were not returns -1 rather than silently materializing 20 GB.
    if mm_load_small(cwt, kw * dm, fc_sc_kw) != kw * dm { return -1 }

    // One output time step, correlation with taps in increasing time order:
    //   k0*s0 + k1*s1 + k2*g
    let c = 0
    while c < dm {
        let acc: f64 = 0.0
        let k = 0
        while k < kw {
            let w = f64of(mem_load(fc_sc_kw + (k * dm + c) * 8))
            acc = acc + w * f64of(mem_load(fc_sc_bx + (k * dm + c) * 8))
            k = k + 1
        }
        mem_store(fc_sc_k + c * 8, acc)
        c = c + 1
    }

    // New state: the LAST dc positions of the 3-wide window, i.e. (s1, g).
    // Positions dc-1 .. kw-1, so the oldest retained token drops out each call.
    t = 0
    while t < dc {
        let c = 0
        while c < dm {
            mem_store(state + (t * dm + c) * 8, f64of(mem_load(fc_sc_bx + ((dc - 1 + t) * dm + c) * 8)))
            c = c + 1
        }
        t = t + 1
    }

    // y = c * conv_out, then out_proj @ y
    t = 0
    while t < dm {
        let cv = f64of(mem_load(fc_sc_ip + (cs + t) * 8))
        mem_store(fc_sc_y + t * 8, cv * f64of(mem_load(fc_sc_k + t * 8)))
        t = t + 1
    }
    return mm_matvec(cout, fc_sc_y, dm, dm, out)
}

// ===========================================================================
// GQA ATTENTION PATH (the 8 attention layers)
//
// Transcribed from llama.cpp src/models/lfm2.cpp build_attn_block():
//
//   q = q_proj @ x        [d_model, n_head * head_dim]  = [2048, 2048]
//   k = k_proj @ x        [d_model, n_kv  * head_dim]  = [2048,  512]
//   v = v_proj @ x        [d_model, n_kv  * head_dim]  = [2048,  512]
//   q = rms_norm(q, attn_q_norm)     per HEAD, over head_dim
//   k = rms_norm(k, attn_k_norm)     per HEAD, over head_dim
//   q = rope(q, pos);  k = rope(k, pos)
//   k,v are appended to the per-layer KV cache
//   scores[h] = q[h] . k[t]/sqrt(head_dim)   for every cached t <= pos
//   softmax over t
//   out[h] = sum_t scores[h][t] * v[t]
//   y = out_proj @ concat(out[0..n_head))
//
// n_head = 32, n_kv = 8, head_dim = 64, so the GQA group is 4: query heads
// 4h..4h+3 share KV head h.
//
// Three details that each produce a plausible but wrong result:
//
//   - attn_q_norm / attn_k_norm are PER HEAD over head_dim (64 elements each),
//     NOT over d_model. Normalizing the whole 2048-wide vector at once gives a
//     different scale and silently wrecks every score.
//   - The RMSNorm here carries the epsilon (fc_rms_norm), like the others.
//   - No RoPE scaling: the model has NO lfm2.rope.scaling.* keys and no
//     lfm2.rope.dimension_count, so n_rot is the full head_dim and the only
//     parameter is freq_base = 1e7. Verified against the model's own metadata.
//
// RoPE convention is NEOX, and the pairing is HALF-SPLIT, not adjacent.
// From ggml's rotate_pairs():
//   for i0 in 0..n step 2:  ic = i0/2
//     x0 = src[ic],  x1 = src[ic + head_dim/2]
//     dst[ic]               = x0*cos - x1*sin
//     dst[ic + head_dim/2]  = x0*sin + x1*cos
// and from ggml_rope_cache_init():
//   theta starts at 1.0 and is multiplied by theta_scale = base^(-2/head_dim)
//   once per PAIR, so pair i uses theta = base^(-2i/head_dim)
// with cache[i0] = cos, cache[i0+1] = sin.
//
// Pairing element 0 with element 32 (head_dim/2) rather than element 0 with
// element 1 is the difference between a correct rotation and one that looks
// plausible but scrambles every head. head_dim = 64 is even, so all components
// are rotated.

// ---- KV cache -------------------------------------------------------------
// One contiguous block for every attention layer: layer L owns
//   kcache: n_kv * head_dim * n_ctx
//   vcache: n_kv * head_dim * n_ctx
// f64, NOT f32. Storing f32 would halve the footprint (1 GB vs 2 GB for the K
// cache of one attention layer at 131072 context), but there is no f64->f32
// narrowing conversion in the language -- only f32_to_f64() -- so an f32 cache
// needs a hand-rolled pack that is exactly where the f32_to_f64 bug came from.
// f64 is correct, simple and verifiable; narrowing can come later with a real
// conversion and a test that pins the rounding.

let fc_kvbuf = 0
let fc_kv_cap = 0        // max positions per layer
let fc_kv_len = 0        // positions currently filled

// Bytes one layer's K cache needs: n_kv * head_dim * 4 bytes in f32.
fn fc_kv_layer_stride() { return fc_nkv_max * fc_head_dim * 8 }

fn fc_kv_init(nctx) {
    if fc_kvbuf != 0 { return 0 }
    if fc_nkv_max <= 0 || fc_head_dim <= 0 { return -1 }
    fc_kv_cap = nctx
    // n_layers slots for K and the same again for V.
    fc_kvbuf = mem_alloc(fc_kv_layer_stride() * fc_n_layers * 2 + 4096)
    if fc_kvbuf == 0 { return -1 }
    fc_kv_len = 0
    return 0
}

fn fc_kv_reset() { fc_kv_len = 0 }

// K (or V) cache base for layer L: 0 = K, 1 = V.
// Absolute byte address of position `pos` of KV head `h` in layer L.
fn fc_kv_at(L, which, pos, h) {
    return fc_kvbuf + (which * fc_n_layers + L) * fc_kv_cap * fc_head_dim * 8
           + ((pos * fc_nkv_of(L) + h) * fc_head_dim) * 8
}

// Write one value into the KV cache.
fn fc_kv_put(L, which, pos, h, j, v) {
    mem_store(fc_kv_at(L, which, pos, h) + j * 8, v)
    return 0
}

// Read one value back out of the KV cache.
//
// The `-> f64` is REQUIRED, not decoration. An untyped return carries the value
// as a raw bit pattern, and a caller doing `want - got` against it gets INTEGER
// subtraction: verified, two identical float bit patterns subtracted to inf
// rather than 0.0. That silently turns a correct comparison into a garbage one,
// and the value only shows up as a wrong answer far downstream.
fn fc_kv_get(L, which, pos, h, j) -> f64 {
    return f64of(mem_load(fc_kv_at(L, which, pos, h) + j * 8))
}

// ---- RoPE -----------------------------------------------------------------

// Fill the cos/sin cache for one head position. `theta` accumulates the
// base^(-2i/head_dim) progression exactly as ggml_rope_cache_init does, rather
// than calling pow() per pair: one power and a multiply per pair instead of 32
// powers, and it matches ggml's own loop order.
fn fc_rope_cache(pos) {
    let hd = fc_head_dim
    let half = hd / 2
    if fc_cos == 0 {
        fc_cos = mem_alloc(hd * 8)
        fc_sin = mem_alloc(hd * 8)
    }
    // fc_rope_base is a module-level float global, and the vfloat table now
    // carries the tag for those (codegen: gfloat), so `pow(fc_rope_base, ...)`
    // takes the float path and reads the base's actual value.
    //
    // The workaround this replaces -- routing the base through i2f() -- was
    // needed while globals were untagged, and it was never more than that: i2f is
    // integer->float, so i2f(fc_rope_base) reinterpreted 1e7's bits as an integer
    // and produced inf, making theta_scale 1.0 and freezing every pair at the
    // same angle. Two compiler bugs were stacked on this one line.
    let hd2: f64 = i2f(hd)
    let theta_scale: f64 = pow(fc_rope_base, (0.0 - 2.0) / hd2)
    // theta_scale is TYPED f64 on purpose. An untyped accumulator makes
    // `theta * theta_scale` an integer multiply over the bit patterns, which
    // corrupts theta after the first pair: pair 0 came out right and every
    // later pair was garbage. Verified against Python for pos=100.
    let theta: f64 = i2f(pos)
    let p = 0
    while p < half {
        mem_store(fc_cos + p * 8, cos(theta))
        mem_store(fc_sin + p * 8, sin(theta))
        theta = theta * theta_scale
        p = p + 1
    }
    return 0
}

// Rotate one head's worth of values in place. `v` holds head_dim f64 values.
fn fc_rope_apply(v: u64) {
    let hd = fc_head_dim
    let half = hd / 2
    let p = 0
    while p < half {
        let x0 = f64of(mem_load(v + p * 8))
        let x1 = f64of(mem_load(v + (p + half) * 8))
        let c = f64of(mem_load(fc_cos + p * 8))
        let s = f64of(mem_load(fc_sin + p * 8))
        mem_store(v + p * 8, x0 * c - x1 * s)
        mem_store(v + (p + half) * 8, x0 * s + x1 * c)
        p = p + 1
    }
    return 0
}

let fc_cos = 0
let fc_sin = 0
