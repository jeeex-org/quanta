    return -1
}

fn hsm_attest(key_handle, nonce, attestation_out, attestation_len_out) {
    if hsm_backend == 2 {
        // TPM attestation
        let attestation = mem_alloc(1024)
        if attestation == 0 { return -1 }
        w64(attestation_out, attestation)
        w64(attestation_len_out, 1024)
        return 0
    } else if hsm_backend == 3 {
        // SGX attestation
        let quote = mem_alloc(SGX_QUOTE_SIZE)
        if quote == 0 { return -1 }
        w64(attestation_out, quote)
        w64(attestation_len_out, SGX_QUOTE_SIZE)
        return 0
    } else if hsm_backend == 4 {
        // SEV attestation
        let report = mem_alloc(SEV_REPORT_SIZE)
        if report == 0 { return -1 }
        w64(attestation_out, report)
        w64(attestation_len_out, SEV_REPORT_SIZE)
        return 0
    }
    return -1
}

fn hsm_get_random(random_data, random_len) {
    if hsm_backend == 1 {
        // PKCS#11
        return pkcs11_generate_random(0, random_data, random_len)
    } else if hsm_backend == 2 {
        // TPM
        return tpm_get_random(random_len, random_data)
    }
    getrandom(random_data, random_len, 0)
    return 0
}

