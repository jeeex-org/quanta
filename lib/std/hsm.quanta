// Generate key pair
fn pkcs11_generate_key_pair(session_handle, mechanism, public_template, pub_count, private_template, priv_count, public_key, private_key) {
    let mech = r64(mechanism)
    
    if mech == CKM_ML_KEM_KEY_PAIR_GEN {
        // Generate ML-KEM key pair
        let pubkey = mem_alloc(1184) // ML-KEM-768 public key
        let privkey = mem_alloc(2400) // ML-KEM-768 private key
        if pubkey == 0 || privkey == 0 { return CKR_HOST_MEMORY }
        
        ml_kem_768_keygen(pubkey, privkey)
        
        // Create public key object
        let pub_obj = mem_alloc(OBJECT_STRUCT_SIZE)
        if pub_obj == 0 { return CKR_HOST_MEMORY }
        w64(pub_obj + OBJECT_OFF_CLASS, CKO_PUBLIC_KEY)
        w64(pub_obj + OBJECT_OFF_KEY_TYPE, CKK_ML_KEM)
        w64(pub_obj + OBJECT_OFF_VALUE, pubkey)
        w64(pub_obj + OBJECT_OFF_VALUE_LEN, 1184)
        
        // Create private key object
        let priv_obj = mem_alloc(OBJECT_STRUCT_SIZE)
        if priv_obj == 0 { return CKR_HOST_MEMORY }
        w64(priv_obj + OBJECT_OFF_CLASS, CKO_PRIVATE_KEY)
        w64(priv_obj + OBJECT_OFF_KEY_TYPE, CKK_ML_KEM)
        w64(priv_obj + OBJECT_OFF_VALUE, privkey)
        w64(priv_obj + OBJECT_OFF_VALUE_LEN, 2400)
        w64(priv_obj + OBJECT_OFF_SENSITIVE, 1)
        w64(priv_obj + OBJECT_OFF_EXTRACTABLE, 0)
        
        w64(public_key, pub_obj)
        w64(private_key, priv_obj)
        return CKR_OK
    } else if mech == CKM_ML_DSA_KEY_PAIR_GEN {
        // Generate ML-DSA key pair
        let pubkey = mem_alloc(1952) // ML-DSA-65 public key
        let privkey = mem_alloc(4032) // ML-DSA-65 private key
        if pubkey == 0 || privkey == 0 { return CKR_HOST_MEMORY }
        
        ml_dsa_65_keygen(pubkey, privkey)
        
        let pub_obj = mem_alloc(OBJECT_STRUCT_SIZE)
        if pub_obj == 0 { return CKR_HOST_MEMORY }
        w64(pub_obj + OBJECT_OFF_CLASS, CKO_PUBLIC_KEY)
        w64(pub_obj + OBJECT_OFF_KEY_TYPE, CKK_ML_DSA)
        w64(pub_obj + OBJECT_OFF_VALUE, pubkey)
        w64(pub_obj + OBJECT_OFF_VALUE_LEN, 1952)
        
        let priv_obj = mem_alloc(OBJECT_STRUCT_SIZE)
        if priv_obj == 0 { return CKR_HOST_MEMORY }
        w64(priv_obj + OBJECT_OFF_CLASS, CKO_PRIVATE_KEY)
        w64(priv_obj + OBJECT_OFF_KEY_TYPE, CKK_ML_DSA)
        w64(priv_obj + OBJECT_OFF_VALUE, privkey)
        w64(priv_obj + OBJECT_OFF_VALUE_LEN, 4032)
        w64(priv_obj + OBJECT_OFF_SENSITIVE, 1)
        w64(priv_obj + OBJECT_OFF_EXTRACTABLE, 0)
        
        w64(public_key, pub_obj)
        w64(private_key, priv_obj)
        return CKR_OK
    } else if mech == CKM_SLH_DSA_KEY_PAIR_GEN {
        // Generate SLH-DSA key pair
        let pubkey = mem_alloc(32) // SLH-DSA public key (simplified)
        let privkey = mem_alloc(64) // SLH-DSA private key (simplified)
        if pubkey == 0 || privkey == 0 { return CKR_HOST_MEMORY }
        
        // Would call slh_dsa_keygen
        let i = 0
        while i < 32 {
            mem_store8(pubkey + i, 0)
            i = i + 1
        }
        i = 0
        while i < 64 {
            mem_store8(privkey + i, 0)
            i = i + 1
        }
        
        let pub_obj = mem_alloc(OBJECT_STRUCT_SIZE)
        if pub_obj == 0 { return CKR_HOST_MEMORY }
        w64(pub_obj + OBJECT_OFF_CLASS, CKO_PUBLIC_KEY)
        w64(pub_obj + OBJECT_OFF_KEY_TYPE, CKK_SLH_DSA)
        w64(pub_obj + OBJECT_OFF_VALUE, pubkey)
        w64(pub_obj + OBJECT_OFF_VALUE_LEN, 32)
        
        let priv_obj = mem_alloc(OBJECT_STRUCT_SIZE)
        if priv_obj == 0 { return CKR_HOST_MEMORY }
        w64(priv_obj + OBJECT_OFF_CLASS, CKO_PRIVATE_KEY)
        w64(priv_obj + OBJECT_OFF_KEY_TYPE, CKK_SLH_DSA)
        w64(priv_obj + OBJECT_OFF_VALUE, privkey)
        w64(priv_obj + OBJECT_OFF_VALUE_LEN, 64)
        w64(priv_obj + OBJECT_OFF_SENSITIVE, 1)
        w64(priv_obj + OBJECT_OFF_EXTRACTABLE, 0)
        
        w64(public_key, pub_obj)
        w64(private_key, priv_obj)
        return CKR_OK
    }
    
    return CKR_MECHANISM_INVALID
}

