// TPM 2.0 (ESAPI) interface
// TPM command codes
let TPM_CC_FIRST = 0x011F
let TPM_CC_CREATE_PRIMARY = 0x0131
let TPM_CC_CREATE = 0x0153
let TPM_CC_LOAD = 0x0157
let TPM_CC_READ_PUBLIC = 0x0173
let TPM_CC_GET_CAPABILITY = 0x017A
let TPM_CC_GET_RANDOM = 0x017B
let TPM_CC_HASH = 0x017D
let TPM_CC_HMAC = 0x017E
let TPM_CC_SIGN = 0x0182
let TPM_CC_VERIFY_SIGNATURE = 0x0183
let TPM_CC_QUOTE = 0x0184
let TPM_CC_PCR_EXTEND = 0x018D
let TPM_CC_PCR_READ = 0x018E
let TPM_CC_ATTEST = 0x018F

// TPM handle types
let TPM_RH_FIRST = 0x40000000
let TPM_RH_SRK = 0x40000000
let TPM_RH_OWNER = 0x40000001
let TPM_RH_ENDORSEMENT = 0x4000000B
let TPM_RH_PLATFORM = 0x4000000C
let TPM_RH_NULL = 0x40000007

// TPM context
