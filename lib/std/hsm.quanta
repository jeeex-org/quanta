// HSM health check
fn hsm_self_test() {
    if hsm_backend == 1 {
        return pkcs11_initialize(0) == CKR_OK ? 0 : -1
    } else if hsm_backend == 2 {
        return tpm_get_random(32, mem_alloc(32)) == 0 ? 0 : -1
    } else if hsm_backend == 3 || hsm_backend == 4 {
        return enclave_initialized == 1 ? 0 : -1
    }
    return -1
}