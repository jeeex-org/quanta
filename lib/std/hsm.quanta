// Slot structure
let SLOT_OFF_ID = 0
let SLOT_OFF_TOKEN_PRESENT = 8
let SLOT_OFF_TOKEN_LABEL = 16
let SLOT_OFF_TOKEN_MANUFACTURER = 24
let SLOT_OFF_TOKEN_MODEL = 32
let SLOT_OFF_TOKEN_SERIAL = 40
let SLOT_OFF_HW_VERSION_MAJOR = 48
let SLOT_OFF_HW_VERSION_MINOR = 56
let SLOT_OFF_FW_VERSION_MAJOR = 64
let SLOT_OFF_FW_VERSION_MINOR = 72
let SLOT_STRUCT_SIZE = 80

// Token structure
let TOKEN_OFF_LABEL = 0
let TOKEN_OFF_MANUFACTURER = 32
let TOKEN_OFF_MODEL = 64
let TOKEN_OFF_SERIAL = 96
let TOKEN_OFF_FLAGS = 128
let TOKEN_OFF_MAX_SESSIONS = 136
let TOKEN_OFF_SESSION_COUNT = 144
let TOKEN_OFF_MAX_RW_SESSIONS = 152
let TOKEN_OFF_RW_SESSION_COUNT = 160
let TOKEN_OFF_MAX_PIN_LEN = 168
let TOKEN_OFF_MIN_PIN_LEN = 176
let TOKEN_OFF_TOTAL_PUBLIC_MEMORY = 184
let TOKEN_OFF_FREE_PUBLIC_MEMORY = 192
let TOKEN_OFF_TOTAL_PRIVATE_MEMORY = 200
let TOKEN_OFF_FREE_PRIVATE_MEMORY = 208
let TOKEN_OFF_HW_VERSION_MAJOR = 216
let TOKEN_OFF_HW_VERSION_MINOR = 224
let TOKEN_OFF_FW_VERSION_MAJOR = 232
let TOKEN_OFF_FW_VERSION_MINOR = 240
let TOKEN_OFF_UTC_TIME = 248
let TOKEN_STRUCT_SIZE = 256

// Session structure
let SESSION_OFF_HANDLE = 0
let SESSION_OFF_SLOT_ID = 8
let SESSION_OFF_STATE = 16
let SESSION_OFF_FLAGS = 24
let SESSION_OFF_USER_TYPE = 32
let SESSION_OFF_OBJECTS = 40
let SESSION_STRUCT_SIZE = 48

// Object structure
let OBJECT_OFF_HANDLE = 0
let OBJECT_OFF_CLASS = 8
let OBJECT_OFF_KEY_TYPE = 16
let OBJECT_OFF_LABEL = 24
let OBJECT_OFF_ID = 32
