fn rms_norm(out: *f32, x: *f32, w: *f32, n: u32) {
    // RMSNorm: out = x / rms(x) * w
    let ss = 0.0f32
    let i = 0
    while i < n {
        let xi = mem_load4(x + i * 4)
        ss = ss + xi * xi
        i = i + 1
    }
    let scale = 1.0f32 / sqrt(ss / n + 1e-6)
    i = 0
    while i < n {
        let xi = mem_load4(x + i * 4)
        let wi = mem_load4(w + i * 4)
        mem_store4(out + i * 4, xi * scale * wi)
        i = i + 1
    }
}

fn matmul_vec(out: *f32, w: *f32, x: *f32, rows: u32, cols: u32) {
    // out[rows] = w[rows, cols] @ x[cols]
    let i = 0
    while i < rows {
        let sum = 0.0f32
        let j = 0
        while j < cols {
            let wij = mem_load4(w + (i * cols + j) * 4)
            let xj = mem_load4(x + j * 4)
            sum = sum + wij * xj
            j = j + 1
        }
        mem_store4(out + i * 4, sum)
        i = i + 1
    }
}

fn rope(q: *f32, k: *f32, pos: u32, head_dim: u32, n_heads: u32, n_kv_heads: u32, theta: f32) {
    // Apply RoPE to q and k
    let h = 0
    while h < n_heads {
        let qh = q + h * head_dim
        let d = 0
        while d < head_dim / 2 {
            let freq = 1.0f32 / pow(theta, (d * 2) as f32 / head_dim as f32)
            let val = pos as f32 * freq
            let cos_v = cos(val)
            let sin_v = sin(val)
            
            let q1 = mem_load4(qh + d * 4)
            let q2 = mem_load4(qh + (d + head_dim/2) * 4)
            mem_store4(qh + d * 4, q1 * cos_v - q2 * sin_v)
            mem_store4(qh + (d + head_dim/2) * 4, q1 * sin_v + q2 * cos_v)
            
            d = d + 1
        }
        h = h + 1
    }
    
    // K heads
    h = 0
    while h < n_kv_heads {
        let kh = k + h * head_dim
        let d = 0
        while d < head_dim / 2 {
            let freq = 1.0f32 / pow(theta, (d * 2) as f32 / head_dim as f32)
            let val = pos as f32 * freq
            let cos_v = cos(val)
            let sin_v = sin(val)
            
            let k1 = mem_load4(kh + d * 4)
            let k2 = mem_load4(kh + (d + head_dim/2) * 4)
            mem_store4(kh + d * 4, k1 * cos_v - k2 * sin_v)
            mem_store4(kh + (d + head_dim/2) * 4, k1 * sin_v + k2 * cos_v)
            
            d = d + 1
        }
        h = h + 1
    }
}

fn attention(out: *f32, q: *f32, k: *f32, v: *f32, 
             key_cache: *f32, value_cache: *f32,
             pos: u32, n_heads: u32, n_kv_heads: u32, head_dim: u32, max_seq: u32) {
    // Multi-head attention with KV cache
    // Simplified implementation
    let h = 0
    while h < n_heads {
        // Get query for this head
        let qh = q + h * head_dim
        
        // Get KV heads (GQA)
        let kv_h = h * n_kv_heads / n_heads
        let kh = k + kv_h * head_dim
        let vh = v + kv_h * head_dim
        
        // Attention scores: q @ k^T / sqrt(d)
        // Simplified - just accumulate
        let scale = 1.0f32 / sqrt(head_dim as f32)
        
        h = h + 1
    }
}

// ============================================================
// Main Inference Loop
// ============================================================

fn quanta_infer(model_path: str, prompt: str) {
    print("Loading model...\n")
    let model = gguf_load_model(model_path)
    if model == 0 {
        print("Failed to load model\n")
        return
    }
    
    print("Model loaded: ")
    print(model.n_tensors)
    print(" tensors\n")
    
    // Config for LFM2-2.6B
    let config = TransformerConfig {
        dim: 2048,
        n_layers: 24,
        n_heads: 32,
        n_kv_heads: 8,
        head_dim: 64,
        hidden_dim: 5632,
        vocab_size: 32000,
        max_seq_len: 4096,
        rope_theta: 10000.0
    }
    
    // Allocate weights
    let weights = mem_alloc(sizeof(TransformerWeights)) as *TransformerWeights
    
    print("Loading weights...\n")
    transformer_load_weights(model, &config, weights)
    
    // Allocate state
    let state = mem_alloc(sizeof(TransformerState)) as *TransformerState
    state.x = mem_alloc(config.dim * 4)
    state.xb = mem_alloc(config.dim * 4)
    state.xb2 = mem_alloc(config.dim * 4)
    state.hb = mem_alloc(config.hidden_dim * 4)
    state.hb2 = mem_alloc(config.hidden_dim * 4)
    state.q = mem_alloc(config.n_heads * config.head_dim * 4)
    state.k = mem_alloc(config.n_kv_heads * config.head_dim * 4)
    state.v = mem_alloc(config.n_kv_heads * config.head_dim * 4)
    state.att = mem_alloc(config.n_heads * config.max_seq_len * 4)
    state.logits = mem_alloc(config.vocab_size * 4)
    state.key_cache = mem_alloc(config.n_layers * config.n_kv_heads * config.max_seq_len * config.head_dim * 4)
    state.value_cache = mem_alloc(config.n_layers * config.n_kv_heads * config.max_seq_len * config.head_dim * 4)
    
    // Tokenizer
    let tok = tokenizer_load(model)
    
    // Encode prompt
    let input_ids = mem_alloc(512 * 4) as *u32
    let n_tokens = tokenizer_encode(tok, prompt, input_ids, 512)
    
    print("Prompt tokens: ")
    print(n_tokens)
    print("\n")
    
    // Generation loop
    let pos = 0
    while pos < n_tokens {
        // Forward pass for this token
        // ... full transformer forward ...
        pos = pos + 1
    }
    
    // Generate new tokens
    let max_new = 128
    let gen = 0
    while gen < max_new {
        // Forward
        // Sample
        // Print
        gen = gen + 1
    }
    
    print("\nDone\n")
}

