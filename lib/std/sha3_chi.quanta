import std/sha3_constants

extern fn malloc(size: u64) -> u64;

fn keccak_chi(st) {
  let B = malloc(200)
  let i = 0
  while (i < 25) {
    mem_store(B + i * 8, mem_load(st + i * 8))
    i = i + 1
  }

  let xi = 0
  while (xi < 5) {
    let y = 0
    while (y < 5) {
      let idx = xi + y * 5
      let b0 = mem_load(B + idx * 8)
      let b1 = mem_load(B + ((xi + 1) % 5 + y * 5) * 8)
      let b2 = mem_load(B + ((xi + 2) % 5 + y * 5) * 8)
      let val = b0 ^ ((~b1) & b2)
      mem_store(st + idx * 8, val)
      y = y + 1
    }
    xi = xi + 1
  }
}

extern fn malloc(size: u64) -> u64