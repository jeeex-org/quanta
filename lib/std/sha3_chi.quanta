// lib/std/sha3_chi.quanta - Keccak chi step (FIPS 202)

fn keccak_chi(st) {
  let b0 = mem_load(st+0); let b1 = mem_load(st+8); let b2 = mem_load(st+16); let b3 = mem_load(st+24); let b4 = mem_load(st+32)
  let b5 = mem_load(st+40); let b6 = mem_load(st+48); let b7 = mem_load(st+56); let b8 = mem_load(st+64); let b9 = mem_load(st+72)
  let b10 = mem_load(st+80); let b11 = mem_load(st+88); let b12 = mem_load(st+96); let b13 = mem_load(st+104); let b14 = mem_load(st+112)
  let b15 = mem_load(st+120); let b16 = mem_load(st+128); let b17 = mem_load(st+136); let b18 = mem_load(st+144); let b19 = mem_load(st+152)
  let b20 = mem_load(st+160); let b21 = mem_load(st+168); let b22 = mem_load(st+176); let b23 = mem_load(st+184); let b24 = mem_load(st+192)

  // Row y=0 (lanes 0,5,10,15,20): x=0..4
  let e0 = b0 ^ ((~b1) & b2)
  let e5 = b5 ^ ((~b6) & b7)
  let e10 = b10 ^ ((~b11) & b12)
  let e15 = b15 ^ ((~b16) & b17)
  let e20 = b20 ^ ((~b21) & b22)

  // Row y=1 (lanes 1,6,11,16,21): x=0..4
  let e1 = b1 ^ ((~b2) & b3)
  let e6 = b6 ^ ((~b7) & b8)
  let e11 = b11 ^ ((~b12) & b13)
  let e16 = b16 ^ ((~b17) & b18)
  let e21 = b21 ^ ((~b22) & b23)

  // Row y=2 (lanes 2,7,12,17,22): x=0..4
  let e2 = b2 ^ ((~b3) & b4)
  let e7 = b7 ^ ((~b8) & b9)
  let e12 = b12 ^ ((~b13) & b14)
  let e17 = b17 ^ ((~b18) & b19)
  let e22 = b22 ^ ((~b23) & b24)

  // Row y=3 (lanes 3,8,13,18,23): x=0..4
  let e3 = b3 ^ ((~b4) & b0)
  let e8 = b8 ^ ((~b9) & b5)
  let e13 = b13 ^ ((~b14) & b10)
  let e18 = b18 ^ ((~b19) & b15)
  let e23 = b23 ^ ((~b24) & b20)

  // Row y=4 (lanes 4,9,14,19,24): x=0..4
  let e4 = b4 ^ ((~b0) & b1)
  let e9 = b9 ^ ((~b5) & b6)
  let e14 = b14 ^ ((~b10) & b11)
  let e19 = b19 ^ ((~b15) & b16)
  let e24 = b24 ^ ((~b20) & b21)

  mem_store(st+0, e0); mem_store(st+8, e1); mem_store(st+16, e2); mem_store(st+24, e3); mem_store(st+32, e4)
  mem_store(st+40, e5); mem_store(st+48, e6); mem_store(st+56, e7); mem_store(st+64, e8); mem_store(st+72, e9)
  mem_store(st+80, e10); mem_store(st+88, e11); mem_store(st+96, e12); mem_store(st+104, e13); mem_store(st+112, e14)
  mem_store(st+120, e15); mem_store(st+128, e16); mem_store(st+136, e17); mem_store(st+144, e18); mem_store(st+152, e19)
  mem_store(st+160, e20); mem_store(st+168, e21); mem_store(st+176, e22); mem_store(st+184, e23); mem_store(st+192, e24)
}