// Full FIPS 202 in one file for testing
import std/sha3_constants

fn keccak_theta(st) {
  let C = malloc(40)
  let i = 0
  while (i < 5) {
    let sum = 0
    let j = 0
    while (j < 5) {
      let idx = i + j * 5
      let lane = mem_load(st + idx * 8)
      sum = sum ^ lane
      j = j + 1
    }
    mem_store(C + i * 8, sum)
    i = i + 1
  }
  let i2 = 0
  while (i2 < 5) {
    let c_left = mem_load(C + ((i2 + 4) % 5) * 8)
    let c_right_raw = mem_load(C + ((i2 + 1) % 5) * 8)
    let c_right = ((c_right_raw << 1) | (c_right_raw >> 63)) & 0xFFFFFFFFFFFFFFFF
    let D = c_left ^ c_right
    let j2 = 0
    while (j2 < 5) {
      let idx2 = i2 + j2 * 5
      let lane2 = mem_load(st + idx2 * 8)
      mem_store(st + idx2 * 8, lane2 ^ D)
      j2 = j2 + 1
    }
    i2 = i2 + 1
  }
}

fn keccak_rhopi(st) {
  let B = malloc(200)
  let i = 0
  while (i < 25) {
    mem_store(B + i * 8, mem_load(st + i * 8))
    i = i + 1
  }
  let rho = malloc(200)
  let ri = 0
  while (ri < 25) {
    let r = 0
    if (ri == 0) { r = 0 }
    else if (ri == 1) { r = 1 }
    else if (ri == 2) { r = 62 }
    else if (ri == 3) { r = 28 }
    else if (ri == 4) { r = 27 }
    else if (ri == 5) { r = 36 }
    else if (ri == 6) { r = 44 }
    else if (ri == 7) { r = 6 }
    else if (ri == 8) { r = 55 }
    else if (ri == 9) { r = 20 }
    else if (ri == 10) { r = 3 }
    else if (ri == 11) { r = 10 }
    else if (ri == 12) { r = 43 }
    else if (ri == 13) { r = 25 }
    else if (ri == 14) { r = 39 }
    else if (ri == 15) { r = 41 }
    else if (ri == 16) { r = 45 }
    else if (ri == 17) { r = 15 }
    else if (ri == 18) { r = 21 }
    else if (ri == 19) { r = 8 }
    else if (ri == 20) { r = 18 }
    else if (ri == 21) { r = 2 }
    else if (ri == 22) { r = 61 }
    else if (ri == 23) { r = 56 }
    else if (ri == 24) { r = 14 }
    mem_store(rho + ri * 8, r)
    ri = ri + 1
  }
  let k = 0
  while (k < 25) {
    let src_lane = mem_load(B + k * 8)
    let r = mem_load(rho + k * 8)
    let rotated = ((src_lane << r) | (src_lane >> (64 - r))) & 0xFFFFFFFFFFFFFFFF
    let pi_idx = 0
    if (k == 0) { pi_idx = 0 }
    else if (k == 1) { pi_idx = 10 }
    else if (k == 2) { pi_idx = 7 }
    else if (k == 3) { pi_idx = 11 }
    else if (k == 4) { pi_idx = 17 }
    else if (k == 5) { pi_idx = 18 }
    else if (k == 6) { pi_idx = 3 }
    else if (k == 7) { pi_idx = 5 }
    else if (k == 8) { pi_idx = 16 }
    else if (k == 9) { pi_idx = 8 }
    else if (k == 10) { pi_idx = 21 }
    else if (k == 11) { pi_idx = 24 }
    else if (k == 12) { pi_idx = 4 }
    else if (k == 13) { pi_idx = 15 }
    else if (k == 14) { pi_idx = 23 }
    else if (k == 15) { pi_idx = 19 }
    else if (k == 16) { pi_idx = 13 }
    else if (k == 17) { pi_idx = 12 }
    else if (k == 18) { pi_idx = 2 }
    else if (k == 19) { pi_idx = 20 }
    else if (k == 20) { pi_idx = 14 }
    else if (k == 21) { pi_idx = 22 }
    else if (k == 22) { pi_idx = 9 }
    else if (k == 23) { pi_idx = 6 }
    else if (k == 24) { pi_idx = 1 }
    mem_store(st + pi_idx * 8, rotated)
    k = k + 1
  }
}

fn keccak_chi(st) {
  let B = malloc(200)
  let i = 0
  while (i < 25) {
    mem_store(B + i * 8, mem_load(st + i * 8))
    i = i + 1
  }
  let xi = 0
  while (xi < 5) {
    let yi = 0
    while (yi < 5) {
      let idx = xi + yi * 5
      let a = mem_load(B + idx * 8)
      let b = mem_load(B + ((xi + 1) % 5 + yi * 5) * 8)
      let c = mem_load(B + ((xi + 2) % 5 + yi * 5) * 8)
      let not_b = ~b
      let and_bc = not_b & c
      mem_store(st + idx * 8, a ^ and_bc)
      yi = yi + 1
    }
    xi = xi + 1
  }
}

fn keccak_iota(st, rnd) {
  let rc = keccak_rc(rnd)
  let a0 = mem_load(st + 0) ^ rc
  mem_store(st + 0, a0)
}

fn keccak_round(st, rnd) {
  keccak_theta(st)
  keccak_rhopi(st)
  keccak_chi(st)
  keccak_iota(st, rnd)
}

fn keccak_f(st) {
  let rnd = 0
  while (rnd < 24) {
    keccak_round(st, rnd)
    rnd = rnd + 1
  }
}

fn keccak_absorb(st, rate, input, input_len, offset) {
  let j = 0
  while (j < rate && offset + j < input_len) {
    let b = input[offset + j] & 0xFF
    let idx = j >> 3
    let shift = (j & 7) * 8
    let lane = mem_load(st + idx * 8)
    lane = lane ^ (b << shift)
    mem_store(st + idx * 8, lane)
    j = j + 1
  }
  return j
}

fn keccak_pad(st, rate, j, suffix_byte) {
  let idx0 = j >> 3
  let shift0 = (j & 7) * 8
  let lane0 = mem_load(st + idx0 * 8)
  lane0 = lane0 ^ (suffix_byte << shift0)
  mem_store(st + idx0 * 8, lane0)
  let idx1 = (rate - 1) >> 3
  let shift1 = ((rate - 1) & 7) * 8
  let lane1 = mem_load(st + idx1 * 8)
  lane1 = lane1 ^ (0x80 << shift1)
  mem_store(st + idx1 * 8, lane1)
}

fn keccak_squeeze(st, rate, out, out_len) {
  let i = 0
  while (i < out_len) {
    let lane_idx = i >> 3
    let shift = (i & 7) * 8
    let v = mem_load(st + lane_idx * 8)
    out[i] = (v >> shift) & 0xFF
    i = i + 1
    if (i % rate == 0 && i < out_len) {
      keccak_f(st)
    }
  }
}

fn keccak_hash(input, input_len, rate, suffix_byte, out, out_len) {
  let st = malloc(200)
  let i = 0
  while (i < 25) { mem_store(st + i * 8, 0); i = i + 1 }
  if (input_len == 0) {
    keccak_pad(st, rate, 0, suffix_byte)
    keccak_f(st)
  } else {
    let offset = 0
    while (offset < input_len) {
      let j = keccak_absorb(st, rate, input, input_len, offset)
      if (offset + j >= input_len) {
        keccak_pad(st, rate, j, suffix_byte)
        keccak_f(st)
        break
      } else {
        keccak_f(st)
        offset = offset + rate
      }
    }
  }
  keccak_squeeze(st, rate, out, out_len)
}

fn sha3_224(input, input_len, out) {
  keccak_hash(input, input_len, 144, 0x06, out, 28)
}

fn sha3_256(input, input_len, out) {
  keccak_hash(input, input_len, 136, 0x06, out, 32)
}

fn sha3_384(input, input_len, out) {
  keccak_hash(input, input_len, 104, 0x06, out, 48)
}

fn sha3_512(input, input_len, out) {
  keccak_hash(input, input_len, 72, 0x06, out, 64)
}

fn shake128(input, input_len, out, out_len) {
  keccak_hash(input, input_len, 168, 0x1F, out, out_len)
}

fn shake256(input, input_len, out, out_len) {
  keccak_hash(input, input_len, 136, 0x1F, out, out_len)
}

extern fn malloc(size: u64) -> u64