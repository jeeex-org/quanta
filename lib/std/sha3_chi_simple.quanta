// lib/std/sha3_chi_simple.quanta - Keccak chi step (FIPS 202), minimal

include "sha3_base.quanta"

fn keccak_chi(st) {
  let a0 = mem_load(st+0)
  let a1 = mem_load(st+8)
  let a2 = mem_load(st+16)
  let a3 = mem_load(st+24)
  let a4 = mem_load(st+32)
  let a5 = mem_load(st+40)
  let a6 = mem_load(st+48)
  let a7 = mem_load(st+56)
  let a8 = mem_load(st+64)
  let a9 = mem_load(st+72)
  let a10 = mem_load(st+80)
  let a11 = mem_load(st+88)
  let a12 = mem_load(st+96)
  let a13 = mem_load(st+104)
  let a14 = mem_load(st+112)
  let a15 = mem_load(st+120)
  let a16 = mem_load(st+128)
  let a17 = mem_load(st+136)
  let a18 = mem_load(st+144)
  let a19 = mem_load(st+152)
  let a20 = mem_load(st+160)
  let a21 = mem_load(st+168)
  let a22 = mem_load(st+176)
  let a23 = mem_load(st+184)
  let a24 = mem_load(st+192)

  a0 ^= (~a1) & a2
  a5 ^= (~a6) & a7
  a10 ^= (~a11) & a12
  a15 ^= (~a16) & a17
  a20 ^= (~a21) & a22
  a1 ^= (~a2) & a3
  a6 ^= (~a7) & a8
  a11 ^= (~a12) & a13
  a16 ^= (~a17) & a18
  a21 ^= (~a22) & a23
  a2 ^= (~a3) & a4
  a7 ^= (~a8) & a9
  a12 ^= (~a13) & a14
  a17 ^= (~a18) & a19
  a22 ^= (~a23) & a24
  a3 ^= (~a4) & a0
  a8 ^= (~a9) & a5
  a13 ^= (~a14) & a10
  a18 ^= (~a19) & a15
  a23 ^= (~a24) & a20
  a4 ^= (~a0) & a1
  a9 ^= (~a5) & a6
  a14 ^= (~a10) & a11
  a19 ^= (~a15) & a16
  a24 ^= (~a20) & a21

  mem_store(st+0, a0); mem_store(st+8, a1); mem_store(st+16, a2); mem_store(st+24, a3); mem_store(st+32, a4)
  mem_store(st+40, a5); mem_store(st+48, a6); mem_store(st+56, a7); mem_store(st+64, a8); mem_store(st+72, a9)
  mem_store(st+80, a10); mem_store(st+88, a11); mem_store(st+96, a12); mem_store(st+104, a13); mem_store(st+112, a14)
  mem_store(st+120, a15); mem_store(st+128, a16); mem_store(st+136, a17); mem_store(st+144, a18); mem_store(st+152, a19)
  mem_store(st+160, a20); mem_store(st+168, a21); mem_store(st+176, a22); mem_store(st+184, a23); mem_store(st+192, a24)
}