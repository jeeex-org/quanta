// std/patterns — pattern library for code synthesis
// Known implementation patterns for common module types

// Pattern: fundamental constants module
const PATTERN_FUNDAMENTALS = 0
// Pattern: security/crypto module
const PATTERN_SECURITY = 1
// Pattern: algorithm module
const PATTERN_ALGORITHM = 2
// Pattern: data structure module
const PATTERN_DATA_STRUCT = 3
// Pattern: protocol module
const PATTERN_PROTOCOL = 4
// Pattern: compliance/audit module
const PATTERN_COMPLIANCE = 5
// Pattern: AI/ML module
const PATTERN_AI = 6

fn pattern_get_template(pattern) {
    if pattern == PATTERN_FUNDAMENTALS { return 1 }
    if pattern == PATTERN_SECURITY { return 2 }
    if pattern == PATTERN_ALGORITHM { return 3 }
    if pattern == PATTERN_DATA_STRUCT { return 4 }
    if pattern == PATTERN_PROTOCOL { return 5 }
    if pattern == PATTERN_COMPLIANCE { return 6 }
    if pattern == PATTERN_AI { return 7 }
    return 0
}

fn pattern_match_category(category) {
    let c = category
    if c == 83 { return PATTERN_SECURITY } // 'S' for Security
    if c == 65 { return PATTERN_ALGORITHM } // 'A' for Algorithm
    if c == 68 { return PATTERN_DATA_STRUCT } // 'D' for Data
    if c == 80 { return PATTERN_PROTOCOL } // 'P' for Protocol
    if c == 67 { return PATTERN_COMPLIANCE } // 'C' for Compliance
    if c == 77 { return PATTERN_AI } // 'M' for ML
    return PATTERN_FUNDAMENTALS
}