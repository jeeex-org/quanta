// std/patterns.quanta - Pattern library for code generation
// Real implementations of common patterns used across domains

module std_patterns;

import std.ir;
import std.types;

// Pattern: Constant function
fn pattern_const_fn(name, value) {
    let ir = [];
    ir.push({ op: IR_CONST, result: 0, a0: value });
    ir.push({ op: IR_RET, a0: 0 });
    return ir;
}

// Pattern: Identity function (return parameter)
fn pattern_identity_fn() {
    let ir = [];
    ir.push({ op: IR_PARAM, result: 0, a0: 0 });  // param 0
    ir.push({ op: IR_RET, a0: 0 });
    return ir;
}

// Pattern: Binary arithmetic (a op b)
fn pattern_binop(op, a, b, result) {
    let ir = [];
    ir.push({ op: op, result: result, a0: a, a1: b });
    return ir;
}

// Pattern: Comparison (a cmp b) -> 0/1
fn pattern_compare(cmp_op, a, b, result) {
    let ir = [];
    ir.push({ op: IR_CMP, result: 0, a0: a, a1: b });  // sets flags
    ir.push({ op: cmp_op, result: result });  // setcc into result
    return ir;
}

// Pattern: Function call with args
fn pattern_call(fn_name, args, result) {
    let ir = [];
    ir.push({ op: IR_CALL, result: result, a0: fn_name, a1: args.len(), a2: args });
    return ir;
}

// Pattern: String literal
fn pattern_string(s, result) {
    let ir = [];
    ir.push({ op: IR_STR, result: result, a0: s });
    return ir;
}

// Pattern: If-then-else
fn pattern_if(cond, then_ir, else_ir, result) {
    let ir = [];
    let else_label = label_gen();
    let end_label = label_gen();
    
    // cond check
    ir.push({ op: IR_BR, a0: cond, a1: else_label });
    // then branch
    ir.extend(then_ir);
    ir.push({ op: IR_JMP, a0: end_label });
    // else branch
    ir.push({ op: IR_LABEL, a0: else_label });
    ir.extend(else_ir);
    // end
    ir.push({ op: IR_LABEL, a0: end_label });
    return ir;
}

// Pattern: Loop
fn pattern_loop(body_ir, cond) {
    let ir = [];
    let loop_label = label_gen();
    let end_label = label_gen();
    
    ir.push({ op: IR_LABEL, a0: loop_label });
    ir.extend(body_ir);
    ir.push({ op: IR_BR, a0: cond, a1: loop_label });
    ir.push({ op: IR_LABEL, a0: end_label });
    return ir;
}

// Pattern: Struct field access
fn pattern_struct_field(base, field_offset, result) {
    let ir = [];
    ir.push({ op: IR_ADD, result: result, a0: base, a1: field_offset });
    return ir;
}

// Pattern: Array index access
fn pattern_array_index(base, index, elem_size, result) {
    let ir = [];
    ir.push({ op: IR_MUL, result: 0, a0: index, a1: elem_size });
    ir.push({ op: IR_ADD, result: result, a0: base, a1: 0 });
    return ir;
}

// Pattern: Memory allocation
fn pattern_alloc(size, result) {
    let ir = [];
    ir.push({ op: IR_ALLOCA, result: result, a0: size });
    return ir;
}

// Pattern: Memory free
fn pattern_free(ptr) {
    let ir = [];
    ir.push({ op: IR_FREE, a0: ptr });
    return ir;
}

// Helper: label generator
fn label_gen() {
    // In real implementation, this would use a counter
    return 0;
}

fn init() -> i64 {
    return 0;
}