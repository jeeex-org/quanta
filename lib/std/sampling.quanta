import std/fs
import std/math

// Sampling: temperature scaling, top-k filtering, softmax, categorical draw.
//
// STATUS (0.0.240): rewritten for correctness against a numpy reference. Three
// defects, each measured with a synthetic logits vector (see
// compiler/0.0.240/WIP.md):
//
//   1. sample_softmax used `1 + (v - max)` as its "exp". That is a shifted
//      value, not an exponential, so the result was not a distribution. MEASURED
//      worse than that: on 10 distinct logits it collapsed to a ONE-HOT at the
//      argmax (only the max element survived, with probability 1.0).
//
//   2. sample_draw compared `cumsum * 1000` (a number in [0, 1000]) against the
//      raw rng output `r` in [0, 2^31). That is never true, so it always fell
//      through to `return 0`. Token id 0 is a WHITESPACE token -- this, not the
//      softmax, is why the native generator emitted spaces. MEASURED: 10/10
//      draws returned 0, and sample_full returned 0 for all 10 calls.
//
//   3. sample_top_k was a full O(n^2) exchange sort AND allocated n*8 bytes per
//      call. At n_vocab = 128000 it measured 110,080 ms (110 s) per call at
//      k = 40, so the driver had to run top_k = 0.
//
// THE RULE THAT MAKES THIS FILE WORK: every float local is a TYPED f64, and
// every value read out of a mem_alloc'd buffer goes through f64of() first.
// mem_load() yields a raw 64-bit INTEGER, and a float builtin handed an untagged
// operand does not compute on the value -- it takes the integer path over the
// bit pattern. Measured on this compiler: an untyped param receiving 3.0 and
// doing `t * 0.5` returned 2.3e18, while the same body with `x: f64` returned
// 1.5. So float PARAMETERS here are declared `: f64`, not left untyped.
//
// Transcendentals come from std/math.expf, verified against Python's math.exp
// over 293 cases on the raw IEEE-754 bits (worst 7.0e-14 relative).

let rng_state = 12345

// ---- EOS (end-of-turn) policy state -------------------------------------
//
// WHY THIS EXISTS: a sampler that can emit the end-of-turn id as a RANDOM DRAW
// truncates answers, and the tracked driver did exactly that. MEASURED on the
// driver before this change (see tests/README-lfm2-generate.md): at
// temp_milli=700, top_k=40 the run printed the first token `str` and then
// stopped -- `new_tokens=1` -- because <|im_end|> (id 124900) was inside the
// top-40 candidate set and the draw landed on it. The native logit tail is
// flatter than llama.cpp's (EOS sits at #2 in the native top-10 on that same
// prompt), so a top-k that CONTAINS EOS keeps it as a live candidate at any
// temperature. A generation that sampling noise can cut short is not usable by
// a loop that needs complete answers.
//
// The policy is the standard one (llama.cpp's `--no-...`, transformers'
// `SuppressTokens`-style handling plus `min_new_tokens`):
//
//   * EXCLUDE the end-of-turn id from the sampled candidate set UNLESS it is
//     the argmax, so the model can still finish a turn -- but only when ending
//     is its CLEAR CHOICE, not when the draw happened to hit it;
//   * optionally refuse EOS until at least `sampling_min_len` tokens have been
//     generated (belt and braces for a policy that wants a floor).
//
// BOTH ARE OFF BY DEFAULT (sampling_eos = -1), so every existing caller -- the
// greedy correctness oracle included -- is bit-for-bit unaffected: with the id
// invalid the policy is a single compare and a return. A caller opts in with
// sample_set_eos(id) before the generation loop; the id is a caller fact (for
// this model it comes from the GGUF, `tokenizer.ggml.eos_token_id` = 124900,
// which bpe.quanta already exposes as `bpe_eos`), never guessed here.
//
// Integers, not floats: -1 is "disabled" and no model id is negative, so the
// sentinel is unambiguous. Unlike a top-level float `const` (which this
// compiler evaluates to 0 -- see the top-k note), an int `let` reads its value.
let sampling_eos = 0 - 1
let sampling_min_len = 0
let sampling_gen_len = 0

// Magnitude of the top-k sentinel. expf() returns exactly 0.0 for any argument
// below -745.2, so after `v - max` a sentinel logit contributes zero mass.
//
// NOT a `const`: on this compiler a top-level `const` with a float initialiser
// evaluates to 0 (measured: `const CF = 2.5` -> f64bits(CF) == 0), so a const
// sentinel silently became 0.0 and the masked tail stayed in the distribution.
// Negative float literals are spelled `0.0 - X` in this tree.

// LCG step. Returns an i64 in [0, 2^31).
fn rng_next() {
    rng_state = (rng_state * 1103515245 + 12345) - ((rng_state * 1103515245 + 12345) / 2147483648) * 2147483648
    return rng_state
}

// Reset the RNG to a fixed seed so a run is reproducible. Also zeroes the
// EOS-policy generation counter, so this is the single reset point a generation
// loop calls before its first draw (the driver does exactly that).
fn sample_seed(s) {
    rng_state = s
    sampling_gen_len = 0
    return s
}

// Enable the EOS policy for id `id` (e.g. bpe_eos). Returns the id.
fn sample_set_eos(id) {
    sampling_eos = id
    return id
}

// Require at least `m` generated tokens before EOS may be drawn. Returns m.
// A negative m clamps to 0 = off. The counter this is compared against is reset
// by sample_seed(), which a generation loop calls before its first draw.
fn sample_set_min_len(m) {
    let v = m
    if v < 0 { v = 0 }
    sampling_min_len = v
    return v
}

// Apply the EOS policy to a logits buffer IN PLACE. Returns 1 if this call
// REMOVED the EOS id from the candidate set, 0 if it left it in place.
//
// Preconditions are checked here, not assumed by callers:
//   * sampling_eos < 0            -> policy disabled, no-op (default);
//   * sampling_eos >= n           -> the id is not in this distribution, no-op;
//   * EOS is the argmax AND at least sampling_min_len tokens have already been
//     generated -> LEFT IN PLACE (the model's clear choice -- it may end);
//   * otherwise                   -> EOS is pushed to the -1e30 sentinel, so
//     expf(v - max) is exactly 0.0 for it and the draw can never land on it.
//
// The sentinel, not a removal/compaction, is what keeps this O(1): every other
// routine (sample_argmax, sample_top_k, sample_softmax, sample_draw) already
// treats -1e30 correctly, so no index bookkeeping has to move. sample_argmax()
// is deliberately NOT changed: a caller asking "what is the argmax" still gets
// EOS when EOS is the argmax.
fn sample_eos_policy(logits, n) {
    if sampling_eos < 0 { return 0 }
    if sampling_eos >= n { return 0 }
    if sampling_gen_len >= sampling_min_len {
        if sample_argmax(logits, n) == sampling_eos { return 0 }
    }
    mem_store(logits + sampling_eos * 8, f64bits(0.0 - 1.0e30))
    return 1
}

// Scale every logit by 1/temperature, in place.
fn sample_temperature(logits, n, temperature: f64) {
    let inv: f64 = 1.0 / temperature
    let i = 0
    while i < n {
        let v: f64 = f64of(mem_load(logits + i * 8))
        mem_store(logits + i * 8, f64bits(v * inv))
        i = i + 1
    }
}

// Index of the largest logit. Ties resolve to the LOWEST index (strict `>`).
fn sample_argmax(logits, n) {
    let best: f64 = f64of(mem_load(logits))
    let bi = 0
    let i = 1
    while i < n {
        let v: f64 = f64of(mem_load(logits + i * 8))
        if v > best {
            best = v
            bi = i
        }
        i = i + 1
    }
    return bi
}

// Keep the k largest logits; push everything else to the sentinel.
//
// O(n * k) via k repeated max-scans: pass p finds the largest value strictly
// below the value found in pass p-1, so after k passes `cut` is the k-th largest
// logit. One O(n) threshold pass then masks the tail. No allocation.
//
// The previous version was O(n^2) -- 110 s at n = 128000, k = 40 -- and
// allocated n*8 bytes on every call.
//
// Ties: a repeated max-scan finds the k-th largest DISTINCT value, so a value
// repeated at the cut is kept in full and the retained set can exceed k when the
// top of the distribution has exact ties. Ties are arbitrary in every reference
// implementation; stated rather than hidden.
fn sample_top_k(logits, n, k) {
    if k <= 0 { return 0 }
    if k >= n { return 0 }
    // hi starts strictly above every logit (global max + 1), so pass 1 finds the
    // global max without assuming any bound on logit magnitude.
    let hi: f64 = f64of(mem_load(logits))
    let j = 1
    while j < n {
        let v: f64 = f64of(mem_load(logits + j * 8))
        if v > hi { hi = v }
        j = j + 1
    }
    hi = hi + 1.0
    let cut: f64 = hi
    let p = 0
    while p < k {
        let best: f64 = 0.0 - 1e300
        let i = 0
        while i < n {
            let v: f64 = f64of(mem_load(logits + i * 8))
            if v < hi && v > best { best = v }
            i = i + 1
        }
        cut = best
        hi = best
        p = p + 1
    }
    let sentinel: f64 = 0.0 - 1.0e30
    let i = 0
    while i < n {
        let v: f64 = f64of(mem_load(logits + i * 8))
        if v < cut { mem_store(logits + i * 8, f64bits(sentinel)) }
        i = i + 1
    }
    return 0
}

// Softmax in place, numerically stable: p[i] = exp(v[i] - max) / sum.
fn sample_softmax(logits, n) {
    if n <= 0 { return 0 }
    let max_val: f64 = f64of(mem_load(logits))
    let i = 1
    while i < n {
        let v: f64 = f64of(mem_load(logits + i * 8))
        if v > max_val { max_val = v }
        i = i + 1
    }
    let sum: f64 = 0.0
    i = 0
    while i < n {
        let v: f64 = f64of(mem_load(logits + i * 8))
        let ev: f64 = expf(v - max_val)
        mem_store(logits + i * 8, f64bits(ev))
        sum = sum + ev
        i = i + 1
    }
    if sum > 0.0 {
        let inv: f64 = 1.0 / sum
        i = 0
        while i < n {
            let p: f64 = f64of(mem_load(logits + i * 8))
            mem_store(logits + i * 8, f64bits(p * inv))
            i = i + 1
        }
    }
    return 0
}

// Categorical draw from a normalised probability vector.
//
// rng_next() is in [0, 2^31); it is scaled into [0, 1) so the comparison is in
// the same domain as the running cumsum. The old form compared cumsum*1000
// (< 1000) against the raw rng output (< 2^31), which was never true and made
// every draw return index 0.
fn sample_draw(probs, n) {
    let r = rng_next()
    let u: f64 = fdiv(i2f(r), i2f(2147483648))
    let cumsum: f64 = 0.0
    let i = 0
    while i < n {
        let p: f64 = f64of(mem_load(probs + i * 8))
        cumsum = cumsum + p
        if cumsum > u { return i }
        i = i + 1
    }
    return n - 1
}

// Full sampler. Signature unchanged from 0.0.239 (and 0.0.240): callers keep
// calling sample_full(logits, n, temperature, k). The EOS policy is configured
// separately via sample_set_eos()/sample_set_min_len(), so no call site had to
// change to gain the fix.
//
// ORDER: the EOS policy runs FIRST, before temperature scaling and top-k, so a
// masked EOS cannot be re-introduced by the top-k pass: top-k then selects the k
// largest of the REMAINING logits, which is exactly "exclude EOS, then top-k".
//
// temperature <= 0 is GREEDY: return the argmax. Load-bearing -- the old code
// would have divided by zero. Greedy still honours a FORCED exclusion (EOS was
// the argmax but min_len is not yet satisfied): EOS is already at -1e30 by then,
// so sample_argmax returns the best non-EOS logit without extra machinery.
fn sample_full(logits, n, temperature: f64, k) {
    sample_eos_policy(logits, n)
    sampling_gen_len = sampling_gen_len + 1
    if temperature <= 0.0 { return sample_argmax(logits, n) }
    sample_temperature(logits, n, temperature)
    if k > 0 && k < n { sample_top_k(logits, n, k) }
    sample_softmax(logits, n)
    return sample_draw(logits, n)
}
