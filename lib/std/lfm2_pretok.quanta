// lib/std/lfm2_pretok.quanta -- the LFM2 (LLAMA3) Unicode pre-tokenizer.
//
// Implements, natively and byte-exactly, the regex llama.cpp applies for
// tokenizer.ggml.pre == "lfm2". Upstream maps that to
// LLAMA_VOCAB_PRE_TYPE_LLAMA3 and splits with:
//
//   (?:'[sS]|'[tT]|'[rR][eE]|'[vV][eE]|'[mM]|'[lL][lL]|'[dD])
//   |[^\r\n\p{L}\p{N}]?\p{L}+
//   |\p{N}{1,3}
//   | ?[^\s\p{L}\p{N}]+[\r\n]*
//   |\s*[\r\n]+
//   |\s+(?!\S)
//   |\s+
//
// Regex alternation is leftmost-first, and the engine takes the FIRST
// alternative that matches at the leftmost position, so this is not a
// "best of" choice -- order decides. The expansion below keeps that order
// literal and calls out where a branch is greedy.
//
// Every branch is scanned before the next, so a caller loops calling
// pretok_next() until it returns 0.
//
// The negative lookahead in branch 6, \s+(?!\S), is resolved by proof rather
// than approximation; see the branch-6 comment in pretok_next().
//
// Nothing below uses an out-parameter. An out-parameter must be a mem_alloc'd
// cell: passing a plain `let` local makes the callee treat the integer's value
// as an address and write through it, which faults. Where two values must come
// back from one scan they are returned through module globals that the caller
// reads immediately.

import std/unicode

// Result of pretok_next(): the pre-token's byte offset and length.
let pretok_off = 0
let pretok_len = 0

// Consume a maximal run of codepoints satisfying the selector `kind`, starting
// at byte index `i`:
//
//   1 = \p{L}      2 = \p{N}      3 = [^\s\p{L}\p{N}]
//   4 = \s         5 = [\r\n]     6 = [^\r\n\p{L}\p{N}]
//
// Returns the byte index just past the run.
//
// kinds 3 and 6 are NOT the same class, and confusing them is the single
// easiest way to get this tokenizer wrong:
//
//   kind 3, [^\s\p{L}\p{N}]  -- whitespace EXCLUDED (branch 4)
//   kind 6, [^\r\n\p{L}\p{N}] -- only \r\n excluded, so a space or tab
//                              COUNTS as a valid optional prefix (branch 2)
//
// Branch 2's prefix may be a space, which is why " world" is one pre-token
// rather than " " + "world"; using kind 3 there splits it wrongly.
fn pretok_run(s, n, i, kind) {
    let at = i
    while at < n {
        let cp = uni_decode(s + at)
        let take = 0
        if kind == 1 {
            if uni_is_letter(cp) { take = 1 }
        } else if kind == 2 {
            if uni_is_number(cp) { take = 1 }
        } else if kind == 3 {
            if !uni_is_space(cp) && !uni_is_letter(cp) && !uni_is_number(cp) { take = 1 }
        } else if kind == 4 {
            if uni_is_space(cp) { take = 1 }
        } else if kind == 5 {
            if uni_is_newline(cp) { take = 1 }
        } else if kind == 6 {
            if !uni_is_newline(cp) && !uni_is_letter(cp) && !uni_is_number(cp) { take = 1 }
        }
        if take == 0 { break }
        at = at + uni_len_scratch
    }
    return at
}

// Byte length of an English contraction starting at `i` -- ' followed by s/S,
// t/T, r/R+e/E, v/V+e/E, m/M, l/L+l, or d/D -- or 0 if none starts here.
fn pretok_contraction_len(s, n, i) {
    if i + 1 >= n { return 0 }
    if mem_load8(s + i) != 39 { return 0 }
    let a = mem_load8(s + i + 1)
    if a == 115 || a == 83 { return 2 }
    if a == 116 || a == 84 { return 2 }
    if a == 109 || a == 77 { return 2 }
    if a == 100 || a == 68 { return 2 }
    if i + 2 >= n { return 0 }
    let b = mem_load8(s + i + 2)
    if a == 114 || a == 82 {
        if b == 101 || b == 69 { return 3 }
        return 0
    }
    if a == 118 || a == 86 {
        if b == 101 || b == 69 { return 3 }
        return 0
    }
    if a == 108 || a == 76 {
        // '[lL][lL] -- the second character must be lowercase.
        if b == 108 { return 3 }
        return 0
    }
    return 0
}

// Produce the next pre-token from the byte buffer `s` of length `n`, starting
// at byte index `i`. Leaves the result in pretok_off / pretok_len and returns 1,
// or returns 0 once `i` has reached `n`.
fn pretok_next(s, n, i) {
    if i >= n { return 0 }
    let start = i

    // branch 1: contraction
    let cl = pretok_contraction_len(s, n, i)
    if cl > 0 {
        pretok_off = start
        pretok_len = cl
        return 1
    }

    let cp0 = uni_decode(s + i)
    let l0 = uni_len_scratch

    // branch 2: [^\r\n\p{L}\p{N}]? \p{L}+
    //
    // The prefix class is [^\r\n\p{L}\p{N}] (kind 6), NOT [^\s\p{L}\p{N}]
    // (kind 3). Only \r\n are excluded, so a space or tab is a legal
    // prefix and " world" comes back as one pre-token.
    if uni_is_letter(cp0) {
        pretok_off = start
        pretok_len = pretok_run(s, n, i, 1) - i
        return 1
    }
    if !uni_is_newline(cp0) && !uni_is_letter(cp0) && !uni_is_number(cp0) {
        let j = i + l0
        if j < n {
            let cp2 = uni_decode(s + j)
            if uni_is_letter(cp2) {
                pretok_off = start
                pretok_len = pretok_run(s, n, j, 1) - i
                return 1
            }
        }
    }

    // branch 3: \p{N}{1,3} -- greedy, capped at three digits per pre-token
    if uni_is_number(cp0) {
        let take = pretok_run(s, n, i, 2) - i
        if take > 3 { take = 3 }
        pretok_off = start
        pretok_len = take
        return 1
    }

    // branch 4: ' '? [^\s\p{L}\p{N}]+ [\r\n]*
    let j = i
    if cp0 == 32 { j = i + l0 }
    if j < n {
        let cpj = uni_decode(s + j)
        if !uni_is_space(cpj) && !uni_is_letter(cpj) && !uni_is_number(cpj) {
            let k = pretok_run(s, n, j, 3)
            k = pretok_run(s, n, k, 5)
            pretok_off = start
            pretok_len = k - i
            return 1
        }
    }

    // branch 5: \s* [\r\n]+
    //
    // \s* is greedy but backtracks. When the whitespace run contains any
    // newline, \s* settles on everything up to the last newline run and [\r\n]+
    // eats the final newlines -- so the pre-token spans the WHOLE run, not just
    // the newlines. Treating it as "only the newlines" would split " \n\nx" into
    // " " + "\n\n", which upstream does not do.
    //
    // branch 6: \s+(?!\S)
    //
    // (?!\S) means "not followed by a NON-space", so this branch only takes a
    // whitespace run that reaches the END of the text. When a non-space
    // follows, \s+ must BACKTRACK by one codepoint and stop, leaving that last
    // whitespace character for branch 2 ([^\r\n\p{L}\p{N}]? \p{L}+), which then
    // absorbs it into the following word.
    //
    // "test  d" must therefore split as "test" / " " / " d" -- NOT "test" /
    // "  " / "d". Consuming the whole run instead makes the two spaces one
    // pre-token, which is a vocabulary entry (U+0120 U+0120, id 266), and
    // llama.cpp's ignore_merges shortcut then emits 266 where upstream emits
    // 229 + 277. Verified against test-tokenizer-0.
    if uni_is_space(cp0) {
        let ws_end = pretok_run(s, n, i, 4)
        // Backtrack one codepoint ONLY when the run is longer than one and a
        // non-space follows. A one-codepoint run has nothing to give up: without
        // the length test the subtraction lands back on i and the scan makes no
        // progress, which spins forever on input like "1 22".
        if ws_end < n && ws_end - i > l0 {
            ws_end = ws_end - uni_decode_len(s + ws_end - 1)
        }
        pretok_off = start
        pretok_len = ws_end - i
        return 1
    }

    // Nothing matched. The branches above are exhaustive for any single
    // codepoint, so this is unreachable in practice; emit one character so the
    // caller still advances instead of looping forever on a zero-length token.
    pretok_off = start
    pretok_len = l0
    return 1
}
