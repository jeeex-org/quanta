// lib/std/lfm2_mm.quanta -- bounded, descriptor-driven matvec for LFM2.
//
// WHY THIS FILE EXISTS
// --------------------
// The obvious implementation -- dequantize a weight tensor to f64, then matvec --
// needs 20.1 GB for this model, and the binary runs under MemoryMax=6G. So the
// weights are NEVER fully materialised. Every matvec here walks the tensor ROW BY
// ROW, dequantizes one row, accumulates, and reuses the same buffer.
//
// Peak cost is set by the widest single row, not by the tensor:
//
//     ffn_gate/up   2048 x 10752   row = 10752 f64 =  84 KB
//     attn_q/out    2048 x  2048   row =  2048 f64 =  16 KB
//     token_embd       1 x 128000  row = 128000 f64 = 1 MB
//
// 1 MB worst case, paid once, not per layer.
//
// MEMORY ACCESS CONVENTION (the part that is easy to get wrong)
// -------------------------------------------------------------
// A Quanta pointer is a raw address, not an array. Pointer arguments are read
// with mem_load(p + i * 8) wrapped in f64of(), and written with
// mem_store(p + i * 8, v). Writing `p[i]` -- or indexing a module GLOBAL this
// module allocated -- compiles to something that faults at run time. Every
// function below follows the shape of gguf_matvec() in gguf.quanta, which is the
// reference implementation.
//
// mem_alloc inside a loop is unsafe: the next iteration clobbers the pointer, so
// every buffer is allocated once in mm_init() and reused.

import std/gguf

let mm_rowcap = 0       // f64 elements per row, rounded up to a power of two
let mm_rowbuf = 0       // f64 scratch for one dequantized row
let mm_rowraw = 0       // raw quantized bytes for one row
let mm_rowraw_cap = 0

// Element ceiling for mm_load_small(), i.e. the largest tensor that may be
// materialized whole. Kept small on purpose: the point of the row-wise path is
// that nothing this big is ever dequantized at once.
let mm_small_cap = 8388608

fn mm_init(maxcols) {
    if mm_rowbuf != 0 { return 0 }
    let c = 1024
    while c < maxcols { c = c * 2 }
    mm_rowcap = c
    mm_rowbuf = mem_alloc(c * 8)
    // Raw buffer must hold the WIDEST per-element encoding: Q8_K is 292 bytes per
    // 256 elements (1.14 bytes/elem). 2 bytes/elem truncates a Q8_K row.
    mm_rowraw = mem_alloc(c * 2 + 4096)
    mm_rowraw_cap = c * 2 + 4096
    return 0
}

// Bytes for one row of `ncols` elements at `dtype`.
//
// (elements_per_block, bytes_per_block) from the table in gguf.quanta, itself
// derived from upstream ggml-common.h's static_asserts. The K-quants are NOT
// 18/22 per 256 elements: Q4_K is 144 and Q5_K is 176. A wrong size reads a
// fraction of the row, or past it.
fn mm_row_bytes(dtype, ncols) {
    if dtype == 0  { return ncols * 4 }        // F32
    if dtype == 1  { return ncols * 2 }        // F16
    if dtype == 30 { return ncols * 2 }        // BF16: 2 bytes/elem, not a 256 block
    if dtype == 2  { return (ncols / 32) * 18 }
    if dtype == 3  { return (ncols / 32) * 20 }
    if dtype == 6  { return (ncols / 32) * 22 }
    if dtype == 7  { return (ncols / 32) * 24 }
    if dtype == 8  { return (ncols / 32) * 34 }
    if dtype == 10 { return (ncols / 256) * 84 }
    if dtype == 11 { return (ncols / 256) * 110 }
    if dtype == 12 { return (ncols / 256) * 144 }
    if dtype == 13 { return (ncols / 256) * 176 }
    if dtype == 14 { return (ncols / 256) * 210 }
    if dtype == 15 { return (ncols / 256) * 292 }
    return 0
}

// Read + dequantize row `r` of tensor `idx` into mm_rowbuf. 0 on success.
fn mm_load_row(idx, r, row_elems) {
    let dtype = gguf_tensor_dtype(idx)
    let rb = mm_row_bytes(dtype, row_elems)
    if rb <= 0 || rb > mm_rowraw_cap { return -1 }
    // gguf_read_tensor_bytes_at returns the BYTE COUNT, not a status. Requiring an
    // exact match distinguishes a whole row from a short read; accepting a short
    // one dequantizes a partly-stale buffer into a plausible wrong answer.
    if gguf_read_tensor_bytes_at(idx, r * rb, mm_rowraw, rb) != rb { return -2 }
    if read_block_f64(dtype, mm_rowraw, row_elems, mm_rowbuf) == 0 { return -3 }
    return 0
}

// ---- chunked reads: TRIED, MEASURED SLOWER, NOT USED -------------------------
//
// Hypothesis: the row-at-a-time path costs ~99 s/token because a 2048x2048
// tensor is 2048 separate pread() calls of 2 KB each (~600k syscalls per token),
// so reading blocks of rows should amortise the syscall overhead.
//
// MEASURED: it does not help. Block reads made a token SLOWER (114 s vs 99-103 s
// baseline), because a 256 KB f64 block thrashes L2 where a 16 KB single row
// stays resident in L1.
//
// The real bottleneck is neither syscalls nor dequantisation:
//   - dequantising a whole 4.2M-element tensor takes 0.63 s
//   - one [2048 x 10752] ffn_gate matvec takes 1.51 s, of which ~0.9 s is the
//     inner dot-product loop: 22M MACs at ~25M MACs/s
// So the cost is the SCALAR f64 inner loop in the matvec, and llama.cpp runs the
// same model at ~110 tok/s because its dot products are vectorised.
//
// The fix is therefore SIMD/blocked dot products, not I/O. This function is kept
// because it is correct and bit-identical to mm_matvec (verified: mismatches=0 on
// a real Q4_K tensor), and it is the right shape for a vectorised dequant+dot --
// but do NOT switch the forward pass onto it expecting a speedup; that was tried
// and measured negative.
//
// Dequantization is bit-identical to the row path: both call the same
// read_block_f64 on the same bytes. That is what lets the existing
// mm test (which compares against the full-dequantize reference) still hold.

let mm_blk_elems = 32768      // elements per block, must be >= widest row
let mm_blk_raw = 0            // raw bytes for one block
let mm_blk_raw_cap = 0
let mm_blk_f64 = 0            // dequantized block, f64
let mm_blk_ready = 0

fn mm_blk_init(cols) {
    if mm_blk_ready != 0 && mm_blk_elems >= cols { return 0 }
    // block size = a whole number of rows where possible, so a block never
    // splits a row across two reads.
    let e = cols
    while e < 32768 { e = e + cols }
    mm_blk_elems = e
    mm_blk_raw = mem_alloc(e * 2 + 4096)
    mm_blk_raw_cap = e * 2 + 4096
    mm_blk_f64 = mem_alloc(e * 8)
    mm_blk_ready = 1
    return 0
}

// y = W x, reading `cols`-wide rows in blocks of mm_blk_elems.
//
// Same contract as mm_matvec. Falls back to the row path if the block buffers
// cannot be sized (a row wider than the cap).
fn mm_matvec_blk(idx: u64, x: u64, rows: i64, cols: i64, y: u64) {
    let dtype = gguf_tensor_dtype(idx)
    if gguf_dtype_supported(dtype) == 0 { return -1 }
    if mm_rowcap < cols { return -1 }
    let row_elems = gguf_tensor_nelements(idx) / rows
    if row_elems != cols { return -1 }
    if mm_blk_init(cols) != 0 { return mm_matvec(idx, x, rows, cols, y) }

    let rb = mm_row_bytes(dtype, cols)          // bytes per row
    if rb <= 0 { return -1 }
    let rows_per_blk = mm_blk_elems / cols
    if rows_per_blk <= 0 { return mm_matvec(idx, x, rows, cols, y) }

    let r0 = 0
    while r0 < rows {
        let nb = rows - r0
        let n = 0
        if nb < rows_per_blk { n = nb } else { n = rows_per_blk }
        let want = n * rb
        if want > mm_blk_raw_cap { return mm_matvec(idx, x, rows, cols, y) }
        // ONE pread for the whole block
        if gguf_read_tensor_bytes_at(idx, r0 * rb, mm_blk_raw, want) != want { return -2 }
        // ONE dequantize call for the whole block
        let elems = n * cols
        if read_block_f64(dtype, mm_blk_raw, elems, mm_blk_f64) == 0 { return -3 }

        let k = 0
        while k < n {
            let base = k * cols
            mem_store(y + (r0 + k) * 8, mm_dot4(mm_blk_f64 + base * 8, x, cols))
            k = k + 1
        }
        r0 = r0 + n
    }
    return 0
}

// y = W x. W is `rows` x `cols`; x holds cols f64 values, y receives rows.
fn mm_matvec(idx: u64, x: u64, rows: i64, cols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < cols { return -1 }
    let row_elems = gguf_tensor_nelements(idx) / rows
    if row_elems != cols { return -1 }

    let r = 0
    while r < rows {
        if mm_load_row(idx, r, row_elems) != 0 { return -1 }
        // 4-wide via the AVX2 builtins. NOTE the summation order changes (4
        // partial lanes combined at the end) so this is not bit-identical to a
        // scalar left-to-right sum in general; see mm_dot4.
        mem_store(y + r * 8, mm_dot4(mm_rowbuf, x, cols))
        r = r + 1
    }
    return 0
}

// One embedding row -> y, as f64 values of length ncols.
//
// This MUST copy out of mm_rowbuf. mm_load_row() fills the SHARED scratch
// buffer mm_rowbuf and returns 0; it does not write the caller's destination.
// An earlier version returned mm_load_row()'s status directly, so `y` was never
// populated: every embedding came back as whatever the caller's buffer held
// (zeros), the whole stack then ran on a zero activation, and the logits came
// out all 0.000000 -- which looks like "the model produced nothing" rather than
// like a missing copy.
fn mm_lookup_row(idx: u64, row: i64, ncols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if mm_load_row(idx, row, ncols) != 0 { return -2 }
    let i = 0
    while i < ncols {
        mem_store(y + i * 8, f64of(mem_load(mm_rowbuf + i * 8)))
        i = i + 1
    }
    return 0
}

// y[v] = dot(embd_row(v0 + v), x) for v in [0, vcount).
//
// Reading all 128000 rows per token would dominate generation cost, so the caller
// chooses the window: a sampled shortlist while sampling, or the full vocabulary
// once a token is settled.
fn mm_embed_logits(idx: u64, x: u64, v0: i64, vcount: i64, ncols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }

    let v = 0
    while v < vcount {
        if mm_load_row(idx, v0 + v, ncols) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < ncols {
            acc = acc + f64of(mem_load(mm_rowbuf + c * 8)) * f64of(mem_load(x + c * 8))
            c = c + 1
        }
        mem_store(y + v * 8, acc)
        v = v + 1
    }
    return 0
}
// Load a WHOLE small tensor into `dst` as f64, using read_tensor_f64.
//
// For a tensor small enough to hold (the short-conv kernel is [3, 2048] = 6144
// elements, and out_proj is 4.2 M) this is simpler and cheaper than a matvec per
// output element. It is NOT a general escape hatch: read_tensor_f64 materializes
// the whole tensor, so calling it on an FFN weight is exactly the 20 GB problem
// this file exists to avoid. The caller must size-check first.
fn mm_load_small(idx: u64, expect: i64, dst: u64) {
    if expect <= 0 { return -1 }
    if gguf_tensor_nelements(idx) != expect { return -1 }
    if expect > mm_small_cap { return -1 }
    read_tensor_f64(idx, dst)
    return expect
}

// ===========================================================================
// 4-wide dot product using the AVX2 f64 builtins.
//
// MEASURED: 67.1 ms -> 22.7 ms over 2048x2048 (2.95x), and the accumulated sum
// came out BIT-IDENTICAL to the scalar path on this data.
//
// ⚠️ It is NOT bit-identical in general. The 4 partial lanes are summed at the
// end, which is a different summation ORDER from a left-to-right scalar sum, and
// float addition is not associative. It matched here because the values happen to
// be benign. Any test asserting exact equality against a scalar reference must
// tolerate this, and the comparison against llama.cpp (which also uses SIMD) is
// the real oracle.
//
// The accumulator must live in MEMORY, not a local: the builtins take pointers.
// Scratch is a module global allocated once -- mem_alloc inside the loop would be
// clobbered by the next iteration.
let mm_dot_acc = 0
let mm_dot_tmp = 0

fn mm_dot4(a: u64, b: u64, n: i64) -> f64 {
    if mm_dot_acc == 0 {
        mm_dot_acc = mem_alloc(32)
        mm_dot_tmp = mem_alloc(32)
    }
    mem_store(mm_dot_acc, 0.0)
    mem_store(mm_dot_acc + 8, 0.0)
    mem_store(mm_dot_acc + 16, 0.0)
    mem_store(mm_dot_acc + 24, 0.0)

    let c = 0
    while c + 4 <= n {
        fmulf_avx2(mm_dot_tmp, a + c * 8, b + c * 8)
        faddf_avx2(mm_dot_acc, mm_dot_acc, mm_dot_tmp)
        c = c + 4
    }
    // horizontal sum of the 4 lanes
    let s0: f64 = f64of(mem_load(mm_dot_acc)) + f64of(mem_load(mm_dot_acc + 8))
    let s1: f64 = f64of(mem_load(mm_dot_acc + 16)) + f64of(mem_load(mm_dot_acc + 24))
    let acc: f64 = s0 + s1
    // tail
    let t: f64 = acc
    while c < n {
        t = t + f64of(mem_load(a + c * 8)) * f64of(mem_load(b + c * 8))
        c = c + 1
    }
    return t
}
