// lib/std/lfm2_mm.quanta -- bounded, descriptor-driven matvec for LFM2.
//
// WHY THIS FILE EXISTS
// --------------------
// The obvious implementation -- dequantize a weight tensor to f64, then matvec --
// needs 20.1 GB for this model, and the binary runs under MemoryMax=6G. So the
// weights are NEVER fully materialised. Every matvec here walks the tensor ROW BY
// ROW, dequantizes one row, accumulates, and reuses the same buffer.
//
// Peak cost is set by the widest single row, not by the tensor:
//
//     ffn_gate/up   2048 x 10752   row = 10752 f64 =  84 KB
//     attn_q/out    2048 x  2048   row =  2048 f64 =  16 KB
//     token_embd       1 x 128000  row = 128000 f64 = 1 MB
//
// 1 MB worst case, paid once, not per layer.
//
// MEMORY ACCESS CONVENTION (the part that is easy to get wrong)
// -------------------------------------------------------------
// A Quanta pointer is a raw address, not an array. Pointer arguments are read
// with mem_load(p + i * 8) wrapped in f64of(), and written with
// mem_store(p + i * 8, v). Writing `p[i]` -- or indexing a module GLOBAL this
// module allocated -- compiles to something that faults at run time. Every
// function below follows the shape of gguf_matvec() in gguf.quanta, which is the
// reference implementation.
//
// mem_alloc inside a loop is unsafe: the next iteration clobbers the pointer, so
// every buffer is allocated once in mm_init() and reused.

import std/gguf

let mm_rowcap = 0       // f64 elements per row, rounded up to a power of two
let mm_rowbuf = 0       // f64 scratch for one dequantized row
let mm_rowraw = 0       // raw quantized bytes for one row
let mm_rowraw_cap = 0

// Element ceiling for mm_load_small(), i.e. the largest tensor that may be
// materialized whole. Kept small on purpose: the point of the row-wise path is
// that nothing this big is ever dequantized at once.
let mm_small_cap = 8388608

fn mm_init(maxcols) {
    if mm_rowbuf != 0 { return 0 }
    let c = 1024
    while c < maxcols { c = c * 2 }
    mm_rowcap = c
    mm_rowbuf = mem_alloc(c * 8)
    // Raw buffer must hold the WIDEST per-element encoding: Q8_K is 292 bytes per
    // 256 elements (1.14 bytes/elem). 2 bytes/elem truncates a Q8_K row.
    mm_rowraw = mem_alloc(c * 2 + 4096)
    mm_rowraw_cap = c * 2 + 4096
    return 0
}

// Bytes for one row of `ncols` elements at `dtype`.
//
// (elements_per_block, bytes_per_block) from the table in gguf.quanta, itself
// derived from upstream ggml-common.h's static_asserts. The K-quants are NOT
// 18/22 per 256 elements: Q4_K is 144 and Q5_K is 176. A wrong size reads a
// fraction of the row, or past it.
fn mm_row_bytes(dtype, ncols) {
    if dtype == 0  { return ncols * 4 }        // F32
    if dtype == 1  { return ncols * 2 }        // F16
    if dtype == 30 { return ncols * 2 }        // BF16: 2 bytes/elem, not a 256 block
    if dtype == 2  { return (ncols / 32) * 18 }
    if dtype == 3  { return (ncols / 32) * 20 }
    if dtype == 6  { return (ncols / 32) * 22 }
    if dtype == 7  { return (ncols / 32) * 24 }
    if dtype == 8  { return (ncols / 32) * 34 }
    if dtype == 10 { return (ncols / 256) * 84 }
    if dtype == 11 { return (ncols / 256) * 110 }
    if dtype == 12 { return (ncols / 256) * 144 }
    if dtype == 13 { return (ncols / 256) * 176 }
    if dtype == 14 { return (ncols / 256) * 210 }
    if dtype == 15 { return (ncols / 256) * 292 }
    return 0
}

// Read + dequantize row `r` of tensor `idx` into mm_rowbuf. 0 on success.
fn mm_load_row(idx, r, row_elems) {
    let dtype = gguf_tensor_dtype(idx)
    let rb = mm_row_bytes(dtype, row_elems)
    if rb <= 0 || rb > mm_rowraw_cap { return -1 }
    // gguf_read_tensor_bytes_at returns the BYTE COUNT, not a status. Requiring an
    // exact match distinguishes a whole row from a short read; accepting a short
    // one dequantizes a partly-stale buffer into a plausible wrong answer.
    if gguf_read_tensor_bytes_at(idx, r * rb, mm_rowraw, rb) != rb { return -2 }
    if read_block_f64(dtype, mm_rowraw, row_elems, mm_rowbuf) == 0 { return -3 }
    return 0
}

// ---- chunked reads: TRIED, MEASURED SLOWER, NOT USED -------------------------
//
// Hypothesis: the row-at-a-time path costs ~99 s/token because a 2048x2048
// tensor is 2048 separate pread() calls of 2 KB each (~600k syscalls per token),
// so reading blocks of rows should amortise the syscall overhead.
//
// MEASURED: it does not help. Block reads made a token SLOWER (114 s vs 99-103 s
// baseline), because a 256 KB f64 block thrashes L2 where a 16 KB single row
// stays resident in L1.
//
// The real bottleneck is neither syscalls nor dequantisation:
//   - dequantising a whole 4.2M-element tensor takes 0.63 s
//   - one [2048 x 10752] ffn_gate matvec takes 1.51 s, of which ~0.9 s is the
//     inner dot-product loop: 22M MACs at ~25M MACs/s
// So the cost is the SCALAR f64 inner loop in the matvec, and llama.cpp runs the
// same model at ~110 tok/s because its dot products are vectorised.
//
// The fix is therefore SIMD/blocked dot products, not I/O. This function is kept
// because it is correct and bit-identical to mm_matvec (verified: mismatches=0 on
// a real Q4_K tensor), and it is the right shape for a vectorised dequant+dot --
// but do NOT switch the forward pass onto it expecting a speedup; that was tried
// and measured negative.
//
// Dequantization is bit-identical to the row path: both call the same
// read_block_f64 on the same bytes. That is what lets the existing
// mm test (which compares against the full-dequantize reference) still hold.

let mm_blk_elems = 32768      // elements per block, must be >= widest row
let mm_blk_raw = 0            // raw bytes for one block
let mm_blk_raw_cap = 0
let mm_blk_f64 = 0            // dequantized block, f64
let mm_blk_ready = 0

fn mm_blk_init(cols) {
    if mm_blk_ready != 0 && mm_blk_elems >= cols { return 0 }
    // block size = a whole number of rows where possible, so a block never
    // splits a row across two reads.
    let e = cols
    while e < 32768 { e = e + cols }
    mm_blk_elems = e
    mm_blk_raw = mem_alloc(e * 2 + 4096)
    mm_blk_raw_cap = e * 2 + 4096
    mm_blk_f64 = mem_alloc(e * 8)
    mm_blk_ready = 1
    return 0
}

// y = W x, reading `cols`-wide rows in blocks of mm_blk_elems.
//
// Same contract as mm_matvec. Falls back to the row path if the block buffers
// cannot be sized (a row wider than the cap).
fn mm_matvec_blk(idx: u64, x: u64, rows: i64, cols: i64, y: u64) {
    let dtype = gguf_tensor_dtype(idx)
    if gguf_dtype_supported(dtype) == 0 { return -1 }
    if mm_rowcap < cols { return -1 }
    let row_elems = gguf_tensor_nelements(idx) / rows
    if row_elems != cols { return -1 }
    if mm_blk_init(cols) != 0 { return mm_matvec(idx, x, rows, cols, y) }

    let rb = mm_row_bytes(dtype, cols)          // bytes per row
    if rb <= 0 { return -1 }
    let rows_per_blk = mm_blk_elems / cols
    if rows_per_blk <= 0 { return mm_matvec(idx, x, rows, cols, y) }

    let r0 = 0
    while r0 < rows {
        let nb = rows - r0
        let n = 0
        if nb < rows_per_blk { n = nb } else { n = rows_per_blk }
        let want = n * rb
        if want > mm_blk_raw_cap { return mm_matvec(idx, x, rows, cols, y) }
        // ONE pread for the whole block
        if gguf_read_tensor_bytes_at(idx, r0 * rb, mm_blk_raw, want) != want { return -2 }
        // ONE dequantize call for the whole block
        let elems = n * cols
        if read_block_f64(dtype, mm_blk_raw, elems, mm_blk_f64) == 0 { return -3 }

        let k = 0
        while k < n {
            let base = k * cols
            mem_store(y + (r0 + k) * 8, mm_dot4(mm_blk_f64 + base * 8, x, cols))
            k = k + 1
        }
        r0 = r0 + n
    }
    return 0
}

// ---- row-parallel matvec -------------------------------------------------
//
// Workers take DISJOINT STATIC ROW SLICES. That is not a convenience: Quanta has
// no atomics, so a work-stealing counter would race (measured 931/2048 rows
// wrong). Static slices make the partition contention-free and deterministic.
//
// Every worker uses mm_load_row_s / mm_dot4_s, which touch no module global, so
// the only shared state is `y`, and each row of `y` is written by exactly one
// worker.
//
// State is read from module globals here because the parent fills them BEFORE
// creating any thread; the workers only read. That ordering is what makes it
// safe -- there is no concurrent writer.
let pm_idx = 0
let pm_x = 0
let pm_rows = 0
let pm_cols = 0
let pm_y = 0
let pm_nworkers = 0

fn pm_worker(t: i64) -> i64 {
    // one scratch set per worker, allocated once and reused for every row
    let cell = mm_scratch_new(pm_cols)
    let per = pm_rows / pm_nworkers
    let lo = t * per
    let hi = lo + per
    // the last worker absorbs the remainder so no row is left unowned
    if t == pm_nworkers - 1 { hi = pm_rows }
    if hi > pm_rows { hi = pm_rows }

    let r = lo
    while r < hi {
        if mm_load_row_s(pm_idx, r, pm_cols, cell) != 0 { return -1 }
        mem_store(pm_y + r * 8, mm_dot4_s(mem_load(cell + 8), pm_x, pm_cols, mem_load(cell + 16)))
        r = r + 1
    }
    return hi - lo
}

// mm_matvec_par(idx, x, rows, cols, y, nworkers) -> 0 on success.
// One output element per row, exactly as the serial path.
//
// WORKER POOL, NOT PER-CALL THREADS (see the pool section below for why):
// thread_create() maps a fresh 1 MB child stack per call and thread_join()
// never unmaps it, so one thread per worker per matvec leaked ~1 MB per worker
// per matvec -- measured 2329 clone() calls inside ONE 30-layer forward, i.e.
// ~2.3 GB of address space. The pool spawns the workers ONCE and feeds them
// jobs, so a forward costs one set of stacks instead of thousands.
fn mm_matvec_par(idx: u64, x: u64, rows: i64, cols: i64, y: u64, nworkers: i64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if rows <= 0 || cols <= 0 { return -1 }
    if nworkers <= 1 { return mm_matvec_blk(idx, x, rows, cols, y) }
    let per = rows / nworkers
    if per < 1 { return mm_matvec_blk(idx, x, rows, cols, y) }

    // zero y so a worker that fails leaves a detectable value rather than
    // whatever was there before
    let r = 0
    while r < rows { mem_store(y + r * 8, 0.0); r = r + 1 }

    pl_kind = 0
    pl_idx = idx
    pl_x = x
    pl_rows = rows
    pl_cols = cols
    pl_y = y
    pl_nw = nworkers
    pl_active = nworkers
    // pl_cols MUST be set before mm_pool_ensure(): a worker allocates its
    // scratch cell from it at spawn time (mm_scratch_new(pl_cell_cols)).
    pl_cell_cols = cols
    if mm_pool_ensure(nworkers, cols) != 0 { return -1 }
    if pl_submit() != 0 { pl_kill(); return -1 }
    if pl_depth == 0 { mm_pool_end() }
    return 0
}

// y = W x. W is `rows` x `cols`; x holds cols f64 values, y receives rows.
// Worker count for mm_matvec. 0 or 1 means the serial path, which is the
// default so nothing changes for callers that do not opt in.
//
// Set this once at startup (e.g. mm_set_workers(8)) and every mm_matvec call
// site in the forward pass benefits at once -- there are ten of them and they
// all funnel through here. Leaving it 0 keeps the serial path byte-identical to
// before, which is what makes this safe to land first and tune later.
let mm_workers = 0
let mm_embed_workers = 0

fn mm_set_workers(n) {
    if n < 0 { n = 0 }
    mm_workers = n
    return 0
}

fn mm_set_embed_workers(n) {
    if n < 0 { n = 0 }
    mm_embed_workers = n
    return 0
}

fn mm_get_workers() { return mm_workers }

fn mm_matvec(idx: u64, x: u64, rows: i64, cols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < cols { return -1 }
    let row_elems = gguf_tensor_nelements(idx) / rows
    if row_elems != cols { return -1 }

    // Route to the row-parallel path when workers are enabled. It uses
    // mm_load_row_s / mm_dot4_s, which are the same reads and the same
    // arithmetic as the loop below -- same summation order, so results are
    // bit-identical, not merely close. Measured: 0 mismatches over all 10752
    // output rows at 1/2/4/8/16/20 workers, 5 repeat runs.
    if mm_workers > 1 {
        if rows / mm_workers >= 1 {
            return mm_matvec_par(idx, x, rows, cols, y, mm_workers)
        }
    }

    let r = 0
    while r < rows {
        if mm_load_row(idx, r, row_elems) != 0 { return -1 }
        // 4-wide via the AVX2 builtins. NOTE the summation order changes (4
        // partial lanes combined at the end) so this is not bit-identical to a
        // scalar left-to-right sum in general; see mm_dot4.
        mem_store(y + r * 8, mm_dot4(mm_rowbuf, x, cols))
        r = r + 1
    }
    return 0
}

// One embedding row -> y, as f64 values of length ncols.
//
// This MUST copy out of mm_rowbuf. mm_load_row() fills the SHARED scratch
// buffer mm_rowbuf and returns 0; it does not write the caller's destination.
// An earlier version returned mm_load_row()'s status directly, so `y` was never
// populated: every embedding came back as whatever the caller's buffer held
// (zeros), the whole stack then ran on a zero activation, and the logits came
// out all 0.000000 -- which looks like "the model produced nothing" rather than
// like a missing copy.
fn mm_lookup_row(idx: u64, row: i64, ncols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if mm_load_row(idx, row, ncols) != 0 { return -2 }
    let i = 0
    while i < ncols {
        mem_store(y + i * 8, f64of(mem_load(mm_rowbuf + i * 8)))
        i = i + 1
    }
    return 0
}

// y[v] = dot(embd_row(v0 + v), x) for v in [0, vcount).
//
// Reading all 128000 rows per token would dominate generation cost, so the caller
// chooses the window: a sampled shortlist while sampling, or the full vocabulary
// once a token is settled.
//
// When mm_embed_workers > 1, this routes to the parallel implementation
// (mm_embed_logits_par). The default is 0 (serial, byte-identical to before).
fn mm_embed_logits(idx: u64, x: u64, v0: i64, vcount: i64, ncols: i64, y: u64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if mm_embed_workers > 1 && vcount / mm_embed_workers >= 1 {
        return mm_embed_logits_par(idx, x, v0, vcount, ncols, y, mm_embed_workers)
    }

    let v = 0
    while v < vcount {
        if mm_load_row(idx, v0 + v, ncols) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < ncols {
            acc = acc + f64of(mem_load(mm_rowbuf + c * 8)) * f64of(mem_load(x + c * 8))
            c = c + 1
        }
        mem_store(y + v * 8, acc)
        v = v + 1
    }
    return 0
}

// y[v] = dot(embd_row(v0 + v), x) for v in [0, vcount). PARALLEL version.
// Static row partitioning, same as mm_matvec_par. Each worker owns [lo, hi)
// and uses its own scratch so there is no shared state.
// The caller sets the global mm_embed_workers (default 0 = serial).
fn mm_embed_logits_par(idx: u64, x: u64, v0: i64, vcount: i64, ncols: i64, y: u64, nworkers: i64) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return -1 }
    if mm_rowcap < ncols { return -1 }
    if nworkers <= 1 || vcount <= 0 {
        return mm_embed_logits(idx, x, v0, vcount, ncols, y)
    }
    let per = vcount / nworkers
    if per < 1 {
        return mm_embed_logits(idx, x, v0, vcount, ncols, y)
    }

    // zero y so a worker failure leaves a detectable value
    let v = 0
    while v < vcount { mem_store(y + v * 8, 0.0); v = v + 1 }

    // job descriptor for the shared pool worker (module-level; the driver fills
    // it BEFORE the generation bump, and the fence in pl_submit orders the two)
    pl_kind = 1
    pl_idx = idx
    pl_x = x
    pl_v0 = v0
    pl_vcount = vcount
    pl_ncols = ncols
    pl_y = y
    pl_nw = nworkers
    pl_active = nworkers
    pl_cell_cols = ncols
    if mm_pool_ensure(nworkers, ncols) != 0 { return -1 }
    if pl_submit() != 0 { pl_kill(); return -1 }
    if pl_depth == 0 { mm_pool_end() }
    return 0
}

// Worker for mm_embed_logits_par: computes a slice of [v0, v0+vcount).
fn pem_worker(t: i64) -> i64 {
    let cell = mm_scratch_new(pem_ncols)
    let per = pem_vcount / pem_nworkers
    let lo = t * per
    let hi = lo + per
    if t == pem_nworkers - 1 { hi = pem_vcount }
    if hi > pem_vcount { hi = pem_vcount }

    let v = lo
    while v < hi {
        if mm_load_row_s(pem_idx, pem_v0 + v, pem_ncols, cell) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < pem_ncols {
            acc = acc + f64of(mem_load(mem_load(cell + 8) + c * 8)) * f64of(mem_load(pem_x + c * 8))
            c = c + 1
        }
        mem_store(pem_y + (pem_v0 + v) * 8, acc)
        v = v + 1
    }
    return hi - lo
}

// module globals for pem_worker
let pem_idx = 0
let pem_x = 0
let pem_v0 = 0
let pem_vcount = 0
let pem_ncols = 0
let pem_y = 0
let pem_nworkers = 0

// Load a WHOLE small tensor into `dst` as f64, using read_tensor_f64.
//
// For a tensor small enough to hold (the short-conv kernel is [3, 2048] = 6144
// elements, and out_proj is 4.2 M) this is simpler and cheaper than a matvec per
// output element. It is NOT a general escape hatch: read_tensor_f64 materializes
// the whole tensor, so calling it on an FFN weight is exactly the 20 GB problem
// this file exists to avoid. The caller must size-check first.
fn mm_load_small(idx: u64, expect: i64, dst: u64) {
    if expect <= 0 { return -1 }
    if gguf_tensor_nelements(idx) != expect { return -1 }
    if expect > mm_small_cap { return -1 }
    read_tensor_f64(idx, dst)
    return expect
}

// ===========================================================================
// 4-wide dot product using the AVX2 f64 builtins.
//
// MEASURED: 67.1 ms -> 22.7 ms over 2048x2048 (2.95x), and the accumulated sum
// came out BIT-IDENTICAL to the scalar path on this data.
//
// ⚠️ It is NOT bit-identical in general. The 4 partial lanes are summed at the
// end, which is a different summation ORDER from a left-to-right scalar sum, and
// float addition is not associative. It matched here because the values happen to
// be benign. Any test asserting exact equality against a scalar reference must
// tolerate this, and the comparison against llama.cpp (which also uses SIMD) is
// the real oracle.
//
// The accumulator must live in MEMORY, not a local: the builtins take pointers.
// Scratch is a module global allocated once -- mem_alloc inside the loop would be
// clobbered by the next iteration.
let mm_dot_acc = 0
let mm_dot_tmp = 0

// ---- per-thread scratch --------------------------------------------------
//
// mm_load_row, mm_dot4 and mm_matvec_blk all use the module globals above
// (mm_rowraw, mm_rowbuf, mm_blk_raw, mm_blk_f64, mm_dot_acc, mm_dot_tmp).
// That is fine for one thread and a race by construction for several: two
// workers dequantising into mm_rowbuf would interleave and every row would be a
// mix of both. Static partitioning does NOT help -- the buffers are shared even
// when the rows are not.
//
// So the *_s variants below take their scratch explicitly and touch no global.
// Each worker allocates its own set once and reuses it for every row, which is
// what makes them cheap enough to call per row.
//
// mm_scratch is a 3-word cell: [0]=raw, [8]=f64 row, [16]=dot acc/tmp pair.
// Keeping it flat avoids a struct type in the calling convention.
fn mm_scratch_new(maxcols) {
    let c = 1024
    while c < maxcols { c = c * 2 }
    let raw = mem_alloc(c * 2 + 4096)
    let f64b = mem_alloc(c * 8)
    // dot needs 32 bytes: 4 accumulator lanes + 1 temporary
    let acc = mem_alloc(64)
    let cell = mem_alloc(24)
    mem_store(cell, raw)
    mem_store(cell + 8, f64b)
    mem_store(cell + 16, acc)
    return cell
}

// ---- scratch-taking variants of the hot primitives ----------------------

// mm_load_row_s(idx, r, row_elems, cell) == mm_load_row, using `cell` scratch.
// Byte-for-byte the same reads and the same dequant call as mm_load_row, so the
// output is identical -- only the destination buffer differs.
fn mm_load_row_s(idx, r, row_elems, cell) {
    let dtype = gguf_tensor_dtype(idx)
    let rb = mm_row_bytes(dtype, row_elems)
    let raw = mem_load(cell)
    let cap = row_elems * 2 + 4096
    if rb <= 0 || rb > cap { return -1 }
    if gguf_read_tensor_bytes_at(idx, r * rb, raw, rb) != rb { return -2 }
    if read_block_f64(dtype, raw, row_elems, mem_load(cell + 8)) == 0 { return -3 }
    return 0
}

// mm_dot4_s(a, b, n, acc) == mm_dot4 with an explicit accumulator buffer.
// Identical arithmetic and summation order -- the AVX2 builtin calls take
// pointers, so the only thing that changes is WHERE the lanes live.
fn mm_dot4_s(a: u64, b: u64, n: i64, acc) -> f64 {
    mem_store(acc, 0.0)
    mem_store(acc + 8, 0.0)
    mem_store(acc + 16, 0.0)
    mem_store(acc + 24, 0.0)

    let c = 0
    while c + 4 <= n {
        fmulf_avx2(acc + 32, a + c * 8, b + c * 8)
        faddf_avx2(acc, acc, acc + 32)
        c = c + 4
    }
    let s0: f64 = f64of(mem_load(acc)) + f64of(mem_load(acc + 8))
    let s1: f64 = f64of(mem_load(acc + 16)) + f64of(mem_load(acc + 24))
    let total: f64 = s0 + s1
    let t: f64 = total
    while c < n {
        t = t + f64of(mem_load(a + c * 8)) * f64of(mem_load(b + c * 8))
        c = c + 1
    }
    return t
}

fn mm_dot4(a: u64, b: u64, n: i64) -> f64 {
    if mm_dot_acc == 0 {
        mm_dot_acc = mem_alloc(32)
        mm_dot_tmp = mem_alloc(32)
    }
    mem_store(mm_dot_acc, 0.0)
    mem_store(mm_dot_acc + 8, 0.0)
    mem_store(mm_dot_acc + 16, 0.0)
    mem_store(mm_dot_acc + 24, 0.0)

    let c = 0
    while c + 4 <= n {
        fmulf_avx2(mm_dot_tmp, a + c * 8, b + c * 8)
        faddf_avx2(mm_dot_acc, mm_dot_acc, mm_dot_tmp)
        c = c + 4
    }
    // horizontal sum of the 4 lanes
    let s0: f64 = f64of(mem_load(mm_dot_acc)) + f64of(mem_load(mm_dot_acc + 8))
    let s1: f64 = f64of(mem_load(mm_dot_acc + 16)) + f64of(mem_load(mm_dot_acc + 24))
    let acc: f64 = s0 + s1
    // tail
    let t: f64 = acc
    while c < n {
        t = t + f64of(mem_load(a + c * 8)) * f64of(mem_load(b + c * 8))
        c = c + 1
    }
    return t
}

// ===========================================================================
// PERSISTENT WORKER POOL for the row-parallel matvecs
// ===========================================================================
//
// WHY THIS EXISTS (measured, not assumed)
// --------------------------------------
// The per-call design -- thread_create() nworkers times, then thread_join() --
// is CORRECT but leaks address space: thread_create() mmaps a fresh 1 MB child
// stack (plus a 24-byte, page-rounded join slot) per call and thread_join()
// never unmaps either. `strace -f -e trace=mmap,clone` over ONE 30-layer
// forward at 20 workers counted **2329 clone() calls** = ~2.3 GB of address
// space leaked per forward, and 20 worker scratch cells per matvec on top.
// Under a 4 GB address-space cap (1.67 GB model + heap) the leak exhausts the
// space mid-forward; the NEXT thread_create's 1 MB mmap returns ENOMEM, and the
// emitter's MAP_FAILED guard runs `mov edi,1; mov eax,60; syscall` -- exit(1)
// ON THE MAIN THREAD -- so the forward dies before the caller's next statement,
// silently: the process is reported as exited 0 (the worker threads of the
// group keep running and the group's final status comes out 0). That is the
// "dies after exactly one threaded forward, rc=0" defect.
//
// THE FIX: spawn the workers ONCE and feed them jobs. A forward then costs one
// set of stacks (nworkers) instead of 2329, and each worker allocates its
// scratch cell once instead of per matvec.
//
// PROTOCOL -- one job in flight; the driver (main thread) is the only writer of
// pl_gen, so no compare-and-swap is needed anywhere:
//
//   driver                         worker t
//   ------                         --------
//   fill pl_* job globals          loop:
//   fence()                          if *stop: exit loop
//   *gen = gen+1  (atomic_store)     g = *gen (atomic_load)
//   futex_wake(*gen)                 if g == last: futex_wait(*gen, last)
//   for each t:                      else: run its static slice;
//     wait done[t] == gen                  atomic_store(done[t], g); wake;
//                                          last = g
//
// done[t] is written by worker t ONLY and read by the driver, so there is no
// shared counter to race on. The driver sleeps in futex_wait (it does not spin,
// so it does not steal a core from the workers). futex_wait re-reads the word
// inside the kernel, so a wake that lands between the driver's load and a
// worker's wait is never lost.
//
// LIFETIME. `mm_pool_begin()` / `mm_pool_end()` nest by depth. The forward
// brackets one forward with them, so a caller that forgets anything still tears
// the pool down at the end of every forward and never hangs at process exit
// (the runtime ends main with exit(60), NOT exit_group(231), so a surviving
// worker thread WOULD hang the process). A generation loop can hold the pool
// across many forwards by calling mm_pool_begin() before the loop and
// mm_pool_end() after it -- then the stacks are paid once per process.
let pl_genp = 0          // ptr: job generation (driver writes, workers read)
let pl_stopp = 0         // ptr: 1 = tear the pool down
let pl_donep = 0         // ptr: nworkers completion stamps (done[t] = gen)
let pl_slots = 0         // ptr: nworkers join slots from thread_create
let pl_size = 0          // workers currently alive (0 = no pool)
let pl_depth = 0         // begin/end nesting depth
let pl_cell_cols = 0     // cols the live workers' scratch cells were sized for
let pl_kind = 0          // 0 = matvec rows, 1 = embedding logits
let pl_idx = 0
let pl_x = 0
let pl_rows = 0
let pl_cols = 0
let pl_y = 0
let pl_v0 = 0
let pl_vcount = 0
let pl_ncols = 0
let pl_nw = 0            // active worker count for the current job
let pl_active = 0

// Static row slice, BYTE-IDENTICAL arithmetic to the old pm_worker: same reads
// (mm_load_row_s), same summation order (mm_dot4_s), same partition rule (the
// last worker absorbs the remainder).
fn pl_run_rows(t: i64, cell) {
    let per = pl_rows / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_rows }
    if hi > pl_rows { hi = pl_rows }
    let r = lo
    while r < hi {
        if mm_load_row_s(pl_idx, r, pl_cols, cell) != 0 { return -1 }
        mem_store(pl_y + r * 8, mm_dot4_s(mem_load(cell + 8), pl_x, pl_cols, mem_load(cell + 16)))
        r = r + 1
    }
    return hi - lo
}

// Static slice of [v0, v0+vcount), byte-identical to the old pem_worker.
fn pl_run_embed(t: i64, cell) {
    let per = pl_vcount / pl_nw
    let lo = t * per
    let hi = lo + per
    if t == pl_nw - 1 { hi = pl_vcount }
    if hi > pl_vcount { hi = pl_vcount }
    let v = lo
    while v < hi {
        if mm_load_row_s(pl_idx, pl_v0 + v, pl_ncols, cell) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < pl_ncols {
            acc = acc + f64of(mem_load(mem_load(cell + 8) + c * 8)) * f64of(mem_load(pl_x + c * 8))
            c = c + 1
        }
        mem_store(pl_y + (pl_v0 + v) * 8, acc)
        v = v + 1
    }
    return hi - lo
}

fn pl_run(t: i64, cell) {
    if pl_kind == 1 { return pl_run_embed(t, cell) }
    return pl_run_rows(t, cell)
}

// One pool worker. Scratch is allocated ONCE here and reused for every job.
// The worker function name is resolved at compile time by thread_create, and
// the child trampoline hands it `t` off the child's OWN stack, so nothing here
// depends on the creating frame surviving.
fn pl_worker(t: i64) -> i64 {
    let cell = mm_scratch_new(pl_cell_cols)
    let last = 0
    let go = 1
    while go == 1 {
        if atomic_load(pl_stopp) != 0 {
            go = 0
        } else {
            let g = atomic_load(pl_genp)
            if g != last {
                lfence()
                if t < pl_active { pl_run(t, cell) }
                atomic_store(pl_donep + t * 8, g)
                futex_wake(pl_donep + t * 8, 1)
                last = g
            } else {
                // re-checked inside the kernel: a generation bump that lands
                // between the load above and this call returns EAGAIN at once
                futex_wait(pl_genp, last)
            }
        }
    }
    return 0
}

// Keep the pool alive across nested begin/end pairs (used by the forward).
fn mm_pool_begin() {
    pl_depth = pl_depth + 1
    return 0
}

// Publish the next job generation and wait for every worker to finish it.
//
// The wait first re-checks worker liveness: thread_join() itself reads slot[0]
// as "0 = the thread has exited", and the kernel owns that word
// (CLONE_PARENT_SETTID writes the tid, exit clears it), so a zero while a job
// is in flight means that worker is gone -- it died spawning its scratch (an
// allocation failure) rather than stamping done[t]. Returning -1 then beats
// blocking forever on a stamp that can never arrive.
//
// A TIMED wait was tried here and REVERTED: a raw
// `syscall(202, uaddr, FUTEX_WAIT, val, &timespec, 0, 0)` made the token stream
// diverge (argmax 5922 -> 35808 / 8696, varying run to run) where the untimed
// wait below is stable at 5922 on the same binary. It corrupted the driver, so
// it is not used. Residual exposure, stated rather than hidden: a worker that
// dies AFTER this check (a trap inside its slice) still blocks the driver. The
// slice itself allocates nothing, so that needs a trap -- which would kill the
// serial path loudly too.
fn pl_submit() -> i64 {
    fence()
    let g = atomic_load(pl_genp) + 1
    atomic_store(pl_genp, g)
    futex_wake(pl_genp, pl_size)
    let t = 0
    while t < pl_size {
        let d = 1
        while d != 0 {
            if mem_load(mem_load(pl_slots + t * 8)) == 0 { return -1 }
            d = atomic_load(pl_donep + t * 8)
            if d == g { d = 0 } else { futex_wait(pl_donep + t * 8, d) }
        }
        t = t + 1
    }
    return 0
}

// Tear the pool down unconditionally: tell the workers to leave, wake them,
// join them. Safe to call with no pool (pl_size == 0).
fn pl_kill() {
    if pl_size <= 0 { return 0 }
    atomic_store(pl_stopp, 1)
    fence()
    let g = atomic_load(pl_genp) + 1
    atomic_store(pl_genp, g)
    futex_wake(pl_genp, pl_size)
    let t = 0
    while t < pl_size {
        thread_join(mem_load(pl_slots + t * 8))
        t = t + 1
    }
    pl_size = 0
    return 0
}

// Leave one begin/end bracket. The pool is torn down when the OUTERMOST bracket
// closes, so a caller holding the pool across a whole generation loop keeps it
// and still leaves nothing alive at process exit.
fn mm_pool_end() {
    if pl_depth > 0 { pl_depth = pl_depth - 1 }
    if pl_depth > 0 { return 0 }
    return pl_kill()
}

// Ensure a pool of exactly `n` workers whose scratch cells can hold `maxcols`.
// A different size or a wider row rebuilds the pool (tear down, spawn again).
// The begin/end depth is NOT touched: a rebuild keeps the caller's bracket.
fn mm_pool_ensure(n: i64, maxcols: i64) {
    if n <= 0 { return -1 }
    if pl_size == n && pl_cell_cols >= maxcols { return 0 }
    pl_kill()

    // fresh protocol cells every time: the workers start with last = 0 and the
    // generation must start at 0 too, or a reused word would look like a job
    pl_genp = mem_alloc(8)
    pl_stopp = mem_alloc(8)
    pl_donep = mem_alloc(n * 8)
    pl_slots = mem_alloc(n * 8)
    atomic_store(pl_genp, 0)
    atomic_store(pl_stopp, 0)
    // the workers size their scratch from this at spawn time
    pl_cell_cols = maxcols

    let t = 0
    while t < n {
        atomic_store(pl_donep + t * 8, 0)
        mem_store(pl_slots + t * 8, thread_create(pl_worker, t))
        t = t + 1
    }
    pl_size = n
    return 0
}
