// std/json.quanta — JSON Parser for Quanta
// Parses JSON into Quanta string/number/array/object/tree structures
// Uses existing str, vec, map stdlib

import std/str
import std/vec
import std/map

const JSON_MAX_DEPTH = 128;

const JSON_NULL = 0;
const JSON_BOOL = 1;
const JSON_NUMBER = 2;
const JSON_STRING = 3;
const JSON_ARRAY = 4;
const JSON_OBJECT = 5;

const JSON_VAL_TYPE = 0;
const JSON_VAL_I64 = 8;
const JSON_VAL_STR = 16;
const JSON_VAL_ARR = 24;
const JSON_VAL_OBJ = 32;
const JSON_VAL_SIZE = 40;

fn json_skip_ws(buf, idx) -> i64 {
    let n = len(buf);
    let i = idx;
    while i < n {
        let c = mem_load8(buf + 8 + i);
        if c != 32 && c != 10 && c != 13 && c != 9 { break; }
        i = i + 1;
    }
    return i;
}

fn json_parse_string(buf, idx) -> i64 {
    let n = len(buf);
    let i = idx;
    if i >= n || mem_load8(buf + 8 + i) != 34 { return -1; }
    i = i + 1;
    let start = i;
    // First pass: count output length (without full copy)
    let out_len = 0;
    let j = i;
    while j < n {
        let c = mem_load8(buf + 8 + j);
        if c == 34 { break; }
        if c == 92 {
            j = j + 1;
            if j >= n { return -1; }
            let esc = mem_load8(buf + 8 + j);
            if esc == 117 {  // \uXXXX - Unicode escape
                j = j + 1;
                // Parse 4 hex digits to determine UTF-8 length
                let code = 0;
                let k = 0;
                while k < 4 {
                    let hex_c = mem_load8(buf + 8 + j + k);
                    let val = 0;
                    if hex_c >= 48 && hex_c <= 57 { val = hex_c - 48; }
                    else if hex_c >= 97 && hex_c <= 102 { val = hex_c - 97 + 10; }
                    else if hex_c >= 65 && hex_c <= 70 { val = hex_c - 65 + 10; }
                    code = code * 16 + val;
                    k = k + 1;
                }
                // Count UTF-8 bytes
                if code < 128 { out_len = out_len + 1; }
                else if code < 2048 { out_len = out_len + 2; }
                else if code < 65536 { out_len = out_len + 3; }
                else { out_len = out_len + 3; }  // replacement char
                j = j + 3;  // extra +1 at end of loop
            } else {
                out_len = out_len + 1;
            }
        } else {
            out_len = out_len + 1;
        }
        j = j + 1;
    }
    if j >= n { return -1; }
    
    // Allocate with Quanta string layout: 8-byte length header + data + null terminator
    let out = mem_alloc(out_len + 9);  // 8 bytes header + data + null
    mem_store(out, out_len);  // Store length at offset 0
    let out_pos = 8;  // Data starts at offset 8
    while i < n {
        let c = mem_load8(buf + 8 + i);
        if c == 34 {
            mem_store8(out + out_pos, 0);
            return out;
        }
        if c == 92 {
            i = i + 1;
            if i >= n { return -1; }
            let esc = mem_load8(buf + 8 + i);
            if esc == 34 { mem_store8(out + out_pos, 34); out_pos = out_pos + 1; }
            else if esc == 92 { mem_store8(out + out_pos, 92); out_pos = out_pos + 1; }
            else if esc == 47 { mem_store8(out + out_pos, 47); out_pos = out_pos + 1; }
            else if esc == 98 { mem_store8(out + out_pos, 8); out_pos = out_pos + 1; }
            else if esc == 102 { mem_store8(out + out_pos, 12); out_pos = out_pos + 1; }
            else if esc == 110 { mem_store8(out + out_pos, 10); out_pos = out_pos + 1; }
            else if esc == 114 { mem_store8(out + out_pos, 13); out_pos = out_pos + 1; }
            else if esc == 116 { mem_store8(out + out_pos, 9); out_pos = out_pos + 1; }
            else if esc == 117 {  // \uXXXX - Unicode escape
                i = i + 1;
                // Parse 4 hex digits
                let code = 0;
                let k = 0;
                while k < 4 {
                    let hex_c = mem_load8(buf + 8 + i + k);
                    let val = 0;
                    if hex_c >= 48 && hex_c <= 57 { val = hex_c - 48; }
                    else if hex_c >= 97 && hex_c <= 102 { val = hex_c - 97 + 10; }
                    else if hex_c >= 65 && hex_c <= 70 { val = hex_c - 65 + 10; }
                    code = code * 16 + val;
                    k = k + 1;
                }
                i = i + 3;  // extra +1 at end of loop
    
                // Encode as UTF-8
                if code < 128 {
                    mem_store8(out + out_pos, code); out_pos = out_pos + 1;
                } else if code < 2048 {
                    mem_store8(out + out_pos, 192 | (code >> 6)); out_pos = out_pos + 1;
                    mem_store8(out + out_pos, 128 | (code & 63)); out_pos = out_pos + 1;
                } else if code < 65536 {
                    mem_store8(out + out_pos, 224 | (code >> 12)); out_pos = out_pos + 1;
                    mem_store8(out + out_pos, 128 | ((code >> 6) & 63)); out_pos = out_pos + 1;
                    mem_store8(out + out_pos, 128 | (code & 63)); out_pos = out_pos + 1;
                } else {
                    // Surrogate pairs - for simplicity, just encode as UTF-8 replacement char
                    mem_store8(out + out_pos, 239); out_pos = out_pos + 1;
                    mem_store8(out + out_pos, 191); out_pos = out_pos + 1;
                    mem_store8(out + out_pos, 189); out_pos = out_pos + 1;
                }
            }
            else { mem_store8(out + out_pos, 92); out_pos = out_pos + 1; mem_store8(out + out_pos, esc); out_pos = out_pos + 1; }
        } else {
            mem_store8(out + out_pos, c); out_pos = out_pos + 1;
        }
        i = i + 1;
    }
    return -1;
}

fn json_parse_string_end(buf, idx) -> i64 {
    let n = len(buf);
    let i = idx;
    if i >= n || mem_load8(buf + 8 + i) != 34 { return -1; }
    i = i + 1;
    while i < n {
        let c = mem_load8(buf + 8 + i);
        if c == 34 { return i + 1; }
        if c == 92 { i = i + 1; if i >= n { return -1; } }
        i = i + 1;
    }
    return -1;
}

fn json_parse_number(buf, idx) -> i64 {
    let n = len(buf);
    let i = idx;
    let neg = 0;
    if i < n && mem_load8(buf + 8 + i) == 45 { neg = 1; i = i + 1; }
    let val = 0;
    let has_digit = 0;
    while i < n {
        let c = mem_load8(buf + 8 + i);
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48);
            has_digit = 1;
            i = i + 1;
        } else { break; }
    }
    if !has_digit { return -1; }
    if neg { val = 0 - val; }
    return val;
}

fn json_parse_number_end(buf, idx) -> i64 {
    let n = len(buf);
    let i = idx;
    if i < n && mem_load8(buf + 8 + i) == 45 { i = i + 1; }
    while i < n {
        let c = mem_load8(buf + 8 + i);
        if c >= 48 && c <= 57 { i = i + 1; }
        else { break; }
    }
    return i;
}

fn json_skip_value(buf, idx) -> i64 {
    let n = len(buf);
    let i = json_skip_ws(buf, idx);
    if i >= n { return -1; }
    let c = mem_load8(buf + 8 + i);
    // number
    if c == 45 || (c >= 48 && c <= 57) {
        return json_parse_number_end(buf, i);
    }
    // string
    if c == 34 {
        return json_parse_string_end(buf, i);
    }
    // array
    if c == 91 {
        let depth = 1;
        i = i + 1;
        while i < n && depth > 0 {
            c = mem_load8(buf + 8 + i);
            if c == 91 { depth = depth + 1; }
            else if c == 93 { depth = depth - 1; }
            else if c == 34 { i = json_parse_string_end(buf, i); if i < 0 { return -1; } continue; }
            i = i + 1;
        }
        return i;
    }
    // object
    if c == 123 {
        let depth = 1;
        i = i + 1;
        while i < n && depth > 0 {
            c = mem_load8(buf + 8 + i);
            if c == 123 { depth = depth + 1; }
            else if c == 125 { depth = depth - 1; }
            else if c == 34 { i = json_parse_string_end(buf, i); if i < 0 { return -1; } continue; }
            i = i + 1;
        }
        return i;
    }
    // true (4 chars)
    if c == 116 { return i + 4; }
    // false (5 chars)
    if c == 102 { return i + 5; }
    // null (4 chars)
    if c == 110 { return i + 4; }
    return -1;
}

fn json_parse_value(buf, idx, depth) -> i64 {
    if depth > JSON_MAX_DEPTH { return -1; }
    let n = len(buf);
    let i = json_skip_ws(buf, idx);
    if i >= n { return -1; }
    let c = mem_load8(buf + 8 + i);
    
    // null
    if c == 110 {
        if i + 3 < n && mem_load8(buf + 8 + i + 1) == 117 && mem_load8(buf + 8 + i + 2) == 108 && mem_load8(buf + 8 + i + 3) == 108 {
            let v = mem_alloc(5);
            mem_store(v + JSON_VAL_TYPE, JSON_NULL);
            return v;
        }
        return -1;
    }
    // true
    if c == 116 {
        if i + 3 < n && mem_load8(buf + 8 + i + 1) == 114 && mem_load8(buf + 8 + i + 2) == 117 && mem_load8(buf + 8 + i + 3) == 101 {
            let v = mem_alloc(5);
            mem_store(v + JSON_VAL_TYPE, JSON_BOOL);
            mem_store(v + JSON_VAL_I64, 1);
            return v;
        }
        return -1;
    }
    // false
    if c == 102 {
        if i + 4 < n && mem_load8(buf + 8 + i + 1) == 97 && mem_load8(buf + 8 + i + 2) == 108 && mem_load8(buf + 8 + i + 3) == 115 && mem_load8(buf + 8 + i + 4) == 101 {
            let v = mem_alloc(5);
            mem_store(v + JSON_VAL_TYPE, JSON_BOOL);
            mem_store(v + JSON_VAL_I64, 0);
            return v;
        }
        return -1;
    }
    // number
    if c == 45 || (c >= 48 && c <= 57) {
        let num = json_parse_number(buf, i);
        if num < 0 { return -1; }
        let v = mem_alloc(5);
        mem_store(v + JSON_VAL_TYPE, JSON_NUMBER);
        mem_store(v + JSON_VAL_I64, num);
        return v;
    }
    // string
    if c == 34 {
        let s = json_parse_string(buf, i);
        if s < 0 { return -1; }
        let v = mem_alloc(5);
        mem_store(v + JSON_VAL_TYPE, JSON_STRING);
        mem_store(v + JSON_VAL_STR, s);
        return v;
    }
    // array
    if c == 91 {
        let arr = vec_new();
        i = i + 1;
        while 1 {
            i = json_skip_ws(buf, i);
            if i >= n { return -1; }
            c = mem_load8(buf + 8 + i);
            if c == 93 {
                let v = mem_alloc(5);
                mem_store(v + JSON_VAL_TYPE, JSON_ARRAY);
                mem_store(v + JSON_VAL_ARR, arr);
                return v;
            }
            let elem = json_parse_value(buf, i, depth + 1);
            if elem < 0 { return -1; }
            vec_push(arr, elem);
            i = json_skip_value(buf, i);
            if i < 0 { return -1; }
            i = json_skip_ws(buf, i);
            if i >= n { return -1; }
            c = mem_load8(buf + 8 + i);
            if c == 44 { i = i + 1; continue; }
            if c == 93 {
                let v = mem_alloc(5);
                mem_store(v + JSON_VAL_TYPE, JSON_ARRAY);
                mem_store(v + JSON_VAL_ARR, arr);
                return v;
            }
            return -1;
        }
    }
    // object
    if c == 123 {
        let obj = map_new();
        i = i + 1;
        while 1 {
            i = json_skip_ws(buf, i);
            if i >= n { return -1; }
            c = mem_load8(buf + 8 + i);
            if c == 125 {
                let v = mem_alloc(5);
                mem_store(v + JSON_VAL_TYPE, JSON_OBJECT);
                mem_store(v + JSON_VAL_OBJ, obj);
                return v;
            }
            if c != 34 { return -1; }
            let key = json_parse_string(buf, i);
            if key < 0 { return -1; }
            i = json_parse_string_end(buf, i);
            if i < 0 { return -1; }
            i = json_skip_ws(buf, i);
            if i >= n { return -1; }
            if mem_load8(buf + 8 + i) != 58 { return -1; }
            i = i + 1;
            let val = json_parse_value(buf, i, depth + 1);
            if val < 0 { return -1; }
            map_put(obj, key, val);
            i = json_skip_value(buf, i);
            if i < 0 { return -1; }
            i = json_skip_ws(buf, i);
            if i >= n { return -1; }
            c = mem_load8(buf + 8 + i);
            if c == 44 { i = i + 1; continue; }
            if c == 125 {
                let v = mem_alloc(5);
                mem_store(v + JSON_VAL_TYPE, JSON_OBJECT);
                mem_store(v + JSON_VAL_OBJ, obj);
                return v;
            }
            return -1;
        }
    }
    return -1;
}

fn json_parse(buf) -> i64 {
    return json_parse_value(buf, 0, 0);
}

fn json_get_type(val) -> i64 {
    return mem_load(val + JSON_VAL_TYPE);
}

fn json_get_number(val) -> i64 {
    return mem_load(val + JSON_VAL_I64);
}

fn json_get_bool(val) -> i64 {
    return mem_load(val + JSON_VAL_I64);
}

fn json_get_string(val) -> i64 {
    return mem_load(val + JSON_VAL_STR);
}

fn json_get_array(val) -> i64 {
    return mem_load(val + JSON_VAL_ARR);
}

fn json_get_object(val) -> i64 {
    return mem_load(val + JSON_VAL_OBJ);
}

fn json_array_len(arr) -> i64 {
    return vec_len(arr);
}

fn json_array_get(arr, idx) -> i64 {
    return vec_at(arr, idx);
}

fn json_object_get(obj, key) -> i64 {
    return map_get(obj, key);
}

fn init() -> i64 {
    return 0;
}