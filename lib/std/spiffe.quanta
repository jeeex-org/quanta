// Automatic SVID rotation
fn spiffe_auto_rotate(svid, socket_path, new_svid_out) {
    // Check if rotation needed
    let now = clock() / 1000000000
    if spiffe_svid_needs_rotation(svid, now) == 0 {
        return 0 // No rotation needed
    }
    
    let typ = spiffe_svid_get_type(svid)
    let id = 0
    let id_len = 0
    spiffe_svid_get_id(svid, id, id_len)
    
    if typ == 0 { // X509
        spire_agent_fetch_x509_svid(socket_path, id, id_len, new_svid_out)
    } else { // JWT
        // For JWT, need audience - simplified
        spire_agent_fetch_jwt_svid(socket_path, 0, 0, new_svid_out)
    }
    
    if id != 0 { mem_free(id) }
    return 0
}

// mTLS verification using SPIFFE
fn spiffe_mtls_verify_peer(peer_cert, peer_cert_len, local_bundle, now, spiffe_id_out, spiffe_id_len_out) {
    // Parse peer cert
    let parsed = x509_parse_cert(peer_cert, peer_cert_len)
    if parsed == 0 { return -1 }
    
    // Extract SPIFFE ID
    let res = spiffe_extract_svid_from_cert(parsed, spiffe_id_out, spiffe_id_len_out)
    
    // Verify against local bundle
    if res == 0 {
        res = spiffe_verify_x509_svid(parsed, local_bundle, now)
    }
    
    x509_free(parsed)
    return res
}

