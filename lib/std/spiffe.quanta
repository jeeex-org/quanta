// mTLS / SPIFFE — X.509-SVID / JWT-SVID parsing, workload identity, trust domain federation, automatic rotation via SPIRE agent API
// Pure Quanta implementation, zero external deps

include "x509.quanta"
include "x509_asn1.quanta"
include "tls_resumption.quanta"

// SPIFFE ID format: spiffe://trust-domain/path
// X.509-SVID: X.509 certificate with SPIFFE ID in URI SAN
// JWT-SVID: JWT token with SPIFFE ID in sub claim

// SPIFFE constants
let SPIFFE_SCHEME = "spiffe://"
let SPIFFE_SCHEME_LEN = 9

// Trust domain structure
let TRUST_DOMAIN_OFF_NAME = 0
let TRUST_DOMAIN_OFF_BUNDLE = 8
let TRUST_DOMAIN_OFF_BUNDLE_LEN = 16
let TRUST_DOMAIN_OFF_FEDERATION = 24
let TRUST_DOMAIN_STRUCT_SIZE = 32

// SVID structure offsets
let SVID_OFF_TYPE = 0        // 0 = X509, 1 = JWT
let SVID_OFF_SPIFFE_ID = 8
let SVID_OFF_SPIFFE_ID_LEN = 16
let SVID_OFF_CERT = 24       // for X509-SVID: cert pointer
let SVID_OFF_KEY = 32        // for X509-SVID: private key pointer
let SVID_OFF_JWT = 24        // for JWT-SVID: JWT token
let SVID_OFF_JWT_LEN = 32
let SVID_OFF_EXPIRY = 40
let SVID_OFF_HINT = 48       // rotation hint (time before expiry to rotate)
let SVID_STRUCT_SIZE = 56

// Bundle structure
let BUNDLE_OFF_TRUST_DOMAIN = 0
let BUNDLE_OFF_TRUST_DOMAIN_LEN = 8
let BUNDLE_OFF_X509_AUTHORITIES = 16
let BUNDLE_OFF_X509_AUTHORITIES_LEN = 24
let BUNDLE_OFF_JWT_AUTHORITIES = 32
let BUNDLE_OFF_JWT_AUTHORITIES_LEN = 40
let BUNDLE_STRUCT_SIZE = 48

// Federation relationship
let FEDERATION_OFF_TRUST_DOMAIN = 0
let FEDERATION_OFF_TRUST_DOMAIN_LEN = 8
let FEDERATION_OFF_BUNDLE = 16
let FEDERATION_OFF_BUNDLE_LEN = 24
let FEDERATION_STRUCT_SIZE = 32

// Workload identity
let WORKLOAD_OFF_SPIFFE_ID = 0
let WORKLOAD_OFF_SPIFFE_ID_LEN = 8
let WORKLOAD_OFF_SELECTORS = 16
let WORKLOAD_OFF_SELECTORS_LEN = 24
let WORKLOAD_OFF_SVID = 32
let WORKLOAD_OFF_SVID_TYPE = 40
let WORKLOAD_STRUCT_SIZE = 48

// SPIRE agent API endpoints
let SPIRE_AGENT_SOCKET = "/tmp/spire-agent/public/api.sock"
let SPIRE_SERVER_SOCKET = "/tmp/spire-server/private/api.sock"

// X.509-SVID TTL (short-lived)
let X509_SVID_TTL_DEFAULT = 3600 // 1 hour
let X509_SVID_ROTATION_WINDOW = 300 // 5 minutes before expiry

// JWT-SVID TTL
let JWT_SVID_TTL_DEFAULT = 3600 // 1 hour
let JWT_SVID_ROTATION_WINDOW = 300

// Context
let spiffe_trust_domains = 0
let spiffe_trust_domain_count = 0
let spiffe_federations = 0
let spiffe_federation_count = 0
let spiffe_workloads = 0
let spiffe_workload_count = 0

// Parse SPIFFE ID from string
// Returns trust_domain pointer/len and path pointer/len
fn spiffe_parse_id(spiffe_id, spiffe_id_len, trust_domain_out, trust_domain_len_out, path_out, path_len_out) {
    // Check prefix "spiffe://"
    if spiffe_id_len < SPIFFE_SCHEME_LEN { return -1 }
    let i = 0
    while i < SPIFFE_SCHEME_LEN {
        if mem_load8(spiffe_id + i) != mem_load8(SPIFFE_SCHEME + i) {
            return -1
        }
        i = i + 1
    }
    
    // Find first '/' after scheme (end of trust domain)
    let trust_domain_start = SPIFFE_SCHEME_LEN
    let trust_domain_end = trust_domain_start
    while trust_domain_end < spiffe_id_len {
        if mem_load8(spiffe_id + trust_domain_end) == 47 { // '/'
            break
        }
        trust_domain_end = trust_domain_end + 1
    }
    
    if trust_domain_end == spiffe_id_len {
        // No path component
        return -1
    }
    
    let trust_domain_len = trust_domain_end - trust_domain_start
    let path_start = trust_domain_end
    let path_len = spiffe_id_len - path_start
    
    // Copy trust domain
    let td_buf = mem_alloc(trust_domain_len + 1)
    if td_buf == 0 { return -1 }
    i = 0
    while i < trust_domain_len {
        mem_store8(td_buf + i, mem_load8(spiffe_id + trust_domain_start + i))
        i = i + 1
    }
    mem_store8(td_buf + trust_domain_len, 0)
    
    // Copy path
    let path_buf = mem_alloc(path_len + 1)
    if path_buf == 0 {
        mem_free(td_buf)
        return -1
    }
    i = 0
    while i < path_len {
        mem_store8(path_buf + i, mem_load8(spiffe_id + path_start + i))
        i = i + 1
    }
    mem_store8(path_buf + path_len, 0)
    
    w64(trust_domain_out, td_buf)
    w64(trust_domain_len_out, trust_domain_len)
    w64(path_out, path_buf)
    w64(path_len_out, path_len)
    return 0
}

// Build SPIFFE ID from trust domain and path
fn spiffe_build_id(trust_domain, trust_domain_len, path, path_len, id_out, id_len_out) {
    let total_len = SPIFFE_SCHEME_LEN + trust_domain_len + 1 + path_len
    let id = mem_alloc(total_len + 1)
    if id == 0 { return -1 }
    
    let i = 0
    while i < SPIFFE_SCHEME_LEN {
        mem_store8(id + i, mem_load8(SPIFFE_SCHEME + i))
        i = i + 1
    }
    let j = 0
    while j < trust_domain_len {
        mem_store8(id + i + j, mem_load8(trust_domain + j))
        j = j + 1
    }
    i = i + trust_domain_len
    mem_store8(id + i, 47) // '/'
    i = i + 1
    j = 0
    while j < path_len {
        mem_store8(id + i + j, mem_load8(path + j))
        j = j + 1
    }
    i = i + path_len
    mem_store8(id + i, 0)
    
    w64(id_out, id)
    w64(id_len_out, total_len)
    return 0
}

// Validate SPIFFE ID format
fn spiffe_validate_id(spiffe_id, spiffe_id_len) {
    let td = 0
    let td_len = 0
    let path = 0
    let path_len = 0
    let res = spiffe_parse_id(spiffe_id, spiffe_id_len, td, td_len, path, path_len)
    if td != 0 { mem_free(td) }
    if path != 0 { mem_free(path) }
    return res
}

// Extract SPIFFE ID from X.509 certificate (URI SAN)
fn spiffe_extract_svid_from_cert(cert, spiffe_id_out, spiffe_id_len_out) {
    let san_buf = 0
    let san_count = 0
    x509_parse_san(cert, san_buf, san_count)
    
    if san_count == 0 {
        w64(spiffe_id_out, 0)
        w64(spiffe_id_len_out, 0)
        return -1
    }
    
    let i = 0
    while i < san_count {
        let entry = r64(san_buf + i * 16)
        let entry_type = r64(entry)
        let entry_value = r64(entry + 8)
        
        // GEN_NAME_URI = 6
        if entry_type == 6 {
            // Calculate length of URI
            let uri_len = 0
            while mem_load8(entry_value + uri_len) != 0 {
                uri_len = uri_len + 1
            }
            
            // Validate it's a SPIFFE ID
            if spiffe_validate_id(entry_value, uri_len) == 0 {
                // Copy it
                let id_copy = mem_alloc(uri_len + 1)
                if id_copy == 0 {
                    x509_free_san(san_buf, san_count)
                    return -1
                }
                let j = 0
                while j < uri_len {
                    mem_store8(id_copy + j, mem_load8(entry_value + j))
                    j = j + 1
                }
                mem_store8(id_copy + uri_len, 0)
                
                w64(spiffe_id_out, id_copy)
                w64(spiffe_id_len_out, uri_len)
                x509_free_san(san_buf, san_count)
                return 0
            }
        }
        i = i + 1
    }
    
    x509_free_san(san_buf, san_count)
    w64(spiffe_id_out, 0)
    w64(spiffe_id_len_out, 0)
    return -1
}

// Create X.509-SVID certificate
// parent_cert: CA certificate
// parent_key: CA private key
// spiffe_id: SPIFFE ID for the workload
// ttl: time to live in seconds
// key_out: output private key
// cert_out: output certificate (DER)
fn spiffe_create_x509_svid(parent_cert, parent_key, spiffe_id, spiffe_id_len, ttl, key_out, cert_out, cert_len_out) {
    // Would need to:
    // 1. Generate key pair (using ML-KEM or X25519 or RSA)
    // 2. Build CSR with SPIFFE ID in URI SAN
    // 3. Sign with parent CA
    // For now placeholder
    w64(key_out, 0)
    w64(cert_out, 0)
    w64(cert_len_out, 0)
    return -1
}

// Verify X.509-SVID certificate chain
fn spiffe_verify_x509_svid(cert, bundle, now) {
    // 1. Parse certificate
    let parsed = x509_parse_cert(cert, 0) // need length
    if parsed == 0 { return -1 }
    
    // 2. Extract SPIFFE ID
    let spiffe_id = 0
    let spiffe_id_len = 0
    if spiffe_extract_svid_from_cert(parsed, spiffe_id, spiffe_id_len) != 0 {
        x509_free(parsed)
        return -1
    }
    
    // 3. Verify cert chain against bundle
    // Extract trust domain from SPIFFE ID
    let td = 0
    let td_len = 0
    let path = 0
    let path_len = 0
    spiffe_parse_id(spiffe_id, spiffe_id_len, td, td_len, path, path_len)
    
    // Find trust domain in bundle
    let bundle_td = r64(bundle + BUNDLE_OFF_TRUST_DOMAIN)
    let bundle_td_len = r64(bundle + BUNDLE_OFF_TRUST_DOMAIN_LEN)
    
    let match = 1
    if td_len != bundle_td_len {
        match = 0
    } else {
        let i = 0
        while i < td_len {
            if mem_load8(td + i) != mem_load8(bundle_td + i) {
                match = 0
                break
            }
            i = i + 1
        }
    }
    
    mem_free(td)
    mem_free(path)
    mem_free(spiffe_id)
    
    if match == 0 {
        x509_free(parsed)
        return -1
    }
    
    // 4. Check expiry
    if x509_is_expired(parsed, now) != 0 {
        x509_free(parsed)
        return -1
    }
    
    // 5. Verify against X.509 authorities in bundle
    // (would use x509_verify_chain)
    
    x509_free(parsed)
    return 0
}

// Parse JWT-SVID (simplified - just extract SPIFFE ID from sub claim)
fn spiffe_parse_jwt_svid(jwt, jwt_len, spiffe_id_out, spiffe_id_len_out, expiry_out) {
    // JWT format: header.payload.signature (base64url encoded, dot-separated)
    // For now just look for "sub":"spiffe://..."
    let sub_marker = "\"sub\":\"spiffe://"
    let marker_len = 16
    
    let i = 0
    while i + marker_len < jwt_len {
        let match = 1
        let j = 0
        while j < marker_len {
            if mem_load8(jwt + i + j) != mem_load8(sub_marker + j) {
                match = 0
                break
            }
            j = j + 1
        }
        if match == 1 {
            // Found sub claim with SPIFFE ID
            let start = i + marker_len - 1 // include the first quote
            // Find closing quote
            let end = start
            while end < jwt_len && mem_load8(jwt + end) != 34 { // "
                end = end + 1
            }
            let id_len = end - start
            
            let id_copy = mem_alloc(id_len + 1)
            if id_copy == 0 { return -1 }
            let k = 0
            while k < id_len {
                mem_store8(id_copy + k, mem_load8(jwt + start + k))
                k = k + 1
            }
            mem_store8(id_copy + id_len, 0)
            
            w64(spiffe_id_out, id_copy)
            w64(spiffe_id_len_out, id_len)
            
            // Try to extract exp claim
            let exp_marker = "\"exp\":"
            let exp_marker_len = 6
            let exp_val = 0
            let k2 = 0
            while k2 + exp_marker_len < jwt_len {
                let match2 = 1
                let j2 = 0
                while j2 < exp_marker_len {
                    if mem_load8(jwt + k2 + j2) != mem_load8(exp_marker + j2) {
                        match2 = 0
                        break
                    }
                    j2 = j2 + 1
                }
                if match2 == 1 {
                    // Parse number
                    let num_start = k2 + exp_marker_len
                    exp_val = 0
                    while num_start < jwt_len {
                        let c = mem_load8(jwt + num_start)
                        if c >= 48 && c <= 57 {
                            exp_val = exp_val * 10 + (c - 48)
                            num_start = num_start + 1
                        } else {
                            break
                        }
                    }
                    break
                }
                k2 = k2 + 1
            }
            w64(expiry_out, exp_val)
            return 0
        }
        i = i + 1
    }
    return -1
}

// Verify JWT-SVID signature (stub - would need JWS verification)
fn spiffe_verify_jwt_svid(jwt, jwt_len, bundle, now) {
    let spiffe_id = 0
    let spiffe_id_len = 0
    let expiry = 0
    if spiffe_parse_jwt_svid(jwt, jwt_len, spiffe_id, spiffe_id_len, expiry) != 0 {
        return -1
    }
    
    // Check expiry
    if expiry > 0 && now > expiry {
        if spiffe_id != 0 { mem_free(spiffe_id) }
        return -1
    }
    
    // Verify trust domain matches bundle
    let td = 0
    let td_len = 0
    let path = 0
    let path_len = 0
    spiffe_parse_id(spiffe_id, spiffe_id_len, td, td_len, path, path_len)
    
    let bundle_td = r64(bundle + BUNDLE_OFF_TRUST_DOMAIN)
    let bundle_td_len = r64(bundle + BUNDLE_OFF_TRUST_DOMAIN_LEN)
    
    let match = 1
    if td_len != bundle_td_len {
        match = 0
    } else {
        let i = 0
        while i < td_len {
            if mem_load8(td + i) != mem_load8(bundle_td + i) {
                match = 0
                break
            }
            i = i + 1
        }
    }
    
    mem_free(td)
    mem_free(path)
    if spiffe_id != 0 { mem_free(spiffe_id) }
    
    if match == 0 { return -1 }
    
    // Would verify JWS signature against JWT authorities in bundle
    return 0
}

// Create SVID structure
fn spiffe_svid_create_x509(cert, key, spiffe_id, spiffe_id_len, expiry, hint, svid_out) {
    let svid = mem_alloc(SVID_STRUCT_SIZE)
    if svid == 0 { return -1 }
    
    w64(svid + SVID_OFF_TYPE, 0) // X509
    w64(svid + SVID_OFF_SPIFFE_ID, spiffe_id) // takes ownership
    w64(svid + SVID_OFF_SPIFFE_ID_LEN, spiffe_id_len)
    w64(svid + SVID_OFF_CERT, cert)
    w64(svid + SVID_OFF_KEY, key)
    w64(svid + SVID_OFF_EXPIRY, expiry)
    w64(svid + SVID_OFF_HINT, hint)
    
    w64(svid_out, svid)
    return 0
}

fn spiffe_svid_create_jwt(jwt, jwt_len, spiffe_id, spiffe_id_len, expiry, hint, svid_out) {
    let svid = mem_alloc(SVID_STRUCT_SIZE)
    if svid == 0 { return -1 }
    
    w64(svid + SVID_OFF_TYPE, 1) // JWT
    w64(svid + SVID_OFF_SPIFFE_ID, spiffe_id)
    w64(svid + SVID_OFF_SPIFFE_ID_LEN, spiffe_id_len)
    w64(svid + SVID_OFF_JWT, jwt)
    w64(svid + SVID_OFF_JWT_LEN, jwt_len)
    w64(svid + SVID_OFF_EXPIRY, expiry)
    w64(svid + SVID_OFF_HINT, hint)
    
    w64(svid_out, svid)
    return 0
}

// Check if SVID needs rotation
fn spiffe_svid_needs_rotation(svid, now) {
    let expiry = r64(svid + SVID_OFF_EXPIRY)
    let hint = r64(svid + SVID_OFF_HINT)
    let rotation_time = expiry - hint
    if now >= rotation_time { return 1 }
    return 0
}

// Get SVID SPIFFE ID
fn spiffe_svid_get_id(svid, id_out, id_len_out) {
    w64(id_out, r64(svid + SVID_OFF_SPIFFE_ID))
    w64(id_len_out, r64(svid + SVID_OFF_SPIFFE_ID_LEN))
    return 0
}

// Get SVID type
fn spiffe_svid_get_type(svid) {
    return r64(svid + SVID_OFF_TYPE)
}

// Free SVID
fn spiffe_svid_free(svid) {
    if svid == 0 { return }
    let typ = r64(svid + SVID_OFF_TYPE)
    let spiffe_id = r64(svid + SVID_OFF_SPIFFE_ID)
    if spiffe_id != 0 { mem_free(spiffe_id) }
    
    if typ == 0 { // X509
        let cert = r64(svid + SVID_OFF_CERT)
        if cert != 0 { x509_free(cert) }
        let key = r64(svid + SVID_OFF_KEY)
        if key != 0 { mem_free(key) }
    } else { // JWT
        let jwt = r64(svid + SVID_OFF_JWT)
        if jwt != 0 { mem_free(jwt) }
    }
    mem_free(svid)
}

// Trust domain management
fn spiffe_trust_domain_create(name, name_len, bundle, bundle_len, td_out) {
    let td = mem_alloc(TRUST_DOMAIN_STRUCT_SIZE)
    if td == 0 { return -1 }
    
    let name_copy = mem_alloc(name_len + 1)
    if name_copy == 0 {
        mem_free(td)
        return -1
    }
    let i = 0
    while i < name_len {
        mem_store8(name_copy + i, mem_load8(name + i))
        i = i + 1
    }
    mem_store8(name_copy + name_len, 0)
    
    w64(td + TRUST_DOMAIN_OFF_NAME, name_copy)
    w64(td + TRUST_DOMAIN_OFF_NAME + 8, name_len) // reuse field for len
    w64(td + TRUST_DOMAIN_OFF_BUNDLE, bundle)
    w64(td + TRUST_DOMAIN_OFF_BUNDLE_LEN, bundle_len)
    w64(td + TRUST_DOMAIN_OFF_FEDERATION, 0)
    
    w64(td_out, td)
    return 0
}

fn spiffe_trust_domain_add_federation(td, federation) {
    w64(td + TRUST_DOMAIN_OFF_FEDERATION, federation)
    return 0
}

fn spiffe_trust_domain_free(td) {
    if td == 0 { return }
    let name = r64(td + TRUST_DOMAIN_OFF_NAME)
    if name != 0 { mem_free(name) }
    let bundle = r64(td + TRUST_DOMAIN_OFF_BUNDLE)
    if bundle != 0 { mem_free(bundle) }
    let fed = r64(td + TRUST_DOMAIN_OFF_FEDERATION)
    if fed != 0 { mem_free(fed) }
    mem_free(td)
}

// Bundle management
fn spiffe_bundle_create(trust_domain, trust_domain_len, x509_authorities, x509_auth_len, jwt_authorities, jwt_auth_len, bundle_out) {
    let bundle = mem_alloc(BUNDLE_STRUCT_SIZE)
    if bundle == 0 { return -1 }
    
    let td_copy = mem_alloc(trust_domain_len + 1)
    if td_copy == 0 {
        mem_free(bundle)
        return -1
    }
    let i = 0
    while i < trust_domain_len {
        mem_store8(td_copy + i, mem_load8(trust_domain + i))
        i = i + 1
    }
    mem_store8(td_copy + trust_domain_len, 0)
    
    w64(bundle + BUNDLE_OFF_TRUST_DOMAIN, td_copy)
    w64(bundle + BUNDLE_OFF_TRUST_DOMAIN_LEN, trust_domain_len)
    w64(bundle + BUNDLE_OFF_X509_AUTHORITIES, x509_authorities)
    w64(bundle + BUNDLE_OFF_X509_AUTHORITIES_LEN, x509_auth_len)
    w64(bundle + BUNDLE_OFF_JWT_AUTHORITIES, jwt_authorities)
    w64(bundle + BUNDLE_OFF_JWT_AUTHORITIES_LEN, jwt_auth_len)
    
    w64(bundle_out, bundle)
    return 0
}

fn spiffe_bundle_free(bundle) {
    if bundle == 0 { return }
    let td = r64(bundle + BUNDLE_OFF_TRUST_DOMAIN)
    if td != 0 { mem_free(td) }
    let x509_auth = r64(bundle + BUNDLE_OFF_X509_AUTHORITIES)
    if x509_auth != 0 { mem_free(x509_auth) }
    let jwt_auth = r64(bundle + BUNDLE_OFF_JWT_AUTHORITIES)
    if jwt_auth != 0 { mem_free(jwt_auth) }
    mem_free(bundle)
}

// Federation management
fn spiffe_federation_create(trust_domain, trust_domain_len, bundle, bundle_len, fed_out) {
    let fed = mem_alloc(FEDERATION_STRUCT_SIZE)
    if fed == 0 { return -1 }
    
    let td_copy = mem_alloc(trust_domain_len + 1)
    if td_copy == 0 {
        mem_free(fed)
        return -1
    }
    let i = 0
    while i < trust_domain_len {
        mem_store8(td_copy + i, mem_load8(trust_domain + i))
        i = i + 1
    }
    mem_store8(td_copy + trust_domain_len, 0)
    
    w64(fed + FEDERATION_OFF_TRUST_DOMAIN, td_copy)
    w64(fed + FEDERATION_OFF_TRUST_DOMAIN_LEN, trust_domain_len)
    w64(fed + FEDERATION_OFF_BUNDLE, bundle)
    w64(fed + FEDERATION_OFF_BUNDLE_LEN, bundle_len)
    
    w64(fed_out, fed)
    return 0
}

fn spiffe_federation_free(fed) {
    if fed == 0 { return }
    let td = r64(fed + FEDERATION_OFF_TRUST_DOMAIN)
    if td != 0 { mem_free(td) }
    let bundle = r64(fed + FEDERATION_OFF_BUNDLE)
    if bundle != 0 { spiffe_bundle_free(bundle) }
    mem_free(fed)
}

// Workload registration
fn spiffe_workload_register(spiffe_id, spiffe_id_len, selectors, selectors_len, svid, svid_type, workload_out) {
    let workload = mem_alloc(WORKLOAD_STRUCT_SIZE)
    if workload == 0 { return -1 }
    
    let id_copy = mem_alloc(spiffe_id_len + 1)
    if id_copy == 0 {
        mem_free(workload)
        return -1
    }
    let i = 0
    while i < spiffe_id_len {
        mem_store8(id_copy + i, mem_load8(spiffe_id + i))
        i = i + 1
    }
    mem_store8(id_copy + spiffe_id_len, 0)
    
    let sel_copy = mem_alloc(selectors_len + 1)
    if sel_copy == 0 {
        mem_free(id_copy)
        mem_free(workload)
        return -1
    }
    i = 0
    while i < selectors_len {
        mem_store8(sel_copy + i, mem_load8(selectors + i))
        i = i + 1
    }
    mem_store8(sel_copy + selectors_len, 0)
    
    w64(workload + WORKLOAD_OFF_SPIFFE_ID, id_copy)
    w64(workload + WORKLOAD_OFF_SPIFFE_ID_LEN, spiffe_id_len)
    w64(workload + WORKLOAD_OFF_SELECTORS, sel_copy)
    w64(workload + WORKLOAD_OFF_SELECTORS_LEN, selectors_len)
    w64(workload + WORKLOAD_OFF_SVID, svid)
    w64(workload + WORKLOAD_OFF_SVID_TYPE, svid_type)
    
    w64(workload_out, workload)
    return 0
}

fn spiffe_workload_free(workload) {
    if workload == 0 { return }
    let id = r64(workload + WORKLOAD_OFF_SPIFFE_ID)
    if id != 0 { mem_free(id) }
    let sel = r64(workload + WORKLOAD_OFF_SELECTORS)
    if sel != 0 { mem_free(sel) }
    let svid = r64(workload + WORKLOAD_OFF_SVID)
    if svid != 0 { spiffe_svid_free(svid) }
    mem_free(workload)
}

