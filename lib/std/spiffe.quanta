    // Send BundleRequest
    // Receive BundleResponse
    // Parse bundle
    w64(bundle_out, 0)
    return -1
}

// mTLS context for a workload
let mtls_ctx = 0
let mtls_ctx_initialized = 0

fn mtls_init(local_spiffe_id, local_spiffe_id_len, local_bundle, socket_path, ctx_out) {
    let ctx = mem_alloc(64)
    if ctx == 0 { return -1 }
    
    let id_copy = mem_alloc(local_spiffe_id_len + 1)
    if id_copy == 0 {
        mem_free(ctx)
        return -1
    }
    let i = 0
    while i < local_spiffe_id_len {
        mem_store8(id_copy + i, mem_load8(local_spiffe_id + i))
        i = i + 1
    }
    mem_store8(id_copy + local_spiffe_id_len, 0)
    
    w64(ctx, id_copy)
    w64(ctx + 8, local_spiffe_id_len)
    w64(ctx + 16, local_bundle)
    w64(ctx + 24, 0) // socket path - simplified
    w64(ctx + 32, 0) // X509 SVID
    w64(ctx + 40, 0) // JWT SVID
    w64(ctx + 48, 0) // rotation timer
    w64(ctx + 56, 0) // flags
    
    w64(ctx_out, ctx)
    mtls_ctx = ctx
    mtls_ctx_initialized = 1
    return 0
}

fn mtls_get_svid(ctx, svid_out) {
    if ctx == 0 { return -1 }
    let x509_svid = r64(ctx + 32)
    let jwt_svid = r64(ctx + 40)
    
    // Prefer X509-SVID for mTLS
    if x509_svid != 0 {
        w64(svid_out, x509_svid)
        return 0
    }
    if jwt_svid != 0 {
        w64(svid_out, jwt_svid)
        return 0
    }
    return -1
}

fn mtls_verify_peer(ctx, peer_cert, peer_cert_len, spiffe_id_out, spiffe_id_len_out) {
    if ctx == 0 { return -1 }
    let bundle = r64(ctx + 16)
    let now = clock() / 1000000000
    return spiffe_mtls_verify_peer(peer_cert, peer_cert_len, bundle, now, spiffe_id_out, spiffe_id_len_out)
}

fn mtls_rotate_svids(ctx, socket_path) {
    if ctx == 0 { return -1 }
    let x509_svid = r64(ctx + 32)
    let jwt_svid = r64(ctx + 40)
    let new_x509 = 0
    let new_jwt = 0
    
    if x509_svid != 0 {
        spiffe_auto_rotate(x509_svid, socket_path, new_x509)
        if new_x509 != 0 {
            w64(ctx + 32, new_x509)
        }
    }
    
    if jwt_svid != 0 {
        spiffe_auto_rotate(jwt_svid, socket_path, new_jwt)
        if new_jwt != 0 {
            w64(ctx + 40, new_jwt)
        }
    }
    
    return 0
}

fn mtls_free(ctx) {
    if ctx == 0 { return }
    let id = r64(ctx)
    if id != 0 { mem_free(id) }
    let x509_svid = r64(ctx + 32)
    if x509_svid != 0 { spiffe_svid_free(x509_svid) }
    let jwt_svid = r64(ctx + 40)
    if jwt_svid != 0 { spiffe_svid_free(jwt_svid) }
    let socket = r64(ctx + 24)
    if socket != 0 { mem_free(socket) }
    mem_free(ctx)
    if ctx == mtls_ctx {
        mtls_ctx = 0
        mtls_ctx_initialized = 0
    }
}