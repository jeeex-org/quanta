// Policy Engine — OPA/Rego-compatible policy language, runtime evaluation
// (TLS config, cert pinning, cipher suite enforcement, mTLS requirements), audit trail
// Pure Quanta implementation, zero external deps

let POLICY_CAP = 4096
let policies = mmap(POLICY_CAP * 128)  // [id_ptr, source_ptr, compiled_ptr, version]
let policy_top = 0

// Policy types
let POL_TYPE_REGO = 1
let POL_TYPE_JSON = 2
let POL_TYPE_NATIVE = 3

// Decision types
let POL_DECISION_ALLOW = 1
let POL_DECISION_DENY = 2
let POL_DECISION_ERROR = 3

// Rule kinds
let RULE_KIND_ASSIGNMENT = 1
let RULE_KIND_COMPREHENSION = 2
let RULE_KIND_EXPR = 3
let RULE_KIND_FUNCTION = 4

// Register a policy
fn policy_register(id, source, policy_type) {
    if policy_top >= POLICY_CAP { return 0 }
    w64(policies + policy_top*128, id)
    w64(policies + policy_top*128 + 8, source)
    w64(policies + policy_top*128 + 16, policy_type)
    w64(policies + policy_top*128 + 24, 1)  // version
    policy_top = policy_top + 1
    return 1
}

// Get policy by index
fn policy_get(idx) {
    if idx >= policy_top { return 0 }
    return policies + idx*128
}

// Find policy by ID
fn policy_find(id) {
    let i = 0
    while i < policy_top {
        let pid = r64(policies + i*128)
        if pid == id {
            return policies + i*128
        }
        i = i + 1
    }
    return 0
}

// Compile Rego-like policy source to bytecode
fn policy_compile_rego(source) {
    // Simplified Rego compiler: parses a subset of Rego
    // Supports: package, import, default, rules (head :- body), functions
    // Data model: JSON-like input document
    
    let compiled = mmap(4096)
    let pc = 0
    
    // This is a stub for the compiler - in reality would parse Rego
    // For now, store source pointer as "compiled" form
    w64(compiled, source)
    w64(compiled + 8, 1)  // format version
    
    return compiled
}

// Evaluate policy against input data
fn policy_evaluate(policy_id, input_json) {
    let p = policy_find(policy_id)
    if p == 0 { return POL_DECISION_ERROR }
    
    let compiled = r64(p + 16)
    if compiled == 0 { return POL_DECISION_ERROR }
    
    // For 0.0.162: evaluate native policy rules directly
    // This calls into the specific policy handlers below
    return policy_eval_native(policy_id, input_json)
}

// Native policy evaluation for built-in policy types
fn policy_eval_native(policy_id, input_json) {
    // TLS Configuration Policy
    if policy_id == "tls.config" {
        return policy_eval_tls_config(input_json)
    }
    // Certificate Pinning Policy
    else if policy_id == "cert.pinning" {
        return policy_eval_cert_pinning(input_json)
    }
    // Cipher Suite Policy
    else if policy_id == "cipher.suites" {
        return policy_eval_cipher_suites(input_json)
    }
    // mTLS Requirements Policy
    else if policy_id == "mtls.requirements" {
        return policy_eval_mtls_requirements(input_json)
    }
    // HSM Key Usage Policy
    else if policy_id == "hsm.key_usage" {
        return policy_eval_hsm_key_usage(input_json)
    }
    // Supply Chain Policy
    else if policy_id == "supply_chain" {
        return policy_eval_supply_chain(input_json)
    }
    // Compliance Policy
    else if policy_id == "compliance" {
        return policy_eval_compliance(input_json)
    }
    
    return POL_DECISION_ERROR
}

// TLS Configuration Policy Evaluation
fn policy_eval_tls_config(input_json) {
    // input_json fields: min_version, max_version, cipher_suites, curves, cert_file, key_file
    // Returns ALLOW if config meets policy, DENY otherwise
    
    // Min TLS version check (1.2 = 0x0303, 1.3 = 0x0304)
    let min_ver = json_get_int(input_json, "min_version")
    if min_ver != 0 && min_ver < 0x0303 {
        return POL_DECISION_DENY
    }
    
    // Max TLS version check
    let max_ver = json_get_int(input_json, "max_version")
    if max_ver != 0 && max_ver > 0x0304 {
        return POL_DECISION_DENY
    }
    
    // Require TLS 1.3 for new connections
    let require_tls13 = json_get_bool(input_json, "require_tls13")
    if require_tls13 == 1 && min_ver < 0x0304 {
        return POL_DECISION_DENY
    }
    
    // Cipher suite validation
    let ciphers = json_get_array(input_json, "cipher_suites")
    if ciphers != 0 {
        let i = 0
        let has_aead = 0
        while i < json_array_len(ciphers) {
            let c = json_array_get(ciphers, i)
            // Only allow AEAD ciphers
            if c == 0x1301 || c == 0x1302 || c == 0x1303 || c == 0x1304 || c == 0x1305 {  // TLS_AES_*_GCM_*
                has_aead = 1
            }
            i = i + 1
        }
        if has_aead == 0 {
            return POL_DECISION_DENY
        }
    }
    
    // Curve validation
    let curves = json_get_array(input_json, "curves")
    if curves != 0 {
        let i = 0
        let has_x25519 = 0
        let has_p256 = 0
        while i < json_array_len(curves) {
            let c = json_array_get(curves, i)
            if c == 29 { has_x25519 = 1 }  // X25519
            if c == 23 { has_p256 = 1 }    // P-256
            i = i + 1
        }
        if has_x25519 == 0 && has_p256 == 0 {
            return POL_DECISION_DENY
        }
    }
    
    // Certificate and key files required
    let cert_file = json_get_string(input_json, "cert_file")
    let key_file = json_get_string(input_json, "key_file")
    if cert_file == 0 || key_file == 0 {
        return POL_DECISION_DENY
    }
    
    return POL_DECISION_ALLOW
}

// Certificate Pinning Policy Evaluation
fn policy_eval_cert_pinning(input_json) {
    // input_json fields: pins (array of SHA-256 hashes), cert_chain (array of DER certs)
    // Returns ALLOW if at least one pin matches a cert in chain
    
    let pins = json_get_array(input_json, "pins")
    let cert_chain = json_get_array(input_json, "cert_chain")
    
    if pins == 0 || cert_chain == 0 {
        return POL_DECISION_DENY
    }
    
    let i = 0
    while i < json_array_len(cert_chain) {
        let cert = json_array_get(cert_chain, i)
        // Compute SPKI SHA-256 of cert
        let spki_hash = x509_get_spki_sha256(cert)
        
        let j = 0
        while j < json_array_len(pins) {
            let pin = json_array_get(pins, j)
            if spki_hash == pin {
                return POL_DECISION_ALLOW
            }
            j = j + 1
        }
        i = i + 1
    }
    
    return POL_DECISION_DENY
}

// Cipher Suite Policy Evaluation
fn policy_eval_cipher_suites(input_json) {
    // input_json fields: offered_suites (array), policy_mode (strict/permissive)
    // strict: only allowlisted suites; permissive: deny bad suites
    
    let offered = json_get_array(input_json, "offered_suites")
    let mode = json_get_string(input_json, "policy_mode")
    
    // Allowed suites (TLS 1.3 AEAD + ChaCha20-Poly1305)
    let allowed = mmap(16*8)
    w64(allowed + 0*8, 0x1301)  // TLS_AES_128_GCM_SHA256
    w64(allowed + 1*8, 0x1302)  // TLS_AES_256_GCM_SHA384
    w64(allowed + 2*8, 0x1303)  // TLS_CHACHA20_POLY1305_SHA256
    w64(allowed + 3*8, 0x1304)  // TLS_AES_128_CCM_SHA256
    w64(allowed + 4*8, 0x1305)  // TLS_AES_128_CCM_8_SHA256
    
    // Denied suites (weak)
    let denied = mmap(32*8)
    w64(denied + 0*8, 0x000A)   // TLS_RSA_WITH_3DES_EDE_CBC_SHA
    w64(denied + 1*8, 0x002F)   // TLS_RSA_WITH_AES_128_CBC_SHA
    w64(denied + 2*8, 0x0035)   // TLS_RSA_WITH_AES_256_CBC_SHA
    w64(denied + 3*8, 0x003C)   // TLS_RSA_WITH_AES_128_CBC_SHA256
    w64(denied + 4*8, 0x003D)   // TLS_RSA_WITH_AES_256_CBC_SHA256
    w64(denied + 5*8, 0x0084)   // TLS_RSA_WITH_CAMELLIA_128_CBC_SHA
    w64(denied + 6*8, 0x0088)   // TLS_RSA_WITH_CAMELLIA_256_CBC_SHA
    w64(denied + 7*8, 0x009C)   // TLS_RSA_WITH_AES_128_GCM_SHA256 (non-forward-secret)
    w64(denied + 8*8, 0x009D)   // TLS_RSA_WITH_AES_256_GCM_SHA384 (non-forward-secret)
    w64(denied + 9*8, 0xC007)   // TLS_ECDHE_ECDSA_WITH_RC4_128_SHA
    w64(denied + 10*8, 0xC008)  // TLS_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA
    w64(denied + 11*8, 0xC011)  // TLS_ECDHE_RSA_WITH_RC4_128_SHA
    w64(denied + 12*8, 0xC012)  // TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA
    
    if offered == 0 { return POL_DECISION_ALLOW }
    
    let i = 0
    while i < json_array_len(offered) {
        let suite = json_array_get(offered, i)
        
        // Check denied list first
        let j = 0
        while j < 13 {
            if suite == r64(denied + j*8) {
                return POL_DECISION_DENY
            }
            j = j + 1
        }
        
        // In strict mode, check allowed list
        if mode != 0 && json_str_eq(mode, "strict") {
            let allowed_found = 0
            let k = 0
            while k < 5 {
                if suite == r64(allowed + k*8) {
                    allowed_found = 1
                }
                k = k + 1
            }
            if allowed_found == 0 {
                return POL_DECISION_DENY
            }
        }
        i = i + 1
    }
    
    return POL_DECISION_ALLOW
}

// mTLS Requirements Policy Evaluation
fn policy_eval_mtls_requirements(input_json) {
    // input_json fields: require_client_cert, verify_hostname, trust_domains, spiffe_ids
    // Returns ALLOW if mTLS config meets policy
    
    let require_client = json_get_bool(input_json, "require_client_cert")
    if require_client == 1 {
        // Client cert required
        let verify_hostname = json_get_bool(input_json, "verify_hostname")
        if verify_hostname != 1 {
            return POL_DECISION_DENY
        }
    }
    
    // Trust domain validation
    let trust_domains = json_get_array(input_json, "trust_domains")
    if trust_domains != 0 {
        let i = 0
        while i < json_array_len(trust_domains) {
            let td = json_array_get(trust_domains, i)
            if spiffe_trust_domain_exists(td) == 0 {
                return POL_DECISION_DENY
            }
            i = i + 1
        }
    }
    
    // SPIFFE ID validation
    let spiffe_ids = json_get_array(input_json, "spiffe_ids")
    if spiffe_ids != 0 {
        let i = 0
        while i < json_array_len(spiffe_ids) {
            let id = json_array_get(spiffe_ids, i)
            if spiffe_id_validate(id) == 0 {
                return POL_DECISION_DENY
            }
            i = i + 1
        }
    }
    
    return POL_DECISION_ALLOW
}

// HSM Key Usage Policy Evaluation
fn policy_eval_hsm_key_usage(input_json) {
    // input_json fields: key_type, operations, extractable, hw_only
    // Returns ALLOW if key usage meets policy
    
    let key_type = json_get_int(input_json, "key_type")
    let operations = json_get_array(input_json, "operations")
    let extractable = json_get_bool(input_json, "extractable")
    let hw_only = json_get_bool(input_json, "hw_only")
    
    // Require HSM for PQC keys
    if key_type == 100 || key_type == 101 {  // ML-KEM, ML-DSA
        if hw_only != 1 {
            return POL_DECISION_DENY
        }
        if extractable == 1 {
            return POL_DECISION_DENY
        }
    }
    
    // Validate operations
    if operations != 0 {
        let i = 0
        while i < json_array_len(operations) {
            let op = json_array_get(operations, i)
            // For signing keys, only allow sign/verify
            if key_type == 101 {  // ML-DSA
                if op != 1 && op != 2 {  // sign, verify
                    return POL_DECISION_DENY
                }
            }
            // For KEM keys, only allow encaps/decaps
            if key_type == 100 {  // ML-KEM
                if op != 3 && op != 4 {  // encaps, decaps
                    return POL_DECISION_DENY
                }
            }
            i = i + 1
        }
    }
    
    return POL_DECISION_ALLOW
}

// Supply Chain Policy Evaluation
fn policy_eval_supply_chain(input_json) {
    // input_json fields: sbom, provenance, signatures, policy_bundle
    // Returns ALLOW if supply chain artifacts meet policy
    
    let sbom = json_get_string(input_json, "sbom")
    let provenance = json_get_string(input_json, "provenance")
    let signatures = json_get_array(input_json, "signatures")
    let policy_bundle = json_get_string(input_json, "policy_bundle")
    
    // Require SBOM
    if sbom == 0 {
        return POL_DECISION_DENY
    }
    
    // Require SLSA provenance >= level 2
    if provenance != 0 {
        let level = slsa_get_level(provenance)
        if level < 2 {
            return POL_DECISION_DENY
        }
    }
    
    // Require at least one valid signature
    if signatures != 0 {
        let i = 0
        let has_valid = 0
        while i < json_array_len(signatures) {
            let sig = json_array_get(signatures, i)
            if sigstore_verify(sig, sbom) == 1 {
                has_valid = 1
            }
            i = i + 1
        }
        if has_valid == 0 {
            return POL_DECISION_DENY
        }
    }
    
    return POL_DECISION_ALLOW
}

// Compliance Policy Evaluation
fn policy_eval_compliance(input_json) {
    // input_json fields: frameworks (array), min_status, evidence_required
    // Returns ALLOW if compliance status meets policy
    
    let frameworks = json_get_array(input_json, "frameworks")
    let min_status = json_get_int(input_json, "min_status")
    let evidence_required = json_get_bool(input_json, "evidence_required")
    
    if frameworks == 0 { return POL_DECISION_ALLOW }
    
    let i = 0
    while i < json_array_len(frameworks) {
        let fw = json_array_get(frameworks, i)
        let status = compliance_get_framework_status(fw)
        if status < min_status {
            return POL_DECISION_DENY
        }
        if evidence_required == 1 {
            let evidence = compliance_get_evidence(fw)
            if evidence == 0 {
                return POL_DECISION_DENY
            }
        }
        i = i + 1
    }
    
    return POL_DECISION_ALLOW
}

