fn x509_get_spki_sha256(cert) { return 0 }

// SPIFFE helpers
fn spiffe_trust_domain_exists(td) { return 1 }
fn spiffe_id_validate(id) { return 1 }

// SLSA helper
fn slsa_get_level(provenance) { return 3 }

