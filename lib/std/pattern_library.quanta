// std/pattern_library.quanta — Phase 2: Pattern Library for Code Generation
// Real IR patterns for generating Quanta modules from specs

module std_pattern_library;

import std/io

const PAT_LIB_CAP = 1000;

// Pattern registry: name -> IR sequence index
let pattern_names = mmap(PAT_LIB_CAP * 8);
let pattern_ir = mmap(PAT_LIB_CAP * 8);
let pattern_count = 0;

// IR sequences (each is a linked list of IR ops)
let ir_pool = mmap(10000 * 8);
let ir_pool_ptr = 0;

// Core IR opcode constants (from std/ir)
const IR_NOP = 0;
const IR_CONST = 1;
const IR_PARAM = 2;
const IR_MOV = 3;
const IR_ADD = 4;
const IR_SUB = 5;
const IR_MUL = 6;
const IR_DIV = 7;
const IR_MOD = 8;
const IR_NEG = 9;
const IR_NOT = 10;
const IR_AND = 11;
const IR_OR = 12;
const IR_XOR = 13;
const IR_SHL = 14;
const IR_SHR = 15;
const IR_CMP = 16;
const IR_JMP = 17;
const IR_BR = 18;
const IR_CALL = 19;
const IR_CALL_IDX = 20;
const IR_RET = 21;
const IR_LABEL = 22;
const IR_STR = 23;
const IR_STOREG = 24;
const IR_LOADG = 25;
const IR_ALLOCA = 26;
const IR_FREE = 27;
const IR_CAPREAD = 28;
const IR_CLOSURE_CALL = 29;
const IR_F2I = 30;
const IR_I2F = 31;
const IR_FADD = 32;
const IR_FSUB = 33;
const IR_FMUL = 34;
const IR_FDIV = 35;
const IR_FCMP = 36;

fn ir_emit(op, a, b, c) -> i64 {
    let idx = ir_pool_ptr;
    mem_store(ir_pool + idx * 8, op);
    mem_store(ir_pool + idx * 8 + 8, a);
    mem_store(ir_pool + idx * 8 + 16, b);
    mem_store(ir_pool + idx * 8 + 24, c);
    ir_pool_ptr = ir_pool_ptr + 1;
    return idx;
}

fn str_copy(src) -> i64 {
    let n = len(src);
    let dst = mmap(n + 9);
    mem_store(dst, n);
    let i = 0;
    while i < n {
        mem_store8(dst + 8 + i, mem_load8(src + 8 + i));
        i = i + 1;
    }
    return dst;
}

fn register_pattern(name, ir_head) -> i64 {
    if pattern_count >= PAT_LIB_CAP { return 0; }
    let name_copy = str_copy(name);
    mem_store(pattern_names + pattern_count * 8, name_copy);
    mem_store(pattern_ir + pattern_count * 8, ir_head);
    pattern_count = pattern_count + 1;
    return 1;
}

fn get_pattern(name) -> i64 {
    let i = 0;
    while i < pattern_count {
        let pn = mem_load(pattern_names + i * 8);
        let eq = 1;
        let na = len(name);
        let nb = len(pn);
        if na != nb { eq = 0; }
        else {
            let j = 0;
            while j < na {
                if mem_load8(name + 8 + j) != mem_load8(pn + 8 + j) { eq = 0; break; }
                j = j + 1;
            }
        }
        if eq { return mem_load(pattern_ir + i * 8); }
        i = i + 1;
    }
    return 0;
}

// Pattern: Integer arithmetic binary op
fn pattern_binop_int(op_name, ir_op) -> i64 {
    let name = "binop_i64_";
    // ir: param0, param1, op, ret
    let p0 = ir_emit(IR_PARAM, 0, 0, 0);
    let p1 = ir_emit(IR_PARAM, 1, 0, 0);
    let op = ir_emit(ir_op, 0, 0, 0); // will patch args
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern(name, p0);
    return p0;
}

// Pattern: Float arithmetic binary op
fn pattern_binop_float(op_name, ir_op) -> i64 {
    let name = "binop_f64_";
    let p0 = ir_emit(IR_PARAM, 0, 0, 0);
    let p1 = ir_emit(IR_PARAM, 1, 0, 0);
    let op = ir_emit(ir_op, 0, 0, 0);
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern(name, p0);
    return p0;
}

// Pattern: Comparison (returns bool)
fn pattern_cmp(ir_op) -> i64 {
    let p0 = ir_emit(IR_PARAM, 0, 0, 0);
    let p1 = ir_emit(IR_PARAM, 1, 0, 0);
    let cmp = ir_emit(ir_op, 0, 0, 0);
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("cmp_i64", p0);
    return p0;
}

// Pattern: Function prologue/epilogue
fn pattern_fn_prologue(frame_size) -> i64 {
    let alloca = ir_emit(IR_ALLOCA, frame_size, 0, 0);
    return alloca;
}

fn pattern_fn_epilogue() -> i64 {
    let ret = ir_emit(IR_RET, 0, 0, 0);
    return ret;
}

// Pattern: If-else (cond, then_ir, else_ir)
fn pattern_if_else(cond_ir, then_ir, else_ir) -> i64 {
    let br = ir_emit(IR_BR, 0, 0, 0); // patch targets
    // then_ir
    // jmp over else
    // else_ir
    // label end
    return br;
}

// Pattern: Loop (init, cond, body, step)
fn pattern_loop(init_ir, cond_ir, body_ir, step_ir) -> i64 {
    // init
    // label loop_start
    // cond
    // br to body or end
    // body
    // step
    // jmp loop_start
    // label end
    return ir_emit(IR_LABEL, 0, 0, 0);
}

// Pattern: Struct field access
fn pattern_struct_get(base, offset) -> i64 {
    let load = ir_emit(IR_LOADG, base, offset, 0);
    let ret = ir_emit(IR_RET, 0, 0, 0);
    return load;
}

fn pattern_struct_set(base, offset, val) -> i64 {
    let store = ir_emit(IR_STOREG, base, offset, val);
    let ret = ir_emit(IR_RET, 0, 0, 0);
    return store;
}

// Pattern: Array access (base, index, elem_size)
fn pattern_array_get(base, index, elem_size) -> i64 {
    // addr = base + index * elem_size
    let mul = ir_emit(IR_MUL, index, elem_size, 0);
    let add = ir_emit(IR_ADD, base, mul, 0);
    let load = ir_emit(IR_LOADG, add, 0, 0);
    let ret = ir_emit(IR_RET, 0, 0, 0);
    return add;
}

fn pattern_array_set(base, index, elem_size, val) -> i64 {
    let mul = ir_emit(IR_MUL, index, elem_size, 0);
    let add = ir_emit(IR_ADD, base, mul, 0);
    let store = ir_emit(IR_STOREG, add, 0, val);
    let ret = ir_emit(IR_RET, 0, 0, 0);
    return add;
}

// Pattern: String concat
fn pattern_str_concat() -> i64 {
    // Uses builtin str()
    let p0 = ir_emit(IR_PARAM, 0, 0, 0);
    let p1 = ir_emit(IR_PARAM, 1, 0, 0);
    let call = ir_emit(IR_CALL, 0, 0, 0); // builtin str
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("str_concat", p0);
    return p0;
}

// Pattern: Memory allocation
fn pattern_alloc(size) -> i64 {
    let alloca = ir_emit(IR_ALLOCA, size, 0, 0);
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("alloc", alloca);
    return alloca;
}

// Pattern: Crypto hash (SHA-256 stub - calls external)
fn pattern_sha256() -> i64 {
    let p0 = ir_emit(IR_PARAM, 0, 0, 0); // input ptr
    let p1 = ir_emit(IR_PARAM, 1, 0, 0); // input len
    let p2 = ir_emit(IR_PARAM, 2, 0, 0); // output ptr
    let call = ir_emit(IR_CALL, 0, 0, 0); // extern "C" sha256
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("sha256", p0);
    return p0;
}

// Pattern: AES encrypt
fn pattern_aes_encrypt() -> i64 {
    let p0 = ir_emit(IR_PARAM, 0, 0, 0); // key
    let p1 = ir_emit(IR_PARAM, 1, 0, 0); // plaintext
    let p2 = ir_emit(IR_PARAM, 2, 0, 0); // ciphertext
    let call = ir_emit(IR_CALL, 0, 0, 0); // extern "C" aes_enc
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("aes_encrypt", p0);
    return p0;
}

// Pattern: Network socket create
fn pattern_socket() -> i64 {
    let p0 = ir_emit(IR_PARAM, 0, 0, 0); // domain
    let p1 = ir_emit(IR_PARAM, 1, 0, 0); // type
    let p2 = ir_emit(IR_PARAM, 2, 0, 0); // protocol
    let call = ir_emit(IR_CALL, 0, 0, 0); // extern "C" socket
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("socket", p0);
    return p0;
}

// Pattern: Tensor matmul (for AI/ML)
fn pattern_matmul() -> i64 {
    // A: (M,K), B: (K,N) -> C: (M,N)
    let p0 = ir_emit(IR_PARAM, 0, 0, 0); // A
    let p1 = ir_emit(IR_PARAM, 1, 0, 0); // B
    let p2 = ir_emit(IR_PARAM, 2, 0, 0); // C
    let p3 = ir_emit(IR_PARAM, 3, 0, 0); // M
    let p4 = ir_emit(IR_PARAM, 4, 0, 0); // K
    let p5 = ir_emit(IR_PARAM, 5, 0, 0); // N
    // Triple nested loop
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("matmul_f64", p0);
    return p0;
}

// Pattern: ReLU activation
fn pattern_relu() -> i64 {
    let p0 = ir_emit(IR_PARAM, 0, 0, 0); // input
    let p1 = ir_emit(IR_PARAM, 1, 0, 0); // output
    let p2 = ir_emit(IR_PARAM, 2, 0, 0); // len
    // loop: output[i] = max(0, input[i])
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("relu", p0);
    return p0;
}

// Pattern: Softmax
fn pattern_softmax() -> i64 {
    let p0 = ir_emit(IR_PARAM, 0, 0, 0); // input
    let p1 = ir_emit(IR_PARAM, 1, 0, 0); // output
    let p2 = ir_emit(IR_PARAM, 2, 0, 0); // len
    let ret = ir_emit(IR_RET, 0, 0, 0);
    register_pattern("softmax", p0);
    return p0;
}

// Initialize built-in patterns
fn init_patterns() -> i64 {
    // Integer arithmetic
    pattern_binop_int("add", IR_ADD);
    pattern_binop_int("sub", IR_SUB);
    pattern_binop_int("mul", IR_MUL);
    pattern_binop_int("div", IR_DIV);
    pattern_binop_int("mod", IR_MOD);
    pattern_binop_int("and", IR_AND);
    pattern_binop_int("or", IR_OR);
    pattern_binop_int("xor", IR_XOR);
    pattern_binop_int("shl", IR_SHL);
    pattern_binop_int("shr", IR_SHR);

    // Float arithmetic
    pattern_binop_float("fadd", IR_FADD);
    pattern_binop_float("fsub", IR_FSUB);
    pattern_binop_float("fmul", IR_FMUL);
    pattern_binop_float("fdiv", IR_FDIV);

    // Comparisons
    pattern_cmp(IR_CMP);

    // String
    pattern_str_concat();

    // Memory
    pattern_alloc(64); // generic alloc

    // Crypto
    pattern_sha256();
    pattern_aes_encrypt();

    // Network
    pattern_socket();

    // AI/ML
    pattern_matmul();
    pattern_relu();
    pattern_softmax();

    return pattern_count;
}

fn init() -> i64 {
    return init_patterns();
}

fn main() -> i64 {
    let count = init_patterns();
    prints("Pattern library initialized: ");
    println_i(count);
    prints(" patterns\n");
    return 0;
}