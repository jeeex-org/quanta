fn aes128_enc(key16, pt16) {
  // state: 16 bytes (column-major: state[r + 4*c])
  let st = mem_alloc(2)              // 16 bytes
  let i = 0
  while i < 16 { mem_store8(st + i, mem_load8(pt16 + i)); i = i + 1 }
  // key schedule: 11 round keys of 16 bytes each
  let rk = mem_alloc(11 * 2)        // 11*16 = 176 bytes = 22 i64
  let c = 0
  while c < 16 { mem_store8(rk + c, mem_load8(key16 + c)); c = c + 1 }
  let rcon = 1
  let r = 1
  while r < 11 {
    let base = r * 16
    let prev = (r - 1) * 16
    // last word of previous round key
    let t0 = mem_load8(rk + prev + 12)
    let t1 = mem_load8(rk + prev + 13)
    let t2 = mem_load8(rk + prev + 14)
    let t3 = mem_load8(rk + prev + 15)
    // RotWord + SubWord
    let g0 = aes_sbox(t1) ^ rcon
    let g1 = aes_sbox(t2)
    let g2 = aes_sbox(t3)
    let g3 = aes_sbox(t0)
    mem_store8(rk + base + 0, mem_load8(rk + prev + 0) ^ g0)
    mem_store8(rk + base + 1, mem_load8(rk + prev + 1) ^ g1)
    mem_store8(rk + base + 2, mem_load8(rk + prev + 2) ^ g2)
    mem_store8(rk + base + 3, mem_load8(rk + prev + 3) ^ g3)
    mem_store8(rk + base + 4, mem_load8(rk + prev + 4) ^ mem_load8(rk + base + 0))
    mem_store8(rk + base + 5, mem_load8(rk + prev + 5) ^ mem_load8(rk + base + 1))
    mem_store8(rk + base + 6, mem_load8(rk + prev + 6) ^ mem_load8(rk + base + 2))
    mem_store8(rk + base + 7, mem_load8(rk + prev + 7) ^ mem_load8(rk + base + 3))
    mem_store8(rk + base + 8, mem_load8(rk + prev + 8) ^ mem_load8(rk + base + 4))
    mem_store8(rk + base + 9, mem_load8(rk + prev + 9) ^ mem_load8(rk + base + 5))
    mem_store8(rk + base + 10, mem_load8(rk + prev + 10) ^ mem_load8(rk + base + 6))
    mem_store8(rk + base + 11, mem_load8(rk + prev + 11) ^ mem_load8(rk + base + 7))
    mem_store8(rk + base + 12, mem_load8(rk + prev + 12) ^ mem_load8(rk + base + 8))
    mem_store8(rk + base + 13, mem_load8(rk + prev + 13) ^ mem_load8(rk + base + 9))
    mem_store8(rk + base + 14, mem_load8(rk + prev + 14) ^ mem_load8(rk + base + 10))
    mem_store8(rk + base + 15, mem_load8(rk + prev + 15) ^ mem_load8(rk + base + 11))
    // update rcon for next round (multiply by 2 in GF(2^8))
    rcon = aes_xtime(rcon)
    r = r + 1
  }
  // AddRoundKey(0)
  i = 0
  while i < 16 { mem_store8(st + i, mem_load8(st + i) ^ mem_load8(rk + 0 + i)); i = i + 1 }
  // 9 full rounds + final round
  r = 1
  while r < 10 {
    // SubBytes
    i = 0
    while i < 16 { mem_store8(st + i, aes_sbox(mem_load8(st + i))); i = i + 1 }
    // ShiftRows
    let s1 = mem_load8(st + 1); let s5 = mem_load8(st + 5); let s9 = mem_load8(st + 9); let s13 = mem_load8(st + 13)
    let s2 = mem_load8(st + 2); let s6 = mem_load8(st + 6); let s10 = mem_load8(st + 10); let s14 = mem_load8(st + 14)
    let s3 = mem_load8(st + 3); let s7 = mem_load8(st + 7); let s11 = mem_load8(st + 11); let s15 = mem_load8(st + 15)
    mem_store8(st + 1, s5); mem_store8(st + 5, s9); mem_store8(st + 9, s13); mem_store8(st + 13, s1)
    mem_store8(st + 2, s10); mem_store8(st + 6, s14); mem_store8(st + 10, s2); mem_store8(st + 14, s6)
    mem_store8(st + 3, s15); mem_store8(st + 7, s3); mem_store8(st + 11, s7); mem_store8(st + 15, s11)
    // MixColumns
    i = 0
    while i < 4 {
      let c0 = i * 4 + 0; let c1 = i * 4 + 1; let c2 = i * 4 + 2; let c3 = i * 4 + 3
      let a0 = mem_load8(st + c0); let a1 = mem_load8(st + c1); let a2 = mem_load8(st + c2); let a3 = mem_load8(st + c3)
      mem_store8(st + c0, aes_mul(a0, 2) ^ aes_mul(a1, 3) ^ a2 ^ a3)
      mem_store8(st + c1, a0 ^ aes_mul(a1, 2) ^ aes_mul(a2, 3) ^ a3)
      mem_store8(st + c2, a0 ^ a1 ^ aes_mul(a2, 2) ^ aes_mul(a3, 3))
      mem_store8(st + c3, aes_mul(a0, 3) ^ a1 ^ a2 ^ aes_mul(a3, 2))
      i = i + 1
    }
    // AddRoundKey(r)
    i = 0
    while i < 16 { mem_store8(st + i, mem_load8(st + i) ^ mem_load8(rk + r * 16 + i)); i = i + 1 }
    r = r + 1
  }
  // final round (SubBytes, ShiftRows, AddRoundKey — no MixColumns)
  i = 0
  while i < 16 { mem_store8(st + i, aes_sbox(mem_load8(st + i))); i = i + 1 }
  let s1 = mem_load8(st + 1); let s5 = mem_load8(st + 5); let s9 = mem_load8(st + 9); let s13 = mem_load8(st + 13)
  let s2 = mem_load8(st + 2); let s6 = mem_load8(st + 6); let s10 = mem_load8(st + 10); let s14 = mem_load8(st + 14)
  let s3 = mem_load8(st + 3); let s7 = mem_load8(st + 7); let s11 = mem_load8(st + 11); let s15 = mem_load8(st + 15)
  mem_store8(st + 1, s5); mem_store8(st + 5, s9); mem_store8(st + 9, s13); mem_store8(st + 13, s1)
  mem_store8(st + 2, s10); mem_store8(st + 6, s14); mem_store8(st + 10, s2); mem_store8(st + 14, s6)
  mem_store8(st + 3, s15); mem_store8(st + 7, s3); mem_store8(st + 11, s7); mem_store8(st + 15, s11)
  i = 0
  while i < 16 { mem_store8(st + i, mem_load8(st + i) ^ mem_load8(rk + 10 * 16 + i)); i = i + 1 }
  return st
}

