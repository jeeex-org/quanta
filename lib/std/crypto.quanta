// lib/crypto — built-in cryptography for Quanta. Pure-Quanta implementations
// over mem_* and the syscall3 builtin. 32-bit words are carried in i64 and masked
// with u32() after every operation (Quanta arithmetic is 64-bit).
// Import with:  import std/crypto
import std/str

// ---------- 32-bit helpers ----------
fn shr32(x, n) { return u32(x >> n) }
fn shl32(x, n) { return u32(x << n) }
fn rotr(x, n) { return u32(shr32(x, n) | shl32(x, 32 - n)) }
fn Ch(x, y, z) { return (x & y) ^ ((~x) & z) }
fn Maj(x, y, z) { return (x & y) ^ (x & z) ^ (y & z) }
fn Sig0(x) { return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22) }
fn Sig1(x) { return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25) }
fn sig0(x) { return rotr(x, 7) ^ rotr(x, 18) ^ shr32(x, 3) }
fn sig1(x) { return rotr(x, 17) ^ rotr(x, 19) ^ shr32(x, 10) }

// K: first 32 bits of the fractional parts of cube roots of primes 2..311.
fn k256(i) {
  if i == 0 { return 0x428a2f98 }
  if i == 1 { return 0x71374491 }
  if i == 2 { return 0xb5c0fbcf }
  if i == 3 { return 0xe9b5dba5 }
  if i == 4 { return 0x3956c25b }
  if i == 5 { return 0x59f111f1 }
  if i == 6 { return 0x923f82a4 }
  if i == 7 { return 0xab1c5ed5 }
  if i == 8 { return 0xd807aa98 }
  if i == 9 { return 0x12835b01 }
  if i == 10 { return 0x243185be }
  if i == 11 { return 0x550c7dc3 }
  if i == 12 { return 0x72be5d74 }
  if i == 13 { return 0x80deb1fe }
  if i == 14 { return 0x9bdc06a7 }
  if i == 15 { return 0xc19bf174 }
  if i == 16 { return 0xe49b69c1 }
  if i == 17 { return 0xefbe4786 }
  if i == 18 { return 0x0fc19dc6 }
  if i == 19 { return 0x240ca1cc }
  if i == 20 { return 0x2de92c6f }
  if i == 21 { return 0x4a7484aa }
  if i == 22 { return 0x5cb0a9dc }
  if i == 23 { return 0x76f988da }
  if i == 24 { return 0x983e5152 }
  if i == 25 { return 0xa831c66d }
  if i == 26 { return 0xb00327c8 }
  if i == 27 { return 0xbf597fc7 }
  if i == 28 { return 0xc6e00bf3 }
  if i == 29 { return 0xd5a79147 }
  if i == 30 { return 0x06ca6351 }
  if i == 31 { return 0x14292967 }
  if i == 32 { return 0x27b70a85 }
  if i == 33 { return 0x2e1b2138 }
  if i == 34 { return 0x4d2c6dfc }
  if i == 35 { return 0x53380d13 }
  if i == 36 { return 0x650a7354 }
  if i == 37 { return 0x766a0abb }
  if i == 38 { return 0x81c2c92e }
  if i == 39 { return 0x92722c85 }
  if i == 40 { return 0xa2bfe8a1 }
  if i == 41 { return 0xa81a664b }
  if i == 42 { return 0xc24b8b70 }
  if i == 43 { return 0xc76c51a3 }
  if i == 44 { return 0xd192e819 }
  if i == 45 { return 0xd6990624 }
  if i == 46 { return 0xf40e3585 }
  if i == 47 { return 0x106aa070 }
  if i == 48 { return 0x19a4c116 }
  if i == 49 { return 0x1e376c08 }
  if i == 50 { return 0x2748774c }
  if i == 51 { return 0x34b0bcb5 }
  if i == 52 { return 0x391c0cb3 }
  if i == 53 { return 0x4ed8aa4a }
  if i == 54 { return 0x5b9cca4f }
  if i == 55 { return 0x682e6ff3 }
  if i == 56 { return 0x748f82ee }
  if i == 57 { return 0x78a5636f }
  if i == 58 { return 0x84c87814 }
  if i == 59 { return 0x8cc70208 }
  if i == 60 { return 0x90befffa }
  if i == 61 { return 0xa4506ceb }
  if i == 62 { return 0xbef9a3f7 }
  return 0xc67178f2   // 63
}

// padbyte: the byte that belongs at absolute message position `p` within block
// `blk` (of `total` blocks). Standard SHA-256 padding:
//   - if p < mlen: the actual message byte
//   - else if p == mlen: 0x80 (the appended '1' bit)
//   - in the FINAL block, bytes 56..63 carry the 64-bit big-endian length in bits
//   - otherwise: 0x00
fn padbyte(msg, mlen, p, total, blk) {
  if p < mlen { return mem_load8(msg + p) }
  if p == mlen { return 0x80 }
  if blk == total - 1 {
    let pos_in_block = p - blk * 64
    if pos_in_block >= 56 {
      let bitlen = mlen * 8
      let li = pos_in_block - 56
      return u32(bitlen >> (56 - li * 8)) & 0xff
    }
  }
  return 0
}

// sha256(msg, len) -> ptr to 32-byte big-endian digest buffer.
fn sha256(msg, mlen) {
  // H init
  let H = mem_alloc(8)          // 8 words (each 8 bytes) -> we store as i64 masked u32
  mem_store(H,       0x6a09e667)
  mem_store(H + 8,   0xbb67ae85)
  mem_store(H + 16,  0x3c6ef372)
  mem_store(H + 24,  0xa54ff53a)
  mem_store(H + 32,  0x510e527f)
  mem_store(H + 40,  0x9b05688c)
  mem_store(H + 48,  0x1f83d9ab)
  mem_store(H + 56,  0x5be0cd19)
  // message schedule
  let w = mem_alloc(64)
  // padded length = (mlen + 1 + pad) padded to 64; total = ((mlen+8)>>6 +1)*64
  let total = ((mlen + 8) >> 6) + 1
  let total_bytes = total * 64
  let blk = 0
  while blk < total {
    let base = blk * 64
    // copy 16 words big-endian, with correct SHA-256 padding:
    //   - byte at position == mlen gets 0x80
    //   - the final block's last 8 bytes carry the 64-bit big-endian length
    let t = 0
    while t < 16 {
      let off = base + t * 4
      let b0 = padbyte(msg, mlen, off,     total, blk)
      let b1 = padbyte(msg, mlen, off + 1, total, blk)
      let b2 = padbyte(msg, mlen, off + 2, total, blk)
      let b3 = padbyte(msg, mlen, off + 3, total, blk)
      let word = u32((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
      mem_store(w + t * 8, word)
      t = t + 1
    }
    // extend
    t = 16
    while t < 64 {
      let s0 = sig0(mem_load(w + (t - 15) * 8))
      let s1 = sig1(mem_load(w + (t - 2) * 8))
      let val = u32(s1 + mem_load(w + (t - 7) * 8) + s0 + mem_load(w + (t - 16) * 8))
      mem_store(w + t * 8, val)
      t = t + 1
    }
    // compression
    let a = mem_load(H); let b = mem_load(H + 8); let c = mem_load(H + 16); let d = mem_load(H + 24)
    let e = mem_load(H + 32); let f = mem_load(H + 40); let g = mem_load(H + 48); let h = mem_load(H + 56)
    t = 0
    while t < 64 {
      let wt = mem_load(w + t * 8)
      let T1 = u32(h + Sig1(e) + Ch(e, f, g) + k256(t) + wt)
      let T2 = u32(Sig0(a) + Maj(a, b, c))
      h = g; g = f; f = e; e = u32(d + T1)
      d = c; c = b; b = a; a = u32(T1 + T2)
      t = t + 1
    }
    mem_store(H,      u32(a + mem_load(H)))
    mem_store(H + 8,  u32(b + mem_load(H + 8)))
    mem_store(H + 16, u32(c + mem_load(H + 16)))
    mem_store(H + 24, u32(d + mem_load(H + 24)))
    mem_store(H + 32, u32(e + mem_load(H + 32)))
    mem_store(H + 40, u32(f + mem_load(H + 40)))
    mem_store(H + 48, u32(g + mem_load(H + 48)))
    mem_store(H + 56, u32(h + mem_load(H + 56)))
    blk = blk + 1
  }
  // produce 32-byte big-endian digest
  let out = mem_alloc(4)        // 32 bytes = 4*8
  let i = 0
  while i < 8 {
    let word = mem_load(H + i * 8)
    mem_store8(out + i * 4,     u32(word >> 24) & 0xff)
    mem_store8(out + i * 4 + 1, u32(word >> 16) & 0xff)
    mem_store8(out + i * 4 + 2, u32(word >> 8) & 0xff)
    mem_store8(out + i * 4 + 3, u32(word) & 0xff)
    i = i + 1
  }
  return out
}

// sha256_str(s, len): convenience — hashes a Quanta string s (bytes live at s+8).
fn sha256_str(s, len) { return sha256(s + 8, len) }

// rand_bytes(buf, n): fill buf with n cryptographically-strong random bytes.
fn rand_bytes(buf, n) {
  return syscall3(318, buf, n, 0)   // getrandom
}

// hex(bytes, n) -> hex string (for displaying digests).
fn hex(bytes, n) {
  let s = ""
  let i = 0
  while i < n {
    let b = mem_load8(bytes + i)
    let hi = b >> 4; let lo = b & 0xf
    s = str(s, hexdig(hi))
    s = str(s, hexdig(lo))
    i = i + 1
  }
  return s
}

fn hexdig(v) {
  if v == 0 { return "0" }
  if v == 1 { return "1" }
  if v == 2 { return "2" }
  if v == 3 { return "3" }
  if v == 4 { return "4" }
  if v == 5 { return "5" }
  if v == 6 { return "6" }
  if v == 7 { return "7" }
  if v == 8 { return "8" }
  if v == 9 { return "9" }
  if v == 10 { return "a" }
  if v == 11 { return "b" }
  if v == 12 { return "c" }
  if v == 13 { return "d" }
  if v == 14 { return "e" }
  return "f"
}

// ---------- HMAC-SHA256 ----------
// hmac_sha256(key, klen, msg, mlen) -> ptr to 32-byte digest.
// HMAC(K,m) = SHA256( (K' xor opad) || SHA256( (K' xor ipad) || m ) )
fn hmac_sha256(key, klen, msg, mlen) {
  // Normalize key to exactly 32 bytes (SHA-256 block size).
  // If the key is longer than 32 bytes, hash it first; otherwise copy (left-padded
  // with zeros by zeroing kpad up front).
  let kpad = mem_alloc(4)            // 32 bytes
  let ki = 0
  while ki < 4 { mem_store(kpad + ki * 8, 0); ki = ki + 1 }
  if klen > 32 {
    let hk = sha256(key, klen)       // hk is a raw 32-byte buffer
    let j = 0
    while j < 32 { mem_store8(kpad + j, mem_load8(hk + j)); j = j + 1 }
  } else {
    let j = 0
    while j < klen { mem_store8(kpad + j, mem_load8(key + j)); j = j + 1 }
  }
  // inner = (kpad XOR ipad) || msg   where ipad = 0x36 * 64
  let inner = mem_alloc(8)           // 64 bytes
  let i2 = 0
  while i2 < 8 { mem_store(inner + i2 * 8, 0); i2 = i2 + 1 }
  let i = 0
  while i < 64 {
    if i < 32 { mem_store8(inner + i, mem_load8(kpad + i) ^ 0x36) }
    else { mem_store8(inner + i, 0x36) }
    i = i + 1
  }
  // inner || msg  -> we build a buffer of (64 + mlen) and hash it
  let ibuf = mem_alloc(((64 + mlen + 8) >> 6) + 1)   // generous; bytes region from +8
  let w = 0
  while w < 64 { mem_store8(ibuf + 8 + w, mem_load8(inner + w)); w = w + 1 }
  let q = 0
  while q < mlen { mem_store8(ibuf + 8 + 64 + q, mem_load8(msg + q)); q = q + 1 }
  let inner_hash = sha256(ibuf + 8, 64 + mlen)
  // outer: opad XOR key || inner_hash
  let outer = mem_alloc(8)           // 64 bytes
  let o2 = 0
  while o2 < 8 { mem_store(outer + o2 * 8, 0); o2 = o2 + 1 }
  let o = 0
  while o < 64 {
    if o < 32 { mem_store8(outer + o, mem_load8(kpad + o) ^ 0x5c) }
    else { mem_store8(outer + o, 0x5c) }
    o = o + 1
  }
  let obuf = mem_alloc(((64 + 32 + 8) >> 6) + 1)
  let r = 0
  while r < 64 { mem_store8(obuf + 8 + r, mem_load8(outer + r)); r = r + 1 }
  let s = 0
  while s < 32 { mem_store8(obuf + 8 + 64 + s, mem_load8(inner_hash + s)); s = s + 1 }
  return sha256(obuf + 8, 64 + 32)
}

// ---------- AES-128 (ECB) ----------
// aes128_enc(key16, plaintext16) -> ptr to 16-byte ciphertext (raw buffer).
// Key schedule + 10 rounds (SubBytes, ShiftRows, MixColumns, AddRoundKey).
fn aes_xtime(x) { let t = x << 1; if t > 255 { t = t ^ 0x11b }; return t & 0xff }
fn aes_mul(a, b) {
  let r = 0
  let i = 0
  while i < 8 {
    if (b & 1) == 1 { r = r ^ a }
    let ta = a
    a = aes_xtime(a)
    b = b >> 1
    i = i + 1
  }
  return r & 0xff
}
// S-box (AES substitution box, 256 entries).
