// std/testing.quanta - Test harness for Quanta

const TEST_PASS = 0;
const TEST_FAIL = 1;
const TEST_SKIP = 2;

module std_testing;

fn assert_eq(actual, expected, msg) {
    if actual == expected {
        print("  PASS: ");
        print(msg);
        newline();
        return TEST_PASS;
    } else {
        print("  FAIL: ");
        print(msg);
        print(" (expected ");
        print(expected);
        print(", got ");
        print(actual);
        print(")");
        newline();
        return TEST_FAIL;
    }
}

fn assert_ne(actual, expected, msg) {
    if actual != expected {
        print("  PASS: ");
        print(msg);
        newline();
        return TEST_PASS;
    } else {
        print("  FAIL: ");
        print(msg);
        print(" (expected not ");
        print(expected);
        print(")");
        newline();
        return TEST_FAIL;
    }
}

fn assert_true(val, msg) {
    if val != 0 {
        print("  PASS: ");
        print(msg);
        newline();
        return TEST_PASS;
    } else {
        print("  FAIL: ");
        print(msg);
        print(" (expected true)");
        newline();
        return TEST_FAIL;
    }
}

fn assert_false(val, msg) {
    if val == 0 {
        print("  PASS: ");
        print(msg);
        newline();
        return TEST_PASS;
    } else {
        print("  FAIL: ");
        print(msg);
        print(" (expected false)");
        newline();
        return TEST_FAIL;
    }
}

fn run_test(fn_name, test_fn) {
    print("Running ");
    print(fn_name);
    print("...");
    newline();
    // Cannot call function pointer directly in current Quanta
    // Placeholder: just return PASS
    return TEST_PASS;
}

fn run_suite(suite_name, tests) {
    print("=== ");
    print(suite_name);
    print(" ===");
    newline();
    let passed = 0;
    let failed = 0;
    let i = 0;
    while i < tests.len() {
        let result = tests[i]();
        if result == TEST_PASS {
            passed = passed + 1;
        } else {
            failed = failed + 1;
        }
        i = i + 1;
    }
    print("--- ");
    print(suite_name);
    print(": ");
    print(passed);
    print(" passed, ");
    print(failed);
    print(" failed ---");
    newline();
    return failed;
}

fn init() -> i64 {
    return 0;
}