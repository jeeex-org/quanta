// std/testing — test harness + EXPECTED.tsv integration
const TEST_PASS = 0
const TEST_FAIL = 1
const TEST_SKIP = 2

fn test_run(name, fn_ptr) {
    prints("Running "); prints(name); prints("... ")
    let result = fn_ptr()
    if result == TEST_PASS { prints("PASS\n") }
    else if result == TEST_SKIP { prints("SKIP\n") }
    else { prints("FAIL\n") }
    return result
}

fn test_assert(cond, msg) {
    if cond != 0 { return TEST_PASS }
    prints("ASSERT: "); prints(msg); prints("\n")
    return TEST_FAIL
}

fn test_assert_eq(a, b, msg) {
    if a == b { return TEST_PASS }
    prints("ASSERT_EQ: "); prints(msg); prints(" got "); print(a); prints(" expected "); print(b); prints("\n")
    return TEST_FAIL
}

fn test_assert_ne(a, b, msg) {
    if a != b { return TEST_PASS }
    prints("ASSERT_NE: "); prints(msg); prints(" got "); print(a); prints(" == "); print(b); prints("\n")
    return TEST_FAIL
}

fn test_assert_lt(a, b, msg) {
    if a < b { return TEST_PASS }
    prints("ASSERT_LT: "); prints(msg); prints(" got "); print(a); prints(" >= "); print(b); prints("\n")
    return TEST_FAIL
}

fn test_assert_gt(a, b, msg) {
    if a > b { return TEST_PASS }
    prints("ASSERT_GT: "); prints(msg); prints(" got "); print(a); prints(" <= "); print(b); prints("\n")
    return TEST_FAIL
}

// EXPECTED.tsv format: test_name<TAB>expected_rc
fn expected_load(path) { 0 }
fn expected_check(name, actual) { 0 }