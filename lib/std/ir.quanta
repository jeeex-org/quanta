// std/ir — Quanta IR representation
// IR opcodes (from globals.quanta)
const IR_CONST = 0; const IR_MOV = 1; const IR_ADD = 2; const IR_SUB = 3
const IR_MUL = 4; const IR_DIV = 5; const IR_MOD = 6
const IR_EQ = 7; const IR_NE = 8; const IR_LT = 9; const IR_GT = 10
const IR_LE = 11; const IR_GE = 12; const IR_AND = 13; const IR_OR = 14
const IR_NEG = 15; const IR_NOT = 16; const IR_CALL = 17; const IR_LABEL = 18
const IR_CALL_IDX = 78; const IR_JMP = 19; const IR_BR = 20; const IR_RET = 21; const IR_PARAM = 22
const IR_STR = 23; const IR_BAND = 24; const IR_BOR = 25; const IR_BXOR = 26; const IR_BNOT = 27; const IR_SHL = 28; const IR_SHR = 29
const IR_LOADG = 30; const IR_STOREG = 31; const IR_CLOSURE_CALL = 36; const IR_FNPTR = 35
const IR_FREE = 37; const IR_FCONST = 38; const IR_FADD = 39; const IR_FSUB = 40; const IR_FMUL = 41; const IR_FDIV = 42
const IR_F2I = 43; const IR_I2F = 44; const IR_ENUM = 45; const IR_MATCH = 46; const IR_SOME = 47; const IR_NONE = 48
const IR_OK = 49; const IR_ERR = 50; const IR_UNWRAP = 51; const IR_TRY = 74
const IR_VTABLE = 52; const IR_DYN = 53; const IR_RAW_PTR = 54; const IR_MUT_PTR = 55; const IR_DEREF = 56
const IR_DEREF_MUT = 57; const IR_PTR_ADD = 58; const IR_PTR_SUB = 59; const IR_PTR_DIFF = 60; const IR_PTR_CAST = 61
const IR_IS_NULL = 62; const IR_VOLATILE_LOAD = 63; const IR_VOLATILE_STORE = 64; const IR_ASM = 65; const IR_FFI_CALL = 66
const IR_VEC128 = 67; const IR_UNSAFE_BLOCK = 68; const IR_ARRAY_LEN = 69; const IR_GENERIC_INST = 70
const IR_FNVAL = 71; const IR_APUSH = 72; const IR_ARRNEW = 73; const IR_CLOSURE = 76; const IR_CAPREAD = 77

// IR instruction structure
const IR_OP_SHIFT = 56; const IR_A0_SHIFT = 48; const IR_A1_SHIFT = 40; const IR_A2_SHIFT = 32
const IR_DST_SHIFT = 24; const IR_SRC_SHIFT = 16; const IR_FLAGS_SHIFT = 8; const IR_PAD_SHIFT = 0

fn ir_make(op, a0, a1, a2, dst, src, flags) {
    let op_part = op << IR_OP_SHIFT
    let a0_part = a0 << IR_A0_SHIFT
    let a1_part = a1 << IR_A1_SHIFT
    let a2_part = a2 << IR_A2_SHIFT
    let dst_part = dst << IR_DST_SHIFT
    let src_part = src << IR_SRC_SHIFT
    let flags_part = flags << IR_FLAGS_SHIFT
    op_part | a0_part | a1_part | a2_part | dst_part | src_part | flags_part
}

fn ir_op(inst) { inst >> IR_OP_SHIFT }
fn ir_a0(inst) { (inst >> IR_A0_SHIFT) & 0xFF }
fn ir_a1(inst) { (inst >> IR_A1_SHIFT) & 0xFF }
fn ir_a2(inst) { (inst >> IR_A2_SHIFT) & 0xFF }
fn ir_dst(inst) { (inst >> IR_DST_SHIFT) & 0xFF }
fn ir_src(inst) { (inst >> IR_SRC_SHIFT) & 0xFF }
fn ir_flags(inst) { (inst >> IR_FLAGS_SHIFT) & 0xFF }