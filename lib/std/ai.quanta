// std/ai — AI LLM library (0.0.168) — minimal tests
import std/ai_core

fn ai_test_tensor_create(): i64 {
    let data: i64[1], shape: i64[1], ndim: i64[1], dtype: i64[1]
    let s: i64[2] = { 2, 3 }
    ai_tensor_create(data, shape, ndim, dtype, s, 2, 0)
    if ai_shape_count(shape, ndim[0]) != 6 { return 1 }
    ai_tensor_free(data)
    return 0
}

fn ai_test_add(): i64 {
    let a: i64[1], b: i64[1], out: i64[1]
    let sa: i64[1] = { 4 }
    let nda: i64[1], ndb: i64[1], ndc: i64[1]
    let dta: i64[1], dtb: i64[1], dtc: i64[1]
    ai_tensor_create(a, sa, nda, dta, sa, 1, 0)
    ai_tensor_create(b, sa, ndb, dtb, sa, 1, 0)
    ai_tensor_create(out, sa, ndc, dtc, sa, 1, 0)
    ai_tensor_set(a, 0, i2f(1)); ai_tensor_set(a, 1, i2f(2))
    ai_tensor_set(a, 2, i2f(3)); ai_tensor_set(a, 3, i2f(4))
    ai_tensor_set(b, 0, i2f(5)); ai_tensor_set(b, 1, i2f(6))
    ai_tensor_set(b, 2, i2f(7)); ai_tensor_set(b, 3, i2f(8))
    ai_add(a, b, out, 4)
    if f2i(ai_tensor_get(out, 0)) != 6 { return 1 }
    ai_tensor_free(a); ai_tensor_free(b); ai_tensor_free(out)
    return 0
}

fn ai_test_matmul(): i64 {
    let a: i64[1], b: i64[1], out: i64[1]
    let sa: i64[2] = { 2, 3 }, sb: i64[2] = { 3, 2 }, sc: i64[2] = { 2, 2 }
    let nda: i64[1], ndb: i64[1], ndc: i64[1]
    let dta: i64[1], dtb: i64[1], dtc: i64[1]
    ai_tensor_create(a, sa, nda, dta, sa, 2, 0)
    ai_tensor_create(b, sb, ndb, dtb, sb, 2, 0)
    ai_tensor_create(out, sc, ndc, dtc, sc, 2, 0)
    ai_tensor_set(a, 0, i2f(1)); ai_tensor_set(a, 1, i2f(2)); ai_tensor_set(a, 2, i2f(3))
    ai_tensor_set(a, 3, i2f(4)); ai_tensor_set(a, 4, i2f(5)); ai_tensor_set(a, 5, i2f(6))
    ai_tensor_set(b, 0, i2f(7)); ai_tensor_set(b, 1, i2f(8))
    ai_tensor_set(b, 2, i2f(9)); ai_tensor_set(b, 3, i2f(10))
    ai_tensor_set(b, 4, i2f(11)); ai_tensor_set(b, 5, i2f(12))
    ai_matmul(a, b, out, 2, 3, 2)
    if f2i(ai_tensor_get(out, 0)) != 58 { return 1 }
    ai_tensor_free(a); ai_tensor_free(b); ai_tensor_free(out)
    return 0
}

fn ai_test_rmsnorm(): i64 {
    let x: i64[1], w: i64[1], out: i64[1]
    let s: i64[1] = { 4 }
    let nd: i64[1], dt: i64[1]
    ai_tensor_create(x, s, nd, dt, s, 1, 0)
    ai_tensor_create(w, s, nd, dt, s, 1, 0)
    ai_tensor_create(out, s, nd, dt, s, 1, 0)
    ai_tensor_set(x, 0, i2f(1)); ai_tensor_set(x, 1, i2f(2))
    ai_tensor_set(x, 2, i2f(3)); ai_tensor_set(x, 3, i2f(4))
    ai_tensor_set(w, 0, i2f(1)); ai_tensor_set(w, 1, i2f(1))
    ai_tensor_set(w, 2, i2f(1)); ai_tensor_set(w, 3, i2f(1))
    ai_rmsnorm(out, x, w, 4, i2f(1))
    let v: i64 = f2i(ai_tensor_get(out, 0))
    if v < 0 || v > 1 { return 1 }
    ai_tensor_free(x); ai_tensor_free(w); ai_tensor_free(out)
    return 0
}

fn ai_test_swiglu(): i64 {
    let x: i64[1], y: i64[1], out: i64[1]
    let s: i64[1] = { 4 }
    let nd: i64[1], dt: i64[1]
    ai_tensor_create(x, s, nd, dt, s, 1, 0)
    ai_tensor_create(y, s, nd, dt, s, 1, 0)
    ai_tensor_create(out, s, nd, dt, s, 1, 0)
    ai_tensor_set(x, 0, i2f(1)); ai_tensor_set(x, 1, i2f(0))
    ai_tensor_set(x, 2, i2f(-1)); ai_tensor_set(x, 3, i2f(2))
    ai_tensor_set(y, 0, i2f(1)); ai_tensor_set(y, 1, i2f(1))
    ai_tensor_set(y, 2, i2f(1)); ai_tensor_set(y, 3, i2f(1))
    ai_swiglu(out, x, y, 4)
    let v: i64 = f2i(ai_tensor_get(out, 0))
    if v != 0 { return 1 }
    ai_tensor_free(x); ai_tensor_free(y); ai_tensor_free(out)
    return 0
}

fn ai_test_quantize(): i64 {
    let x: i64[1], q: i64[1], dq: i64[1]
    let s: i64[1] = { 4 }
    let nd: i64[1], dt: i64[1]
    ai_tensor_create(x, s, nd, dt, s, 1, 0)
    q[0] = malloc(4)
    ai_tensor_create(dq, s, nd, dt, s, 1, 0)
    ai_tensor_set(x, 0, i2f(1)); ai_tensor_set(x, 1, i2f(-1))
    ai_tensor_set(x, 2, fdiv(i2f(1), i2f(2))); ai_tensor_set(x, 3, fdiv(i2f(-1), i2f(2)))
    let scale: i64 = fdiv(i2f(1), i2f(100))
    ai_quant8(q, x, 4, scale, 0)
    ai_dequant8(dq, q, 4, scale, 0)
    let v: i64 = f2i(ai_tensor_get(dq, 0))
    if v < 0 || v > 2 { return 1 }
    ai_tensor_free(x); free(q[0]); ai_tensor_free(dq)
    return 0
}

fn ai_test_kv_cache(): i64 {
    let k: i64[1], v: i64[1], pos: i64[1]
    ai_kv_create(k, v, pos, 2, 128, 64)
    if pos[0] != 0 { return 1 }
    let kn: i64[1], vn: i64[1]
    let s: i64[1] = { 2 * 4 * 64 }
    let nd: i64[1], dt: i64[1]
    ai_tensor_create(kn, s, nd, dt, s, 1, 0)
    ai_tensor_create(vn, s, nd, dt, s, 1, 0)
    ai_kv_append(k, v, pos, kn, vn, 2, 64, 4, 128)
    if pos[0] != 4 { return 1 }
    ai_tensor_free(kn); ai_tensor_free(vn); ai_kv_free(k, v)
    return 0
}

fn init(): i64 { return 0 }

fn main(): i64 {
    if ai_test_tensor_create() != 0 { prints("FAIL: tensor_create\n"); return 1 }
    if ai_test_add() != 0 { prints("FAIL: add\n"); return 1 }
    if ai_test_matmul() != 0 { prints("FAIL: matmul\n"); return 1 }
    if ai_test_rmsnorm() != 0 { prints("FAIL: rmsnorm\n"); return 1 }
    if ai_test_swiglu() != 0 { prints("FAIL: swiglu\n"); return 1 }
    if ai_test_quantize() != 0 { prints("FAIL: quantize\n"); return 1 }
    if ai_test_kv_cache() != 0 { prints("FAIL: kv_cache\n"); return 1 }
    prints("ALL AI TESTS PASSED\n")
    return 0
}
