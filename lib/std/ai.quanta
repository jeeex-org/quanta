// ============================================================================
// Example: Simple MLP
// ============================================================================

struct ai_mlp {
    base: ai_module,
    layers: ai_linear_layer[8],
    activations: i64[8],
    num_layers: i64,
    dropout: f32
}

fn ai_mlp_init(mlp: ai_mlp[], layer_sizes: i64[], num_layers: i64, dropout: f32): i64 {
    ai_module_init(mlp[0].base, "MLP")
    mlp[0].num_layers = num_layers - 1
    mlp[0].dropout = dropout
    
    let i: i64 = 0
    while i < mlp[0].num_layers {
        ai_linear_layer_init(mlp[0].layers + i, layer_sizes[i], layer_sizes[i + 1], 1)
        ai_module_add_child(mlp[0].base, mlp[0].layers[i].base)
        if i < mlp[0].num_layers - 1 {
            mlp[0].activations[i] = 1  // ReLU
        } else {
            mlp[0].activations[i] = 0  // Linear
        }
        i = i + 1
    }
    return 0
}

fn ai_mlp_forward(mlp: ai_mlp[], input: ai_tensor[], output: ai_tensor[]): i64 {
    let current: ai_tensor = input[0]
    let next: ai_tensor
    
    let i: i64 = 0
    while i < mlp[0].num_layers {
        ai_linear_layer_forward(mlp[0].layers + i, current, next)
        if mlp[0].activations[i] == 1 {
            ai_relu(current, next)
        }
        current = next
        i = i + 1
    }
    output[0] = current
    return 0
}

