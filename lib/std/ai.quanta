// ============================================================================
// Linear / Fully Connected
// ============================================================================

fn ai_linear(out: ai_tensor[], a: ai_tensor[], weight: ai_tensor[], bias: ai_tensor[]): i64 {
    // out = a @ weight.T + bias
    // a: [..., in_features], weight: [out_features, in_features]
    return ai_matmul(out, a, weight)  // simplified
}

