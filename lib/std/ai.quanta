// ============================================================================
// Optimizers (stateful)
// ============================================================================

struct ai_sgd_state {
    params: ai_tensor[100],
    param_count: i64,
    lr: f32,
    momentum: f32,
    dampening: f32,
    weight_decay: f32,
    nesterov: i64,
    buffers: ai_tensor[100]  // momentum buffers
}

fn ai_sgd_init(state: ai_sgd_state[], lr: f32, momentum: f32, dampening: f32,
               weight_decay: f32, nesterov: i64): i64 {
    state[0].lr = lr
    state[0].momentum = momentum
    state[0].dampening = dampening
    state[0].weight_decay = weight_decay
    state[0].nesterov = nesterov
    state[0].param_count = 0
    return 0
}

fn ai_sgd_add_param(state: ai_sgd_state[], param: ai_tensor[]): i64 {
    let idx: i64 = state[0].param_count
    state[0].params[idx] = param[0]
    // Initialize momentum buffer
    ai_tensor_create(state[0].buffers + idx, param[0].shape, param[0].ndim, param[0].dtype)
    state[0].param_count = state[0].param_count + 1
    return 0
}

fn ai_sgd_step(state: ai_sgd_state[], grads: ai_tensor[]): i64 {
    // For each param: param = param - lr * grad (with momentum)
    return 0
}

struct ai_adam_state {
    params: ai_tensor[100],
    param_count: i64,
    lr: f32,
    beta1: f32,
    beta2: f32,
    eps: f32,
    weight_decay: f32,
    step: i64,
    exp_avg: ai_tensor[100],   // 1st moment
    exp_avg_sq: ai_tensor[100] // 2nd moment
}

fn ai_adam_init(state: ai_adam_state[], lr: f32, beta1: f32, beta2: f32,
                eps: f32, weight_decay: f32): i64 {
    state[0].lr = lr
    state[0].beta1 = beta1
    state[0].beta2 = beta2
    state[0].eps = eps
    state[0].weight_decay = weight_decay
    state[0].step = 0
    state[0].param_count = 0
    return 0
}

fn ai_adam_add_param(state: ai_adam_state[], param: ai_tensor[]): i64 {
    let idx: i64 = state[0].param_count
    state[0].params[idx] = param[0]
    ai_tensor_create(state[0].exp_avg + idx, param[0].shape, param[0].ndim, param[0].dtype)
    ai_tensor_create(state[0].exp_avg_sq + idx, param[0].shape, param[0].ndim, param[0].dtype)
    state[0].param_count = state[0].param_count + 1
    return 0
}

fn ai_adam_step(state: ai_adam_state[], grads: ai_tensor[]): i64 {
    state[0].step = state[0].step + 1
    // Adam update rule
    return 0
}

// ============================================================================
// Model Definition
// ============================================================================

struct ai_module {
    name: u8[64],
    parameters: ai_tensor[100],
    param_count: i64,
    buffers: ai_tensor[100],
    buffer_count: i64,
    children: ai_module[10],
    child_count: i64
}

fn ai_module_init(m: ai_module[], name: u8[]): i64 {
    let i: i64 = 0
    while i < 64 && name[i] != 0 {
        m[0].name[i] = name[i]
        i = i + 1
    }
    m[0].name[i] = 0
    m[0].param_count = 0
    m[0].buffer_count = 0
    m[0].child_count = 0
    return 0
}

fn ai_module_register_param(m: ai_module[], param: ai_tensor[]): i64 {
    let idx: i64 = m[0].param_count
    m[0].parameters[idx] = param[0]
    m[0].param_count = m[0].param_count + 1
    return 0
}

fn ai_module_register_buffer(m: ai_module[], buffer: ai_tensor[]): i64 {
    let idx: i64 = m[0].buffer_count
    m[0].buffers[idx] = buffer[0]
    m[0].buffer_count = m[0].buffer_count + 1
    return 0
}

fn ai_module_add_child(m: ai_module[], child: ai_module[]): i64 {
    let idx: i64 = m[0].child_count
    m[0].children[idx] = child[0]
    m[0].child_count = m[0].child_count + 1
    return 0
}

// Forward pass (to be implemented by specific modules)
fn ai_module_forward(m: ai_module[], input: ai_tensor[], output: ai_tensor[]): i64 {
    return 0
}

// Get all parameters recursively
fn ai_module_parameters(m: ai_module[], out: ai_tensor[], count: i64[]): i64 {
    let idx: i64 = 0
    let i: i64 = 0
    while i < m[0].param_count {
        out[idx] = m[0].parameters[i]
        idx = idx + 1
        i = i + 1
    }
    i = 0
    while i < m[0].child_count {
        let child_count: i64[1]
        ai_module_parameters(m[0].children + i, out + idx, child_count)
        idx = idx + child_count[0]
        i = i + 1
    }
    count[0] = idx
    return 0
}

// ============================================================================
// Common Layers
// ============================================================================

struct ai_linear_layer {
    base: ai_module,
    weight: ai_tensor,
    bias: ai_tensor,
    in_features: i64,
    out_features: i64
}

fn ai_linear_layer_init(layer: ai_linear_layer[], in_features: i64, out_features: i64, bias: i64): i64 {
    ai_module_init(layer[0].base, "Linear")
    layer[0].in_features = in_features
    layer[0].out_features = out_features
    
    let w_shape: i64[2] = { out_features, in_features }
    ai_tensor_create(layer[0].weight, w_shape, 2, ai_dtype_f32())
    ai_module_register_param(layer[0].base, layer[0].weight)
    
    if bias != 0 {
        let b_shape: i64[1] = { out_features }
        ai_tensor_create(layer[0].bias, b_shape, 1, ai_dtype_f32())
        ai_module_register_param(layer[0].base, layer[0].bias)
    }
    return 0
}

fn ai_linear_layer_forward(layer: ai_linear_layer[], input: ai_tensor[], output: ai_tensor[]): i64 {
    ai_linear(output, input, layer[0].weight, layer[0].bias)
    return 0
}

struct ai_conv2d_layer {
    base: ai_module,
    weight: ai_tensor,
    bias: ai_tensor,
    in_channels: i64,
    out_channels: i64,
    kernel_size: i64,
    stride: i64,
    padding: i64,
    dilation: i64,
    groups: i64
}

fn ai_conv2d_layer_init(layer: ai_conv2d_layer[], in_channels: i64, out_channels: i64,
                        kernel_size: i64, stride: i64, padding: i64,
                        dilation: i64, groups: i64, bias: i64): i64 {
    ai_module_init(layer[0].base, "Conv2d")
    layer[0].in_channels = in_channels
    layer[0].out_channels = out_channels
    layer[0].kernel_size = kernel_size
    layer[0].stride = stride
    layer[0].padding = padding
    layer[0].dilation = dilation
    layer[0].groups = groups
    
    let w_shape: i64[4] = { out_channels, in_channels / groups, kernel_size, kernel_size }
    ai_tensor_create(layer[0].weight, w_shape, 4, ai_dtype_f32())
    ai_module_register_param(layer[0].base, layer[0].weight)
    
    if bias != 0 {
        let b_shape: i64[1] = { out_channels }
        ai_tensor_create(layer[0].bias, b_shape, 1, ai_dtype_f32())
        ai_module_register_param(layer[0].base, layer[0].bias)
    }
    return 0
}

fn ai_conv2d_layer_forward(layer: ai_conv2d_layer[], input: ai_tensor[], output: ai_tensor[]): i64 {
    ai_conv2d(output, input, layer[0].weight, layer[0].bias,
              layer[0].stride, layer[0].padding, layer[0].dilation, layer[0].groups)
    return 0
}

struct ai_batchnorm2d_layer {
    base: ai_module,
    weight: ai_tensor,
    bias: ai_tensor,
    running_mean: ai_tensor,
    running_var: ai_tensor,
    num_features: i64,
    eps: f32,
    momentum: f32
}

fn ai_batchnorm2d_layer_init(layer: ai_batchnorm2d_layer[], num_features: i64, eps: f32, momentum: f32): i64 {
    ai_module_init(layer[0].base, "BatchNorm2d")
    layer[0].num_features = num_features
    layer[0].eps = eps
    layer[0].momentum = momentum
    
    let shape: i64[1] = { num_features }
    ai_tensor_create(layer[0].weight, shape, 1, ai_dtype_f32())
    ai_tensor_create(layer[0].bias, shape, 1, ai_dtype_f32())
    ai_tensor_create(layer[0].running_mean, shape, 1, ai_dtype_f32())
    ai_tensor_create(layer[0].running_var, shape, 1, ai_dtype_f32())
    
    ai_module_register_param(layer[0].base, layer[0].weight)
    ai_module_register_param(layer[0].base, layer[0].bias)
    ai_module_register_buffer(layer[0].base, layer[0].running_mean)
    ai_module_register_buffer(layer[0].base, layer[0].running_var)
    
    // Initialize
    // running_mean = 0, running_var = 1, weight = 1, bias = 0
    return 0
}

fn ai_batchnorm2d_layer_forward(layer: ai_batchnorm2d_layer[], input: ai_tensor[], output: ai_tensor[], training: i64): i64 {
    ai_batchnorm2d(output, input, layer[0].weight, layer[0].bias,
                   layer[0].running_mean, layer[0].running_var,
                   layer[0].eps, layer[0].momentum, training)
    return 0
}

struct ai_layernorm_layer {
    base: ai_module,
    weight: ai_tensor,
    bias: ai_tensor,
    normalized_shape: i64[8],
    normalized_ndim: i64,
    eps: f32
}

fn ai_layernorm_layer_init(layer: ai_layernorm_layer[], normalized_shape: i64[], ndim: i64, eps: f32): i64 {
    ai_module_init(layer[0].base, "LayerNorm")
    let i: i64 = 0
    while i < ndim {
        layer[0].normalized_shape[i] = normalized_shape[i]
        i = i + 1
    }
    layer[0].normalized_ndim = ndim
    layer[0].eps = eps
    
    ai_tensor_create(layer[0].weight, normalized_shape, ndim, ai_dtype_f32())
    ai_tensor_create(layer[0].bias, normalized_shape, ndim, ai_dtype_f32())
    ai_module_register_param(layer[0].base, layer[0].weight)
    ai_module_register_param(layer[0].base, layer[0].bias)
    return 0
}

fn ai_layernorm_layer_forward(layer: ai_layernorm_layer[], input: ai_tensor[], output: ai_tensor[]): i64 {
    ai_layernorm(output, input, layer[0].weight, layer[0].bias,
                 layer[0].normalized_shape, layer[0].eps)
    return 0
}

struct ai_dropout_layer {
    base: ai_module,
    p: f32,
    inplace: i64
}

fn ai_dropout_layer_init(layer: ai_dropout_layer[], p: f32, inplace: i64): i64 {
    ai_module_init(layer[0].base, "Dropout")
    layer[0].p = p
    layer[0].inplace = inplace
    return 0
}

fn ai_dropout_layer_forward(layer: ai_dropout_layer[], input: ai_tensor[], output: ai_tensor[], training: i64): i64 {
    if training == 0 || layer[0].p == 0.0 {
        // Copy input to output
        return 0
    }
    // Apply dropout mask
    return 0
}

struct ai_embedding_layer {
    base: ai_module,
    weight: ai_tensor,
    num_embeddings: i64,
    embedding_dim: i64,
    padding_idx: i64
}

fn ai_embedding_layer_init(layer: ai_embedding_layer[], num_embeddings: i64, embedding_dim: i64, padding_idx: i64): i64 {
    ai_module_init(layer[0].base, "Embedding")
    layer[0].num_embeddings = num_embeddings
    layer[0].embedding_dim = embedding_dim
    layer[0].padding_idx = padding_idx
    
    let shape: i64[2] = { num_embeddings, embedding_dim }
    ai_tensor_create(layer[0].weight, shape, 2, ai_dtype_f32())
    ai_module_register_param(layer[0].base, layer[0].weight)
    return 0
}

fn ai_embedding_layer_forward(layer: ai_embedding_layer[], indices: ai_tensor[], output: ai_tensor[]): i64 {
    ai_embedding(output, indices, layer[0].weight)
    return 0
}

