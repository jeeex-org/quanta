    linear1: ai_linear_layer,
    linear2: ai_linear_layer,
    norm1: ai_layernorm_layer,
    norm2: ai_layernorm_layer,
    dropout1: ai_dropout_layer,
    dropout2: ai_dropout_layer,
    activation: i64  // 0=relu, 1=gelu
}

struct ai_multihead_attention_layer {
    base: ai_module,
    embed_dim: i64,
    num_heads: i64,
    in_proj_weight: ai_tensor,
    in_proj_bias: ai_tensor,
    out_proj_weight: ai_tensor,
    out_proj_bias: ai_tensor,
    batch_first: i64
}

fn ai_multihead_attention_layer_init(layer: ai_multihead_attention_layer[],
                                     embed_dim: i64, num_heads: i64, bias: i64, batch_first: i64): i64 {
    ai_module_init(layer[0].base, "MultiheadAttention")
    layer[0].embed_dim = embed_dim
    layer[0].num_heads = num_heads
    layer[0].batch_first = batch_first
    
    let proj_shape: i64[2] = { 3 * embed_dim, embed_dim }
    ai_tensor_create(layer[0].in_proj_weight, proj_shape, 2, ai_dtype_f32())
    ai_module_register_param(layer[0].base, layer[0].in_proj_weight)
    
    if bias != 0 {
        let b_shape: i64[1] = { 3 * embed_dim }
        ai_tensor_create(layer[0].in_proj_bias, b_shape, 1, ai_dtype_f32())
        ai_module_register_param(layer[0].base, layer[0].in_proj_bias)
    }
    
    let out_shape: i64[2] = { embed_dim, embed_dim }
    ai_tensor_create(layer[0].out_proj_weight, out_shape, 2, ai_dtype_f32())
    ai_module_register_param(layer[0].base, layer[0].out_proj_weight)
    
    let out_b_shape: i64[1] = { embed_dim }
    ai_tensor_create(layer[0].out_proj_bias, out_b_shape, 1, ai_dtype_f32())
    ai_module_register_param(layer[0].base, layer[0].out_proj_bias)
    return 0
}

struct ai_transformer_encoder {
    base: ai_module,
    layers: ai_transformer_encoder_layer[32],
    num_layers: i64,
    norm: ai_layernorm_layer
}

struct ai_transformer_decoder_layer {
    base: ai_module,
    self_attn: ai_multihead_attention_layer,
    multihead_attn: ai_multihead_attention_layer,
    linear1: ai_linear_layer,
    linear2: ai_linear_layer,
    norm1: ai_layernorm_layer,
    norm2: ai_layernorm_layer,
    norm3: ai_layernorm_layer,
    dropout1: ai_dropout_layer,
    dropout2: ai_dropout_layer,
    dropout3: ai_dropout_layer,
    activation: i64
}

struct ai_transformer_decoder {
    base: ai_module,
    layers: ai_transformer_decoder_layer[32],
    num_layers: i64,
    norm: ai_layernorm_layer
}

