struct ai_inference_engine {
    modules: ai_module[100],
    module_count: i64,
    inputs: ai_tensor[10],
    input_count: i64,
    outputs: ai_tensor[10],
    output_count: i64,
    workspace: u8[1048576]  // 1MB workspace
}

fn ai_engine_init(engine: ai_inference_engine[]): i64 {
    engine[0].module_count = 0
    engine[0].input_count = 0
    engine[0].output_count = 0
    return 0
}

fn ai_engine_add_module(engine: ai_inference_engine[], module: ai_module[]): i64 {
    let idx: i64 = engine[0].module_count
    engine[0].modules[idx] = module[0]
    engine[0].module_count = engine[0].module_count + 1
    return 0
}

fn ai_engine_set_input(engine: ai_inference_engine[], name: u8[], tensor: ai_tensor[]): i64 {
    let idx: i64 = engine[0].input_count
    engine[0].inputs[idx] = tensor[0]
    engine[0].input_count = engine[0].input_count + 1
    return 0
}

