}

// Argon2id
fn argon2id(password, password_len, salt, salt_len, secret, secret_len, ad, ad_len, t_cost, m_cost, parallelism, out, out_len) {
    // Validate parameters
    if m_cost < 8 || parallelism < 1 || parallelism > 255 || t_cost < 1 { return -1 }
    if m_cost > (1 << 24) { return -1 } // Max 16 GB
    if password_len > (1 << 24) || salt_len > (1 << 24) { return -1 }
    if out_len < 4 || out_len > (1 << 24) { return -1 }
    
    // Simplified Argon2id implementation
    // In reality this would be a full implementation of RFC 9106
    // For now, we use a simplified memory-hard construction
    
    let segment_length = (m_cost / parallelism / ARGON2_SYNC_POINTS) & ~1
    if segment_length < 2 { segment_length = 2 }
    
    // Initialize first blocks
    let block_size = 1024
    let memory = mem_alloc(m_cost * block_size)
    if memory == 0 { return -1 }
    
    // H0 = Blake2b(...)
    let h0 = mem_alloc(64)
    argon2_blake2b(h0, 64, password, password_len, secret, secret_len, salt, salt_len)
    
    // Generate initial blocks
    let lane = 0
    while lane < parallelism {
        let slice = 0
        while slice < ARGON2_SYNC_POINTS {
            let index = 0
            while index < segment_length {
                // Fill block
                let block_offset = (lane * ARGON2_SYNC_POINTS + slice) * segment_length + index
                let block_ptr = memory + block_offset * block_size
                
                if index == 0 && slice == 0 {
                    // First block: H0 || lane || 0 || 0
                    let i = 0
                    while i < 64 {
                        mem_store8(block_ptr + i, mem_load8(h0 + i))
                        i = i + 1
                    }
                    w64(block_ptr + 64, lane)
                    w64(block_ptr + 72, 0)
                    w64(block_ptr + 80, 0)
                } else if index == 0 {
                    // First block of slice: H(prev_lane_last_block)
                    let prev = memory + (lane * ARGON2_SYNC_POINTS + slice - 1) * segment_length * block_size + (segment_length - 1) * block_size
                    let i = 0
                    while i < 64 {
                        mem_store8(block_ptr + i, mem_load8(prev + i))
                        i = i + 1
                    }
                    w64(block_ptr + 64, lane)
                    w64(block_ptr + 72, slice)
                    w64(block_ptr + 80, 0)
                } else {
                    // Other blocks: H(prev_block)
                    let prev = memory + block_offset * block_size - block_size
                    let i = 0
                    while i < 64 {
                        mem_store8(block_ptr + i, mem_load8(prev + i))
                        i = i + 1
                    }
                    w64(block_ptr + 64, lane)
                    w64(block_ptr + 72, slice)
                    w64(block_ptr + 80, index)
                }
                
                // Hash the block
                argon2_blake2b(block_ptr, 64, block_ptr, block_size, 0, 0, 0, 0)
                index = index + 1
            }
            slice = slice + 1
        }
        lane = lane + 1
    }
    
    // Time-cost passes
    let pass = 0
    while pass < t_cost {
        lane = 0
        while lane < parallelism {
            slice = 0
            while slice < ARGON2_SYNC_POINTS {
                index = 0
                while index < segment_length {
                    // Compute block using Argon2 G function
                    let block_offset = (lane * ARGON2_SYNC_POINTS + slice) * segment_length + index
                    let block_ptr = memory + block_offset * block_size
                    
                    // Simplified - would use actual Argon2 indexing
                    argon2_blake2b(block_ptr, 64, block_ptr, block_size, 0, 0, 0, 0)
                    
                    index = index + 1
                }
                slice = slice + 1
            }
            lane = lane + 1
        }
        pass = pass + 1
    }
    
    // Final hash
    let final_block = memory + (parallelism * ARGON2_SYNC_POINTS * segment_length - 1) * block_size
    argon2_blake2b(out, out_len, final_block, block_size, 0, 0, 0, 0)
    
    mem_free(memory)
    mem_free(h0)
    return 0
}

// ============================================================================
// Encrypted Keystore (AES-256-GCM + Argon2id)
// ============================================================================

// Keystore header
let KEYSTORE_MAGIC = 0x514E544B53544F52 // "QNTS" + "TORE"
let KEYSTORE_VERSION = 1
let KEYSTORE_HEADER_SIZE = 128

let KS_OFF_MAGIC = 0
let KS_OFF_VERSION = 8
let KS_OFF_KDF_ALGO = 16
let KS_OFF_KDF_PARAMS = 24
let KS_OFF_SALT = 40
let KS_OFF_SALT_LEN = 48
let KS_OFF_NONCE = 72
let KS_OFF_NONCE_LEN = 80
let KS_OFF_TAG = 88
let KS_OFF_TAG_LEN = 96
let KS_OFF_ENTRY_COUNT = 104
let KS_OFF_RESERVED = 112

// KDF algorithms
let KDF_ALGO_PBKDF2 = 1
let KDF_ALGO_SCRYPT = 2
let KDF_ALGO_ARGON2ID = 3
let KDF_ALGO_HKDF = 4

// Keystore entry
let KS_ENTRY_OFF_ID = 0
let KS_ENTRY_OFF_ID_LEN = 8
let KS_ENTRY_OFF_TYPE = 16
let KS_ENTRY_OFF_VALUE = 24
let KS_ENTRY_OFF_VALUE_LEN = 32
let KS_ENTRY_OFF_META = 40
let KS_ENTRY_OFF_META_LEN = 48
let KS_ENTRY_OFF_CREATED = 56
let KS_ENTRY_OFF_EXPIRES = 64
let KS_ENTRY_OFF_ROTATION = 72
let KS_ENTRY_STRUCT_SIZE = 80

let KS_TYPE_PLAIN = 0
let KS_TYPE_SECRET = 1
let KS_TYPE_PRIVATE_KEY = 2
let KS_TYPE_CERTIFICATE = 3
let KS_TYPE_HSM_HANDLE = 4

// Keystore context
let keystore_ctx = 0
let keystore_path = 0
let keystore_dirty = 0
let keystore_master_key = 0
let keystore_entries = 0
let keystore_entry_count = 0
let keystore_entry_cap = 0

fn keystore_init() {
    keystore_ctx = mem_alloc(KEYSTORE_HEADER_SIZE)
    keystore_entries = 0
    keystore_entry_count = 0
    keystore_entry_cap = 0
    keystore_dirty = 0
    keystore_master_key = 0
    keystore_path = 0
    return 0
}

fn keystore_free() {
    if keystore_ctx != 0 { mem_free(keystore_ctx) }
    if keystore_master_key != 0 { mem_free(keystore_master_key) }
    if keystore_entries != 0 { mem_free(keystore_entries) }
    if keystore_path != 0 { mem_free(keystore_path) }
    keystore_ctx = 0
    keystore_master_key = 0
    keystore_entries = 0
    keystore_entry_count = 0
    keystore_entry_cap = 0
    keystore_dirty = 0
    keystore_path = 0
}

fn keystore_set_path(path, path_len) {
    if keystore_path != 0 { mem_free(keystore_path) }
    keystore_path = mem_alloc(path_len + 1)
    if keystore_path == 0 { return -1 }
    let i = 0
    while i < path_len {
        mem_store8(keystore_path + i, mem_load8(path + i))
        i = i + 1
    }
    mem_store8(keystore_path + path_len, 0)
    return 0
}

// Derive master key from password
fn keystore_derive_master_key(password, password_len, kdf_algo, kdf_params, salt, salt_len, nonce, nonce_len, key_out, key_len) {
    if kdf_algo == KDF_ALGO_ARGON2ID {
        let t_cost = r64(kdf_params + 0)
        let m_cost = r64(kdf_params + 8)
        let parallelism = r64(kdf_params + 16)
        return argon2id(password, password_len, salt, salt_len, 0, 0, 0, 0, t_cost, m_cost, parallelism, key_out, key_len)
    } else if kdf_algo == KDF_ALGO_SCRYPT {
        let n = r64(kdf_params + 0)
        let r = r64(kdf_params + 8)
        let p = r64(kdf_params + 16)
        return scrypt(password, password_len, salt, salt_len, n, r, p, key_out, key_len)
    } else if kdf_algo == KDF_ALGO_PBKDF2 {
        let iterations = r64(kdf_params + 0)
        return pbkdf2_hmac_sha256(password, password_len, salt, salt_len, iterations, key_out, key_len)
    } else if kdf_algo == KDF_ALGO_HKDF {
        let info = r64(kdf_params + 0)
        let info_len = r64(kdf_params + 8)
        return hkdf_sha256(salt, salt_len, password, password_len, info, info_len, key_out, key_len)
    }
    return -1
}

// Create new keystore
fn keystore_create(path, path_len, password, password_len, kdf_algo, kdf_params) {
    keystore_free()
    keystore_init()
    keystore_set_path(path, path_len)
    
    // Generate salt
    let salt = mem_alloc(32)
    getrandom(salt, 32, 0)
    
    // Generate nonce
    let nonce = mem_alloc(12)
    getrandom(nonce, 12, 0)
    
    // Derive master key
    let master_key = mem_alloc(32)
    if master_key == 0 { return -1 }
    
    let r = keystore_derive_master_key(password, password_len, kdf_algo, kdf_params, salt, 32, nonce, 12, master_key, 32)
    if r != 0 {
        mem_free(salt)
        mem_free(nonce)
        mem_free(master_key)
        return r
    }
    
    keystore_master_key = master_key
    
    // Initialize header
    w64(keystore_ctx + KS_OFF_MAGIC, KEYSTORE_MAGIC)
    w64(keystore_ctx + KS_OFF_VERSION, KEYSTORE_VERSION)
    w64(keystore_ctx + KS_OFF_KDF_ALGO, kdf_algo)
    w64(keystore_ctx + KS_OFF_KDF_PARAMS, kdf_params)
    w64(keystore_ctx + KS_OFF_SALT, salt)
    w64(keystore_ctx + KS_OFF_SALT_LEN, 32)
    w64(keystore_ctx + KS_OFF_NONCE, nonce)
    w64(keystore_ctx + KS_OFF_NONCE_LEN, 12)
    w64(keystore_ctx + KS_OFF_TAG, 0) // Will be filled on save
    w64(keystore_ctx + KS_OFF_TAG_LEN, 16)
    w64(keystore_ctx + KS_OFF_ENTRY_COUNT, 0)
    
    // Allocate initial entries array
    keystore_entry_cap = 16
    keystore_entries = mem_alloc(keystore_entry_cap * KS_ENTRY_STRUCT_SIZE)
    
    keystore_dirty = 1
    return keystore_save()
}

// Save keystore to disk
fn keystore_save() {
    if keystore_path == 0 { return -1 }
    if keystore_dirty == 0 { return 0 }
    
    // Serialize entries
    let entries_data = mem_alloc(keystore_entry_count * KS_ENTRY_STRUCT_SIZE)
    if entries_data == 0 { return -1 }
    
    let i = 0
    while i < keystore_entry_count {
        let src = keystore_entries + i * KS_ENTRY_STRUCT_SIZE
        let dst = entries_data + i * KS_ENTRY_STRUCT_SIZE
        let j = 0
        while j < KS_ENTRY_STRUCT_SIZE {
            mem_store8(dst + j, mem_load8(src + j))
            j = j + 1
        }
        i = i + 1
    }
    
    // Encrypt entries
    let encrypted = mem_alloc(keystore_entry_count * KS_ENTRY_STRUCT_SIZE + 16)
    let tag = mem_alloc(16)
    if encrypted == 0 || tag == 0 {
        mem_free(entries_data)
        if encrypted != 0 { mem_free(encrypted) }
        if tag != 0 { mem_free(tag) }
        return -1
    }
    
    let nonce_ptr = r64(keystore_ctx + KS_OFF_NONCE)
    let r = aes256_gcm_enc(keystore_master_key, 32, nonce_ptr, 12, 0, 0, entries_data, keystore_entry_count * KS_ENTRY_STRUCT_SIZE, encrypted, tag)
    if r != 0 {
        mem_free(entries_data)
        mem_free(encrypted)
        mem_free(tag)
        return r
    }
    
    // Update header tag
    let tag_len = 16
    let tag_ptr = mem_alloc(16)
    let j = 0
    while j < 16 {
        mem_store8(tag_ptr + j, mem_load8(tag + j))
        j = j + 1
    }
    w64(keystore_ctx + KS_OFF_TAG, tag_ptr)
    
    // Update entry count
    w64(keystore_ctx + KS_OFF_ENTRY_COUNT, keystore_entry_count)
    
    // Write to file
    let fd = file_open(keystore_path, 0x0201 | 0x0400) // O_WRONLY | O_CREAT | O_TRUNC
    if fd < 0 {
        mem_free(entries_data)
        mem_free(encrypted)
        mem_free(tag_ptr)
        return -1
    }
    
    // Write header
    let written = file_write(fd, keystore_ctx, KEYSTORE_HEADER_SIZE)
    if written != KEYSTORE_HEADER_SIZE {
        file_close(fd)
        mem_free(entries_data)
        mem_free(encrypted)
        mem_free(tag_ptr)
        return -1
    }
    
    // Write encrypted entries
    written = file_write(fd, encrypted, keystore_entry_count * KS_ENTRY_STRUCT_SIZE)
    if written != keystore_entry_count * KS_ENTRY_STRUCT_SIZE {
        file_close(fd)
        mem_free(entries_data)
        mem_free(encrypted)
        mem_free(tag_ptr)
        return -1
    }
    
    file_close(fd)
    mem_free(entries_data)
    mem_free(encrypted)
    mem_free(tag_ptr)
    
    keystore_dirty = 0
    return 0
}

// Load keystore from disk
fn keystore_load(path, path_len, password, password_len) {
    keystore_free()
    keystore_init()
    keystore_set_path(path, path_len)
    
    let fd = file_open(keystore_path, 0x0000) // O_RDONLY
    if fd < 0 { return -1 }
    
    // Read header
    let read = file_read(fd, keystore_ctx, KEYSTORE_HEADER_SIZE)
    if read != KEYSTORE_HEADER_SIZE {
        file_close(fd)
        return -1
    }
    
    // Verify magic
    if r64(keystore_ctx + KS_OFF_MAGIC) != KEYSTORE_MAGIC {
        file_close(fd)
        return -1
    }
    
    // Verify version
    if r64(keystore_ctx + KS_OFF_VERSION) != KEYSTORE_VERSION {
        file_close(fd)
        return -1
    }
    
    // Get KDF params
    let kdf_algo = r64(keystore_ctx + KS_OFF_KDF_ALGO)
    let kdf_params = r64(keystore_ctx + KS_OFF_KDF_PARAMS)
    let salt_ptr = r64(keystore_ctx + KS_OFF_SALT)
    let salt_len = r64(keystore_ctx + KS_OFF_SALT_LEN)
    let nonce_ptr = r64(keystore_ctx + KS_OFF_NONCE)
    let nonce_len = r64(keystore_ctx + KS_OFF_NONCE_LEN)
    let tag_ptr = r64(keystore_ctx + KS_OFF_TAG)
    let tag_len = r64(keystore_ctx + KS_OFF_TAG_LEN)
    let entry_count = r64(keystore_ctx + KS_OFF_ENTRY_COUNT)
    
    // Derive master key
    let master_key = mem_alloc(32)
    if master_key == 0 {
        file_close(fd)
        return -1
    }
    
    let r = keystore_derive_master_key(password, password_len, kdf_algo, kdf_params, salt_ptr, salt_len, nonce_ptr, nonce_len, master_key, 32)
    if r != 0 {
        file_close(fd)
        mem_free(master_key)
        return r
    }
    
    keystore_master_key = master_key
    
    // Read encrypted entries
    let encrypted_size = entry_count * KS_ENTRY_STRUCT_SIZE
    let encrypted = mem_alloc(encrypted_size)
    if encrypted == 0 {
        file_close(fd)
        return -1
    }
    
    read = file_read(fd, encrypted, encrypted_size)
    if read != encrypted_size {
        file_close(fd)
        mem_free(encrypted)
        return -1
    }
    file_close(fd)
    
    // Decrypt entries
    let entries_data = mem_alloc(encrypted_size)
    if entries_data == 0 {
        mem_free(encrypted)
        return -1
    }
    
    let tag = mem_alloc(16)
    let j = 0
    while j < 16 {
        mem_store8(tag + j, mem_load8(tag_ptr + j))
        j = j + 1
    }
    
    r = aes256_gcm_dec(keystore_master_key, 32, nonce_ptr, 12, 0, 0, encrypted, encrypted_size, tag, entries_data)
    if r != 0 {
        mem_free(encrypted)
        mem_free(entries_data)
        mem_free(tag)
        return r
    }
    
    // Store entries
    keystore_entry_count = entry_count
    keystore_entry_cap = entry_count + 16
    keystore_entries = mem_alloc(keystore_entry_cap * KS_ENTRY_STRUCT_SIZE)
    if keystore_entries == 0 {
        mem_free(encrypted)
        mem_free(entries_data)
        mem_free(tag)
        return -1
    }
    
    i = 0
    while i < entry_count {
        let src = entries_data + i * KS_ENTRY_STRUCT_SIZE
        let dst = keystore_entries + i * KS_ENTRY_STRUCT_SIZE
        j = 0
        while j < KS_ENTRY_STRUCT_SIZE {
            mem_store8(dst + j, mem_load8(src + j))
            j = j + 1
        }
        i = i + 1
    }
    
    mem_free(encrypted)
    mem_free(entries_data)
    mem_free(tag)
    
    keystore_dirty = 0
    return 0
}

// Add entry to keystore
fn keystore_add_entry(id, id_len, entry_type, value, value_len, meta, meta_len, rotation_period) {
    if keystore_entry_count >= keystore_entry_cap {
        let new_cap = keystore_entry_cap * 2
        let new_entries = mem_alloc(new_cap * KS_ENTRY_STRUCT_SIZE)
        if new_entries == 0 { return -1 }
        
        let i = 0
        while i < keystore_entry_count {
            let src = keystore_entries + i * KS_ENTRY_STRUCT_SIZE
            let dst = new_entries + i * KS_ENTRY_STRUCT_SIZE
            let j = 0
            while j < KS_ENTRY_STRUCT_SIZE {
                mem_store8(dst + j, mem_load8(src + j))
                j = j + 1
            }
            i = i + 1
        }
        mem_free(keystore_entries)
        keystore_entries = new_entries
        keystore_entry_cap = new_cap
    }
    
    let entry = keystore_entries + keystore_entry_count * KS_ENTRY_STRUCT_SIZE
    
    // ID
    let copy_id = id_len
    if copy_id > 64 { copy_id = 64 }
    let i = 0
    while i < copy_id {
        mem_store8(entry + KS_ENTRY_OFF_ID + i, mem_load8(id + i))
        i = i + 1
    }
    while i < 64 {
        mem_store8(entry + KS_ENTRY_OFF_ID + i, 0)
        i = i + 1
    }
    w64(entry + KS_ENTRY_OFF_ID_LEN, id_len)
    
    // Type
    w64(entry + KS_ENTRY_OFF_TYPE, entry_type)
    
    // Value
    w64(entry + KS_ENTRY_OFF_VALUE, value)
    w64(entry + KS_ENTRY_OFF_VALUE_LEN, value_len)
    
    // Meta
    let copy_meta = meta_len
    if copy_meta > 256 { copy_meta = 256 }
    i = 0
    while i < copy_meta {
        mem_store8(entry + KS_ENTRY_OFF_META + i, mem_load8(meta + i))
        i = i + 1
    }
    while i < 256 {
        mem_store8(entry + KS_ENTRY_OFF_META + i, 0)
        i = i + 1
    }
    w64(entry + KS_ENTRY_OFF_META_LEN, meta_len)
    
    // Timestamps
    let now = clock() / 1000000000
    w64(entry + KS_ENTRY_OFF_CREATED, now)
    w64(entry + KS_ENTRY_OFF_EXPIRES, now + rotation_period)
    w64(entry + KS_ENTRY_OFF_ROTATION, rotation_period)
    
    keystore_entry_count = keystore_entry_count + 1
    keystore_dirty = 1
    return 0
}

// Get entry from keystore
fn keystore_get_entry(id, id_len, entry_out) {
    let i = 0
    while i < keystore_entry_count {
        let entry = keystore_entries + i * KS_ENTRY_STRUCT_SIZE
        let eid_len = r64(entry + KS_ENTRY_OFF_ID_LEN)
        if eid_len == id_len {
            let match = 1
            let j = 0
            while j < id_len {
                if mem_load8(entry + KS_ENTRY_OFF_ID + j) != mem_load8(id + j) {
                    match = 0
                    break
                }
                j = j + 1
            }
            if match != 0 {
                w64(entry_out, entry)
                return 0
            }
        }
        i = i + 1
    }
    return -1
}

// Delete entry from keystore
fn keystore_delete_entry(id, id_len) {
    let i = 0
    while i < keystore_entry_count {
        let entry = keystore_entries + i * KS_ENTRY_STRUCT_SIZE
        let eid_len = r64(entry + KS_ENTRY_OFF_ID_LEN)
        if eid_len == id_len {
            let match = 1
            let j = 0
            while j < id_len {
                if mem_load8(entry + KS_ENTRY_OFF_ID + j) != mem_load8(id + j) {
                    match = 0
                    break
                }
                j = j + 1
            }
            if match != 0 {
                // Move last entry here
                if i < keystore_entry_count - 1 {
                    let last = keystore_entries + (keystore_entry_count - 1) * KS_ENTRY_STRUCT_SIZE
                    let k = 0
                    while k < KS_ENTRY_STRUCT_SIZE {
                        mem_store8(entry + k, mem_load8(last + k))
                        k = k + 1
                    }
                }
                keystore_entry_count = keystore_entry_count - 1
                keystore_dirty = 1
                return 0
            }
        }
        i = i + 1
    }
    return -1
}

// Check and rotate keys
fn keystore_check_rotation() {
    let now = clock() / 1000000000
    let i = 0
    while i < keystore_entry_count {
        let entry = keystore_entries + i * KS_ENTRY_STRUCT_SIZE
        let expires = r64(entry + KS_ENTRY_OFF_EXPIRES)
        let rotation = r64(entry + KS_ENTRY_OFF_ROTATION)
        let entry_type = r64(entry + KS_ENTRY_OFF_TYPE)
        
        if rotation > 0 && now >= expires && (entry_type == KS_TYPE_SECRET || entry_type == KS_TYPE_PRIVATE_KEY) {
            // Key needs rotation
            // Generate new key
            let new_key = mem_alloc(32)
            if new_key != 0 {
                getrandom(new_key, 32, 0)
                // Update entry
                w64(entry + KS_ENTRY_OFF_VALUE, new_key)
                w64(entry + KS_ENTRY_OFF_VALUE_LEN, 32)
                w64(entry + KS_ENTRY_OFF_CREATED, now)
                w64(entry + KS_ENTRY_OFF_EXPIRES, now + rotation)
                keystore_dirty = 1
            }
        }
        i = i + 1
    }
    return 0
}

// Key rotation policies
let ROTATION_POLICY_NONE = 0
let ROTATION_POLICY_DAILY = 86400
let ROTATION_POLICY_WEEKLY = 604800
let ROTATION_POLICY_MONTHLY = 2592000
let ROTATION_POLICY_QUARTERLY = 7776000
let ROTATION_POLICY_YEARLY = 31536000

// Secure delete (overwrite before free)
fn secure_delete(ptr, len) {
    if ptr == 0 || len == 0 { return }
    
    // Three-pass overwrite
    let pass = 0
    while pass < 3 {
        let i = 0
        while i < len {
            if pass == 0 {
                mem_store8(ptr + i, 0x00)
            } else if pass == 1 {
                mem_store8(ptr + i, 0xFF)
            } else {
                getrandom(ptr + i, 1, 0)
            }
            i = i + 1
        }
        pass = pass + 1
    }
    mem_free(ptr)
}

// High-level keystore API
fn keystore_store_secret(id, id_len, secret, secret_len, rotation_policy) {
    return keystore_add_entry(id, id_len, KS_TYPE_SECRET, secret, secret_len, 0, 0, rotation_policy)
}

fn keystore_store_private_key(id, id_len, key, key_len, rotation_policy) {
    return keystore_add_entry(id, id_len, KS_TYPE_PRIVATE_KEY, key, key_len, 0, 0, rotation_policy)
}

fn keystore_store_certificate(id, id_len, cert, cert_len, meta, meta_len) {
    return keystore_add_entry(id, id_len, KS_TYPE_CERTIFICATE, cert, cert_len, meta, meta_len, 0)
}

fn keystore_get_secret(id, id_len, secret_out, secret_len_out) {
    let entry = mem_alloc(8)
    let r = keystore_get_entry(id, id_len, entry)
    if r != 0 { return r }
    let e = r64(entry)
    mem_free(entry)
    w64(secret_out, r64(e + KS_ENTRY_OFF_VALUE))
    w64(secret_len_out, r64(e + KS_ENTRY_OFF_VALUE_LEN))
    return 0
}

fn keystore_get_private_key(id, id_len, key_out, key_len_out) {
    let entry = mem_alloc(8)
    let r = keystore_get_entry(id, id_len, entry)
    if r != 0 { return r }
    let e = r64(entry)
    mem_free(entry)
    w64(key_out, r64(e + KS_ENTRY_OFF_VALUE))
    w64(key_len_out, r64(e + KS_ENTRY_OFF_VALUE_LEN))
    return 0
}

// ============================================================================
// Constants test
// ============================================================================

fn kdf_algo_pbkdf2(): i64 { return 1 }
fn kdf_algo_scrypt(): i64 { return 2 }
fn kdf_algo_argon2id(): i64 { return 3 }
fn kdf_algo_hkdf(): i64 { return 4 }

fn ks_type_secret(): i64 { return 1 }
fn ks_type_private_key(): i64 { return 2 }
fn ks_type_certificate(): i64 { return 3 }
fn ks_type_hsm_handle(): i64 { return 4 }

fn rotation_daily(): i64 { return 86400 }
fn rotation_weekly(): i64 { return 604800 }
fn rotation_monthly(): i64 { return 2592000 }
fn rotation_yearly(): i64 { return 31536000 }

fn main() {
    if kdf_algo_pbkdf2() != 1 { return 1 }
    if kdf_algo_scrypt() != 2 { return 2 }
    if kdf_algo_argon2id() != 3 { return 3 }
    if kdf_algo_hkdf() != 4 { return 4 }
    if ks_type_secret() != 1 { return 5 }
    if ks_type_private_key() != 2 { return 6 }
    if ks_type_certificate() != 3 { return 7 }
    if ks_type_hsm_handle() != 4 { return 8 }
    if rotation_daily() != 86400 { return 9 }
    if rotation_weekly() != 604800 { return 10 }
    if rotation_monthly() != 2592000 { return 11 }
    if rotation_yearly() != 31536000 { return 12 }
    return 0
}