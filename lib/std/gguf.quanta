// std/gguf.quanta — Native GGUF model loader for Quanta

import std/fs

let GGUF_TYPE_F32 = 0
let GGUF_TYPE_F16 = 1
let GGUF_TYPE_Q4_0 = 2
let GGUF_TYPE_Q4_1 = 3
let GGUF_TYPE_Q5_0 = 6
let GGUF_TYPE_Q5_1 = 7
let GGUF_TYPE_Q8_0 = 8
let GGUF_TYPE_Q8_1 = 9
let GGUF_TYPE_Q2_K = 10
let GGUF_TYPE_Q3_K = 11
let GGUF_TYPE_Q4_K = 12
let GGUF_TYPE_Q5_K = 13
let GGUF_TYPE_Q6_K = 14
let GGUF_TYPE_Q8_K = 15
let GGUF_TYPE_IQ4_NL = 20
let GGUF_TYPE_IQ4_XS = 21

let GGUF_VAL_UINT8 = 0
let GGUF_VAL_INT8 = 1
let GGUF_VAL_UINT16 = 2
let GGUF_VAL_INT16 = 3
let GGUF_VAL_UINT32 = 4
let GGUF_VAL_INT32 = 5
let GGUF_VAL_FLOAT32 = 6
let GGUF_VAL_BOOL = 7
let GGUF_VAL_STRING = 8
let GGUF_VAL_ARRAY = 9
let GGUF_VAL_UINT64 = 10
let GGUF_VAL_INT64 = 11
let GGUF_VAL_FLOAT64 = 12

let gguf_fd = -1
let gguf_n_kv = 0
let gguf_n_tensors = 0
let gguf_tensors = 0

const TINFO_SIZE = 64

fn gguf_read_string(fd) {
    let len_buf = mem_alloc(8)
    let n = file_read(fd, len_buf, 8)
    if n < 8 { return 0 }
    let len = mem_load(len_buf)
    if len == 0 { return 0 }
    if len > 1048576 { return 0 }
    let buf = mem_alloc(len + 1)
    let r = file_read(fd, buf, len)
    if r < len { return 0 }
    mem_store8(buf + len, 0)
    return buf
}

fn gguf_skip(fd, n) {
    if n <= 0 { return }
    lseek(fd, n, 1)
}

fn gguf_load(path) {
    let fd = open(path, 0, 0)
    if fd < 0 { return -1 }
    gguf_fd = fd

    let hdr = mem_alloc(24)
    let n = read_raw(fd, hdr, 24)
    if n < 24 { close(fd); gguf_fd = -1; return -2 }

    let b0 = mem_load8(hdr)
    if b0 != 71 { close(fd); gguf_fd = -1; return -3 }

    gguf_n_kv = mem_load(hdr + 8)
    gguf_n_tensors = mem_load(hdr + 16)

    let i = 0
    while i < gguf_n_kv {
        let key = gguf_read_string(fd)
        if key != 0 {
            let vtype_buf = mem_alloc(4)
            read_raw(fd, vtype_buf, 4)
            let vtype = mem_load(vtype_buf)

            if vtype == 8 {
                gguf_read_string(fd)
            } else if vtype == 0 {
                gguf_skip(fd, 1)
            } else if vtype == 1 {
                gguf_skip(fd, 1)
            } else if vtype == 2 {
                gguf_skip(fd, 2)
            } else if vtype == 3 {
                gguf_skip(fd, 2)
            } else if vtype == 4 {
                gguf_skip(fd, 4)
            } else if vtype == 5 {
                gguf_skip(fd, 4)
            } else if vtype == 6 {
                gguf_skip(fd, 4)
            } else if vtype == 7 {
                gguf_skip(fd, 1)
            } else if vtype == 9 {
                gguf_skip_array(fd)
            } else if vtype == 10 {
                gguf_skip(fd, 8)
            } else if vtype == 11 {
                gguf_skip(fd, 8)
            } else if vtype == 12 {
                gguf_skip(fd, 8)
            } else {
                gguf_skip(fd, 4)
            }
        }
        i = i + 1
    }

    gguf_tensors = mem_alloc(gguf_n_tensors * TINFO_SIZE)

    let ti = 0
    while ti < gguf_n_tensors {
        let name = gguf_read_string(fd)

        let ndims_buf = mem_alloc(4)
        read_raw(fd, ndims_buf, 4)
        let ndims = mem_load(ndims_buf)

        let dims = mem_alloc(ndims * 8)
        let d = 0
        while d < ndims {
            let dval = mem_alloc(8)
            read_raw(fd, dval, 8)
            mem_store(dims + d * 8, mem_load(dval))
            d = d + 1
        }

        let dtype_buf = mem_alloc(4)
        read_raw(fd, dtype_buf, 4)
        let dtype = mem_load(dtype_buf)

        let offset_buf = mem_alloc(8)
        read_raw(fd, offset_buf, 8)
        let offset = mem_load(offset_buf)

        mem_store(gguf_tensors + ti * TINFO_SIZE, name)
        mem_store(gguf_tensors + ti * TINFO_SIZE + 8, ndims)
        mem_store(gguf_tensors + ti * TINFO_SIZE + 16, dims)
        mem_store(gguf_tensors + ti * TINFO_SIZE + 24, dtype)
        mem_store(gguf_tensors + ti * TINFO_SIZE + 32, offset)

        ti = ti + 1
    }

    return 0
}

fn gguf_skip_array(fd) {
    let atype_buf = mem_alloc(4)
    read_raw(fd, atype_buf, 4)
    let atype = mem_load(atype_buf)
    let alen_buf = mem_alloc(8)
    read_raw(fd, alen_buf, 8)
    let alen = mem_load(alen_buf)

    if atype == 8 {
        let j = 0
        while j < alen {
            gguf_read_string(fd)
            j = j + 1
        }
    } else if atype == 0 {
        gguf_skip(fd, alen)
    } else if atype == 1 {
        gguf_skip(fd, alen)
    } else if atype == 2 {
        gguf_skip(fd, alen * 2)
    } else if atype == 3 {
        gguf_skip(fd, alen * 2)
    } else if atype == 4 {
        gguf_skip(fd, alen * 4)
    } else if atype == 5 {
        gguf_skip(fd, alen * 4)
    } else if atype == 6 {
        gguf_skip(fd, alen * 4)
    } else if atype == 7 {
        gguf_skip(fd, alen)
    } else if atype == 10 {
        gguf_skip(fd, alen * 8)
    } else if atype == 11 {
        gguf_skip(fd, alen * 8)
    } else if atype == 12 {
        gguf_skip(fd, alen * 8)
    } else {
        gguf_skip(fd, alen * 4)
    }
}

fn gguf_tensor_name(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE) }
fn gguf_tensor_ndims(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 8) }
fn gguf_tensor_dims(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 16) }
fn gguf_tensor_dtype(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 24) }
fn gguf_tensor_offset(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 32) }

fn gguf_tensor_dim(idx, d) {
    let dims = gguf_tensor_dims(idx)
    return mem_load(dims + d * 8)
}

fn gguf_tensor_nelements(idx) {
    let ndims = gguf_tensor_ndims(idx)
    let n = 1
    let d = 0
    while d < ndims {
        n = n * gguf_tensor_dim(idx, d)
        d = d + 1
    }
    return n
}

fn gguf_find_tensor(name) {
    let name_len = len(name)
    let i = 0
    while i < gguf_n_tensors {
        let tname = gguf_tensor_name(i)
        let tlen = len(tname)
        if tlen == name_len {
            if gguf_str_eq(tname, name, tlen) { return i }
        }
        i = i + 1
    }
    return -1
}

fn gguf_str_eq(a, b, len) {
    let j = 0
    let ok = 1
    while j < len {
        if mem_load8(a + 8 + j) != mem_load8(b + 8 + j) {
            ok = 0
            j = len
        }
        j = j + 1
    }
    return ok
}

fn gguf_close() {
    if gguf_fd >= 0 {
        close(gguf_fd)
        gguf_fd = -1
    }
}

fn gguf_num_tensors() { return gguf_n_tensors }
fn gguf_get_fd() { return gguf_fd }
