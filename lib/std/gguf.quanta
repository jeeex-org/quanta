// std/gguf.quanta — Complete GGUF inference engine for Quanta 0.0.195
// Uses proper floating point: fadd, fmul, fdiv, i2f, f2i, sqrt
// General GGUF support: proper metadata parsing, alignment, string arrays
import std/fs
import std/math

let gguf_fd = -1
let gguf_n_tensors = 0
let gguf_n_kv = 0
let gguf_data_start = 0
// Byte offset of the tensor-info table, set by read_tensor_info().
let gguf_tinfo_start = 0
// Total file size, captured at load. The chain validator needs it to prove each
// tensor stays inside the file; upstream gguf_reader tracks the equivalent as
// nbytes_remain and bounds every read against it.
let gguf_filesize = 0
let gguf_tensor_dims = 0
let gguf_tensor_data = 0

// Byte offset of each metadata KV record, plus the shape of any string array
// it carries. Built by scan_metadata() so metadata VALUES -- not just their
// sizes -- become reachable. The tokenizer needs the actual token strings and
// the merge list, and no existing API exposed them: scan_metadata() only ever
// skipped over them.
//
// Layout, parallel to the tensor-info table, 4 i64s per KV record:
//   gguf_kv_index[i]    : file offset of KV record i
//   gguf_kv_arr_off[i]  : file offset of element 0 of its string array,
//                         or -1 when the value is not a string array
//   gguf_kv_arr_len[i]  : element count, 0 when not a string array
//   gguf_kv_etype[i]    : element type ID, 0 when not an array
//
// String array elements are variable length, so the array is walked on demand
// (gguf_arr_elem_off) rather than indexed up front. The tokenizer arrays are
// 128000 and 293320 entries; an offset index for them would cost 3.4 MB and
// buy nothing, since both are read front to back exactly once.
let gguf_kv_index = 0
let gguf_kv_arr_off = 0
let gguf_kv_arr_len = 0
let gguf_kv_etype = 0

const TINFO_SIZE = 40
const KVREC_SIZE = 24

// GGUF layout: the tensor DATA section begins after the tensor-info table,
// padded to a 32-byte boundary. Each tensor's `offset` is RELATIVE to this
// point -- seeking to the raw offset lands in the header and yields zeros.
fn record_data_start(fd) {
    let info_end = lseek(fd, 0, 1)
    let rem = info_end - (info_end / 32) * 32
    if rem != 0 { lseek(fd, 32 - rem, 1) }
    gguf_data_start = lseek(fd, 0, 1)
    return 0
}

// Walk the metadata KV block, leaving fd at the tensor-info table.
// Returns the metadata byte count excluding the 24-byte header.
//
// Also records, per KV, where its value lives (gguf_kv_*), so the value can
// be fetched later by gguf_kv_find(). Recording the offset costs one lseek(0,1)
// per record; the alternative -- re-walking the block on every lookup -- turns
// a vocab search into an O(n_kv * n_tokens) scan of a 20 MB region.
// Cap on the metadata (KV) block, and on any single string length inside it.
//
// ComfyUI caps a safetensors header at 100 MB and rejects anything larger before
// allocating; safetensors does the same. Without a cap, a file declaring a
// 4 GB key length causes an allocation and a seek sized by an attacker-chosen
// number. The real model uses ~1.6 MB of metadata, so this leaves three orders of
// magnitude of headroom while still bounding the damage.
const GGUF_MAX_META = 268435456      // 256 MB total metadata block
const GGUF_MAX_STRING = 67108864     // 64 MB for any one string

fn scan_metadata(fd, n_kv) {
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let slen_buf = mem_alloc(8)

    // n_kv is attacker-controlled and is multiplied into four allocations below.
    // A huge value overflows or simply asks for an enormous buffer, so bound it
    // against the file itself: there cannot be more KV records than there are
    // bytes, and every record costs at least 12 bytes on disk.
    if n_kv < 0 { return -1 }
    if n_kv > 1000000 { return -1 }
    if gguf_filesize > 0 && n_kv > gguf_filesize / 12 { return -1 }

    gguf_kv_index = mem_alloc(n_kv * KVREC_SIZE)
    gguf_kv_arr_off = mem_alloc(n_kv * 8)
    gguf_kv_arr_len = mem_alloc(n_kv * 8)
    gguf_kv_etype = mem_alloc(n_kv * 8)

    let meta_size = 0
    let i = 0
    
    while i < n_kv {
        mem_store(gguf_kv_index + i * 8, lseek(fd, 0, 1))
        mem_store(gguf_kv_arr_off + i * 8, -1)
        mem_store(gguf_kv_arr_len + i * 8, 0)
        mem_store(gguf_kv_etype + i * 8, 0)

        // Truncation check: a short read here means the file ended mid-record.
        if read_raw(fd, klen_buf, 8) != 8 { return -1 }
        let klen = mem_load(klen_buf)
        if klen < 0 || klen > GGUF_MAX_STRING { return -1 }
        // The running metadata size must stay inside both the cap and the file.
        if meta_size > GGUF_MAX_META - 8 - klen { return -1 }
        if gguf_filesize > 0 && meta_size + 8 + klen > gguf_filesize { return -1 }
        meta_size = meta_size + 8 + klen
        lseek(fd, klen, 1)
        
        read_raw(fd, vtype_buf, 4)
        meta_size = meta_size + 4
        let vtype = mem_load(vtype_buf)
        
        if vtype == 0 { lseek(fd, 1, 1); meta_size = meta_size + 1 }
        else if vtype == 1 { lseek(fd, 1, 1); meta_size = meta_size + 1 }
        else if vtype == 2 { lseek(fd, 2, 1); meta_size = meta_size + 2 }
        else if vtype == 3 { lseek(fd, 2, 1); meta_size = meta_size + 2 }
        else if vtype == 4 { lseek(fd, 4, 1); meta_size = meta_size + 4 }
        else if vtype == 5 { lseek(fd, 4, 1); meta_size = meta_size + 4 }
        else if vtype == 6 { lseek(fd, 4, 1); meta_size = meta_size + 4 }
        else if vtype == 7 { lseek(fd, 1, 1); meta_size = meta_size + 1 }
        else if vtype == 10 { lseek(fd, 8, 1); meta_size = meta_size + 8 }
        else if vtype == 11 { lseek(fd, 8, 1); meta_size = meta_size + 8 }
        else if vtype == 12 { lseek(fd, 8, 1); meta_size = meta_size + 8 }
        else if vtype == 8 {
            read_raw(fd, slen_buf, 8)
            let slen = mem_load(slen_buf)
            lseek(fd, slen, 1)
            meta_size = meta_size + 8 + slen
        } else if vtype == 9 {
            read_raw(fd, vtype_buf, 4)
            meta_size = meta_size + 4
            read_raw(fd, slen_buf, 8)
            meta_size = meta_size + 8
            let alen = mem_load(slen_buf)
            let etype = mem_load(vtype_buf)
            // Record the element type, element count and data offset for EVERY
            // array, not just string ones. Previously only the `etype == 8` branch
            // below filled these three, so a numeric array reported count -1,
            // etype 0 and offset -1 -- and a caller seeking to that offset read
            // from before the start of the file. LFM2's
            // lfm2.attention.head_count_kv is exactly such an array (i32, 30
            // elements), so the per-layer KV head counts came back as zero and
            // fc_read_config() failed closed rather than reporting it.
            //
            // The string-array walk below is kept for the length-prefixed
            // elem_off()/elem_len()/slurp() helpers, which need per-element
            // offsets; numeric arrays are read at gguf_kv_arr_off + 0 with
            // esize bytes per element.
            mem_store(gguf_kv_etype + i * 8, etype)
            mem_store(gguf_kv_arr_off + i * 8, lseek(fd, 0, 1))
            mem_store(gguf_kv_arr_len + i * 8, alen)
            if etype == 8 {
                let ai = 0
                while ai < alen {
                    read_raw(fd, slen_buf, 8)
                    let slen = mem_load(slen_buf)
                    lseek(fd, slen, 1)
                    meta_size = meta_size + 8 + slen
                    ai = ai + 1
                }
            } else {
                let esize = 1
                if etype == 2 || etype == 3 { esize = 2 }
                if etype == 4 || etype == 5 || etype == 6 { esize = 4 }
                if etype == 10 || etype == 11 || etype == 12 { esize = 8 }
                lseek(fd, alen * esize, 1)
                meta_size = meta_size + alen * esize
            }
        }
        
        i = i + 1
    }
    
    return meta_size
}

// Read the gguf_n_tensors tensor-info records into gguf_tensor_data.
fn read_tensor_info(fd) {
    // Where the tensor-info table starts, in bytes from the beginning of the file.
    //
    // Recorded so that external tooling (the byte-level corrupt-file generator)
    // can patch a field at a known offset WITHOUT re-walking the KV block. Two
    // hand-rolled Python GGUF readers desynced on general.base_model.0.name and
    // produced garbage; asking the verified parser for offsets removes that
    // whole failure mode.
    gguf_tinfo_start = lseek(fd, 0, 1)
    // n_tensors is attacker-controlled and multiplies an allocation. Each tensor
    // record costs at least 40 bytes in the file, so the file bounds the count.
    if gguf_n_tensors < 0 || gguf_n_tensors > 10000000 { return -1 }
    if gguf_filesize > 0 && gguf_n_tensors * TINFO_SIZE > gguf_filesize { return -1 }
    gguf_tensor_data = mem_alloc(gguf_n_tensors * TINFO_SIZE)
    
    let nlen_buf = mem_alloc(8)
    let ndims_buf = mem_alloc(4)
    let dim_buf = mem_alloc(8)
    let dtype_buf = mem_alloc(4)
    let off_buf = mem_alloc(8)
    let name_buf = mem_alloc(256)

    // Shape storage: up to 4 dims per tensor, kept alongside the fixed
    // tensor-info record so gguf_tensor_dim() does not need a second lookup.
    gguf_tensor_dims = mem_alloc(gguf_n_tensors * 32)
    
    let i = 0
    while i < gguf_n_tensors {
        file_read(fd, nlen_buf, 8)
        let nlen = mem_load(nlen_buf)
        file_read(fd, name_buf, nlen)
        mem_store8(name_buf + nlen, 0)
        
        file_read(fd, ndims_buf, 4)
        let ndims = mem_load(ndims_buf)
        
        let nelem = 1
        let d = 0
        while d < ndims {
            file_read(fd, dim_buf, 8)
            let dim = mem_load(dim_buf)
            nelem = nelem * dim
            mem_store(gguf_tensor_dims + i * 32 + d * 8, dim)
            d = d + 1
        }
        // clear any stale dims from a wider previous record
        while d < 4 {
            mem_store(gguf_tensor_dims + i * 32 + d * 8, 0)
            d = d + 1
        }
        
        file_read(fd, dtype_buf, 4)
        let dtype = mem_load(dtype_buf)
        
        file_read(fd, off_buf, 8)
        let offset = mem_load(off_buf)
        
        let name_copy = mem_alloc(nlen + 1)
        d = 0
        while d < nlen {
            mem_store8(name_copy + d, mem_load8(name_buf + d))
            d = d + 1
        }
        mem_store8(name_copy + nlen, 0)
        
        mem_store(gguf_tensor_data + i * TINFO_SIZE, name_copy)
        mem_store(gguf_tensor_data + i * TINFO_SIZE + 8, ndims)
        mem_store(gguf_tensor_data + i * TINFO_SIZE + 16, dtype)
        mem_store(gguf_tensor_data + i * TINFO_SIZE + 24, offset)
        mem_store(gguf_tensor_data + i * TINFO_SIZE + 32, nelem)
        
        i = i + 1
    }
    
    return 0
}

fn gguf_load(path) {
    let fd = open(path, 0, 0)
    if fd < 0 { return -1 }
    gguf_fd = fd
    gguf_filesize = file_size(fd)
    
    // GGUF header: magic(4) + version(4) + n_kv(8) + n_tensors(8) = 24 bytes
    let hdr = mem_alloc(24)
    file_read(fd, hdr, 24)
    if mem_load8(hdr) != 71 { close(fd); gguf_fd = -1; return -2 }
    
    // GGUF v3 header layout:
    //   +0 magic(4)  +4 version(4)  +8 tensor_count(8)  +16 metadata_kv_count(8)
    // tensor_count comes FIRST, then metadata_kv_count. Reading these the
    // other way round makes the metadata walk iterate over tensor records and
    // desync every subsequent read.
    let n_kv = mem_load(hdr + 16)
    gguf_n_tensors = mem_load(hdr + 8)
    gguf_n_kv = n_kv
    
    let meta_size = scan_metadata(fd, n_kv)
    if meta_size < 0 { close(fd); gguf_fd = -1; return -8 }
    
    // GGUF alignment: pad to the alignment boundary after metadata.
    // Read from general.alignment; upstream llama.cpp reads the same key and
    // rejects a non-power-of-2 value. A file declaring alignment 64 while we
    // assumed 32 would silently mis-place every tensor data section.
    // NO alignment padding between the metadata block and the tensor-info
    // table. gguf writes the KV block and the tensor-info records back to
    // back; only the tensor DATA section is aligned. Padding here pushes the
    // tensor-info read three bytes past the real first record and reads a
    // garbage name length.
    let total_meta = 24 + meta_size
    
    read_tensor_info(fd)
    
    record_data_start(fd)
    
    // Adopt the declared alignment, then prove the tensor data section is a
    // consistent chain. Both are checked here rather than lazily so a malformed
    // file is rejected at load instead of producing wrong numbers much later.
    if gguf_read_alignment() != 0 { close(fd); gguf_fd = -1; return -5 }
    let vr = gguf_validate_chain()
    if vr != 0 { close(fd); gguf_fd = -1; return -6 }
    // Checked dimension products: a crafted shape whose product wraps must not
    // produce a small element count that passes every size check.
    let dr = gguf_validate_all_dims()
    if dr != 0 { close(fd); gguf_fd = -1; return -7 }
    return 0
}

// Alignment used for the tensor DATA section. Read from the
// general.alignment metadata key; defaults to 32 when absent, which is what
// upstream does (GGUF_DEFAULT_ALIGNMENT).
let gguf_alignment = 32

// Validate the tensor data section after read_tensor_info() has filled it.
//
// Upstream llama.cpp rejects the file outright if any tensor's offset differs
// from the running padded total (gguf.cpp, the "tensor '%s' has offset %llu,
// expected %zu" check). We enforce the same chain, plus a representability
// check on each tensor's byte size.
//
// MEASURED ON THE REAL MODEL before writing this, because a naive port would
// have rejected a valid file: the chain is NOT anchored at 0. The first tensor
// sits at the data-section origin (gguf_data_start = 8239136 for the real
// LFM2 Q4_K_M file), and every later tensor chains exactly from there. Starting
// the running total at 0 instead of at gguf_data_start yields exactly one
// spurious "gap" at index 0 (delta 8239136) and would have made gguf_load fail
// on every well-formed file. So: running total starts at the data origin.
//
// A real gap (offset beyond where the previous tensor ended) means the file is
// internally inconsistent and tensor reads could land on unrelated bytes, so
// we reject. Overlap is likewise rejected: two tensors sharing bytes would
// decode to different values depending on read order.
//
// Return 0 on success, or a negative code identifying the first offending
// tensor so a caller can report which one.
fn gguf_validate_chain() {
    if gguf_n_tensors <= 0 { return 0 }
    let n = gguf_n_tensors
    // running total, ABSOLUTE file offset.
    //
    // gguf_tensor_offset() already adds gguf_data_offset() (see its definition:
    // it returns gguf_data_offset() + the stored relative offset), so the chain
    // must start at the data-section origin, NOT at 0. An earlier version of
    // this validator started at 0 and compared against absolute offsets, which
    // reported a spurious gap of 8239136 at tensor 0 and made gguf_load REJECT
    // the real, valid model. Measured, not assumed.
    let running = gguf_data_start
    let i = 0
    while i < n {
        let off = gguf_tensor_offset(i)
        let nb = gguf_tensor_nbytes(i)
        if nb < 0 { return -1000 - i }
        if off < 0 { return -2000 - i }
        // the chain must be exact: no gap, no overlap
        if off != running { return -3000 - i }
        // representability: running + nb must not wrap, and must stay inside
        // the file. nb is derived from nelements * type_size with integer
        // multiply, so this is the guard against a crafted nelem/dtype pair.
        // running and off are absolute; compare against the real file size
        if off > gguf_filesize { return -4000 - i }
        if nb > gguf_filesize - off { return -4000 - i }
        running = running + nb
        i = i + 1
    }
    return 0
}

// Validate that the declared alignment is usable, and adopt it.
fn gguf_read_alignment() {
    let k = gguf_kv_find("general.alignment")
    if k < 0 { gguf_alignment = 32 ; return 0 }
    let v = gguf_kv_int(k)
    if v <= 0 { return -1 }
    // power of two, as upstream requires
    if (v & (v - 1)) != 0 { return -1 }
    gguf_alignment = v
    return 0
}

// Safe multiply: return 0 (and report overflow) if a * b would exceed `limit`.
//
// GGUF dims come from an untrusted file, so the element count is a product of up
// to 4 attacker-chosen dimensions. safetensors makes the same guard mandatory
// (every dimension product is a checked_mul) precisely because a wrapped product
// yields a SMALL number that then passes every size check while the real read
// runs far past the end of the buffer. Quanta's nbytes used a plain multiply,
// so a crafted shape could make a tensor claim to be tiny while its true extent
// was enormous.
//
// Returns the product, or -1 on overflow. `limit` is the largest product we are
// willing to accept; GGUF files legitimately reach ~2.6e8 elements
// (token_embd.weight = 262144000), so the limit is generous but finite.
const GGUF_MAX_ELEMENTS = 900000000000000000

fn gguf_checked_mul(a, b) {
    if a <= 0 || b <= 0 { return -1 }
    if a > GGUF_MAX_ELEMENTS || b > GGUF_MAX_ELEMENTS { return -1 }
    let t = a * b
    if t <= 0 { return -1 }
    if t > GGUF_MAX_ELEMENTS { return -1 }
    return t
}

// Recompute a tensor's element count from its dimensions with checked
// multiplication, and require it to agree with the stored nelements.
//
// Two separate attacks are covered:
//   - dims whose product OVERFLOWS, so the stored nelements is small and every
//     downstream size check passes while the true extent is huge
//   - dims that simply DISAGREE with the stored nelements, which means the file
//     is internally inconsistent
//
// Returns 0 if consistent, or a negative code.
fn gguf_validate_dims(idx) {
    if idx < 0 || idx >= gguf_n_tensors { return -1000 }
    let nd = gguf_tensor_ndims(idx)
    if nd <= 0 || nd > 4 { return -1001 - idx }
    let prod = 1
    let d = 0
    while d < nd {
        let v = gguf_tensor_dim(idx, d)
        if v <= 0 { return -1002 - idx }
        let c = gguf_checked_mul(prod, v)
        if c < 0 { return -1003 - idx }
        prod = c
        d = d + 1
    }
    if prod != gguf_tensor_nelements(idx) { return -1004 - idx }
    // the byte size must also be representable and must fit the file
    let nb = gguf_tensor_nbytes(idx)
    if nb <= 0 { return -1005 - idx }
    if nb > gguf_filesize { return -1006 - idx }
    return 0
}

// Validate every tensor's dimensions. Returns 0, or -(3000+idx) for the first
// tensor that fails, so a caller can name the offender.
fn gguf_validate_all_dims() {
    let i = 0
    while i < gguf_n_tensors {
        let r = gguf_validate_dims(i)
        if r != 0 { return r - 3000 }
        i = i + 1
    }
    return 0
}

// ===========================================================================
// BIT-WIDTH ACCESSORS
//
// Needed for the HuggingFace quantization formats (GPTQ, AWQ, NF4, MLX), which
// pack 2-8 bits per element. Every dtype above is a whole number of BYTES per
// block, which is why gguf_tensor_nbytes() is already correct for all 35 of them
// -- verified against ggml's own struct sizes by
// scripts/audit/check_dtype_sizes.py, which reports 0 mismatches.
//
// That verification is what makes this additive rather than a fix: the GGUF path
// needs nothing changed. These accessors are for formats that pack below a byte.
//
// bit_at(p, i): value of bit i (0 = LEAST significant) of the byte at p.
// MSB/LSB first: GGUF and safetensors pack low bits first within a byte, while
// GPTQ's qweight packs the LOW nibble first per int32. Read bit 0 = LSB so the
// caller chooses the convention; getting this backwards transposes every value
// in a quantized tensor without erroring.
fn gguf_bit_at(p, i) {
    if i < 0 || i > 7 { return 0 }
    let b = mem_load8(p)
    return (b >> i) & 1
}

// Extract `nbits` bits starting at bit `start` from the byte at p, as an
// unsigned integer. Handles a field that straddles two bytes, which 3-, 5- and
// 6-bit MLX packings require -- a bytes-per-element model cannot express those
// at all, because 3 bits/element does not land on a byte boundary.
fn gguf_bits_extract(p, start, nbits) {
    if nbits <= 0 { return 0 }
    if nbits > 32 { return 0 }
    if start < 0 { return 0 }
    let acc = 0
    let i = 0
    while i < nbits {
        let src = p + (start + i) / 8
        let bit = (start + i) % 8
        let avail = 8 - bit
        let take = nbits - i
        if take > avail { take = avail }
        // read `take` bits starting at `bit`, LSB-first
        let chunk = 0
        let j = 0
        while j < take {
            chunk = chunk | (gguf_bit_at(src, bit + j) << j)
            j = j + 1
        }
        acc = acc | (chunk << i)
        i = i + take
    }
    return acc
}

// Byte offset and bit offset of element `idx` for a `bits`-per-element packing.
// Returns the byte address; the caller then uses gguf_bits_extract with the bit
// offset. Kept as two accessors because the address alone is not enough for a
// sub-byte type -- the single most common way to read these wrongly is to treat
// the bit offset as part of the address and then read whole bytes.
fn gguf_packed_byte(p, idx, bits) {
    if bits <= 0 { return p }
    return p + (idx * bits) / 8
}

fn gguf_packed_bit(p, idx, bits) {
    if bits <= 0 { return 0 }
    return (idx * bits) % 8
}

// Read element `idx` of a `bits`-per-element packing, sign-extended for a signed
// format (signed_widths != 0). GPTQ and AWQ store signed 4-bit values; NF4 and
// MLX affine store unsigned. Getting the signedness wrong yields plausible but
// wrong weights -- the same class of error as dequantizing an AWQ zero-point by
// ADDING it when the file never stored one.
fn gguf_packed_read(p, idx, bits, signed_widths) {
    if bits <= 0 || bits > 32 { return 0 }
    let byteaddr = gguf_packed_byte(p, idx, bits)
    let bitoff = gguf_packed_bit(p, idx, bits)
    let raw = gguf_bits_extract(byteaddr, bitoff, bits)
    if signed_widths != 0 {
        // sign-extend from `bits`
        let sgn = 1 << (bits - 1)
        if (raw & sgn) != 0 { return raw - (1 << bits) }
    }
    return raw
}

fn gguf_tensor_name(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE) }
// Materialise a tensor's name as a real Quanta string object.
//
// gguf_tensor_name() returns the RAW C pointer into the mmap'd header region.
// It is usable for byte comparison (that is how gguf_find_tensor works) but not
// for anything else: printing it emits the address ("name@140353555505152") and
// the pointer is not length-prefixed, so len()/str operations read whatever
// 8 bytes precede it. The weight table needs real strings to key on.
//
// The string object layout is [i64 length][bytes...], matching str::substr and
// the emitter's str() builtin. The GGUF name is NUL-terminated, so the length is
// found by scanning for the terminator rather than stored anywhere.
fn gguf_tensor_name_str(idx) {
    let p = gguf_tensor_name(idx)
    if p == 0 { return 0 }
    let n = 0
    while mem_load8(p + n) != 0 { n = n + 1 }
    if n == 0 { return 0 }
    let buf = mem_alloc((n + 9 + 7) / 8)
    mem_store(buf, n)
    let i = 0
    while i < n {
        mem_store8(buf + 8 + i, mem_load8(p + i))
        i = i + 1
    }
    return buf
}

// Number of bytes in a tensor's name, excluding the NUL terminator. This is a
// length, not a string, so it is safe to call from a context where a string
// cannot be passed around.
fn gguf_tensor_name_len(idx) {
    let p = gguf_tensor_name(idx)
    if p == 0 { return 0 }
    let n = 0
    while mem_load8(p + n) != 0 { n = n + 1 }
    return n
}

fn gguf_tensor_dtype(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 16) }
// Absolute file offset of a tensor's data. The GGUF header stores each
// tensor's offset RELATIVE to the start of the tensor-data section, so
// callers seeking to a tensor must add gguf_data_offset() or they land at
// file offset 0 -- the magic bytes -- and dequantize reads garbage.
fn gguf_tensor_offset(idx) {
    return gguf_data_offset() + mem_load(gguf_tensor_data + idx * TINFO_SIZE + 24) }
fn gguf_tensor_nelements(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 32) }
fn gguf_tensor_ndims(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 8) }
fn gguf_tensor_dim(idx, d) {
    if d < 0 || d > 3 { return 0 }
    return mem_load(gguf_tensor_dims + idx * 32 + d * 8)
}

// Byte size of a tensor's raw storage, from its dtype and element count.
fn gguf_type_size(dtype) {
    if dtype == 0 || dtype == 1 || dtype == 7 { return 1 }
    if dtype == 2 || dtype == 3 { return 2 }
    if dtype == 6 || dtype == 8 || dtype == 9 || dtype == 30 { return 1 }
    if dtype == 10 || dtype == 11 || dtype == 12 { return 8 }
    if dtype == 13 { return 4 }
    return 0
}

// Byte size of a quantised tensor, from the GGML block layouts.
//
// Every quantised type is (elements_per_block, bytes_per_block); the size is
// (nelements / elems_per_block) * bytes_per_block. This used to return the
// ELEMENT COUNT for the k-quants, so Q4_K (dtype 12) reported 22020096 for
// blk.0.ffn_gate.weight instead of 12386304 -- a tensor then read as f32 would
// run 1.8x past the end of its own storage.
//
// Every (bytes, block) pair below is derived from the static_assert in upstream
// ggml-common.h, which states each block's own size:
//
//   type                       elems  bytes
//   F32   (0)                    1      4
//   F16   (1)                    1      2
//   Q4_0  (2) / Q4_1  (3)       32    18 / 20
//   Q5_0  (6) / Q5_1  (7)       32    22 / 24
//   Q8_0  (8) / Q8_1  (9)       32    34 / 36
//   Q2_K (10) / Q3_K (11)      256    84 / 110
//   Q4_K (12) / Q5_K (13)      256   144 / 176
//   Q6_K (14) / Q8_K (15)      256   210 / 292
//   IQ2_XXS(16) / IQ2_XS (17)  256    66 / 74
//   IQ3_XXS(18) / IQ1_S  (19)  256    98 / 50
//   IQ4_NL(20)                  32     18   <- 32-element block, not 256
//   IQ3_S (21) / IQ2_S (22)     256   110 /  82
//   IQ4_XS(23)                  256   136
//   I8(24) I16(25) I32(26) I64(27) F64(28)   1  1/2/4/8/8
//   IQ1_M(29)                   256    56
//   BF16 (30)                     1      2   <- 2 bytes/elem, not a 256 block
//   TQ1_0(34) / TQ2_0(35)       256    54 / 66
//   MXFP4(39)                    32     17
//   NVFP4(40)                    64     36
//   Q1_0 (41) / Q2_0 (42)       128/64 18 / 18
//
// IQ4_NL, IQ2_S and IQ4_XS previously carried Q4_K/Q4_1/Q4_K's numbers, and
// IQ3_S and IQ1_M were short. That made the loader's total tensor-data footprint
// overrun the file by 2.50 GB on QUANTA-GG4-26B4-IQ4.gguf and 2.87 GB on
// QUANTA-GW38-27B-IQ4.gguf, silently reading unrelated bytes as weights. The
// corrected table brings both files into the same ~15 MB of metadata padding as
// every other model on the box.
fn gguf_tensor_nbytes(idx) {
    let dtype = gguf_tensor_dtype(idx)
    let n = gguf_tensor_nelements(idx)
    if dtype == 0 { return n * 4 }        // F32
    if dtype == 1 { return n * 2 }        // F16
    if dtype == 2 { return (n / 32) * 18 }   // Q4_0
    if dtype == 3 { return (n / 32) * 20 }   // Q4_1
    if dtype == 6 { return (n / 32) * 22 }   // Q5_0
    if dtype == 7 { return (n / 32) * 24 }   // Q5_1
    if dtype == 8 { return (n / 32) * 34 }   // Q8_0
    if dtype == 9 { return (n / 32) * 36 }   // Q8_1
    if dtype == 10 { return (n / 256) * 84 }   // Q2_K
    if dtype == 11 { return (n / 256) * 110 }  // Q3_K
    if dtype == 12 { return (n / 256) * 144 }  // Q4_K
    if dtype == 13 { return (n / 256) * 176 }  // Q5_K
    if dtype == 14 { return (n / 256) * 210 }  // Q6_K
    if dtype == 15 { return (n / 256) * 292 }  // Q8_K
    if dtype == 16 { return (n / 256) * 66 }   // IQ2_XXS
    if dtype == 17 { return (n / 256) * 74 }   // IQ2_XS
    if dtype == 18 { return (n / 256) * 98 }   // IQ3_XXS
    if dtype == 19 { return (n / 256) * 50 }   // IQ1_S
    if dtype == 20 { return (n / 32) * 18 }    // IQ4_NL  (QK4_NL=32, NOT 256)
    if dtype == 21 { return (n / 256) * 110 }  // IQ3_S
    if dtype == 22 { return (n / 256) * 82 }   // IQ2_S
    if dtype == 23 { return (n / 256) * 136 }  // IQ4_XS
    if dtype == 24 { return n }                 // I8
    if dtype == 25 { return n * 2 }             // I16
    if dtype == 26 { return n * 4 }             // I32
    if dtype == 27 { return n * 8 }             // I64
    if dtype == 28 { return n * 8 }             // F64
    if dtype == 29 { return (n / 256) * 56 }    // IQ1_M
    if dtype == 30 { return n * 2 }             // BF16  (2 bytes/elem, NOT a 256 block)
    if dtype == 34 { return (n / 256) * 54 }    // TQ1_0
    if dtype == 35 { return (n / 256) * 66 }    // TQ2_0
    if dtype == 39 { return (n / 32) * 17 }     // MXFP4  (QK_MXFP4=32)
    if dtype == 40 { return (n / 64) * 36 }     // NVFP4  (QK_NVFP4=64, 4 E4M3 scales)
    if dtype == 41 { return (n / 128) * 18 }    // Q1_0    (QK1_0=128)
    if dtype == 42 { return (n / 64) * 18 }     // Q2_0    (QK2_0=64)
    return n
}

// Read `nbytes` of a tensor's RAW (still quantised) storage into `buf`.
// Tensor offsets in GGUF are relative to the start of the aligned tensor
// data section, so the file position must include gguf_data_start.
fn gguf_read_tensor_bytes(idx, buf, nbytes) {
    if idx < 0 || idx >= gguf_n_tensors { return -1 }
    // gguf_tensor_offset() already returns an ABSOLUTE file offset (it adds
    // gguf_data_start itself). Adding it again here seeked 8239136 bytes past
    // the tensor, so every tensor read returned unrelated file data instead of
    // failing.
    let abs_pos = gguf_tensor_offset(idx)
    // Bound against the tensor's own size and against EOF, same as
    // gguf_read_tensor_bytes_at(). Returns a byte count, so a short read at EOF
    // is detectable by the caller.
    if nbytes < 0 { return -3 }
    let tsz = gguf_tensor_nbytes(idx)
    if nbytes > tsz { return -3 }
    if abs_pos > gguf_filesize { return -5 }
    if nbytes > gguf_filesize - abs_pos { return -5 }
    if lseek(gguf_fd, abs_pos, 0) < 0 { return -2 }
    return read_raw(gguf_fd, buf, nbytes)
}

fn gguf_num_tensors() { return gguf_n_tensors }
fn gguf_num_kv() { return gguf_n_kv }
fn gguf_data_offset() { return gguf_data_start }
fn gguf_close() { if gguf_fd >= 0 { close(gguf_fd); gguf_fd = -1 } }

// ---- metadata value access -------------------------------------------------
//
// The tensor APIs can name and read tensors but nothing could reach a metadata
// VALUE: scan_metadata() only ever skipped over them. The LFM2 tokenizer needs
// tokenizer.ggml.tokens (128000 strings), tokenizer.ggml.merges (293320
// strings) and the three special token IDs, so the offsets recorded by
// scan_metadata() are turned into reads here.
//
// These accessors are for the header region only. The file is opened normally
// and read with read_raw(); nothing here materialises the tensor data, so a
// 2.6B model costs a few KB of state, not its 1.5 GB of weights.

// Index of the KV record named `name`, or -1. `name` is a Quanta string.
fn gguf_kv_find(name) {
    let want = len(name)
    let i = 0
    while i < gguf_n_kv {
        lseek(gguf_fd, mem_load(gguf_kv_index + i * 8), 0)
        let lb = mem_alloc(8)
        read_raw(gguf_fd, lb, 8)
        let klen = mem_load(lb)
        let kb = mem_alloc(klen + 1)
        read_raw(gguf_fd, kb, klen)
        let ok = 1
        if klen != want {
            ok = 0
        } else {
            let j = 0
            while j < want {
                if mem_load8(kb + j) != mem_load8(name + 8 + j) { ok = 0; j = want }
                j = j + 1
            }
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

// Value type ID of KV `i` (see gguf_vtype_* below).
fn gguf_kv_type(i) {
    lseek(gguf_fd, mem_load(gguf_kv_index + i * 8), 0)
    let lb = mem_alloc(8)
    read_raw(gguf_fd, lb, 8)
    let klen = mem_load(lb)
    lseek(gguf_fd, klen, 1)
    let tb = mem_alloc(4)
    read_raw(gguf_fd, tb, 4)
    return mem_load(tb)
}

// Byte offset of the VALUE of KV `i` (i.e. just past its key and type field).
fn gguf_kv_value_off(i) {
    let off = mem_load(gguf_kv_index + i * 8)
    lseek(gguf_fd, off, 0)
    let lb = mem_alloc(8)
    read_raw(gguf_fd, lb, 8)
    let klen = mem_load(lb)
    return off + 8 + klen + 4
}

// Integer value of a scalar u32/i32/u64/i64 KV. Returns -1 if `i` is not a
// scalar integer, so a type mismatch cannot be mistaken for a real value.
fn gguf_kv_int(i) {
    let vt = gguf_kv_type(i)
    lseek(gguf_fd, gguf_kv_value_off(i), 0)
    let b = mem_alloc(8)
    if vt == 1 || vt == 2 || vt == 3 || vt == 4 || vt == 5 {
        read_raw(gguf_fd, b, 4)
        if vt == 1 || vt == 3 || vt == 5 {
            // signed: sign-extend from 32 bits
            let v = mem_load(b)
            if v > 2147483647 { v = v - 4294967296 }
            return v
        }
        return mem_load(b)
    }
    if vt == 7 { read_raw(gguf_fd, b, 1); return mem_load8(b) }
    if vt == 10 || vt == 11 || vt == 12 {
        read_raw(gguf_fd, b, 8)
        return mem_load(b)
    }
    return -1
}

// Floating value of a scalar f32/f64 KV, as f64.
fn gguf_kv_float(i) {
    let vt = gguf_kv_type(i)
    lseek(gguf_fd, gguf_kv_value_off(i), 0)
    let b = mem_alloc(8)
    if vt == 6 {
        read_raw(gguf_fd, b, 4)
        // f32 -> f64 must go through f32_to_f64(), which reinterprets the 4 bytes
        // as an IEEE single and produces a real double.
        //
        // This used to be f64of(mem_load(b)), which reinterprets the FOUR bytes
        // as the low half of an f64 bit pattern. That is not a valid f64: a
        // zero-extended f32 pattern denormalises to ~1e-315, so every f32
        // metadata value read 0 or a denormal. LFM2's rope.freq_base (1e7) and
        // layer_norm_rms_epsilon (1e-5) both came back as 0.0.
        return f32_to_f64(b)
    }
    if vt == 12 {
        read_raw(gguf_fd, b, 8)
        return mem_load(b)
    }
    return 0.0
}

// String value of a scalar string KV, as a real Quanta string.
// GGUF stores a string as u64 length + raw bytes, with NO NUL terminator.
fn gguf_kv_str(i) {
    if gguf_kv_type(i) != 8 { return 0 }
    let off = gguf_kv_value_off(i)
    lseek(gguf_fd, off, 0)
    let lb = mem_alloc(8)
    read_raw(gguf_fd, lb, 8)
    let n = mem_load(lb)
    let buf = mem_alloc((n + 9 + 7) / 8)
    mem_store(buf, n)
    if n > 0 { read_raw(gguf_fd, buf + 8, n) }
    return buf
}

// Byte length of a scalar string KV, or -1 if `i` is not a string.
// Prefer this over len(gguf_kv_str(i)) at a call site: a Quanta string RETURNED
// from a function prints as a raw pointer, and passing one back IN as a
// parameter is unreliable (len()/index of a string parameter reads adjacent
// memory). Working with explicit length + buffer keeps every access byte-exact.
fn gguf_kv_str_len(i) {
    if gguf_kv_type(i) != 8 { return -1 }
    lseek(gguf_fd, gguf_kv_value_off(i), 0)
    let lb = mem_alloc(8)
    read_raw(gguf_fd, lb, 8)
    return mem_load(lb)
}

// Copy the bytes of scalar string KV `i` into `dst`. Returns the byte count.
fn gguf_kv_str_bytes(i, dst) {
    let n = gguf_kv_str_len(i)
    if n < 0 { return -1 }
    lseek(gguf_fd, gguf_kv_value_off(i) + 8, 0)
    if n > 0 { read_raw(gguf_fd, dst, n) }
    return n
}

// Element count of a string array KV, or -1 if `i` is not a string array.
fn gguf_kv_arr_count(i) {
    if mem_load(gguf_kv_arr_len + i * 8) == 0 { return -1 }
    if mem_load(gguf_kv_etype + i * 8) != 8 { return -1 }
    return mem_load(gguf_kv_arr_len + i * 8)
}

// Element count of ANY array KV, string or numeric. -1 only if the entry is not
// an array at all (length 0).
//
// gguf_kv_arr_count() above deliberately rejects numeric arrays, because every
// caller of it walks LENGTH-PREFIXED elements and would read nonsense on an i32
// array. That guard is correct for them and must stay. Numeric arrays need their
// own accessor: LFM2's lfm2.attention.head_count_kv is an i32 array of 30
// per-layer KV head counts, and reading it needed count, element type and data
// offset without the string precondition.
fn gguf_kv_arr_count_any(i) {
    let n = mem_load(gguf_kv_arr_len + i * 8)
    if n <= 0 { return -1 }
    return n
}

// Element type of array KV `i`: 5 = i32, 12 = f64, 8 = string. -1 if not an array.
fn gguf_kv_arr_etype(i) {
    if mem_load(gguf_kv_arr_len + i * 8) <= 0 { return -1 }
    return mem_load(gguf_kv_etype + i * 8)
}

// Bytes per element of a numeric array, from its element type.
fn gguf_kv_arr_esize(i) {
    let et = gguf_kv_arr_etype(i)
    if et == 0 || et == 1 || et == 7 { return 1 }
    if et == 2 || et == 3 { return 2 }
    if et == 4 || et == 5 || et == 6 { return 4 }
    if et == 10 || et == 11 || et == 12 { return 8 }
    return 0
}

// Read `idx` of a numeric array into `dst` as its raw little-endian bytes.
// Returns the element size, or -1 if the array is a string array or the read is
// short. Use mem_load(dst) to decode an i32, f32_bits_to_f64-style helpers for a
// float -- this deliberately does not interpret the value.
fn gguf_kv_arr_elem_num(i, idx, dst) {
    let es = gguf_kv_arr_esize(i)
    if es <= 0 { return -1 }
    let cnt = gguf_kv_arr_count_any(i)
    if idx < 0 || idx >= cnt { return -1 }
    let pos = mem_load(gguf_kv_arr_off + i * 8)
    if pos < 0 { return -1 }
    lseek(gguf_fd, pos + idx * es, 0)
    if read_raw(gguf_fd, dst, es) != es { return -1 }
    return es
}

// File offset of element `idx` of the string array in KV `i`.
//
// Walks the variable-length elements from the start every call, so this is
// O(idx). That is deliberate: the tokenizer reads each array front to back
// exactly once, and a persistent offset index for 293320 merges would cost
// 2.3 MB of resident state for a single pass. Callers that need random access
// should build their own index once.
fn gguf_kv_arr_elem_off(i, idx) {
    let pos = mem_load(gguf_kv_arr_off + i * 8)
    if pos < 0 { return -1 }
    let lb = mem_alloc(8)
    let k = 0
    while k < idx {
        lseek(gguf_fd, pos, 0)
        read_raw(gguf_fd, lb, 8)
        let n = mem_load(lb)
        pos = pos + 8 + n
        k = k + 1
    }
    lseek(gguf_fd, pos, 0)
    read_raw(gguf_fd, lb, 8)
    return pos + 8
}

// Length in bytes of element `idx` of the string array in KV `i`.
fn gguf_kv_arr_elem_len(i, idx) {
    let at = gguf_kv_arr_elem_off(i, idx)
    if at < 0 { return 0 }
    lseek(gguf_fd, at - 8, 0)
    let lb = mem_alloc(8)
    read_raw(gguf_fd, lb, 8)
    return mem_load(lb)
}

// Element `idx` of a string array KV, as a real Quanta string.
fn gguf_kv_arr_elem(i, idx) {
    let at = gguf_kv_arr_elem_off(i, idx)
    if at < 0 { return 0 }
    let n = gguf_kv_arr_elem_len(i, idx)
    if n == 0 { return 0 }
    let buf = mem_alloc((n + 9 + 7) / 8)
    mem_store(buf, n)
    read_raw(gguf_fd, buf + 8, n)
    return buf
}

// Read `n` raw bytes of element `idx` into `dst`. Used by the tokenizer, which
// compares byte-level encoded forms against the vocab and must not pay for a
// string object per candidate.
fn gguf_kv_arr_elem_bytes(i, idx, dst, n) {
    let at = gguf_kv_arr_elem_off(i, idx)
    if at < 0 { return -1 }
    lseek(gguf_fd, at, 0)
    read_raw(gguf_fd, dst, n)
    return n
}

// Total bytes of all elements in a string array KV, so a caller can size one
// buffer for the whole array and slurp it in a single sequential read.
//
// Single pass by construction: it seeks to the array start once and then reads
// forward through the 8-byte length / n-byte payload sequence, rather than
// calling gguf_kv_arr_elem_off() per element (which would be O(n^2) over
// 293320 merges).
fn gguf_kv_arr_total_bytes(i) {
    let cnt = gguf_kv_arr_count(i)
    if cnt < 0 { return 0 }
    let pos = mem_load(gguf_kv_arr_off + i * 8)
    if pos < 0 { return 0 }
    lseek(gguf_fd, pos, 0)
    let lb = mem_alloc(8)
    let total = 0
    let k = 0
    while k < cnt {
        read_raw(gguf_fd, lb, 8)
        let n = mem_load(lb)
        if n > 0 { lseek(gguf_fd, n, 1) }
        // The 8-byte length prefix is part of the packed record, so it counts
        // toward the size. Omitting it under-reports by exactly 8*count, which
        // for the 128000-entry vocab is a 1.02 MB shortfall -- enough to
        // overrun the destination on the last few entries.
        total = total + 8 + n
        k = k + 1
    }
    return total
}

// Slurp a whole string array KV into `dst` as a packed sequence of
// [u64 length][length bytes] records, in file order -- the same encoding
// gguf_kv_arr_elem_off() describes, so the two can be used interchangeably.
//
// Returns the number of bytes written. The tokenizer does exactly this once for
// tokenizer.ggml.tokens and once for tokenizer.ggml.merges, then works from
// memory: the merges array is ~5 MB and searching it per BPE step from the
// file would dominate the run.
fn gguf_kv_arr_slurp(i, dst) {
    let cnt = gguf_kv_arr_count(i)
    if cnt < 0 { return 0 }
    let pos = mem_load(gguf_kv_arr_off + i * 8)
    if pos < 0 { return 0 }
    lseek(gguf_fd, pos, 0)
    let lb = mem_alloc(8)
    let at = dst
    let k = 0
    while k < cnt {
        read_raw(gguf_fd, lb, 8)
        let n = mem_load(lb)
        mem_store(at, n)
        if n > 0 { read_raw(gguf_fd, at + 8, n) }
        at = at + 8 + n
        k = k + 1
    }
    return at - dst
}

// Offset of element `idx` within a buffer packed by gguf_kv_arr_slurp().
// Walks the packed records, so O(idx) -- callers that need many random lookups
// should build their own index in one pass.
fn slurp_elem_off(packed, idx) {
    let at = packed
    let k = 0
    while k < idx {
        let n = mem_load(at)
        at = at + 8 + n
        k = k + 1
    }
    return at + 8
}

fn gguf_find_tensor(name) {
    let name_len = len(name)
    let i = 0
    while i < gguf_n_tensors {
        let tname = gguf_tensor_name(i)
        if tname != 0 {
            let ok = 1
            let j = 0
            while j < name_len {
                if mem_load8(tname + j) != mem_load8(name + 8 + j) { ok = 0; j = name_len }
                j = j + 1
            }
            if ok == 1 && mem_load8(tname + name_len) == 0 { return i }
        }
        i = i + 1
    }
    return -1
}

// Read tensor `idx` of ANY supported dtype into `buf` as f64.
//     buf layout: nelem * 8 bytes, little-endian IEEE 754 binary64.
//
// Dispatch is on the GGML type ID, NOT on gguf_type_size(). The two disagree:
// gguf_type_size() returns 1 for type 0 (F32) and for type 1 (F16), because it
// describes the QUANTISED types' per-element granularity for block layouts. Using
// it as a dtype test is a category error, and the earlier version of this
// function dispatched on it and so matched NEITHER F32 (0) nor F16 (1) -- it
// fell through every branch and returned having loaded nothing, silently.
//
// Returning 0 on an unsupported type is deliberate: an unsupported dtype must
// fail explicitly, not substitute another format's bytes for this one.
// TRUE when read_tensor_f64() can materialize this dtype into caller-provided
// f64 storage.
//
// Callers MUST ask this before allocating. read_tensor_f64() reports failure by
// returning 0, but the buffer it fills is sized by the caller from
// gguf_tensor_nelements(), and an unimplemented dtype still demands the FULL
// allocation before the refusal is discovered -- token_embd.weight at 1.27e9
// elements is 10.2 GB of f64 for a tensor that cannot be read at all, which
// blows the 6 GB inference scope before any error is reported.
fn gguf_dtype_supported(dtype) {
    if dtype == 0 { return 1 }   // F32
    if dtype == 1 { return 1 }   // F16
    if dtype == 2 { return 1 }   // Q4_0
    if dtype == 8 { return 1 }   // Q8_0
    if dtype == 12 { return 1 }  // Q4_K
    if dtype == 13 { return 1 }  // Q5_K
    if dtype == 14 { return 1 }  // Q6_K
    if dtype == 3 { return 1 }   // Q4_1
    if dtype == 6 { return 1 }   // Q5_0
    if dtype == 7 { return 1 }   // Q5_1
    if dtype == 10 { return 1 }  // Q2_K
    if dtype == 11 { return 1 }  // Q3_K
    if dtype == 15 { return 1 }  // Q8_K
    if dtype == 30 { return 1 }  // BF16
    // NOTE: Q8_1 (9) is deliberately ABSENT and must stay absent. It is not a
    // row-storage format -- upstream exports no dequantize_row_q8_1 because it
    // has no per-element meaning. Its qs[] bytes are only ever consumed as int8
    // multipliers inside vec_dot, paired with a matching weight block. A
    // "dequantizer" for it would have to invent semantics, and an earlier
    // hand-written deq_q8_1 did exactly that. Supporting Q8_1 means a matvec
    // kernel, not a dequant function.
    return 0
}

// TRUE when this tensor's dtype can be materialized natively.
fn gguf_tensor_supported(idx) {
    return gguf_dtype_supported(gguf_tensor_dtype(idx))
}

// read_block_f64(dtype, raw, nelem, out): dequantize a RAW block buffer that the
// caller already has in memory, without a GGUF file in the picture.
//
// Split out from read_tensor_f64() so fixture-based tests (and any future
// direct kernel use) can hand over bytes and get f64 out, instead of the only
// entry point being "point me at a tensor in a model on disk". Both share the
// same dispatch table below, so a dtype cannot be supported in one and missing
// in the other.
//
// `raw` must hold exactly gguf_nbytes(dtype, nelem) bytes.
fn read_block_f64(dtype, raw, nelem, out) {
    if gguf_dtype_supported(dtype) == 0 { return 0 }
    if dtype == 0 {
        dequant_f32(raw, nelem, out)
    } else if dtype == 1 {
        dequant_f16(raw, nelem, out)
    } else if dtype == 12 {
        dequant_q4k(raw, nelem, out)
    } else if dtype == 13 {
        dequant_q5k(raw, nelem, out)
    } else if dtype == 14 {
        dequant_q6k(raw, nelem, out)
    } else if dtype == 8 {
        dequant_q8_0(raw, nelem, out)
    } else if dtype == 2 {
        dequant_q4_0(raw, nelem, out)
    } else if dtype == 30 {
        dequant_bf16(raw, nelem, out)
    } else if dtype == 3 {
        dequant_q4_1(raw, nelem, out)
    } else if dtype == 6 {
        dequant_q5_0(raw, nelem, out)
    } else if dtype == 7 {
        dequant_q5_1(raw, nelem, out)
    } else if dtype == 10 {
        dequant_q2k(raw, nelem, out)
    } else if dtype == 11 {
        dequant_q3k(raw, nelem, out)
    } else if dtype == 15 {
        dequant_q8k(raw, nelem, out)
    } else {
        return 0
    }
    return 1
}

fn read_tensor_f64(idx, buf) {
    if gguf_dtype_supported(gguf_tensor_dtype(idx)) == 0 { return 0 }
    let dtype = gguf_tensor_dtype(idx)
    let offset = gguf_tensor_offset(idx)
    let nelem = gguf_tensor_nelements(idx)

    // gguf_tensor_offset() is ALREADY absolute -- it adds gguf_data_offset()
    // itself (see its definition and gguf_read_tensor_bytes). Adding the data
    // start a second time seeks 8239136 bytes past the tensor and reads
    // unrelated bytes, which is what produced the garbage first values here.
    // Do NOT add gguf_data_offset() to `offset`.
    if dtype == 0 {
        let n = nelem * 4
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_f32(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 1 {
        let n = nelem * 2
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_f16(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 12 {
        let n = gguf_tensor_nbytes(idx)
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_q4k(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 13 {
        let n = gguf_tensor_nbytes(idx)
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_q5k(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 14 {
        let n = gguf_tensor_nbytes(idx)
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_q6k(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 8 {
        let n = gguf_tensor_nbytes(idx)
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_q8_0(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 2 {
        let n = gguf_tensor_nbytes(idx)
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_q4_0(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 30 {
        let n = nelem * 2
        let raw = mem_alloc(n)
        lseek(gguf_fd, offset, 0)
        file_read(gguf_fd, raw, n)
        dequant_bf16(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 3 {
        dequant_q4_1(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 6 {
        dequant_q5_0(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 7 {
        dequant_q5_1(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 10 {
        dequant_q2k(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 11 {
        dequant_q3k(raw, nelem, buf)
        mem_free(raw)
    } else if dtype == 15 {
        dequant_q8k(raw, nelem, buf)
        mem_free(raw)
    } else {
        // Explicit failure. An unsupported dtype must NOT silently return 0,
        // which a caller cannot distinguish from "success, all zeroes".
        return 0
    }
    return 1
}

fn f32_to_f64(ptr) {
    let b0 = mem_load8(ptr)
    let b1 = mem_load8(ptr + 1)
    let b2 = mem_load8(ptr + 2)
    let b3 = mem_load8(ptr + 3)
    
    // f32 layout: sign = b3 bit 7; exp = b3 bits 0-6 | b2 bit 7;
    // mant = b2 bits 0-6 | b1 | b0.
    let sign = i2f(b3 / 128)
    let exp32 = i2f(b3 - (b3 / 128) * 128) * i2f(2) + i2f(b2 / 128)
    let mant32 = i2f(b2 - (b2 / 128) * 128) * i2f(65536) + i2f(b1) * i2f(256) + i2f(b0)
    
    let two = i2f(2)
    let one = i2f(1)
    let zero = i2f(0)
    
    if exp32 == zero {
        // exp == 0: signed zero, or a subnormal. This used to return 0 for
        // both, which silently discarded every subnormal weight. A subnormal
        // f32 has value mant32 * 2^-149, exactly representable in f64.
        if mant32 == zero {
            // Signed zero. This returned `fsub(zero, zero)`, but that is
            // +0.0 - +0.0 = +0.0 under round-to-nearest -- so every -0.0f32
            // weight came back as +0.0 and the sign bit was simply lost.
            // Negating the ZERO VARIABLE is what produces -0.0: 0.0 * -1.0 is
            // -0.0 exactly, because the sign is applied to the zero itself.
            if sign == one { return fmul(zero, i2f(0-1)) }
            return zero
        }
        let sub = one
        let si = 0
        while si < 149 { sub = fdiv(sub, two); si = si + 1 }
        let subv = fmul(mant32, sub)
        if sign == one { return fsub(zero, subv) }
        return subv
    }
    
    if exp32 == i2f(255) {
        // exp == 255: Inf when mant == 0, NaN otherwise. This used to return 0
        // for both, so an Inf or NaN weight became a zero weight.
        // 2^1023 is the largest finite f64, so one more doubling overflows to
        // exactly +Inf. Keep the loop to 1023 iterations -- a 1024-iteration
        // one kept doubling a value that was already Inf.
        let pinf = one
        let pi = 0
        while pi < 1023 { pinf = fmul(pinf, two); pi = pi + 1 }
        pinf = fmul(pinf, two)
        if mant32 != zero {
            // NaN: Inf - Inf is the canonical quiet NaN.
            return fsub(pinf, pinf)
        }
        if sign == one { return fsub(zero, pinf) }
        return pinf
    }
    
    let new_exp = f2i(exp32 - i2f(127))
    let mant_frac = fdiv(mant32, i2f(8388608))
    let one_plus_mant = fadd(one, mant_frac)
    
    let pow2 = one
    let i = 0
    if new_exp >= 0 {
        while i < new_exp { pow2 = fmul(pow2, two); i = i + 1 }
    } else {
        let neg = 0 - new_exp
        while i < neg { pow2 = fdiv(pow2, two); i = i + 1 }
    }
    
    let result = fmul(pow2, one_plus_mant)
    if sign == one { result = fsub(zero, result) }
    return result
}

// --------------------------------------------------------------- F32 (type 0)
//
// 99 of the 266 tensors in the reference model are F32 -- 37% of it -- and this
// was the only dtype with no decoder. The shapes are the small per-layer
// vectors, which is exactly why it went unnoticed: they are 1/260th the size of
// the weight matrices, so a run that only ever touched the k-quants looked
// complete.
//
//   token_embd_norm.weight   [2048]     x61
//   ...                      [3, 2048]  x22      per-layer, one row per norm kind
//   ...                      [64]       x16
//
// F32 has no quantisation: the bytes ARE the IEEE-754 values, so this is a
// widening f32 -> f64 over the whole buffer. f32_to_f64() is exact for normals,
// subnormals, zeros and both infinities (it was fixed for subnormals earlier);
// the widening is always exact because every f32 is representable in f64.
fn dequant_f32(raw, nelements, out) {
    let i = 0
    while i < nelements {
        mem_store(out + i * 8, f32_to_f64(raw + i * 4))
        i = i + 1
    }
}

// f16_to_f64(ptr): widen an IEEE 754 binary16 at `ptr` to binary64.
//
// Every binary16 is exactly representable in binary32 and binary64, so this is a
// widening with no rounding at all -- only exponent rebasing and a mantissa
// shift. Handles both zeros, subnormals, the normal range, and both infinities;
// NaN is produced as Inf - Inf, the canonical quiet NaN.
//
// Transcribed from ggml's GGML_FP16_TO_FP32, which in ggml-impl.h is POWER8
// inline assembly (mtfprd / xscvhpdp) and so cannot be used directly. Verified
// bit-for-bit against a compiled reference by scripts/audit/dequant_oracle.py.
// f16_to_f64(ptr): widen an IEEE 754 binary16 at `ptr` to binary64.
//
// Every binary16 is exactly representable in binary32 and binary64, so this is a
// widening with no rounding at all -- only exponent rebasing and a mantissa
// shift. Handles both zeros, subnormals, the normal range, both infinities; NaN
// is produced as Inf - Inf, the canonical quiet NaN.
//
// Bit layout, little-endian:
//
//   lo = bits 0..7   -> mantissa bits 0..7
//   hi = bits 8..15  -> mantissa bits 8..9, exponent bits 0..4, sign
//
// so exp = (hi >> 2) & 31 and mant = lo | ((hi & 3) << 8). The FIRST version of
// this function masked lo to SEVEN bits and read only hi bit 0 for the top of the
// mantissa, which is correct for neither: it lost the low 7 bits of every value's
// mantissa and one of its top bits. Verified bit-for-bit against a compiled
// reference by scripts/audit/dequant_diff.py.
//
// ggml's GGML_FP16_TO_FP32 is POWER8 inline assembly (mtfprd / xscvhpdp) in
// ggml-impl.h, so it cannot be used directly here.
fn f16_to_f64(ptr) {
    let lo = mem_load8(ptr)
    let hi = mem_load8(ptr + 1)

    let sign = hi / 128                                  // 0 or 1
    let hib = hi - sign * 128                            // bits 0..6 of hi
    let exp = hib / 4                                    // (hi >> 2) & 31
    let mant = lo + (hib - (hib / 4) * 4) * 256          // lo | ((hi & 3) << 8)

    let two = i2f(2)
    let one = i2f(1)
    let zero = i2f(0)

    if exp == 0 {
        if mant == 0 {
            // Signed zero. Negating the zero variable produces -0.0 exactly. The
            // sign is applied to the zero itself, not to a subtraction, because
            // 0.0 - 0.0 is +0.0 under round-to-nearest.
            if sign == 1 { return fmul(zero, i2f(0 - 1)) }
            return zero
        }
        // Subnormal: value = mant * 2^-24. Build the scale by repeated halving
        // and multiply the integer mantissa in. A plain (exp - 15) rebasing
        // returns 0 for every subnormal, which is a real defect class -- f32's
        // own converter had it and it silently discarded subnormal weights.
        let scale = one
        let i = 0
        while i < 24 { scale = fdiv(scale, two); i = i + 1 }
        let v = fmul(i2f(mant), scale)
        if sign == 1 { return fsub(zero, v) }
        return v
    }

    if exp == 31 {
        // Inf when mant == 0, NaN otherwise. 2^1023 is the largest finite f64, so
        // one more doubling overflows to exactly +Inf.
        let pinf = one
        let i = 0
        while i < 1023 { pinf = fmul(pinf, two); i = i + 1 }
        pinf = fmul(pinf, two)
        if mant != 0 {
            // Inf - Inf produces x87's "indefinite" value 0xC000000000000000,
            // which is a NEGATIVE quiet NaN -- so a positive input NaN came out
            // with its sign flipped. Build the NaN from its bits instead:
            // exponent all ones, quiet bit set, sign copied from the input. That
            // is deterministic and matches what a widening conversion owes the
            // caller (IEEE does not fix the payload, but it does fix the class
            // and the sign).
            let nanpat = 9221120237041090560    // 0x7FF8000000000000, quiet NaN
            if sign == 1 { return f64of(0 - nanpat) }
            return f64of(nanpat)
        }
        if sign == 1 { return fsub(zero, pinf) }
        return pinf
    }

    // Normal: value = (1 + mant/1024) * 2^(exp - 15). Since f16 and f64 share a
    // biased-exponent convention with the same bias offset relationship here,
    // the exponent shift is exp - 15 + 1023 applied to the f64 exponent field;
    // done here by multiplying out a power of two, which is exact.
    let leading = fadd(one, fdiv(i2f(mant), i2f(1024)))
    let e = exp - 15
    let pow2 = one
    let i = 0
    if e >= 0 {
        while i < e { pow2 = fmul(pow2, two); i = i + 1 }
    } else {
        let neg = 0 - e
        while i < neg { pow2 = fdiv(pow2, two); i = i + 1 }
    }
    let v = fmul(leading, pow2)
    if sign == 1 { return fsub(zero, v) }
    return v
}

// -------------------------------------------------------------- Q6_K (type 14)
//
// Q6_K super-block: 210 bytes -> 256 weights, in ggml-quants.h order:
//
//   +0   u8  ql[128]    quants, LOW 4 bits, interleaved
//   +128 u8  qh[64]     quants, UPPER 2 bits
//   +192 i8  scales[16] per-16-element scales
//   +208 f16 d          super-block scale
//
// THE PREVIOUS BODY OF THIS FUNCTION WAS NOT Q6_K. It read a 2-byte scale at
// offset 0 and 3-byte quant groups from offset 2 -- which is not any GGML block
// layout at all. It read the FIRST QUANT BYTE as the super-block scale and
// produced plausible numbers, so nothing caught it: it is used for 19 of the
// reference model's 266 tensors, including token_embd.weight (the whole
// embedding table), and tests/test_inference_ops.quanta only asserted the Q4_K
// path, so Q6_K was never checked against a value.
//
// Verified bit-for-bit against the compiled reference (scripts/audit/
// dequant_oracle.py extracts dequantize_row_q6_K verbatim and links it).
//
// The quant packing, transcribed from ggml-quants.c:
//
//   q1 = (ql[l]      & 0xF) | ((qh[l] >> 0 & 3) << 4) - 32
//   q2 = (ql[l+32]   & 0xF) | ((qh[l] >> 2 & 3) << 4) - 32
//   q3 = (ql[l]      >> 4)  | ((qh[l] >> 4 & 3) << 4) - 32
//   q4 = (ql[l+32]   >> 4)  | ((qh[l] >> 6 & 3) << 4) - 32
//   y[l+0]  = d * sc[is+0] * q1
//   y[l+32] = d * sc[is+2] * q2
//   y[l+64] = d * sc[is+4] * q3
//   y[l+96] = d * sc[is+6] * q4        is = l/16
fn dequant_q6k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 210
        let d = f16_to_f64(raw + bo + 208)
        // The C runs TWO passes of 128 elements per 256-element block:
        //
        //     for (n = 0; n < 256; n += 128) {
        //         for (l = 0; l < 32; ++l) { ... }
        //         y += 128; ql += 64; qh += 32; sc += 8;
        //     }
        //
        // The first version ran a SINGLE pass, so it filled elements 0..127 and
        // left 128..255 as whatever the buffer held -- which was zero. Every
        // Q6_K tensor was half garbage. The audit caught it only because one
        // assertion read element 254; the first eight all matched the oracle.
        let n = 0
        while n < 2 {
            let ql = bo + n * 64
            let qh = bo + 128 + n * 32
            let sc = bo + 192 + n * 8
            let ybase = bi * 256 + n * 128
            let l = 0
            while l < 32 {
                // Sub-scale index: is = 0 for l < 16, 1 for l >= 16.
                //
                // Each 128-element pass advances the SCALE POINTER by 8
                // (`sc += 8` in the reference, see the `sc` binding above), and
                // within a pass `is` selects which half of that 8-byte group is
                // used. Combined with the +0/+2/+4/+6 strides this reaches all
                // 8 scale bytes of the pass, i.e. all 16 bytes of the block.
                //
                // This is correct as written. An intermediate revision replaced
                // it with `(l / 16) * 8`, reasoning that `sc` did not move --
                // but it does (sc += 8 per pass), so that change made elements
                // 16..127 read past the scale array into the trailing `d`
                // field. Do not "simplify" this back into a single pointer.
                let is = l / 16
                let ql0 = mem_load8(raw + ql + l)
                let ql1 = mem_load8(raw + ql + l + 32)
                let qhb = mem_load8(raw + qh + l)

                let h0 = qhb - (qhb / 4) * 4
                let t1 = qhb / 4
                let h1 = t1 - (t1 / 4) * 4
                let t2 = t1 / 4
                let h2 = t2 - (t2 / 4) * 4
                let h3 = t2 / 4

                let q1 = (ql0 - (ql0 / 16) * 16 + h0 * 16) - 32
                let q2 = (ql1 - (ql1 / 16) * 16 + h1 * 16) - 32
                let q3 = (ql0 / 16 + h2 * 16) - 32
                let q4 = (ql1 / 16 + h3 * 16) - 32

                mem_store(out + (ybase + l) * 8, fmul(d, fmul(i2f(i8_at(raw + sc + is)), i2f(q1))))
                mem_store(out + (ybase + l + 32) * 8, fmul(d, fmul(i2f(i8_at(raw + sc + is + 2)), i2f(q2))))
                mem_store(out + (ybase + l + 64) * 8, fmul(d, fmul(i2f(i8_at(raw + sc + is + 4)), i2f(q3))))
                mem_store(out + (ybase + l + 96) * 8, fmul(d, fmul(i2f(i8_at(raw + sc + is + 6)), i2f(q4))))
                l = l + 1
            }
            n = n + 1
        }
        bi = bi + 1
    }
}

// -------------------------------------------------------------- Q5_K (type 13)
//
// Q5_K super-block: 176 bytes -> 256 weights:
//
//   +0   f16 d          super-block scale
//   +2   f16 dmin       super-block minimum scale
//   +4   u8 scales[12]  eight (scale, min) pairs, 6 bits each, bit-packed
//   +16  u8 qh[32]      5th bit of each quant
//   +48  u8 qs[128]     low 4 bits, nibble-packed
//
// Same shape as Q4_K plus the qh high-bit plane. Transcribed from
// dequantize_row_q5_K in ggml-quants.c and verified bit-for-bit against the
// compiled reference (scripts/audit/dequant_diff.py).

// pow4i(n): 4^n for n in 0..3 -- the Q5_K high-bit mask sequence.
//
// The C advances the masks with `u1 <<= 2`, i.e. it QUADRUPLES them each
// 64-element group: u1 = 1, 4, 16, 64 with u2 = 2, 8, 32, 128 alongside. The
// first version used a powers-of-TWO table (1, 2, 4, 8), which is right for
// Q4_K's single mask and wrong for Q5_K's pair from group 1 on -- so elements
// 0..63 matched and 64..255 did not.
fn pow4i(n) {
    if n <= 0 { return 1 }
    if n == 1 { return 4 }
    if n == 2 { return 16 }
    return 64
}

fn dequant_q5k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 176
        let d = f16_to_f64(raw + bo)
        let dmin = f16_to_f64(raw + bo + 2)
        let ybase = bi * 256
        // Four groups of 64 elements. Each group uses TWO (scale,min) pairs and
        // TWO high-bit masks, u1 and u2, which advance by a factor of 2 per group
        // -- so group g uses masks 2^g and 2^(g+1). Within a group the first 32
        // elements take the LOW nibble of ql[l] and mask u1; the next 32 take
        // the HIGH nibble and mask u2.
        let grp = 0
        while grp < 4 {
            let is = grp * 2
            let sc1 = q5_scale(raw + bo + 4, is)
            let mn1 = q5_min(raw + bo + 4, is)
            let sc2 = q5_scale(raw + bo + 4, is + 1)
            let mn2 = q5_min(raw + bo + 4, is + 1)
            let d1 = fmul(d, i2f(sc1))
            let m1 = fmul(dmin, i2f(mn1))
            let d2 = fmul(d, i2f(sc2))
            let m2 = fmul(dmin, i2f(mn2))
            // The C carries the high-bit masks in u1/u2 and advances them with
            // `u1 <<= 2` each group, so group g uses (2^g, 2^(g+1)).
            //
            // They are read from a table rather than computed with a runtime
            // division: `hbit / u1` is a DIVIDE, not a bit test, and it silently
            // produced 0 for every odd group, dropping the +16 on half the
            // elements. `x & mask` is the operation the C means by
            // `qh[l] & u1`.
            let u1 = pow4i(grp)
            let u2 = u1 * 2
            let ql = bo + 48 + grp * 32
            // qh does NOT advance: the C keeps `const uint8_t *qh = x[i].qh;`
            // and indexes qh[l] with l in 0..31 for EVERY group, letting only the
            // u1/u2 masks move. Advancing qh per group reads different bytes.
            let qh = bo + 16
            let l = 0
            while l < 32 {
                let qlo = mem_load8(raw + ql + l)
                let qhi = mem_load8(raw + qh + l)
                // (ql[l] & 0xF) + (qh[l] & u1 ? 16 : 0)
                let nib_a = qlo - (qlo / 16) * 16
                // `qh[l] & u1 ? 16 : 0`. u1 is a power of two, so bit k of qhi is
                // set iff floor(qhi / u1) is ODD. The first version wrote
                // `qhi % u1 != 0`, which is a MODULO and is zero for every
                // u1 == 1 -- so bit 0 was never set and half the elements lost
                // their +16.
                let bit_a = 0
                if (qhi / u1) - ((qhi / u1) / 2) * 2 == 1 { bit_a = 16 }
                // (ql[l] >> 4) + (qh[l] & u2 ? 16 : 0)
                let nib_b = qlo / 16
                let bit_b = 0
                if (qhi / u2) - ((qhi / u2) / 2) * 2 == 1 { bit_b = 16 }
                mem_store(out + (ybase + grp * 64 + l) * 8,
                          fsub(fmul(d1, i2f(nib_a + bit_a)), m1))
                mem_store(out + (ybase + grp * 64 + 32 + l) * 8,
                          fsub(fmul(d2, i2f(nib_b + bit_b)), m2))
                l = l + 1
            }
            grp = grp + 1
        }
        bi = bi + 1
    }
}

// The six-bit (scale, min) pairs in a k-quant block's scales[12] array.
// ggml's get_scale_min_k4: for k < 4 the low nibbles carry it; for k >= 4 the
// value straddles two bytes, two bits in scales[k+4] and four in the high bits
// of scales[k-4].
fn q5_scale(q, k) {
    if k < 4 { return mem_load8(q + k) - (mem_load8(q + k) / 64) * 64 }
    let a = mem_load8(q + k + 4)
    let b = mem_load8(q + k - 4)
    return (a - (a / 16) * 16) + (b / 64) * 16
}

fn q5_min(q, k) {
    if k < 4 { return mem_load8(q + k + 4) - (mem_load8(q + k + 4) / 64) * 64 }
    let a = mem_load8(q + k + 4)
    let b = mem_load8(q + k)
    return (a / 16) + (b / 64) * 16
}

// -------------------------------------------------------------- Q8_0 (type 8)
//
// 34 bytes -> 32 weights. d f16 at +0, then 32 signed bytes.
//
//   y[i*32 + j] = qs[j] * d
//
// The standard KV-cache quant, and the one a caller is most likely to reach for
// after Q6_K. Verified against the compiled dequantize_row_q8_0.
// i8_at(ptr): read one byte as a SIGNED int8.
//
// Two's complement: b >= 128 means b - 256. The first version of dequant_q8_0
// wrote `b - (b / 128) * 128 - (b / 128) * 256`, which subtracts 128 AND 256 and
// so turns 240 (which is -16) into -144 -- off by 128 for every byte with the
// high bit set, i.e. for every negative quant, which is exactly the half of the
// range that matters.
fn i8_at(ptr) {
    let b = mem_load8(ptr)
    if b >= 128 { return b - 256 }
    return b
}

fn dequant_q8_0(raw, nelements, out) {
    let n_blocks = nelements / 32
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 34
        let d = f16_to_f64(raw + bo)
        let j = 0
        while j < 32 {
            let q = i8_at(raw + bo + 2 + j)
            mem_store(out + (bi * 32 + j) * 8, fmul(d, i2f(q)))
            j = j + 1
        }
        bi = bi + 1
    }
}

// --------------------------------------------------------------- Q4_0 (type 2)
//
// 32 values / 18 bytes. ggml-common.h: block_q4_0 { fp16 d; uint8 qs[16]; }.
// ggml-quants.c: dequantize_row_q4_0() is just a nibble split with no min term --
//     y[j]      = (qs[j] & 0xF) - 8) * d
//     y[j + 16] = (qs[j] >> 4)  - 8) * d
// so element j and element j+16 come from the SAME byte, low nibble then high.
// There is no `m`, unlike Q4_1.
//
// This is NOT Q4_1 and NOT Q4_K. An earlier body here read a second scale at
// +2 and used the Q4_1/K layout, which silently produced garbage for every
// Q4_0 tensor.
fn dequant_q4_0(raw, nelements, out) {
    let n_blocks = nelements / 32
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 18
        let d = f16_to_f64(raw + bo)
        let j = 0
        while j < 16 {
            // NOTE: this local must NOT be named `byte` -- that is a reserved
            // type keyword and the parser rejects it as a binding name.
            let qb = mem_load8(raw + bo + 2 + j)
            let lo = qb & 15
            let hi = qb >> 4
            mem_store(out + (bi * 32 + j) * 8, fmul(d, i2f(lo - 8)))
            mem_store(out + (bi * 32 + 16 + j) * 8, fmul(d, i2f(hi - 8)))
            j = j + 1
        }
        bi = bi + 1
    }
}

// -------------------------------------------------------------- BF16 (type 30)
//
// 1 value / 2 bytes. BF16 is the top 16 bits of an IEEE binary32 with a zero
// exponent field and no mantissa -- i.e. bf16 == fp32 with the low half
// discarded. So widening is a SHIFT, not a conversion: there is no separate
// exponent or rounding rule to get wrong.
//
// NOTE this is NOT f16_to_f64(). A BF16 bit pattern is an fp16 bit pattern only
// by coincidence; feeding one to the half-precision converter reads the exponent
// at the wrong width and returns values that are wrong by powers of two.
fn dequant_bf16(raw, nelements, out) {
    let i = 0
    // Scratch is hoisted out of the loop: mem_alloc inside a loop body is unsafe
    // (the next iteration can clobber the block).
    // mem_alloc returns a HEADER-CARRYING pointer: [ptr] is the element count and
    // the data begins at ptr+8. Writing at scratch+0 wrote the header and the
    // converter then read the count 8 as an fp32 exponent-zero pattern -- every
    // element came back 0.0. All access below is via p = scratch + 8.
    let scratch = mem_alloc(8)
    let p = scratch + 8
    // Bytes 0 and 1 of the fp32 pattern are the mantissa's LOW half and must be
    // zero for every element, so they are zeroed ONCE here and never touched
    // again. Only bytes 2 and 3 are rewritten per iteration. (Building the 4-byte
    // pattern with an inner per-byte loop instead returned 0.0 for every element,
    // and lifted out into its own function it SIGILLed -- so it stays flattened.)
    mem_store8(p + 0, 0)
    mem_store8(p + 1, 0)
    while i < nelements {
        // A bf16 element is EXACTLY bytes [i*2, i*2+2). Placed in the HIGH half of
        // the 4-byte fp32 scratch, the 32-bit pattern the converter reads IS
        // bf16<<16 -- the authoritative C-oracle form.
        //
        // Two earlier forms were wrong. f32_to_f64(raw + i*2) read 4 bytes and
        // folded the NEXT element into the mantissa low bits (sum off by 0.033 on
        // the 27.5M-element per_layer_model_proj.weight, plus every min/max).
        // Shifting straight into an f64 was worse: an f64 whose pattern is
        // bf16<<48 has bias 1023 where fp32 has 127, so it is off by a factor of
        // 2^896 -- 16561 widened to 4352.0 instead of 1.0. No shift works: the
        // exponent must be REBASED, which is exactly what f32_to_f64 does.
        // Little-endian: the fp32 SIGN+EXPONENT byte is b3 and the top mantissa
        // byte is b2. So bf16<<16 lands in bytes 2 and 3 -- bytes 0 and 1 would
        // build the pattern 0x00003f80, a subnormal ~1.7e-38, not 1.0. Every
        // element came back 0.0 at 6 decimal places until this was corrected.
        mem_store8(p + 2, mem_load8(raw + i * 2))
        mem_store8(p + 3, mem_load8(raw + i * 2 + 1))
        mem_store(out + i * 8, f32_to_f64(p))
        i = i + 1
    }
}

// ---------------------------------------------------------------- F16 (type 1)
//
// 1 value / 2 bytes, no quantisation. Just the widening.
// --------------------------------------------------------------- Q4_1 (type 3)
//
// 32 values / 20 bytes. Two scales -- delta AND min -- so unlike Q4_0 the
// reconstruction is affine, not multiplicative:
//     y = q*d + m
// Element order is the split-nibble order shared by every Q4x format: the low
// nibble of byte j is element j, the HIGH nibble is element j+16. Not
// interleaved.
fn dequant_q4_1(raw, nelements, out) {
    let n_blocks = nelements / 32
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 20
        let d = f16_to_f64(raw + bo)
        let m = f16_to_f64(raw + bo + 2)
        let j = 0
        while j < 16 {
            let qb = mem_load8(raw + bo + 4 + j)
            let lo = qb & 15
            let hi = qb >> 4
            mem_store(out + (bi * 32 + j) * 8, fadd(fmul(d, i2f(lo)), m))
            mem_store(out + (bi * 32 + 16 + j) * 8, fadd(fmul(d, i2f(hi)), m))
            j = j + 1
        }
        bi = bi + 1
    }
}

// --------------------------------------------------------------- Q5_0 (type 6)
//
// 32 values / 22 bytes. Delta only (no min), but 5-bit: the low 4 bits come
// from the nibble and the 5th bit from a 32-bit `qh` read little-endian, which
// is why qh must be assembled from 4 bytes by hand rather than loaded as one.
//
// The -16 is the Q5 signed offset (5-bit range is -16..15).
//
// qh bit layout: element j's high bit is (qh >> j) & 1, and element j+16's is
// (qh >> (j+16)) & 1. Upstream writes this as `((qh >> (j+0)) << 4) & 0x10`
// and `((qh >> (j+12)) & 0x10)`, i.e. the same two bits moved into bit 4 so they
// can be OR'd with a 4-bit nibble.
fn dequant_q5_0(raw, nelements, out) {
    let n_blocks = nelements / 32
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 22
        let d = f16_to_f64(raw + bo)
        let qh = mem_load32(raw + bo + 2)
        let j = 0
        while j < 16 {
            let qb = mem_load8(raw + bo + 6 + j)
            let h0 = (qh >> j) & 1
            let h1 = (qh >> (j + 16)) & 1
            let x0 = ((qb & 15) | (h0 << 4)) - 16
            let x1 = ((qb >> 4) | (h1 << 4)) - 16
            mem_store(out + (bi * 32 + j) * 8, fmul(d, i2f(x0)))
            mem_store(out + (bi * 32 + 16 + j) * 8, fmul(d, i2f(x1)))
            j = j + 1
        }
        bi = bi + 1
    }
}

// --------------------------------------------------------------- Q5_1 (type 7)
//
// 32 values / 24 bytes. Q5_0 plus a min, so affine like Q4_1, and UNSIGNED:
// the 5-bit value is 0..31 with no -16 offset.
fn dequant_q5_1(raw, nelements, out) {
    let n_blocks = nelements / 32
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 24
        let d = f16_to_f64(raw + bo)
        let m = f16_to_f64(raw + bo + 2)
        let qh = mem_load32(raw + bo + 4)
        let j = 0
        while j < 16 {
            let qb = mem_load8(raw + bo + 8 + j)
            let h0 = (qh >> j) & 1
            let h1 = (qh >> (j + 16)) & 1
            let x0 = (qb & 15) | (h0 << 4)
            let x1 = (qb >> 4) | (h1 << 4)
            mem_store(out + (bi * 32 + j) * 8, fadd(fmul(d, i2f(x0)), m))
            mem_store(out + (bi * 32 + 16 + j) * 8, fadd(fmul(d, i2f(x1)), m))
            j = j + 1
        }
        bi = bi + 1
    }
}

// --------------------------------------------------------------- Q8_K (type 15)
//
// 256 values / 292 bytes. The simplest K format and the only one that is not
// sub-block scaled: a single f32 delta and 256 signed bytes.
//     y = d * qs[j]
// The 16 int16 bsums are block SUMS, used for activation quantization, and are
// not part of dequantization -- reading them as data shifts every element.
fn dequant_q8k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 292
        // `d` is a raw f32, not f16 -- this is the one K block with a full-
        // precision scale, so f16_to_f64 here would halve the mantissa.
        let d = f32_to_f64(raw + bo)
        let j = 0
        while j < 256 {
            let q = mem_load8(raw + bo + 4 + j)
            // Sign-extend from int8. mem_load8() returns 0..255 UNSIGNED (measured,
            // not assumed), so a bare `q - 256` maps 0..127 to -256..-129 and
            // inflates every magnitude. Branch instead of biasing: `q & 0x80`
            // set means negative.
            let sv = q
            if (q & 128) != 0 { sv = q - 256 }
            mem_store(out + (bi * 256 + j) * 8, fmul(d, i2f(sv)))
            j = j + 1
        }
        bi = bi + 1
    }
}

// --------------------------------------------------------------- Q2_K (type 10)
//
// 256 values / 84 bytes. 16 groups of 16, each with a 4-bit scale AND a 4-bit
// min packed in one scales byte (low nibble = scale, high nibble = min):
//     y = d * (sc & 0xF) * q - dmin * (sc >> 4)
//
// Layout order matters twice over, and both are easy to get backwards:
//   * quants are stored in FOUR passes of 64 (two halves of 32 bytes), each
//     pass holding one 2-bit shift of 16+16 elements, so element order is
//     NOT the flat order of the qs array;
//   * the `q` cursor advances 32 bytes per 128-element pass, so the two 128-
//     element halves of a super-block read from disjoint qs regions.
fn dequant_q2k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 84
        // Layout: scales[16]@+0, qs[64]@+16, f16 d@+80, f16 dmin@+82.
        // The scales come FIRST in block_q2_K, not last -- reading d at +64
        // returns a garbage half (d=-0.000195 instead of ~0.0018) and inflates
        // every element by 4e5.
        let d = f16_to_f64(raw + bo + 80)
        let dmin = f16_to_f64(raw + bo + 82)
        let is = 0
        let yo = bi * 256
        // n steps over 128-element passes; qcursor walks the qs region.
        let pass = 0
        while pass < 2 {
            let qc = bo + 16 + pass * 32
            let shift = 0
            let j = 0
            while j < 4 {
                let sc = mem_load8(raw + bo + is)
                let dl = fmul(d, i2f(sc & 15))
                let ml = fmul(dmin, i2f(sc >> 4))
                let l = 0
                while l < 16 {
                    let q = mem_load8(raw + qc + l)
                    let v = (q >> shift) & 3
                    mem_store(out + (yo + pass * 128 + j * 32 + l) * 8, fsub(fmul(dl, i2f(v)), ml))
                    l = l + 1
                }
                is = is + 1
                let sc2 = mem_load8(raw + bo + is)
                let dl2 = fmul(d, i2f(sc2 & 15))
                let ml2 = fmul(dmin, i2f(sc2 >> 4))
                l = 0
                while l < 16 {
                    let q = mem_load8(raw + qc + 16 + l)
                    let v = (q >> shift) & 3
                    mem_store(out + (yo + pass * 128 + j * 32 + 16 + l) * 8, fsub(fmul(dl2, i2f(v)), ml2))
                    l = l + 1
                }
                is = is + 1
                shift = shift + 2
                j = j + 1
            }
            pass = pass + 1
        }
        bi = bi + 1
    }
}

// --------------------------------------------------------------- Q3_K (type 11)
//
// 256 values / 110 bytes. 16 groups of 16, each with a 6-bit scale, plus a
// per-element high bit in `hmask`:
//     y = d * (scale - 32) * (q_low2 - (hmask_bit ? 0 : 4))
//
// The 6-bit scales are stored PACKED 12 bytes, not one byte each, so they must
// be unpacked before use. Upstream does this with 32-bit SWAR masks
// (kmask1/kmask2) in one shot over four u32 words; doing it with four
// independent 12-byte reads and a bit cursor avoids depending on 32-bit shifts
// being correct, at the cost of being slower -- which is irrelevant here.
fn dequant_q3k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 110
        // Layout: hmask[32]@+0, qs[64]@+32, scales[12]@+96, f16 d@+108.
        let d = f16_to_f64(raw + bo + 108)

        // Unpack the 16 six-bit scales from 12 packed bytes, 8 per 32-bit word.
        // Upstream does this with SWAR masks on four u32s; here the four
        // resulting words are written to a 16-byte scratch and read back as
        // bytes, so the per-byte extraction needs no 32-bit shift assumptions.
        let a0 = mem_load32(raw + bo + 96)
        let a1 = mem_load32(raw + bo + 100)
        let tm = mem_load32(raw + bo + 104)
        // 0x03030303 and 0x0f0f0f0f. Written as decimal because a hex literal
        // is not worth the transcription risk here: a mistyped mask still
        // compiles and still yields plausible-looking scales.
        let km1 = 50529027
        let km2 = 252645135
        let n2 = ((a0 >> 4) & km2) | (((tm >> 4) & km1) << 4)
        let n3 = ((a1 >> 4) & km2) | (((tm >> 6) & km1) << 4)
        let n0 = (a0 & km2) | ((tm & km1) << 4)
        let n1 = (a1 & km2) | (((tm >> 2) & km1) << 4)
        let sb = mem_alloc(32)
        let sp = sb + 8
        mem_store(sp, n0)
        mem_store(sp + 4, n1)
        mem_store(sp + 8, n2)
        mem_store(sp + 12, n3)

        let is = 0
        let yo = bi * 256
        // Two 128-element passes. NOTE: upstream advances the `q` cursor by 32
        // per pass but leaves `hm` pointing at the start of hmask for BOTH
        // passes -- only the mask BIT index moves. Advancing hmask by pass is
        // the natural mistake and silently corrupts the upper half.
        let pass = 0
        while pass < 2 {
            let qc = bo + 32 + pass * 32
            let shift = 0
            let j = 0
            while j < 4 {
                let dl = fmul(d, i2f(mem_load8(sp + is) - 32))
                let mbit = j + pass * 4
                let l = 0
                while l < 16 {
                    let q = mem_load8(raw + qc + l)
                    let hb = mem_load8(raw + bo + l)
                    let hi = (hb >> mbit) & 1
                    // hmask bit SET means the high bit was NOT consumed, so
                    // subtract 0; bit CLEAR means it WAS, so subtract 4. This
                    // polarity is the easy thing to invert: writing `(hi << 2)`
                    // compiles, runs, and produces values that look plausible
                    // but are wrong by exactly the 4-offset.
                    let sub = 4
                    if hi != 0 { sub = 0 }
                    let v = ((q >> shift) & 3) - sub
                    mem_store(out + (yo + pass * 128 + j * 32 + l) * 8, fmul(dl, i2f(v)))
                    l = l + 1
                }
                is = is + 1
                let dl2 = fmul(d, i2f(mem_load8(sp + is) - 32))
                l = 0
                while l < 16 {
                    let q = mem_load8(raw + qc + 16 + l)
                    let hb = mem_load8(raw + bo + 16 + l)
                    let hi = (hb >> mbit) & 1
                    // hmask bit SET means the high bit was NOT consumed, so
                    // subtract 0; bit CLEAR means it WAS, so subtract 4. This
                    // polarity is the easy thing to invert: writing `(hi << 2)`
                    // compiles, runs, and produces values that look plausible
                    // but are wrong by exactly the 4-offset.
                    let sub = 4
                    if hi != 0 { sub = 0 }
                    let v = ((q >> shift) & 3) - sub
                    mem_store(out + (yo + pass * 128 + j * 32 + 16 + l) * 8, fmul(dl2, i2f(v)))
                    l = l + 1
                }
                is = is + 1
                shift = shift + 2
                j = j + 1
            }
            pass = pass + 1
        }
        bi = bi + 1
    }
}

fn dequant_f16(raw, nelements, out) {
    let i = 0
    while i < nelements {
        mem_store(out + i * 8, f16_to_f64(raw + i * 2))
        i = i + 1
    }
}

// --------------------------------------------------------------- Q4_K (type 12)
//
// Q4_K super-block: 144 bytes -> 256 f32 weights.
//   +0  f16 d      super-block scale for the 6-bit sub-scales
//   +2  f16 dmin   super-block scale for the 6-bit sub-mins
//   +4  u8 scales[12]  eight (scale, min) pairs, each 6 bits, bit-packed
//   +16 u8 qs[128]     4-bit quants, low nibble = even element, high = odd
//
// The previous body of this function was NOT Q4_K: it read a 2-byte scale at +0
// and treated the quants as starting at +8, which is Q4_0's layout. It compiled
// and ran, so it silently produced garbage weights for every Q4_K tensor -- worse
// than failing to build. Layout and arithmetic transcribed from
// ggml-quants.c: dequantize_row_q4_K() + get_scale_min_k4(), and checked value
// for value against the real QUANTA-LFM2.5 Q4_K_M tensor
// (blk.0.ffn_gate.weight, file offset 8239136 + 233119744).

// 6-bit (scale, min) pair for sub-block index `j`, read from the 12-byte packed
// scale table at `sc`. This mirrors get_scale_min_k4() from ggml-quants.c
// exactly, and both halves MUST be read from the same 12-byte table with the
// same index j:
//
//     j < 4 : sc[j]   & 63          -> scale
//             sc[j+4] & 63          -> min
//     j >= 4: sc[j+4] & 0xF          scale low nibble
//             (sc[j-4] >> 6) << 4    scale high bits   <- j-4, not j
//             sc[j+4] >> 4           min low nibble
//             (sc[j]   >> 6) << 4    min high bits      <- j, not j-4
//
// Two bugs lived here and both produced ~1e20 outputs. Passing `sc` and `sc+4`
// as two different bases (to read the scale half and the min half) ran off the
// end of the 12-byte table once j reached 4. And deriving both high halves from
// `sc[j-4]` mis-paired the scale and min of every sub-block from 4 upward.
fn q4k_sc(j, sc) {
    if j < 4 { return mem_load8(sc + j) - (mem_load8(sc + j) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo - (lo / 16) * 16) + ((mem_load8(sc + j - 4) / 64) * 16)
}

fn q4k_min(j, sc) {
    if j < 4 { return mem_load8(sc + j + 4) - (mem_load8(sc + j + 4) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo / 16 - (lo / 16 / 16) * 16) + ((mem_load8(sc + j) / 64) * 16)
}

fn dequant_q4k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 144
        let d    = f16_to_f64(raw + bo)
        let dmin = f16_to_f64(raw + bo + 2)
        let sc   = raw + bo + 4
        let q    = raw + bo + 16

        // Four 64-element chunks, each pairing two 32-element sub-blocks that
        // share a 32-byte span of quants: low nibbles first, then high nibbles.
        let chunk = 0
        let is = 0
        while chunk < 4 {
            let s0 = q4k_sc(is, sc)
            let m0 = q4k_min(is, sc)
            let s1 = q4k_sc(is + 1, sc)
            let m1 = q4k_min(is + 1, sc)
            let d1 = fmul(d, i2f(s0))
            let mm1 = fmul(dmin, i2f(m0))
            let d2 = fmul(d, i2f(s1))
            let mm2 = fmul(dmin, i2f(m1))

            // One pass over the 32 bytes, emitting BOTH nibbles.
            //
            // MEASURED, do not "optimise" this further without timing it:
            //   direct fmul/fsub, two passes   129 ms  (before the shift/mask fix)
            //   shift/mask instead of idiv      93 ms  <- the real win, 1.39x
            //   merged into one pass            98 ms  (noise, kept for clarity)
            //   precomputed 16-entry table     101 ms  (SLOWER -- reverted)
            //   4-wide AVX2 f64                267 ms  (3.5x SLOWER -- reverted)
            // The table lost because a mem_load+mem_store pair costs as much as
            // the fmul+fsub pair it replaced.
            //
            // The 4-wide attempt is the informative one: fmulf_avx2/fsubf_avx2
            // are real and correct, but they need their operands in MEMORY
            // (pointer arguments), so the nibbles must be materialised as f64
            // first. That adds a whole extra pass -- 32 stores to build the
            // nibble buffer, then 32 more to write the results -- on top of the
            // 32 the scalar form already does. This loop is bound by memory
            // operations per element, not by FP arithmetic, which is why
            // widening the arithmetic made it worse.
            //
            // So dequant is NOT vectorisable with the builtins that exist.
            // Breaking 93 ms needs either a new emitter builtin (a vector
            // nibble-unpack or int->f64 convert, so the values never round-trip
            // through memory) or a fused Q4_K matvec (q4k_matvec_avx2, currently
            // a placeholder), or threads -- and threads are blocked on the clone
            // trampoline (see scripts/proto/README.md). Recorded so the next
            // session does not retry the widening.
            let op = out + (bi * 256 + chunk * 64) * 8
            let l = 0
            while l < 32 {
                let b = mem_load8(q + l)
                // Shifts/mask, NOT `b / 16` and `(b/16)*16`. Quanta's -O is a
                // verified no-op (byte-identical binaries with and without it),
                // so an integer divide here is a real `idiv` -- ~40-80 cycles
                // each, twice per element, which was the bulk of the dequant.
                mem_store(op + l * 8, fsub(fmul(d1, i2f(b & 15)), mm1))
                mem_store(op + (32 + l) * 8, fsub(fmul(d2, i2f(b >> 4)), mm2))
                l = l + 1
            }
            q = q + 32
            is = is + 2
            chunk = chunk + 1
        }
        bi = bi + 1
    }
    return 0
}

fn rms_norm(out, x, w, n) {
    // Standard RMSNorm: y[i] = x[i] / sqrt(mean(x^2)) * w[i].
    //
    // The divisor is sqrt(mean), NOT sqrt(1 + mean). The stray +1 (meant as an
    // epsilon guard) scaled every vector by 1/sqrt(2) at unit magnitude, which
    // is a factor-of-1.41 error on every layer of the model. Measured on
    // x = all ones, w = [0.001, ..., 2.048]:
    //     with the +1: 0.0007071067812 / 1.4481546879
    //     correct:     0.0010000000000 / 2.0480000000
    let ms = i2f(0)
    let i = 0
    while i < n {
        // f64of is REQUIRED: mem_load() returns the raw 8 bytes as an integer,
        // so without it every value below is a float's bit pattern fed to
        // fadd/fmul as a number. The integer path also overflows -- 4.0's bit
        // pattern is 4612676019179889152 and squaring it needs 2^124, which
        // raises the compiler's overflow trap.
        let v = f64of(mem_load(x + i * 8))
        ms = fadd(ms, fmul(v, v))
        i = i + 1
    }
    let ir = fdiv(i2f(1), sqrt(fdiv(ms, i2f(n))))

    i = 0
    while i < n {
        let xv = f64of(mem_load(x + i * 8))
        let wv = f64of(mem_load(w + i * 8))
        mem_store(out + i * 8, fmul(fmul(xv, ir), wv))
        i = i + 1
    }
}

fn matvec(A, x, rows, cols, y) {
    let i = 0
    while i < rows {
        // `acc` MUST be a typed float and both operands MUST go through f64of.
        // mem_load() returns a raw 64-bit bit pattern, so the untyped version
        // this replaces emitted an integer imul plus the signed-overflow trap
        // and overflowed on ordinary index arithmetic.
        let acc: f64 = 0.0
        let j = 0
        while j < cols {
            let a = f64of(mem_load(A + (i * cols + j) * 8))
            let xv = f64of(mem_load(x + j * 8))
            acc = acc + a * xv
            j = j + 1
        }
        mem_store(y + i * 8, acc)
        i = i + 1
    }
}

fn softmax_arr(out, inp, n) {
    if n <= 0 { return 0 }
    let max_val: f64 = f64of(mem_load(inp))
    let i = 1
    while i < n {
        let v = f64of(mem_load(inp + i * 8))
        if v > max_val { max_val = v }
        i = i + 1
    }
    let sum: f64 = 0.0
    i = 0
    while i < n {
        let ev = gguf_exp(f64of(mem_load(inp + i * 8)) - max_val)
        mem_store(out + i * 8, ev)
        sum = sum + ev
        i = i + 1
    }
    i = 0
    while i < n {
        mem_store(out + i * 8, f64of(mem_load(out + i * 8)) / sum)
        i = i + 1
    }
}

fn swiglu(out, x, y, n) {
    let i = 0
    while i < n {
        // Same defect rms_norm had: mem_load() yields the integer bit pattern,
        // so swiglu was computing silu on bit patterns rather than values.
        let xv = f64of(mem_load(x + i * 8))
        let yv = f64of(mem_load(y + i * 8))
        // sigmoid(x) = 1 / (1 + e^-x). This used pow(2, -x), which is
        // 1/(1 + e^(-x*ln2)) -- a sigmoid of ln2*x, not of x. Measured on
        // x = 2, y = 10: it returned 16.0, and the correct
        // silu(2)*10 = 2/(1+e^-2)*10 = 17.615941559557648.
        let sig = fdiv(i2f(1), fadd(i2f(1), gguf_exp(fsub(i2f(0), xv))))
        mem_store(out + i * 8, fmul(fmul(xv, sig), yv))
        i = i + 1
    }
}

fn vec_add(out, a, b, n) {
    let i = 0
    while i < n {
        mem_store(out + i * 8, f64of(mem_load(a + i * 8)) + f64of(mem_load(b + i * 8)))
        i = i + 1
    }
}

fn vec_mul(out, a, b, n) {
    let i = 0
    while i < n {
        mem_store(out + i * 8, f64of(mem_load(a + i * 8)) * f64of(mem_load(b + i * 8)))
        i = i + 1
    }
}

// ---------------------------------------------------------------- skipping

// Advance fd by `n` bytes.
fn gguf_skip(fd, n) {
    if n <= 0 { return 0 }
    return lseek(fd, n, 1)
}

// Byte width of a scalar GGUF metadata value type.
fn gguf_value_size(vtype) {
    if vtype == 0 || vtype == 1 || vtype == 7 { return 1 }
    if vtype == 2 || vtype == 3 { return 2 }
    if vtype == 4 || vtype == 5 || vtype == 6 { return 4 }
    return 0
}

// Advance fd past one metadata value of type `vtype`, including its length
// prefix when the value is a string or an array. This is what lets a reader
// walk a KV block without interpreting the payload.
fn gguf_skip_value(fd, vtype) {
    let b8 = mem_alloc(8)
    let b4 = mem_alloc(4)
    if vtype == 8 {
        // string: u64 length + bytes
        read_raw(fd, b8, 8)
        gguf_skip(fd, mem_load(b8))
    } else if vtype == 9 {
        // array: u32 element type + u64 count + payload
        read_raw(fd, b4, 4)
        let etype = mem_load(b4)
        read_raw(fd, b8, 8)
        let alen = mem_load(b8)
        if etype == 8 {
            let i = 0
            while i < alen {
                read_raw(fd, b8, 8)
                gguf_skip(fd, mem_load(b8))
                i = i + 1
            }
        } else {
            let esz = gguf_value_size(etype)
            gguf_skip(fd, alen * esz)
        }
    } else {
        gguf_skip(fd, gguf_value_size(vtype))
    }
    return 0
}

// Print a human-readable summary of the loaded model.
fn gguf_print_info() {
    print("GGUF tensors=") print(gguf_n_tensors) print(" kv=") print(gguf_n_kv) print(" data@") print(gguf_data_start) print("\n")
    let i = 0
    while i < gguf_n_tensors {
        if i < 8 {
            print("  [") print(i) print("] name@")
            print(gguf_tensor_name(i))
            print(" dims=")
            let nd = gguf_tensor_ndims(i)
            let d = 0
            while d < nd { print(gguf_tensor_dim(i, d)) print(",") d = d + 1 }
            print(" dt=") print(gguf_tensor_dtype(i)) print("\n")
        }
        i = i + 1
    }
    return 0
}

// ------------------------------------------------------- tensor data access

// Read a tensor's raw (quantised) bytes into a fresh buffer and return the
// buffer address; the length is available from gguf_tensor_nbytes().
fn gguf_read_tensor(idx) {
    if idx < 0 || idx >= gguf_n_tensors { return 0 }
    let nbytes = gguf_tensor_nbytes(idx)
    let buf = mem_alloc(nbytes)
    if gguf_read_tensor_bytes(idx, buf, nbytes) < 0 { return 0 }
    return buf
}

// Read a contiguous slice of a tensor, `byte_off` bytes into it. Needed for
// token embeddings: token_embd.weight is [2048, 128000] Q6_K = 262 MB, so
// reading the whole tensor to fetch one 1680-byte row wastes both memory and
// time on every single token. Callers pass byte_off = row * bytes_per_row.
fn gguf_read_tensor_bytes_at(idx, byte_off, buf, nbytes) {
    if idx < 0 || idx >= gguf_n_tensors { return -1 }
    if byte_off < 0 || nbytes < 0 { return -3 }

    // Bound the read against the tensor's OWN size and against end of file.
    //
    // This is the gguf.cpp `nbytes_remain` guard: every read is checked against
    // what is actually available before it is issued, so a bad `byte_off` or an
    // over-long `nbytes` cannot read past the tensor or past EOF. Before this,
    // a caller could pass any offset and the kernel would happily read unrelated
    // bytes -- which for a quantized weight means decoding garbage with no error.
    //
    // The RETURN CONTRACT IS UNCHANGED: this returns a BYTE COUNT on success and
    // a negative value on failure. lfm2_mm.quanta:87 depends on it --
    // `if gguf_read_tensor_bytes_at(idx, r*rb, buf, rb) != rb` -- so returning a
    // short count on a partial read is what makes an EOF mid-read detectable.
    let tsz = gguf_tensor_nbytes(idx)
    if tsz <= 0 { return -4 }
    // byte_off and nbytes must both be representable and must not wrap
    if byte_off > tsz - nbytes { return -3 }
    let abs = gguf_tensor_offset(idx)
    if abs > gguf_filesize { return -5 }
    if nbytes > gguf_filesize - abs { return -5 }
    if byte_off > gguf_filesize - abs - nbytes { return -5 }

    if lseek(gguf_fd, abs + byte_off, 0) < 0 { return -2 }
    return read_raw(gguf_fd, buf, nbytes)
}

// ------------------------------------------------------------- linear algebra

// y = A * x for a row-major matrix A of `rows` x `cols` values, 8 bytes each.
// x holds `cols` values, y receives `rows` results. This is the plain
// reference matvec used to check dequantised tensor data; the quantised
// kernels in the inference path are separate.
fn gguf_matvec(A: u64, x: u64, rows: i64, cols: i64, y: u64) {
    let r = 0
    while r < rows {
        // `acc` MUST be a typed float. mem_load() returns a raw 64-bit integer
        // bit pattern, so an untyped `acc` made `acc + a * xv` an integer
        // multiply: the compiler emitted `imul` + the signed-overflow trap
        // (`jno`/`ud2`), and the multiply then overflowed on ordinary index
        // arithmetic -> SIGILL (exit 132) instead of a result.
        let acc: f64 = 0.0
        let c = 0
        while c < cols {
            let a = f64of(mem_load(A + (r * cols + c) * 8))
            let xv = f64of(mem_load(x + c * 8))
            acc = acc + a * xv
            c = c + 1
        }
        mem_store(y + r * 8, acc)
        r = r + 1
    }
    return 0
}

// exp(x) for f64. There is no native `exp` builtin, so this is range
// reduced: exp(x) = 2^k * exp(r) with k = round(x / ln2) and |r| <= ln2/2,
// leaving a series that converges to full f64 precision in a few terms.
// gguf_exp(x) -- kept as a name for callers already using it; the
// implementation moved to lib/std/math.quanta as expf().
//
// It was hand-rolled here and duplicated nowhere else, but there was no tested
// home for f64 transcendentals at all: this was the only implementation in the
// tree, with no accuracy bar and no coverage. std/math's expf is verified
// against Python's math.exp on the raw IEEE-754 bits over 260 cases including
// subnormals, overflow, and a dense sweep of |x| < 61.
//
//   exp(0)    exact
//   exp(+-1)  1 ULP
//   exp(-10)  4 ULP
//   exp(700)  414 ULP (worst; 2^k dominates)  -- 4.97e-14 relative
fn gguf_exp(x: f64) -> f64 {
    return expf(x)
}

// Softmax: out[i] = exp(inp[i] - max) / sum, over `n` f64 values.
//
// Every float local and every mem_load() result must be converted with f64of():
// mem_load() yields a raw 64-bit INTEGER bit pattern, so an untyped `mx` made
// `x > mx` an integer compare and `gguf_exp(inp[i] - mx)` an integer subtract.
// The result was all zeros.
fn gguf_softmax(out: u64, inp: u64, n: i64) {
    if n <= 0 { return 0 }
    let mx: f64 = f64of(mem_load(inp))
    let i = 1
    while i < n {
        let x = f64of(mem_load(inp + i * 8))
        if x > mx { mx = x }
        i = i + 1
    }
    let sum: f64 = 0.0
    i = 0
    while i < n {
        let e = gguf_exp(f64of(mem_load(inp + i * 8)) - mx)
        mem_store(out + i * 8, e)
        sum = sum + e
        i = i + 1
    }
    i = 0
    while i < n {
        mem_store(out + i * 8, f64of(mem_load(out + i * 8)) / sum)
        i = i + 1
    }
    return 0
}
