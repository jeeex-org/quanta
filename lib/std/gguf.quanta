// std/gguf.quanta — Native GGUF model loader for Quanta

import std/fs

let GGUF_TYPE_F32 = 0
let GGUF_TYPE_F16 = 1
let GGUF_TYPE_Q4_0 = 2
let GGUF_TYPE_Q4_1 = 3
let GGUF_TYPE_Q5_0 = 6
let GGUF_TYPE_Q5_1 = 7
let GGUF_TYPE_Q8_0 = 8
let GGUF_TYPE_Q8_1 = 9
let GGUF_TYPE_Q2_K = 10
let GGUF_TYPE_Q3_K = 11
let GGUF_TYPE_Q4_K = 12
let GGUF_TYPE_Q5_K = 13
let GGUF_TYPE_Q6_K = 14
let GGUF_TYPE_Q8_K = 15
let GGUF_TYPE_IQ4_NL = 20
let GGUF_TYPE_IQ4_XS = 21

let GGUF_VAL_UINT8 = 0
let GGUF_VAL_INT8 = 1
let GGUF_VAL_UINT16 = 2
let GGUF_VAL_INT16 = 3
let GGUF_VAL_UINT32 = 4
let GGUF_VAL_INT32 = 5
let GGUF_VAL_FLOAT32 = 6
let GGUF_VAL_BOOL = 7
let GGUF_VAL_STRING = 8
let GGUF_VAL_ARRAY = 9
let GGUF_VAL_UINT64 = 10
let GGUF_VAL_INT64 = 11
let GGUF_VAL_FLOAT64 = 12

let gguf_fd = -1
let gguf_n_kv = 0
let gguf_n_tensors = 0
let gguf_tensors = 0

const TINFO_SIZE = 64

fn gguf_read_string(fd) {
    let len_buf = mem_alloc(8)
    let n = file_read(fd, len_buf, 8)
    if n < 8 { return 0 }
    let len = mem_load(len_buf)
    if len == 0 { return 0 }
    if len > 1048576 { return 0 }
    let buf = mem_alloc(len + 1)
    let r = file_read(fd, buf, len)
    if r < len { return 0 }
    mem_store8(buf + len, 0)
    return buf
}

fn gguf_skip(fd, n) {
    if n <= 0 { return }
    lseek(fd, n, 1)
}

fn gguf_load(path) {
    let fd = open(path, 0, 0)
    if fd < 0 { return -1 }
    gguf_fd = fd
    let hdr = mem_alloc(24)
    let n = read_raw(fd, hdr, 24)
    if n < 24 { close(fd); gguf_fd = -1; return -2 }
    let b0 = mem_load8(hdr)
    if b0 != 71 { close(fd); gguf_fd = -1; return -3 }
    gguf_n_kv = mem_load(hdr + 8)
    gguf_n_tensors = mem_load(hdr + 16)
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let i = 0
    while i < gguf_n_kv {
        read_raw(fd, klen_buf, 8)
        let klen = mem_load(klen_buf)
        if klen > 100000 {
            i = gguf_n_kv
        } else {
            let skip_buf = mem_alloc(1024)
            let remaining = klen
            while remaining > 0 {
                let chunk = 1024
                if remaining < chunk { chunk = remaining }
                read_raw(fd, skip_buf, chunk)
                remaining = remaining - chunk
            }
            read_raw(fd, vtype_buf, 4)
            let vtype = mem_load(vtype_buf)
            gguf_skip_value_read(fd, vtype)
            i = i + 1
        }
    }
    let meta_end = lseek(fd, 0, 1)
    let tensor_info_pos = meta_end + 80
    lseek(fd, tensor_info_pos, 0)
    gguf_tensors = mem_alloc(gguf_n_tensors * TINFO_SIZE)
    let ti = 0
    while ti < gguf_n_tensors {
        let name = gguf_read_string(fd)
        if name == 0 {
            ti = gguf_n_tensors
        } else {
            let ndims_buf = mem_alloc(4)
            read_raw(fd, ndims_buf, 4)
            let ndims = mem_load(ndims_buf)
            if ndims > 10 {
                ti = gguf_n_tensors
            } else {
                let dims = mem_alloc(ndims * 8)
                let d = 0
                while d < ndims {
                    let dval = mem_alloc(8)
                    read_raw(fd, dval, 8)
                    mem_store(dims + d * 8, mem_load(dval))
                    d = d + 1
                }
                let dtype_buf = mem_alloc(4)
                read_raw(fd, dtype_buf, 4)
                let dtype = mem_load(dtype_buf)
                let offset_buf = mem_alloc(8)
                read_raw(fd, offset_buf, 8)
                let offset = mem_load(offset_buf)
                mem_store(gguf_tensors + ti * TINFO_SIZE, name)
                mem_store(gguf_tensors + ti * TINFO_SIZE + 8, ndims)
                mem_store(gguf_tensors + ti * TINFO_SIZE + 16, dims)
                mem_store(gguf_tensors + ti * TINFO_SIZE + 24, dtype)
                mem_store(gguf_tensors + ti * TINFO_SIZE + 32, offset)
                ti = ti + 1
            }
        }
    }
    return 0
}

fn gguf_skip_array_read(fd) {
    let atype_buf = mem_alloc(4)
    read_raw(fd, atype_buf, 4)
    let atype = mem_load(atype_buf)
    let alen_buf = mem_alloc(8)
    read_raw(fd, alen_buf, 8)
    let alen = mem_load(alen_buf)
    
    if atype == 8 {
        let j = 0
        while j < alen {
            let len_buf = mem_alloc(8)
            read_raw(fd, len_buf, 8)
            let slen = mem_load(len_buf)
            let skip_buf = mem_alloc(1024)
            let remaining = slen
            while remaining > 0 {
                let chunk = 1024
                if remaining < chunk { chunk = remaining }
                read_raw(fd, skip_buf, chunk)
                remaining = remaining - chunk
            }
            j = j + 1
        }
    } else if atype == 0 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 1 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 2 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 2
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 3 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 2
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 4 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 4
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 5 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 4
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 6 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 4
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 7 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 10 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 8
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 11 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 8
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if atype == 12 {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 8
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else {
        let skip_buf = mem_alloc(4096)
        let remaining = alen * 4
        while remaining > 0 {
            let chunk = 4096
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    }
}

fn gguf_skip_value_read(fd, vtype) {
    if vtype == 8 {
        let len_buf = mem_alloc(8)
        read_raw(fd, len_buf, 8)
        let slen = mem_load(len_buf)
        let skip_buf = mem_alloc(1024)
        let remaining = slen
        while remaining > 0 {
            let chunk = 1024
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if vtype == 0 {
        let skip = mem_alloc(1)
        read_raw(fd, skip, 1)
    } else if vtype == 1 {
        let skip = mem_alloc(1)
        read_raw(fd, skip, 1)
    } else if vtype == 2 {
        let skip = mem_alloc(2)
        read_raw(fd, skip, 2)
    } else if vtype == 3 {
        let skip = mem_alloc(2)
        read_raw(fd, skip, 2)
    } else if vtype == 4 {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    } else if vtype == 5 {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    } else if vtype == 6 {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    } else if vtype == 7 {
        let skip = mem_alloc(1)
        read_raw(fd, skip, 1)
    } else if vtype == 9 {
        gguf_skip_array_read(fd)
    } else if vtype == 10 {
        let skip = mem_alloc(8)
        read_raw(fd, skip, 8)
    } else if vtype == 11 {
        let skip = mem_alloc(8)
        read_raw(fd, skip, 8)
    } else if vtype == 12 {
        let skip = mem_alloc(8)
        read_raw(fd, skip, 8)
    } else {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    }
}

fn gguf_skip_value(fd, vtype) {
    if vtype == 8 {
        let s = gguf_read_string(fd)
    } else if vtype == 0 {
        gguf_skip(fd, 1)
    } else if vtype == 1 {
        gguf_skip(fd, 1)
    } else if vtype == 2 {
        gguf_skip(fd, 2)
    } else if vtype == 3 {
        gguf_skip(fd, 2)
    } else if vtype == 4 {
        gguf_skip(fd, 4)
    } else if vtype == 5 {
        gguf_skip(fd, 4)
    } else if vtype == 6 {
        gguf_skip(fd, 4)
    } else if vtype == 7 {
        gguf_skip(fd, 1)
    } else if vtype == 9 {
        gguf_skip_array(fd)
    } else if vtype == 10 {
        gguf_skip(fd, 8)
    } else if vtype == 11 {
        gguf_skip(fd, 8)
    } else if vtype == 12 {
        gguf_skip(fd, 8)
    } else {
        gguf_skip(fd, 4)
    }
}

fn gguf_print_info() {
    let i = 0
    let max_n = gguf_n_tensors
    if max_n > 20 { max_n = 20 }
    
    while i < max_n {
        let ndims = gguf_tensor_ndims(i)
        let dtype = gguf_tensor_dtype(i)
        let offset = gguf_tensor_offset(i)
        let nelements = gguf_tensor_nelements(i)
        
        gguf_print_tensor_name(i)
        print(" [")
        let d = 0
        while d < ndims {
            if d > 0 { print("x") }
            print(gguf_tensor_dim(i, d))
            d = d + 1
        }
        print("] type=")
        print(dtype)
        print(" off=")
        print(offset)
        print(" ne=")
        print(nelements)
        print("\n")
        i = i + 1
    }
    
    if gguf_n_tensors > 20 {
        print("... and ")
        print(gguf_n_tensors - 20)
        print(" more tensors\n")
    }
}

fn gguf_skip_array(fd) {
    let atype_buf = mem_alloc(4)
    read_raw(fd, atype_buf, 4)
    let atype = mem_load(atype_buf)
    let alen_buf = mem_alloc(8)
    read_raw(fd, alen_buf, 8)
    let alen = mem_load(alen_buf)
    
    if atype == 8 {
        let j = 0
        while j < alen {
            gguf_read_string(fd)
            j = j + 1
        }
    } else if atype == 0 {
        gguf_skip(fd, alen)
    } else if atype == 1 {
        gguf_skip(fd, alen)
    } else if atype == 2 {
        gguf_skip(fd, alen * 2)
    } else if atype == 3 {
        gguf_skip(fd, alen * 2)
    } else if atype == 4 {
        gguf_skip(fd, alen * 4)
    } else if atype == 5 {
        gguf_skip(fd, alen * 4)
    } else if atype == 6 {
        gguf_skip(fd, alen * 4)
    } else if atype == 7 {
        gguf_skip(fd, alen)
    } else if atype == 10 {
        gguf_skip(fd, alen * 8)
    } else if atype == 11 {
        gguf_skip(fd, alen * 8)
    } else if atype == 12 {
        gguf_skip(fd, alen * 8)
    } else {
        gguf_skip(fd, alen * 4)
    }
}

fn gguf_tensor_name(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE) }
fn gguf_tensor_ndims(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 8) }
fn gguf_tensor_dims(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 16) }
fn gguf_tensor_dtype(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 24) }
fn gguf_tensor_offset(idx) { return mem_load(gguf_tensors + idx * TINFO_SIZE + 32) }

fn gguf_print_tensor_name(idx) {
    let name_ptr = gguf_tensor_name(idx)
    if name_ptr != 0 {
        let slen = 0
        while mem_load8(name_ptr + slen) != 0 {
            slen = slen + 1
        }
        write_raw(1, name_ptr, slen)
    }
}

fn gguf_tensor_dim(idx, d) {
    let dims = gguf_tensor_dims(idx)
    return mem_load(dims + d * 8)
}

fn gguf_tensor_nelements(idx) {
    let ndims = gguf_tensor_ndims(idx)
    let n = 1
    let d = 0
    while d < ndims {
        n = n * gguf_tensor_dim(idx, d)
        d = d + 1
    }
    return n
}

fn gguf_find_tensor(name) {
    let name_len = len(name)
    let i = 0
    while i < gguf_n_tensors {
        let tname = gguf_tensor_name(i)
        if tname != 0 {
            let match = 1
            let j = 0
            while j < name_len {
                let tc = mem_load8(tname + j)
                let nc = mem_load8(name + 8 + j)
                if tc != nc {
                    match = 0
                    j = name_len
                }
                j = j + 1
            }
            if match == 1 {
                if mem_load8(tname + name_len) == 0 {
                    return i
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn gguf_close() {
    if gguf_fd >= 0 {
        close(gguf_fd)
        gguf_fd = -1
    }
}

fn gguf_num_tensors() { return gguf_n_tensors }
fn gguf_get_fd() { return gguf_fd }

fn gguf_read_tensor(idx) {
    let ndims = gguf_tensor_ndims(idx)
    let dtype = gguf_tensor_dtype(idx)
    let offset = gguf_tensor_offset(idx)
    let nelements = gguf_tensor_nelements(idx)
    
    let elem_size = 4
    if dtype == 0 { elem_size = 1 }
    else if dtype == 1 { elem_size = 1 }
    else if dtype == 2 { elem_size = 2 }
    else if dtype == 3 { elem_size = 2 }
    else if dtype == 6 { elem_size = 2 }
    else if dtype == 7 { elem_size = 1 }
    else if dtype == 8 { elem_size = 2 }
    else if dtype == 9 { elem_size = 2 }
    else if dtype == 10 { elem_size = 8 }
    else if dtype == 11 { elem_size = 8 }
    else if dtype == 12 { elem_size = 2 }
    else if dtype == 14 { elem_size = 2 }
    else if dtype == 15 { elem_size = 2 }
    else if dtype == 16 { elem_size = 2 }
    else if dtype == 17 { elem_size = 2 }
    else if dtype == 18 { elem_size = 2 }
    
    let data_size = nelements * elem_size
    let buf = mem_alloc(data_size)
    
    lseek(gguf_fd, offset, 0)
    read_raw(gguf_fd, buf, data_size)
    
    return buf
}

// Q4_K_M dequantization
fn gguf_dequant_q4km(raw, nelements) {
    let out = mem_alloc(nelements * 4)
    let n_blocks = nelements / 256
    
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 132
        
        let s0 = mem_load8(raw + bo)
        let s1 = mem_load8(raw + bo + 1)
        let scale = s0 + s1 * 256
        
        let m0 = mem_load8(raw + bo + 2)
        let m1 = mem_load8(raw + bo + 3)
        let min_val = m0 + m1 * 256
        
        let vi = 0
        while vi < 256 {
            let byte_idx = vi / 2
            let byte_val = mem_load8(raw + bo + 4 + byte_idx)
            
            let nibble = 0
            if vi % 2 == 0 {
                nibble = byte_val / 16
            } else {
                nibble = byte_val % 16
            }
            
            let val = (scale * nibble / 15) + min_val
            mem_store(out + (bi * 256 + vi) * 4, val)
            
            vi = vi + 1
        }
        
        bi = bi + 1
    }
    
    return out
}

// Matrix-vector multiplication: y = A * x
fn gguf_matvec(A, x, rows, cols, y) {
    let i = 0
    while i < rows {
        let sum = 0
        let j = 0
        while j < cols {
            let a_val = mem_load(A + (i * cols + j) * 4)
            let x_val = mem_load(x + j * 4)
            sum = sum + a_val * x_val
            j = j + 1
        }
        mem_store(y + i * 4, sum)
        i = i + 1
    }
}