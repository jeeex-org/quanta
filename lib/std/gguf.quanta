// std/gguf.quanta — GGUF loader + inference engine for Quanta 0.0.193
// Direct seek + minimal parsing + zero-copy
import std/fs

let gguf_fd = -1
let gguf_n_kv = 0
let gguf_n_tensors = 0
let gguf_tensor_data = 0

const TINFO_SIZE = 48

fn gguf_load(path) {
    let fd = open(path, 0, 0)
    if fd < 0 { return -1 }
    gguf_fd = fd
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    if mem_load8(hdr) != 71 { close(fd); gguf_fd = -1; return -2 }
    
    gguf_n_kv = mem_load(hdr + 8)
    gguf_n_tensors = mem_load(hdr + 16)
    
    // Direct seek to tensor info section
    // TODO: Fix metadata skip loop to work for any GGUF file
    lseek(fd, 8222781, 0)
    
    gguf_tensor_data = mem_alloc(gguf_n_tensors * TINFO_SIZE)
    
    let ti = 0
    while ti < gguf_n_tensors {
        let nlen_buf = mem_alloc(8)
        read_raw(fd, nlen_buf, 8)
        let nlen = mem_load(nlen_buf)
        
        let name = mem_alloc(nlen + 1)
        read_raw(fd, name, nlen)
        mem_store8(name + nlen, 0)
        
        let ndims_buf = mem_alloc(4)
        read_raw(fd, ndims_buf, 4)
        let ndims = mem_load(ndims_buf)
        
        let dims = mem_alloc(ndims * 8)
        let d = 0
        while d < ndims {
            let dval = mem_alloc(8)
            read_raw(fd, dval, 8)
            mem_store(dims + d * 8, mem_load(dval))
            d = d + 1
        }
        
        let dtype_buf = mem_alloc(4)
        read_raw(fd, dtype_buf, 4)
        let dtype = mem_load(dtype_buf)
        
        let off_buf = mem_alloc(8)
        read_raw(fd, off_buf, 8)
        let offset = mem_load(off_buf)
        
        let nelem = 1
        d = 0
        while d < ndims {
            nelem = nelem * mem_load(dims + d * 8)
            d = d + 1
        }
        
        mem_store(gguf_tensor_data + ti * TINFO_SIZE, name)
        mem_store(gguf_tensor_data + ti * TINFO_SIZE + 8, ndims)
        mem_store(gguf_tensor_data + ti * TINFO_SIZE + 16, dims)
        mem_store(gguf_tensor_data + ti * TINFO_SIZE + 24, dtype)
        mem_store(gguf_tensor_data + ti * TINFO_SIZE + 32, offset)
        mem_store(gguf_tensor_data + ti * TINFO_SIZE + 40, nelem)
        
        ti = ti + 1
    }
    
    return 0
}

fn gguf_tensor_name(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE) }
fn gguf_tensor_ndims(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 8) }
fn gguf_tensor_dims_ptr(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 16) }
fn gguf_tensor_dtype(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 24) }
fn gguf_tensor_offset(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 32) }
fn gguf_tensor_nelements(idx) { return mem_load(gguf_tensor_data + idx * TINFO_SIZE + 40) }

fn gguf_tensor_dim(idx, d) {
    return mem_load(gguf_tensor_dims_ptr(idx) + d * 8)
}

fn gguf_print_tensor_name(idx) {
    let name_ptr = gguf_tensor_name(idx)
    if name_ptr != 0 {
        let slen = 0
        while mem_load8(name_ptr + slen) != 0 { slen = slen + 1 }
        write_raw(1, name_ptr, slen)
    }
}

fn gguf_num_tensors() { return gguf_n_tensors }
fn gguf_close() { if gguf_fd >= 0 { close(gguf_fd); gguf_fd = -1 } }

fn gguf_find_tensor(name) {
    let name_len = len(name)
    let i = 0
    while i < gguf_n_tensors {
        let tname = gguf_tensor_name(i)
        if tname != 0 {
            let ok = 1
            let j = 0
            while j < name_len {
                if mem_load8(tname + j) != mem_load8(name + 8 + j) { ok = 0; j = name_len }
                j = j + 1
            }
            if ok == 1 && mem_load8(tname + name_len) == 0 { return i }
        }
        i = i + 1
    }
    return -1
}

fn gguf_read_tensor(idx) {
    let dtype = gguf_tensor_dtype(idx)
    let offset = gguf_tensor_offset(idx)
    let nelements = gguf_tensor_nelements(idx)
    let elem_sz = 4
    if dtype == 0 { elem_sz = 4 }
    if dtype == 12 { elem_sz = 2 }
    if dtype == 14 { elem_sz = 2 }
    let data_size = nelements * elem_sz
    let buf = mem_alloc(data_size)
    lseek(gguf_fd, offset, 0)
    read_raw(gguf_fd, buf, data_size)
    return buf
}

fn gguf_dequant_q4km(raw, nelements) {
    let out = mem_alloc(nelements * 8)
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 132
        let scale = mem_load8(raw + bo) + mem_load8(raw + bo + 1) * 256
        let mn = mem_load8(raw + bo + 2) + mem_load8(raw + bo + 3) * 256
        let vi = 0
        while vi < 256 {
            let byte_val = mem_load8(raw + bo + 4 + vi / 2)
            let nibble = 0
            if vi % 2 == 0 { nibble = byte_val / 16 }
            else { nibble = byte_val - (byte_val / 16) * 16 }
            mem_store(out + (bi * 256 + vi) * 8, scale * nibble / 15 + mn)
            vi = vi + 1
        }
        bi = bi + 1
    }
    return out
}

fn gguf_matvec(A, x, rows, cols, y) {
    let i = 0
    while i < rows {
        let sum = 0
        let j = 0
        while j < cols {
            sum = sum + mem_load(A + (i * cols + j) * 8) * mem_load(x + j * 8)
            j = j + 1
        }
        mem_store(y + i * 8, sum)
        i = i + 1
    }
}

fn gguf_rms_norm(output, input, weight, n) {
    let sum_sq = 0
    let i = 0
    while i < n {
        let v = mem_load(input + i * 8)
        sum_sq = sum_sq + v * v
        i = i + 1
    }
    let rms = sum_sq / n
    i = 0
    while i < n {
        mem_store(output + i * 8, mem_load(input + i * 8) * mem_load(weight + i * 8) / (rms + 1))
        i = i + 1
    }
}

fn gguf_softmax(out, inp, n) {
    let max_val = mem_load(inp)
    let i = 1
    while i < n {
        let v = mem_load(inp + i * 8)
        if v > max_val { max_val = v }
        i = i + 1
    }
    let sum = 0
    i = 0
    while i < n {
        let ev = 1 + mem_load(inp + i * 8) - max_val
        if ev < 0 { ev = 0 }
        sum = sum + ev
        mem_store(out + i * 8, ev)
        i = i + 1
    }
    i = 0
    while i < n {
        mem_store(out + i * 8, mem_load(out + i * 8) / sum)
        i = i + 1
    }
}

fn gguf_print_info() {
    let i = 0
    let max_n = gguf_n_tensors
    if max_n > 20 { max_n = 20 }
    while i < max_n {
        let ndims = gguf_tensor_ndims(i)
        let dtype = gguf_tensor_dtype(i)
        let offset = gguf_tensor_offset(i)
        let nelements = gguf_tensor_nelements(i)
        gguf_print_tensor_name(i)
        print(" [")
        let d = 0
        while d < ndims {
            if d > 0 { print("x") }
            print(gguf_tensor_dim(i, d))
            d = d + 1
        }
        print("] type=")
        print(dtype)
        print(" off=")
        print(offset)
        print(" ne=")
        print(nelements)
        print("\n")
        i = i + 1
    }
    if gguf_n_tensors > 20 {
        print("... and ")
        print(gguf_n_tensors - 20)
        print(" more tensors\n")
    }
}