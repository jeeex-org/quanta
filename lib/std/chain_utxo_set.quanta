// std/chain_utxo_set — minimal UTXO set (0.0.177)

const UTXO_SIZE = 81;

fn utxo_add(set: i64, count: i64, tx_hash: i64, output_idx: i64, addr: i64, amount: i64): i64 {
    let offset = count * UTXO_SIZE;
    // tx_hash (32 bytes)
    let i = 0;
    while i < 32 {
        mem_store8(set + offset + i, mem_load8(tx_hash + i));
        i = i + 1;
    }
    // output_idx (8 bytes)
    mem_store(set + offset + 32, output_idx);
    // address (32 bytes) - placeholder
    // amount (8 bytes)
    mem_store(set + offset + 72, amount);
    // spent flag (1 byte)
    mem_store8(set + offset + 80, 0);
    return count + 1;
}

fn init() -> i64 { return 0; }