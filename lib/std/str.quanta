// std/str - real string ops. A Quanta string is a header pointer:
//   [0]  = byte length (i64)
//   [8]  = first byte ... (length bytes follow)
// `len(s)` returns the byte length; `s + 8` is the byte buffer.
// `str(a,b)` concatenates two strings (builtin). Byte access via mem_load8/mem_store8.
// Import with:  import std/str

// Concatenate two strings (builtin str wrapper).
fn concat(a, b) {
  return str(a, b)
}

// Get the i-th byte of string s (0-based). Returns the byte value (0..255).
fn byte_at(s, i) {
  return mem_load8(s + 8 + i)
}

// Set the i-th byte of string s to v (0..255).
fn byte_set(s, i, v) {
  mem_store8(s + 8 + i, v)
}

// True if two strings are byte-equal.
fn equals(a, b) {
  let la = len(a)
  let lb = len(b)
  if la != lb { return 0 }
  let i = 0
  while i < la {
    if mem_load8(a + 8 + i) != mem_load8(b + 8 + i) { return 0 }
    i = i + 1
  }
  return 1
}

// Return a substring of s: count bytes starting at byte index `start`.
// Allocates a fresh string via mem_alloc (mirrors the str() header layout).
fn substr(s, start, count) {
  let buf = mem_alloc((count + 9 + 7) / 8)   // round up to 8-byte multiples
  mem_store(buf, count)                        // header: length
  let i = 0
  while i < count {
    mem_store8(buf + 8 + i, mem_load8(s + 8 + start + i))
    i = i + 1
  }
  return buf
}

// Parse a base-10 signed integer from string s. Supports an optional leading '-'.
 // Returns the i64 value (0 if no digits).
 fn parse_i64(s) {
   let n = len(s)
   let i = 0
   let neg = 0
   if n > 0 {
     let c0 = mem_load8(s + 8)
     if c0 == 45 { neg = 1; i = 1 }   // '-'
   }
   let val = 0
   while i < n {
     let c = mem_load8(s + 8 + i)
     if c < 48 || c > 57 { return val }   // not a digit -> stop
     val = val * 10 + (c - 48)
     i = i + 1
   }
   if neg == 1 { return 0 - val }
   return val
 }

// =====================================================================
// String formatting (minimal for model_arch tensor names)
// =====================================================================

// Copy a C-string literal into a Quanta string buffer.
// dst must have at least src_len + 9 bytes allocated.
// Returns the number of bytes written (excluding NUL), or -1 if truncated.
fn str_copy(dst: u64, src: u64, dst_cap: i64) -> i64 {
    let i = 0
    // src is a literal: its length is in the first qword
    let src_len = len(src)
    if src_len + 1 > dst_cap { return 0 - 1 }
    while i < src_len {
        mem_store8(dst + 8 + i, mem_load8(src + 8 + i))
        i = i + 1
    }
    mem_store8(dst + 8 + i, 0)  // NUL-terminate
    mem_store(dst, i)           // set length
    return i
}

// Format "prefix{num}suffix" into dst.
// Only supports %d (decimal i64) as the single format specifier.
// Returns bytes written (excluding NUL), or -1 on error.
fn str_fmt(dst: u64, dst_cap: i64, fmt: u64, val: i64) -> i64 {
    // Find the %d in fmt
    let fmt_len = len(fmt)
    let pct = -1
    let i = 0
    while i < fmt_len {
        if mem_load8(fmt + 8 + i) == 37 && i + 1 < fmt_len && mem_load8(fmt + 8 + i + 1) == 100 {  // '%' 'd'
            pct = i
            break
        }
        i = i + 1
    }
    if pct < 0 { return 0 - 1 }  // no %d found

    // Convert val to decimal string
    let num_buf = mem_alloc(32)
    let neg = 0
    let v = val
    if v < 0 { neg = 1; v = 0 - v }
    let num_len = 0
    if v == 0 {
        mem_store8(num_buf, 48)  // '0'
        num_len = 1
    } else {
        // Write digits in reverse
        let rev = 0
        while v > 0 {
            mem_store8(num_buf + rev, 48 + (v % 10))
            v = v / 10
            rev = rev + 1
        }
        num_len = rev
        // Reverse into final position
        let j = 0
        while j < num_len {
            mem_store8(num_buf + j, mem_load8(num_buf + num_len - 1 - j))
            j = j + 1
        }
    }
    if neg == 1 {
        // Shift right and prepend '-'
        let j = num_len
        while j > 0 {
            mem_store8(num_buf + j, mem_load8(num_buf + j - 1))
            j = j - 1
        }
        mem_store8(num_buf, 45)  // '-'
        num_len = num_len + 1
    }

    // Build: prefix + num + suffix
    let prefix_len = pct
    let suffix_len = fmt_len - pct - 2
    let total = prefix_len + num_len + suffix_len
    if total + 1 > dst_cap { return 0 - 1 }

    // Copy prefix
    let i = 0
    while i < prefix_len {
        mem_store8(dst + 8 + i, mem_load8(fmt + 8 + i))
        i = i + 1
    }
    // Copy number
    let j = 0
    while j < num_len {
        mem_store8(dst + 8 + i, mem_load8(num_buf + j))
        i = i + 1
        j = j + 1
    }
    // Copy suffix
    let k = 0
    while k < suffix_len {
        mem_store8(dst + 8 + i, mem_load8(fmt + 8 + pct + 2 + k))
        i = i + 1
        k = k + 1
    }
    mem_store8(dst + 8 + i, 0)
    mem_store(dst, i)
    return i
}
