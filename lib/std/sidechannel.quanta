fn cache_line_size(): i64 { return 64 }

fn ct_eq32_test(): i64 {
    let a = ct_eq32(5, 5)
    let b = ct_eq32(5, 6)
    if a != 0 { return 1 }
    if b != 1 { return 2 }
    return 0
}

fn ct_eq64_test(): i64 {
    let a = ct_eq64(100, 100)
    let b = ct_eq64(100, 200)
    if a != 0 { return 1 }
    if b != 1 { return 2 }
    return 0
}

fn ct_select32_test(): i64 {
    let a = ct_select32(1, 10, 20)
    let b = ct_select32(0, 10, 20)
    if a != 10 { return 1 }
    if b != 20 { return 2 }
    return 0
}

fn ct_memcmp_test(): i64 {
    let a = "hello"
    let b = "hello"
    let c = "world"
    let r1 = ct_memcmp(a, b, 5)
    let r2 = ct_memcmp(a, c, 5)
    if r1 != 0 { return 1 }
    if r2 == 0 { return 2 }
    return 0
}

fn kdf_algo_pbkdf2(): i64 { return 1 }
fn kdf_algo_scrypt(): i64 { return 2 }
fn kdf_algo_argon2id(): i64 { return 3 }
fn kdf_algo_hkdf(): i64 { return 4 }

fn main() {
    if cache_line_size() != 64 { return 1 }
    if ct_eq32_test() != 0 { return 2 }
    if ct_eq64_test() != 0 { return 3 }
    if ct_select32_test() != 0 { return 4 }
    if ct_memcmp_test() != 0 { return 5 }
    return 0
}