// ============================================================================
// Secure memory allocator (cache-line aligned, zero-on-free)
// ============================================================================

// Allocate secure memory (cache-aligned, zeroed)
fn secure_alloc(size) {
    let ptr = cache_aligned_alloc(size)
    if ptr == 0 { return 0 }
    ct_memset(ptr, 0, size)
    return ptr
}

// Free secure memory (zero before free)
fn secure_free(ptr, size) {
    if ptr == 0 { return }
    ct_memset(ptr, 0, size)
    mem_free(ptr)
}

// Secure memory pool for sensitive operations
let secure_pool = 0
let secure_pool_size = 0
let secure_pool_used = 0

fn secure_pool_init(size) {
    secure_pool = cache_aligned_alloc(size)
    if secure_pool == 0 { return -1 }
    secure_pool_size = size
    secure_pool_used = 0
    ct_memset(secure_pool, 0, size)
    return 0
}

fn secure_pool_alloc(size) {
    let aligned_size = (size + CACHE_LINE_SIZE - 1) & ~(CACHE_LINE_SIZE - 1)
    if secure_pool_used + aligned_size > secure_pool_size { return 0 }
    
    let ptr = secure_pool + secure_pool_used
    secure_pool_used = secure_pool_used + aligned_size
    return ptr
}

fn secure_pool_free() {
    if secure_pool != 0 {
        ct_memset(secure_pool, 0, secure_pool_size)
        mem_free(secure_pool)
        secure_pool = 0
        secure_pool_size = 0
        secure_pool_used = 0
    }
    return 0
}

// ============================================================================
// Timing attack detection (for testing)
// ============================================================================

// Measure execution time (for side-channel testing)
let timing_samples = 0
let timing_sample_count = 0
let timing_sample_cap = 0

fn timing_init(max_samples) {
    if timing_samples != 0 { mem_free(timing_samples) }
    timing_samples = mem_alloc(max_samples * 8)
    timing_sample_count = 0
    timing_sample_cap = max_samples
    return 0
}

fn timing_start() {
    return clock()
}

fn timing_end(start_time) {
    let end = clock()
    let elapsed = end - start_time
    
    if timing_sample_count < timing_sample_cap {
        w64(timing_samples + timing_sample_count * 8, elapsed)
        timing_sample_count = timing_sample_count + 1
    }
    return elapsed
}

fn timing_get_samples(out, count) {
    if count > timing_sample_count { count = timing_sample_count }
    let i = 0
    while i < count {
        w64(out + i * 8, r64(timing_samples + i * 8))
        i = i + 1
    }
    return count
}

fn timing_stats() {
    if timing_sample_count == 0 { return }
    
    let sum = 0
    let min = r64(timing_samples)
    let max = min
    let i = 0
    while i < timing_sample_count {
        let val = r64(timing_samples + i * 8)
        sum = sum + val
        if val < min { min = val }
        if val > max { max = val }
        i = i + 1
    }
    
    let mean = sum / timing_sample_count
    
    // Variance
    let var_sum = 0
    i = 0
    while i < timing_sample_count {
        let val = r64(timing_samples + i * 8)
        let diff = val - mean
        if diff < 0 { diff = -diff }
        var_sum = var_sum + diff * diff
        i = i + 1
    }
    let variance = var_sum / timing_sample_count
    
    // Return stats (in practice would use a struct)
    // For now just return mean
    return mean
}

fn timing_free() {
    if timing_samples != 0 { mem_free(timing_samples) }
    timing_samples = 0
    timing_sample_count = 0
    timing_sample_cap = 0
}

