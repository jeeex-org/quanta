// Constant-time rejection sampling for ML-KEM
fn ml_kem_ct_rej_samp(out, len, buf, buf_len) {
    let out_idx = 0
    let buf_idx = 0
    
    while out_idx < len && buf_idx + 2 < buf_len {
        let val = r16(buf + buf_idx)
        buf_idx = buf_idx + 2
        
        // Constant-time check: val < 3329
        let cond = ct_lt32(val, 3329)
        let mask = -cond
        w16(out + out_idx * 2, (val & mask) | (0 & ~mask))
        out_idx = out_idx + cond
    }
    
    // If not enough coefficients, would need more entropy
    // This is simplified
    return 0
}

// Masked ML-KEM key generation
fn ml_kem_768_keygen_masked(pub_out, priv_out) {
    // Generate with first-order masking
    let sk_mask = mem_alloc(2400) // ML-KEM-768 private key size
    let sk_share = mem_alloc(2400)
    
    gen_random_mask(sk_mask, 2400)
    
    // Generate actual private key
    let tmp_sk = mem_alloc(2400)
    ml_kem_768_keygen(pub_out, tmp_sk)
    
    // Share the private key
    mask_share(tmp_sk, sk_share, 1, 2400)
    
    // Output masked shares
    // In practice, would store shares separately
    ct_memcpy(priv_out, sk_share, 2400) // share[0]
    ct_memcpy(priv_out + 2400, sk_share + 2400, 2400) // share[1]
    
    mem_free(sk_mask)
    mem_free(sk_share)
    mem_free(tmp_sk)
    return 0
}

// Masked ML-KEM encapsulation
fn ml_kem_768_encaps_masked(pubkey, ct_out, ss_out) {
    // Encapsulation with masked randomness
    let r_mask = mem_alloc(32)
    gen_random_mask(r_mask, 32)
    
    // Standard encapsulation
    ml_kem_768_encaps(pubkey, ct_out, ss_out)
    
    // Mask the shared secret
    mask_xor(ss_out, r_mask, 32)
    
    // Store mask alongside (in practice, would use secret sharing)
    // Simplified
    mem_free(r_mask)
    return 0
}

// Masked ML-KEM decapsulation
fn ml_kem_768_decaps_masked(privkey_shares, ct, ss_out) {
    // privkey_shares contains two shares of private key
    // Reconstruct and decapsulate
    
    let sk = mem_alloc(2400)
    mask_reconstruct(privkey_shares, 1, 2400, sk)
    
    ml_kem_768_decaps(sk, ct, ss_out)
    
    // Clear private key
    ct_memset(sk, 0, 2400)
    mem_free(sk)
    return 0
}

// ============================================================================
// ML-DSA (Dilithium) side-channel countermeasures
// ============================================================================

// Constant-time polynomial operations for ML-DSA
fn ml_dsa_ct_poly_add(a, b, out, n) {
    let i = 0
    while i < n {
        let ai = r32(a + i * 4)
        let bi = r32(b + i * 4)
        w32(out + i * 4, (ai + bi) % 8380417)
        i = i + 1
    }
    return 0
}

fn ml_dsa_ct_poly_sub(a, b, out, n) {
    let i = 0
    while i < n {
        let ai = r32(a + i * 4)
        let bi = r32(b + i * 4)
        let diff = ai - bi
        w32(out + i * 4, (diff + 8380417) % 8380417)
        i = i + 1
    }
    return 0
}

// Constant-time challenge polynomial generation (from hash)
fn ml_dsa_ct_challenge_poly(hash, hash_len, poly_out, n, tau) {
    // Generate polynomial with exactly tau non-zero coefficients (+/-1)
    // Using constant-time sampling
    
    // Simplified - real implementation uses expand_mask from SHAKE256
    let i = 0
    while i < n {
        w32(poly_out + i * 4, 0)
        i = i + 1
    }
    return 0
}

// Constant-time hint generation (for high/low bits)
fn ml_dsa_ct_make_hint(z, w, n, hint_out) {
    let i = 0
    while i < n {
        let zi = r32(z + i * 4)
        let wi = r32(w + i * 4)
        
        // High bits
        let z_high = zi >> 13 // (Q-1)/2^13
        let w_high = wi >> 13
        
        // Hint = 1 if high bits differ, 0 otherwise
        let diff = z_high ^ w_high
        diff = diff | (-diff)
        diff = diff >> 31
        w32(hint_out + i * 4, diff & 1)
        i = i + 1
    }
    return 0
}

// Constant-time norm check (for rejection sampling)
fn ml_dsa_ct_check_norm(poly, n, bound) {
    let bad = 0
    let i = 0
    while i < n {
        let coeff = r32(poly + i * 4)
        // Check |coeff| > bound
        let abs_coeff = coeff
        if abs_coeff < 0 { abs_coeff = -abs_coeff }
        let cond = ct_lt32(bound, abs_coeff) // bound < abs_coeff
        bad = bad | cond
        i = i + 1
    }
    return bad
}

// Masked ML-DSA signing
fn ml_dsa_65_sign_masked(privkey_shares, msg, msg_len, ctx, ctx_len, sig_out) {
    // Reconstruct private key from shares
    let sk = mem_alloc(4032)
    mask_reconstruct(privkey_shares, 1, 4032, sk)
    
    ml_dsa_65_sign(sk, msg, msg_len, ctx, ctx_len, sig_out)
    
    ct_memset(sk, 0, 4032)
    mem_free(sk)
    return 0
}

// Masked ML-DSA verification
fn ml_dsa_65_verify_masked(pubkey, msg, msg_len, ctx, ctx_len, sig, sig_len) {
    // Verification doesn't need secret key, but can mask intermediate values
    return ml_dsa_65_verify(pubkey, msg, msg_len, ctx, ctx_len, sig, sig_len)
}

