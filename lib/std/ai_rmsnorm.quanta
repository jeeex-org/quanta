// std/ai_rmsnorm — RMSNorm (0.0.170)
// out = x / sqrt(mean(x^2) + eps) * weight

import std/ai_tensor

fn ai_rmsnorm(out: i64[], x: i64[], w: i64[], n: i64, eps: i64): i64 {
    let ms: i64 = i2f(0)
    let i: i64 = 0
    while i < n {
        let v: i64 = mem_load(x[0] + i * 8)
        ms = fadd(ms, fmul(v, v))
        i = i + 1
    }
    ms = fdiv(ms, i2f(n))
    let ir: i64 = fdiv(i2f(1), sqrt(fadd(ms, eps)))
    i = 0
    while i < n {
        let v: i64 = mem_load(x[0] + i * 8)
        let wv: i64 = mem_load(w[0] + i * 8)
        mem_store(out[0] + i * 8, fmul(fmul(v, ir), wv))
        i = i + 1
    }
    return 0
}
