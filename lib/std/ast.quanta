// std/ast.quanta - Abstract Syntax Tree for Quanta

const AST_MODULE = 1;
const AST_FN = 2;
const AST_CONST = 3;
const AST_PARAM = 4;
const AST_BINOP = 5;
const AST_UNOP = 6;
const AST_CALL = 7;
const AST_RET = 8;
const AST_IF = 9;
const AST_LOOP = 10;
const AST_STRUCT = 11;
const AST_FIELD = 12;
const AST_INDEX = 13;
const AST_VAR = 14;
const AST_ASSIGN = 15;
const AST_LITERAL = 16;
const AST_STRING = 17;

module std_ast;

fn ast_node(kind) {
    return { "kind": kind, "children": [] };
}

fn ast_add_child(parent, child) {
    parent["children"].push(child);
    return parent;
}

fn ast_module(name, body) {
    let node = ast_node(AST_MODULE);
    node["name"] = name;
    node["body"] = body;
    return node;
}

fn ast_fn(name, params, body, ret_type) {
    let node = ast_node(AST_FN);
    node["name"] = name;
    node["params"] = params;
    node["body"] = body;
    node["ret_type"] = ret_type;
    return node;
}

fn ast_const(name, value, type) {
    let node = ast_node(AST_CONST);
    node["name"] = name;
    node["value"] = value;
    node["type"] = type;
    return node;
}

fn ast_param(name, type) {
    let node = ast_node(AST_PARAM);
    node["name"] = name;
    node["type"] = type;
    return node;
}

fn ast_binop(op, left, right) {
    let node = ast_node(AST_BINOP);
    node["op"] = op;
    node["left"] = left;
    node["right"] = right;
    return node;
}

fn ast_unop(op, operand) {
    let node = ast_node(AST_UNOP);
    node["op"] = op;
    node["operand"] = operand;
    return node;
}

fn ast_call(fn_name, args) {
    let node = ast_node(AST_CALL);
    node["fn"] = fn_name;
    node["args"] = args;
    return node;
}

fn ast_ret(expr) {
    let node = ast_node(AST_RET);
    node["expr"] = expr;
    return node;
}

fn ast_if(cond, then_branch, else_branch) {
    let node = ast_node(AST_IF);
    node["cond"] = cond;
    node["then"] = then_branch;
    node["else"] = else_branch;
    return node;
}

fn ast_loop(body, cond) {
    let node = ast_node(AST_LOOP);
    node["body"] = body;
    node["cond"] = cond;
    return node;
}

fn ast_struct(name, fields) {
    let node = ast_node(AST_STRUCT);
    node["name"] = name;
    node["fields"] = fields;
    return node;
}

fn ast_field(base, name) {
    let node = ast_node(AST_FIELD);
    node["base"] = base;
    node["name"] = name;
    return node;
}

fn ast_index(base, index) {
    let node = ast_node(AST_INDEX);
    node["base"] = base;
    node["index"] = index;
    return node;
}

fn ast_var(name) {
    let node = ast_node(AST_VAR);
    node["name"] = name;
    return node;
}

fn ast_assign(target, value) {
    let node = ast_node(AST_ASSIGN);
    node["target"] = target;
    node["value"] = value;
    return node;
}

fn ast_literal(value, type) {
    let node = ast_node(AST_LITERAL);
    node["value"] = value;
    node["type"] = type;
    return node;
}

fn ast_string(value) {
    let node = ast_node(AST_STRING);
    node["value"] = value;
    return node;
}

fn init() -> i64 {
    return 0;
}