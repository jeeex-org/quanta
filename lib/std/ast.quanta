// std/ast — Abstract Syntax Tree nodes
const AST_MODULE = 0
const AST_FN = 1
const AST_STRUCT = 2
const AST_ENUM = 3
const AST_IMPL = 4
const AST_TRAIT = 5
const AST_CONST = 6
const AST_GLOBAL = 7
const AST_IMPORT = 8
const AST_EXPR_BINARY = 10
const AST_EXPR_UNARY = 11
const AST_EXPR_CALL = 12
const AST_EXPR_LITERAL = 13
const AST_EXPR_VAR = 14
const AST_EXPR_FIELD = 15
const AST_EXPR_INDEX = 16
const AST_EXPR_IF = 17
const AST_EXPR_WHILE = 18
const AST_EXPR_FOR = 19
const AST_EXPR_MATCH = 20
const AST_EXPR_BLOCK = 21
const AST_EXPR_RETURN = 22
const AST_EXPR_BREAK = 23
const AST_EXPR_CONTINUE = 24
const AST_EXPR_ASSIGN = 25
const AST_EXPR_CAST = 26
const AST_EXPR_ASM = 27
const AST_STMT_LET = 30
const AST_STMT_EXPR = 31
const AST_STMT_RETURN = 32

fn ast_node(kind) {
    let node = mmap(48)
    w8(node, kind)
    return node
}

fn ast_set_child(parent, idx, child) {
    w64(parent + 8 + idx * 8, child)
}

fn ast_get_child(parent, idx) {
    r64(parent + 8 + idx * 8)
}

fn ast_kind(node) {
    r8(node)
}