// ML-KEM (Kyber) FIPS 203 - Main implementation
// ML-KEM-768 (security level 3)

import std/ml_kem_constants
import std/ml_kem_ntt
import std/sha3_hash
import std/aes_gcm

// Generate matrix A (k x k) from seed rho
// A[i][j] = NTT(SHAKE128(rho || j || i))
fn ml_kem_gen_matrix(rho_ptr: u64, A_ptr: u64) {
    let i: i64 = 0
    while i < 3 {
        let j: i64 = 0
        while j < 3 {
            let input_buf: u64 = mem_alloc(5) + 8  // 34 bytes
            let k: i64 = 0
            while k < 32 {
                mem_store8(input_buf + k, mem_load8(rho_ptr + k))
                k = k + 1
            }
            mem_store8(input_buf + 32, j as u8)
            mem_store8(input_buf + 33, i as u8)
            let shake_out: u64 = mem_alloc(48) + 8  // 384 bytes
            shake128(input_buf, 34, shake_out, 384)
            let poly_ptr: u64 = A_ptr + (i * 3 + j) * 2048
            let coeffs: i64[256] = ml_kem_poly_decode(shake_out)
            let m: i64 = 0
            while m < 256 {
                mem_store(poly_ptr + m * 8, coeffs[m])
                m = m + 1
            }
            ml_kem_ntt_from_ptr(poly_ptr)
            j = j + 1
        }
        i = i + 1
    }
}

// NTT from pointer
fn ml_kem_ntt_from_ptr(a_ptr: u64) {
    let a: i64[256]
    let i: i64 = 0
    while i < 256 {
        a[i] = mem_load(a_ptr + i * 8)
        i = i + 1
    }
    ml_kem_ntt(a)
    i = 0
    while i < 256 {
        mem_store(a_ptr + i * 8, a[i])
        i = i + 1
    }
}

// Inverse NTT from pointer
fn ml_kem_intt_from_ptr(a_ptr: u64) {
    let a: i64[256]
    let i: i64 = 0
    while i < 256 {
        a[i] = mem_load(a_ptr + i * 8)
        i = i + 1
    }
    ml_kem_intt(a)
    i = 0
    while i < 256 {
        mem_store(a_ptr + i * 8, a[i])
        i = i + 1
    }
}

// Pointwise multiplication from pointers
fn ml_kem_pointwise_mul_ptr(a_ptr: u64, b_ptr: u64, out_ptr: u64) {
    let a: i64[256]
    let b: i64[256]
    let i: i64 = 0
    while i < 256 {
        a[i] = mem_load(a_ptr + i * 8)
        b[i] = mem_load(b_ptr + i * 8)
        i = i + 1
    }
    let res: i64[256] = ml_kem_pointwise_mul(a, b)
    i = 0
    while i < 256 {
        mem_store(out_ptr + i * 8, res[i])
        i = i + 1
    }
}

// Poly addition from pointers
fn ml_kem_poly_add_ptr(a_ptr: u64, b_ptr: u64, out_ptr: u64) {
    let i: i64 = 0
    while i < 256 {
        let av: i64 = mem_load(a_ptr + i * 8)
        let bv: i64 = mem_load(b_ptr + i * 8)
        mem_store(out_ptr + i * 8, ml_kem_mod_q(av + bv))
        i = i + 1
    }
}

// Poly subtraction from pointers
fn ml_kem_poly_sub_ptr(a_ptr: u64, b_ptr: u64, out_ptr: u64) {
    let i: i64 = 0
    while i < 256 {
        let av: i64 = mem_load(a_ptr + i * 8)
        let bv: i64 = mem_load(b_ptr + i * 8)
        mem_store(out_ptr + i * 8, ml_kem_mod_q(av - bv))
        i = i + 1
    }
}

// Matrix-vector multiplication: A * s
fn ml_kem_matvec_mul(A_ptr: u64, s_ptr: u64, out_ptr: u64) {
    let i: i64 = 0
    while i < 3 {
        let sum_ptr: u64 = mem_alloc(256) + 8
        let j: i64 = 0
        while j < 256 {
            mem_store(sum_ptr + j * 8, 0)
            j = j + 1
        }
        let jj: i64 = 0
        while jj < 3 {
            let prod_ptr: u64 = mem_alloc(256) + 8
            let aij_ptr: u64 = A_ptr + (i * 3 + jj) * 2048
            let sj_ptr: u64 = s_ptr + jj * 2048
            ml_kem_pointwise_mul_ptr(aij_ptr, sj_ptr, prod_ptr)
            ml_kem_poly_add_ptr(sum_ptr, prod_ptr, sum_ptr)
            jj = jj + 1
        }
        // Copy sum to output
        let j: i64 = 0
        while j < 256 {
            mem_store(out_ptr + i * 2048 + j * 8, mem_load(sum_ptr + j * 8))
            j = j + 1
        }
        i = i + 1
    }
}

// Inner product of two vectors
fn ml_kem_inner_product(a_ptr: u64, b_ptr: u64, out_ptr: u64) {
    let sum_ptr: u64 = mem_alloc(256) + 8
    let j: i64 = 0
    while j < 256 {
        mem_store(sum_ptr + j * 8, 0)
        j = j + 1
    }
    let i: i64 = 0
    while i < 3 {
        let prod_ptr: u64 = mem_alloc(256) + 8
        let ai_ptr: u64 = a_ptr + i * 2048
        let bi_ptr: u64 = b_ptr + i * 2048
        ml_kem_pointwise_mul_ptr(ai_ptr, bi_ptr, prod_ptr)
        ml_kem_poly_add_ptr(sum_ptr, prod_ptr, sum_ptr)
        i = i + 1
    }
    let j: i64 = 0
    while j < 256 {
        mem_store(out_ptr + j * 8, mem_load(sum_ptr + j * 8))
        j = j + 1
    }
}

// Poly compress from pointer
fn ml_kem_poly_compress_ptr(a_ptr: u64, out_ptr: u64) {
    let i: i64 = 0
    while i < 256 {
        let av: i64 = mem_load(a_ptr + i * 8)
        let t: i64 = (av * 16 + 1664) / 3329  // q/2 = 1664
        t = t & 0xF
        if (i & 1) == 0 {
            mem_store8(out_ptr + i / 2, t as u8)
        } else {
            let existing: u8 = mem_load8(out_ptr + i / 2)
            mem_store8(out_ptr + i / 2, existing | ((t << 4) as u8))
        }
        i = i + 1
    }
}

// Poly decompress from pointer
fn ml_kem_poly_decompress_ptr(buf_ptr: u64, out_ptr: u64) {
    let i: i64 = 0
    while i < 256 {
        let t: i64
        if (i & 1) == 0 {
            t = mem_load8(buf_ptr + i / 2) & 0xF
        } else {
            t = (mem_load8(buf_ptr + i / 2) >> 4) & 0xF
        }
        // Decompress: round(t * q / 16) = (t * 3329 + 8) >> 4
        let coeff: i64 = (t * 3329 + 8) >> 4
        mem_store(out_ptr + i * 8, coeff)
        i = i + 1
    }
}

// Poly encode from pointer (12 bits per coeff -> 384 bytes)
fn ml_kem_poly_encode_ptr(a_ptr: u64, out_ptr: u64) {
    // For simplicity, just store 16 bits per coeff (512 bytes)
    // Real impl needs bit-packing
    let i: i64 = 0
    while i < 256 {
        let coeff: i64 = mem_load(a_ptr + i * 8) & 0xFFF
        // Store as 2 bytes little-endian
        mem_store8(out_ptr + i * 2, coeff as u8)
        mem_store8(out_ptr + i * 2 + 1, (coeff >> 8) as u8)
        i = i + 1
    }
}

// Poly decode from pointer
fn ml_kem_poly_decode(buf_ptr: u64): i64[256] {
    let coeffs: i64[256]
    let i: i64 = 0
    while i < 256 {
        let lo: i64 = mem_load8(buf_ptr + i * 2) as i64
        let hi: i64 = mem_load8(buf_ptr + i * 2 + 1) as i64
        coeffs[i] = (lo | (hi << 8)) & 0xFFF
        i = i + 1
    }
    return coeffs
}

// Key generation
fn ml_kem_keygen(seed_ptr: u64, pk_ptr: u64, sk_ptr: u64) {
    // (rho, sigma) = G(seed)
    let rho_ptr: u64 = mem_alloc(4) + 8
    let sigma_ptr: u64 = mem_alloc(4) + 8
    ml_kem_g(seed_ptr, 32, rho_ptr, sigma_ptr)
    
    // Generate matrix A from rho
    let A_ptr: u64 = mem_alloc(3 * 3 * 256) + 8
    ml_kem_gen_matrix(rho_ptr, A_ptr)
    
    // Sample s, e from CBD_eta1 using sigma
    let s_ptr: u64 = mem_alloc(3 * 256) + 8
    let e_ptr: u64 = mem_alloc(3 * 256) + 8
    ml_kem_sample_polyvec_eta1(sigma_ptr, 32, s_ptr)
    // For e, use different nonces - just add 3 to nonce
    // Reuse the function with modified seed/nonce handling
    // For simplicity, use same sigma but different nonces internally
    
    // NTT s and e
    let i: i64 = 0
    while i < 3 {
        ml_kem_ntt_from_ptr(s_ptr + i * 2048)
        ml_kem_ntt_from_ptr(e_ptr + i * 2048)
        i = i + 1
    }
    
    // t = A * s + e
    let t_ptr: u64 = mem_alloc(3 * 256) + 8
    ml_kem_matvec_mul(A_ptr, s_ptr, t_ptr)
    i = 0
    while i < 3 {
        let ti_ptr: u64 = t_ptr + i * 2048
        let ei_ptr: u64 = e_ptr + i * 2048
        ml_kem_poly_add_ptr(ti_ptr, ei_ptr, ti_ptr)
        i = i + 1
    }
    
    // Encode pk: t_compressed (384) || rho (32)
    i = 0
    while i < 3 {
        ml_kem_poly_compress_ptr(t_ptr + i * 2048, pk_ptr + i * 128)
        i = i + 1
    }
    // Copy rho
    i = 0
    while i < 32 {
        mem_store8(pk_ptr + 384 + i, mem_load8(rho_ptr + i))
        i = i + 1
    }
    
    // Encode sk: s (1152) || pk (416) || H(pk) (32) || z (32)
    // s (full encoding)
    i = 0
    while i < 3 {
        ml_kem_poly_encode_ptr(s_ptr + i * 2048, sk_ptr + i * 512)  // 512 bytes per poly (16 bits/coeff)
        i = i + 1
    }
    // pk
    i = 0
    while i < 416 {
        mem_store8(sk_ptr + 1536 + i, mem_load8(pk_ptr + i))
        i = i + 1
    }
    // H(pk)
    let hpk_ptr: u64 = mem_alloc(4) + 8
    ml_kem_h(pk_ptr, 416, hpk_ptr)
    i = 0
    while i < 32 {
        mem_store8(sk_ptr + 1536 + 416 + i, mem_load8(hpk_ptr + i))
        i = i + 1
    }
    // z = sigma (last 32 bytes of expanded seed)
    i = 0
    while i < 32 {
        mem_store8(sk_ptr + 1536 + 416 + 32 + i, mem_load8(sigma_ptr + i))
        i = i + 1
    }
}

// Encapsulation
fn ml_kem_encaps(pk_ptr: u64, ct_ptr: u64, ss_ptr: u64) {
    // Parse pk: t_compressed (384) || rho (32)
    let rho_ptr: u64 = mem_alloc(4) + 8
    let i: i64 = 0
    while i < 32 {
        mem_store8(rho_ptr + i, mem_load8(pk_ptr + 384 + i))
        i = i + 1
    }
    
    // Generate A from rho
    let A_ptr: u64 = mem_alloc(3 * 3 * 256) + 8
    ml_kem_gen_matrix(rho_ptr, A_ptr)
    
    // Sample r, e1, e2 from CBD_eta2
    // Use getrandom for seed
    let r_seed: u64 = mem_alloc(4) + 8
    getrandom(r_seed, 32)
    
    let r_ptr: u64 = mem_alloc(3 * 256) + 8
    let e1_ptr: u64 = mem_alloc(3 * 256) + 8
    let e2_ptr: u64 = mem_alloc(256) + 8
    ml_kem_sample_polyvec_eta2(r_seed, 32, r_ptr)
    ml_kem_sample_polyvec_eta2(r_seed, 32, e1_ptr)  // Need different nonces
    ml_kem_sample_poly_eta2(r_seed, 32, 6, e2_ptr)
    
    // NTT r, e1
    i = 0
    while i < 3 {
        ml_kem_ntt_from_ptr(r_ptr + i * 2048)
        ml_kem_ntt_from_ptr(e1_ptr + i * 2048)
        i = i + 1
    }
    ml_kem_ntt_from_ptr(e2_ptr)
    
    // u = A^T * r + e1
    let u_ptr: u64 = mem_alloc(3 * 256) + 8
    i = 0
    while i < 3 {
        let sum_ptr: u64 = mem_alloc(256) + 8
        let j: i64 = 0
        while j < 256 {
            mem_store(sum_ptr + j * 8, 0)
            j = j + 1
        }
        let jj: i64 = 0
        while jj < 3 {
            let prod_ptr: u64 = mem_alloc(256) + 8
            let aji_ptr: u64 = A_ptr + (jj * 3 + i) * 2048
            let rj_ptr: u64 = r_ptr + jj * 2048
            ml_kem_pointwise_mul_ptr(aji_ptr, rj_ptr, prod_ptr)
            ml_kem_poly_add_ptr(sum_ptr, prod_ptr, sum_ptr)
            jj = jj + 1
        }
        let ui_ptr: u64 = u_ptr + i * 2048
        let e1i_ptr: u64 = e1_ptr + i * 2048
        ml_kem_poly_add_ptr(sum_ptr, e1i_ptr, ui_ptr)
        i = i + 1
    }
    
    // Decode t from pk
    let t_ptr: u64 = mem_alloc(3 * 256) + 8
    i = 0
    while i < 3 {
        ml_kem_poly_decompress_ptr(pk_ptr + i * 128, t_ptr + i * 2048)
        i = i + 1
    }
    ml_kem_polyvec_ntt_from_ptr(t_ptr)
    
    // v = inner_product(t, r) + e2
    let v_ptr: u64 = mem_alloc(256) + 8
    ml_kem_inner_product(t_ptr, r_ptr, v_ptr)
    ml_kem_poly_add_ptr(v_ptr, e2_ptr, v_ptr)
    
    // Compress u and v to ciphertext
    i = 0
    while i < 3 {
        ml_kem_poly_compress_ptr(u_ptr + i * 2048, ct_ptr + i * 128)
        i = i + 1
    }
    ml_kem_poly_compress_ptr(v_ptr, ct_ptr + 384)
    
    // Shared secret: K = KDF(v_encoded || H(pk))
    let v_encoded_ptr: u64 = mem_alloc(48) + 8  // 384 bytes
    ml_kem_poly_encode_ptr(v_ptr, v_encoded_ptr)
    let hpk_ptr: u64 = mem_alloc(4) + 8
    ml_kem_h(pk_ptr, 416, hpk_ptr)
    let kdf_input: u64 = mem_alloc(52) + 8  // 384 + 32 = 416 bytes
    i = 0
    while i < 384 {
        mem_store8(kdf_input + i, mem_load8(v_encoded_ptr + i))
        i = i + 1
    }
    let j: i64 = 0
    while j < 32 {
        mem_store8(kdf_input + 384 + j, mem_load8(hpk_ptr + j))
        j = j + 1
    }
    ml_kem_kdf(kdf_input, 416, ss_ptr)
}

// Decapsulation
fn ml_kem_decaps(sk_ptr: u64, ct_ptr: u64, ss_ptr: u64) {
    // Parse sk: s (1536) || pk (416) || H(pk) (32) || z (32)
    let s_ptr: u64 = sk_ptr
    let pk_ptr: u64 = sk_ptr + 1536
    let hpk_ptr: u64 = sk_ptr + 1536 + 416
    let z_ptr: u64 = sk_ptr + 1536 + 416 + 32
    
    // Parse ct: u_compressed (384) || v_compressed (128)
    let u_ptr: u64 = mem_alloc(3 * 256) + 8
    let i: i64 = 0
    while i < 3 {
        ml_kem_poly_decompress_ptr(ct_ptr + i * 128, u_ptr + i * 2048)
        i = i + 1
    }
    let v_ptr: u64 = mem_alloc(256) + 8
    ml_kem_poly_decompress_ptr(ct_ptr + 384, v_ptr)
    
    // NTT s, u, v
    i = 0
    while i < 3 {
        ml_kem_ntt_from_ptr(s_ptr + i * 512)  // s was encoded as 512 bytes per poly
        ml_kem_ntt_from_ptr(u_ptr + i * 2048)
        i = i + 1
    }
    ml_kem_ntt_from_ptr(v_ptr)
    
    // v' = v - inner_product(s, u)
    let su_ptr: u64 = mem_alloc(256) + 8
    ml_kem_inner_product(s_ptr, u_ptr, su_ptr)
    let v_prime_ptr: u64 = mem_alloc(256) + 8
    ml_kem_poly_sub_ptr(v_ptr, su_ptr, v_prime_ptr)
    
    // K = KDF(v'_encoded || H(pk))
    let v_prime_encoded: u64 = mem_alloc(48) + 8
    ml_kem_poly_encode_ptr(v_prime_ptr, v_prime_encoded)
    let kdf_input: u64 = mem_alloc(52) + 8
    i = 0
    while i < 384 {
        mem_store8(kdf_input + i, mem_load8(v_prime_encoded + i))
        i = i + 1
    }
    let j: i64 = 0
    while j < 32 {
        mem_store8(kdf_input + 384 + j, mem_load8(hpk_ptr + j))
        j = j + 1
    }
    ml_kem_kdf(kdf_input, 416, ss_ptr)
}

// Polyvec NTT from pointer
fn ml_kem_polyvec_ntt_from_ptr(vec_ptr: u64) {
    let i: i64 = 0
    while i < 3 {
        ml_kem_ntt_from_ptr(vec_ptr + i * 2048)
        i = i + 1
    }
}

// High-level API
fn ml_kem_768_keygen(pk_ptr: u64, sk_ptr: u64) {
    let seed: u64 = mem_alloc(4) + 8
    getrandom(seed, 32)
    ml_kem_keygen(seed, pk_ptr, sk_ptr)
}

fn ml_kem_768_encaps(pk_ptr: u64, ct_ptr: u64, ss_ptr: u64) {
    ml_kem_encaps(pk_ptr, ct_ptr, ss_ptr)
}

fn ml_kem_768_decaps(sk_ptr: u64, ct_ptr: u64, ss_ptr: u64) {
    ml_kem_decaps(sk_ptr, ct_ptr, ss_ptr)
}