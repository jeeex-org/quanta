// std/types.quanta - Type system for Quanta

const TYPE_VOID = 0;
const TYPE_I8 = 1;
const TYPE_I16 = 2;
const TYPE_I32 = 3;
const TYPE_I64 = 4;
const TYPE_U8 = 5;
const TYPE_U16 = 6;
const TYPE_U32 = 7;
const TYPE_U64 = 8;
const TYPE_F32 = 9;
const TYPE_F64 = 10;
const TYPE_BOOL = 11;
const TYPE_STR = 12;
const TYPE_PTR = 13;
const TYPE_ARRAY = 14;
const TYPE_STRUCT = 15;
const TYPE_FN = 16;
const TYPE_GENERIC = 17;
const TYPE_TRAIT = 18;
const TYPE_ANY = 19;

const TYPE_SIZE = 8;  // all types are 64-bit at runtime

module std_types;

fn type_name(t) {
    if t == TYPE_VOID { return "void"; }
    if t == TYPE_I8 { return "i8"; }
    if t == TYPE_I16 { return "i16"; }
    if t == TYPE_I32 { return "i32"; }
    if t == TYPE_I64 { return "i64"; }
    if t == TYPE_U8 { return "u8"; }
    if t == TYPE_U16 { return "u16"; }
    if t == TYPE_U32 { return "u32"; }
    if t == TYPE_U64 { return "u64"; }
    if t == TYPE_F32 { return "f32"; }
    if t == TYPE_F64 { return "f64"; }
    if t == TYPE_BOOL { return "bool"; }
    if t == TYPE_STR { return "str"; }
    if t == TYPE_PTR { return "ptr"; }
    if t == TYPE_ARRAY { return "[]"; }
    if t == TYPE_STRUCT { return "struct"; }
    if t == TYPE_FN { return "fn"; }
    if t == TYPE_GENERIC { return "generic"; }
    if t == TYPE_TRAIT { return "trait"; }
    if t == TYPE_ANY { return "any"; }
    return "unknown";
}

fn is_int(t) {
    return t >= TYPE_I8 && t <= TYPE_U64;
}

fn is_float(t) {
    return t == TYPE_F32 || t == TYPE_F64;
}

fn is_signed(t) {
    return t >= TYPE_I8 && t <= TYPE_I64;
}

fn is_ptr(t) {
    return t == TYPE_PTR || t == TYPE_STR || t == TYPE_ARRAY || t == TYPE_FN;
}

fn ptr_elem_type(t) {
    if t == TYPE_STR { return TYPE_U8; }
    return TYPE_I64;  // default
}

fn size_of(t) {
    return TYPE_SIZE;
}

fn init() -> i64 {
    return 0;
}