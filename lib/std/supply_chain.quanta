// Generate build fingerprint
fn build_fingerprint(command, command_len, env, env_count, inputs, input_count, fingerprint_out) {
    // Create deterministic hash of build inputs
    let ctx = mem_alloc(1024)
    sha3_256_init()
    sha3_256_update(command, command_len)
    
    let i = 0
    while i < env_count {
        let env_var = r64(env + i * 8)
        let env_len = r64(env + i * 8 + 8) // Assuming env is array of ptr+len
        sha3_256_update(env_var, env_len)
        i = i + 1
    }
    
    i = 0
    while i < input_count {
        let input = r64(inputs + i * 8)
        let input_len = r64(inputs + i * 8 + 8)
        sha3_256_update(input, input_len)
        i = i + 1
    }
    
    sha3_256_final(fingerprint_out)
    mem_free(ctx)
    return 0
}

// ============================================================================
// Supply Chain Attestation
// ============================================================================

// Attestation types
let ATTEST_TYPE_BUILD = 0
let ATTEST_TYPE_TEST = 1
let ATTEST_TYPE_DEPLOY = 2
let ATTEST_TYPE_SCAN = 3
let ATTEST_TYPE_REVIEW = 4

// Attestation
let ATTEST_OFF_TYPE = 0
let ATTEST_OFF_SUBJECT = 8
let ATTEST_OFF_SUBJECT_LEN = 16
let ATTEST_OFF_PREDICATE = 24
let ATTEST_OFF_PREDICATE_LEN = 32
let ATTEST_OFF_SIGNATURE = 40
let ATTEST_OFF_TIMESTAMP = 104
let ATTEST_STRUCT_SIZE = 112

// Create attestation
fn attestation_create(type, subject, subject_len, predicate, predicate_len, signer, attestation_out) {
    w64(attestation_out + ATTEST_OFF_TYPE, type)
    w64(attestation_out + ATTEST_OFF_SUBJECT, subject)
    w64(attestation_out + ATTEST_OFF_SUBJECT_LEN, subject_len)
    w64(attestation_out + ATTEST_OFF_PREDICATE, predicate)
    w64(attestation_out + ATTEST_OFF_PREDICATE_LEN, predicate_len)
    
    // Sign
    let sig = attestation_out + ATTEST_OFF_SIGNATURE
    ml_dsa_65_sign(signer, attestation_out, ATTEST_OFF_SIGNATURE, 0, 0, sig)
    
    w64(attestation_out + ATTEST_OFF_TIMESTAMP, clock() / 1000000000)
    return 0
}

// Verify attestation
fn attestation_verify(attestation, attestation_len, verifier_key) {
    let sig = attestation + ATTEST_OFF_SIGNATURE
    return ml_dsa_65_verify(verifier_key, attestation, ATTEST_OFF_SIGNATURE, 0, 0, sig, 64)
}

