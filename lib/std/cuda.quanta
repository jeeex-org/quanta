// CUDA runtime FFI bindings for Phase 7 (GPU residency).
//
// Quanta's extern "C" fn with --emit-dynamic links against the CUDA runtime.
// Set LD_LIBRARY_PATH to include the CUDA library path when running.
// This module provides the minimal set needed for GPU load/unload:
//   - cudaMalloc / cudaFree: GPU memory allocation
//   - cudaMemcpyAsync: async host-to-device copy
//   - cudaStreamCreate / cudaStreamSynchronize: stream management
//   - cudaHostAlloc / cudaFreeHost: pinned staging
//
// Fused dequant-on-load requires a CUDA kernel, which Quanta cannot write.
// The non-fused path (dequant on CPU, then copy to GPU) is implemented here.

extern "C" fn cudaMalloc(ptr: u64, size: u64) -> i64;
extern "C" fn cudaFree(ptr: u64) -> i64;
extern "C" fn cudaMemcpyAsync(dst: u64, src: u64, count: u64, kind: i64, stream: u64) -> i64;
extern "C" fn cudaStreamCreate(stream: u64) -> i64;
extern "C" fn cudaStreamSynchronize(stream: u64) -> i64;
extern "C" fn cudaHostAlloc(ptr: u64, size: u64, flags: u64) -> i64;
extern "C" fn cudaFreeHost(ptr: u64) -> i64;
extern "C" fn cudaGetErrorString(err: i64) -> u64;
extern "C" fn cudaSetDevice(dev: i64) -> i64;
extern "C" fn cudaGetDevice(dev: u64) -> i64;
extern "C" fn cudaDeviceSynchronize() -> i64;

// cudaMemcpyHostToDevice = 1, cudaMemcpyDeviceToHost = 2
const CUDA_MEMCPY_H2D = 1
const CUDA_MEMCPY_D2H = 2
// cudaHostAllocDefault = 0, cudaHostAllocPortable = 1, cudaHostAllocMapped = 2
const CUDA_HOST_ALLOC_DEFAULT = 0
const CUDA_HOST_ALLOC_PORTABLE = 1
const CUDA_HOST_ALLOC_MAPPED = 2

// CUDA error codes
const CUDA_SUCCESS = 0
const CUDA_ERROR_INVALID_VALUE = 1
const CUDA_ERROR_OUT_OF_MEMORY = 2
const CUDA_ERROR_NOT_INITIALIZED = 3
const CUDA_ERROR_DEINITIALIZED = 4
const CUDA_ERROR_NO_DEVICE = 100
const CUDA_ERROR_INVALID_DEVICE = 101

// Allocate GPU memory. Returns pointer, or 0 on failure.
fn gpu_malloc(size) {
    let ptr = mem_alloc(8)
    let rc = cudaMalloc(ptr, size)
    if rc != CUDA_SUCCESS {
        mem_free(ptr)
        return 0
    }
    return mem_load(ptr)
}

// Initialize CUDA device. Returns 0 on success, -1 on failure.
fn cuda_init() {
    let rc = cudaSetDevice(0)
    if rc != CUDA_SUCCESS { return -1 }
    return 0
}

// Free GPU memory.
fn gpu_free(ptr) {
    if ptr == 0 { return }
    cudaFree(ptr)
}

// Allocate pinned host memory. Returns pointer, or 0 on failure.
fn host_alloc(size) {
    let ptr = mem_alloc(8)
    let rc = cudaHostAlloc(ptr, size, CUDA_HOST_ALLOC_DEFAULT)
    if rc != CUDA_SUCCESS {
        mem_free(ptr)
        return 0
    }
    return mem_load(ptr)
}

// Free pinned host memory.
fn host_free(ptr) {
    if ptr == 0 { return }
    cudaFreeHost(ptr)
}

// Create a CUDA stream. Returns stream handle, or 0 on failure.
fn stream_create() {
    let ptr = mem_alloc(8)
    let rc = cudaStreamCreate(ptr)
    if rc != CUDA_SUCCESS {
        mem_free(ptr)
        return 0
    }
    return mem_load(ptr)
}

// Synchronize a CUDA stream.
fn stream_sync(stream) {
    if stream == 0 { return }
    cudaStreamSynchronize(stream)
}

// Async copy host to device.
fn memcpy_h2d_async(dst, src, size, stream) {
    if stream == 0 {
        // Synchronous copy
        cudaMemcpyAsync(dst, src, size, CUDA_MEMCPY_H2D, 0)
    } else {
        cudaMemcpyAsync(dst, src, size, CUDA_MEMCPY_H2D, stream)
    }
}

// Async copy device to host.
fn memcpy_d2h_async(dst, src, size, stream) {
    if stream == 0 {
        cudaMemcpyAsync(dst, src, size, CUDA_MEMCPY_D2H, 0)
    } else {
        cudaMemcpyAsync(dst, src, size, CUDA_MEMCPY_D2H, stream)
    }
}

// Get CUDA error string. Returns pointer to string.
fn cuda_error_string(err) {
    return cudaGetErrorString(err)
}

// Set CUDA device.
fn cuda_set_device(dev) {
    return cudaSetDevice(dev)
}

// Get current CUDA device.
fn cuda_get_device() {
    let ptr = mem_alloc(8)
    cudaGetDevice(ptr)
    return mem_load(ptr)
}

// Synchronize the entire device.
fn cuda_device_sync() {
    return cudaDeviceSynchronize()
}
