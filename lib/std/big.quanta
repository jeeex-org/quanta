// std/big — arbitrary-precision signed big integers.
// Stages: ADD/SUB/MUL (0.0.81), DIV/MOD (0.0.82), SHL/SHR (0.0.83),
// decimal printing + 24-bit limbs + Karatsuba multiply (0.0.84).
//
// A `big` is a header-pointer to a little-endian array of 24-bit limbs:
//   [base]      = nlimbs (i64; element 0 is the header, NOT a limb)
//   [base+8]    = sign    (0 = non-negative, 1 = negative)
//   [base+16]   = limb[0]  (least significant 24 bits; stored as i64 0..16777215)
//   [base+24]   = limb[1]
//   ...
//
// WHY 24-BIT LIMBS: Quanta's `*` is a signed 64-bit multiply with ovf_trap=1.
// A 32-bit limb squared (~1.8e19) overflows i64 and trips the trap, and a 64-bit
// limb loses the high half of the 128-bit product entirely. 24-bit limbs keep
// every a[i]*b[j] < 2^48 < 2^63 (never traps), and carry = prod >> 24 with
// prod & 16777215 exact. 4096-bit numbers use 171 limbs; 1M bits = 41,667 limbs.
// Signed arithmetic is handled by sign/magnitude on top of the magnitude ops.

// Stage 1 is MAGNITUDE-ONLY (unsigned). Sign handling arrives with DIV/MOD
// (Stage 2). Callers pass non-negative operands; results are non-negative.
//
// Import with:  import std/big

// --- Stage 2 shared state (declared first for forward use) -----------------
// SIGN CONVENTION: stored in slot a[1] (0 or 1), kept SEPARATE from the
// limb-count header a[0] (always non-negative) and the limbs (a[2..]). This
// avoids needing the INT64_MIN literal (0x8000000000000000), which the compiler
// cannot represent. All Stage-1 magnitude ops use big_len(a)=a[0] and access
// limbs via big_limb/big_set, so they are unaffected by the sign slot.

// Allocate a big with `n` 24-bit limbs. Layout: a[0]=nlimbs, a[1]=sign(0/1),
// a[2..]=limbs. mem_alloc(k) gives k qword slots (indices 0..k-1) with [base]=k;
// we need n+2 slots (count + sign + n limbs).
fn big_alloc(n) -> big {
  let r = mem_alloc(n + 2)
  r[0] = n
  r[1] = 0
  return r
}

fn big_len(a: big) { return a[0] }
fn big_limb(a: big, i) { return a[i + 2] }
fn big_set(a: big, i, v) { a[i + 2] = v }

fn big_is_neg(a: big) { return a[1] }
fn big_set_neg(a: big, s) { a[1] = s; return 0 }

// Strip leading zero limbs; never reduce below 1.
fn big_norm(r: big) -> big {
  let m = big_len(r)
  while m > 1 {
    if big_limb(r, m - 1) == 0 { m = m - 1 }
    else { break }
  }
  r[0] = m
  return r
}

// Unsigned addition: r = a + b.
fn big_add(a: big, b: big) -> big {
  let na = big_len(a)
  let nb = big_len(b)
  let n = na
  if nb > n { n = nb }
  let r = big_alloc(n + 1)
  let carry = 0
  let i = 0
  while i < n {
    let x = 0
    let y = 0
    if i < na { x = big_limb(a, i) }
    if i < nb { y = big_limb(b, i) }
    let s = x + y + carry            // < 3*16777216 < 2^26, never traps
    big_set(r, i, s & 16777215)        // store low 24 bits
    carry = s >> 24                 // carry = high bits (0, 1, or 2)
    i = i + 1
  }
  if carry > 0 { big_set(r, n, carry); n = n + 1 }
  r[0] = n
  return r
}

// Unsigned subtraction: r = |a - b| (magnitude difference).
fn big_sub(a: big, b: big) -> big {
  let na = big_len(a)
  let nb = big_len(b)
  let swap = 0
  if na < nb { swap = 1 }
  else if na == nb {
    let k = na - 1
    while k >= 0 {
      let xa = big_limb(a, k)
      let xb = big_limb(b, k)
      if xa < xb { swap = 1; k = -1 }
      else if xa > xb { k = -1 }
      else { k = k - 1 }
    }
  }
  let hi = a
  let lo = b
  if swap == 1 { hi = b; lo = a }
  let nh = big_len(hi)
  let nl = big_len(lo)
  let r = big_alloc(nh)
  let borrow = 0
  let i = 0
  while i < nh {
    let x = big_limb(hi, i)
    let y = 0
    if i < nl { y = big_limb(lo, i) }
    let d = x - y - borrow
    let b2 = 0
    if d < 0 { b2 = 1; d = d + 16777216 }   // wrap to u24 (i64 mod 2^24)
    big_set(r, i, d)
    borrow = b2
    i = i + 1
  }
  return big_norm(r)
}

// Unsigned multiplication: r = a * b. Dispatches to Karatsuba for large inputs
// (O(n^1.585)) and schoolbook (big_mul_base) for small ones.
fn big_mul(a: big, b: big) -> big {
  let na = big_len(a)
  let nb = big_len(b)
  if na < 32 && nb < 32 { return big_mul_base(a, b) }
  return big_mul_kara(a, b)
}

// Schoolbook multiplication (24-bit limbs). Used directly for small inputs.
fn big_mul_base(a: big, b: big) -> big {
  let na = big_len(a)
  let nb = big_len(b)
  let nr = na + nb
  let r = big_alloc(nr)
  let i = 0
  while i < nr { big_set(r, i, 0); i = i + 1 }
  let i0 = 0
  while i0 < na {
    let ai = big_limb(a, i0)
    let carry = 0
    let j = 0
    while j < nb {
      let bj = big_limb(b, j)
      let rij = big_limb(r, i0 + j)
      // ai*bj < 2^32, rij < 2^16, carry < 2^17 -> prod < 2^33, never traps
      let prod = ai * bj + rij + carry
      big_set(r, i0 + j, prod & 16777215)
      carry = prod >> 24
      j = j + 1
    }
    big_set(r, i0 + nb, big_limb(r, i0 + nb) + carry)
    i0 = i0 + 1
  }
  return big_norm(r)
}

// r[off..] += x (term-by-term add with carry), used by Karatsuba combine.
fn big_add_off(r: big, off, x: big) {
  let n = big_len(x)
  let carry = 0
  let i = 0
  while i < n {
    let cur = big_limb(r, off + i) + big_limb(x, i) + carry
    big_set(r, off + i, cur & 16777215)
    carry = cur >> 24
    i = i + 1
  }
  // propagate carry into higher limbs of r
  let k = off + n
  while carry > 0 {
    let cur = big_limb(r, k) + carry
    big_set(r, k, cur & 16777215)
    carry = cur >> 24
    k = k + 1
  }
  return 0
}

// r[off..] -= x (assumes r[off..] >= x term-by-term after borrow); magnitude sub.
fn big_sub_off(r: big, off, x: big) {
  let n = big_len(x)
  let borrow = 0
  let i = 0
  while i < n {
    let cur = big_limb(r, off + i) - big_limb(x, i) - borrow
    if cur < 0 { cur = cur + 16777216; borrow = 1 } else { borrow = 0 }
    big_set(r, off + i, cur & 16777215)
    i = i + 1
  }
  // propagate borrow into higher limbs
  let k = off + n
  while borrow > 0 {
    let cur = big_limb(r, k) - borrow
    if cur < 0 { cur = cur + 16777216; borrow = 1 } else { borrow = 0 }
    big_set(r, k, cur & 16777215)
    k = k + 1
  }
  return 0
}

// Karatsuba multiply (magnitude). Splits each operand at a midpoint strictly
// less than both lengths, so the recursion actually reduces in size.
fn big_mul_kara(a: big, b: big) -> big {
  let na = big_len(a)
  let nb = big_len(b)
  let half = na
  if nb < half { half = nb }
  half = half / 2                       // midpoint < min(na,nb) -> recursion shrinks
  if half < 16 { return big_mul_base(a, b) }
  let lo = half
  // a = a1 * B^lo + a0 ; b = b1 * B^lo + b0  (B = 2^(24*lo))
  let a0 = big_lo(a, lo)
  let a1 = big_hi(a, lo)
  let b0 = big_lo(b, lo)
  let b1 = big_hi(b, lo)
  let z0 = big_mul(a0, b0)
  let z2 = big_mul(a1, b1)
  let sa = big_add(a0, a1)
  let sb = big_add(b0, b1)
  let z1 = big_mul(sa, sb)
  z1 = big_sub(z1, z0)
  z1 = big_sub(z1, z2)
  // result = z2*B^(2lo) + z1*B^lo + z0
  // z2 is placed at offset 2*lo, so the result span can reach ~1.5*(na+nb);
  // allocate 2*(na+nb) limbs to avoid writing past the end of r.
  let nr = (na + nb) * 2
  let r = big_alloc(nr)
  let i = 0
  while i < nr { big_set(r, i, 0); i = i + 1 }
  big_add_off(r, 0, z0)
  big_add_off(r, lo, z1)
  big_add_off(r, 2 * lo, z2)
  return big_norm(r)
}

// low `n` limbs of x (x mod B^n)
fn big_lo(x: big, n) -> big {
  let nx = big_len(x)
  let m = n
  if m > nx { m = nx }
  let r = big_alloc(m)
  let i = 0
  while i < m { big_set(r, i, big_limb(x, i)); i = i + 1 }
  return big_norm(r)
}

// high limbs of x (x div B^n); returns 0 if x < B^n
fn big_hi(x: big, n) -> big {
  let nx = big_len(x)
  if n >= nx { return big_from_i64(0) }
  let m = nx - n
  let r = big_alloc(m)
  let i = 0
  while i < m { big_set(r, i, big_limb(x, n + i)); i = i + 1 }
  return big_norm(r)
}

// Build a big from a single i64 (handles negatives via the sign slot).
fn big_from_i64(x) -> big {
  let neg = 0
  let m = x
  if x < 0 { neg = 1; m = -x }          // m = |x| (positive, < 2^63)
  let r = big_alloc(3)                   // 64 bits -> 3 x 24-bit limbs
  big_set(r, 0, m & 16777215)
  big_set(r, 1, (m >> 24) & 16777215)
  big_set(r, 2, (m >> 48) & 16777215)
  big_set_neg(r, neg)
  return big_norm(r)
}

// Build a big from an ASCII decimal string `s` (Quanta runtime string layout:
// [8:len][packed bytes, 1 byte each]). Returns 0 (null) on empty / non-digit.
// Algorithm: acc = 0; for each char c: acc = acc*10 + (c - '0').
fn big_from_dec(s) -> big {
  let slen = mem_load(s)                 // string length (bytes) at s+0
  if slen == 0 { return 0 }
  let acc = big_from_i64(0)
  let ten = big_from_i64(10)
  let i = 0
  while i < slen {
    let c = mem_load8(s + 8 + i)         // packed byte at position i
    if c < 48 || c > 57 { return 0 }      // not a digit
    let d = big_from_i64(c - 48)
    acc = big_mul(acc, ten)
    acc = big_add(acc, d)
    i = i + 1
  }
  return acc
}

// Build a big from two 64-bit values (lo64, hi64), each split into three 24-bit
// limbs (little-endian, 6 limbs total). Useful for tests; e.g.
// big_from_2x64(-1, 0) = 2^64-1.
fn big_from_2x64(lo64, hi64) -> big {
  let r = big_alloc(6)
  big_set(r, 0, lo64 & 16777215)
  big_set(r, 1, (lo64 >> 24) & 16777215)
  big_set(r, 2, (lo64 >> 48) & 16777215)
  big_set(r, 3, hi64 & 16777215)
  big_set(r, 4, (hi64 >> 24) & 16777215)
  big_set(r, 5, (hi64 >> 48) & 16777215)
  return big_norm(r)
}

// Return the value as an i64, valid only when it fits in signed 64 bits
// (value < 2^63; i.e. len <= 3 for 24-bit limbs). Reconstructs from the
// non-overlapping limb fields so no intermediate shift overflows i64.
fn big_to_i64(a: big) {
  let lo = big_limb(a, 0)
  let mid = 0
  let hi = 0
  if big_len(a) > 1 { mid = big_limb(a, 1) }
  if big_len(a) > 2 { hi = big_limb(a, 2) & 65535 }   // only low 16 bits matter (value < 2^63)
  let v = lo | (mid << 24) | (hi << 48)
  if big_is_neg(a) == 1 { v = -v }
  return v
}

// Print a big in hexadecimal (exact, limb-by-limb). Each 24-bit limb is 6 hex
// digits, most-significant limb printed first. Cross-checks against Python.
// Each nibble is printed followed by a comma (unambiguous parsing).
fn big_print_hex(a: big) {
  let n = big_len(a)
  let k = n - 1
  while k >= 0 {
    let limb = big_limb(a, k)
    let sh = 20
    while sh >= 0 {
      let nib = (limb >> sh) & 15
      print(nib); print(44)   // 44 = ','
      sh = sh - 4
    }
    k = k - 1
  }
  return 0
}

// ============================================================================
// Stage 2 (DIV/MOD): signed division/modulo on top of the magnitude ops.
//
// SIGN CONVENTION: stored in slot a[1] (0 or 1), separate from the limb-count
// header a[0] (always non-negative) and the limbs (a[2..]). All Stage-1
// magnitude ops use big_len(a)=a[0] and access limbs via big_limb/big_set, so
// they ignore the sign slot and remain correct & unchanged.
//
// DIVISION ALGORITHM: binary (shift-subtract) restoring division. It uses only
// left/right shifts by 1 (never a full multiply), so it cannot trip ovf_trap and
// is straightforward to verify correct. For x = q*y + r with 0 <= r < y:
//   q = 0; r = 0
//   for i = nbits(x)-1 downto 0:
//       r = (r << 1) | bit_i(x); q = q << 1
//       if r >= y: r = r - y; q = q | 1
// Implemented via big_shl1 / big_shr1 / big_ge / big_sub on magnitude words.
// ============================================================================

// r = x << 1 (magnitude). Out-of-place; allocates a new big.
fn big_shl1(x: big) -> big {
  let n = big_len(x)
  let r = big_alloc(n + 1)
  let carry = 0
  let i = 0
  while i < n {
    let v = big_limb(x, i)
    let nv = (v << 1) | carry
    let c = 0
    if nv > 16777215 { c = 1; nv = nv & 16777215 }
    big_set(r, i, nv)
    carry = c
    i = i + 1
  }
  if carry == 1 { big_set(r, n, 1) }
  return big_norm(r)
}

// r = x >> 1 (magnitude).
fn big_shr1(x: big) -> big {
  let n = big_len(x)
  let r = big_alloc(n)
  let carry = 0
  let i = n - 1
  while i >= 0 {
    let v = big_limb(x, i)
    let nv = (v >> 1) | carry
    big_set(r, i, nv)
    if (v & 1) == 1 { carry = 8388608 } else { carry = 0 }   // bit 23 -> next limb's LSB
    i = i - 1
  }
  return big_norm(r)
}

// 1 if |a| == |b| (magnitude equality), else 0. Compares limb-by-limb ignoring
// any leading zero limbs, so equal values with differing lengths still match.
fn big_cmp(a: big, b: big) {
  let an = big_is_neg(a)
  let bn = big_is_neg(b)
  if an == 1 && bn == 0 { return -1 }
  if an == 0 && bn == 1 { return 1 }
  if an == 0 && bn == 0 {
    if big_ge(a, b) == 1 {
      if big_eq(a, b) == 1 { return 0 } else { return 1 }
    }
    return -1
  }
  if big_ge(a, b) == 1 {
    if big_eq(a, b) == 1 { return 0 } else { return -1 }
  }
  return 1
}
fn big_add_signed(x: big, y: big) -> big {
    let xn = big_is_neg(x)
    let yn = big_is_neg(y)
    if xn == 0 && yn == 0 { return big_add(x, y) }       // a + b
    if xn == 1 && yn == 1 {                              // (-a) + (-b) = -(a+b)
        let r = big_add(x, y); big_set_neg(r, 1); return r
    }
    if xn == 1 && yn == 0 {                              // (-a) + b = b - a
        let a = big_abs(x)                               // |x|
        if big_ge(a, y) == 1 { let r = big_sub(a, y); big_set_neg(r, 1); return r }
        let r = big_sub(y, a); big_set_neg(r, 0); return r
    }
    // xn==0 && yn==1 : a + (-b) = a - b
    let b = big_abs(y)                                   // |y|
    if big_ge(b, x) == 1 { let r = big_sub(b, x); big_set_neg(r, 1); return r }
    let r = big_sub(x, b); big_set_neg(r, 0); return r
}
// big_abs: copy of a with sign cleared (non-mutating).
fn big_abs(a: big) -> big {
    let n = big_len(a)
    let r = big_alloc(n)
    let i = 0
    while i < n { big_set(r, i, big_limb(a, i)); i = i + 1 }
    big_set_neg(r, 0)
    return big_norm(r)
}
fn big_sub_signed(x: big, y: big) -> big {
    let xn = big_is_neg(x)
    let yn = big_is_neg(y)
    if xn == 0 && yn == 0 { return big_sub(x, y) }       // a - b
    if xn == 1 && yn == 1 {                              // (-a) - (-b) = b - a = |y| - |x|
        return big_sub(big_abs(y), big_abs(x))
    }
    if xn == 1 && yn == 0 {                              // (-a) - b = -(a+b)
        let a = big_abs(x); let r = big_add(a, y); big_set_neg(r, 1); return r
    }
    // xn==0 && yn==1 : a - (-b) = a + b
    let b = big_abs(y); let r = big_add(x, b); big_set_neg(r, 0); return r
}
fn big_mul_signed(x: big, y: big) -> big {
  let r = big_mul(x, y)
  if (big_is_neg(x) ^ big_is_neg(y)) == 1 { big_set_neg(r, 1) } else { big_set_neg(r, 0) }
  return r
}
fn big_to_tc(a: big) -> big {
  let n = big_len(a)
  let r = big_alloc(n + 1)
  let i = 0
  while i < n { big_set(r, i, big_limb(a, i)); i = i + 1 }
  big_set(r, n, 0)
  if big_is_neg(a) == 1 {
    let i2 = 0
    while i2 <= n { big_set(r, i2, (16777215 - big_limb(r, i2)) & 16777215); i2 = i2 + 1 }
    let i3 = 0; let carry = 1
    while carry == 1 && i3 <= n { let s = big_limb(r, i3) + carry; big_set(r, i3, s & 16777215); carry = s >> 24; i3 = i3 + 1 }
  }
  r[0] = n + 1
  return r
}
fn big_from_tc(t: big) -> big {
  let n = big_len(t) - 1
  let sign_bit = 0
  if (big_limb(t, n) & 1) == 1 { sign_bit = 1 }
  if sign_bit == 0 {
    let r = big_alloc(n)
    let i = 0
    while i < n { big_set(r, i, big_limb(t, i)); i = i + 1 }
    big_set_neg(r, 0)
    return big_norm(r)
  }
  let r = big_alloc(n + 1)
  let i2 = 0
  while i2 <= n { big_set(r, i2, (16777215 - big_limb(t, i2)) & 16777215); i2 = i2 + 1 }
  let i3 = 0; let carry = 1
  while carry == 1 && i3 <= n { let s = big_limb(r, i3) + carry; big_set(r, i3, s & 16777215); carry = s >> 24; i3 = i3 + 1 }
  r[0] = n
  big_set_neg(r, 1)
  return big_norm(r)
}
fn big_and(x: big, y: big) -> big {
  let a = big_to_tc(x); let b = big_to_tc(y)
  let n = big_len(a)
  if big_len(b) > n { n = big_len(b) }
  let r = big_alloc(n)
  let i = 0
  while i < n {
    let av = 0; if i < big_len(a) { av = big_limb(a, i) }
    let bv = 0; if i < big_len(b) { bv = big_limb(b, i) }
    big_set(r, i, av & bv & 16777215)
    i = i + 1
  }
  r[0] = n
  return big_norm(big_from_tc(r))
}
fn big_or(x: big, y: big) -> big {
  let a = big_to_tc(x); let b = big_to_tc(y)
  let n = big_len(a)
  if big_len(b) > n { n = big_len(b) }
  let r = big_alloc(n)
  let i = 0
  while i < n {
    let av = 0; if i < big_len(a) { av = big_limb(a, i) }
    let bv = 0; if i < big_len(b) { bv = big_limb(b, i) }
    big_set(r, i, (av | bv) & 16777215)
    i = i + 1
  }
  r[0] = n
  return big_norm(big_from_tc(r))
}
fn big_xor(x: big, y: big) -> big {
  let a = big_to_tc(x); let b = big_to_tc(y)
  let n = big_len(a)
  if big_len(b) > n { n = big_len(b) }
  let r = big_alloc(n)
  let i = 0
  while i < n {
    let av = 0; if i < big_len(a) { av = big_limb(a, i) }
    let bv = 0; if i < big_len(b) { bv = big_limb(b, i) }
    big_set(r, i, (av ^ bv) & 16777215)
    i = i + 1
  }
  r[0] = n
  return big_norm(big_from_tc(r))
}
fn big_shl_signed(x: big, n) -> big {
  let r = big_shl(x, n)
  big_set_neg(r, big_is_neg(x))
  return r
}
fn big_shr_signed(x: big, n) -> big {
  let r = big_shr(x, n)
  big_set_neg(r, big_is_neg(x))
  return r
}
fn big_eq(a: big, b: big) {
  // 0.0.114: SIGNED equality — signs must match too (magnitude-only compare
  // wrongly reported big_eq(-5, 5) == 1).
  if big_is_neg(a) != big_is_neg(b) { return 0 }
  let na = big_len(a)
  let nb = big_len(b)
  let i = 0
  while i < na {
    let x = big_limb(a, i)
    let y = 0
    if i < nb { y = big_limb(b, i) }
    if x != y { return 0 }
    i = i + 1
  }
  // any remaining b limbs must also be zero
  while i < nb {
    if big_limb(b, i) != 0 { return 0 }
    i = i + 1
  }
  return 1
}

// 1 if |a| >= |b| (magnitude compare), else 0. Compares limb-by-limb from the
// most significant position down, treating absent limbs as zero, so it is
// robust to any leading-zero inconsistencies in the representation.
fn big_ge(a: big, b: big) {
  let na = big_len(a)
  let nb = big_len(b)
  let m = na
  if nb > m { m = nb }
  let k = m - 1
  while k >= 0 {
    let xa = 0
    if k < na { xa = big_limb(a, k) }
    let xb = 0
    if k < nb { xb = big_limb(b, k) }
    if xa > xb { return 1 }
    if xa < xb { return 0 }
    k = k - 1
  }
  return 1
}

// Unsigned magnitude division x / y (returns quotient big). Uses binary
// restoring division (shift-subtract), which needs only shifts + subtract, so it
// never trips ovf_trap. Caller must ensure 0 < y <= x (else returns 0).
fn big_udiv(x: big, y: big) -> big {
  if big_ge(y, x) == 1 {           // y >= x  ->  q = (x==y ? 1 : 0)
    if big_ge(x, y) == 1 {         // x == y
      let o = big_alloc(1); big_set(o, 0, 1); o[0] = 1; return o
    }
    let z = big_alloc(1); big_set(z, 0, 0); z[0] = 1; return z   // x < y -> 0
  }
  // nbits = bit length of x = (n-1)*24 + (bit count of top limb)
  let n = big_len(x)
  let top = big_limb(x, n - 1)
  let bp = 0
  let t = top
  while t > 0 { t = t >> 1; bp = bp + 1 }
  let nbits = (n - 1) * 24 + bp

  let ONE = big_from_i64(1)
  let q = big_alloc(1); big_set(q, 0, 0); q[0] = 1
  let r = big_alloc(1); big_set(r, 0, 0); r[0] = 1
  let i = nbits - 1
  while i >= 0 {
    r = big_shl1(r)                                     // r = r << 1
    let bl = i / 24                                       // extract bit i of x
    let bb = i - bl * 24
    let bit = (big_limb(x, bl) >> bb) & 1
    if bit == 1 { r = big_add(r, ONE) }                  // r = r | 1 (r is even here)
    q = big_shl1(q)                                      // q = q << 1
    if big_ge(r, y) == 1 { r = big_sub(r, y); q = big_add(q, ONE) }
    i = i - 1
  }
  return q
}

// Signed division a / b. Floor semantics (like Python //). When the true
// truncating quotient's remainder is non-zero and the signs differ, the floor
// quotient is one less than the magnitude quotient.
fn big_div(a: big, b: big) -> big {
  let an = big_is_neg(a)
  let bn = big_is_neg(b)
  big_set_neg(a, 0); big_set_neg(b, 0)     // work on magnitudes
  let q = big_udiv(a, b)
  let r = big_sub(a, big_mul(q, b))         // 0 <= r < |b|
  if (an ^ bn) == 1 {
    if big_ge(r, big_from_i64(1)) == 1 { q = big_add(q, big_from_i64(1)) }
  }
  big_set_neg(a, an); big_set_neg(b, bn)   // restore signs
  if (an ^ bn) == 1 { big_set_neg(q, 1) }
  return q
}

// Signed modulo a % b. Python semantics: result has the SIGN OF THE DIVISOR.
// r = |a| - q*|b| where q is the floor quotient; when signs differ and r != 0,
// the adjusted remainder is |b| - r.
fn big_mod(a: big, b: big) -> big {
  let an = big_is_neg(a)
  let bn = big_is_neg(b)
  big_set_neg(a, 0); big_set_neg(b, 0)     // magnitudes
  let q = big_udiv(a, b)
  let r = big_sub(a, big_mul(q, b))         // |a| - q*|b|  (0 <= r < |b|)
  if (an ^ bn) == 1 {
    if big_ge(r, big_from_i64(1)) == 1 { r = big_sub(b, r) }
  }
  big_set_neg(a, an); big_set_neg(b, bn)
  if bn == 1 { big_set_neg(r, 1) }          // sign = sign of divisor
  return r
}

// ============================================================================
// Stage 3 (SHIFTS): shift a magnitude left/right by n bits (n >= 0). Negative n
// shifts the opposite direction. Implemented by splitting n into a whole-limb
// shift (n/16) plus a sub-limb bit shift (n%16); only shifts + masks are used,
// so it never trips ovf_trap.
// ============================================================================

// r = |x| << n  (n >= 0). If n < 0, shifts right instead.
fn big_shl(x: big, n) -> big {
  if n < 0 { return big_shr(x, -n) }
  if n == 0 { return x }
  let limb_shift = n / 24
  let rem = n - limb_shift * 24
  let na = big_len(x)
  let nr = na + limb_shift + 1
  let r = big_alloc(nr)
  let i = 0
  while i < nr { big_set(r, i, 0); i = i + 1 }
  i = 0
  while i < na {
    let v = big_limb(x, i)
    let cur = big_limb(r, limb_shift + i) + (v << rem)   // < 2^31, no trap
    big_set(r, limb_shift + i, cur & 16777215)
    let hi = (v << rem) >> 24                            // spill to next limb
    if hi > 0 { big_set(r, limb_shift + i + 1, big_limb(r, limb_shift + i + 1) + hi) }
    i = i + 1
  }
  return big_norm(r)
}

// r = |x| >> n  (n >= 0). If n < 0, shifts left instead.
fn big_shr(x: big, n) -> big {
  if n < 0 { return big_shl(x, -n) }
  if n == 0 { return x }
  let limb_shift = n / 24
  let rem = n - limb_shift * 24
  let na = big_len(x)
  if limb_shift >= na { return big_from_i64(0) }
  let nr = na - limb_shift
  let r = big_alloc(nr)
  let i = 0
  while i < nr { big_set(r, i, 0); i = i + 1 }
  i = 0
  while i < nr {
    let src = i + limb_shift
    let v = big_limb(x, src) >> rem
    if src + 1 < na {
      let vn = big_limb(x, src + 1)
      v = v + ((vn & ((1 << rem) - 1)) << (24 - rem))   // low rem bits -> high rem bits
    }
    big_set(r, i, v & 16777215)
    i = i + 1
  }
  return big_norm(r)
}

// ============================================================================
// DECIMAL PRINTING: big -> base-10 string, printed via recursive divide-by-10.
// Signed-aware (prints '-' for negatives). Pure stdlib, fixpoint-safe.
// ============================================================================

// Emit a single byte to stdout via write(1, &b, 1). Reuses one 8-byte buffer.
let _putc_buf = mem_alloc(1)
fn putc(b) {
  mem_store(_putc_buf, b)
  syscall(1, 1, _putc_buf, 1)
  return 0
}

// Print the decimal digits of |a| (magnitude), iteratively.
// Builds digits into a fixed buffer, tracking a real write count, then emits
// exactly that many ASCII bytes.
fn big_print_dec_mag(a: big) {
  let ten = big_from_i64(10)
  // count digits
  let dcount = 0
  let t = a
  while big_ge(t, ten) == 1 { t = big_udiv(t, ten); dcount = dcount + 1 }
  let ndig = dcount + 1
  // FIX-0.0.21: allocate exactly ndig qwords (digit i stored at buf+8+i*8 needs
  // indices 0..ndig -> ndig+1 qwords incl. header). The old fixed 2048-qword
  // buffer overflowed into adjacent heap for numbers with >256 decimal digits.
  let buf = mem_alloc(ndig + 1)          // big scratch; digit i at buf+8+i*8
  let w = 0                             // number of digits written
  let k = ndig - 1
  let v = a
  while k >= 0 {
    let q = big_udiv(v, ten)
    let r = big_sub(v, big_mul(q, ten))   // r = v mod 10, 0..9
    mem_store(buf + 8 + w * 8, big_to_i64(r))
    w = w + 1
    v = q
    k = k - 1
  }
  let i = w - 1
  while i >= 0 { putc(48 + mem_load(buf + 8 + i * 8)); i = i - 1 }
  return 0
}

// Print a big as a signed decimal integer followed by a newline.
fn big_println(a: big) {
  big_print(a)
  putc(10)                               // '\n'
  return 0
}

// Print a big as a signed decimal integer.
fn big_print(a: big) {
  let neg = big_is_neg(a)
  if neg == 1 { putc(45) }              // '-'
  // magnitude copy of a (strip sign by leaving the copy's sign slot 0)
  let n = big_len(a)
  let mag = big_alloc(n)
  let i = 0
  while i < n {
    big_set(mag, i, big_limb(a, i))
    i = i + 1
  }
  if big_ge(mag, big_from_i64(1)) == 1 {
    big_print_dec_mag(mag)
  } else {
    putc(48)                            // '0'
  }
  return 0
}

