// Minimal test
import std/fs

let gguf_fd = -1

fn gguf_read_string(fd) {
    let len_buf = mem_alloc(8)
    let n = file_read(fd, len_buf, 8)
    if n < 8 { return 0 }
    let len = mem_load(len_buf)
    if len == 0 { return 0 }
    let buf = mem_alloc(len + 1)
    let r = file_read(fd, buf, len)
    if r < len { return 0 }
    mem_store8(buf + len, 0)
    return buf
}

fn gguf_skip(fd, n) {
    if n <= 0 { return }
    lseek(fd, n, 1)
}

fn gguf_skip_value_read(fd, vtype) {
    if vtype == 8 {
        let len_buf = mem_alloc(8)
        read_raw(fd, len_buf, 8)
        let slen = mem_load(len_buf)
        let skip_buf = mem_alloc(1024)
        let remaining = slen
        while remaining > 0 {
            let chunk = 1024
            if remaining < chunk { chunk = remaining }
            read_raw(fd, skip_buf, chunk)
            remaining = remaining - chunk
        }
    } else if vtype == 0 {
        let skip = mem_alloc(1)
        read_raw(fd, skip, 1)
    } else if vtype == 1 {
        let skip = mem_alloc(1)
        read_raw(fd, skip, 1)
    } else if vtype == 2 {
        let skip = mem_alloc(2)
        read_raw(fd, skip, 2)
    } else if vtype == 3 {
        let skip = mem_alloc(2)
        read_raw(fd, skip, 2)
    } else if vtype == 4 {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    } else if vtype == 5 {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    } else if vtype == 6 {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    } else if vtype == 7 {
        let skip = mem_alloc(1)
        read_raw(fd, skip, 1)
    } else if vtype == 9 {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    } else if vtype == 10 {
        let skip = mem_alloc(8)
        read_raw(fd, skip, 8)
    } else if vtype == 11 {
        let skip = mem_alloc(8)
        read_raw(fd, skip, 8)
    } else if vtype == 12 {
        let skip = mem_alloc(8)
        read_raw(fd, skip, 8)
    } else {
        let skip = mem_alloc(4)
        read_raw(fd, skip, 4)
    }
}

fn gguf_print_tensor_name(idx) {
    print("tensor\n")
}