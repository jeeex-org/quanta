// Fused Q4_K_M matvec: dequantize + dot product on-the-fly
// This is the key optimization that makes llama.cpp fast.
// Instead of materializing full f64 weight matrix, we dequantize blocks
// directly into SIMD registers and accumulate.

// Q4_K_M block layout: 2 bytes scale (f16) + 128 bytes quads = 144 bytes per 256 elements
// Actually for Q4_K: 2 bytes scale + 16 bytes scales + 128 bytes quads = 146 bytes? 
// Let me use the standard: Q4_K = 2 + 16 + 128 = 146 bytes per 256 elements
// But the file uses Q4_K_M which is 2 + 2 + 128 = 132 bytes per 256 elements? 
// Standard Q4_K: 2 (d scale) + 16 (8-bit scales) + 128 (4-bit quads) = 146 bytes per 256 values

// For simplicity, let's use the Q4_K layout:
// Block = 146 bytes: [scale_f16(2)] [scales_byte(16)] [quads(128)]
// Each quad = 2 nibbles = 2 values (low nibble first, then high nibble)

// Fused matvec for Q4_K weights: y = W * x where W is Q4_K quantized
// W is [rows, cols], x is [cols], y is [rows]
fn matvec_q4k(W_raw, x, rows, cols, y) {
    let n_blocks_per_row = cols / 256
    let i = 0
    while i < rows {
        let sum = i2f(0)
        let bi = 0
        while bi < n_blocks_per_row {
            let block_offset = (i * n_blocks_per_row + bi) * 146
            
            // Read scale (f16, 2 bytes)
            let scale_bits = mem_load8(W_raw + block_offset) + mem_load8(W_raw + block_offset + 1) * 256
            let scale = f16_to_f64(scale_bits)
            
            // Read 16 sub-scales (8-bit each)
            let subscales = W_raw + block_offset + 2
            
            // Read 128 bytes of quads (256 4-bit values)
            let quads = W_raw + block_offset + 18
            
            // Process 256 elements in this block
            let qi = 0
            while qi < 256 {
                // Get sub-scale index (4 bits per sub-block of 16 elements)
                let sub_idx = qi / 16
                let sub_scale_byte = mem_load8(subscales + sub_idx)
                let sub_scale = i2f(sub_scale_byte)
                
                // Get quad value
                let byte_idx = qi / 2
                let byte_val = mem_load8(quads + byte_idx)
                let nibble = 0
                if qi - (qi / 2) * 2 == 0 {
                    nibble = byte_val - (byte_val / 16) * 16  // low nibble
                } else {
                    nibble = byte_val / 16  // high nibble
                }
                
                // Dequantize: value = scale * sub_scale * (nibble - 8)
                let quant_val = fmul(fmul(scale, sub_scale), i2f(nibble - 8))
                
                // Multiply by x and accumulate
                let xv = mem_load(x + (bi * 256 + qi) * 8)
                sum = fadd(sum, fmul(quant_val, xv))
                
                qi = qi + 1
            }
            
            bi = bi + 1
        }
        mem_store(y + i * 8, sum)
        i = i + 1
    }
}

// Convert f16 (16-bit) to f64 bit pattern
fn f16_to_f64(f16_bits) {
    let sign = (f16_bits / 32768) * 32768
    let exp = (f16_bits - sign) / 1024
    let mant = f16_bits - sign - exp * 1024
    
    if exp == 0 {
        // Subnormal or zero
        if mant == 0 { return i2f(0) }
        // Very small number, approximate
        return fdiv(i2f(mant), i2f(1048576))
    }
    
    if exp == 31 {
        // Inf or NaN
        return i2f(0)
    }
    
    // Normal: value = (-1)^sign * 2^(exp-15) * (1 + mant/1024)
    let new_exp = exp - 15 + 1023  // Bias adjustment
    let result = sign + new_exp * 1024 + mant
    return i2f(result)
}