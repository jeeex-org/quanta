// std/ci.quanta - CI integration for Quanta

module std_ci;

fn ci_run_gate(gate_name) {
    print("Running gate: ");
    print(gate_name);
    newline();
    return 0;
}

fn ci_run_all_gates() {
    let gates = [
        "functional",
        "extern-c",
        "extern-ld",
        "security",
        "performance",
        "valgrind",
        "fuzz",
        "differential",
        "generics",
        "stdlib",
        "multi-tu"
    ];
    let i = 0;
    while i < gates.len() {
        ci_run_gate(gates[i]);
        i = i + 1;
    }
    return 0;
}

