// String helpers for RAG (missing from std/str)
import std/str

// Find substring position, returns -1 if not found
fn str_index(s, sub) -> i64 {
    let n = len(s)
    let m = len(sub)
    if m == 0 { return 0 }
    if m > n { return -1 }
    
    let i = 0
    while i <= n - m {
        let j = 0
        let found = 1
        while j < m {
            if byte_at(s, i + j) != byte_at(sub, j) { found = 0; break }
            j = j + 1
        }
        if found == 1 { return i }
        i = i + 1
    }
    return -1
}

// String length
fn str_len(s) -> i64 {
    return len(s)
}

// Substring
fn str_substring(s, start, end) -> str {
    return substr(s, start, end - start)
}

// Replace all occurrences of old_str with new_str in s
fn str_replace(s, old_str, new_str) -> str {
    let result = s
    let pos = str_index(result, old_str)
    while pos >= 0 {
        let before = substr(result, 0, pos)
        let after = substr(result, pos + str_len(old_str), str_len(result) - pos - str_len(old_str))
        result = concat(concat(before, new_str), after)
        pos = str_index(result, old_str)
    }
    return result
}

// String equals
fn str_equals(a, b) -> i64 {
    return equals(a, b)
}
