// std/ai_swiglu — SwiGLU activation (0.0.171)
// out = x * sigmoid(x) * y = x * (1/(1+exp(-x))) * y

import std/ai_tensor

fn ai_swiglu(out: i64[], x: i64[], y: i64[], n: i64): i64 {
    let i: i64 = 0
    while i < n {
        let xv: i64 = mem_load(x[0] + i * 8)
        let yv: i64 = mem_load(y[0] + i * 8)
        // sigmoid(x) = 1/(1+exp(-x))
        let neg_x: i64 = fsub(i2f(0), xv)
        let exp_neg_x: i64 = pow(i2f(2), fdiv(neg_x, i2f(1)))
        let sig_x: i64 = fdiv(i2f(1), fadd(i2f(1), exp_neg_x))
        mem_store(out[0] + i * 8, fmul(fmul(xv, sig_x), yv))
        i = i + 1
    }
    return 0
}
