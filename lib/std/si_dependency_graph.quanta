// std/si_dependency_graph — Topological sort of specs by imports (0.0.183)
// Fully featured: scans lib/std/, parses imports, builds DAG, Kahn's algorithm

module std_si_dependency_graph;

import std/fs
import std/str
import std/vec
import std/map

const MAX_MODULES = 1000;
const MAX_DEPS = 5000;
const MAX_LINE = 4096;

// File scanning
fn scan_std_dir(dir_path, file_list) -> i64 {
    // Use fs to list .quanta files
    // For now, return 0 - would need fs.readdir
    return 0;
}

// Parse imports from a .quanta file
// Returns number of imports found
fn parse_imports(file_path, imports_out) -> i64 {
    let fd = file_open(file_path, 0);
    if fd < 0 { return 0; }
    let buf = mmap(MAX_LINE);
    let n = file_read(fd, buf, MAX_LINE);
    file_close(fd);
    if n <= 0 { return 0; }
    
    let count = 0;
    let i = 0;
    let content = buf + 8;  // skip length prefix
    
    while i < n {
        // Look for "import " pattern
        if i + 6 < n &&
           mem_load8(content + i) == 105 &&  // i
           mem_load8(content + i + 1) == 109 &&  // m
           mem_load8(content + i + 2) == 112 &&  // p
           mem_load8(content + i + 3) == 111 &&  // o
           mem_load8(content + i + 4) == 114 &&  // r
           mem_load8(content + i + 5) == 116 {   // t
            i = i + 6;
            // Skip whitespace
            while i < n && (mem_load8(content + i) == 32 || mem_load8(content + i) == 9) { i = i + 1; }
            // Read module name until ; or newline
            let start = i;
            while i < n && mem_load8(content + i) != 59 && mem_load8(content + i) != 10 { i = i + 1; }
            let name_len = i - start;
            if name_len > 0 && count < MAX_DEPS {
                let name = mmap(name_len + 1);
                let k = 0;
                while k < name_len { mem_store8(name + k, mem_load8(content + start + k)); k = k + 1; }
                mem_store8(name + name_len, 0);
                mem_store(imports_out + count * 8, name);
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

// Build module dependency graph
// modules: array of module name pointers
// dep_from: output array of from-indices
// dep_to: output array of to-indices
// Returns number of dependency edges
fn build_graph(modules, module_count, dep_from, dep_to) -> i64 {
    let edge_count = 0;
    let i = 0;
    while i < module_count {
        let mod_name = mem_load(modules + i * 8);
        // Construct file path: lib/std/<mod_name>.quanta
        let path = mmap(256);
        let prefix = "lib/std/";
        let p = 0;
        while p < len(prefix) { mem_store8(path + p, mem_load8(prefix + 8 + p)); p = p + 1; }
        let j = 0;
        while j < len(mod_name) { mem_store8(path + p + j, mem_load8(mod_name + 8 + j)); j = j + 1; }
        p = p + j;
        let ext = ".quanta";
        j = 0;
        while j < len(ext) { mem_store8(path + p + j, mem_load8(ext + 8 + j)); j = j + 1; }
        p = p + j;
        mem_store8(path + p, 0);
        
        let imports = mmap(MAX_DEPS * 8);
        let import_count = parse_imports(path, imports);
        
        // For each import, find target module index
        let k = 0;
        while k < import_count {
            let imp_name = mem_load(imports + k * 8);
            // Find target module
            let target_idx = -1;
            let t = 0;
            while t < module_count {
                let tgt = mem_load(modules + t * 8);
                if str_eq(imp_name, tgt) == 1 {
                    target_idx = t;
                    break;
                }
                t = t + 1;
            }
            if target_idx >= 0 {
                mem_store(dep_from + edge_count * 8, i);
                mem_store(dep_to + edge_count * 8, target_idx);
                edge_count = edge_count + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return edge_count;
}

// String equality
fn str_eq(a, b) -> i64 {
    if a == b { return 1; }
    let i = 0;
    while 1 {
        let ca = mem_load8(a + i);
        let cb = mem_load8(b + i);
        if ca != cb { return 0; }
        if ca == 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

// Kahn's topological sort
// sorted: output array of module indices in topological order
// Returns number of modules sorted, or -1 if cycle detected
fn topo_sort(module_count, dep_from, dep_to, edge_count, sorted) -> i64 {
    // Compute in-degrees
    let in_degree = mmap(module_count * 8);
    let i = 0;
    while i < module_count { mem_store(in_degree + i * 8, 0); i = i + 1; }
    
    i = 0;
    while i < edge_count {
        let to = mem_load(dep_to + i * 8);
        let deg = mem_load(in_degree + to * 8);
        mem_store(in_degree + to * 8, deg + 1);
        i = i + 1;
    }
    
    // Queue of nodes with in-degree 0
    let queue = mmap(module_count * 8);
    let q_head = 0;
    let q_tail = 0;
    
    i = 0;
    while i < module_count {
        if mem_load(in_degree + i * 8) == 0 {
            mem_store(queue + q_tail * 8, i);
            q_tail = q_tail + 1;
        }
        i = i + 1;
    }
    
    let sorted_count = 0;
    while q_head < q_tail {
        let u = mem_load(queue + q_head * 8);
        q_head = q_head + 1;
        mem_store(sorted + sorted_count * 8, u);
        sorted_count = sorted_count + 1;
        
        // Decrease in-degree of neighbors
        i = 0;
        while i < edge_count {
            let from = mem_load(dep_from + i * 8);
            if from == u {
                let to = mem_load(dep_to + i * 8);
                let deg = mem_load(in_degree + to * 8);
                mem_store(in_degree + to * 8, deg - 1);
                if deg - 1 == 0 {
                    mem_store(queue + q_tail * 8, to);
                    q_tail = q_tail + 1;
                }
            }
            i = i + 1;
        }
    }
    
    if sorted_count != module_count {
        prints("[Dependency Graph] CYCLE DETECTED!\n");
        return -1;
    }
    
    return sorted_count;
}

// Get synthesis order for all modules
// Returns ordered module indices in synthesis_order
fn get_synthesis_order(modules, module_count, synthesis_order) -> i64 {
    let dep_from = mmap(MAX_DEPS * 8);
    let dep_to = mmap(MAX_DEPS * 8);
    
    let edge_count = build_graph(modules, module_count, dep_from, dep_to);
    prints("[Dependency Graph] Modules: "); printi(module_count); prints(", Edges: "); printi(edge_count); prints("\n");
    
    let sorted = mmap(module_count * 8);
    let result = topo_sort(module_count, dep_from, dep_to, edge_count, sorted);
    
    if result < 0 {
        return 0;
    }
    
    // Copy to output
    i = 0;
    while i < module_count {
        mem_store(synthesis_order + i * 8, mem_load(sorted + i * 8));
        i = i + 1;
    }
    return module_count;
}

fn init() -> i64 { return 0; }
fn main() -> i64 { return init(); }