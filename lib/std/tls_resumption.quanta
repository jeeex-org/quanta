// Replay protection for 0-RTT
let replay_cache = 0
let replay_cache_count = 0
let replay_cache_capacity = 0

fn tls_replay_cache_init(capacity) {
    replay_cache_capacity = capacity
    if capacity == 0 { replay_cache_capacity = 1024 }
    replay_cache = mem_alloc(capacity * 40) // 32-byte hash + 8-byte timestamp
    replay_cache_count = 0
    return 0
}

// Check and record client hello for replay protection
fn tls_replay_check(client_hello_hash, now) {
    // Check if we've seen this client hello recently
    let i = 0
    while i < replay_cache_count {
        let hash = r64(replay_cache + i * 40)
        let timestamp = r64(replay_cache + i * 40 + 32)
        
        // Check if hash matches
        let match = 1
        let j = 0
        while j < 32 {
            if mem_load8(hash + j) != mem_load8(client_hello_hash + j) {
                match = 0
                break
            }
            j = j + 1
        }
        
        if match == 1 {
            // Check if within replay window
            if now - timestamp < REPLAY_WINDOW_MS {
                return -1 // Replay detected
            }
        }
        i = i + 1
    }
    
    // Add to cache
    if replay_cache_count >= replay_cache_capacity {
        // Evict oldest (simple rotation)
        replay_cache_count = 0
    }
    
    let hash = mem_alloc(32)
    if hash == 0 { return -1 }
    let i = 0
    while i < 32 {
        mem_store8(hash + i, mem_load8(client_hello_hash + i))
        i = i + 1
    }
    w64(replay_cache + replay_cache_count * 40, hash)
    w64(replay_cache + replay_cache_count * 40 + 32, now)
    replay_cache_count = replay_cache_count + 1
    
    return 0
}

