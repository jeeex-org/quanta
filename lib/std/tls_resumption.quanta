// TLS Resumption — Session Tickets (RFC 5077), PSK (RFC 8446), 0-RTT with replay protection
// Pure Quanta implementation, zero external deps

include "sha3_hash.quanta"
include "aes_gcm.quanta"
include "x509.quanta"

// TLS 1.3 PSK key exchange modes (RFC 8446 Section 4.2.9)
let TLS_PSK_KE = 0           // PSK only
let TLS_PSK_DHE_KE = 1       // PSK with (EC)DHE

// Ticket format version
let TLS_TICKET_VERSION = 1

// Ticket lifetime hints
let TLS_TICKET_LIFETIME_DEFAULT = 86400 // 24 hours
let TLS_TICKET_AGE_ADD_DEFAULT = 0

// Ticket structure offsets
let TICKET_OFF_VERSION = 0
let TICKET_OFF_CIPHER_SUITE = 8
let TICKET_OFF_KEY_NAME = 16
let TICKET_OFF_IV = 24
let TICKET_OFF_ENCRYPTED_STATE = 56
let TICKET_OFF_STATE_LEN = 88
let TICKET_OFF_LIFETIME = 96
let TICKET_OFF_AGE_ADD = 104
let TICKET_OFF_CREATION_TIME = 112
let TICKET_STRUCT_SIZE = 120

// PSK structure offsets
let PSK_OFF_IDENTITY = 0
let PSK_OFF_BINDER = 8
let PSK_OFF_BINDER_LEN = 16
let PSK_STRUCT_SIZE = 24

// Replay protection
let REPLAY_WINDOW_MS = 10000 // 10 seconds

// Early data context
let EARLY_DATA_CONTEXT_CLIENT = "c e traffic"
let EARLY_DATA_CONTEXT_SERVER = "s e traffic"

// Ticket key context
let ticket_keys = 0
let ticket_key_count = 0
let ticket_key_current = 0
let TICKET_KEY_SIZE = 32
let TICKET_KEY_NAME_SIZE = 16

// TLS context for resumption
let tls_resumption_ctx = 0
let tls_resumption_ctx_len = 0

fn tls_resumption_init(ctx_buf, ctx_len) {
    tls_resumption_ctx = ctx_buf
    tls_resumption_ctx_len = ctx_len
    return 0
}

// Generate new ticket key
fn tls_ticket_key_generate(key_out, key_name_out) {
    let key = mem_alloc(TICKET_KEY_SIZE)
    if key == 0 { return -1 }
    getrandom(key, TICKET_KEY_SIZE, 0)
    
    let name = mem_alloc(TICKET_KEY_NAME_SIZE)
    if name == 0 {
        mem_free(key)
        return -1
    }
    getrandom(name, TICKET_KEY_NAME_SIZE, 0)
    
    w64(key_out, key)
    w64(key_name_out, name)
    return 0
}

// Initialize ticket key store
fn tls_ticket_keys_init(capacity) {
    let cap = capacity
    if cap < 1 { cap = 4 }
    ticket_keys = mem_alloc(cap * (TICKET_KEY_SIZE + TICKET_KEY_NAME_SIZE + 8)) // key + name + creation_time
    if ticket_keys == 0 { return -1 }
    ticket_key_count = 0
    ticket_key_current = 0
    return 0
}

// Add ticket key
fn tls_ticket_key_add(key, key_name, creation_time) {
    if ticket_key_count >= 4 { return -1 } // max 4 keys
    let idx = ticket_key_count
    let base = idx * (TICKET_KEY_SIZE + TICKET_KEY_NAME_SIZE + 8)
    w64(ticket_keys + base, key)
    w64(ticket_keys + base + 8, key_name)
    w64(ticket_keys + base + 16, creation_time)
    ticket_key_count = ticket_key_count + 1
    if ticket_key_current == 0 {
        ticket_key_current = idx
    }
    return 0
}

// Get current ticket key
fn tls_ticket_key_get_current(key_out, key_name_out) {
    if ticket_key_count == 0 { return -1 }
    let base = ticket_key_current * (TICKET_KEY_SIZE + TICKET_KEY_NAME_SIZE + 8)
    w64(key_out, r64(ticket_keys + base))
    w64(key_name_out, r64(ticket_keys + base + 8))
    return 0
}

// Get ticket key by name
fn tls_ticket_key_get_by_name(key_name, key_out) {
    let i = 0
    while i < ticket_key_count {
        let base = i * (TICKET_KEY_SIZE + TICKET_KEY_NAME_SIZE + 8)
        let name = r64(ticket_keys + base + 8)
        let match = 1
        let j = 0
        while j < TICKET_KEY_NAME_SIZE {
            if mem_load8(name + j) != mem_load8(key_name + j) {
                match = 0
                break
            }
            j = j + 1
        }
        if match == 1 {
            w64(key_out, r64(ticket_keys + base))
            return 0
        }
        i = i + 1
    }
    return -1
}

// Rotate ticket key (call periodically)
fn tls_ticket_key_rotate() {
    let new_key = 0
    let new_name = 0
    if tls_ticket_key_generate(new_key, new_name) != 0 { return -1 }
    let now = clock()
    // Convert to seconds
    let now_sec = now / 1000000000
    tls_ticket_key_add(new_key, new_name, now_sec)
    ticket_key_current = ticket_key_count - 1
    return 0
}

// Encrypt ticket state
fn tls_ticket_encrypt_state(plaintext, plaintext_len, key, key_name, iv, ciphertext_out, ciphertext_len_out) {
    // AES-256-GCM encryption
    let tag = mem_alloc(16)
    if tag == 0 { return -1 }
    
    // AAD includes key_name + iv + version
    let aad = mem_alloc(TICKET_KEY_NAME_SIZE + 12 + 1)
    if aad == 0 {
        mem_free(tag)
        return -1
    }
    let i = 0
    while i < TICKET_KEY_NAME_SIZE {
        mem_store8(aad + i, mem_load8(key_name + i))
        i = i + 1
    }
    while i < TICKET_KEY_NAME_SIZE + 12 {
        mem_store8(aad + i, mem_load8(iv + (i - TICKET_KEY_NAME_SIZE)))
        i = i + 1
    }
    mem_store8(aad + i, TLS_TICKET_VERSION)
    
    let res = aes128_gcm_enc(plaintext, plaintext_len, aad, TICKET_KEY_NAME_SIZE + 13, key, iv, ciphertext_out, tag)
    mem_free(aad)
    mem_free(tag)
    return res
}

// Decrypt ticket state
fn tls_ticket_decrypt_state(ciphertext, ciphertext_len, key, key_name, iv, plaintext_out, plaintext_len_out, tag) {
    // AAD includes key_name + iv + version
    let aad = mem_alloc(TICKET_KEY_NAME_SIZE + 12 + 1)
    if aad == 0 { return -1 }
    let i = 0
    while i < TICKET_KEY_NAME_SIZE {
        mem_store8(aad + i, mem_load8(key_name + i))
        i = i + 1
    }
    while i < TICKET_KEY_NAME_SIZE + 12 {
        mem_store8(aad + i, mem_load8(iv + (i - TICKET_KEY_NAME_SIZE)))
        i = i + 1
    }
    mem_store8(aad + i, TLS_TICKET_VERSION)
    
    let res = aes128_gcm_dec(ciphertext, ciphertext_len, aad, TICKET_KEY_NAME_SIZE + 13, key, iv, tag, plaintext_out)
    mem_free(aad)
    return res
}

// Create session ticket (RFC 5077 / RFC 8446)
// state: serialized session state (cipher suite, master secret, etc.)
// state_len: length of state
// lifetime: ticket lifetime in seconds
// age_add: ticket age add (obfuscation)
// Returns DER-encoded ticket
fn tls_create_ticket(state, state_len, lifetime, age_add, ticket_out, ticket_len_out) {
    let key = 0
    let key_name = 0
    if tls_ticket_key_get_current(key, key_name) != 0 { return -1 }
    
    // Generate IV
    let iv = mem_alloc(12)
    if iv == 0 { return -1 }
    getrandom(iv, 12, 0)
    
    // Encrypt state
    let ciphertext = mem_alloc(state_len + 16) // +16 for GCM tag
    if ciphertext == 0 {
        mem_free(iv)
        return -1
    }
    let ciphertext_len = 0
    let tag = mem_alloc(16)
    if tag == 0 {
        mem_free(iv)
        mem_free(ciphertext)
        return -1
    }
    
    let aad = mem_alloc(TICKET_KEY_NAME_SIZE + 12 + 1)
    if aad == 0 {
        mem_free(iv)
        mem_free(ciphertext)
        mem_free(tag)
        return -1
    }
    
    let i = 0
    while i < TICKET_KEY_NAME_SIZE {
        mem_store8(aad + i, mem_load8(key_name + i))
        i = i + 1
    }
    while i < TICKET_KEY_NAME_SIZE + 12 {
        mem_store8(aad + i, mem_load8(iv + (i - TICKET_KEY_NAME_SIZE)))
        i = i + 1
    }
    mem_store8(aad + i, TLS_TICKET_VERSION)
    
    if aes128_gcm_enc(state, state_len, aad, TICKET_KEY_NAME_SIZE + 13, key, iv, ciphertext, tag) != 0 {
        mem_free(iv)
        mem_free(ciphertext)
        mem_free(tag)
        mem_free(aad)
        return -1
    }
    
    // Append tag to ciphertext
    let j = 0
    while j < 16 {
        mem_store8(ciphertext + ciphertext_len + j, mem_load8(tag + j))
        j = j + 1
    }
    ciphertext_len = state_len + 16
    
    // Build ticket structure
    let now = clock()
    let now_sec = now / 1000000000
    
    let ticket = mem_alloc(TICKET_STRUCT_SIZE + ciphertext_len)
    if ticket == 0 {
        mem_free(iv)
        mem_free(ciphertext)
        mem_free(tag)
        mem_free(aad)
        return -1
    }
    
    w64(ticket + TICKET_OFF_VERSION, TLS_TICKET_VERSION)
    w64(ticket + TICKET_OFF_CIPHER_SUITE, 0x1301) // TLS_AES_128_GCM_SHA256 placeholder
    // Copy key_name
    let kn = r64(key_name)
    i = 0
    while i < TICKET_KEY_NAME_SIZE {
        mem_store8(ticket + TICKET_OFF_KEY_NAME + i, mem_load8(kn + i))
        i = i + 1
    }
    // Copy IV
    i = 0
    while i < 12 {
        mem_store8(ticket + TICKET_OFF_IV + i, mem_load8(iv + i))
        i = i + 1
    }
    // Encrypted state pointer
    let enc_state = ticket + TICKET_STRUCT_SIZE
    i = 0
    while i < ciphertext_len {
        mem_store8(enc_state + i, mem_load8(ciphertext + i))
        i = i + 1
    }
    w64(ticket + TICKET_OFF_ENCRYPTED_STATE, enc_state)
    w64(ticket + TICKET_OFF_STATE_LEN, ciphertext_len)
    w64(ticket + TICKET_OFF_LIFETIME, lifetime)
    w64(ticket + TICKET_OFF_AGE_ADD, age_add)
    w64(ticket + TICKET_OFF_CREATION_TIME, now_sec)
    
    w64(ticket_out, ticket)
    w64(ticket_len_out, TICKET_STRUCT_SIZE + ciphertext_len)
    
    mem_free(iv)
    mem_free(ciphertext)
    mem_free(tag)
    mem_free(aad)
    return 0
}

// Parse session ticket
fn tls_parse_ticket(ticket, ticket_len, ticket_out) {
    if ticket_len < TICKET_STRUCT_SIZE { return -1 }
    
    let version = r64(ticket + TICKET_OFF_VERSION)
    if version != TLS_TICKET_VERSION { return -1 }
    
    let parsed = mem_alloc(TICKET_STRUCT_SIZE)
    if parsed == 0 { return -1 }
    
    // Copy fixed fields
    let i = 0
    while i < TICKET_STRUCT_SIZE {
        mem_store8(parsed + i, mem_load8(ticket + i))
        i = i + 1
    }
    
    // Point to encrypted state
    let enc_state = ticket + TICKET_STRUCT_SIZE
    let state_len = r64(ticket + TICKET_OFF_STATE_LEN)
    if state_len != ticket_len - TICKET_STRUCT_SIZE {
        mem_free(parsed)
        return -1
    }
    w64(parsed + TICKET_OFF_ENCRYPTED_STATE, enc_state)
    w64(parsed + TICKET_OFF_STATE_LEN, state_len)
    
    w64(ticket_out, parsed)
    return 0
}

// Decrypt session ticket
fn tls_decrypt_ticket(parsed_ticket, state_out, state_len_out) {
    let key_name = parsed_ticket + TICKET_OFF_KEY_NAME
    let iv = parsed_ticket + TICKET_OFF_IV
    let enc_state = r64(parsed_ticket + TICKET_OFF_ENCRYPTED_STATE)
    let state_len = r64(parsed_ticket + TICKET_OFF_STATE_LEN)
    
    // Get key by name
    let key = 0
    if tls_ticket_key_get_by_name(key_name, key) != 0 { return -1 }
    
    // Split ciphertext and tag
    let ciphertext_len = state_len - 16
    let ciphertext = mem_alloc(ciphertext_len)
    if ciphertext == 0 { return -1 }
    let tag = mem_alloc(16)
    if tag == 0 {
        mem_free(ciphertext)
        return -1
    }
    
    let i = 0
    while i < ciphertext_len {
        mem_store8(ciphertext + i, mem_load8(enc_state + i))
        i = i + 1
    }
    while i < state_len {
        mem_store8(tag + (i - ciphertext_len), mem_load8(enc_state + i))
        i = i + 1
    }
    
    // Decrypt
    let plaintext = mem_alloc(ciphertext_len)
    if plaintext == 0 {
        mem_free(ciphertext)
        mem_free(tag)
        return -1
    }
    
    let aad = mem_alloc(TICKET_KEY_NAME_SIZE + 12 + 1)
    if aad == 0 {
        mem_free(ciphertext)
        mem_free(tag)
        mem_free(plaintext)
        return -1
    }
    
    i = 0
    while i < TICKET_KEY_NAME_SIZE {
        mem_store8(aad + i, mem_load8(key_name + i))
        i = i + 1
    }
    while i < TICKET_KEY_NAME_SIZE + 12 {
        mem_store8(aad + i, mem_load8(iv + (i - TICKET_KEY_NAME_SIZE)))
        i = i + 1
    }
    mem_store8(aad + i, TLS_TICKET_VERSION)
    
    if aes128_gcm_dec(ciphertext, ciphertext_len, aad, TICKET_KEY_NAME_SIZE + 13, key, iv, tag, plaintext) != 0 {
        mem_free(ciphertext)
        mem_free(tag)
        mem_free(plaintext)
        mem_free(aad)
        return -1
    }
    
    mem_free(ciphertext)
    mem_free(tag)
    mem_free(aad)
    
    w64(state_out, plaintext)
    w64(state_len_out, ciphertext_len)
    return 0
}

// Check ticket validity
fn tls_ticket_is_valid(parsed_ticket, now) {
    let lifetime = r64(parsed_ticket + TICKET_OFF_LIFETIME)
    let creation_time = r64(parsed_ticket + TICKET_OFF_CREATION_TIME)
    let expiry = creation_time + lifetime
    if now > expiry { return 0 }
    return 1
}

// Get ticket age
fn tls_ticket_age(parsed_ticket, now) {
    let creation_time = r64(parsed_ticket + TICKET_OFF_CREATION_TIME)
    let age_add = r64(parsed_ticket + TICKET_OFF_AGE_ADD)
    let age = now - creation_time
    return age + age_add
}

// PSK binder computation
fn tls_psk_compute_binder(psk, psk_len, transcript_hash, transcript_len, binder_out) {
    // HKDF-Expand-Label(psk, "res binder", transcript_hash, hash_len)
    // For now use SHA-256 as placeholder
    let label = "res binder"
    let label_len = 10
    let info = mem_alloc(label_len + 1 + transcript_len + 2)
    if info == 0 { return -1 }
    
    let i = 0
    while i < label_len {
        mem_store8(info + i, mem_load8(label + i))
        i = i + 1
    }
    mem_store8(info + i, 0)
    i = i + 1
    let j = 0
    while j < transcript_len {
        mem_store8(info + i + j, mem_load8(transcript_hash + j))
        j = j + 1
    }
    i = i + transcript_len
    // Hash length (2 bytes, big-endian for SHA-256)
    mem_store8(info + i, 0)
    mem_store8(info + i + 1, 32)
    
    // HMAC with PSK as key
    // Using SHA-256 HMAC
    let hmac_key = psk
    let hmac_key_len = psk_len
    let hmac_data = info
    let hmac_data_len = i + 2
    
    // Simplified: just use sha3_256 for now
    // Real impl would use HMAC-SHA256
    sha3_256(hmac_data, hmac_data_len, binder_out)
    
    mem_free(info)
    return 0
}

// Derive PSK from ticket
fn tls_psk_from_ticket(ticket_state, ticket_state_len, psk_out, psk_len_out) {
    // Extract master secret from ticket state and derive PSK
    // For now copy the state as PSK (simplified)
    let psk = mem_alloc(ticket_state_len)
    if psk == 0 { return -1 }
    let i = 0
    while i < ticket_state_len {
        mem_store8(psk + i, mem_load8(ticket_state + i))
        i = i + 1
    }
    w64(psk_out, psk)
    w64(psk_len_out, ticket_state_len)
    return 0
}

// Client hello with PSK (pre-shared key extension)
// identities: array of PSK identity structures
// binders: array of binder values
fn tls_client_hello_psk(identities, identity_count, binders, binder_count, transcript_hash, transcript_len, psk_out, psk_mode_out) {
    // Verify binders
    let i = 0
    while i < identity_count {
        let identity = r64(identities + i * PSK_STRUCT_SIZE)
        let binder = r64(binders + i * 8)
        let binder_len = r64(binders + i * 8 + 8)
        
        // Get PSK for this identity
        let psk = 0
        let psk_len = 0
        if tls_psk_from_ticket(identity, 0, psk, psk_len) != 0 { // placeholder
            i = i + 1
            continue
        }
        
        // Compute expected binder
        let expected_binder = mem_alloc(32)
        if expected_binder == 0 { return -1 }
        
        if tls_psk_compute_binder(psk, psk_len, transcript_hash, transcript_len, expected_binder) != 0 {
            mem_free(expected_binder)
            mem_free(psk)
            return -1
        }
        
        // Compare binders
        let match = 1
        j = 0
        while j < binder_len && j < 32 {
            if mem_load8(binder + j) != mem_load8(expected_binder + j) {
                match = 0
                break
            }
            j = j + 1
        }
        
        mem_free(expected_binder)
        mem_free(psk)
        
        if match == 1 {
            // Valid PSK found
            w64(psk_out, identity)
            w64(psk_mode_out, TLS_PSK_DHE_KE) // Use PSK with DHE
            return 0
        }
        
        i = i + 1
    }
    
    return -1 // No valid PSK
}

