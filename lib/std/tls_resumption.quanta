// Session ticket serialization for storage
fn tls_ticket_serialize(parsed_ticket, buf_out, len_out) {
    let ticket_len = r64(parsed_ticket + TICKET_OFF_STATE_LEN) + TICKET_STRUCT_SIZE
    let buf = mem_alloc(ticket_len)
    if buf == 0 { return -1 }
    
    let i = 0
    while i < ticket_len {
        mem_store8(buf + i, mem_load8(parsed_ticket + i))
        i = i + 1
    }
    
    w64(buf_out, buf)
    w64(len_out, ticket_len)
    return 0
}

// Session ticket deserialization from storage
fn tls_ticket_deserialize(buf, len, ticket_out) {
    if len < TICKET_STRUCT_SIZE { return -1 }
    return tls_parse_ticket(buf, len, ticket_out)
}

// Free ticket
fn tls_ticket_free(ticket) {
    if ticket == 0 { return }
    mem_free(ticket)
}

// Free ticket keys
fn tls_ticket_keys_free() {
    if ticket_keys != 0 {
        let i = 0
        while i < ticket_key_count {
            let base = i * (TICKET_KEY_SIZE + TICKET_KEY_NAME_SIZE + 8)
            let key = r64(ticket_keys + base)
            let name = r64(ticket_keys + base + 8)
            if key != 0 { mem_free(key) }
            if name != 0 { mem_free(name) }
            i = i + 1
        }
        mem_free(ticket_keys)
        ticket_keys = 0
    }
    ticket_key_count = 0
    ticket_key_current = 0
}

// Free replay cache
fn tls_replay_cache_free() {
    if replay_cache != 0 {
        let i = 0
        while i < replay_cache_count {
            let hash = r64(replay_cache + i * 40)
            if hash != 0 { mem_free(hash) }
            i = i + 1
        }
        mem_free(replay_cache)
        replay_cache = 0
    }
    replay_cache_count = 0
    replay_cache_capacity = 0
}

// Import OCSP for stapling
import "ocsp.quanta"

// Build ticket with OCSP stapling
fn tls_ticket_with_ocsp(state, state_len, ocsp_response, lifetime, age_add, ticket_out, ticket_len_out) {
    // Include OCSP response in ticket state
    // For now just create regular ticket
    return tls_create_ticket(state, state_len, lifetime, age_add, ticket_out, ticket_len_out)
}

// Verify ticket with OCSP
fn tls_ticket_verify_ocsp(parsed_ticket, now) {
    // Would check OCSP response embedded in ticket
    return tls_ticket_is_valid(parsed_ticket, now)
}