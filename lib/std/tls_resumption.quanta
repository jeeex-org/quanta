// Derive early traffic secret for 0-RTT
fn tls_derive_early_secret(psk, psk_len, early_secret_out) {
    // early_secret = HKDF-Extract(0, psk)
    // Using SHA-256
    let zero = mem_alloc(32)
    if zero == 0 { return -1 }
    let i = 0
    while i < 32 {
        mem_store8(zero + i, 0)
        i = i + 1
    }
    
    // HKDF-Extract(salt=0, IKM=psk)
    // Simplified: just hash the PSK
    sha3_256(psk, psk_len, early_secret_out)
    
    mem_free(zero)
    return 0
}

