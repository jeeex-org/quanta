// Free certificate struct and all allocated buffers
fn x509_free(cert) {
    if cert == 0 { return }
    // Free serial
    let serial_buf = r64(cert + X509_OFF_SERIAL)
    if serial_buf != 0 { mem_free(serial_buf) }
    // Free sig algo
    let sig_algo = r64(cert + X509_OFF_SIG_ALGO)
    if sig_algo != 0 { mem_free(sig_algo) }
    // Free issuer (not owned, part of original buffer)
    // Free subject (not owned)
    // Free pubkey algo
    let pk_algo = r64(cert + X509_OFF_PUBKEY_ALGO)
    if pk_algo != 0 { mem_free(pk_algo) }
    // Free pubkey
    let pk = r64(cert + X509_OFF_PUBKEY)
    if pk != 0 { mem_free(pk) }
    // Free extensions buffer if owned
    let ext = r64(cert + X509_OFF_EXTENSIONS)
    if ext != 0 { mem_free(ext) }
    mem_free(cert)
}