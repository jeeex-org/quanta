// Parse PEM format (-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----)
// Returns DER buffer and length
fn x509_parse_pem(pem_buf, pem_len, der_out, der_len_out) {
    let begin_marker = "-----BEGIN CERTIFICATE-----"
    let end_marker = "-----END CERTIFICATE-----"
    let begin_len = 27
    let end_len = 25
    
    // Find BEGIN marker
    let i = 0
    let begin_pos = -1
    while i + begin_len <= pem_len {
        let match = 1
        let j = 0
        while j < begin_len {
            if mem_load8(pem_buf + i + j) != mem_load8(begin_marker + j) {
                match = 0
                break
            }
            j = j + 1
        }
        if match == 1 {
            begin_pos = i
            break
        }
        i = i + 1
    }
    if begin_pos == -1 { return -1 }
    
    // Find END marker
    let data_start = begin_pos + begin_len
    i = data_start
    let end_pos = -1
    while i + end_len <= pem_len {
        let match = 1
        let j = 0
        while j < end_len {
            if mem_load8(pem_buf + i + j) != mem_load8(end_marker + j) {
                match = 0
                break
            }
            j = j + 1
        }
        if match == 1 {
            end_pos = i
            break
        }
        i = i + 1
    }
    if end_pos == -1 { return -1 }
    
    // Extract base64 data
    let b64_len = end_pos - data_start
    let b64_buf = mem_alloc(b64_len)
    if b64_buf == 0 { return -1 }
    i = 0
    while i < b64_len {
        mem_store8(b64_buf + i, mem_load8(pem_buf + data_start + i))
        i = i + 1
    }
    
    // Decode base64
    let der_buf = mem_alloc((b64_len * 3) / 4 + 4)
    if der_buf == 0 {
        mem_free(b64_buf)
        return -1
    }
    let der_len = 0
    if base64_decode(b64_buf, b64_len, der_buf, der_len) != 0 {
        mem_free(b64_buf)
        mem_free(der_buf)
        return -1
    }
    mem_free(b64_buf)
    
    w64(der_out, der_buf)
    w64(der_len_out, r64(der_len))
    return 0
}

// Free certificate struct and all allocated buffers
fn x509_free(cert) {
    if cert == 0 { return }
    // Free serial
    let serial_buf = r64(cert + X509_OFF_SERIAL)
    if serial_buf != 0 { mem_free(serial_buf) }
    // Free sig algo
    let sig_algo = r64(cert + X509_OFF_SIG_ALGO)
    if sig_algo != 0 { mem_free(sig_algo) }
    // Free issuer (not owned, part of original buffer)
    // Free subject (not owned)
    // Free pubkey algo
    let pk_algo = r64(cert + X509_OFF_PUBKEY_ALGO)
    if pk_algo != 0 { mem_free(pk_algo) }
    // Free pubkey
    let pk = r64(cert + X509_OFF_PUBKEY)
    if pk != 0 { mem_free(pk) }
    // Free extensions buffer if owned
    let ext = r64(cert + X509_OFF_EXTENSIONS)
    if ext != 0 { mem_free(ext) }
    mem_free(cert)
}