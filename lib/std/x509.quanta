// Check if certificate is expired
fn x509_is_expired(cert, now) {
    let not_after = r64(cert + X509_OFF_NOT_AFTER)
    if now > not_after { return 1 }
    return 0
}

// Check if certificate is not yet valid
fn x509_not_yet_valid(cert, now) {
    let not_before = r64(cert + X509_OFF_NOT_BEFORE)
    if now < not_before { return 1 }
    return 0
}

// Check basic constraints (CA flag)
fn x509_get_basic_constraints(cert, is_ca_out, pathlen_out) {
    // Parse extensions to find basicConstraints
    let ext_buf = r64(cert + X509_OFF_EXTENSIONS)
    let ext_len = r64(cert + X509_OFF_EXTENSIONS + 8)
    if ext_buf == 0 || ext_len == 0 {
        w64(is_ca_out, 0)
        w64(pathlen_out, -1)
        return 0
    }
    // Simplified - would need full extension parsing
    w64(is_ca_out, 0)
    w64(pathlen_out, -1)
    return 0
}

// Check key usage
fn x509_get_key_usage(cert, usage_out) {
    let ext_buf = r64(cert + X509_OFF_EXTENSIONS)
    let ext_len = r64(cert + X509_OFF_EXTENSIONS + 8)
    if ext_buf == 0 || ext_len == 0 {
        w64(usage_out, 0)
        return 0
    }
    w64(usage_out, 0)
    return 0
}

