// X.509 Certificate parser
// Pure Quanta implementation, zero external deps
// Uses lib/std/x509_asn1.quanta for ASN.1 DER decoding

include "x509_asn1.quanta"

// X.509 certificate structure (heap-allocated)
let X509_VERSION_V1 = 0
let X509_VERSION_V2 = 1
let X509_VERSION_V3 = 2

// Certificate fields offsets in heap struct
let X509_OFF_VERSION = 0
let X509_OFF_SERIAL = 8
let X509_OFF_SIG_ALGO = 16
let X509_OFF_ISSUER = 24
let X509_OFF_NOT_BEFORE = 32
let X509_OFF_NOT_AFTER = 40
let X509_OFF_SUBJECT = 48
let X509_OFF_PUBKEY_ALGO = 56
let X509_OFF_PUBKEY = 64
let X509_OFF_EXTENSIONS = 72
let X509_STRUCT_SIZE = 80

// Extension OIDs (as string constants for comparison)
let OID_BASIC_CONSTRAINTS = "2.5.29.19"
let OID_KEY_USAGE = "2.5.29.15"
let OID_SUBJECT_ALT_NAME = "2.5.29.17"
let OID_EXT_KEY_USAGE = "2.5.29.37"
let OID_AUTH_KEY_ID = "2.5.29.35"
let OID_SUBJECT_KEY_ID = "2.5.29.14"
let OID_CRL_DIST_POINTS = "2.5.29.31"
let OID_AUTH_INFO_ACCESS = "1.3.6.1.5.5.7.1.1"

// Key usage bits
let KU_DIGITAL_SIGNATURE = 0x80
let KU_NON_REPUDIATION = 0x40
let KU_KEY_ENCIPHERMENT = 0x20
let KU_DATA_ENCIPHERMENT = 0x10
let KU_KEY_AGREEMENT = 0x08
let KU_KEY_CERT_SIGN = 0x04
let KU_CRL_SIGN = 0x02
let KU_ENCIPHER_ONLY = 0x01
let KU_DECIPHER_ONLY = 0x80 // bit 8 in second byte

// Parse a certificate from DER buffer
// Returns heap pointer to X509 struct, or 0 on error
fn x509_parse_cert(der_buf, der_len) {
    asn_init(der_buf, der_len)
    
    // Parse outer SEQUENCE (Certificate)
    let seq_start = 0
    let seq_end = 0
    if asn_parse_sequence(seq_start, seq_end) != 0 { return 0 }
    
    // Allocate cert struct
    let cert = mem_alloc(X509_STRUCT_SIZE)
    if cert == 0 { return 0 }
    
    // Parse tbsCertificate (first SEQUENCE inside)
    let tbs_start = 0
    let tbs_end = 0
    if asn_parse_sequence(tbs_start, tbs_end) != 0 {
        mem_free(cert)
        return 0
    }
    let saved_pos = asn_pos
    asn_pos = r64(tbs_start)
    
    // Version (optional, default v1) - [0] EXPLICIT
    let tag = 0
    let len = 0
    let version = X509_VERSION_V1
    if asn_read_tag_len(tag, len) == 0 {
        let t = r64(tag)
        if (t & 0xff) == (ASN_CLASS_CONTEXT | 0x00) && (t & 0x80) != 0 {
            // Context-specific constructed [0]
            let inner_start = 0
            let inner_end = 0
            if asn_parse_sequence(inner_start, inner_end) == 0 {
                let inner_saved = asn_pos
                asn_pos = r64(inner_start)
                version = asn_parse_integer()
                asn_pos = inner_saved
                asn_pos = r64(inner_end)
            }
        } else {
            // Not version, rewind
            asn_pos = saved_pos + (asn_pos - r64(tbs_start)) - 1 // approximate rewind
        }
    }
    w64(cert + X509_OFF_VERSION, version)
    
    // Serial number
    let serial_buf = mem_alloc(32)
    let serial_len = 0
    if asn_parse_integer_raw(serial_buf, serial_len) != 0 {
        // Use the integer parser that returns raw bytes
    }
    w64(cert + X509_OFF_SERIAL, serial_buf)
    w64(cert + X509_OFF_SERIAL + 8, serial_len)
    
    // Signature algorithm (AlgorithmIdentifier)
    let sig_algo_start = 0
    let sig_algo_end = 0
    if asn_parse_sequence(sig_algo_start, sig_algo_end) != 0 {
        mem_free(cert)
        return 0
    }
    let algo_saved = asn_pos
    asn_pos = r64(sig_algo_start)
    let algo_oid_buf = mem_alloc(64)
    let algo_oid_len = 0
    asn_parse_oid_raw(algo_oid_buf, algo_oid_len)
    w64(cert + X509_OFF_SIG_ALGO, algo_oid_buf)
    w64(cert + X509_OFF_SIG_ALGO + 8, algo_oid_len)
    asn_pos = algo_saved
    asn_pos = r64(sig_algo_end)
    
    // Issuer (Name)
    let issuer_start = 0
    let issuer_end = 0
    if asn_parse_sequence(issuer_start, issuer_end) != 0 {
        mem_free(cert)
        return 0
    }
    w64(cert + X509_OFF_ISSUER, r64(issuer_start))
    w64(cert + X509_OFF_ISSUER + 8, r64(issuer_end) - r64(issuer_start))
    asn_pos = r64(issuer_end)
    
    // Validity (SEQUENCE of two times)
    let val_start = 0
    let val_end = 0
    if asn_parse_sequence(val_start, val_end) != 0 {
        mem_free(cert)
        return 0
    }
    let val_saved = asn_pos
    asn_pos = r64(val_start)
    let not_before = asn_parse_utc_time()
    if not_before == 0 { not_before = asn_parse_generalized_time() }
    let not_after = asn_parse_utc_time()
    if not_after == 0 { not_after = asn_parse_generalized_time() }
    w64(cert + X509_OFF_NOT_BEFORE, not_before)
    w64(cert + X509_OFF_NOT_AFTER, not_after)
    asn_pos = val_saved
    asn_pos = r64(val_end)
    
    // Subject (Name)
    let subject_start = 0
    let subject_end = 0
    if asn_parse_sequence(subject_start, subject_end) != 0 {
        mem_free(cert)
        return 0
    }
    w64(cert + X509_OFF_SUBJECT, r64(subject_start))
    w64(cert + X509_OFF_SUBJECT + 8, r64(subject_end) - r64(subject_start))
    asn_pos = r64(subject_end)
    
    // SubjectPublicKeyInfo
    let spki_start = 0
    let spki_end = 0
    if asn_parse_sequence(spki_start, spki_end) != 0 {
        mem_free(cert)
        return 0
    }
    let spki_saved = asn_pos
    asn_pos = r64(spki_start)
    
    // AlgorithmIdentifier for public key
    let pk_algo_start = 0
    let pk_algo_end = 0
    if asn_parse_sequence(pk_algo_start, pk_algo_end) != 0 {
        mem_free(cert)
        return 0
    }
    let pk_algo_saved = asn_pos
    asn_pos = r64(pk_algo_start)
    let pk_algo_oid_buf = mem_alloc(64)
    let pk_algo_oid_len = 0
    asn_parse_oid_raw(pk_algo_oid_buf, pk_algo_oid_len)
    w64(cert + X509_OFF_PUBKEY_ALGO, pk_algo_oid_buf)
    w64(cert + X509_OFF_PUBKEY_ALGO + 8, pk_algo_oid_len)
    asn_pos = pk_algo_saved
    asn_pos = r64(pk_algo_end)
    
    // Subject public key (BIT STRING)
    let pk_bits = mem_alloc(512)
    let pk_len = 0
    let unused = 0
    asn_parse_bit_string(pk_bits, pk_len, unused)
    w64(cert + X509_OFF_PUBKEY, pk_bits)
    w64(cert + X509_OFF_PUBKEY + 8, pk_len)
    
    asn_pos = spki_saved
    asn_pos = r64(spki_end)
    
    // Extensions (optional, v3 only) - [3] EXPLICIT
    let ext_buf = 0
    let ext_len = 0
    if version == X509_VERSION_V3 {
        if asn_read_tag_len(tag, len) == 0 {
            let t = r64(tag)
            if (t & 0xff) == (ASN_CLASS_CONTEXT | 0x03) && (t & 0x80) != 0 {
                let inner_start = 0
                let inner_end = 0
                if asn_parse_sequence(inner_start, inner_end) == 0 {
                    ext_buf = r64(inner_start)
                    ext_len = r64(inner_end) - r64(inner_start)
                    asn_pos = r64(inner_end)
                }
            }
        }
    }
    w64(cert + X509_OFF_EXTENSIONS, ext_buf)
    w64(cert + X509_OFF_EXTENSIONS + 8, ext_len)
    
    asn_pos = saved_pos
    asn_pos = r64(tbs_end)
    
    // Signature algorithm (again)
    let sig_algo2_start = 0
    let sig_algo2_end = 0
    if asn_parse_sequence(sig_algo2_start, sig_algo2_end) == 0 {
        asn_pos = r64(sig_algo2_end)
    }
    
    // Signature value (BIT STRING)
    let sig_bits = mem_alloc(512)
    let sig_len = 0
    let sig_unused = 0
    asn_parse_bit_string(sig_bits, sig_len, sig_unused)
    // Could store signature but not needed for validation
    mem_free(sig_bits)
    
    return cert
}

// Parse integer returning raw bytes
fn asn_parse_integer_raw(out_buf, out_len) {
    let tag = 0
    let len = 0
    if asn_read_tag_len(tag, len) != 0 { return -1 }
    if (r64(tag) & 0xff) != ASN_TAG_INTEGER { return -1 }
    let i = 0
    while i < r64(len) {
        let b = mem_load8(asn_buf + asn_pos + i)
        mem_store8(r64(out_buf) + i, b)
        i = i + 1
    }
    w64(out_len, r64(len))
    asn_pos = asn_pos + r64(len)
    return 0
}

// Parse OID returning raw bytes
fn asn_parse_oid_raw(out_buf, out_len) {
    let tag = 0
    let len = 0
    if asn_read_tag_len(tag, len) != 0 { return -1 }
    if (r64(tag) & 0xff) != ASN_TAG_OID { return -1 }
    let i = 0
    while i < len {
        let b = mem_load8(asn_buf + asn_pos + i)
        mem_store8(r64(out_buf) + i, b)
        i = i + 1
    }
    w64(out_len, len)
    asn_pos = asn_pos + len
    return 0
}

// Verify certificate signature
// cert: parsed cert struct
// issuer_pubkey: issuer's public key buffer
// issuer_pubkey_len: length
// Returns 0 on success, -1 on failure
fn x509_verify_signature(cert, issuer_pubkey, issuer_pubkey_len) {
