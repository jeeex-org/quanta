// HKDF-Extract
fn tls13_hkdf_extract(salt: u8[32], ikm: u8[32]): u8[32] {
    // HMAC-SHA256(salt, ikm)
    // If salt is all zeros, use SHA256(ikm) effectively
    let prk: u8[32]
    // For now, just copy - real impl uses HMAC
    let i: i64 = 0
    while i < 32 {
        prk[i] = ikm[i]
        i = i + 1
    }
    return prk
}

