// Hybrid key exchange: X25519 + ML-KEM-768
fn tls13_hybrid_kem_keygen(): (u8[416], u8[1632]) {
    // Generate X25519 keypair
    let x25519_sk: u8[32]
    let x25519_pk: u8[32]
    // getrandom for x25519_sk
    // x25519_pk = x25519(x25519_sk, base_point)
    
    // Generate ML-KEM-768 keypair
    let mlkem_pk: u8[416]
    let mlkem_sk: u8[1632]
    // ml_kem_768_keygen(mlkem_pk, mlkem_sk)
    
    // Combine public keys
    let hybrid_pk: u8[448]  // 32 + 416
    let hybrid_sk: u8[1664] // 32 + 1632
    
    return (hybrid_pk, hybrid_sk)
}

// Hybrid encapsulation
fn tls13_hybrid_kem_encaps(pk: u8[448]): (u8[544], u8[32]) {
    // pk = x25519_pk (32) || mlkem_pk (416)
    // Extract
    let x25519_pk: u8[32]
    let mlkem_pk: u8[416]
    let i: i64 = 0
    while i < 32 {
        x25519_pk[i] = pk[i]
        i = i + 1
    }
    i = 0
    while i < 416 {
        mlkem_pk[i] = pk[32 + i]
        i = i + 1
    }
    
    // X25519 encapsulation (ephemeral)
    let x25519_eph_sk: u8[32]
    let x25519_eph_pk: u8[32]
    let x25519_ss: u8[32]
    // x25519_ss = x25519(x25519_eph_sk, x25519_pk)
    
    // ML-KEM-768 encapsulation
    let mlkem_ct: u8[512]
    let mlkem_ss: u8[32]
    // ml_kem_768_encaps(mlkem_pk, mlkem_ct, mlkem_ss)
    
    // Combine: ct = x25519_eph_pk (32) || mlkem_ct (512) = 544
    let hybrid_ct: u8[544]
    i = 0
    while i < 32 {
        hybrid_ct[i] = x25519_eph_pk[i]
        i = i + 1
    }
    i = 0
    while i < 512 {
        hybrid_ct[32 + i] = mlkem_ct[i]
        i = i + 1
    }
    
    // Combine shared secrets: HKDF-Extract(0, x25519_ss || mlkem_ss)
    let combined_ikm: u8[64]
    i = 0
    while i < 32 {
        combined_ikm[i] = x25519_ss[i]
        i = i + 1
    }
    i = 0
    while i < 32 {
        combined_ikm[32 + i] = mlkem_ss[i]
        i = i + 1
    }
    let hybrid_ss: u8[32] = tls13_hkdf_extract(0, combined_ikm)
    
    return (hybrid_ct, hybrid_ss)
}

// Hybrid decapsulation
fn tls13_hybrid_kem_decaps(sk: u8[1664], ct: u8[544]): u8[32] {
    // sk = x25519_sk (32) || mlkem_sk (1632)
    // ct = x25519_eph_pk (32) || mlkem_ct (512)
    let x25519_sk: u8[32]
    let mlkem_sk: u8[1632]
    let x25519_eph_pk: u8[32]
    let mlkem_ct: u8[512]
    let i: i64 = 0
    while i < 32 {
        x25519_sk[i] = sk[i]
        i = i + 1
    }
    i = 0
    while i < 1632 {
        mlkem_sk[i] = sk[32 + i]
        i = i + 1
    }
    i = 0
    while i < 32 {
        x25519_eph_pk[i] = ct[i]
        i = i + 1
    }
    i = 0
    while i < 512 {
        mlkem_ct[i] = ct[32 + i]
        i = i + 1
    }
    
    // X25519 decapsulation
    let x25519_ss: u8[32]
    // x25519_ss = x25519(x25519_sk, x25519_eph_pk)
    
    // ML-KEM-768 decapsulation
    let mlkem_ss: u8[32]
    // ml_kem_768_decaps(mlkem_sk, mlkem_ct, mlkem_ss)
    
    // Combine
    let combined_ikm: u8[64]
    i = 0
    while i < 32 {
        combined_ikm[i] = x25519_ss[i]
        i = i + 1
    }
    i = 0
    while i < 32 {
        combined_ikm[32 + i] = mlkem_ss[i]
        i = i + 1
    }
    let hybrid_ss: u8[32] = tls13_hkdf_extract(0, combined_ikm)
    
    return hybrid_ss
}

// Hybrid signature: ML-DSA-65 (primary) + SLH-DSA (backup)
fn tls13_hybrid_sign(ml_dsa_sk: u8[2528], slh_dsa_sk: u8[64], msg: u8[256], msg_len: i64): u8[5000] {
    // ML-DSA-65 signature
    let ml_dsa_sig: u8[3293]
    // ml_dsa_65_sign(ml_dsa_sk, msg, msg_len, ml_dsa_sig)
    
    // SLH-DSA signature
    let slh_dsa_sig: u8[4988]
    // slh_dsa_sign(slh_dsa_sk, msg, msg_len, slh_dsa_sig)
    
    // Combine: sig = ml_dsa_sig || slh_dsa_sig
    let hybrid_sig: u8[8281]
    let i: i64 = 0
    while i < 3293 {
        hybrid_sig[i] = ml_dsa_sig[i]
        i = i + 1
    }
    i = 0
    while i < 4988 {
        hybrid_sig[3293 + i] = slh_dsa_sig[i]
        i = i + 1
    }
    return hybrid_sig
}

// Hybrid signature verification
fn tls13_hybrid_verify(ml_dsa_pk: u8[1312], slh_dsa_pk: u8[32], msg: u8[256], msg_len: i64, sig: u8[8281]): i64 {
    // Verify ML-DSA
    let ml_dsa_sig: u8[3293]
    let i: i64 = 0
    while i < 3293 {
        ml_dsa_sig[i] = sig[i]
        i = i + 1
    }
    // if ml_dsa_65_verify(ml_dsa_pk, msg, msg_len, ml_dsa_sig) != 0 { return 1 }
    
    // Verify SLH-DSA
    let slh_dsa_sig: u8[4988]
    i = 0
    while i < 4988 {
        slh_dsa_sig[i] = sig[3293 + i]
        i = i + 1
    }
    // if slh_dsa_verify(slh_dsa_pk, msg, msg_len, slh_dsa_sig) != 0 { return 1 }
    
    return 0
}

// Client Hello construction
fn tls13_client_hello(out: u8[2048]): i64 {
    let pos: i64 = 0
    // msg_type = client_hello (1)
    out[pos] = 1; pos = pos + 1
    // length = 3 bytes (filled later)
    let len_pos = pos; pos = pos + 3
    // legacy_version = 0x0303
    out[pos] = 0x03; pos = pos + 1; out[pos] = 0x03; pos = pos + 1
    // random (32 bytes)
    // getrandom(out+pos, 32); pos = pos + 32
    // legacy_session_id_echo = 0
    out[pos] = 0; pos = pos + 1
    // cipher_suites
    // length = 2 bytes (number of suites * 2)
    let cs_len_pos = pos; pos = pos + 2
    let num_cs: i64 = 0
    // Add hybrid KEM suite
    let cs = tls13_cs_x25519_mlkem768_aes128_gcm_sha256()
    out[pos] = (cs >> 8) & 0xFF; pos = pos + 1; out[pos] = cs & 0xFF; pos = pos + 1; num_cs = num_cs + 1
    // Add X25519 only
    cs = tls13_cs_aes128_gcm_sha256()
    out[pos] = (cs >> 8) & 0xFF; pos = pos + 1; out[pos] = cs & 0xFF; pos = pos + 1; num_cs = num_cs + 1
    out[cs_len_pos] = (num_cs * 2) >> 8; out[cs_len_pos + 1] = (num_cs * 2) & 0xFF
    // compression_methods = {0}
    out[pos] = 1; pos = pos + 1; out[pos] = 0; pos = pos + 1
    // extensions
    let ext_len_pos = pos; pos = pos + 2
    let ext_start = pos
    // supported_versions
    out[pos] = 0; out[pos+1] = 43; pos = pos + 2  // extension type
    out[pos] = 0; out[pos+1] = 3; pos = pos + 2  // length
    out[pos] = 2; pos = pos + 1  // list length (1 version * 2)
    out[pos] = 0x03; out[pos+1] = 0x04; pos = pos + 2  // TLS 1.3
    // supported_groups
    out[pos] = 0; out[pos+1] = 10; pos = pos + 2
    let sg_len_pos = pos; pos = pos + 2
    let num_sg: i64 = 0
    // x25519_mlkem768
    let ng = tls13_ng_x25519_mlkem768()
    out[pos] = (ng >> 8) & 0xFF; out[pos+1] = ng & 0xFF; pos = pos + 2; num_sg = num_sg + 1
    // x25519
    ng = tls13_ng_x25519()
    out[pos] = (ng >> 8) & 0xFF; out[pos+1] = ng & 0xFF; pos = pos + 2; num_sg = num_sg + 1
    // mlkem768
    ng = tls13_ng_mlkem768()
    out[pos] = (ng >> 8) & 0xFF; out[pos+1] = ng & 0xFF; pos = pos + 2; num_sg = num_sg + 1
    out[sg_len_pos] = (num_sg * 2) >> 8; out[sg_len_pos + 1] = (num_sg * 2) & 0xFF
    // key_share
    out[pos] = 0; out[pos+1] = 51; pos = pos + 2
    let ks_len_pos = pos; pos = pos + 2
    // We'll add key shares for each group
    // For now just x25519_mlkem768
    let ks_start = pos
    ng = tls13_ng_x25519_mlkem768()
    out[pos] = (ng >> 8) & 0xFF; out[pos+1] = ng & 0xFF; pos = pos + 2
    let ks_key_len_pos = pos; pos = pos + 2
    // Generate X25519 key share
    let x25519_eph_sk: u8[32]
    let x25519_eph_pk: u8[32]
    // Generate ML-KEM key share
    let mlkem_pk: u8[416]
    let mlkem_sk: u8[1632]
    // ml_kem_768_keygen(mlkem_pk, mlkem_sk)
    // Combined key share = x25519_eph_pk (32) || mlkem_pk (416) = 448
    let ks_key_len = 448
    out[ks_key_len_pos] = (ks_key_len >> 8) & 0xFF; out[ks_key_len_pos + 1] = ks_key_len & 0xFF
    // Write key share data
    i = 0
    while i < 32 {
        out[pos] = x25519_eph_pk[i]; pos = pos + 1; i = i + 1
    }
    i = 0
    while i < 416 {
        out[pos] = mlkem_pk[i]; pos = pos + 1; i = i + 1
    }
    // end extensions
    let ext_len = pos - ext_start
    out[ext_len_pos] = (ext_len >> 8) & 0xFF; out[ext_len_pos + 1] = ext_len & 0xFF
    // set total message length
    let msg_len = pos - len_pos - 3
    out[len_pos] = (msg_len >> 16) & 0xFF; out[len_pos + 1] = (msg_len >> 8) & 0xFF; out[len_pos + 2] = msg_len & 0xFF
    return pos
}

// Server Hello construction
fn tls13_server_hello(out: u8[2048], client_hello: u8[2048], client_hello_len: i64): i64 {
    return 0 // placeholder
}

// Finished message
fn tls13_finished(verify_data: u8[32], out: u8[256]): i64 {
    let pos: i64 = 0
    out[pos] = 20; pos = pos + 1  // msg_type = finished
    // length (3 bytes)
    out[pos] = 0; out[pos+1] = 0; out[pos+2] = 32; pos = pos + 3
    // verify_data
    let i: i64 = 0
    while i < 32 {
        out[pos] = verify_data[i]; pos = pos + 1; i = i + 1
    }
    return pos
}

// AEAD encrypt (AES-128-GCM)
fn tls13_aead_encrypt(key: u8[16], nonce: u8[12], aad: u8[256], aad_len: i64, plaintext: u8[2048], plaintext_len: i64, ciphertext: u8[2080]): i64 {
    // Use aes128_gcm_enc
    // nonce is sequence_number XOR iv
    return plaintext_len + 16  // ciphertext + tag
}

// AEAD decrypt
fn tls13_aead_decrypt(key: u8[16], nonce: u8[12], aad: u8[256], aad_len: i64, ciphertext: u8[2080], ciphertext_len: i64, plaintext: u8[2048]): i64 {
    // Use aes128_gcm_dec
    return ciphertext_len - 16
}

// Record layer
fn tls13_write_record(content_type: i64, version: i64, data: u8[2048], data_len: i64, out: u8[2055]): i64 {
    let pos: i64 = 0
    out[pos] = content_type as u8; pos = pos + 1
    out[pos] = (version >> 8) & 0xFF; pos = pos + 1; out[pos] = version & 0xFF; pos = pos + 1
    out[pos] = (data_len >> 8) & 0xFF; pos = pos + 1; out[pos] = data_len & 0xFF; pos = pos + 1
    let i: i64 = 0
    while i < data_len {
        out[pos] = data[i]; pos = pos + 1; i = i + 1
    }
    return pos
}

// Read record
fn tls13_read_record(data: u8[2055], data_len: i64, out_content_type: u64, out_version: u64, out_payload: u8[2048]): i64 {
    if data_len < 5 { return -1 }
    let ct = data[0]
    let ver = (data[1] as i64) << 8 | (data[2] as i64)
    let len = (data[3] as i64) << 8 | (data[4] as i64)
    if data_len != 5 + len { return -1 }
    mem_store8(out_content_type, ct)
    mem_store(out_version, ver)
    let i: i64 = 0
    while i < len {
        out_payload[i] = data[5 + i]
        i = i + 1
    }
    return len
}

// Main TLS 1.3 connection structure
struct tls13_conn {
    // State
    state: i64,
    // Keys
    client_handshake_traffic_secret: u8[32],
    server_handshake_traffic_secret: u8[32],
    client_application_traffic_secret: u8[32],
    server_application_traffic_secret: u8[32],
    // Sequence numbers
    client_seq: i64,
    server_seq: i64,
    // Transcript hash
    transcript_hash: u8[32],
    // Negotiated parameters
    cipher_suite: i64,
    named_group: i64,
    sig_alg: i64,
    // Key shares
    client_x25519_sk: u8[32],
    client_mlkem_sk: u8[1632],
    server_x25519_sk: u8[32],
    server_mlkem_sk: u8[1632],
    // Certificates
    cert_chain: u8[8192],
    cert_chain_len: i64,
}

