// lib/std/sha3_rhopi.quanta - Keccak rho/pi step (FIPS 202)

include "sha3_base.quanta"

fn keccak_rhopi(st) {
  let a0 = mem_load(st+0); let a1 = mem_load(st+8); let a2 = mem_load(st+16); let a3 = mem_load(st+24); let a4 = mem_load(st+32)
  let a5 = mem_load(st+40); let a6 = mem_load(st+48); let a7 = mem_load(st+56); let a8 = mem_load(st+64); let a9 = mem_load(st+72)
  let a10 = mem_load(st+80); let a11 = mem_load(st+88); let a12 = mem_load(st+96); let a13 = mem_load(st+104); let a14 = mem_load(st+112)
  let a15 = mem_load(st+120); let a16 = mem_load(st+128); let a17 = mem_load(st+136); let a18 = mem_load(st+144); let a19 = mem_load(st+152)
  let a20 = mem_load(st+160); let a21 = mem_load(st+168); let a22 = mem_load(st+176); let a23 = mem_load(st+184); let a24 = mem_load(st+192)

  let b0 = krot(a0, 0); let b1 = krot(a6, 44); let b2 = krot(a12, 43); let b3 = krot(a18, 21); let b4 = krot(a24, 14)
  let b5 = krot(a3, 28); let b6 = krot(a9, 20); let b7 = krot(a10, 3); let b8 = krot(a16, 45); let b9 = krot(a22, 61)
  let b10 = krot(a1, 1); let b11 = krot(a7, 6); let b12 = krot(a13, 25); let b13 = krot(a19, 8); let b14 = krot(a20, 18)
  let b15 = krot(a4, 27); let b16 = krot(a5, 36); let b17 = krot(a11, 10); let b18 = krot(a17, 15); let b19 = krot(a23, 56)
  let b20 = krot(a2, 62); let b21 = krot(a8, 55); let b22 = krot(a14, 39); let b23 = krot(a15, 41); let b24 = krot(a21, 2)

  mem_store(st+0, b0); mem_store(st+8, b1); mem_store(st+16, b2); mem_store(st+24, b3); mem_store(st+32, b4)
  mem_store(st+40, b5); mem_store(st+48, b6); mem_store(st+56, b7); mem_store(st+64, b8); mem_store(st+72, b9)
  mem_store(st+80, b10); mem_store(st+88, b11); mem_store(st+96, b12); mem_store(st+104, b13); mem_store(st+112, b14)
  mem_store(st+120, b15); mem_store(st+128, b16); mem_store(st+136, b17); mem_store(st+144, b18); mem_store(st+152, b19)
  mem_store(st+160, b20); mem_store(st+168, b21); mem_store(st+176, b22); mem_store(st+184, b23); mem_store(st+192, b24)
}