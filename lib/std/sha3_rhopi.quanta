import std/sha3_constants

extern fn malloc(size: u64) -> u64;

fn keccak_rhopi(st) {
  let B = malloc(200)
  let i = 0
  while (i < 25) {
    mem_store(B + i * 8, mem_load(st + i * 8))
    i = i + 1
  }

  let rots = malloc(200)
  mem_store(rots + 0*8, 0); mem_store(rots + 1*8, 1); mem_store(rots + 2*8, 62)
  mem_store(rots + 3*8, 28); mem_store(rots + 4*8, 27); mem_store(rots + 5*8, 36)
  mem_store(rots + 6*8, 44); mem_store(rots + 7*8, 6); mem_store(rots + 8*8, 55)
  mem_store(rots + 9*8, 20); mem_store(rots + 10*8, 3); mem_store(rots + 11*8, 10)
  mem_store(rots + 12*8, 43); mem_store(rots + 13*8, 25); mem_store(rots + 14*8, 39)
  mem_store(rots + 15*8, 41); mem_store(rots + 16*8, 45); mem_store(rots + 17*8, 15)
  mem_store(rots + 18*8, 21); mem_store(rots + 19*8, 8); mem_store(rots + 20*8, 18)
  mem_store(rots + 21*8, 2); mem_store(rots + 22*8, 61); mem_store(rots + 23*8, 56)
  mem_store(rots + 24*8, 14)

  let i = 0
  while (i < 25) {
    let src_idx = 0
    if (i == 0) { src_idx = 0 }
    else if (i == 1) { src_idx = 7 }
    else if (i == 2) { src_idx = 14 }
    else if (i == 3) { src_idx = 21 }
    else if (i == 4) { src_idx = 3 }
    else if (i == 5) { src_idx = 10 }
    else if (i == 6) { src_idx = 17 }
    else if (i == 7) { src_idx = 24 }
    else if (i == 8) { src_idx = 6 }
    else if (i == 9) { src_idx = 13 }
    else if (i == 10) { src_idx = 20 }
    else if (i == 11) { src_idx = 2 }
    else if (i == 12) { src_idx = 9 }
    else if (i == 13) { src_idx = 16 }
    else if (i == 14) { src_idx = 23 }
    else if (i == 15) { src_idx = 5 }
    else if (i == 16) { src_idx = 12 }
    else if (i == 17) { src_idx = 19 }
    else if (i == 18) { src_idx = 1 }
    else if (i == 19) { src_idx = 8 }
    else if (i == 20) { src_idx = 15 }
    else if (i == 21) { src_idx = 22 }
    else if (i == 22) { src_idx = 4 }
    else if (i == 23) { src_idx = 11 }
    else if (i == 24) { src_idx = 18 }
    let lane = mem_load(B + src_idx * 8)
    let rot = mem_load(rots + i * 8)
    let rotated = (lane << rot) | (lane >> (64 - rot))
    mem_store(st + i * 8, rotated)
    i = i + 1
  }
}

extern fn malloc(size: u64) -> u64