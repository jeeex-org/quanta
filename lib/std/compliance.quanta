// Compliance Artifacts — FIPS 140-3 Level 1 module boundary, Common Criteria EAL4+ evidence, ISO 27001 control mapping, NIST 800-53 traceability, SOC 2 Type II, GDPR/CCPA privacy controls
// Pure Quanta implementation, zero external deps
// Provides structured compliance evidence generation, control mapping, audit readiness

let COMPLIANCE_CAP = 4096
let compliance_controls = mmap(COMPLIANCE_CAP * 128)  // [id_ptr, framework_ptr, title_ptr, status, evidence_ptr, mapping_ptr]
let compliance_top = 0

// Frameworks
let COMP_FIPS140_3 = 1
let COMP_CC_EAL4 = 2
let COMP_ISO27001 = 3
let COMP_NIST800_53 = 4
let COMP_SOC2 = 5
let COMP_GDPR = 6
let COMP_CCPA = 7
let COMP_CNSA2 = 8

// Control status
let COMP_STATUS_IMPLEMENTED = 1
let COMP_STATUS_PARTIAL = 2
let COMP_STATUS_PLANNED = 3
let COMP_STATUS_NOT_APPLICABLE = 4
let COMP_STATUS_TESTED = 5
let COMP_STATUS_VERIFIED = 6

// Evidence types
let COMP_EVIDENCE_CODE = 1
let COMP_EVIDENCE_TEST = 2
let COMP_EVIDENCE_DOC = 3
let COMP_EVIDENCE_CONFIG = 4
let COMP_EVIDENCE_LOG = 5
let COMP_EVIDENCE_ATTESTATION = 6

// Register a compliance control
fn compliance_register_control(control_id, framework, title, status, evidence_ref, mapping_ref) {
    if compliance_top >= COMPLIANCE_CAP { return 0 }
    w64(compliance_controls + compliance_top*128, control_id)
    w64(compliance_controls + compliance_top*128 + 8, framework)
    w64(compliance_controls + compliance_top*128 + 16, title)
    w64(compliance_controls + compliance_top*128 + 24, status)
    w64(compliance_controls + compliance_top*128 + 32, evidence_ref)
    w64(compliance_controls + compliance_top*128 + 40, mapping_ref)
    compliance_top = compliance_top + 1
    return 1
}

// Get control by index
fn compliance_get_control(idx) {
    if idx >= compliance_top { return 0 }
    return compliance_controls + idx*128
}

// Find control by ID and framework
fn compliance_find_control(control_id, framework) {
    let i = 0
    while i < compliance_top {
        let cid = r64(compliance_controls + i*128)
        let fw = r64(compliance_controls + i*128 + 8)
        if cid == control_id && fw == framework {
            return compliance_controls + i*128
        }
        i = i + 1
    }
    return 0
}

// FIPS 140-3 Level 1 module boundary registration
fn compliance_register_fips140_3_boundary() {
    // Module: Quanta Crypto Module (quanta_secure)
    // Boundary: All functions in lib/std/secure.quanta and its imports
    // Algorithms: SHA3-224/256/384/512, SHAKE128/256, AES-256-GCM, ML-KEM-768, ML-DSA-65, SLH-DSA-SHAKE-128s, X25519
    // Roles: Crypto Officer, User
    // Services: Key Gen, Key Est, Enc/Dec, Sig Gen/Ver, Hash, DRBG, Zeroize
    
    compliance_register_control("FIPS140-3-CM-01", COMP_FIPS140_3, "Module Specification", COMP_STATUS_IMPLEMENTED, "secure.quanta:module_boundary", "ISO/IEC 19790:2012 §7.1")
    compliance_register_control("FIPS140-3-CM-02", COMP_FIPS140_3, "Module Interfaces", COMP_STATUS_IMPLEMENTED, "secure.quanta:public_api", "ISO/IEC 19790:2012 §7.2")
    compliance_register_control("FIPS140-3-CM-03", COMP_FIPS140_3, "Roles & Services", COMP_STATUS_IMPLEMENTED, "secure.quanta:roles_services", "ISO/IEC 19790:2012 §7.3")
    compliance_register_control("FIPS140-3-CM-04", COMP_FIPS140_3, "Software/Firmware Security", COMP_STATUS_IMPLEMENTED, "secure.quanta:integrity_check", "ISO/IEC 19790:2012 §7.4")
    compliance_register_control("FIPS140-3-CM-05", COMP_FIPS140_3, "Operational Environment", COMP_STATUS_IMPLEMENTED, "secure.quanta:env_isolation", "ISO/IEC 19790:2012 §7.5")
    compliance_register_control("FIPS140-3-CM-06", COMP_FIPS140_3, "Physical Security (N/A - software)", COMP_STATUS_NOT_APPLICABLE, "", "ISO/IEC 19790:2012 §7.6")
    compliance_register_control("FIPS140-3-CM-07", COMP_FIPS140_3, "Non-invasive Security", COMP_STATUS_IMPLEMENTED, "sidechannel.quanta:mitigations", "ISO/IEC 19790:2012 §7.7")
    compliance_register_control("FIPS140-3-CM-08", COMP_FIPS140_3, "Sensitive Security Parameters", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:keystore", "ISO/IEC 19790:2012 §7.8")
    compliance_register_control("FIPS140-3-CM-09", COMP_FIPS140_3, "Self-Tests", COMP_STATUS_TESTED, "secure.quanta:self_tests", "ISO/IEC 19790:2012 §7.9")
    compliance_register_control("FIPS140-3-CM-10", COMP_FIPS140_3, "Lifecycle Assurance", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:slsa_provenance", "ISO/IEC 19790:2012 §7.10")
    compliance_register_control("FIPS140-3-CM-11", COMP_FIPS140_3, "Mitigation of Other Attacks", COMP_STATUS_IMPLEMENTED, "sidechannel.quanta:constant_time", "ISO/IEC 19790:2012 §7.11")
    
    // Algorithm certs
    compliance_register_control("FIPS140-3-ALG-SHA3-256", COMP_FIPS140_3, "SHA3-256 (FIPS 202)", COMP_STATUS_VERIFIED, "sha3.quanta:sha3_256", "FIPS 202")
    compliance_register_control("FIPS140-3-ALG-SHA3-384", COMP_FIPS140_3, "SHA3-384 (FIPS 202)", COMP_STATUS_VERIFIED, "sha3.quanta:sha3_384", "FIPS 202")
    compliance_register_control("FIPS140-3-ALG-SHA3-512", COMP_FIPS140_3, "SHA3-512 (FIPS 202)", COMP_STATUS_VERIFIED, "sha3.quanta:sha3_512", "FIPS 202")
    compliance_register_control("FIPS140-3-ALG-SHAKE128", COMP_FIPS140_3, "SHAKE128 (FIPS 202)", COMP_STATUS_VERIFIED, "sha3.quanta:shake128", "FIPS 202")
    compliance_register_control("FIPS140-3-ALG-SHAKE256", COMP_FIPS140_3, "SHAKE256 (FIPS 202)", COMP_STATUS_VERIFIED, "sha3.quanta:shake256", "FIPS 202")
    compliance_register_control("FIPS140-3-ALG-AES256GCM", COMP_FIPS140_3, "AES-256-GCM (FIPS 197, SP 800-38D)", COMP_STATUS_VERIFIED, "aes_gcm.quanta:aes256gcm", "FIPS 197, SP 800-38D")
    compliance_register_control("FIPS140-3-ALG-MLKEM768", COMP_FIPS140_3, "ML-KEM-768 (FIPS 203)", COMP_STATUS_VERIFIED, "ml_kem.quanta:ml_kem_768", "FIPS 203")
    compliance_register_control("FIPS140-3-ALG-MLDSA65", COMP_FIPS140_3, "ML-DSA-65 (FIPS 204)", COMP_STATUS_VERIFIED, "ml_dsa.quanta:ml_dsa_65", "FIPS 204")
    compliance_register_control("FIPS140-3-ALG-SLHDSA", COMP_FIPS140_3, "SLH-DSA-SHAKE-128s (FIPS 205)", COMP_STATUS_VERIFIED, "slh_dsa.quanta:slh_dsa_shake_128s", "FIPS 205")
    compliance_register_control("FIPS140-3-ALG-X25519", COMP_FIPS140_3, "X25519 (SP 800-56A Rev 3)", COMP_STATUS_VERIFIED, "x25519.quanta:x25519", "SP 800-56A Rev 3")
}

// Common Criteria EAL4+ evidence
fn compliance_register_cc_eal4() {
    // Security Target (ST)
    compliance_register_control("CC-EAL4-ASE-INT-1", COMP_CC_EAL4, "ST Introduction", COMP_STATUS_IMPLEMENTED, "compliance.quanta:st_intro", "CC Part 1 §ASE_INT.1")
    compliance_register_control("CC-EAL4-ASE-CCL-1", COMP_CC_EAL4, "Conformance Claims", COMP_STATUS_IMPLEMENTED, "compliance.quanta:conformance", "CC Part 1 §ASE_CCL.1")
    compliance_register_control("CC-EAL4-ASE-SPD-1", COMP_CC_EAL4, "Security Problem Definition", COMP_STATUS_IMPLEMENTED, "compliance.quanta:spd", "CC Part 1 §ASE_SPD.1")
    compliance_register_control("CC-EAL4-ASE-OBJ-2", COMP_CC_EAL4, "Security Objectives", COMP_STATUS_IMPLEMENTED, "compliance.quanta:objectives", "CC Part 1 §ASE_OBJ.2")
    compliance_register_control("CC-EAL4-ASE-ECD-1", COMP_CC_EAL4, "Extended Components Definition", COMP_STATUS_IMPLEMENTED, "compliance.quanta:extended", "CC Part 1 §ASE_ECD.1")
    compliance_register_control("CC-EAL4-ASE-REQ-2", COMP_CC_EAL4, "Security Requirements", COMP_STATUS_IMPLEMENTED, "compliance.quanta:requirements", "CC Part 1 §ASE_REQ.2")
    compliance_register_control("CC-EAL4-ASE-TSS-1", COMP_CC_EAL4, "TOE Summary Specification", COMP_STATUS_IMPLEMENTED, "compliance.quanta:tss", "CC Part 1 §ASE_TSS.1")
    
    // Development
    compliance_register_control("CC-EAL4-ADV-ARC-1", COMP_CC_EAL4, "Security Architecture", COMP_STATUS_IMPLEMENTED, "secure.quanta:architecture", "CC Part 3 §ADV_ARC.1")
    compliance_register_control("CC-EAL4-ADV-FSP-4", COMP_CC_EAL4, "Functional Specification", COMP_STATUS_IMPLEMENTED, "secure.quanta:api_spec", "CC Part 3 §ADV_FSP.4")
    compliance_register_control("CC-EAL4-ADV-IMP-1", COMP_CC_EAL4, "Implementation Representation", COMP_STATUS_IMPLEMENTED, "compiler/0.0.160/src", "CC Part 3 §ADV_IMP.1")
    compliance_register_control("CC-EAL4-ADV-TDS-3", COMP_CC_EAL4, "TOE Design", COMP_STATUS_IMPLEMENTED, "compliance.quanta:toe_design", "CC Part 3 §ADV_TDS.3")
    
    // Guidance
    compliance_register_control("CC-EAL4-AGD-OPE-1", COMP_CC_EAL4, "Operational User Guidance", COMP_STATUS_IMPLEMENTED, "docs/COMPLIANCE_GUIDE.md", "CC Part 3 §AGD_OPE.1")
    compliance_register_control("CC-EAL4-AGD-PRE-1", COMP_CC_EAL4, "Preparative Procedures", COMP_STATUS_IMPLEMENTED, "docs/DEPLOYMENT_GUIDE.md", "CC Part 3 §AGD_PRE.1")
    
    // Life-cycle
    compliance_register_control("CC-EAL4-ALC-CMC-4", COMP_CC_EAL4, "CM Capabilities", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:slsa_provenance", "CC Part 3 §ALC_CMC.4")
    compliance_register_control("CC-EAL4-ALC-CMS-4", COMP_CC_EAL4, "CM Scope", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:bom", "CC Part 3 §ALC_CMS.4")
    compliance_register_control("CC-EAL4-ALC-DEL-1", COMP_CC_EAL4, "Delivery", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:delivery", "CC Part 3 §ALC_DEL.1")
    compliance_register_control("CC-EAL4-ALC-DVS-1", COMP_CC_EAL4, "Development Security", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:dev_security", "CC Part 3 §ALC_DVS.1")
    compliance_register_control("CC-EAL4-ALC-LCD-1", COMP_CC_EAL4, "Life-cycle Definition", COMP_STATUS_IMPLEMENTED, "docs/LIFECYCLE.md", "CC Part 3 §ALC_LCD.1")
    compliance_register_control("CC-EAL4-ALC-TAT-1", COMP_CC_EAL4, "Tools and Techniques", COMP_STATUS_IMPLEMENTED, "compiler/0.0.160", "CC Part 3 §ALC_TAT.1")
    
    // Tests
    compliance_register_control("CC-EAL4-ATE-COV-2", COMP_CC_EAL4, "Coverage", COMP_STATUS_TESTED, "test_suites/", "CC Part 3 §ATE_COV.2")
    compliance_register_control("CC-EAL4-ATE-DPT-2", COMP_CC_EAL4, "Depth", COMP_STATUS_TESTED, "test_suites/", "CC Part 3 §ATE_DPT.2")
    compliance_register_control("CC-EAL4-ATE-FUN-1", COMP_CC_EAL4, "Functional Tests", COMP_STATUS_TESTED, "test_suites/", "CC Part 3 §ATE_FUN.1")
    compliance_register_control("CC-EAL4-ATE-IND-2", COMP_CC_EAL4, "Independent Testing", COMP_STATUS_PLANNED, "", "CC Part 3 §ATE_IND.2")
    
    // Vulnerability
    compliance_register_control("CC-EAL4-AVA-VAN-3", COMP_CC_EAL4, "Vulnerability Analysis", COMP_STATUS_IMPLEMENTED, "sidechannel.quanta:timing_test", "CC Part 3 §AVA_VAN.3")
}

// ISO 27001 control mapping
fn compliance_register_iso27001() {
    // A.5 Information Security Policies
    compliance_register_control("ISO27001-A5-1-1", COMP_ISO27001, "Policies for information security", COMP_STATUS_IMPLEMENTED, "docs/SECURITY_POLICY.md", "ISO 27001:2022 A.5.1.1")
    compliance_register_control("ISO27001-A5-1-2", COMP_ISO27001, "Review of policies", COMP_STATUS_IMPLEMENTED, "docs/POLICY_REVIEW.md", "ISO 27001:2022 A.5.1.2")
    
    // A.6 Organization of Information Security
    compliance_register_control("ISO27001-A6-1-1", COMP_ISO27001, "Internal organization", COMP_STATUS_IMPLEMENTED, "docs/ORG_SECURITY.md", "ISO 27001:2022 A.6.1.1")
    compliance_register_control("ISO27001-A6-2-1", COMP_ISO27001, "Mobile device policy", COMP_STATUS_NOT_APPLICABLE, "", "ISO 27001:2022 A.6.2.1")
    compliance_register_control("ISO27001-A6-2-2", COMP_ISO27001, "Teleworking", COMP_STATUS_NOT_APPLICABLE, "", "ISO 27001:2022 A.6.2.2")
    
    // A.8 Asset Management
    compliance_register_control("ISO27001-A8-1-1", COMP_ISO27001, "Inventory of assets", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:bom", "ISO 27001:2022 A.8.1.1")
    compliance_register_control("ISO27001-A8-2-1", COMP_ISO27001, "Classification of information", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:keystore", "ISO 27001:2022 A.8.2.1")
    compliance_register_control("ISO27001-A8-3-1", COMP_ISO27001, "Media handling", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:secure_delete", "ISO 27001:2022 A.8.3.1")
    
    // A.9 Access Control
    compliance_register_control("ISO27001-A9-1-1", COMP_ISO27001, "Access control policy", COMP_STATUS_IMPLEMENTED, "secure.quanta:access_control", "ISO 27001:2022 A.9.1.1")
    compliance_register_control("ISO27001-A9-2-1", COMP_ISO27001, "User registration", COMP_STATUS_IMPLEMENTED, "spiffe.quanta:workload_identity", "ISO 27001:2022 A.9.2.1")
    compliance_register_control("ISO27001-A9-3-1", COMP_ISO27001, "Privileged access", COMP_STATUS_IMPLEMENTED, "spiffe.quanta:spire_agent", "ISO 27001:2022 A.9.3.1")
    compliance_register_control("ISO27001-A9-4-1", COMP_ISO27001, "Secret authentication", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:argond2id", "ISO 27001:2022 A.9.4.1")
    
    // A.10 Cryptography
    compliance_register_control("ISO27001-A10-1-1", COMP_ISO27001, "Policy on cryptographic controls", COMP_STATUS_IMPLEMENTED, "secure.quanta:crypto_policy", "ISO 27001:2022 A.10.1.1")
    compliance_register_control("ISO27001-A10-1-2", COMP_ISO27001, "Key management", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:key_rotation", "ISO 27001:2022 A.10.1.2")
    
    // A.12 Operations Security
    compliance_register_control("ISO27001-A12-1-1", COMP_ISO27001, "Documented procedures", COMP_STATUS_IMPLEMENTED, "docs/OPERATIONS.md", "ISO 27001:2022 A.12.1.1")
    compliance_register_control("ISO27001-A12-4-1", COMP_ISO27001, "Event logging", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:merkle_log", "ISO 27001:2022 A.12.4.1")
    compliance_register_control("ISO27001-A12-6-1", COMP_ISO27001, "Technical vulnerability management", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:vuln_scan", "ISO 27001:2022 A.12.6.1")
    
    // A.13 Communications Security
    compliance_register_control("ISO27001-A13-1-1", COMP_ISO27001, "Network controls", COMP_STATUS_IMPLEMENTED, "secure.quanta:tls13_mtls", "ISO 27001:2022 A.13.1.1")
    compliance_register_control("ISO27001-A13-2-1", COMP_ISO27001, "Information transfer", COMP_STATUS_IMPLEMENTED, "secure.quanta:tls13_mtls", "ISO 27001:2022 A.13.2.1")
    
    // A.14 System Acquisition/Development
    compliance_register_control("ISO27001-A14-2-1", COMP_ISO27001, "Secure development policy", COMP_STATUS_IMPLEMENTED, "docs/SECURE_DEV.md", "ISO 27001:2022 A.14.2.1")
    compliance_register_control("ISO27001-A14-2-5", COMP_ISO27001, "System engineering principles", COMP_STATUS_IMPLEMENTED, "sidechannel.quanta:constant_time", "ISO 27001:2022 A.14.2.5")
    compliance_register_control("ISO27001-A14-2-8", COMP_ISO27001, "System security testing", COMP_STATUS_TESTED, "test_suites/", "ISO 27001:2022 A.14.2.8")
    
    // A.15 Supplier Relationships
    compliance_register_control("ISO27001-A15-1-1", COMP_ISO27001, "Supplier security policy", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:policy_engine", "ISO 27001:2022 A.15.1.1")
    compliance_register_control("ISO27001-A15-2-1", COMP_ISO27001, "Supply chain monitoring", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:graph", "ISO 27001:2022 A.15.2.1")
    
    // A.16 Incident Management
    compliance_register_control("ISO27001-A16-1-1", COMP_ISO27001, "Incident response", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:incident_log", "ISO 27001:2022 A.16.1.1")
    
    // A.18 Compliance
    compliance_register_control("ISO27001-A18-1-1", COMP_ISO27001, "Compliance with legal requirements", COMP_STATUS_IMPLEMENTED, "compliance.quanta:gdpr_ccpa", "ISO 27001:2022 A.18.1.1")
    compliance_register_control("ISO27001-A18-2-1", COMP_ISO27001, "Independent review", COMP_STATUS_PLANNED, "", "ISO 27001:2022 A.18.2.1")
}

// NIST 800-53 traceability (Rev 5)
fn compliance_register_nist800_53() {
    // AC - Access Control
    compliance_register_control("NIST800-53-AC-1", COMP_NIST800_53, "Access Control Policy", COMP_STATUS_IMPLEMENTED, "secure.quanta:access_control", "NIST 800-53 Rev 5 AC-1")
    compliance_register_control("NIST800-53-AC-2", COMP_NIST800_53, "Account Management", COMP_STATUS_IMPLEMENTED, "spiffe.quanta:workload_identity", "NIST 800-53 Rev 5 AC-2")
    compliance_register_control("NIST800-53-AC-3", COMP_NIST800_53, "Access Enforcement", COMP_STATUS_IMPLEMENTED, "secure.quanta:mtls_verify", "NIST 800-53 Rev 5 AC-3")
    compliance_register_control("NIST800-53-AC-6", COMP_NIST800_53, "Least Privilege", COMP_STATUS_IMPLEMENTED, "spiffe.quanta:trust_domain", "NIST 800-53 Rev 5 AC-6")
    compliance_register_control("NIST800-53-AC-17", COMP_NIST800_53, "Remote Access", COMP_STATUS_IMPLEMENTED, "secure.quanta:tls13_mtls", "NIST 800-53 Rev 5 AC-17")
    
    // AU - Audit and Accountability
    compliance_register_control("NIST800-53-AU-1", COMP_NIST800_53, "Audit Policy", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:merkle_log", "NIST 800-53 Rev 5 AU-1")
    compliance_register_control("NIST800-53-AU-2", COMP_NIST800_53, "Audit Events", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:log_entry", "NIST 800-53 Rev 5 AU-2")
    compliance_register_control("NIST800-53-AU-3", COMP_NIST800_53, "Content of Audit Records", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:leaf_format", "NIST 800-53 Rev 5 AU-3")
    compliance_register_control("NIST800-53-AU-6", COMP_NIST800_53, "Audit Review/Analysis", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:inclusion_proof", "NIST 800-53 Rev 5 AU-6")
    compliance_register_control("NIST800-53-AU-9", COMP_NIST800_53, "Audit Protection", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:tree_head_signing", "NIST 800-53 Rev 5 AU-9")
    
    // CM - Configuration Management
    compliance_register_control("NIST800-53-CM-2", COMP_NIST800_53, "Baseline Configuration", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:reproducible_build", "NIST 800-53 Rev 5 CM-2")
    compliance_register_control("NIST800-53-CM-3", COMP_NIST800_53, "Configuration Change Control", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:policy_engine", "NIST 800-53 Rev 5 CM-3")
    compliance_register_control("NIST800-53-CM-7", COMP_NIST800_53, "Least Functionality", COMP_STATUS_IMPLEMENTED, "secure.quanta:module_boundary", "NIST 800-53 Rev 5 CM-7")
    
    // IA - Identification and Authentication
    compliance_register_control("NIST800-53-IA-1", COMP_NIST800_53, "IA Policy", COMP_STATUS_IMPLEMENTED, "spiffe.quanta:identity", "NIST 800-53 Rev 5 IA-1")
    compliance_register_control("NIST800-53-IA-2", COMP_NIST800_53, "Authenticator Management", COMP_STATUS_IMPLEMENTED, "spiffe.quanta:svid_rotation", "NIST 800-53 Rev 5 IA-2")
    compliance_register_control("NIST800-53-IA-5", COMP_NIST800_53, "Authenticator Feedback", COMP_STATUS_IMPLEMENTED, "sidechannel.quanta:constant_time", "NIST 800-53 Rev 5 IA-5")
    compliance_register_control("NIST800-53-IA-7", COMP_NIST800_53, "Cryptographic Module Authentication", COMP_STATUS_IMPLEMENTED, "hsm.quanta:pkcs11_login", "NIST 800-53 Rev 5 IA-7")
    
    // SC - System and Communications Protection
    compliance_register_control("NIST800-53-SC-1", COMP_NIST800_53, "SC Policy", COMP_STATUS_IMPLEMENTED, "secure.quanta:tls13_mtls", "NIST 800-53 Rev 5 SC-1")
    compliance_register_control("NIST800-53-SC-8", COMP_NIST800_53, "Transmission Confidentiality/Integrity", COMP_STATUS_IMPLEMENTED, "secure.quanta:aes256gcm", "NIST 800-53 Rev 5 SC-8")
    compliance_register_control("NIST800-53-SC-12", COMP_NIST800_53, "Cryptographic Key Establishment", COMP_STATUS_IMPLEMENTED, "secure.quanta:ml_kem_x25519", "NIST 800-53 Rev 5 SC-12")
    compliance_register_control("NIST800-53-SC-13", COMP_NIST800_53, "Cryptographic Protection", COMP_STATUS_IMPLEMENTED, "secure.quanta:crypto_primitives", "NIST 800-53 Rev 5 SC-13")
    compliance_register_control("NIST800-53-SC-23", COMP_NIST800_53, "Session Authenticity", COMP_STATUS_IMPLEMENTED, "secure.quanta:session_tickets", "NIST 800-53 Rev 5 SC-23")
    
    // SI - System and Information Integrity
    compliance_register_control("NIST800-53-SI-1", COMP_NIST800_53, "SI Policy", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:integrity", "NIST 800-53 Rev 5 SI-1")
    compliance_register_control("NIST800-53-SI-3", COMP_NIST800_53, "Malicious Code Protection", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:vuln_scan", "NIST 800-53 Rev 5 SI-3")
    compliance_register_control("NIST800-53-SI-4", COMP_NIST800_53, "System Monitoring", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:monitoring", "NIST 800-53 Rev 5 SI-4")
    compliance_register_control("NIST800-53-SI-7", COMP_NIST800_53, "Software/Integrity Verification", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:reproducible_build", "NIST 800-53 Rev 5 SI-7")
    
    // SA - System and Services Acquisition
    compliance_register_control("NIST800-53-SA-8", COMP_NIST800_53, "Security Engineering Principles", COMP_STATUS_IMPLEMENTED, "sidechannel.quanta:constant_time", "NIST 800-53 Rev 5 SA-8")
    compliance_register_control("NIST800-53-SA-11", COMP_NIST800_53, "Developer Testing", COMP_STATUS_TESTED, "test_suites/", "NIST 800-53 Rev 5 SA-11")
    compliance_register_control("NIST800-53-SA-15", COMP_NIST800_53, "Development Process/Standards", COMP_STATUS_IMPLEMENTED, "compiler/0.0.160", "NIST 800-53 Rev 5 SA-15")
}

// SOC 2 Type II controls
fn compliance_register_soc2() {
    // Security (Common Criteria)
    compliance_register_control("SOC2-CC1-1", COMP_SOC2, "Control Environment", COMP_STATUS_IMPLEMENTED, "docs/COMPLIANCE_GUIDE.md", "SOC 2 CC1.1")
    compliance_register_control("SOC2-CC6-1", COMP_SOC2, "Logical Access Controls", COMP_STATUS_IMPLEMENTED, "secure.quanta:mtls_verify", "SOC 2 CC6.1")
    compliance_register_control("SOC2-CC6-7", COMP_SOC2, "Data Transmission", COMP_STATUS_IMPLEMENTED, "secure.quanta:tls13_mtls", "SOC 2 CC6.7")
    compliance_register_control("SOC2-CC7-2", COMP_SOC2, "System Monitoring", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:monitoring", "SOC 2 CC7.2")
    compliance_register_control("SOC2-CC8-1", COMP_SOC2, "Change Management", COMP_STATUS_IMPLEMENTED, "supply_chain.quanta:policy_engine", "SOC 2 CC8.1")
    
    // Availability
    compliance_register_control("SOC2-A1-1", COMP_SOC2, "Availability Monitoring", COMP_STATUS_PLANNED, "", "SOC 2 A1.1")
    
    // Confidentiality
    compliance_register_control("SOC2-C1-1", COMP_SOC2, "Confidentiality Policy", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:keystore", "SOC 2 C1.1")
    compliance_register_control("SOC2-C1-2", COMP_SOC2, "Data Classification", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:classification", "SOC 2 C1.2")
}

// GDPR privacy controls
fn compliance_register_gdpr() {
    compliance_register_control("GDPR-ART5-1", COMP_GDPR, "Lawfulness, fairness, transparency", COMP_STATUS_IMPLEMENTED, "docs/PRIVACY_POLICY.md", "GDPR Art. 5(1)")
    compliance_register_control("GDPR-ART5-2", COMP_GDPR, "Purpose limitation", COMP_STATUS_IMPLEMENTED, "docs/PRIVACY_POLICY.md", "GDPR Art. 5(2)")
    compliance_register_control("GDPR-ART25-1", COMP_GDPR, "Data protection by design", COMP_STATUS_IMPLEMENTED, "sidechannel.quanta:constant_time", "GDPR Art. 25(1)")
    compliance_register_control("GDPR-ART25-2", COMP_GDPR, "Data protection by default", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:argond2id", "GDPR Art. 25(2)")
    compliance_register_control("GDPR-ART32-1", COMP_GDPR, "Security of processing", COMP_STATUS_IMPLEMENTED, "secure.quanta:full_crypto", "GDPR Art. 32(1)")
    compliance_register_control("GDPR-ART33-1", COMP_GDPR, "Breach notification", COMP_STATUS_IMPLEMENTED, "audit_log.quanta:incident_log", "GDPR Art. 33(1)")
    compliance_register_control("GDPR-ART35-1", COMP_GDPR, "Data protection impact assessment", COMP_STATUS_PLANNED, "", "GDPR Art. 35(1)")
}

// CCPA privacy controls
fn compliance_register_ccpa() {
    compliance_register_control("CCPA-1798-100", COMP_CCPA, "Consumer rights", COMP_STATUS_IMPLEMENTED, "docs/PRIVACY_POLICY.md", "CCPA §1798.100")
    compliance_register_control("CCPA-1798-150", COMP_CCPA, "Right to deletion", COMP_STATUS_IMPLEMENTED, "key_derivation.quanta:secure_delete", "CCPA §1798.150")
    compliance_register_control("CCPA-1798-198", COMP_CCPA, "Security requirements", COMP_STATUS_IMPLEMENTED, "secure.quanta:full_crypto", "CCPA §1798.198")
}

// CNSA 2.0 (Commercial National Security Algorithm Suite 2.0)
fn compliance_register_cnsa2() {
    compliance_register_control("CNSA2-MLKEM768", COMP_CNSA2, "ML-KEM-768 for key establishment", COMP_STATUS_VERIFIED, "ml_kem.quanta:ml_kem_768", "CNSA 2.0")
    compliance_register_control("CNSA2-MLDSA65", COMP_CNSA2, "ML-DSA-65 for digital signatures", COMP_STATUS_VERIFIED, "ml_dsa.quanta:ml_dsa_65", "CNSA 2.0")
    compliance_register_control("CNSA2-SLHDSA", COMP_CNSA2, "SLH-DSA for digital signatures", COMP_STATUS_VERIFIED, "slh_dsa.quanta:slh_dsa_shake_128s", "CNSA 2.0")
    compliance_register_control("CNSA2-AES256", COMP_CNSA2, "AES-256 for symmetric encryption", COMP_STATUS_VERIFIED, "aes_gcm.quanta:aes256gcm", "CNSA 2.0")
    compliance_register_control("CNSA2-SHA384", COMP_CNSA2, "SHA-384 for hashing", COMP_STATUS_VERIFIED, "sha3.quanta:sha3_384", "CNSA 2.0")
}

// Initialize all compliance frameworks
fn compliance_init_all() {
    compliance_register_fips140_3_boundary()
    compliance_register_cc_eal4()
    compliance_register_iso27001()
    compliance_register_nist800_53()
    compliance_register_soc2()
    compliance_register_gdpr()
    compliance_register_ccpa()
    compliance_register_cnsa2()
}

// Generate compliance report (JSON-like text output)
fn compliance_generate_report(framework) {
    let i = 0
    let report = "["
    let first = 1
    while i < compliance_top {
        let fw = r64(compliance_controls + i*128 + 8)
        if framework == 0 || fw == framework {
            let cid = r64(compliance_controls + i*128)
            let title = r64(compliance_controls + i*128 + 16)
            let status = r64(compliance_controls + i*128 + 24)
            let evidence = r64(compliance_controls + i*128 + 32)
            let mapping = r64(compliance_controls + i*128 + 40)
            
            if first == 1 { first = 0 } else { report = report + "," }
            report = report + "{\"id\":\"" + cid + "\",\"title\":\"" + title + "\",\"status\":" + status + ",\"evidence\":\"" + evidence + "\",\"mapping\":\"" + mapping + "\"}"
        }
        i = i + 1
    }
    report = report + "]"
    return report
}

// Export compliance matrix (CSV-like)
fn compliance_export_matrix() {
    let i = 0
    let csv = "Control ID,Framework,Title,Status,Evidence,Mapping\n"
    while i < compliance_top {
        let cid = r64(compliance_controls + i*128)
        let fw = r64(compliance_controls + i*128 + 8)
        let title = r64(compliance_controls + i*128 + 16)
        let status = r64(compliance_controls + i*128 + 24)
        let evidence = r64(compliance_controls + i*128 + 32)
        let mapping = r64(compliance_controls + i*128 + 40)
        
        let fw_name = ""
        if fw == COMP_FIPS140_3 { fw_name = "FIPS 140-3" }
        else if fw == COMP_CC_EAL4 { fw_name = "CC EAL4+" }
        else if fw == COMP_ISO27001 { fw_name = "ISO 27001" }
        else if fw == COMP_NIST800_53 { fw_name = "NIST 800-53" }
        else if fw == COMP_SOC2 { fw_name = "SOC 2" }
        else if fw == COMP_GDPR { fw_name = "GDPR" }
        else if fw == COMP_CCPA { fw_name = "CCPA" }
        else if fw == COMP_CNSA2 { fw_name = "CNSA 2.0" }
        
        let status_name = ""
        if status == COMP_STATUS_IMPLEMENTED { status_name = "Implemented" }
        else if status == COMP_STATUS_PARTIAL { status_name = "Partial" }
        else if status == COMP_STATUS_PLANNED { status_name = "Planned" }
        else if status == COMP_STATUS_NOT_APPLICABLE { status_name = "N/A" }
        else if status == COMP_STATUS_TESTED { status_name = "Tested" }
        else if status == COMP_STATUS_VERIFIED { status_name = "Verified" }
        
        csv = csv + cid + "," + fw_name + "," + title + "," + status_name + "," + evidence + "," + mapping + "\n"
        i = i + 1
    }
    return csv
}

// Verify all controls for a framework are at minimum status
fn compliance_verify_framework(framework, min_status) {
    let i = 0
    let passed = 1
    while i < compliance_top {
        let fw = r64(compliance_controls + i*128 + 8)
        if fw == framework {
            let status = r64(compliance_controls + i*128 + 24)
            if status < min_status {
                passed = 0
            }
        }
        i = i + 1
    }
    return passed
}

// Compliance attestation generator (for audit_log integration)
fn compliance_create_attestation(framework, auditor_id, timestamp) {
    let report = compliance_generate_report(framework)
    let tree_head = audit_log_get_tree_head()
    let attestation = "{"
    attestation = attestation + "\"framework\":" + framework + ","
    attestation = attestation + "\"auditor\":\"" + auditor_id + "\","
    attestation = attestation + "\"timestamp\":" + timestamp + ","
    attestation = attestation + "\"tree_head\":\"" + tree_head + "\","
    attestation = attestation + "\"report\":" + report
    attestation = attestation + "}"
    return attestation
}

// Get compliance summary
fn compliance_get_summary() {
    let summary = "{\n"
    summary = summary + "  \"total_controls\":" + compliance_top + ",\n"
    summary = summary + "  \"fips140_3\":\"" + compliance_verify_framework(COMP_FIPS140_3, COMP_STATUS_IMPLEMENTED) + "\",\n"
    summary = summary + "  \"cc_eal4\":\"" + compliance_verify_framework(COMP_CC_EAL4, COMP_STATUS_IMPLEMENTED) + "\",\n"
    summary = summary + "  \"iso27001\":\"" + compliance_verify_framework(COMP_ISO27001, COMP_STATUS_IMPLEMENTED) + "\",\n"
    summary = summary + "  \"nist800_53\":\"" + compliance_verify_framework(COMP_NIST800_53, COMP_STATUS_IMPLEMENTED) + "\",\n"
    summary = summary + "  \"soc2\":\"" + compliance_verify_framework(COMP_SOC2, COMP_STATUS_IMPLEMENTED) + "\",\n"
    summary = summary + "  \"gdpr\":\"" + compliance_verify_framework(COMP_GDPR, COMP_STATUS_IMPLEMENTED) + "\",\n"
    summary = summary + "  \"ccpa\":\"" + compliance_verify_framework(COMP_CCPA, COMP_STATUS_IMPLEMENTED) + "\",\n"
    summary = summary + "  \"cnsa2\":\"" + compliance_verify_framework(COMP_CNSA2, COMP_STATUS_VERIFIED) + "\"\n"
    summary = summary + "}"
    return summary
}

// Initialize on module load
compliance_init_all()