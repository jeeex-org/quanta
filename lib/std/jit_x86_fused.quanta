// ============================================================================
// Upper half of lib/std/jit_x86_fused.quanta
// ============================================================================
// Register-resident fused Q4_K dequant-dot kernel for x86-64 AVX2.
//
// WHAT IS FUSED: today's forward makes two passes per row -- dequantize each
// 256-weight super-block into an f64 scratch row (via dq32lo / dq32hi), then
// dot that row against x. Fusing computes dot(row_i, x) straight from the raw
// nibbles, so the f64 row is never written and never re-read. This module only
// builds the machine code; it does not know how the caller obtains the
// arguments. See the calling contract in the lower half of this file.
//
// All builders below take explicit pointer arguments so that every emitted
// kernel ends up independent of any module global. Nothing here touches
// jit_x86.quanta's own emitter state, though it does reuse jbytes().
//
// REGISTER MAP. Let AS be the address of the argument area (see below).
//   rdi = AS                 argument-area base on entry
//   r9  = W                  running quant cursor, initialised from [AS+0]
//   r10 = X                  running x cursor,   initialised from [AS+8]
//   rdx = DMD                running d/md cursor, set from [AS+16]
//   rcx = nsuper             from [AS+24]        super-block loop counter
//   ymm0 = accumulator (4 f64 lanes)
//   ymm6/ymm7 = broadcast d*Kn / dmin*Mn
//   ymm1 = scratch nibble group; xmm2 = its upper half
//   rax = return value
//
// The dequant arguments arrive PRECOMPUTED in the DMD table, so nothing here
// needs f16 semantics. That keeps the fixed-body loop entirely free of scalar
// float work.
//
// PURITY: no callee-saved register is touched (rbx, rbp, r12-r15 are never
// written), so there is no prologue or epilogue. That matters because the
// x-permanence rule established over in lib/std/lfm2_forward.quanta is about x
// being READ-ONLY from the kernel's point of view; a pure leaf makes "the
// kernel writes nothing but its own return value"auditable by reading this
// file alone.
//
// FLOATING POINT. The per-lane arithmetic is exactly w = q * (d*Kn) - (dmin*Mn),
// matching matmul_q4k.quanta. The SUMMATION ORDER over the 256 weights does
// differ: four lanes reduced once at the end, versus one left-to-right
// accumulator in the scalar path. Float addition is not associative, so this
// kernel is NOT expected to be bit-identical to the scalar path and must be
// measured, not assumed -- see tests/lfm2_jit_fused_test.quanta.
// ============================================================================

import std/fs

// ---- fused-encode helpers --------------------------------------------------
// Same "paste verified bytes" discipline as jit_x86.quanta: every string below
// was produced with GNU `as` and read back out of `objdump -d`. None of these
// encodings were derived by hand. Re-derive them with:
//   printf '.intel_syntax noprefix\n.text\n.globl f\nf:\n  <insn>\n' > t.s
//   as -o t.o t.s && objdump -d t.o

// Indirection: a bare `return jbytes(n, h)` keeps every helper's rtable live.
fn femit(hexstr, n: i64) -> i64 {
    let rr = jbytes(n, hexstr)
    return rr
}

// ---- argument load ---------------------------------------------------------
// mov r9, [rdi]        4c 8b 0f        W, from [AS+0]
fn j_f_load_w() -> i64 { return femit("4c8b0f", 3) }
// mov r10, [rdi+8]     4c 8b 57 08     X, from [AS+8]
fn j_f_load_x() -> i64 { return femit("4c8b5708", 4) }
// mov rdx, [rdi+16]    48 8b 57 10     DMD table, from [AS+16]
fn j_f_load_dmd() -> i64 { return femit("488b5710", 4) }
// mov rcx, [rdi+24]    48 8b 4f 18     nsuper, from [AS+24]
fn j_f_load_n() -> i64 { return femit("488b4f18", 4) }

// vxorpd ymm0, ymm0, ymm0        c5 fd 57 c0   -- zero the accumulator
fn j_f_vxorpd_y0() -> i64 { return femit("c5fd57c0", 4) }

// ---- nibble unpacking ------------------------------------------------------
// vpmovzxbd xmm1, [r9]           c4 c2 79 31 09   4 bytes -> 4 dwords
fn j_f_vpmovzxbd_x1_r9() -> i64 { return femit("c4c2793109", 5) }
// vpslld xmm1, xmm1, 28          c5 f1 72 f1 1c   low nibble -> high
fn j_f_vpslld_28() -> i64 { return femit("c5f172f11c", 5) }
// vpsrld xmm1, xmm1, 28          c5 f1 72 d1 1c   and back down: b & 15
fn j_f_vpsrld_28() -> i64 { return femit("c5f172d11c", 5) }
// vpsrld xmm1, xmm1, 4           c5 f1 72 d1 04   high nibble: b >> 4
fn j_f_vpsrld_4() -> i64 { return femit("c5f172d104", 5) }

// ---- 4 dwords -> 4 doubles -------------------------------------------------
// vcvtdq2pd ymm1, xmm1           c5 fe e6 c9   low 2 dwords -> ymm1[0:1]
fn j_f_vcvtdq2pd_y1_x1() -> i64 { return femit("c5fee6c9", 4) }
// vpsrldq xmm2, xmm1, 8          c5 e9 73 d9 08   shift high 2 down
fn j_f_vpsrldq_x2_x1_8() -> i64 { return femit("c5e973d908", 5) }
// vcvtdq2pd ymm2, xmm2           c5 fe e6 d2   -> ymm2[0:1]
fn j_f_vcvtdq2pd_y2_x2() -> i64 { return femit("c5fee6d2", 4) }
// vinsertf128 ymm1, ymm1, xmm2, 1   c4 e3 75 18 ca 01   join halves
fn j_f_vinsertf128_y1_y1_x2_1() -> i64 { return femit("c4e37518ca01", 6) }

// ---- w -> they multiply-add ------------------------------------------------
// vbroadcastsd ymm6, [rdx]       c4 e2 7d 19 32   d*Kn broadcasts
fn j_f_vbcastsd_y6_rdx() -> i64 { return femit("c4e27d1932", 5) }
// vbroadcastsd ymm7, [rdx+8]     c4 e2 7d 19 7a 08   dmin*Mn
fn j_f_vbcastsd_y7_rdx8() -> i64 { return femit("c4e27d197a08", 6) }
// vmulpd ymm1, ymm1, ymm6        c5 f5 59 ce
fn j_f_vmulpd_y1_y6() -> i64 { return femit("c5f559ce", 4) }
// vsubpd ymm1, ymm1, ymm7        c5 f5 5c cf
fn j_f_vsubpd_y1_y7() -> i64 { return femit("c5f55ccf", 4) }
// vmulpd ymm1, ymm1, [r10]       c4 c1 75 59 0a   by x
fn j_f_vmulpd_y1_r10() -> i64 { return femit("c4c175590a", 5) }
// vaddpd ymm0, ymm0, ymm1        c5 fd 58 c1   into the accumulator
fn j_f_vaddpd_y0_y1() -> i64 { return femit("c5fd58c1", 4) }

// ---- cursor advances -------------------------------------------------------
// add r9, 4                      49 83 c1 04   one vpmovzxbd = 4 bytes = 8 quants
fn j_f_add_r9_4() -> i64 { return femit("4983c104", 4) }
// add r10, 32                    49 83 c2 20   4 doubles
fn j_f_add_r10_32() -> i64 { return femit("4983c220", 4) }
// add r10, 256                   49 81 c2 00 01 00 00
fn j_f_add_r10_256() -> i64 { return femit("4981c200010000", 7) }
// add rdx, 16                    48 83 c2 10   one (scale,min) pair
fn j_f_add_rdx_16() -> i64 { return femit("4883c210", 4) }
// add rdx, 32                    48 83 c2 20   one (scale,min) pair = 32 quant bytes
fn j_f_add_rdx_32() -> i64 { return femit("4883c220", 4) }
// sub r9, 32                     49 83 e9 20   rewind the quant cursor one half-chunk
fn j_f_rewind_r9_32() -> i64 { return femit("4983e920", 4) }
// add r9, 16                     49 83 c1 10   skip the 144-byte super-block
// header (f16 d, f16 dmin, 12 scale bytes) to reach the 128 quant bytes.
// lib/std/matmul_q4k.quanta q4k_block_dot does exactly this with `q = raw+bo+16`.
fn j_f_skip_header() -> i64 { return femit("4983c110", 4) }
// vbroadcastsd ymm6, [rdx+16]    c4 e2 7d 19 72 10   high-half d*Kn
fn j_f_vbcastsd_y6_rdx16() -> i64 { return femit("c4e27d197210", 6) }
// vbroadcastsd ymm7, [rdx+24]    c4 e2 7d 19 7a 18   high-half dmin*Mn
fn j_f_vbcastsd_y7_rdx24() -> i64 { return femit("c4e27d197a18", 6) }
// add rdx, 128                   48 81 c2 80 00 00 00   skip one super-block row
fn j_f_add_rdx_128() -> i64 { return femit("4881c280000000", 7) }

// ---- horizontal reduce: ymm0 -> scalar double in xmm3 ----------------------
// vextracti128 xmm2, ymm0, 1     c4 e3 7d 39 c2 01
fn j_f_vextracti128_x2_y0() -> i64 { return femit("c4e37d39c201", 6) }
// vhaddpd xmm3, xmm0, xmm0       c5 f9 7c d8   -> {a0+a1, a2+a3}
fn j_f_vhaddpd_x3_x0() -> i64 { return femit("c5f97cd8", 4) }
// vhaddpd xmm4, xmm2, xmm2       c5 e9 7c e2
fn j_f_vhaddpd_x4_x2() -> i64 { return femit("c5e97ce2", 4) }
// vaddsd xmm3, xmm3, xmm4        c5 e3 58 dc
fn j_f_vaddsd_x3_x4() -> i64 { return femit("c5e358dc", 4) }
// vmovq rax, xmm3                c4 e1 f9 7e d8   result bits -> rax
fn j_f_vmovq_rax_x3() -> i64 { return femit("c4e1f97ed8", 5) }

// ret                            c3
fn j_f_ret() -> i64 { return femit("c3", 1) }

// ============================================================================
// The 4-byte group: 8 quantised weights -> one 4-double contribution.
// ============================================================================
// One vpmovzxbd consumes 4 quant BYTES and yields 8 nibbles: low nibbles are
// elements [0..3], high nibbles [4..7]. But each paired (scale,min) entry in
// the DMD table applies to exactly 4 weights, so each 4-byte group needs TWO
// entries and advances rdx by 16 bytes. The (scale,min) pair is read from rdx;
// rdx is advanced by the caller after every group.
// One 4-byte step of the LOW-nibble pass: bytes -> weights [i..i+3] of the
// 32-weight low half, using the (scale,min) pair at [rdx].
// Advances r9 by 4 quant bytes and r10 by 4 doubles (32 bytes).
fn j_f_low() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vbcastsd_y6_rdx()      // d*Kn
    j_f_vbcastsd_y7_rdx8()     // dmin*Mn
    j_f_vpslld_28()
    j_f_vpsrld_28()            // low nibbles
    // ORDER MATTERS: vcvtdq2pd ymm1,xmm1 writes ymm1, whose LOW half IS xmm1, so
    // it destroys the source dwords. Capture dwords 2,3 into xmm2 FIRST, then
    // convert both halves. The old order read the high half of an already
    // converted DOUBLE and re-converted it as int32, which produced exactly
    // 1072693248 == 0x3FF00000 out of an x of 1.0.
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

// One 4-byte step of the HIGH-nibble pass: the SAME quant bytes, >>4, mapping
// to weights [32+i..35+i] of the chunk, using the pair at [rdx+16].
fn j_f_high() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vbcastsd_y6_rdx16()    // d*Kn  for the high half
    j_f_vbcastsd_y7_rdx24()    // dmin*Mn
    j_f_vpsrld_4()             // high nibbles
    j_f_vpsrldq_x2_x1_8()      // capture dwords 2,3 before the cvt clobbers xmm1
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

// ============================================================================
// Whole kernel: y += sum over nsuper super-blocks of (W_row . X)
// ============================================================================
// Emits a complete leaf function into the current emit region and returns its
// entry address. Uses no callee-saved register and needs no frame.
fn jit_f_build() -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_skip_header()          // r9 now points at the quant bytes, not the header
    j_f_load_x()
    j_f_load_dmd()
    j_f_load_n()
    j_f_vxorpd_y0()

    // Body begins here; the backward branch targets THIS address, captured
    // after the prologue rather than derived from a byte count (a hand-counted
    // offset would silently rot the moment any prologue instruction changes).
    let bodytop = ja_pos()

    // One Q4_K super-block = 256 weights = 8 groups of 32 weights each.
    // Each group consumes 32 bytes of DMD: two (scale,min) pairs, one per
    // 16-weight half (the low nibbles and the high nibbles of its 16 bytes).
    // 8 groups * 32 bytes = 128 bytes == exactly one DMD row, which is the
    // stride jit_f_dmd_alloc reserves. The old code emitted 32 groups of 8,
    // which read 1024 bytes per super-block -- 8x past the allocated row.
    // Layout per lib/std/matmul_q4k.quanta q4k_block_dot (the bit-truth):
    //   144-byte super-block = d, dmin, 12 scale bytes, 128 quant bytes
    //   4 chunks; chunk c uses pair 2c for the LOW 32 weights and pair 2c+1 for
    //   the HIGH 32 weights. Each pair covers 32 quant bytes.
    //   Within a chunk: 8 low steps (4 bytes each) walk x by 32 doubles, then r9
    //   rewinds 32 bytes and 8 high steps walk the NEXT 32 doubles. That is the
    //   only way to express Q4_K's layout: low nibbles are weights [i], high
    //   nibbles are weights [32+i] -- one linear cursor cannot do both.
    let chunk = 0
    while chunk < 4 {
        let b = 0
        while b < 8 {
            j_f_low()
            b = b + 1
        }
        j_f_rewind_r9_32()          // re-read the same 32 quant bytes
        b = 0
        while b < 8 {
            j_f_high()
            b = b + 1
        }
        j_f_add_rdx_32()            // both pairs of this chunk consumed
        chunk = chunk + 1
    }
    j_f_skip_header()               // 128 quant bytes + 16 header = 144 stride

    // sub rcx,1 ; jne rel32 -> back to bodytop.
    // rel32, not rel8: the corrected Q4_K cadence (4 chunks x 8 groups) makes
    // the body ~4 KB, far outside the +-127-byte window a rel8 branch reaches.
    jbytes(4, "4883e901")            // sub rcx, 1
    j_jne32()                        // 0F 85, displacement follows
    let disp_at = ja_pos()           // address OF the displacement (4 bytes)
    jbytes(4, "00000000")            // placeholder
    // rel32 is relative to the END of this instruction, which is disp_at+4.
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    // Horizontal reduce + return.
    j_f_vextracti128_x2_y0()
    j_f_vhaddpd_x3_x0()
    j_f_vhaddpd_x4_x2()
    j_f_vaddsd_x3_x4()
    j_f_vmovq_rax_x3()
    j_f_ret()
    return entry
}

// ============================================================================
// FOLDED-FACTOR VARIANT: derive the 8 (d*Kn, dmin*Mn) pairs IN THE KERNEL
// ============================================================================
// WHY. The table variant above reads its factors from a DMD table the CALLER
// builds, and that build is scalar Quanta source: per super-block it runs 8
// iterations of q4k_sc/q4k_min bit extraction (each with integer divisions)
// plus 16 i2f/fmul/mem_store builtin calls. Measured on the model's real
// FFN-gate rows (tests/jit_dmd_fold_test.quanta): the build alone costs 2.9x
// the kernel it feeds -- 81% of the fused path -- so the integrated win was
// only ~3.1x while the kernel alone is ~11.1x. The build is O(weights) scalar
// work inside the loop fusion was supposed to make cheaper.
//
// WHAT. The kernel's quant cursor r9 points at the 128 quant bytes, so the
// 144-byte super-block header sits at r9-16..r9-1:
//
//      r9-16 : f16 d
//      r9-14 : f16 dmin
//      r9-12 : 12 packed scale/min bytes (sc[0..11])
//
// The kernel loads that header itself, converts d/dmin f16->f32->f64 (both
// steps EXACT -- f16's 11-bit significand fits f32's 24), unpacks the 16
// six-bit fields as dwords, scales them by d / dmin, and keeps the four
// resulting f64 vectors in ymm12-15. It then broadcasts one lane per chunk
// with vpermilpd -- ONE instruction instead of the 8 redundant vbroadcastsd
// per half that the table variant emits. No DMD table, no per-row scalar
// build, no 128-byte-per-super-block memory traffic.
//
// The six-bit unpack below is q4k_sc/q4k_min (lib/std/matmul_q4k.quanta:45,
// :51) and mm_deq_row_raw's use of them, rewritten per-dword:
//
//      scales[0..3] = sc[0..3] & 63
//      scales[4..7] = (sc[8..11] & 15) | ((sc[0..3] >> 6) << 4)
//      mins  [0..3] = sc[4..7] & 63
//      mins  [4..7] = (sc[8..11] >> 4) | ((sc[4..7] >> 6) << 4)
//
// Each is expressed as shifts, not masks-witha-constant-register, so no
// constant pool is needed: (x<<26)>>26 == x & 63 and (x<<28)>>28 == x & 15.
// The per-lane arithmetic and the four-lane accumulation order are IDENTICAL
// to the table variant, so this kernel stays bit-exact against
// mm_deq_row_raw + mm_dot4_s. Verified 0/64 mismatches, and 0 mismatches
// against the table kernel, on real FFN-gate rows.
//
// ARGS AREA: [W, X, DMD, nsuper] is unchanged; [rdi+16] is simply not read.

// The 27-instruction factor prologue. Runs once per super-block, at body top,
// while r9 still points at the quant bytes (header at r9-16).
//   ymm3  = [d, dmin, 0, 0]      (f64)
//   ymm8  = broadcast d          ymm9 = broadcast dmin
//   ymm4/5/6 = sc[0..3]/[4..7]/[8..11] as 4 dwords each
//   ymm7  = unpack scratch
//   ymm12 = [d*sc0..d*sc3]  ymm13 = [d*sc4..d*sc7]
//   ymm14 = [dmin*mn0..3]   ymm15 = [dmin*mn4..mn7]
fn j_f_fold_factors() -> i64 {
    jbytes(6, "c4c1796e59f0")      // vmovd xmm3, [r9-16]       4 header bytes
    jbytes(5, "c4e27913db")        // vcvtph2ps xmm3, xmm3      [d,dmin] as f32
    jbytes(4, "c5fc5adb")          // vcvtps2pd ymm3, xmm3      -> f64 (exact)
    jbytes(6, "c463fd01c300")      // vpermpd ymm8, ymm3, 0    broadcast d
    jbytes(6, "c463fd01cb55")      // vpermpd ymm9, ymm3, 0x55 broadcast dmin
    jbytes(6, "c4c2793161f4")      // vpmovzxbd xmm4, [r9-12]   a = sc0..3
    jbytes(6, "c4c2793169f8")      // vpmovzxbd xmm5, [r9-8]    b = sc4..7
    jbytes(6, "c4c2793171fc")      // vpmovzxbd xmm6, [r9-4]    c = sc8..11
    // scales[0..3] = a & 63
    jbytes(5, "c5c172f41a")        // vpslld xmm7, xmm4, 26
    jbytes(5, "c5c172d71a")        // vpsrld xmm7, xmm7, 26
    jbytes(4, "c57ee6e7")          // vcvtdq2pd ymm12, xmm7
    jbytes(5, "c4411d59e0")        // vmulpd ymm12, ymm12, ymm8
    // mins[0..3] = b & 63
    jbytes(5, "c5c172f51a")        // vpslld xmm7, xmm5, 26
    jbytes(5, "c5c172d71a")        // vpsrld xmm7, xmm7, 26
    jbytes(4, "c57ee6f7")          // vcvtdq2pd ymm14, xmm7
    jbytes(5, "c4410d59f1")        // vmulpd ymm14, ymm14, ymm9
    // scales[4..7] = (c & 15) | ((a >> 6) << 4)
    jbytes(5, "c5c172d406")        // vpsrld xmm7, xmm4, 6
    jbytes(5, "c5c172f704")        // vpslld xmm7, xmm7, 4
    jbytes(5, "c5d972f61c")        // vpslld xmm4, xmm6, 28
    jbytes(5, "c5d972d41c")        // vpsrld xmm4, xmm4, 28
    jbytes(4, "c5c1ebfc")          // vpor xmm7, xmm7, xmm4
    jbytes(4, "c57ee6ef")          // vcvtdq2pd ymm13, xmm7
    jbytes(5, "c4411559e8")        // vmulpd ymm13, ymm13, ymm8
    // mins[4..7] = (c >> 4) | ((b >> 6) << 4)
    jbytes(5, "c5c172d506")        // vpsrld xmm7, xmm5, 6
    jbytes(5, "c5c172f704")        // vpslld xmm7, xmm7, 4
    jbytes(5, "c5d172d604")        // vpsrld xmm5, xmm6, 4
    jbytes(4, "c5c1ebfd")          // vpor xmm7, xmm7, xmm5
    jbytes(4, "c57ee6ff")          // vcvtdq2pd ymm15, xmm7
    jbytes(5, "c4410559f9")        // vmulpd ymm15, ymm15, ymm9
    return 0
}

// Chunk c (0..3) uses pair 2c for its low 32 weights and pair 2c+1 for its
// high 32. Pairs 0..3 live in ymm12/ymm14 (scales/mins), pairs 4..7 in
// ymm13/ymm15.
//
// THE BROADCAST MUST BE vpermpd, NOT vpermilpd. Measured, not assumed: an
// earlier revision used vpermilpd with imm 0x00/0x55/0xAA/0xFF, which
// assembled and disassembled perfectly and still produced the wrong factors.
// VPERMILPD's imm8 selectors are LANE-RELATIVE -- each 2-bit field picks a
// source element inside the destination's own 128-bit half -- so imm 0x00
// yields [s0,s1,s0,s1], not a broadcast. (It produced exactly
// ymm8 = [d,d,0,0], which tests/jit_fold_probe.quanta caught: only factor
// lanes 0 and 1 of each vector were ever right.) VPERMPD ymm1,ymm2,imm8 IS a
// cross-lane 4-element permute, so a repeated 2-bit selector broadcasts:
// lane0=0x00, lane1=0x55, lane2=0xAA, lane3=0xFF. ymm6 carries d*Kn, ymm7
// carries dmin*Mn.
fn j_f_perm6_lo(c) -> i64 {          // ymm6 <- lane 2c of ymm12/ymm13
    if c == 0 { return jbytes(6, "c4c3fd01f400") }
    if c == 1 { return jbytes(6, "c4c3fd01f4aa") }
    if c == 2 { return jbytes(6, "c4c3fd01f500") }
    return jbytes(6, "c4c3fd01f5aa")
}
fn j_f_perm6_hi(c) -> i64 {          // ymm6 <- lane 2c+1 of ymm12/ymm13
    if c == 0 { return jbytes(6, "c4c3fd01f455") }
    if c == 1 { return jbytes(6, "c4c3fd01f4ff") }
    if c == 2 { return jbytes(6, "c4c3fd01f555") }
    return jbytes(6, "c4c3fd01f5ff")
}
fn j_f_perm7_lo(c) -> i64 {          // ymm7 <- lane 2c of ymm14/ymm15
    if c == 0 { return jbytes(6, "c4c3fd01fe00") }
    if c == 1 { return jbytes(6, "c4c3fd01feaa") }
    if c == 2 { return jbytes(6, "c4c3fd01ff00") }
    return jbytes(6, "c4c3fd01ffaa")
}
fn j_f_perm7_hi(c) -> i64 {          // ymm7 <- lane 2c+1 of ymm14/ymm15
    if c == 0 { return jbytes(6, "c4c3fd01fe55") }
    if c == 1 { return jbytes(6, "c4c3fd01feff") }
    if c == 2 { return jbytes(6, "c4c3fd01ff55") }
    return jbytes(6, "c4c3fd01ffff")
}

// The 4-byte group, with the factor broadcast HOISTED out: ymm6/ymm7 must
// already hold this half's (d*Kn, dmin*Mn). Byte-for-byte the same body as
// j_f_low/j_f_high minus their two vbroadcastsd calls.
fn j_f_low_nb() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vpslld_28()
    j_f_vpsrld_28()
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

fn j_f_high_nb() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vpsrld_4()
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

// ============================================================================
// Whole FOLDED kernel: same cadence, factors derived in-kernel, no DMD table.
// ============================================================================
fn jit_f_build_folded() -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_skip_header()          // r9 -> quant bytes; header now at r9-16
    j_f_load_x()
    j_f_load_n()
    j_f_vxorpd_y0()

    let bodytop = ja_pos()

    j_f_fold_factors()         // ymm12-15 = the 8 (d*Kn,dmin*Mn) pairs

    let chunk = 0
    while chunk < 4 {
        // low 32 weights of the chunk: one broadcast each, then 8 steps
        j_f_perm6_lo(chunk)
        j_f_perm7_lo(chunk)
        let b = 0
        while b < 8 {
            j_f_low_nb()
            b = b + 1
        }
        j_f_rewind_r9_32()     // re-read the same 32 quant bytes
        // high 32 weights: pair 2c+1
        j_f_perm6_hi(chunk)
        j_f_perm7_hi(chunk)
        b = 0
        while b < 8 {
            j_f_high_nb()
            b = b + 1
        }
        chunk = chunk + 1
    }
    j_f_skip_header()          // 128 quant bytes + 16 header = 144 stride

    jbytes(4, "4883e901")      // sub rcx, 1
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    j_f_vextracti128_x2_y0()
    j_f_vhaddpd_x3_x0()
    j_f_vhaddpd_x4_x2()
    j_f_vaddsd_x3_x4()
    j_f_vmovq_rax_x3()
    j_f_ret()
    return entry
}

// ============================================================================
// ============================================================================
// LOWER HALF -- the caller side: how emitted bytes become callable functions
// ============================================================================
// ============================================================================

// ---- the closure shim ------------------------------------------------------
// The only indirect call the language can make is CLOSURE_CALL (see
// tests/lfm2_jit_probe.quanta, committed 2cace033). It requires a tuple whose
// first qword is the code pointer, so "JIT'd code" enters through the same
// door as any other Quanta closure:
//
//     let tbl = mem_alloc(2)
//     mem_store(tbl, entry)          // where our bytes live
//     mem_store(tbl + 8, 0)          // no environment
//     let result = closure_call(tbl, args_ptr)
//
// Because it is a genuine `call` instruction, the emitted bytes see a normal
// SysV frame and may use every caller-saved register freely. We do exactly
// that: the kernel writes rax,rcx,rdx,rsi,rdi,r8-r11 and touches no
// callee-saved register, so there is no stack traffic at all.
fn jit_f_code(entry: i64) -> i64 {
    let tbl = mem_alloc(2)
    mem_store(tbl, entry)
    mem_store(tbl + 8, 0)
    return tbl
}

// ---- executable memory -----------------------------------------------------
// Maps a fresh RWX anonymous region for emitted code. Wraps the region in the
// jit_x86 emit cursor so the builders above can write into it directly.
//
// NOTE: W^X-pedantic kernels refuse PROT_EXEC on anonymous mappings; this box
// (Linux 6.12) allows it, and tests/lfm2_jit_probe.quanta Q3 proved it here by
// executing eight runtime-emitted stubs. Return<=0 means the box forbids it --
// the test must then report "unsupported", not "failed".
fn jit_f_alloc(nbytes: i64) -> i64 {
    let base = mmap_file(0, nbytes, 7, 34, 0 - 1, 0)
    if base <= 0 { return 0 }
    ja_init(base, nbytes)
    return base
}

// ============================================================================
// HIGH-LEVEL ENTRY: one Q4_K row dot, ready to call from a model module
// ============================================================================
//
// STATUS: BLOCKED BY A COMPILER DEFECT -- NOT USABLE YET. Do not wire this into
// lfm2_forward/mm until the defect is fixed; jit_f_apply faults at run time.
//
// qc 0.0.245 miscompiles closure_call when it is reached from a function inside
// an IMPORTED module. Measured, minimal 2-module TU (imports jit_x86 +
// jit_x86_fused only), identical tuple / argument area / bytes:
//
//     let va = closure_call(tbl, asz, 0)   // inline in main -> 4700186342854754304
//     let vc = jit_f_apply(asz)            // via this module -> SIGSEGV (rc=139)
//
// The same fault appears with the tuple passed as a parameter, with a local
// tuple, with/without accompanying mem_store, and from gguf_mm.quanta; the call
// also traps the COMPILER (SIGILL, rc=132) in larger translation units. Inline
// in the program's top-level module it always works, which is why every existing
// test dispatches the kernel that way. Full evidence:
// docs/research/jit-fused-dot-status.md and tests/lfm2_jit_cc_probe.quanta.
//
// jit_f_setup() emits the kernel ONCE and keeps the closure tuple here, so the
// callers only have to supply the argument area once the defect is fixed.
let jf_tbl = 0

fn jit_f_setup() -> i64 {
    if jf_tbl != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build())
    if t <= 0 { return -2 }
    jf_tbl = t
    return 0
}

fn jit_f_ready() { return jf_tbl }

// Call the emitted kernel with the argument area at `as` (4 qwords:
// W, X, DMD, nsuper). Returns the dot as raw f64 bits.
//
// BLOCKED: faults when reached from here (an imported module) -- see the STATUS
// note above. Kept because it is the interface the wiring needs, and because it
// is the smallest reproducer of the defect.
fn jit_f_apply(as) -> i64 {
    return closure_call(jf_tbl, as, 0)
}

// ---- the per-(row Sub-block) dequant argument table ------------------------
// The kernel reads its scale/min factors from a precomputed table rather than
// doing f16 arithmetic in the hot loop. Layout, per super-block:
//
//     8 entries x 16 bytes = 128 bytes, entry k =
//         +0  f64  d    * scale[k]       apply to the 4 low nibbles
//         +8  f64  dmin * min[k]         subtract from those same 4
//
// Wait: the (scale,min) pairing below is what a SUB-BLOCK contributes. Q4_K
// has 8 per super-block and each covers 32 weights, which is 8 four-double
// groups -- so one entry serves 8 groups, and the kernel must therefore
// consume it, not advance past it, on 7 of every 8 groups.
//
// THE BUG THIS CREATES, stated plainly rather than papered over: as written,
// j_f_group() unconditionally does `add rdx,16` twice per 4-byte group, so it
// advances one (scale,min) entry every FOUR weights instead of every 32. That
// reads the wrong factors for 7/8 of the row. The verified credentials for
// this file must therefore be established BEFORE the table is trusted, which
// is why tests/lfm2_jit_fused_test.quanta checks the kernel against a scalar
// oracle over real data rather than assuming the addressing is right. Fixing
// it means emitting one of 8 group variants so only every 8th advances rdx.
fn jit_f_dmd_alloc(nsuper: i64) -> i64 {
    let nbytes = nsuper * 128
    let p = mem_alloc(nbytes)
    return p
}

// Fill the table for one super-block from its raw bytes.
//   raw     : start of the 144-byte Q4_K super-block
//   d       : the block's f16 scale, already converted to f64
//   dmin    : the block's f16 min scale, already converted to f64
//   sc      : pointer to the 12 packed scale bytes (raw + 4)
//   DMD     : destination row for this super-block (128 bytes)
//
// Uses the SAME q4k_sc / q4k_min bit-extraction as lib/std/matmul_q4k.quanta
// so both paths agree on the factors before the arithmetic differs.
fn jit_f_dmd_fill(raw, sc, d: f64, dmin: f64, DMD) -> i64 {
    let k = 0
    while k < 8 {
        let s0 = q4k_sc_jit(k, sc)
        let m0 = q4k_min_jit(k, sc)
        mem_store(DMD + k * 16, fmul(d, i2f(s0)))
        mem_store(DMD + k * 16 + 8, fmul(dmin, i2f(m0)))
        k = k + 1
    }
    return 0
}

// Local copies of the scale/min extractors, matching matmul_q4k.quanta.
fn q4k_sc_jit(j, sc) {
    if j < 4 { return mem_load8(sc + j) - (mem_load8(sc + j) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo - (lo / 16) * 16) + ((mem_load8(sc + j - 4) / 64) * 16)
}

fn q4k_min_jit(j, sc) {
    if j < 4 { return mem_load8(sc + j + 4) - (mem_load8(sc + j + 4) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo / 16 - (lo / 16 / 16) * 16) + ((mem_load8(sc + j) / 64) * 16)
}

// ============================================================================
// CALLING CONTRACT -- how lfm2_forward must use this, given the source admits
// no pointer-to-function type in its tensor arguments
// ============================================================================
//
// 1. Every value the kernel needs arrives through a SIX-POINTER argument area
//    rather than through registers directly, because Quanta's closure_call
//    passes exactly one pointer argument in rdi:
//
//        AS = mem_alloc(6)          // argument area
//        AS[0] = W                  // quantised row base
//        AS[1] = X                  // f64 x base
//        AS[2] = DMD                // the (d*scale, dmin*min) table above
//        AS[3] = nsuper             // cols / 256
//
//    The kernel loads all four from rdi in its first instructions.
//
// 2. X-PERMANENCE -- resolved by reading the forward path, not assumed.
//    mm_load_row (gguf_mm.quanta:80) creates NO row buffer: it fills the two
//    MODULE GLOBALS mm_rowraw and mm_rowbuf, and its only other effect is a
//    read. So a fused dot may hold x FIXED in a register across every dot of
//    a whole tensor, and the same x may be re-read as many times as rows
//    require. Confirming that required checking every matvec call site for
//    aliasing (could some call pass a destination that overlaps its own x?):
//
//      fc_short_conv : mm_matvec(cin, x, ...)      -> fc_sc_ip
//                      mm_matvec(cout, fc_sc_y,..) -> out
//      fc_attention  : q/k/v from x                -> fc_at_q/k/v
//                      mm_matvec(wo, fc_at_out,..) -> out
//      fc_layer ffn  : gate/up from fc_fw_n        -> fc_ffn_f_gate/up
//                      down from fc_fw_f           -> fc_fw_ff
//      fc_final_norm+logits : mm_embed_logits(emb, fc_fw_n, ..) -> fc_fw_logits
//
//    In every case the destination is a distinct buffer from the source and
//    none of them is ever also the x argument -- the closest is
//    fc_layer writing its residual into `out` while reading fc_fw_x, which is
//    a different pointer. So: **x must be immutable for the DURATION of the
//    fused loop, and it is.** The pointer identity changes per tensor, so the
//    caller re-establishes the base each time, once per matvec, not per row.
//
// 3. The kernel returns the f64 dot product as RAW BITS in rax, which is
//    already Quanta's float convention -- so the caller does NOT reinterpret.
//    See: jit_f_code() returns whatever closure_call yields.
//
// 4. The results must be summed EXACTLY once per row. Keeping y scalar is what
//    preserves the scalar path's summation order across super-blocks.
