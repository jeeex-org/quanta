// ============================================================================
// Upper half of lib/std/jit_x86_fused.quanta
// ============================================================================
// Register-resident fused Q4_K dequant-dot kernel for x86-64 AVX2.
//
// WHAT IS FUSED: today's forward makes two passes per row -- dequantize each
// 256-weight super-block into an f64 scratch row (via dq32lo / dq32hi), then
// dot that row against x. Fusing computes dot(row_i, x) straight from the raw
// nibbles, so the f64 row is never written and never re-read. This module only
// builds the machine code; it does not know how the caller obtains the
// arguments. See the calling contract in the lower half of this file.
//
// All builders below take explicit pointer arguments so that every emitted
// kernel ends up independent of any module global. Nothing here touches
// jit_x86.quanta's own emitter state, though it does reuse jbytes().
//
// REGISTER MAP. Let AS be the address of the argument area (see below).
//   rdi = AS                 argument-area base on entry
//   r9  = W                  running quant cursor, initialised from [AS+0]
//   r10 = X                  running x cursor,   initialised from [AS+8]
//   rdx = DMD                running d/md cursor, set from [AS+16]
//   rcx = nsuper             from [AS+24]        super-block loop counter
//   ymm0 = accumulator (4 f64 lanes)
//   ymm6/ymm7 = broadcast d*Kn / dmin*Mn
//   ymm1 = scratch nibble group; xmm2 = its upper half
//   rax = return value
//
// The dequant arguments arrive PRECOMPUTED in the DMD table, so nothing here
// needs f16 semantics. That keeps the fixed-body loop entirely free of scalar
// float work.
//
// PURITY: no callee-saved register is touched (rbx, rbp, r12-r15 are never
// written), so there is no prologue or epilogue. That matters because the
// x-permanence rule established over in lib/std/lfm2_forward.quanta is about x
// being READ-ONLY from the kernel's point of view; a pure leaf makes "the
// kernel writes nothing but its own return value"auditable by reading this
// file alone.
//
// FLOATING POINT. The per-lane arithmetic is exactly w = q * (d*Kn) - (dmin*Mn),
// matching matmul_q4k.quanta. The SUMMATION ORDER over the 256 weights does
// differ: four lanes reduced once at the end, versus one left-to-right
// accumulator in the scalar path. Float addition is not associative, so this
// kernel is NOT expected to be bit-identical to the scalar path and must be
// measured, not assumed -- see tests/lfm2_jit_fused_test.quanta.
// ============================================================================

import std/fs

// ---- fused-encode helpers --------------------------------------------------
// Same "paste verified bytes" discipline as jit_x86.quanta: every string below
// was produced with GNU `as` and read back out of `objdump -d`. None of these
// encodings were derived by hand. Re-derive them with:
//   printf '.intel_syntax noprefix\n.text\n.globl f\nf:\n  <insn>\n' > t.s
//   as -o t.o t.s && objdump -d t.o

// Indirection: a bare `return jbytes(n, h)` keeps every helper's rtable live.
fn femit(hexstr, n: i64) -> i64 {
    let rr = jbytes(n, hexstr)
    return rr
}

// ---- argument load ---------------------------------------------------------
// mov r9, [rdi]        4c 8b 0f        W, from [AS+0]
fn j_f_load_w() -> i64 { return femit("4c8b0f", 3) }
// mov r10, [rdi+8]     4c 8b 57 08     X, from [AS+8]
fn j_f_load_x() -> i64 { return femit("4c8b5708", 4) }
// mov rdx, [rdi+16]    48 8b 57 10     DMD table, from [AS+16]
fn j_f_load_dmd() -> i64 { return femit("488b5710", 4) }
// mov rcx, [rdi+24]    48 8b 4f 18     nsuper, from [AS+24]
fn j_f_load_n() -> i64 { return femit("488b4f18", 4) }

// vxorpd ymm0, ymm0, ymm0        c5 fd 57 c0   -- zero the accumulator
fn j_f_vxorpd_y0() -> i64 { return femit("c5fd57c0", 4) }

// ---- nibble unpacking ------------------------------------------------------
// vpmovzxbd xmm1, [r9]           c4 c2 79 31 09   4 bytes -> 4 dwords
fn j_f_vpmovzxbd_x1_r9() -> i64 { return femit("c4c2793109", 5) }
// vpslld xmm1, xmm1, 28          c5 f1 72 f1 1c   low nibble -> high
fn j_f_vpslld_28() -> i64 { return femit("c5f172f11c", 5) }
// vpsrld xmm1, xmm1, 28          c5 f1 72 d1 1c   and back down: b & 15
fn j_f_vpsrld_28() -> i64 { return femit("c5f172d11c", 5) }
// vpsrld xmm1, xmm1, 4           c5 f1 72 d1 04   high nibble: b >> 4
fn j_f_vpsrld_4() -> i64 { return femit("c5f172d104", 5) }

// ---- 4 dwords -> 4 doubles -------------------------------------------------
// vcvtdq2pd ymm1, xmm1           c5 fe e6 c9   low 2 dwords -> ymm1[0:1]
fn j_f_vcvtdq2pd_y1_x1() -> i64 { return femit("c5fee6c9", 4) }
// vpsrldq xmm2, xmm1, 8          c5 e9 73 d9 08   shift high 2 down
fn j_f_vpsrldq_x2_x1_8() -> i64 { return femit("c5e973d908", 5) }
// vcvtdq2pd ymm2, xmm2           c5 fe e6 d2   -> ymm2[0:1]
fn j_f_vcvtdq2pd_y2_x2() -> i64 { return femit("c5fee6d2", 4) }
// vinsertf128 ymm1, ymm1, xmm2, 1   c4 e3 75 18 ca 01   join halves
fn j_f_vinsertf128_y1_y1_x2_1() -> i64 { return femit("c4e37518ca01", 6) }

// ---- w -> they multiply-add ------------------------------------------------
// vbroadcastsd ymm6, [rdx]       c4 e2 7d 19 32   d*Kn broadcasts
fn j_f_vbcastsd_y6_rdx() -> i64 { return femit("c4e27d1932", 5) }
// vbroadcastsd ymm7, [rdx+8]     c4 e2 7d 19 7a 08   dmin*Mn
fn j_f_vbcastsd_y7_rdx8() -> i64 { return femit("c4e27d197a08", 6) }
// vmulpd ymm1, ymm1, ymm6        c5 f5 59 ce
fn j_f_vmulpd_y1_y6() -> i64 { return femit("c5f559ce", 4) }
// vsubpd ymm1, ymm1, ymm7        c5 f5 5c cf
fn j_f_vsubpd_y1_y7() -> i64 { return femit("c5f55ccf", 4) }
// vmulpd ymm1, ymm1, [r10]       c4 c1 75 59 0a   by x
fn j_f_vmulpd_y1_r10() -> i64 { return femit("c4c175590a", 5) }
// vaddpd ymm0, ymm0, ymm1        c5 fd 58 c1   into the accumulator
fn j_f_vaddpd_y0_y1() -> i64 { return femit("c5fd58c1", 4) }

// ---- cursor advances -------------------------------------------------------
// add r9, 4                      49 83 c1 04   one vpmovzxbd = 4 bytes = 8 quants
fn j_f_add_r9_4() -> i64 { return femit("4983c104", 4) }
// add r10, 32                    49 83 c2 20   4 doubles
fn j_f_add_r10_32() -> i64 { return femit("4983c220", 4) }
// add r10, 256                   49 81 c2 00 01 00 00
fn j_f_add_r10_256() -> i64 { return femit("4981c200010000", 7) }
// add rdx, 16                    48 83 c2 10   one (scale,min) pair
fn j_f_add_rdx_16() -> i64 { return femit("4883c210", 4) }
// add rdx, 32                    48 83 c2 20   one (scale,min) pair = 32 quant bytes
fn j_f_add_rdx_32() -> i64 { return femit("4883c220", 4) }
// sub r9, 32                     49 83 e9 20   rewind the quant cursor one half-chunk
fn j_f_rewind_r9_32() -> i64 { return femit("4983e920", 4) }
// add r9, 16                     49 83 c1 10   skip the 144-byte super-block
// header (f16 d, f16 dmin, 12 scale bytes) to reach the 128 quant bytes.
// lib/std/matmul_q4k.quanta q4k_block_dot does exactly this with `q = raw+bo+16`.
fn j_f_skip_header() -> i64 { return femit("4983c110", 4) }
// vbroadcastsd ymm6, [rdx+16]    c4 e2 7d 19 72 10   high-half d*Kn
fn j_f_vbcastsd_y6_rdx16() -> i64 { return femit("c4e27d197210", 6) }
// vbroadcastsd ymm7, [rdx+24]    c4 e2 7d 19 7a 18   high-half dmin*Mn
fn j_f_vbcastsd_y7_rdx24() -> i64 { return femit("c4e27d197a18", 6) }
// add rdx, 128                   48 81 c2 80 00 00 00   skip one super-block row
fn j_f_add_rdx_128() -> i64 { return femit("4881c280000000", 7) }

// ---- horizontal reduce: ymm0 -> scalar double in xmm3 ----------------------
// vextracti128 xmm2, ymm0, 1     c4 e3 7d 39 c2 01
fn j_f_vextracti128_x2_y0() -> i64 { return femit("c4e37d39c201", 6) }
// vhaddpd xmm3, xmm0, xmm0       c5 f9 7c d8   -> {a0+a1, a2+a3}
fn j_f_vhaddpd_x3_x0() -> i64 { return femit("c5f97cd8", 4) }
// vhaddpd xmm4, xmm2, xmm2       c5 e9 7c e2
fn j_f_vhaddpd_x4_x2() -> i64 { return femit("c5e97ce2", 4) }
// vaddsd xmm3, xmm3, xmm4        c5 e3 58 dc
fn j_f_vaddsd_x3_x4() -> i64 { return femit("c5e358dc", 4) }
// vmovq rax, xmm3                c4 e1 f9 7e d8   result bits -> rax
fn j_f_vmovq_rax_x3() -> i64 { return femit("c4e1f97ed8", 5) }

// ret                            c3
fn j_f_ret() -> i64 { return femit("c3", 1) }

// ============================================================================
// The 4-byte group: 8 quantised weights -> one 4-double contribution.
// ============================================================================
// One vpmovzxbd consumes 4 quant BYTES and yields 8 nibbles: low nibbles are
// elements [0..3], high nibbles [4..7]. But each paired (scale,min) entry in
// the DMD table applies to exactly 4 weights, so each 4-byte group needs TWO
// entries and advances rdx by 16 bytes. The (scale,min) pair is read from rdx;
// rdx is advanced by the caller after every group.
// One 4-byte step of the LOW-nibble pass: bytes -> weights [i..i+3] of the
// 32-weight low half, using the (scale,min) pair at [rdx].
// Advances r9 by 4 quant bytes and r10 by 4 doubles (32 bytes).
fn j_f_low() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vbcastsd_y6_rdx()      // d*Kn
    j_f_vbcastsd_y7_rdx8()     // dmin*Mn
    j_f_vpslld_28()
    j_f_vpsrld_28()            // low nibbles
    // ORDER MATTERS: vcvtdq2pd ymm1,xmm1 writes ymm1, whose LOW half IS xmm1, so
    // it destroys the source dwords. Capture dwords 2,3 into xmm2 FIRST, then
    // convert both halves. The old order read the high half of an already
    // converted DOUBLE and re-converted it as int32, which produced exactly
    // 1072693248 == 0x3FF00000 out of an x of 1.0.
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

// One 4-byte step of the HIGH-nibble pass: the SAME quant bytes, >>4, mapping
// to weights [32+i..35+i] of the chunk, using the pair at [rdx+16].
fn j_f_high() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vbcastsd_y6_rdx16()    // d*Kn  for the high half
    j_f_vbcastsd_y7_rdx24()    // dmin*Mn
    j_f_vpsrld_4()             // high nibbles
    j_f_vpsrldq_x2_x1_8()      // capture dwords 2,3 before the cvt clobbers xmm1
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

// ============================================================================
// Whole kernel: y += sum over nsuper super-blocks of (W_row . X)
// ============================================================================
// Emits a complete leaf function into the current emit region and returns its
// entry address. Uses no callee-saved register and needs no frame.
fn jit_f_build() -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_skip_header()          // r9 now points at the quant bytes, not the header
    j_f_load_x()
    j_f_load_dmd()
    j_f_load_n()
    j_f_vxorpd_y0()

    // Body begins here; the backward branch targets THIS address, captured
    // after the prologue rather than derived from a byte count (a hand-counted
    // offset would silently rot the moment any prologue instruction changes).
    let bodytop = ja_pos()

    // One Q4_K super-block = 256 weights = 8 groups of 32 weights each.
    // Each group consumes 32 bytes of DMD: two (scale,min) pairs, one per
    // 16-weight half (the low nibbles and the high nibbles of its 16 bytes).
    // 8 groups * 32 bytes = 128 bytes == exactly one DMD row, which is the
    // stride jit_f_dmd_alloc reserves. The old code emitted 32 groups of 8,
    // which read 1024 bytes per super-block -- 8x past the allocated row.
    // Layout per lib/std/matmul_q4k.quanta q4k_block_dot (the bit-truth):
    //   144-byte super-block = d, dmin, 12 scale bytes, 128 quant bytes
    //   4 chunks; chunk c uses pair 2c for the LOW 32 weights and pair 2c+1 for
    //   the HIGH 32 weights. Each pair covers 32 quant bytes.
    //   Within a chunk: 8 low steps (4 bytes each) walk x by 32 doubles, then r9
    //   rewinds 32 bytes and 8 high steps walk the NEXT 32 doubles. That is the
    //   only way to express Q4_K's layout: low nibbles are weights [i], high
    //   nibbles are weights [32+i] -- one linear cursor cannot do both.
    let chunk = 0
    while chunk < 4 {
        let b = 0
        while b < 8 {
            j_f_low()
            b = b + 1
        }
        j_f_rewind_r9_32()          // re-read the same 32 quant bytes
        b = 0
        while b < 8 {
            j_f_high()
            b = b + 1
        }
        j_f_add_rdx_32()            // both pairs of this chunk consumed
        chunk = chunk + 1
    }
    j_f_skip_header()               // 128 quant bytes + 16 header = 144 stride

    // sub rcx,1 ; jne rel32 -> back to bodytop.
    // rel32, not rel8: the corrected Q4_K cadence (4 chunks x 8 groups) makes
    // the body ~4 KB, far outside the +-127-byte window a rel8 branch reaches.
    jbytes(4, "4883e901")            // sub rcx, 1
    j_jne32()                        // 0F 85, displacement follows
    let disp_at = ja_pos()           // address OF the displacement (4 bytes)
    jbytes(4, "00000000")            // placeholder
    // rel32 is relative to the END of this instruction, which is disp_at+4.
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    // Horizontal reduce + return.
    j_f_vextracti128_x2_y0()
    j_f_vhaddpd_x3_x0()
    j_f_vhaddpd_x4_x2()
    j_f_vaddsd_x3_x4()
    j_f_vmovq_rax_x3()
    j_f_ret()
    return entry
}

// ============================================================================
// FOLDED-FACTOR VARIANT: derive the 8 (d*Kn, dmin*Mn) pairs IN THE KERNEL
// ============================================================================
// WHY. The table variant above reads its factors from a DMD table the CALLER
// builds, and that build is scalar Quanta source: per super-block it runs 8
// iterations of q4k_sc/q4k_min bit extraction (each with integer divisions)
// plus 16 i2f/fmul/mem_store builtin calls. Measured on the model's real
// FFN-gate rows (tests/jit_dmd_fold_test.quanta): the build alone costs 2.9x
// the kernel it feeds -- 81% of the fused path -- so the integrated win was
// only ~3.1x while the kernel alone is ~11.1x. The build is O(weights) scalar
// work inside the loop fusion was supposed to make cheaper.
//
// WHAT. The kernel's quant cursor r9 points at the 128 quant bytes, so the
// 144-byte super-block header sits at r9-16..r9-1:
//
//      r9-16 : f16 d
//      r9-14 : f16 dmin
//      r9-12 : 12 packed scale/min bytes (sc[0..11])
//
// The kernel loads that header itself, converts d/dmin f16->f32->f64 (both
// steps EXACT -- f16's 11-bit significand fits f32's 24), unpacks the 16
// six-bit fields as dwords, scales them by d / dmin, and keeps the four
// resulting f64 vectors in ymm12-15. It then broadcasts one lane per chunk
// with vpermilpd -- ONE instruction instead of the 8 redundant vbroadcastsd
// per half that the table variant emits. No DMD table, no per-row scalar
// build, no 128-byte-per-super-block memory traffic.
//
// The six-bit unpack below is q4k_sc/q4k_min (lib/std/matmul_q4k.quanta:45,
// :51) and mm_deq_row_raw's use of them, rewritten per-dword:
//
//      scales[0..3] = sc[0..3] & 63
//      scales[4..7] = (sc[8..11] & 15) | ((sc[0..3] >> 6) << 4)
//      mins  [0..3] = sc[4..7] & 63
//      mins  [4..7] = (sc[8..11] >> 4) | ((sc[4..7] >> 6) << 4)
//
// Each is expressed as shifts, not mask-with-a-constant-register, so no
// constant pool is needed: (x<<26)>>26 == x & 63 and (x<<28)>>28 == x & 15.
// The per-lane arithmetic and the four-lane accumulation order are IDENTICAL
// to the table variant, so this kernel stays bit-exact against
// mm_deq_row_raw + mm_dot4_s. Verified 0/512 mismatches on the FFN-gate rows
// and 0/128 on a 10752-column, 42-super-block row (this tensor and one other
// distinct shape), for BOTH this kernel and the table kernel.
//
// ARGS AREA: [W, X, DMD, nsuper] is unchanged; [rdi+16] is simply not read.

// The 27-instruction factor prologue. Runs once per super-block, at body top,
// while r9 still points at the quant bytes (header at r9-16).
//   ymm3  = [d, dmin, 0, 0]      (f64)
//   ymm8  = broadcast d          ymm9 = broadcast dmin
//   ymm4/5/6 = sc[0..3]/[4..7]/[8..11] as 4 dwords each
//   ymm7  = unpack scratch
//   ymm12 = [d*sc0..d*sc3]  ymm13 = [d*sc4..d*sc7]
//   ymm14 = [dmin*mn0..3]   ymm15 = [dmin*mn4..mn7]
fn j_f_fold_factors() -> i64 {
    jbytes(6, "c4c1796e59f0")      // vmovd xmm3, [r9-16]       4 header bytes
    jbytes(5, "c4e27913db")        // vcvtph2ps xmm3, xmm3      [d,dmin] as f32
    jbytes(4, "c5fc5adb")          // vcvtps2pd ymm3, xmm3      -> f64 (exact)
    jbytes(6, "c463fd01c300")      // vpermpd ymm8, ymm3, 0    broadcast d
    jbytes(6, "c463fd01cb55")      // vpermpd ymm9, ymm3, 0x55 broadcast dmin
    jbytes(6, "c4c2793161f4")      // vpmovzxbd xmm4, [r9-12]   a = sc0..3
    jbytes(6, "c4c2793169f8")      // vpmovzxbd xmm5, [r9-8]    b = sc4..7
    jbytes(6, "c4c2793171fc")      // vpmovzxbd xmm6, [r9-4]    c = sc8..11
    // scales[0..3] = a & 63
    jbytes(5, "c5c172f41a")        // vpslld xmm7, xmm4, 26
    jbytes(5, "c5c172d71a")        // vpsrld xmm7, xmm7, 26
    jbytes(4, "c57ee6e7")          // vcvtdq2pd ymm12, xmm7
    jbytes(5, "c4411d59e0")        // vmulpd ymm12, ymm12, ymm8
    // mins[0..3] = b & 63
    jbytes(5, "c5c172f51a")        // vpslld xmm7, xmm5, 26
    jbytes(5, "c5c172d71a")        // vpsrld xmm7, xmm7, 26
    jbytes(4, "c57ee6f7")          // vcvtdq2pd ymm14, xmm7
    jbytes(5, "c4410d59f1")        // vmulpd ymm14, ymm14, ymm9
    // scales[4..7] = (c & 15) | ((a >> 6) << 4)
    jbytes(5, "c5c172d406")        // vpsrld xmm7, xmm4, 6
    jbytes(5, "c5c172f704")        // vpslld xmm7, xmm7, 4
    jbytes(5, "c5d972f61c")        // vpslld xmm4, xmm6, 28
    jbytes(5, "c5d972d41c")        // vpsrld xmm4, xmm4, 28
    jbytes(4, "c5c1ebfc")          // vpor xmm7, xmm7, xmm4
    jbytes(4, "c57ee6ef")          // vcvtdq2pd ymm13, xmm7
    jbytes(5, "c4411559e8")        // vmulpd ymm13, ymm13, ymm8
    // mins[4..7] = (c >> 4) | ((b >> 6) << 4)
    jbytes(5, "c5c172d506")        // vpsrld xmm7, xmm5, 6
    jbytes(5, "c5c172f704")        // vpslld xmm7, xmm7, 4
    jbytes(5, "c5d172d604")        // vpsrld xmm5, xmm6, 4
    jbytes(4, "c5c1ebfd")          // vpor xmm7, xmm7, xmm5
    jbytes(4, "c57ee6ff")          // vcvtdq2pd ymm15, xmm7
    jbytes(5, "c4410559f9")        // vmulpd ymm15, ymm15, ymm9
    return 0
}

// Chunk c (0..3) uses pair 2c for its low 32 weights and pair 2c+1 for its
// high 32. Pairs 0..3 live in ymm12/ymm14 (scales/mins), pairs 4..7 in
// ymm13/ymm15.
//
// THE BROADCAST MUST BE vpermpd, NOT vpermilpd. Measured, not assumed: an
// earlier revision used vpermilpd with imm 0x00/0x55/0xAA/0xFF, which
// assembled and disassembled perfectly and still produced the wrong factors.
// VPERMILPD's imm8 selectors are LANE-RELATIVE -- each 2-bit field picks a
// source element inside the destination's own 128-bit half -- so imm 0x00
// yields [s0,s1,s0,s1], not a broadcast. (It produced exactly
// ymm8 = [d,d,0,0], which tests/jit_fold_probe.quanta caught: only factor
// lanes 0 and 1 of each vector were ever right.) VPERMPD ymm1,ymm2,imm8 IS a
// cross-lane 4-element permute, so a repeated 2-bit selector broadcasts:
// lane0=0x00, lane1=0x55, lane2=0xAA, lane3=0xFF. ymm6 carries d*Kn, ymm7
// carries dmin*Mn.
fn j_f_perm6_lo(c) -> i64 {          // ymm6 <- lane 2c of ymm12/ymm13
    if c == 0 { return jbytes(6, "c4c3fd01f400") }
    if c == 1 { return jbytes(6, "c4c3fd01f4aa") }
    if c == 2 { return jbytes(6, "c4c3fd01f500") }
    return jbytes(6, "c4c3fd01f5aa")
}
fn j_f_perm6_hi(c) -> i64 {          // ymm6 <- lane 2c+1 of ymm12/ymm13
    if c == 0 { return jbytes(6, "c4c3fd01f455") }
    if c == 1 { return jbytes(6, "c4c3fd01f4ff") }
    if c == 2 { return jbytes(6, "c4c3fd01f555") }
    return jbytes(6, "c4c3fd01f5ff")
}
fn j_f_perm7_lo(c) -> i64 {          // ymm7 <- lane 2c of ymm14/ymm15
    if c == 0 { return jbytes(6, "c4c3fd01fe00") }
    if c == 1 { return jbytes(6, "c4c3fd01feaa") }
    if c == 2 { return jbytes(6, "c4c3fd01ff00") }
    return jbytes(6, "c4c3fd01ffaa")
}
fn j_f_perm7_hi(c) -> i64 {          // ymm7 <- lane 2c+1 of ymm14/ymm15
    if c == 0 { return jbytes(6, "c4c3fd01fe55") }
    if c == 1 { return jbytes(6, "c4c3fd01feff") }
    if c == 2 { return jbytes(6, "c4c3fd01ff55") }
    return jbytes(6, "c4c3fd01ffff")
}

// The 4-byte group, with the factor broadcast HOISTED out: ymm6/ymm7 must
// already hold this half's (d*Kn, dmin*Mn). Byte-for-byte the same body as
// j_f_low/j_f_high minus their two vbroadcastsd calls.
fn j_f_low_nb() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vpslld_28()
    j_f_vpsrld_28()
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

fn j_f_high_nb() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vpsrld_4()
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vmulpd_y1_y6()
    j_f_vsubpd_y1_y7()
    j_f_vmulpd_y1_r10()
    j_f_vaddpd_y0_y1()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

// ============================================================================
// Whole FOLDED kernel: same cadence, factors derived in-kernel, no DMD table.
// ============================================================================
fn jit_f_build_folded() -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_skip_header()          // r9 -> quant bytes; header now at r9-16
    j_f_load_x()
    j_f_load_n()
    j_f_vxorpd_y0()

    let bodytop = ja_pos()

    j_f_fold_factors()         // ymm12-15 = the 8 (d*Kn,dmin*Mn) pairs

    let chunk = 0
    while chunk < 4 {
        // low 32 weights of the chunk: one broadcast each, then 8 steps
        j_f_perm6_lo(chunk)
        j_f_perm7_lo(chunk)
        let b = 0
        while b < 8 {
            j_f_low_nb()
            b = b + 1
        }
        j_f_rewind_r9_32()     // re-read the same 32 quant bytes
        // high 32 weights: pair 2c+1
        j_f_perm6_hi(chunk)
        j_f_perm7_hi(chunk)
        b = 0
        while b < 8 {
            j_f_high_nb()
            b = b + 1
        }
        chunk = chunk + 1
    }
    j_f_skip_header()          // 128 quant bytes + 16 header = 144 stride

    jbytes(4, "4883e901")      // sub rcx, 1
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    j_f_vextracti128_x2_y0()
    j_f_vhaddpd_x3_x0()
    j_f_vhaddpd_x4_x2()
    j_f_vaddsd_x3_x4()
    j_f_vmovq_rax_x3()
    j_f_ret()
    return entry
}

// ============================================================================
// FOLDED Q6_K DEQUANT-DOT KERNEL (dtype 14) -- the twin of the Q4_K kernel
// ============================================================================
// WHY. Q4_K is 78.69% of the model's per-token matvec elements and its folded
// kernel landed first. The remaining 21.30% (574,619,648 elements, from the
// model's own header) is Q6_K and had NO folded twin, so those rows kept the
// two-pass shape: dequantise 256 weights into an f64 row (dq6, SIMD since
// 0.0.243) and then dot that row (mm_dot4_s). Q6_K covers NINETEEN tensors:
//   14 x blk.N.ffn_down.weight  [10752, 2048]  (22020096 elems each)
//    4 x blk.N.attn_v.weight    [ 2048,  512]
//    1 x token_embd.weight      [ 2048,128000]   <- the tied output projection
// The first eighteen go through the SAME pool kind 4 route Q4_K uses
// (mm_matvec -> mm_matvec_par -> pl_run_rows_map), so one branch there fuses
// them. token_embd does NOT: it is pool kind 5 (pl_run_embed_map) with a
// DIFFERENT reference dot -- a strict left-to-right scalar chain, not
// mm_dot4_s's four lanes -- so it is deliberately left un-fused here (see the
// COVERAGE note in gguf_mm.quanta). 
//
// WHAT IS FUSED. dot(row, x) is computed straight from the raw block, so the
// f64 row is never written and never re-read, and the (d*sc) factors are
// derived in-kernel from the block header rather than from a caller-built
// table. This is the exact structural twin of jit_f_build_folded() above; only
// the block format and the per-element unpack differ.
//
// Q6_K BLOCK (210 bytes -> 256 weights), transcribed from ggml-quants.c and
// from lib/std/gguf.quanta's dequant_q6k / mm_deq_row_raw dtype 14:
//
//    +0    u8  ql[128]   low 4 bits of every quant
//    +128  u8  qh[64]    high 2 bits of every quant
//    +192  i8  sc[16]    one signed scale per 16 weights
//    +208  f16 d         super-block scale
//
//   For a 128-element half (n = 0,1; ql at +n*64, qh at +128+n*32, sc at
//   +192+n*8) and a section s = 0..3:
//     s=0  y[ 0.. 31]  ql[ 0..31] &15, qh>>0, sc[0] sc[1]
//     s=1  y[32.. 63]  ql[32..63] &15, qh>>2, sc[2] sc[3]
//     s=2  y[64.. 95]  ql[ 0..31] >>4, qh>>4, sc[4] sc[5]
//     s=3  y[96..127]  ql[32..63] >>4, qh>>6, sc[6] sc[7]
//   each section = two 16-element halves (one scale each) = four 4-element
//   groups. Per element:
//     q = (ql & 15 | ((qh >> 2s & 3) << 4)) - 32           in [-32,31]
//     value = d * (sc * q)          sc*q EXACT, only the *d rounds
//
// BIT-EXACTNESS. The bar is the 128,000-logit test, and it demands identity
// against mm_deq_row_raw(14) + mm_dot4_s, which is what pl_run_rows_map runs
// on the un-fused branch. Three properties make that hold exactly:
//   1. PER-ELEMENT ARITHMETIC. sc (i8) times q (int in [-32,31]) is an integer
//      in [-4064,4064], exactly representable in binary64, so the vector form
//      q -> vcvtdq2pd -> *sc -> *d rounds exactly where the scalar fmul(d,
//      fmul(sc, q)) rounds (once, at *d), and then *x rounds once, same as
//      mm_dot4_s's element product. d is decoded f16->f32->f64, both steps
//      exact (f16's 11-bit significand fits f32's 24), matching f16_to_f64.
//   2. LANE ASSIGNMENT. Groups are 4 consecutive elements and element k of a
//      group lands in ymm0 lane k, so lane k accumulates the elements k, k+4,
//      k+8, ... -- exactly mm_dot4_s's lane k.
//   3. ORDER. mm_dot4_s walks c = 0,4,8,... in INCREASING element index, so
//      lane k sees its elements in increasing order. This kernel walks
//      n(0,1) -> s(0,1,2,3) -> h(0,1) -> g(0,1,2,3), whose destination index
//      32s+16h+4g+k is itself increasing with the loop nesting. So every lane
//      accumulates in the same order on both sides, and the final reduce
//      ((l0+l1)+(l2+l3)) is byte-for-byte the same as mm_dot4_s's s0+s1.
//   Float addition is not associative, so ALL THREE must hold; (2) and (3) are
//   the ones that are easy to get subtly wrong, and the header comments here
//   exist because the Q4_K kernel lost a day to exactly that class.
//
// REGISTER MAP
//   rdi = AS entry pointer          r9  = W block cursor (advance 210/block)
//   r10 = X cursor (advance 32/group)  rcx = nsuper   rax = return value
//   ymm0 = 4-lane accumulator       ymm1 = d broadcast (f64)
//   ymm2 = sc broadcast (f64, reloaded per 16-half)
//   xmm3 = -32   xmm4 = 15   xmm5 = 3   (dword masks, built with vpcmpeqd)
//   ymm6 = q/group scratch          ymm7 = qh scratch
//   No callee-saved register is touched, so there is no prologue/epilogue.

// ---- verified emit helpers (bytes pasted from `as` + `objdump -d`) ----------
// vpmovzxbd xmm6, [r9+disp8]     c4 c2 79 31 71 <disp8>   (4 ql bytes -> 4 dwords)
fn q6_ld_ql(d) -> i64 {
    jbytes(5, "c4c2793171")
    jb(d)
    return 0
}
// vpmovzxbd xmm7, [r9+disp32]    c4 c2 79 31 b9 <disp32>  (4 qh bytes -> 4 dwords)
// disp32 because the qh plane starts at +128, past the disp8 window.
fn q6_ld_qh(d) -> i64 {
    jbytes(5, "c4c27931b9")
    ji32(d)
    return 0
}
// vpbroadcastb xmm2, [r9+disp32] c4 c2 79 78 91 <disp32>
fn q6_ld_sc(d) -> i64 {
    jbytes(5, "c4c2797891")
    ji32(d)
    return 0
}
// vpmovsxbd xmm2, xmm2           c4 e2 79 21 d2   (sign-extend the i8 scale)
fn q6_sc_sext() -> i64 { return jbytes(5, "c4e27921d2") }
// vcvtdq2pd ymm2, xmm2           c5 fe e6 d2
fn q6_sc_tod() -> i64 { return jbytes(4, "c5fee6d2") }
// vpsrld xmm7, xmm7, sh          c5 c1 72 d7 <sh>
fn q6_qh_shr(sh) -> i64 { jbytes(4, "c5c172d7"); jb(sh); return 0 }

// The fastest safe load of the f16 d at [r9+208]. `vmovd xmm1,[r9+208]` would
// read 4 bytes, i.e. 2 bytes PAST the end of the last block of the tensor; the
// movzx word form reads exactly the 2 bytes the format promises.
fn q6_d_load() -> i64 {
    jbytes(8, "410fb781d0000000")   // movzx eax, word ptr [r9+208]
    jbytes(4, "c5f96ec8")           // vmovd xmm1, eax
    jbytes(5, "c4e27913c9")         // vcvtph2ps xmm1, xmm1   (f16 -> f32, exact)
    jbytes(4, "c5fc5ac9")           // vcvtps2pd ymm1, xmm1   (f32 -> f64, exact)
    jbytes(5, "c4e27d19c9")         // vbroadcastsd ymm1, xmm1 (lane 0 = d)
    return 0
}

// The constant masks -32 / 15 / 3, built from vpcmpeqd (all-ones) plus shifts,
// so no GPR and no constant pool is needed. Identical to the dq6 builtin.
fn q6_consts() -> i64 {
    jbytes(4, "c5e176db")           // vpcmpeqd xmm3,xmm3,xmm3
    jbytes(5, "c5e172f305")         // vpslld xmm3,xmm3,5    -> -32
    jbytes(4, "c5d976e4")           // vpcmpeqd xmm4,xmm4,xmm4
    jbytes(5, "c5d972d41c")         // vpsrld xmm4,xmm4,28   -> 15
    jbytes(4, "c5d176ed")           // vpcmpeqd xmm5,xmm5,xmm5
    jbytes(5, "c5d172d51e")         // vpsrld xmm5,xmm5,30   -> 3
    return 0
}

// One 4-element group -> one 4-double contribution into ymm0.
//  ql offset : n*64 + (s&1)*32 + h*16 + g*4   (max 124 -> disp8)
//  qh offset : 128 + n*32 + h*16 + g*4        (min 128 -> disp32)
// ymm2 must already hold (double)sc for this 16-half; ymm1 holds d.
fn q6_group(s, qlo, qho) -> i64 {
    q6_ld_ql(qlo)
    if s >= 2 { jbytes(5, "c5c972d604") }        // vpsrld xmm6,xmm6,4  high nibble
    else { jbytes(4, "c5c9dbf4") }               // vpand xmm6,xmm6,xmm4  low nibble
    q6_ld_qh(qho)
    if s > 0 { q6_qh_shr(s * 2) }                // vpsrld xmm7,xmm7,2s
    jbytes(4, "c5c1dbfd")                        // vpand xmm7,xmm7,xmm5  (&3)
    jbytes(5, "c5c172f704")                      // vpslld xmm7,xmm7,4
    jbytes(4, "c5c9ebf7")                        // vpor xmm6,xmm6,xmm7
    jbytes(4, "c5c9fef3")                        // vpaddd xmm6,xmm6,xmm3  (-32)
    jbytes(4, "c5fee6f6")                        // vcvtdq2pd ymm6,xmm6   (exact)
    jbytes(4, "c5cd59f2")                        // vmulpd ymm6,ymm6,ymm2 (*sc, exact)
    jbytes(4, "c5cd59f1")                        // vmulpd ymm6,ymm6,ymm1 (*d, rounds)
    jbytes(5, "c4c14d5932")                      // vmulpd ymm6,ymm6,[r10] (*x, rounds)
    jbytes(4, "c5fd58c6")                        // vaddpd ymm0,ymm0,ymm6 (lane k += elem k)
    jbytes(4, "4983c220")                        // add r10, 32   (4 doubles)
    return 0
}

// ============================================================================
// jit_f_build_folded_q6k(): the whole leaf function, factor-free (d and the 16
// scales are read from the block header in-kernel), same cadence as dq6.
// ============================================================================
fn jit_f_build_folded_q6k() -> i64 {
    let entry = ja_pos()
    j_f_load_w()               // r9  = W  (block cursor)
    j_f_load_x()               // r10 = X
    j_f_load_n()               // rcx = nsuper
    j_f_vxorpd_y0()            // ymm0 = 0

    let bodytop = ja_pos()     // the backward branch targets THIS address

    q6_d_load()                // ymm1 = broadcast d
    q6_consts()                // xmm3/4/5 = -32 / 15 / 3

    // 256 weights = 2 halves x 4 sections x 2 sixteen-element halves x 4 groups.
    let n = 0
    while n < 2 {
        let s = 0
        while s < 4 {
            let h = 0
            while h < 2 {
                // one scale per 16 weights: sc byte 192 + n*8 + 2s + h
                q6_ld_sc(192 + n * 8 + s * 2 + h)
                q6_sc_sext()
                q6_sc_tod()
                let g = 0
                while g < 4 {
                    q6_group(s, n * 64 + (s - (s / 2) * 2) * 32 + h * 16 + g * 4, 128 + n * 32 + h * 16 + g * 4)
                    g = g + 1
                }
                h = h + 1
            }
            s = s + 1
        }
        n = n + 1
    }
    jbytes(7, "4981c1d2000000")    // add r9, 210   (one Q6_K super-block)

    // sub rcx,1 ; jne rel32 -> bodytop. rel32 because the body is ~4 KB.
    jbytes(4, "4883e901")
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    // horizontal reduce: ((l0+l1)+(l2+l3)), identical to mm_dot4_s's s0+s1.
    jbytes(6, "c4e37d39c201")      // vextracti128 xmm2, ymm0, 1
    jbytes(4, "c5f97cd8")          // vhaddpd xmm3, xmm0, xmm0
    jbytes(4, "c5e97ce2")          // vhaddpd xmm4, xmm2, xmm2
    jbytes(4, "c5e358dc")          // vaddsd xmm3, xmm3, xmm4
    jbytes(5, "c4e1f97ed8")        // vmovq rax, xmm3   (f64 bits)
    jbytes(1, "c3")                // ret
    return entry
}

// ============================================================================
// jit_f_build_chain_q6k(): the SCALAR-CHAIN twin of the folded Q6_K kernel.
//
// WHY A SECOND KERNEL. The tied output projection (token_embd.weight, Q6_K,
// [2048, 128000] = 262,144,000 elements, the single largest matvec in the model)
// is the one matvec the 4-lane folded route CANNOT take. Its reference dot is
// pl_run_embed_map's strict LEFT-TO-RIGHT scalar chain
//     acc = acc + row[c]*x[c]     for c = 0..ncols-1
// not mm_dot4_s's four lanes, so the 4-lane kernel would change every product's
// summation order. Changing the REFERENCE to make a kernel reusable was already
// rejected once (blast radius); this kernel instead keeps the chain and deletes
// the overhead the chain pays.
//
// THE SHAPE. The dequant is byte-for-byte the same encodings as
// jit_f_build_folded_q6k (register-resident, factor-free). The only difference is
// the fold: instead of `vaddpd ymm0, ymm0, ymm6` (lane k accumulates element
// k%4, reduced horizontally at the end -- the 4-lane order), the four products of
// each group are folded into ONE scalar accumulator with FOUR SERIAL vaddsd, in
// element order:
//     acc += p[4i+0] ; acc += p[4i+1] ; acc += p[4i+2] ; acc += p[4i+3]
// which is exactly `acc = acc + row[c]*x[c]` in order. Groups are consumed in
// ascending element order and r10 walks x 4 doubles at a time, so the sequence is
// c = 0,1,2,...,ncols-1 with nothing reordered, reassociated, or vectorised.
//
// COST MODEL. The chain is LATENCY-bound: four dependent vaddsd (4 cycles each)
// per 4 elements = ~4 cycles/element, and the independent multiplies and the
// dequant issue underneath it. That is the price of the reference order -- it
// cannot be broken without breaking bit-exactness -- and it is still an order of
// magnitude below the scalar path, which pays ~4 Quanta builtin calls (each a
// call + home-slot round trip) per element.
//
// xmm7 is the shuffle scratch. q6_group_chain leaves it dead after the
// multiplies, so no extra register is needed; ymm0 is zeroed once and only its
// low lane (xmm0) is ever the accumulator.
// ============================================================================

// One 4-element group -> four SERIAL vaddsd into the scalar accumulator xmm0.
// Dequant encodings identical to q6_group; the fold is the only change.
fn q6_group_chain(s, qlo, qho) -> i64 {
    q6_ld_ql(qlo)
    if s >= 2 { jbytes(5, "c5c972d604") }        // vpsrld xmm6,xmm6,4  high nibble
    else { jbytes(4, "c5c9dbf4") }               // vpand xmm6,xmm6,xmm4  low nibble
    q6_ld_qh(qho)
    if s > 0 { q6_qh_shr(s * 2) }                // vpsrld xmm7,xmm7,2s
    jbytes(4, "c5c1dbfd")                        // vpand xmm7,xmm7,xmm5  (&3)
    jbytes(5, "c5c172f704")                      // vpslld xmm7,xmm7,4
    jbytes(4, "c5c9ebf7")                        // vpor xmm6,xmm6,xmm7
    jbytes(4, "c5c9fef3")                        // vpaddd xmm6,xmm6,xmm3  (-32)
    jbytes(4, "c5fee6f6")                        // vcvtdq2pd ymm6,xmm6   (exact)
    jbytes(4, "c5cd59f2")                        // vmulpd ymm6,ymm6,ymm2 (*sc, exact)
    jbytes(4, "c5cd59f1")                        // vmulpd ymm6,ymm6,ymm1 (*d, rounds)
    jbytes(5, "c4c14d5932")                      // vmulpd ymm6,ymm6,[r10] (*x, rounds)
    // ---- the chain: acc += p0, p1, p2, p3 IN ELEMENT ORDER -----------------
    jbytes(4, "c5fb58c6")            // vaddsd xmm0, xmm0, xmm6       acc += p0
    jbytes(4, "c5c915fe")            // vunpckhpd xmm7, xmm6, xmm6    [p1,p1]
    jbytes(4, "c5fb58c7")            // vaddsd xmm0, xmm0, xmm7       acc += p1
    jbytes(6, "c4e37d19f701")        // vextractf128 xmm7, ymm6, 1    [p2,p3]
    jbytes(4, "c5fb58c7")            // vaddsd xmm0, xmm0, xmm7       acc += p2
    jbytes(4, "c5c115ff")            // vunpckhpd xmm7, xmm7, xmm7    [p3,p3]
    jbytes(4, "c5fb58c7")            // vaddsd xmm0, xmm0, xmm7       acc += p3
    jbytes(4, "4983c220")                        // add r10, 32   (4 doubles)
    return 0
}

fn jit_f_build_chain_q6k() -> i64 {
    let entry = ja_pos()
    j_f_load_w()               // r9  = W  (block cursor)
    j_f_load_x()               // r10 = X
    j_f_load_n()               // rcx = nsuper
    j_f_vxorpd_y0()            // ymm0 = 0 -> xmm0 lane0 is the scalar accumulator

    let bodytop = ja_pos()

    q6_d_load()                // ymm1 = broadcast d
    q6_consts()                // xmm3/4/5 = -32 / 15 / 3

    let n = 0
    while n < 2 {
        let s = 0
        while s < 4 {
            let h = 0
            while h < 2 {
                q6_ld_sc(192 + n * 8 + s * 2 + h)
                q6_sc_sext()
                q6_sc_tod()
                let g = 0
                while g < 4 {
                    q6_group_chain(s, n * 64 + (s - (s / 2) * 2) * 32 + h * 16 + g * 4, 128 + n * 32 + h * 16 + g * 4)
                    g = g + 1
                }
                h = h + 1
            }
            s = s + 1
        }
        n = n + 1
    }
    jbytes(7, "4981c1d2000000")    // add r9, 210   (one Q6_K super-block)

    jbytes(4, "4883e901")          // sub rcx,1
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    // NO horizontal reduce: the whole chain is already in xmm0 lane 0.
    // FIVE bytes: jbytes(n,f) writes only the first n bytes of the hex string, and
    // a 5-byte instruction declared as 4 drops the ModRM byte -- the following
    // `c3` (ret) then lands as that instruction's ModRM (vmovq %xmm0,%rbx) and the
    // kernel runs off the end of the emitted region into zero padding (measured:
    // SIGSEGV at `add %al,(%rax)` with rax=0xbc). tests/lfm2_jbytes_len_check.py
    // now checks every jbytes call in lib/std/jit_x86*.quanta mechanically.
    jbytes(5, "c4e1f97ec0")        // vmovq rax, xmm0   (f64 bits of the chain sum)
    jbytes(1, "c3")                // ret
    return entry
}

// ============================================================================
// ============================================================================
// LOWER HALF -- the caller side: how emitted bytes become callable functions
// ============================================================================
// ============================================================================

// ---- the closure shim ------------------------------------------------------
// The only indirect call the language can make is CLOSURE_CALL (see
// tests/lfm2_jit_probe.quanta, committed 2cace033). It requires a tuple whose
// first qword is the code pointer, so "JIT'd code" enters through the same
// door as any other Quanta closure:
//
//     let tbl = mem_alloc(2)
//     mem_store(tbl, entry)          // where our bytes live
//     mem_store(tbl + 8, 0)          // no environment
//     let result = closure_call(tbl, args_ptr)
//
// Because it is a genuine `call` instruction, the emitted bytes see a normal
// SysV frame and may use every caller-saved register freely. We do exactly
// that: the kernel writes rax,rcx,rdx,rsi,rdi,r8-r11 and touches no
// callee-saved register, so there is no stack traffic at all.
fn jit_f_code(entry: i64) -> i64 {
    let tbl = mem_alloc(2)
    mem_store(tbl, entry)
    mem_store(tbl + 8, 0)
    return tbl
}

// ---- executable memory -----------------------------------------------------
// Maps a fresh RWX anonymous region for emitted code. Wraps the region in the
// jit_x86 emit cursor so the builders above can write into it directly.
//
// NOTE: W^X-pedantic kernels refuse PROT_EXEC on anonymous mappings; this box
// (Linux 6.12) allows it, and tests/lfm2_jit_probe.quanta Q3 proved it here by
// executing eight runtime-emitted stubs. Return<=0 means the box forbids it --
// the test must then report "unsupported", not "failed".
fn jit_f_alloc(nbytes: i64) -> i64 {
    let base = mmap_file(0, nbytes, 7, 34, 0 - 1, 0)
    if base <= 0 { return 0 }
    ja_init(base, nbytes)
    return base
}

// ============================================================================
// HIGH-LEVEL ENTRY: one Q4_K row dot, ready to call from a model module
// ============================================================================
//
// STATUS: UNBLOCKED as of qc 0.0.246. The trio below is now callable from an
// imported module and is exercised by the gate row
// test_suites/codes/stdlib_jit_dispatch_test.quanta (expected rc=0, PASSING).
//
// HISTORY, kept because the diagnosis matters and was wrong once: on 0.0.245
// this call SIGSEGV'd (rc=139) when reached from a function inside an IMPORTED
// module, while the byte-identical inline `closure_call(tbl, asz, 0)` in `main`
// returned 4700186342854754304. The device blamed was closure_call. The real
// cause was the parameter NAME `as`: funcscan recorded a parameter only when
// its name token was TT_ID, so a parameter named with a reserved keyword token
// was dropped, every later parameter shifted down one slot, and the kernel was
// entered with rdi=0. Fixed in 0.0.246 (see
// docs/research/keyword-named-parameters.md). NOTE the fix was a front-end
// predicate, NOT a closure_call change, so this module needed no edit.
//
// jit_f_setup() emits the kernel ONCE and keeps the closure tuple here, so
// callers only have to supply the argument area.
let jf_tbl = 0
let jf_tbl_folded = 0

fn jit_f_setup() -> i64 {
    if jf_tbl != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build())
    if t <= 0 { return -2 }
    jf_tbl = t
    return 0
}

fn jit_f_ready() { return jf_tbl }

// Call the emitted kernel with the argument area at `as` (4 qwords:
// W, X, DMD, nsuper). Returns the dot as raw f64 bits.
fn jit_f_apply(as) -> i64 {
    return closure_call(jf_tbl, as, 0)
}

// ---- the FOLDED kernel, same entry shape -----------------------------------
// Emits jit_f_build_folded() into its OWN region so the table kernel above is
// left byte-identical (the gate row above depends on it). The folded kernel
// derives its factors in-kernel and IGNORES [AS+16], so the DMD slot must
// simply be left as anything -- pass 0.
fn jit_f_setup_folded() -> i64 {
    if jf_tbl_folded != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build_folded())
    if t <= 0 { return -2 }
    jf_tbl_folded = t
    return 0
}

fn jit_f_ready_folded() { return jf_tbl_folded }

fn jit_f_apply_folded(as) -> i64 {
    return closure_call(jf_tbl_folded, as, 0)
}

// ---- the FOLDED Q6_K kernel, same entry shape ------------------------------
// Its own RWX region again, so the Q4_K kernels above stay byte-identical. Same
// argument area ([W, X, DMD, nsuper], [AS+16] unread) and the same
// closure_call door, so callers only choose which kernel to dispatch.
let jf_tbl_q6k = 0

fn jit_f_setup_folded_q6k() -> i64 {
    if jf_tbl_q6k != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build_folded_q6k())
    if t <= 0 { return -2 }
    jf_tbl_q6k = t
    return 0
}

fn jit_f_ready_folded_q6k() { return jf_tbl_q6k }

fn jit_f_apply_folded_q6k(as) -> i64 {
    return closure_call(jf_tbl_q6k, as, 0)
}

// ---- the SCALAR-CHAIN Q6_K kernel (the tied output projection) --------------
// Same entry shape again ([W, X, DMD, nsuper], and the chain kernel reads only
// [W], [X] and [nsuper] like the folded twins), its OWN RWX region so the other
// kernels stay byte-identical, and its own fail-closed flag.
let jf_tbl_chain = 0

fn jit_f_setup_chain() -> i64 {
    if jf_tbl_chain != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build_chain_q6k())
    if t <= 0 { return -2 }
    jf_tbl_chain = t
    return 0
}

fn jit_f_ready_chain() { return jf_tbl_chain }

fn jit_f_apply_chain(as) -> i64 {
    return closure_call(jf_tbl_chain, as, 0)
}

// ---- the per-super-block dequant argument table (the TABLE kernel's input) --
// The table kernel reads its scale/min factors from a precomputed table rather
// than doing f16 arithmetic in the hot loop. Layout, per super-block:
//
//     8 entries x 16 bytes = 128 bytes, entry k =
//         +0  f64  d    * scale[k]       applies to the 4 low nibbles
//         +8  f64  dmin * min[k]         subtracts from those same 4
//
// One entry serves ONE 32-weight half, so the kernel must CONSUME the entry for
// a whole 8-step half and advance rdx only once per half (see jit_f_build's
// chunk loop). An earlier revision advanced one entry every four weights, which
// read the wrong factors for 7/8 of the row -- that was fixed by giving rdx to
// the chunk, and the corrected cadence is what tests/jit_vs_prod_test.quanta
// and tests/lfm2_jit_mm_test.quanta verify bit-exactly against
// q4k_matvec_real and mm_deq_row_raw + mm_dot4_s.
//
// NOTE: jit_f_build_folded() above does not read this table at all -- it derives
// the same eight pairs in-kernel. This table remains the input for jit_f_build()
// only.
fn jit_f_dmd_alloc(nsuper: i64) -> i64 {
    let nbytes = nsuper * 128
    let p = mem_alloc(nbytes)
    return p
}

// Fill the table for one super-block from its raw bytes.
//   raw     : start of the 144-byte Q4_K super-block
//   d       : the block's f16 scale, already converted to f64
//   dmin    : the block's f16 min scale, already converted to f64
//   sc      : pointer to the 12 packed scale bytes (raw + 4)
//   DMD     : destination row for this super-block (128 bytes)
//
// Uses the SAME q4k_sc / q4k_min bit-extraction as lib/std/matmul_q4k.quanta
// so both paths agree on the factors before the arithmetic differs.
fn jit_f_dmd_fill(raw, sc, d: f64, dmin: f64, DMD) -> i64 {
    let k = 0
    while k < 8 {
        let s0 = q4k_sc_jit(k, sc)
        let m0 = q4k_min_jit(k, sc)
        mem_store(DMD + k * 16, fmul(d, i2f(s0)))
        mem_store(DMD + k * 16 + 8, fmul(dmin, i2f(m0)))
        k = k + 1
    }
    return 0
}

// Local copies of the scale/min extractors, matching matmul_q4k.quanta.
fn q4k_sc_jit(j, sc) {
    if j < 4 { return mem_load8(sc + j) - (mem_load8(sc + j) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo - (lo / 16) * 16) + ((mem_load8(sc + j - 4) / 64) * 16)
}

fn q4k_min_jit(j, sc) {
    if j < 4 { return mem_load8(sc + j + 4) - (mem_load8(sc + j + 4) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo / 16 - (lo / 16 / 16) * 16) + ((mem_load8(sc + j) / 64) * 16)
}

// ============================================================================
// CALLING CONTRACT -- how lfm2_forward must use this, given the source admits
// no pointer-to-function type in its tensor arguments
// ============================================================================
//
// 1. Every value the kernel needs arrives through a SIX-POINTER argument area
//    rather than through registers directly, because Quanta's closure_call
//    passes exactly one pointer argument in rdi:
//
//        AS = mem_alloc(6)          // argument area
//        AS[0] = W                  // quantised row base
//        AS[1] = X                  // f64 x base
//        AS[2] = DMD                // the (d*scale, dmin*min) table above
//        AS[3] = nsuper             // cols / 256
//
//    The kernel loads all four from rdi in its first instructions.
//
// 2. X-PERMANENCE -- resolved by reading the forward path, not assumed.
//    mm_load_row (gguf_mm.quanta:80) creates NO row buffer: it fills the two
//    MODULE GLOBALS mm_rowraw and mm_rowbuf, and its only other effect is a
//    read. So a fused dot may hold x FIXED in a register across every dot of
//    a whole tensor, and the same x may be re-read as many times as rows
//    require. Confirming that required checking every matvec call site for
//    aliasing (could some call pass a destination that overlaps its own x?):
//
//      fc_short_conv : mm_matvec(cin, x, ...)      -> fc_sc_ip
//                      mm_matvec(cout, fc_sc_y,..) -> out
//      fc_attention  : q/k/v from x                -> fc_at_q/k/v
//                      mm_matvec(wo, fc_at_out,..) -> out
//      fc_layer ffn  : gate/up from fc_fw_n        -> fc_ffn_f_gate/up
//                      down from fc_fw_f           -> fc_fw_ff
//      fc_final_norm+logits : mm_embed_logits(emb, fc_fw_n, ..) -> fc_fw_logits
//
//    In every case the destination is a distinct buffer from the source and
//    none of them is ever also the x argument -- the closest is
//    fc_layer writing its residual into `out` while reading fc_fw_x, which is
//    a different pointer. So: **x must be immutable for the DURATION of the
//    fused loop, and it is.** The pointer identity changes per tensor, so the
//    caller re-establishes the base each time, once per matvec, not per row.
//
// 3. The kernel returns the f64 dot product as RAW BITS in rax, which is
//    already Quanta's float convention -- so the caller does NOT reinterpret.
//    See: jit_f_code() returns whatever closure_call yields.
//
// 4. The results must be summed EXACTLY once per row. Keeping y scalar is what
//    preserves the scalar path's summation order across super-blocks.

// ============================================================================
// FMA VARIANT of the folded kernels (opt-in, default OFF, its OWN flag)
// ============================================================================
// WHY. lib/std had no `vfmadd` anywhere in it while /proc/cpuinfo reports `fma`.
// Every multiply-accumulate in the folded kernels was a separate `vmulpd` +
// `vaddpd`. Measured instruction census of the emitted bodies before this:
// 26 vmulpd / 25 vcvtdq2pd / 15 vaddpd (docs/plans/performance.md).
//
// WHAT CHANGES, per 4-weight group:
//
//   Q4_K (j_f_low_nb / j_f_high_nb): 4 FP ops -> 2
//       vmulpd  ymm1, ymm1, ymm6        q*K
//       vsubpd  ymm1, ymm1, ymm7        w = q*K - M
//       vmulpd  ymm1, ymm1, [r10]       w*x
//       vaddpd  ymm0, ymm0, ymm1
//     becomes
//       vfnmadd213pd ymm1, ymm6, ymm7   ymm1 = -(q*K) + M  = -w
//       vfnmadd231pd ymm0, ymm1, [r10]  ymm0 = -((-w)*x) + ymm0 = ymm0 + w*x
//     It also halves the DEPENDENCY CHAIN of the fold (2 dependent ops instead
//     of 4), which matters more than the instruction count here because the
//     seven dequant ops above it are independent and issue underneath it.
//
//   Q6_K (q6_group): 4 FP ops -> 3
//       vmulpd ymm6, ymm6, ymm2         *sc   (exact)
//       vmulpd ymm6, ymm6, ymm1         *d    (rounds -- MUST stay a separate
//                                              multiply: it is where the
//                                              reference rounds)
//       vfmadd231pd ymm0, ymm6, [r10]   acc += (q*sc*d)*x, ONE rounding
//
// ENCODINGS ARE VERIFIED BY EXECUTION, not by reading the manual. The three
// forms were assembled and then RUN in a C harness with known operands,
// asserting on all four lanes
//     vfnmadd213pd y1,y6,y7 == -(y1*y6)+y7
//     vfnmadd231pd y0,y1,m  == -(y1*m)+y0
//     vfmadd231pd  y0,y6,m  ==  y6*m+y0
// (A previous unit lost a day to `vpermilpd`'s lane-relative selectors, so no
// FMA operand-order assumption is taken on faith.)
//
// THE CHAIN KERNEL IS DELIBERATELY NOT FUSED, and the reason is structural
// rather than budgetary. jit_f_build_chain_q6k() keeps the reference's strict
// left-to-right scalar accumulation; its fold is four SERIAL vaddsd whose
// operands are already-computed products, so there is nothing for an FMA to
// fuse that the reference has not already rounded. It would gain zero
// instructions and move bits for no speed. It therefore stays on the f64 route
// even when the FMA flag is on. Stated here, not left to be inferred.
//
// BIT STATUS: this path MOVES BITS (single-rounding differs from mul-then-add)
// which is exactly why it is a separate flag with its own bar -- see the
// mm_fused_fma block in gguf_mm.quanta for the measured bound.

// vfnmadd213pd ymm1, ymm6, ymm7   c4 e2 cd ac cf   ymm1 = -(ymm1*ymm6) + ymm7
fn j_f_vfnmadd213_y1_y6_y7() -> i64 { return femit("c4e2cdaccf", 5) }
// vfnmadd231pd ymm0, ymm1, [r10]  c4 c2 f5 bc 02   ymm0 = -(ymm1*[r10]) + ymm0
fn j_f_vfnmadd231_y0_y1_r10() -> i64 { return femit("c4c2f5bc02", 5) }
// vfmadd231pd ymm0, ymm6, [r10]   c4 c2 cd b8 02   ymm0 = ymm6*[r10] + ymm0
fn j_f_vfmadd231_y0_y6_r10() -> i64 { return femit("c4c2cdb802", 5) }

// ---- Q4_K: the two 4-weight group bodies with the fold fused ----------------
fn j_f_low_fma() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vpslld_28()
    j_f_vpsrld_28()
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vfnmadd213_y1_y6_y7()
    j_f_vfnmadd231_y0_y1_r10()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

fn j_f_high_fma() -> i64 {
    j_f_vpmovzxbd_x1_r9()
    j_f_vpsrld_4()
    j_f_vpsrldq_x2_x1_8()
    j_f_vcvtdq2pd_y1_x1()
    j_f_vcvtdq2pd_y2_x2()
    j_f_vinsertf128_y1_y1_x2_1()
    j_f_vfnmadd213_y1_y6_y7()
    j_f_vfnmadd231_y0_y1_r10()
    j_f_add_r9_4()
    j_f_add_r10_32()
    return 0
}

// Whole FMA Q4_K kernel: byte-for-byte jit_f_build_folded() except that the two
// group bodies are the FMA ones. A separate entry point into its OWN region, so
// the f64 kernels stay byte-identical (their gate rows depend on that).
fn jit_f_build_folded_fma() -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_skip_header()
    j_f_load_x()
    j_f_load_n()
    j_f_vxorpd_y0()

    let bodytop = ja_pos()

    j_f_fold_factors()

    let chunk = 0
    while chunk < 4 {
        j_f_perm6_lo(chunk)
        j_f_perm7_lo(chunk)
        let b = 0
        while b < 8 { j_f_low_fma(); b = b + 1 }
        j_f_rewind_r9_32()
        j_f_perm6_hi(chunk)
        j_f_perm7_hi(chunk)
        b = 0
        while b < 8 { j_f_high_fma(); b = b + 1 }
        chunk = chunk + 1
    }
    j_f_skip_header()

    jbytes(4, "4883e901")      // sub rcx, 1
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    j_f_vextracti128_x2_y0()
    j_f_vhaddpd_x3_x0()
    j_f_vhaddpd_x4_x2()
    j_f_vaddsd_x3_x4()
    j_f_vmovq_rax_x3()
    j_f_ret()
    return entry
}

// ---- Q6_K: the 4-element group body with the fold fused ---------------------
// The dequant encodings are IDENTICAL to q6_group; only the last two FP ops
// collapse into one vfmadd231pd.
fn q6_group_fma(s, qlo, qho) -> i64 {
    q6_ld_ql(qlo)
    if s >= 2 { jbytes(5, "c5c972d604") }        // vpsrld xmm6,xmm6,4
    else { jbytes(4, "c5c9dbf4") }               // vpand xmm6,xmm6,xmm4
    q6_ld_qh(qho)
    if s > 0 { q6_qh_shr(s * 2) }                // vpsrld xmm7,xmm7,2s
    jbytes(4, "c5c1dbfd")                        // vpand xmm7,xmm7,xmm5  (&3)
    jbytes(5, "c5c172f704")                      // vpslld xmm7,xmm7,4
    jbytes(4, "c5c9ebf7")                        // vpor xmm6,xmm6,xmm7
    jbytes(4, "c5c9fef3")                        // vpaddd xmm6,xmm6,xmm3 (-32)
    jbytes(4, "c5fee6f6")                        // vcvtdq2pd ymm6,xmm6 (exact)
    jbytes(4, "c5cd59f2")                        // vmulpd ymm6,ymm6,ymm2 (*sc, exact)
    jbytes(4, "c5cd59f1")                        // vmulpd ymm6,ymm6,ymm1 (*d, rounds)
    j_f_vfmadd231_y0_y6_r10()                    // acc += (q*sc*d)*x  (one rounding)
    jbytes(4, "4983c220")                        // add r10, 32
    return 0
}

fn jit_f_build_folded_q6k_fma() -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_load_x()
    j_f_load_n()
    j_f_vxorpd_y0()

    let bodytop = ja_pos()

    q6_d_load()
    q6_consts()

    let n = 0
    while n < 2 {
        let s = 0
        while s < 4 {
            let h = 0
            while h < 2 {
                q6_ld_sc(192 + n * 8 + s * 2 + h)
                q6_sc_sext()
                q6_sc_tod()
                let g = 0
                while g < 4 {
                    q6_group_fma(s, n * 64 + (s - (s / 2) * 2) * 32 + h * 16 + g * 4, 128 + n * 32 + h * 16 + g * 4)
                    g = g + 1
                }
                h = h + 1
            }
            s = s + 1
        }
        n = n + 1
    }
    jbytes(7, "4981c1d2000000")    // add r9, 210

    jbytes(4, "4883e901")          // sub rcx,1
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    jbytes(6, "c4e37d39c201")      // vextracti128 xmm2, ymm0, 1
    jbytes(4, "c5f97cd8")          // vhaddpd xmm3, xmm0, xmm0
    jbytes(4, "c5e97ce2")          // vhaddpd xmm4, xmm2, xmm2
    jbytes(4, "c5e358dc")          // vaddsd xmm3, xmm3, xmm4
    jbytes(5, "c4e1f97ed8")        // vmovq rax, xmm3
    jbytes(1, "c3")                // ret
    return entry
}

// ---- the FMA kernels' own RWX regions and tables ---------------------------
// Own regions again, so the f64 kernels' bytes are untouched. Same argument area
// ([W, X, DMD, nsuper], [AS+16] unread) and the same closure_call door.
let jf_tbl_fma = 0
let jf_tbl_fma_q6k = 0

fn jit_f_setup_folded_fma() -> i64 {
    if jf_tbl_fma != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build_folded_fma())
    if t <= 0 { return -2 }
    jf_tbl_fma = t
    return 0
}

fn jit_f_ready_folded_fma() { return jf_tbl_fma }

fn jit_f_apply_folded_fma(as) -> i64 {
    return closure_call(jf_tbl_fma, as, 0)
}

fn jit_f_setup_folded_q6k_fma() -> i64 {
    if jf_tbl_fma_q6k != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build_folded_q6k_fma())
    if t <= 0 { return -2 }
    jf_tbl_fma_q6k = t
    return 0
}

fn jit_f_ready_folded_q6k_fma() { return jf_tbl_fma_q6k }

fn jit_f_apply_folded_q6k_fma(as) -> i64 {
    return closure_call(jf_tbl_fma_q6k, as, 0)
}

// ============================================================================
// THE f32 KERNEL FAMILY -- opt-in, DEFAULT OFF, its OWN flag (mm_fused_f32)
// ============================================================================
// WHY f32. Every FP instruction in the kernels above is a *pd form: 4 f64 lanes
// per ymm. The *ps forms carry EIGHT lanes, `vcvtdq2ps` converts 8 int32 at once
// where `vcvtdq2pd` converts only the low 4, and x becomes 4 bytes/element
// instead of 8 -- halving the one operand that is re-read once per ROW (x is
// read rows*cols*8 bytes per matvec against 0.5 bytes/element of weights, i.e.
// 16x the weight traffic; see docs/research/f32-fma-loader-kernels.md 3.1).
//
// Measured instruction counts of the emitted bodies, per Q4_K super-block
// (256 weights), the f64 folded kernel against the f32 one:
//   f64: 43-instruction factor prologue + 4 chunks x (8x13 low + 1 rewind +
//        8x12 high) = 43 + 4*201 = 847
//   f32: 32-instruction factor prologue + 16 broadcasts + 4 chunks x (4x10 low
//        + 1 rewind + 4x9 high) = 48 + 4*77 = 356
// i.e. ~2.4x fewer instructions for the same 256 weights, because a group is 8
// weights instead of 4. That is the lever: not a percentage but a multiple.
//
// BIT STATUS: this path MOVES BITS and therefore has its OWN flag and its OWN
// bar, exactly like the FMA kernels. Two independent reasons bits move:
//   1. f32 ACCUMULATION, not f64. llama.cpp's own SIMD dot products accumulate
//      in f32, so this moves the loader TOWARD its reference -- but it is a
//      different sequence from THIS loader's f64 one, and the existing flags'
//      gate is bit-exactness against that. Hence: a separate flag, never a
//      silent substitution.
//   2. x is NARROWED to f32 once per matvec (RNE), where the f64 path keeps it
//      in f64. One rounding per activation element.
// The measured bound is in docs/research/f32-loader-kernels.md and is reproduced
// by tests/lfm2_f32_kernel_ab_test.quanta (argmax 597, first 24 ids identical,
// and a max |logit difference| stated as an absolute value and a relative one).
//
// COMPOSITION WITH mm_fused_fma -- stated, not left to be inferred:
//   f32=0 fma=0 -> the f64 folded kernels          (unchanged)
//   f32=0 fma=1 -> the f64 FMA kernels             (unchanged)
//   f32=1 fma=0 -> the f32 kernels                 (this section)
//   f32=1 fma=1 -> the f32 FMA kernels             (this section, fused fold)
// mm_fused_f32 is a MODIFIER of mm_fused_q4k / mm_fused_q6k exactly as
// mm_fused_fma is: it changes WHICH kernel those routes dispatch. The f64
// kernels' bytes are not touched and their gate rows depend on that.
//
// REGISTER MAP of the f32 Q4_K kernel (the Q6_K one is beside its builder):
//   rdi = AS     r9 = W cursor   r10 = X f32 cursor   rcx = nsuper
//   ymm0 = 8-lane f32 accumulator    ymm1 = weight scratch
//   ymm2 = [d,dmin,0,0] f32          ymm8/ymm9  = broadcast d / dmin (4 f32)
//   ymm4/ymm5/ymm10 = sc bytes a/b/c as dwords     ymm3/ymm11 = unpack scratch
//   ymm12 = [d*sc0..3]   ymm13 = [d*sc4..7]    (each later DUPLICATED to 8 lanes)
//   ymm14 = [dmin*mn0..3] ymm15 = [dmin*mn4..7] (each later DUPLICATED)
//   ymm6 = this half's scale broadcast (8 f32)   ymm7 = this half's min (8 f32)
// No callee-saved register is touched: no prologue, no epilogue, no stack.
//
// THE BROADCAST TRICK, and why it is 1 instruction. VPERMILPS's imm8 selectors
// are LANE-RELATIVE within each 128-bit half -- the exact trap that cost a peer
// a day with vpermilpd. It is used here ON PURPOSE: after each factor vector is
// DUPLICATED into both halves by `vinsertf128 ymm,ymm,xmm,1` (verified by
// execution: the imm8 low bit selects the destination lane, and 1 means the HIGH
// one, so the register becomes [x,x]), a single `vpermilps ymm6, ymm12, j*0x55`
// broadcasts lane j of the low half to all eight lanes. That is one instruction
// per factor, against the f64 kernel's one vpermpd per factor, while carrying
// twice the lanes.

// ---- the shared 8-lane f32 reduce: ymm0 -> f64 bits in rax -----------------
// ORDER, stated because it is a specific choice and not "whatever the hardware
// does": with ymm0 = [L0..L7],
//     vextractf128 + vaddps  -> A = [L0+L4, L1+L5, L2+L6, L3+L7]
//     vhaddps x2             -> (A0+A1)+(A2+A3)
// i.e. ((L0+L4)+(L1+L5)) + ((L2+L6)+(L3+L7)), every step in f32.
// PINNED BY EXECUTION over 4000 random finite inputs, bit-for-bit, in
// tests/lfm2_f32_enc_verify.c -- this order is a stated contract, not an
// emergent property. The f32 sum is then widened ONCE to f64 (exact), because
// the calling contract is "the dot as f64 bits in rax".
fn j_f32_vxorps_y0() -> i64 { return femit("c5fc57c0", 4) }
fn j_f32_reduce() -> i64 {
    femit("c4e37d19c101", 6)     // vextractf128 xmm1, ymm0, 1
    femit("c5f858c1", 4)         // vaddps xmm0, xmm0, xmm1
    femit("c5fb7cc0", 4)         // vhaddps xmm0, xmm0, xmm0
    femit("c5fb7cc0", 4)         // vhaddps xmm0, xmm0, xmm0
    femit("c5fa5ac0", 4)         // vcvtss2sd xmm0, xmm0, xmm0   (exact widening)
    femit("c4e1f97ec0", 5)       // vmovq rax, xmm0
    return 0
}

// ---- Q4_K f32: the 8-weight group body --------------------------------------
// vpmovzxbd ymm1, qword [r9]   c4 c2 7d 31 09   FOUR bytes -> FOUR dwords
// (the xmm form above). The ymm destination form has L=1 and reads EIGHT bytes,
// giving 8 dwords: low nibbles are weights [i..i+7], high nibbles [32+i..39+i].
// Verified by execution including the read length: lane 7 must carry byte 7.
fn j_f32_vpmovzxbd_y1_r9() -> i64 { return femit("c4c27d3109", 5) }
fn j_f32_vpslld_y1_28() -> i64 { return femit("c5f572f11c", 5) }   // <<28: low nib -> high
fn j_f32_vpsrld_y1_28() -> i64 { return femit("c5f572d11c", 5) }   // >>28: & 15
fn j_f32_vpsrld_y1_4()  -> i64 { return femit("c5f572d104", 5) }   // >>4 : high nibble
fn j_f32_vcvtdq2ps_y1() -> i64 { return femit("c5fc5bc9", 4) }     // 8 int32 -> 8 f32
fn j_f32_vmulps_y1_y6() -> i64 { return femit("c5f459ce", 4) }     // * (d*sc)
fn j_f32_vsubps_y1_y7() -> i64 { return femit("c5f45ccf", 4) }     // - (dmin*mn)
fn j_f32_vmulps_y1_r10() -> i64 { return femit("c4c174590a", 5) }  // * x (8 f32 = 32 bytes)
fn j_f32_vaddps_y0_y1() -> i64 { return femit("c5fc58c1", 4) }
fn j_f32_add_r9_8() -> i64 { return femit("4983c108", 4) }
// the FMA fold, byte-for-byte the f64 shape with ps opcodes:
//   vfnmadd213ps ymm1, ymm6, ymm7   ymm1 = -(q*K) + M  = -w
//   vfnmadd231ps ymm0, ymm1, [r10]  ymm0 = -((-w)*x) + ymm0 = acc + w*x
fn j_f32_vfnmadd213_y1_y6_y7() -> i64 { return femit("c4e24daccf", 5) }
fn j_f32_vfnmadd231_y0_y1_r10() -> i64 { return femit("c4c275bc02", 5) }

// One 8-weight group of the LOW-nibble half. r9 advances 8 quant bytes, r10
// advances 8 f32. ymm6/ymm7 must already hold this half's two broadcast factors.
fn j_f32_low_nb() -> i64 {
    j_f32_vpmovzxbd_y1_r9()
    j_f32_vpslld_y1_28()
    j_f32_vpsrld_y1_28()
    j_f32_vcvtdq2ps_y1()
    j_f32_vmulps_y1_y6()
    j_f32_vsubps_y1_y7()
    j_f32_vmulps_y1_r10()
    j_f32_vaddps_y0_y1()
    j_f32_add_r9_8()
    j_f_add_r10_32()
    return 0
}
// One 8-weight group of the HIGH-nibble half: the same quant bytes >>4.
fn j_f32_high_nb() -> i64 {
    j_f32_vpmovzxbd_y1_r9()
    j_f32_vpsrld_y1_4()
    j_f32_vcvtdq2ps_y1()
    j_f32_vmulps_y1_y6()
    j_f32_vsubps_y1_y7()
    j_f32_vmulps_y1_r10()
    j_f32_vaddps_y0_y1()
    j_f32_add_r9_8()
    j_f_add_r10_32()
    return 0
}
fn j_f32_low_fma() -> i64 {
    j_f32_vpmovzxbd_y1_r9()
    j_f32_vpslld_y1_28()
    j_f32_vpsrld_y1_28()
    j_f32_vcvtdq2ps_y1()
    j_f32_vfnmadd213_y1_y6_y7()
    j_f32_vfnmadd231_y0_y1_r10()
    j_f32_add_r9_8()
    j_f_add_r10_32()
    return 0
}
fn j_f32_high_fma() -> i64 {
    j_f32_vpmovzxbd_y1_r9()
    j_f32_vpsrld_y1_4()
    j_f32_vcvtdq2ps_y1()
    j_f32_vfnmadd213_y1_y6_y7()
    j_f32_vfnmadd231_y0_y1_r10()
    j_f32_add_r9_8()
    j_f_add_r10_32()
    return 0
}

// ---- Q4_K f32 factor prologue ----------------------------------------------
// The f64 prologue (j_f_fold_factors) widened d/dmin to f64 and the 6-bit
// fields to f64. Here everything stays f32: `vcvtph2ps` gives d and dmin as f32
// directly (f16's 11-bit significand is exact in f32, so no rounding at all),
// `vcvtdq2ps` converts four 6-bit fields at once, and the pair product is one
// `vmulps`. The final four `vinsertf128` duplicate each 4-lane vector into both
// halves so the per-chunk broadcast is a single lane-relative `vpermilps`.
//
// Header layout is unchanged: r9 points at the 128 quant bytes, so
//   [r9-16] = f16 d, [r9-14] = f16 dmin, [r9-12..-1] = the 12 packed bytes.
// The six-bit unpack is q4k_sc/q4k_min as in lib/std/matmul_q4k.quanta.
fn j_f32_fold_factors() -> i64 {
    femit("c4c1796e51f0", 6)       // vmovd xmm2, [r9-16]        d, dmin
    femit("c4e27913d2", 5)         // vcvtph2ps xmm2, xmm2       [d,dmin,0,0] f32
    femit("c4637904c200", 6)       // vpermilps xmm8, xmm2, 0x00 broadcast d
    femit("c4637904ca55", 6)       // vpermilps xmm9, xmm2, 0x55 broadcast dmin
    femit("c4c2793161f4", 6)       // vpmovzxbd xmm4, [r9-12]    a = sc0..3
    femit("c4c2793169f8", 6)       // vpmovzxbd xmm5, [r9-8]     b = sc4..7
    femit("c4c2793171fc", 6)       // vpmovzxbd xmm10,[r9-4]     c = sc8..11
    // scales[0..3] = a & 63
    femit("c5d572f31a", 5)         // vpslld xmm11, xmm4, 26
    femit("c5d572d31a", 5)         // vpsrld xmm11, xmm11, 26
    femit("c5785be7", 4)           // vcvtdq2ps xmm12, xmm11
    femit("c4411859e0", 5)         // vmulps xmm12, xmm12, xmm8  d*sc[0..3]
    // mins[0..3] = b & 63
    femit("c5d572f51a", 5)         // vpslld xmm11, xmm5, 26
    femit("c5d572d31a", 5)         // vpsrld xmm11, xmm11, 26
    femit("c5785bf7", 4)           // vcvtdq2ps xmm14, xmm11
    femit("c4410859f1", 5)         // vmulps xmm14, xmm14, xmm9  dmin*mn[0..3]
    // scales[4..7] = (c & 15) | ((a >> 6) << 4)
    femit("c5d572d306", 5)         // vpsrld xmm11, xmm4, 6
    femit("c5d572f304", 5)         // vpslld xmm11, xmm11, 4
    femit("c5e172f41c", 5)         // vpslld xmm3, xmm10, 28
    femit("c5e172d41c", 5)         // vpsrld xmm3, xmm3, 28
    femit("c5d5ebdb", 4)           // vpor xmm11, xmm11, xmm3
    femit("c5785bef", 4)           // vcvtdq2ps xmm13, xmm11
    femit("c4411859e8", 5)         // vmulps xmm13, xmm13, xmm8  d*sc[4..7]
    // mins[4..7] = (c >> 4) | ((b >> 6) << 4)
    femit("c5d572d506", 5)         // vpsrld xmm11, xmm5, 6
    femit("c5d572f304", 5)         // vpslld xmm11, xmm11, 4
    femit("c5d172d604", 5)         // vpsrld xmm5, xmm10, 4
    femit("c5d5ebe9", 4)           // vpor xmm11, xmm11, xmm5
    femit("c5785bff", 4)           // vcvtdq2ps xmm15, xmm11
    femit("c4410859f9", 5)         // vmulps xmm15, xmm15, xmm9  dmin*mn[4..7]
    // duplicate both halves so one lane-relative vpermilps broadcasts a factor
    femit("c4431d18e401", 6)       // vinsertf128 ymm12, ymm12, xmm12, 1
    femit("c4431518ed01", 6)       // vinsertf128 ymm13, ymm13, xmm13, 1
    femit("c4430d18f601", 6)       // vinsertf128 ymm14, ymm14, xmm14, 1
    femit("c4430518ff01", 6)       // vinsertf128 ymm15, ymm15, xmm15, 1
    return 0
}

// Broadcast factor lane k (k = 2c for a chunk's low half, 2c+1 for its high).
// k 0..3 live in ymm12 (scales) / ymm14 (mins), k 4..7 in ymm13 / ymm15; the
// duplicated halves make `vpermilps ymm6, src, (k%4)*0x55` an 8-lane broadcast.
fn j_f32_bc6_lo(c) -> i64 {
    if c == 0 { return femit("c4c37d04f400", 6) }
    if c == 1 { return femit("c4c37d04f4aa", 6) }
    if c == 2 { return femit("c4c37d04f500", 6) }
    return femit("c4c37d04f5aa", 6)
}
fn j_f32_bc6_hi(c) -> i64 {
    if c == 0 { return femit("c4c37d04f455", 6) }
    if c == 1 { return femit("c4c37d04f4ff", 6) }
    if c == 2 { return femit("c4c37d04f555", 6) }
    return femit("c4c37d04f5ff", 6)
}
fn j_f32_bc7_lo(c) -> i64 {
    if c == 0 { return femit("c4c37d04fe00", 6) }
    if c == 1 { return femit("c4c37d04feaa", 6) }
    if c == 2 { return femit("c4c37d04ff00", 6) }
    return femit("c4c37d04ffaa", 6)
}
fn j_f32_bc7_hi(c) -> i64 {
    if c == 0 { return femit("c4c37d04fe55", 6) }
    if c == 1 { return femit("c4c37d04feff", 6) }
    if c == 2 { return femit("c4c37d04ff55", 6) }
    return femit("c4c37d04ffff", 6)
}

// Whole Q4_K f32 kernel. `fma` selects the fused fold; a SEPARATE region is
// allocated for each so neither the f64 kernels nor each other's bytes move.
// Cadence, and it is the f64 cadence with 8-weight steps instead of 4:
//   4 chunks; chunk c covers weights [64c,64c+64): its low 32 use scale pair 2c
//   (4 groups of 8 bytes), then r9 rewinds 32 bytes and its high 32 use pair
//   2c+1. r10 walks x forward throughout, so lanes accumulate elements
//   k, k+8, k+16, ... in ascending order and the reduce order above applies.
fn jit_f_build_folded_f32(fma) -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_skip_header()          // r9 -> the quant bytes; header now at r9-16
    j_f_load_x()
    j_f_load_n()
    j_f32_vxorps_y0()

    let bodytop = ja_pos()

    j_f32_fold_factors()

    let chunk = 0
    while chunk < 4 {
        j_f32_bc6_lo(chunk)
        j_f32_bc7_lo(chunk)
        let b = 0
        while b < 4 {
            if fma != 0 { j_f32_low_fma() } else { j_f32_low_nb() }
            b = b + 1
        }
        j_f_rewind_r9_32()     // re-read the same 32 quant bytes
        j_f32_bc6_hi(chunk)
        j_f32_bc7_hi(chunk)
        b = 0
        while b < 4 {
            if fma != 0 { j_f32_high_fma() } else { j_f32_high_nb() }
            b = b + 1
        }
        chunk = chunk + 1
    }
    j_f_skip_header()          // 128 quant bytes + 16 header = 144 stride

    jbytes(4, "4883e901")      // sub rcx, 1
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    j_f32_reduce()
    j_f_ret()
    return entry
}

// ============================================================================
// FOLDED Q6_K f32 KERNEL -- the twin of jit_f_build_folded_q6k
// ============================================================================
// The Q6_K block is 210 bytes: ql[128] at +0, qh[64] at +128, sc[16] i8 at
// +192, f16 d at +208. Section offsets are the f64 kernel's, with 8-element
// groups instead of 4 (so g*8, and two groups per 16-element half):
//    ql offset : n*64 + (s%2)*32 + h*16 + g*8     (max 120 -> disp8)
//    qh offset : 128 + n*32 + h*16 + g*8          (min 128  -> disp32)
// Consuming n(0,1) -> s(0..3) -> h(0,1) -> g(0,1) walks destination element
// index n*128+s*32+h*16+g*8+k in ASCENDING order, so lane k accumulates
// elements k, k+8, ... and the shared reduce order applies unchanged.
// d: `movzx eax,word [r9+208]` reads exactly the 2 bytes the format promises.
// sc: vpbroadcastb + vpmovsxbd + vcvtdq2ps + vbroadcastss -- four instructions
// to an 8-lane f32 scale, against the f64 path's four to a 4-lane f64 one.
fn j_f32_ld_ql(d) -> i64 {
    jbytes(5, "c4c27d3131")        // vpmovzxbd ymm6, qword [r9+disp8]
    jb(d)
    return 0
}
fn j_f32_ld_qh(d) -> i64 {
    jbytes(5, "c4c27d31b9")        // vpmovzxbd ymm7, qword [r9+disp32]
    ji32(d)
    return 0
}
fn j_f32_qh_shr(sh) -> i64 {
    jbytes(4, "c5c572d7")          // vpsrld ymm7, ymm7, sh
    jb(sh)
    return 0
}
fn j_f32_d_load() -> i64 {
    jbytes(8, "410fb781d0000000")  // movzx eax, word ptr [r9+208]
    jbytes(4, "c5f96ec8")          // vmovd xmm1, eax
    jbytes(5, "c4e27913c9")        // vcvtph2ps xmm1, xmm1   (f16 -> f32, exact)
    jbytes(5, "c4e27d18c9")        // vbroadcastss ymm1, xmm1 (8 lanes of d)
    return 0
}
fn j_f32_q6_consts() -> i64 {
    jbytes(4, "c5e576db")          // vpcmpeqd ymm3, ymm3, ymm3
    jbytes(5, "c5e572f305")        // vpslld ymm3, ymm3, 5    -> 8 x -32
    jbytes(4, "c5dd76e4")          // vpcmpeqd ymm4, ymm4, ymm4
    jbytes(5, "c5dd72d41c")        // vpsrld ymm4, ymm4, 28   -> 8 x 15
    jbytes(4, "c5d576ed")          // vpcmpeqd ymm5, ymm5, ymm5
    jbytes(5, "c5d572d51e")        // vpsrld ymm5, ymm5, 30   -> 8 x 3
    return 0
}
fn j_f32_sc_load(d) -> i64 {
    jbytes(5, "c4c2797891")        // vpbroadcastb xmm2, byte [r9+disp32]
    ji32(d)
    return 0
}
fn j_f32_sc_sext() -> i64 { return jbytes(5, "c4e27921d2") }     // vpmovsxbd xmm2, xmm2
fn j_f32_sc_cvt()  -> i64 { return jbytes(4, "c5f85bd2") }       // vcvtdq2ps xmm2, xmm2
fn j_f32_sc_bc()   -> i64 { return jbytes(5, "c4e27d18d2") }     // vbroadcastss ymm2, xmm2

// One 8-element group -> one 8-lane f32 contribution into ymm0.
// ymm1 = broadcast d, ymm2 = broadcast sc, ymm3/4/5 = -32 / 15 / 3.
fn j_f32_q6_group(s, qlo, qho) -> i64 {
    j_f32_ld_ql(qlo)
    if s >= 2 { jbytes(5, "c5cd72d604") }        // vpsrld ymm6, ymm6, 4
    else { jbytes(4, "c5cddbf4") }               // vpand ymm6, ymm6, ymm4
    j_f32_ld_qh(qho)
    if s > 0 { j_f32_qh_shr(s * 2) }
    jbytes(4, "c5c5dbfd")                        // vpand ymm7, ymm7, ymm5
    jbytes(5, "c5c572f704")                      // vpslld ymm7, ymm7, 4
    jbytes(4, "c5cdebf7")                        // vpor ymm6, ymm6, ymm7
    jbytes(4, "c5cdfef3")                        // vpaddd ymm6, ymm6, ymm3  (-32)
    jbytes(4, "c5fc5bf6")                        // vcvtdq2ps ymm6, ymm6
    jbytes(4, "c5cc59f2")                        // vmulps ymm6, ymm6, ymm2  (*sc)
    jbytes(4, "c5cc59f1")                        // vmulps ymm6, ymm6, ymm1  (*d)
    jbytes(5, "c4c14c5932")                      // vmulps ymm6, ymm6, [r10] (*x)
    jbytes(4, "c5fc58c6")                        // vaddps ymm0, ymm0, ymm6
    j_f_add_r10_32()
    return 0
}
// The FMA fold: the *sc and *d multiplies stay separate -- *d is where the
// reference rounds -- and only the accumulate fuses, exactly as in the f64 FMA
// twin. vfmadd231ps ymm0, ymm6, [r10] = ymm6*[r10] + ymm0.
fn j_f32_q6_group_fma(s, qlo, qho) -> i64 {
    j_f32_ld_ql(qlo)
    if s >= 2 { jbytes(5, "c5cd72d604") }
    else { jbytes(4, "c5cddbf4") }
    j_f32_ld_qh(qho)
    if s > 0 { j_f32_qh_shr(s * 2) }
    jbytes(4, "c5c5dbfd")
    jbytes(5, "c5c572f704")
    jbytes(4, "c5cdebf7")
    jbytes(4, "c5cdfef3")
    jbytes(4, "c5fc5bf6")
    jbytes(4, "c5cc59f2")
    jbytes(4, "c5cc59f1")
    jbytes(5, "c4c24db802")                      // vfmadd231ps ymm0, ymm6, [r10]
    j_f_add_r10_32()
    return 0
}

fn jit_f_build_folded_q6k_f32(fma) -> i64 {
    let entry = ja_pos()
    j_f_load_w()
    j_f_load_x()
    j_f_load_n()
    j_f32_vxorps_y0()

    let bodytop = ja_pos()

    j_f32_d_load()
    j_f32_q6_consts()

    let n = 0
    while n < 2 {
        let s = 0
        while s < 4 {
            let h = 0
            while h < 2 {
                j_f32_sc_load(192 + n * 8 + s * 2 + h)
                j_f32_sc_sext()
                j_f32_sc_cvt()
                j_f32_sc_bc()
                let g = 0
                while g < 2 {
                    if fma != 0 {
                        j_f32_q6_group_fma(s, n * 64 + (s - (s / 2) * 2) * 32 + h * 16 + g * 8, 128 + n * 32 + h * 16 + g * 8)
                    } else {
                        j_f32_q6_group(s, n * 64 + (s - (s / 2) * 2) * 32 + h * 16 + g * 8, 128 + n * 32 + h * 16 + g * 8)
                    }
                    g = g + 1
                }
                h = h + 1
            }
            s = s + 1
        }
        n = n + 1
    }
    jbytes(7, "4981c1d2000000")    // add r9, 210

    jbytes(4, "4883e901")          // sub rcx, 1
    j_jne32()
    let disp_at = ja_pos()
    jbytes(4, "00000000")
    if j_patch32(disp_at, bodytop) != 0 { return 0 - 1 }

    j_f32_reduce()
    j_f_ret()
    return entry
}

// ---- the f32 kernels' own RWX regions and tables ---------------------------
// Own regions again, so neither the f64 kernels nor the FMA kernels move. Same
// argument area ([W, X, DMD, nsuper]) but [AS+8] must point at the f32 x
// supplied by the grow-only buffer in gguf_mm.quanta, NOT at the f64 x.
let jf_tbl_f32 = 0
let jf_tbl_f32_fma = 0
let jf_tbl_f32_q6k = 0
let jf_tbl_f32_q6k_fma = 0

fn jit_f_setup_folded_f32() -> i64 {
    if jf_tbl_f32 != 0 { return 0 }
    if jit_f_alloc(65536) <= 0 { return -1 }
    let t = jit_f_code(jit_f_build_folded_f32(0))
    if t <= 0 { return -2 }
    jf_tbl_f32 = t
    return 0
}
fn jit_f_ready_folded_f32() { return jf_tbl_f32 }
fn jit_f_apply_folded_f32(as) -> i64 { return closure_call(jf_tbl_f32, as, 0) }

