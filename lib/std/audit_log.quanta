    return 0
}

// ============================================================================
// Signed Checkpoints (for Trillian compatibility)
// ============================================================================

// Checkpoint structure
let CP_OFF_VERSION = 0
let CP_OFF_TREE_SIZE = 4
let CP_OFF_TIMESTAMP = 12
let CP_OFF_ROOT_HASH = 20
let CP_OFF_SIGNATURE = 52
let CP_OFF_METADATA = 116
let CP_STRUCT_SIZE = 116 + 64 // metadata + signature

// Sign checkpoint
fn log_sign_checkpoint(checkpoint, privkey) {
    let sig = checkpoint + CP_OFF_SIGNATURE
    ml_dsa_65_sign(privkey, checkpoint, CP_OFF_SIGNATURE, 0, 0, sig)
    return 0
}

// Verify checkpoint
fn log_verify_checkpoint(checkpoint, pubkey) {
    let sig = checkpoint + CP_OFF_SIGNATURE
    return ml_dsa_65_verify(pubkey, checkpoint, CP_OFF_SIGNATURE, 0, 0, sig, 64)
}

// ============================================================================
// Sigstore / Cosign Integration
// ============================================================================

// Sigstore bundle (simplified)
let BUNDLE_OFF_VERSION = 0
let BUNDLE_OFF_MEDIA_TYPE = 4
let BUNDLE_OFF_CONTENT = 12
let BUNDLE_OFF_CONTENT_LEN = 20
let BUNDLE_OFF_SIGNATURES = 28
let BUNDLE_OFF_SIG_COUNT = 36
let BUNDLE_OFF_CERTIFICATES = 44
let BUNDLE_OFF_CERT_COUNT = 52
let BUNDLE_OFF_TRANSPARENCY = 60
let BUNDLE_OFF_LOG_INDEX = 68

// Create sigstore bundle
fn sigstore_create_bundle(payload, payload_len, media_type, signer_privkey, signer_cert, cert_len, transparency_log, log_index, bundle_out) {
    // Media type
    w32(bundle_out + BUNDLE_OFF_VERSION, 1)
    
    let mt_len = 0
    while mt_len < 256 && mem_load8(media_type + mt_len) != 0 { mt_len = mt_len + 1 }
    w32(bundle_out + BUNDLE_OFF_MEDIA_TYPE, mt_len)
    let i = 0
    while i < mt_len {
        mem_store8(bundle_out + BUNDLE_OFF_MEDIA_TYPE + 4 + i, mem_load8(media_type + i))
        i = i + 1
    }
    
    // Content
    w64(bundle_out + BUNDLE_OFF_CONTENT, payload)
    w64(bundle_out + BUNDLE_OFF_CONTENT_LEN, payload_len)
    
    // Signatures
    let sig = mem_alloc(64)
    ml_dsa_65_sign(signer_privkey, payload, payload_len, 0, 0, sig)
    w64(bundle_out + BUNDLE_OFF_SIGNATURES, sig)
    w64(bundle_out + BUNDLE_OFF_SIG_COUNT, 1)
    
    // Certificates
    w64(bundle_out + BUNDLE_OFF_CERTIFICATES, signer_cert)
    w64(bundle_out + BUNDLE_OFF_CERT_COUNT, 1)
    
    // Transparency
    w64(bundle_out + BUNDLE_OFF_TRANSPARENCY, transparency_log)
    w64(bundle_out + BUNDLE_OFF_LOG_INDEX, log_index)
    
    mem_free(sig)
    return 0
}

