// ============================================================================
// In-toto / SLSA Provenance
// ============================================================================

// Provenance statement (SLSA)
let PROV_OFF_BUILD_TYPE = 0
let PROV_OFF_BUILDER_ID = 8
let PROV_OFF_BUILD_CONFIG = 16
let PROV_OFF_METADATA = 24
let PROV_OFF_MATERIALS = 32
let PROV_OFF_MATERIALS_COUNT = 40
let PROV_STRUCT_SIZE = 48

// Material (input artifact)
let MAT_OFF_URI = 0
let MAT_OFF_DIGEST = 8
let MAT_OFF_DIGEST_LEN = 16
let MAT_STRUCT_SIZE = 24

// Create provenance
fn provenance_create(build_type, builder_id, build_config, materials, materials_count, provenance_out) {
    w64(provenance_out + PROV_OFF_BUILD_TYPE, build_type)
    w64(provenance_out + PROV_OFF_BUILDER_ID, builder_id)
    w64(provenance_out + PROV_OFF_BUILD_CONFIG, build_config)
    w64(provenance_out + PROV_OFF_METADATA, 0) // Timestamp, etc.
    w64(provenance_out + PROV_OFF_MATERIALS, materials)
    w64(provenance_out + PROV_OFF_MATERIALS_COUNT, materials_count)
    return 0
}

// Sign provenance
fn provenance_sign(provenance, privkey, sig_out) {
    ml_dsa_65_sign(privkey, provenance, PROV_STRUCT_SIZE, 0, 0, sig_out)
    return 0
}

// Verify provenance
fn provenance_verify(provenance, pubkey, sig) {
    return ml_dsa_65_verify(pubkey, provenance, PROV_STRUCT_SIZE, 0, 0, sig, 64)
}

// ============================================================================
// SBOM (SPDX / CycloneDX)
// ============================================================================

// SPDX document
let SPDX_OFF_VERSION = 0
let SPDX_OFF_NAME = 4
let SPDX_OFF_NAME_LEN = 12
let SPDX_OFF_CREATORS = 20
let SPDX_OFF_PACKAGES = 28
let SPDX_OFF_PACKAGE_COUNT = 36
let SPDX_OFF_RELATIONSHIPS = 44
let SPDX_OFF_REL_COUNT = 52
let SPDX_STRUCT_SIZE = 60

// Package
let PKG_OFF_NAME = 0
let PKG_OFF_NAME_LEN = 8
let PKG_OFF_VERSION = 16
let PKG_OFF_VERSION_LEN = 24
let PKG_OFF_SUPPLIER = 32
let PKG_OFF_DOWNLOAD = 40
let PKG_OFF_CHECKSUMS = 48
let PKG_OFF_LICENSE = 56
let PKG_OFF_LICENSE_LEN = 64
let PKG_STRUCT_SIZE = 72

// Create SPDX
fn spdx_create(name, name_len, version, version_len, spdx_out) {
    w32(spdx_out + SPDX_OFF_VERSION, 2) // SPDX-2.3
    w64(spdx_out + SPDX_OFF_NAME, name)
    w64(spdx_out + SPDX_OFF_NAME_LEN, name_len)
    w64(spdx_out + SPDX_OFF_VERSION + 4, version)
    w64(spdx_out + SPDX_OFF_VERSION_LEN + 4, version_len)
    w64(spdx_out + SPDX_OFF_PACKAGES, 0)
    w64(spdx_out + SPDX_OFF_PACKAGE_COUNT, 0)
    return 0
}

// Add package to SPDX
fn spdx_add_package(spdx, pkg_name, pkg_name_len, pkg_version, pkg_version_len, supplier, download, checksums, license, license_len) {
    let count = r64(spdx + SPDX_OFF_PACKAGE_COUNT)
    let pkgs = r64(spdx + SPDX_OFF_PACKAGES)
    
    // Expand array if needed
    // Simplified
    let pkg = mem_alloc(PKG_STRUCT_SIZE)
    if pkg == 0 { return -1 }
    
    w64(pkg + PKG_OFF_NAME, pkg_name)
    w64(pkg + PKG_OFF_NAME_LEN, pkg_name_len)
    w64(pkg + PKG_OFF_VERSION, pkg_version)
    w64(pkg + PKG_OFF_VERSION_LEN, pkg_version_len)
    w64(pkg + PKG_OFF_SUPPLIER, supplier)
    w64(pkg + PKG_OFF_DOWNLOAD, download)
    w64(pkg + PKG_OFF_CHECKSUMS, checksums)
    w64(pkg + PKG_OFF_LICENSE, license)
    w64(pkg + PKG_OFF_LICENSE_LEN, license_len)
    
    return 0
}

// CycloneDX BOM
let CDX_OFF_VERSION = 0
let CDX_OFF_BOM_REF = 4
let CDX_OFF_METADATA = 12
let CDX_OFF_COMPONENTS = 20
let CDX_OFF_COMP_COUNT = 28
let CDX_OFF_SERVICES = 36
let CDX_OFF_DEPENDENCIES = 44
let CDX_STRUCT_SIZE = 52

fn cyclonedx_create(bom_ref, version, metadata, components, comp_count, cdx_out) {
    w32(cdx_out + CDX_OFF_VERSION, 1) // CycloneDX 1.5
    w64(cdx_out + CDX_OFF_BOM_REF, bom_ref)
    w64(cdx_out + CDX_OFF_METADATA, metadata)
    w64(cdx_out + CDX_OFF_COMPONENTS, components)
    w64(cdx_out + CDX_OFF_COMP_COUNT, comp_count)
    return 0
}

// ============================================================================
// Reproducible Build Attestation
// ============================================================================

// Build attestation
let ATT_OFF_COMMAND = 0
let ATT_OFF_COMMAND_LEN = 8
let ATT_OFF_ENVIRONMENT = 16
let ATT_OFF_ENV_COUNT = 24
let ATT_OFF_INPUTS = 32
let ATT_OFF_INPUT_COUNT = 40
let ATT_OFF_OUTPUTS = 48
let ATT_OFF_OUTPUT_COUNT = 56
let ATT_OFF_TIMESTAMP = 64
let ATT_STRUCT_SIZE = 72

// Create build attestation
fn build_attestation_create(command, command_len, env, env_count, inputs, input_count, outputs, output_count, attestation_out) {
    w64(attestation_out + ATT_OFF_COMMAND, command)
    w64(attestation_out + ATT_OFF_COMMAND_LEN, command_len)
    w64(attestation_out + ATT_OFF_ENVIRONMENT, env)
    w64(attestation_out + ATT_OFF_ENV_COUNT, env_count)
    w64(attestation_out + ATT_OFF_INPUTS, inputs)
    w64(attestation_out + ATT_OFF_INPUT_COUNT, input_count)
    w64(attestation_out + ATT_OFF_OUTPUTS, outputs)
    w64(attestation_out + ATT_OFF_OUTPUT_COUNT, output_count)
    w64(attestation_out + ATT_OFF_TIMESTAMP, clock() / 1000000000)
    return 0
}

// Sign build attestation
fn build_attestation_sign(attestation, privkey, sig_out) {
    ml_dsa_65_sign(privkey, attestation, ATT_STRUCT_SIZE, 0, 0, sig_out)
    return 0
}

// ============================================================================
// Trillian-compatible Log Server
// ============================================================================

// Trillian log operations
let TRILLIAN_OP_ADD = 0
let TRILLIAN_OP_GET = 1
let TRILLIAN_OP_PROVE = 2
let TRILLIAN_OP_VERIFY = 3

// Log server context
let trillian_log = 0
let trillian_initialized = 0

fn trillian_init(pubkey, privkey) {
    return log_init(pubkey, privkey)
}

fn trillian_add_leaf(leaf_data, leaf_len) {
    let timestamp = clock() / 1000000000
    return log_add_entry(LOG_ENTRY_GENERAL, timestamp, leaf_data, leaf_len)
}

fn trillian_get_proof_by_hash(leaf_hash, tree_size, proof_out, proof_len_out) {
    // Find leaf index by hash
    let leaves_ptr = r64(log_ctx + LOG_OFF_LEAVES)
    let leaf_count = r64(log_ctx + LOG_OFF_LEAF_COUNT)
    
    let i = 0
    while i < leaf_count {
        let lh = leaves_ptr + i * 32
        if ct_memcmp(lh, leaf_hash, 32) == 0 {
            return log_inclusion_proof(i, tree_size, proof_out, proof_len_out)
        }
        i = i + 1
    }
    return -1
}

fn trillian_get_proof_by_index(index, tree_size, proof_out, proof_len_out) {
    return log_inclusion_proof(index, tree_size, proof_out, proof_len_out)
}

fn trillian_verify_inclusion(leaf_hash, index, tree_size, proof, proof_len) {
    let root = log_ctx + LOG_OFF_ROOT
    return log_verify_inclusion_proof(leaf_hash, index, tree_size, proof, proof_len, root)
}

fn trillian_get_tree_head(tree_head_out) {
    return log_get_tree_head(tree_head_out)
}

// ============================================================================
// Constants test
// ============================================================================

fn log_entry_x509(): i64 { return 0 }
fn log_entry_precert(): i64 { return 1 }
fn log_entry_general(): i64 { return 2 }

fn th_version(): i64 { return 1 }
fn th_struct_size(): i64 { return 116 }

fn bundle_version(): i64 { return 1 }

fn prov_struct_size(): i64 { return 48 }
fn mat_struct_size(): i64 { return 24 }

fn spdx_version(): i64 { return 2 }
fn spdx_struct_size(): i64 { return 60 }

fn cdx_version(): i64 { return 1 }
fn cdx_struct_size(): i64 { return 52 }

fn attest_struct_size(): i64 { return 72 }

fn trillian_op_add(): i64 { return 0 }
fn trillian_op_get(): i64 { return 1 }
fn trillian_op_prove(): i64 { return 2 }
fn trillian_op_verify(): i64 { return 3 }

fn main() {
    if log_entry_x509() != 0 { return 1 }
    if log_entry_precert() != 1 { return 2 }
    if log_entry_general() != 2 { return 3 }
    if th_version() != 1 { return 4 }
    if th_struct_size() != 116 { return 5 }
    if bundle_version() != 1 { return 6 }
    if prov_struct_size() != 48 { return 7 }
    if mat_struct_size() != 24 { return 8 }
    if spdx_version() != 2 { return 9 }
    if spdx_struct_size() != 60 { return 10 }
    if cdx_version() != 1 { return 11 }
    if cdx_struct_size() != 52 { return 12 }
    if attest_struct_size() != 72 { return 13 }
    if trillian_op_add() != 0 { return 14 }
    if trillian_op_get() != 1 { return 15 }
    if trillian_op_prove() != 2 { return 16 }
    if trillian_op_verify() != 3 { return 17 }
    return 0
}