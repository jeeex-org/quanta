    return 0
}

// Verify inclusion proof (Merkle audit path)
// leaf_hash: 32-byte SHA-256 hash of the leaf
// audit_path: array of 32-byte sibling hashes
// path_len: number of siblings
// root_hash: expected 32-byte root hash
// leaf_index: index of leaf in tree (0-based)
// tree_size: total number of leaves
// Returns 0 if proof valid, -1 otherwise
fn sct_verify_inclusion(leaf_hash, audit_path, path_len, root_hash, leaf_index, tree_size) {
    // Compute root from leaf and audit path
    let current_hash = mem_alloc(32)
    if current_hash == 0 { return -1 }
    
    let i = 0
    while i < 32 {
        mem_store8(current_hash + i, mem_load8(leaf_hash + i))
        i = i + 1
    }
    
    let idx = leaf_index
    let i = 0
    while i < path_len {
        let sibling = r64(audit_path + i * 8)
        let combined = mem_alloc(64)
        if combined == 0 {
            mem_free(current_hash)
            return -1
        }
        
        // Order: if idx is even, leaf is left; if odd, leaf is right
        if (idx & 1) == 0 {
            // leaf || sibling
            let j = 0
            while j < 32 {
                mem_store8(combined + j, mem_load8(current_hash + j))
                j = j + 1
            }
            j = 0
            while j < 32 {
                mem_store8(combined + 32 + j, mem_load8(sibling + j))
                j = j + 1
            }
        } else {
            // sibling || leaf
            let j = 0
            while j < 32 {
                mem_store8(combined + j, mem_load8(sibling + j))
                j = j + 1
            }
            j = 0
            while j < 32 {
                mem_store8(combined + 32 + j, mem_load8(current_hash + j))
                j = j + 1
            }
        }
        
        // Hash combined (would use SHA-256)
        // For now just copy first 32 bytes as placeholder
        let j = 0
        while j < 32 {
            mem_store8(current_hash + j, mem_load8(combined + j))
            j = j + 1
        }
        mem_free(combined)
        idx = idx >> 1
        i = i + 1
    }
    
    // Compare with root_hash
    let match = 1
    i = 0
    while i < 32 {
        if mem_load8(current_hash + i) != mem_load8(root_hash + i) {
            match = 0
            break
        }
        i = i + 1
    }
    
    mem_free(current_hash)
    if match == 1 { return 0 }
    return -1
}

