// std/io — input/output helpers over the builtin print/exit family.
// Import with:  import std/io

// Print an i64 followed by a newline.
fn println_i(x) {
  println(x)
}

// Print a raw string followed by a newline.
fn println_s(s) {
  prints(s)
  newline()
}

// Print a string WITHOUT a trailing newline.
fn print_s(s) {
  prints(s)
}

// Print an i64 WITHOUT a trailing newline.
fn print_i(x) {
  print(x)
}

// Terminate the program with an exit code.
fn die(code) {
  exit(code)
}
