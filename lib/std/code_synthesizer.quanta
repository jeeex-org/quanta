// std/code_synthesizer.quanta - Phase 2: Code Synthesis
// Generates Quanta module files from gap_specs.json

module std_code_synthesizer;

import std/str
import std/vec
import std/map
import std/fs

const SYNTH_CAP = 10000;

// Pattern registry
let pattern_names = mmap(1024 * 8);
let pattern_types = mmap(1024 * 8);
let pattern_count = 0;

fn sanitize_ident(name) {
    let len_n = len(name);
    let out = mmap(len_n + 1);
    let i = 0;
    while i < len_n {
        let c = mem_load8(name + 8 + i);
        if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
            mem_store8(out + i, c);
        } else {
            mem_store8(out + i, 95);
        }
        i = i + 1;
    }
    mem_store8(out + len_n, 0);
    return out;
}

fn register_pattern(name, ty) -> i64 {
    if pattern_count >= 1024 { return 0; }
    let name_copy = mem_alloc(len(name) + 9);
    mem_store(name_copy, len(name));
    let i = 0;
    while i < len(name) {
        mem_store8(name_copy + 8 + i, mem_load8(name + 8 + i));
        i = i + 1;
    }
    mem_store(pattern_names + pattern_count * 8, name_copy);
    mem_store(pattern_types + pattern_count * 8, ty);
    pattern_count = pattern_count + 1;
    return 1;
}

fn init_pattern_library() -> i64 {
    register_pattern("accounting_gaap", 1);
    register_pattern("accounting_ifrs", 1);
    register_pattern("accounting_tax", 2);
    register_pattern("chain_tx", 1);
    register_pattern("chain_block", 1);
    register_pattern("quantum_qft", 2);
    register_pattern("ai_rope", 2);
    register_pattern("math_linalg", 2);
    register_pattern("crypto_aes_gcm", 2);
    return pattern_count;
}

fn emit_quanta_module(domain, category, module) -> i64 {
    let clean_domain = sanitize_ident(domain);
    let clean_category = sanitize_ident(category);
    let clean_module = sanitize_ident(module);

    let out_path = mmap(512);
    let base = "lib/std/";
    let i = 0;
    while i < len(base) { mem_store8(out_path + i, mem_load8(base + 8 + i)); i = i + 1; }
    let j = 0;
    while j < len(clean_domain) { mem_store8(out_path + i + j, mem_load8(clean_domain + 8 + j)); j = j + 1; }
    i = i + j;
    mem_store8(out_path + i, 95); i = i + 1;
    j = 0;
    while j < len(clean_category) { mem_store8(out_path + i + j, mem_load8(clean_category + 8 + j)); j = j + 1; }
    i = i + j;
    mem_store8(out_path + i, 95); i = i + 1;
    j = 0;
    while j < len(clean_module) { mem_store8(out_path + i + j, mem_load8(clean_module + 8 + j)); j = j + 1; }
    i = i + j;
    let ext = ".quanta";
    j = 0;
    while j < len(ext) { mem_store8(out_path + i + j, mem_load8(ext + 8 + j)); j = j + 1; }
    i = i + j;
    mem_store8(out_path + i, 0);

    let fd = file_open(out_path, 577);
    if fd < 0 { return 0; }

    file_write(fd, "module std_", len("module std_"));
    file_write(fd, clean_domain, len(clean_domain));
    file_write(fd, "_", 1);
    file_write(fd, clean_category, len(clean_category));
    file_write(fd, "_", 1);
    file_write(fd, clean_module, len(clean_module));
    file_write(fd, ";\n\n", 2);
    file_write(fd, "import std/types;\n\n", len("import std/types;\n\n"));
    file_write(fd, "fn init() -> i64 { return 0; }\n\n", len("fn init() -> i64 { return 0; }\n\n"));
    file_write(fd, "fn main() -> i64 { return init(); }\n", len("fn main() -> i64 { return init(); }\n"));
    file_close(fd);
    return 1;
}

// Simple JSON parser: extract all "domain", "category", "module" triplets
// by scanning for the key names and extracting the following quoted value
fn synthesize_all(specs_path) -> i64 {
    let pat_count = init_pattern_library();
    prints("Pattern library initialized: "); printi(pat_count); prints(" patterns\n");

    let fd = file_open(specs_path, 0);
    if fd < 0 { return 0; }
    let buf = mmap(2097152);
    let n = file_read(fd, buf + 8, 16777216);
    file_close(fd);
    if n <= 0 { return 0; }
    mem_store(buf, n);

    let i = 0;
    let generated = 0;
    
    while i < n {
        // Scan for "domain" key
        let found = 0;
        while i < n - 10 {
            if mem_load8(buf + 8 + i) == 34 && 
               mem_load8(buf + 8 + i + 1) == 100 &&  // d
               mem_load8(buf + 8 + i + 2) == 111 &&  // o
               mem_load8(buf + 8 + i + 3) == 109 &&  // m
               mem_load8(buf + 8 + i + 4) == 97 &&   // a
               mem_load8(buf + 8 + i + 5) == 105 &&  // i
               mem_load8(buf + 8 + i + 6) == 110 &&  // n
               mem_load8(buf + 8 + i + 7) == 34 {    // "
                found = 1;
                i = i + 8;
                break;
            }
            i = i + 1;
        }
        if found == 0 { break; }
        
        // Skip to value
        while i < n && mem_load8(buf + 8 + i) != 34 { i = i + 1; }
        if i >= n { break; }
        i = i + 1;
        let domain_start = i;
        while i < n && mem_load8(buf + 8 + i) != 34 { i = i + 1; }
        let domain_len = i - domain_start;
        
        // Now look for "category" key
        found = 0;
        while i < n - 12 {
            if mem_load8(buf + 8 + i) == 34 && 
               mem_load8(buf + 8 + i + 1) == 99 &&   // c
               mem_load8(buf + 8 + i + 2) == 97 &&   // a
               mem_load8(buf + 8 + i + 3) == 116 &&  // t
               mem_load8(buf + 8 + i + 4) == 101 &&  // e
               mem_load8(buf + 8 + i + 5) == 103 &&  // g
               mem_load8(buf + 8 + i + 6) == 111 &&  // o
               mem_load8(buf + 8 + i + 7) == 114 &&  // r
               mem_load8(buf + 8 + i + 8) == 121 &&  // y
               mem_load8(buf + 8 + i + 9) == 34 {    // "
                found = 1;
                i = i + 10;
                break;
            }
            i = i + 1;
        }
        if found == 0 { break; }
        
        // Skip to value
        while i < n && mem_load8(buf + 8 + i) != 34 { i = i + 1; }
        if i >= n { break; }
        i = i + 1;
        let cat_start = i;
        while i < n && mem_load8(buf + 8 + i) != 34 { i = i + 1; }
        let cat_len = i - cat_start;
        
        // Now look for "module" key
        found = 0;
        while i < n - 10 {
            if mem_load8(buf + 8 + i) == 34 && 
               mem_load8(buf + 8 + i + 1) == 109 &&  // m
               mem_load8(buf + 8 + i + 2) == 111 &&  // o
               mem_load8(buf + 8 + i + 3) == 100 &&  // d
               mem_load8(buf + 8 + i + 4) == 117 &&  // u
               mem_load8(buf + 8 + i + 5) == 108 &&  // l
               mem_load8(buf + 8 + i + 6) == 101 &&  // e
               mem_load8(buf + 8 + i + 7) == 34 {    // "
                found = 1;
                i = i + 8;
                break;
            }
            i = i + 1;
        }
        if found == 0 { break; }
        
        // Skip to value
        while i < n && mem_load8(buf + 8 + i) != 34 { i = i + 1; }
        if i >= n { break; }
        i = i + 1;
        let mod_start = i;
        while i < n && mem_load8(buf + 8 + i) != 34 { i = i + 1; }
        let mod_len = i - mod_start;
        
        // Create Quanta strings for domain, category, module
        let domain_str = mmap(domain_len + 9);
        mem_store(domain_str, domain_len);
        let di = 0;
        while di < domain_len { mem_store8(domain_str + 8 + di, mem_load8(buf + 8 + domain_start + di)); di = di + 1; }
        mem_store8(domain_str + 8 + domain_len, 0);
        
        let cat_str = mmap(cat_len + 9);
        mem_store(cat_str, cat_len);
        let ci = 0;
        while ci < cat_len { mem_store8(cat_str + 8 + ci, mem_load8(buf + 8 + cat_start + ci)); ci = ci + 1; }
        mem_store8(cat_str + 8 + cat_len, 0);
        
        let mod_str = mmap(mod_len + 9);
        mem_store(mod_str, mod_len);
        let mi = 0;
        while mi < mod_len { mem_store8(mod_str + 8 + mi, mem_load8(buf + 8 + mod_start + mi)); mi = mi + 1; }
        mem_store8(mod_str + 8 + mod_len, 0);
        
        let result = emit_quanta_module(domain_str, cat_str, mod_str);
        if result != 0 { generated = generated + 1; }
    }
    
    return generated;
}

fn init() -> i64 { return 0; }

fn main() -> i64 {
    prints("Code synthesizer running...\n");
    let count = synthesize_all("gap_specs.json");
    prints("Generated modules: "); printi(count); prints("\n");
    return 0;
}
