// ===========================================================================
// Phase 6.1: Per-context safetensors API (appended to safetensors.quanta)
// ===========================================================================

// ---- StCtx layout (mem_alloc'd buffer) ----
// All offsets in bytes from context base
const SCTX_FD         = 0
const SCTX_ROOT       = 8
const SCTX_DATA_BASE  = 16
const SCTX_FILESIZE   = 24
const SCTX_NTENSORS   = 32
const SCTX_TEST_HLEN  = 40
const SCTX_SIZE       = 48

fn st_ctx_alloc() -> u64 {
    return mem_alloc(SCTX_SIZE)
}

fn st_ctx_free(ctx: u64) {
    if ctx == 0 { return }
    let fd = mem_load(ctx + SCTX_FD)
    if fd >= 0 { close(fd) }
    // Note: we don't free the JSON parse tree here
}

fn st_ctx_fd(ctx: u64) -> i64 {
    return mem_load(ctx + SCTX_FD)
}

fn st_ctx_set_fd(ctx: u64, fd: i64) {
    mem_store(ctx + SCTX_FD, fd)
}

fn st_ctx_root(ctx: u64) -> u64 {
    return mem_load(ctx + SCTX_ROOT)
}

fn st_ctx_set_root(ctx: u64, root: u64) {
    mem_store(ctx + SCTX_ROOT, root)
}

fn st_ctx_data_base(ctx: u64) -> i64 {
    return mem_load(ctx + SCTX_DATA_BASE)
}

fn st_ctx_set_data_base(ctx: u64, off: i64) {
    mem_store(ctx + SCTX_DATA_BASE, off)
}

fn st_ctx_filesize(ctx: u64) -> i64 {
    return mem_load(ctx + SCTX_FILESIZE)
}

fn st_ctx_set_filesize(ctx: u64, sz: i64) {
    mem_store(ctx + SCTX_FILESIZE, sz)
}

fn st_ctx_ntensors(ctx: u64) -> i64 {
    return mem_load(ctx + SCTX_NTENSORS)
}

fn st_ctx_set_ntensors(ctx: u64, n: i64) {
    mem_store(ctx + SCTX_NTENSORS, n)
}

fn st_ctx_test_hlen(ctx: u64) -> i64 {
    return mem_load(ctx + SCTX_TEST_HLEN)
}

fn st_ctx_set_test_hlen(ctx: u64, hlen: i64) {
    mem_store(ctx + SCTX_TEST_HLEN, hlen)
}

fn st_open_ctx(path: u64, ctx: u64) -> i64 {
    let fd = open(path, 0, 0)
    if fd < 0 { return -1 }
    st_ctx_set_fd(ctx, fd)
    st_ctx_set_filesize(ctx, file_size(fd))
    let fsz = st_ctx_filesize(ctx)
    if fsz < 16 { close(fd); st_ctx_set_fd(ctx, -1); return -2 }

    let lb = mem_alloc(8)
    if read_raw(fd, lb, 8) != 8 { close(fd); st_ctx_set_fd(ctx, -1); return -2 }
    let hlen = mem_load(lb)
    if hlen <= 0 || hlen > ST_MAGIC_MAX { close(fd); st_ctx_set_fd(ctx, -1); return -3 }
    if hlen > fsz - 8 { close(fd); st_ctx_set_fd(ctx, -1); return -3 }

    let buf = mem_alloc(hlen + 8 + 1)
    if lseek(fd, 8, 0) < 0 { close(fd); st_ctx_set_fd(ctx, -1); return -4 }
    let got = read_raw(fd, buf + 8, hlen)
    if got != hlen { close(fd); st_ctx_set_fd(ctx, -1); return -4 }
    mem_store8(buf + 8 + hlen, 0)
    mem_store(buf, hlen)
    st_ctx_set_test_hlen(ctx, hlen)

    let parsed = json_parse(buf)
    if parsed < 0 { close(fd); st_ctx_set_fd(ctx, -1); return -5 }
    if json_get_type(parsed) != 5 { close(fd); st_ctx_set_fd(ctx, -1); return -5 }
    let root = json_get_object(parsed)
    st_ctx_set_root(ctx, root)
    st_ctx_set_data_base(ctx, 8 + hlen)

    let rc = st_validate_ctx(ctx)
    if rc != 0 { return rc }
    return 0
}

fn st_validate_ctx(ctx: u64) -> i64 {
    let root = st_ctx_root(ctx)
    if root == 0 { return -2999 }
    let data_base = st_ctx_data_base(ctx)
    let fsz = st_ctx_filesize(ctx)
    if data_base > fsz { return -2998 }

    let nb = mem_load(root)
    if nb <= 0 { return 0 }
    let esz = mem_load(root + 8) * 8
    if esz <= 0 { return -2997 }
    let i = 0
    while i < nb {
        let slot = mem_load(root + 24) + i * esz
        let k = mem_load(slot)
        if k != 0 {
            if st_is_metadata(k) == 0 {
                let r = st_validate_one_ctx(ctx, mem_load(slot + 8))
                if r != 0 { return r }
            }
        }
        i = i + 1
    }
    return 0
}

fn st_validate_one_ctx(ctx: u64, e: u64) -> i64 {
    if e <= 0 { return -3002 }
    if json_get_type(e) != 5 { return -3002 }
    let eo = json_get_object(e)

    let dtv = json_object_get(eo, "dtype")
    if dtv < 0 { return -3003 }
    let bits = st_bits(json_get_string(dtv))
    if bits <= 0 { return -3003 }

    let shv = json_object_get(eo, "shape")
    if shv < 0 { return -3004 }
    if json_get_type(shv) != 4 { return -3004 }
    let shape_arr = json_get_array(shv)
    let ndims = json_array_len(shape_arr)
    let nel = 1
    if ndims > 0 {
        nel = st_nelements(shape_arr)
        if nel < 0 { return -3004 }
    }

    let offv = json_object_get(eo, "data_offsets")
    if offv < 0 { return -3006 }
    let arr = json_get_array(offv)
    if json_array_len(arr) != 2 { return -3006 }
    let b0 = json_get_number(json_array_get(arr, 0))
    let b1 = json_get_number(json_array_get(arr, 1))
    if b0 < 0 || b1 < 0 { return -3006 }
    if b1 < b0 { return -3006 }

    let want = nel * bits / 8
    if b1 - b0 != want { return -3005 }

    if b1 > st_ctx_filesize(ctx) - st_ctx_data_base(ctx) { return -3006 }

    return 0
}

fn st_close_ctx(ctx: u64) -> i64 {
    let fd = st_ctx_fd(ctx)
    if fd >= 0 { close(fd) }
    st_ctx_set_fd(ctx, -1)
    st_ctx_set_root(ctx, 0)
    return 0
}

fn st_entry_ctx(ctx: u64, name: u64) -> i64 {
    let root = st_ctx_root(ctx)
    if root == 0 { return -1 }
    return json_object_get(root, name)
}

fn st_layout_ctx(ctx: u64, name: u64, nbytes_out: u64, bits_out: u64) -> i64 {
    mem_store(nbytes_out, 0)
    mem_store(bits_out, 0)
    let e = st_entry_ctx(ctx, name)
    if e < 0 { return -1 }
    if json_get_type(e) != 5 { return -2 }
    let eo = json_get_object(e)

    let dtv = json_object_get(eo, "dtype")
    if dtv < 0 { return -3 }
    let bits = st_bits(json_get_string(dtv))
    if bits <= 0 { return -3 }
    mem_store(bits_out, bits)

    let shv = json_object_get(eo, "shape")
    if shv < 0 { return -4 }
    if json_get_type(shv) != 4 { return -4 }
    let nel = st_nelements(json_get_array(shv))
    if nel < 0 { return -4 }

    let nbytes = nel * bits / 8
    let offv = json_object_get(eo, "data_offsets")
    if offv < 0 { return -4 }
    let arr = json_get_array(offv)
    if json_array_len(arr) != 2 { return -4 }
    let declared = json_get_number(json_array_get(arr, 1)) - json_get_number(json_array_get(arr, 0))
    if declared != nbytes { return -4 }
    mem_store(nbytes_out, nbytes)

    return 0
}

fn st_read_ctx(ctx: u64, name: u64, dst: u64) -> i64 {
    let e = st_entry_ctx(ctx, name)
    if e < 0 { return -1 }
    let eo = json_get_object(e)
    let offv = json_object_get(eo, "data_offsets")
    if offv < 0 { return -2 }
    let arr = json_get_array(offv)
    if json_array_len(arr) != 2 { return -2 }
    let b0 = json_get_number(json_array_get(arr, 0))
    let b1 = json_get_number(json_array_get(arr, 1))
    if b0 < 0 || b1 < b0 { return -2 }
    let n = b1 - b0
    if b1 > st_ctx_filesize(ctx) - st_ctx_data_base(ctx) { return -3 }
    if lseek(st_ctx_fd(ctx), st_ctx_data_base(ctx) + b0, 0) < 0 { return -4 }
    return read_raw(st_ctx_fd(ctx), dst, n)
}

fn st_bucket_count_ctx(ctx: u64) -> i64 {
    let root = st_ctx_root(ctx)
    if root == 0 { return 0 }
    return mem_load(root)
}

fn st_bucket_esize_ctx(ctx: u64) -> i64 {
    let root = st_ctx_root(ctx)
    if root == 0 { return 0 }
    return mem_load(root + 8) * 8
}

fn st_name_at_ctx(ctx: u64, i: i64) -> u64 {
    let root = st_ctx_root(ctx)
    if root == 0 { return 0 }
    if i < 0 { return 0 }
    let nb = st_bucket_count_ctx(ctx)
    let esz = st_bucket_esize_ctx(ctx)
    if nb <= 0 || esz <= 0 { return 0 }
    let seen = 0
    let s = 0
    while s < nb {
        let slot = mem_load(root + 24) + s * esz
        let k = mem_load(slot)
        if k != 0 && st_is_metadata(k) == 0 {
            if seen == i { return k }
            seen = seen + 1
        }
        s = s + 1
    }
    return 0
}

fn st_count_ctx(ctx: u64) -> i64 {
    let root = st_ctx_root(ctx)
    if root == 0 { return 0 }
    let nb = st_bucket_count_ctx(ctx)
    let esz = st_bucket_esize_ctx(ctx)
    if nb <= 0 || esz <= 0 { return 0 }
    let n = 0
    let s = 0
    while s < nb {
        let slot = mem_load(root + 24) + s * esz
        let k = mem_load(slot)
        if k != 0 && st_is_metadata(k) == 0 { n = n + 1 }
        s = s + 1
    }
    return n
}

fn st_index_of_ctx(ctx: u64, name: u64) -> i64 {
    let root = st_ctx_root(ctx)
    if root == 0 { return -1 }
    let nb = st_bucket_count_ctx(ctx)
    let esz = st_bucket_esize_ctx(ctx)
    if nb <= 0 || esz <= 0 { return -1 }
    let seen = 0
    let s = 0
    while s < nb {
        let slot = mem_load(root + 24) + s * esz
        let k = mem_load(slot)
        if k != 0 && st_is_metadata(k) == 0 {
            if equals(k, name) { return seen }
            seen = seen + 1
        }
        s = s + 1
    }
    return -1
}

fn st_dims_at_ctx(ctx: u64, i: i64, out: u64, cap: i64) -> i64 {
    let name = st_name_at_ctx(ctx, i)
    if name == 0 { return -1 }
    let e = st_entry_ctx(ctx, name)
    if e < 0 { return -1 }
    let eo = json_get_object(e)
    let shv = json_object_get(eo, "shape")
    if shv < 0 { return -2 }
    if json_get_type(shv) != 4 { return -2 }
    let arr = json_get_array(shv)
    let nd = json_array_len(arr)
    if nd < 0 { return -2 }
    if nd > cap { return -2 }
    let d = 0
    while d < nd {
        mem_store(out + d * 8, json_get_number(json_array_get(arr, d)))
        d = d + 1
    }
    return nd
}

fn st_ndims_ctx(ctx: u64, i: i64) -> i64 {
    let tmp = mem_alloc(32)
    return st_dims_at_ctx(ctx, i, tmp, 4)
}

fn st_dim_ctx(ctx: u64, i: i64, d: i64) -> i64 {
    if d < 0 || d > 3 { return 0 }
    let tmp = mem_alloc(32)
    let nd = st_dims_at_ctx(ctx, i, tmp, 4)
    if nd < 0 { return 0 }
    if d >= nd { return 0 }
    return mem_load(tmp + d * 8)
}

fn st_nelements_of_ctx(ctx: u64, i: i64) -> i64 {
    let name = st_name_at_ctx(ctx, i)
    if name == 0 { return -1 }
    let e = st_entry_ctx(ctx, name)
    if e < 0 { return -1 }
    let eo = json_get_object(e)
    let shv = json_object_get(eo, "shape")
    if shv < 0 { return -2 }
    if json_get_type(shv) != 4 { return -2 }
    let arr = json_get_array(shv)
    if json_array_len(arr) == 0 { return 1 }
    return st_nelements(arr)
}

fn st_bits_of_ctx(ctx: u64, i: i64) -> i64 {
    let name = st_name_at_ctx(ctx, i)
    if name == 0 { return -1 }
    let e = st_entry_ctx(ctx, name)
    if e < 0 { return -1 }
    let eo = json_get_object(e)
    let dtv = json_object_get(eo, "dtype")
    if dtv < 0 { return -2 }
    return st_bits(json_get_string(dtv))
}

fn st_tensor_data_off_ctx(ctx: u64, i: i64) -> i64 {
    let name = st_name_at_ctx(ctx, i)
    if name == 0 { return -1 }
    let e = st_entry_ctx(ctx, name)
    if e < 0 { return -1 }
    let eo = json_get_object(e)
    let offv = json_object_get(eo, "data_offsets")
    if offv < 0 { return -2 }
    let arr = json_get_array(offv)
    if json_array_len(arr) != 2 { return -2 }
    return json_get_number(json_array_get(arr, 0))
}