// lib/std/sha3_constants.quanta — shared constants for FIPS 202

fn krot(x, n) {
  return (x << n) | (x >> (64 - n))
}

fn keccak_rc(rnd) {
  if (rnd == 0) { return 0x0000000000000001 }
  if (rnd == 1) { return 0x0000000000008082 }
  if (rnd == 2) { return 0x800000000000808a }
  if (rnd == 3) { return 0x8000000080008000 }
  if (rnd == 4) { return 0x000000000000808b }
  if (rnd == 5) { return 0x0000000080000001 }
  if (rnd == 6) { return 0x8000000080008081 }
  if (rnd == 7) { return 0x8000000000008009 }
  if (rnd == 8) { return 0x000000000000008a }
  if (rnd == 9) { return 0x0000000000000088 }
  if (rnd == 10) { return 0x0000000080008009 }
  if (rnd == 11) { return 0x000000008000000a }
  if (rnd == 12) { return 0x000000008000808b }
  if (rnd == 13) { return 0x800000000000008b }
  if (rnd == 14) { return 0x8000000000008089 }
  if (rnd == 15) { return 0x8000000000008003 }
  if (rnd == 16) { return 0x8000000000008002 }
  if (rnd == 17) { return 0x8000000000000080 }
  if (rnd == 18) { return 0x000000000000800a }
  if (rnd == 19) { return 0x800000008000000a }
  if (rnd == 20) { return 0x8000000080008081 }
  if (rnd == 21) { return 0x8000000000008080 }
  if (rnd == 22) { return 0x0000000080000001 }
  return 0x8000000080008008
}