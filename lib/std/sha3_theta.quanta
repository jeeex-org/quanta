import std/sha3_constants

extern fn malloc(size: u64) -> u64;

fn keccak_theta(st) {
  let C = malloc(40)
  let i = 0
  while (i < 5) {
    let sum = 0
    let j = 0
    while (j < 5) {
      let idx = i + j * 5
      let lane = mem_load(st + idx * 8)
      sum = sum ^ lane
      j = j + 1
    }
    mem_store(C + i * 8, sum)
    i = i + 1
  }

  let i = 0
  while (i < 5) {
    let im4 = i + 4
    if (im4 >= 5) { im4 = im4 - 5 }
    let ip1 = i + 1
    if (ip1 >= 5) { ip1 = ip1 - 5 }
    let D = mem_load(C + im4 * 8) ^ krot(mem_load(C + ip1 * 8), 1)
    let j = 0
    while (j < 5) {
      let idx = i + j * 5
      let lane = mem_load(st + idx * 8)
      mem_store(st + idx * 8, lane ^ D)
      j = j + 1
    }
    i = i + 1
  }
}

extern fn malloc(size: u64) -> u64