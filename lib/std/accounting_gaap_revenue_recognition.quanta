// Real Implementation: Revenue Recognition (ASC 606)
// Domain: accounting | Category: GAAP | Module: Revenue Recognition
// 5-step model: Identify contract → Identify performance obligations →
// Determine transaction price → Allocate price → Recognize as satisfied

// Revenue recognition using percentage-of-completion (output method)
fn recognize_revenue(total_price: i64, obligations_total: i64, obligations_done: i64) -> i64 {
    if obligations_total <= 0 { return 0 }
    if obligations_done >= obligations_total { return total_price }
    if obligations_done <= 0 { return 0 }
    let per = total_price / obligations_total
    return per * obligations_done
}

// Variable consideration constraint - only include if highly probable
fn constrain_variable_consideration(expected_value: i64, constraint_threshold_pct: i64) -> i64 {
    if constraint_threshold_pct >= 80 {
        return expected_value
    }
    if constraint_threshold_pct >= 50 {
        return expected_value / 2
    }
    return 0
}

// Calculate contract liability (deferred revenue) 
fn deferred_revenue(total_billed: i64, revenue_recognized: i64) -> i64 {
    if revenue_recognized >= total_billed { return 0 }
    return total_billed - revenue_recognized
}

// Allocate transaction price to performance obligations on SSP basis
fn allocate_price(total_price: i64, ssp_this: i64, ssp_total: i64) -> i64 {
    if ssp_total <= 0 { return 0 }
    let allocated = (total_price * ssp_this) / ssp_total
    return allocated
}

// Material right - loyalty points valuation
fn material_right_liability(points_issued: i64, points_value: i64, redemption_rate_pct: i64) -> i64 {
    let expected_redemptions = (points_issued * redemption_rate_pct) / 100
    return expected_redemptions * points_value
}
