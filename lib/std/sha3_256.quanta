// lib/std/sha3_256.quanta - SHA3-256 hash function (FIPS 202)

include "sha3_keccak_f.quanta"

fn sha3_256(input, input_len) {
  let rate = 136
  let st = malloc(200)
  let i = 0
  while (i < 25) { mem_store(st + i * 8, 0); i = i + 1 }

  if (input_len == 0) {
    // Empty string: just pad and permute once
    // SHA3-256 padding: 0x06 at byte 0 (bit 0 of lane 0), 0x80 at byte 135 (bit 56 of lane 16)
    let lane0 = mem_load(st + 0) ^ 0x06
    mem_store(st + 0, lane0)
    let lane16 = mem_load(st + 128) ^ 0x8000000000000000
    mem_store(st + 128, lane16)
    keccak_f(st)
  } else {
    let offset = 0
    while (offset < input_len) {
      let j = 0
      while (j < rate && offset + j < input_len) {
        let b = input[offset + j] & 0xFF
        let idx = j >> 3
        let shift = (j & 7) * 8
        let lane = mem_load(st + idx * 8)
        lane = lane ^ (b << shift)
        mem_store(st + idx * 8, lane)
        j = j + 1
      }
      if (offset + j >= input_len) {
        // Last block - pad and permute
        let idx0 = j >> 3
        let shift0 = (j & 7) * 8
        let lane0 = mem_load(st + idx0 * 8)
        lane0 = lane0 ^ (0x06 << shift0)
        mem_store(st + idx0 * 8, lane0)

        let idx1 = 135 >> 3  // 16
        let shift1 = (135 & 7) * 8  // 56
        let lane1 = mem_load(st + idx1 * 8)
        lane1 = lane1 ^ (0x80 << shift1)
        mem_store(st + idx1 * 8, lane1)

        keccak_f(st)
        break
      } else {
        // Full block - permute and continue
        keccak_f(st)
        offset = offset + rate
      }
    }
  }

  let out = malloc(32)
  let i = 0
  while (i < 32) {
    let lane_idx = i >> 3
    let shift = (i & 7) * 8
    let v = mem_load(st + lane_idx * 8)
    out[i] = (v >> shift) & 0xFF
    i = i + 1
  }
  return out
}

fn print_hex(out, len) {
  let i = 0
  while (i < len) {
    let b = out[i] & 0xFF
    let hi = (b >> 4) & 0xF
    let lo = b & 0xF
    let chi = hi + (hi > 9 ? 87 : 48)
    let clo = lo + (lo > 9 ? 87 : 48)
    putchar(chi)
    putchar(clo)
    i = i + 1
  }
  putchar(10)
}

fn main() {
  let out = sha3_256(0, 0)
  print_hex(out, 32)
  let msg = malloc(3)
  msg[0] = 97; msg[1] = 98; msg[2] = 99
  let out2 = sha3_256(msg, 3)
  print_hex(out2, 32)
}

extern fn malloc(size: u64) -> u64