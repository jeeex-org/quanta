import std/sha3_hash

// Re-export all FIPS 202 functions for std/secure users
fn sha3_224(input, input_len, out) {
  return std/sha3_hash/sha3_224(input, input_len, out)
}

fn sha3_256(input, input_len, out) {
  return std/sha3_hash/sha3_256(input, input_len, out)
}

fn sha3_384(input, input_len, out) {
  return std/sha3_hash/sha3_384(input, input_len, out)
}

fn sha3_512(input, input_len, out) {
  return std/sha3_hash/sha3_512(input, input_len, out)
}

fn shake128(input, input_len, out, out_len) {
  return std/sha3_hash/shake128(input, input_len, out, out_len)
}

fn shake256(input, input_len, out, out_len) {
  return std/sha3_hash/shake256(input, input_len, out, out_len)
}