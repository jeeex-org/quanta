fn krot(x, n) {
  return (x << n) | (x >> (64 - n))
}

extern fn malloc(size: u64) -> u64

fn keccak_rc(rnd) {
  if (rnd == 0) { return 0x0000000000000001 }
  if (rnd == 1) { return 0x0000000000008082 }
  if (rnd == 2) { return 0x800000000000808a }
  if (rnd == 3) { return 0x8000000080008000 }
  if (rnd == 4) { return 0x000000000000808b }
  if (rnd == 5) { return 0x0000000080000001 }
  if (rnd == 6) { return 0x8000000080008081 }
  if (rnd == 7) { return 0x0000000000008009 }
  if (rnd == 8) { return 0x000000000000008a }
  if (rnd == 9) { return 0x0000000000000088 }
  if (rnd == 10) { return 0x0000000080008009 }
  if (rnd == 11) { return 0x800000008000000a }
  if (rnd == 12) { return 0x000000008000808b }
  if (rnd == 13) { return 0x800000000000008b }
  if (rnd == 14) { return 0x8000000000008089 }
  if (rnd == 15) { return 0x8000000000008003 }
  if (rnd == 16) { return 0x8000000000008002 }
  if (rnd == 17) { return 0x8000000000000080 }
  if (rnd == 18) { return 0x000000000000800a }
  if (rnd == 19) { return 0x8000000080008008 }
  if (rnd == 20) { return 0x8000000080008009 }
  if (rnd == 21) { return 0x800000008000000a }
  if (rnd == 22) { return 0x800000008000808b }
  return 0x8000000080008081
}

fn keccak_theta(st) {
  let a0 = mem_load(st+0); let a1 = mem_load(st+8); let a2 = mem_load(st+16); let a3 = mem_load(st+24); let a4 = mem_load(st+32)
  let a5 = mem_load(st+40); let a6 = mem_load(st+48); let a7 = mem_load(st+56); let a8 = mem_load(st+64); let a9 = mem_load(st+72)
  let a10 = mem_load(st+80); let a11 = mem_load(st+88); let a12 = mem_load(st+96); let a13 = mem_load(st+104); let a14 = mem_load(st+112)
  let a15 = mem_load(st+120); let a16 = mem_load(st+128); let a17 = mem_load(st+136); let a18 = mem_load(st+144); let a19 = mem_load(st+152)
  let a20 = mem_load(st+160); let a21 = mem_load(st+168); let a22 = mem_load(st+176); let a23 = mem_load(st+184); let a24 = mem_load(st+192)

  let C0 = a0 ^ a5 ^ a10 ^ a15 ^ a20
  let C1 = a1 ^ a6 ^ a11 ^ a16 ^ a21
  let C2 = a2 ^ a7 ^ a12 ^ a17 ^ a22
  let C3 = a3 ^ a8 ^ a13 ^ a18 ^ a23
  let C4 = a4 ^ a9 ^ a14 ^ a19 ^ a24

  let D0 = C4 ^ krot(C1, 1)
  let D1 = C0 ^ krot(C2, 1)
  let D2 = C1 ^ krot(C3, 1)
  let D3 = C2 ^ krot(C4, 1)
  let D4 = C3 ^ krot(C0, 1)

  a0 ^= D0; a1 ^= D1; a2 ^= D2; a3 ^= D3; a4 ^= D4
  a5 ^= D0; a6 ^= D1; a7 ^= D2; a8 ^= D3; a9 ^= D4
  a10 ^= D0; a11 ^= D1; a12 ^= D2; a13 ^= D3; a14 ^= D4
  a15 ^= D0; a16 ^= D1; a17 ^= D2; a18 ^= D3; a19 ^= D4
  a20 ^= D0; a21 ^= D1; a22 ^= D2; a23 ^= D3; a24 ^= D4

  mem_store(st+0, a0); mem_store(st+8, a1); mem_store(st+16, a2); mem_store(st+24, a3); mem_store(st+32, a4)
  mem_store(st+40, a5); mem_store(st+48, a6); mem_store(st+56, a7); mem_store(st+64, a8); mem_store(st+72, a9)
  mem_store(st+80, a10); mem_store(st+88, a11); mem_store(st+96, a12); mem_store(st+104, a13); mem_store(st+112, a14)
  mem_store(st+120, a15); mem_store(st+128, a16); mem_store(st+136, a17); mem_store(st+144, a18); mem_store(st+152, a19)
  mem_store(st+160, a20); mem_store(st+168, a21); mem_store(st+176, a22); mem_store(st+184, a23); mem_store(st+192, a24)
}

fn keccak_rhopi(st) {
  let a0 = mem_load(st+0); let a1 = mem_load(st+8); let a2 = mem_load(st+16); let a3 = mem_load(st+24); let a4 = mem_load(st+32)
  let a5 = mem_load(st+40); let a6 = mem_load(st+48); let a7 = mem_load(st+56); let a8 = mem_load(st+64); let a9 = mem_load(st+72)
  let a10 = mem_load(st+80); let a11 = mem_load(st+88); let a12 = mem_load(st+96); let a13 = mem_load(st+104); let a14 = mem_load(st+112)
  let a15 = mem_load(st+120); let a16 = mem_load(st+128); let a17 = mem_load(st+136); let a18 = mem_load(st+144); let a19 = mem_load(st+152)
  let a20 = mem_load(st+160); let a21 = mem_load(st+168); let a22 = mem_load(st+176); let a23 = mem_load(st+184); let a24 = mem_load(st+192)

  let b0 = krot(a0, 0); let b1 = krot(a6, 44); let b2 = krot(a12, 43); let b3 = krot(a18, 21); let b4 = krot(a24, 14)
  let b5 = krot(a3, 28); let b6 = krot(a9, 20); let b7 = krot(a15, 15); let b8 = krot(a21, 61); let b9 = krot(a2, 62)
  let b10 = krot(a1, 1); let b11 = krot(a7, 6); let b12 = krot(a13, 25); let b13 = krot(a19, 8); let b14 = krot(a20, 18)
  let b15 = krot(a4, 27); let b16 = krot(a10, 36); let b17 = krot(a16, 10); let b18 = krot(a22, 39); let b19 = krot(a3, 41)
  let b20 = krot(a2, 62); let b21 = krot(a8, 55); let b22 = krot(a14, 56); let b23 = krot(a15, 45); let b24 = krot(a11, 55)

  mem_store(st+0, b0); mem_store(st+8, b5); mem_store(st+16, b10); mem_store(st+24, b15); mem_store(st+32, b20)
  mem_store(st+40, b1); mem_store(st+48, b6); mem_store(st+56, b11); mem_store(st+64, b16); mem_store(st+72, b21)
  mem_store(st+80, b2); mem_store(st+88, b7); mem_store(st+96, b12); mem_store(st+104, b17); mem_store(st+112, b22)
  mem_store(st+120, b3); mem_store(st+128, b8); mem_store(st+136, b13); mem_store(st+144, b18); mem_store(st+152, b23)
  mem_store(st+160, b4); mem_store(st+168, b9); mem_store(st+176, b14); mem_store(st+184, b19); mem_store(st+192, b24)
}

fn keccak_chi(st) {
  let b0 = mem_load(st+0); let b1 = mem_load(st+8); let b2 = mem_load(st+16); let b3 = mem_load(st+24); let b4 = mem_load(st+32)
  let b5 = mem_load(st+40); let b6 = mem_load(st+48); let b7 = mem_load(st+56); let b8 = mem_load(st+64); let b9 = mem_load(st+72)
  let b10 = mem_load(st+80); let b11 = mem_load(st+88); let b12 = mem_load(st+96); let b13 = mem_load(st+104); let b14 = mem_load(st+112)
  let b15 = mem_load(st+120); let b16 = mem_load(st+128); let b17 = mem_load(st+136); let b18 = mem_load(st+144); let b19 = mem_load(st+152)
  let b20 = mem_load(st+160); let b21 = mem_load(st+168); let b22 = mem_load(st+176); let b23 = mem_load(st+184); let b24 = mem_load(st+192)

  let e0 = b0 ^ ((~b1) & b2); let e1 = b1 ^ ((~b2) & b3); let e2 = b2 ^ ((~b3) & b4); let e3 = b3 ^ ((~b4) & b0); let e4 = b4 ^ ((~b0) & b1)
  let e5 = b5 ^ ((~b6) & b7); let e6 = b6 ^ ((~b7) & b8); let e7 = b7 ^ ((~b8) & b9); let e8 = b8 ^ ((~b9) & b5); let e9 = b9 ^ ((~b5) & b6)
  let e10 = b10 ^ ((~b11) & b12); let e11 = b11 ^ ((~b12) & b13); let e12 = b12 ^ ((~b13) & b14); let e13 = b13 ^ ((~b14) & b10); let e14 = b14 ^ ((~b10) & b11)
  let e15 = b15 ^ ((~b16) & b17); let e16 = b16 ^ ((~b17) & b18); let e17 = b17 ^ ((~b18) & b19); let e18 = b18 ^ ((~b19) & b15); let e19 = b19 ^ ((~b15) & b16)
  let e20 = b20 ^ ((~b21) & b22); let e21 = b21 ^ ((~b22) & b23); let e22 = b22 ^ ((~b23) & b24); let e23 = b23 ^ ((~b24) & b20); let e24 = b24 ^ ((~b20) & b21)

  mem_store(st+0, e0); mem_store(st+8, e1); mem_store(st+16, e2); mem_store(st+24, e3); mem_store(st+32, e4)
  mem_store(st+40, e5); mem_store(st+48, e6); mem_store(st+56, e7); mem_store(st+64, e8); mem_store(st+72, e9)
  mem_store(st+80, e10); mem_store(st+88, e11); mem_store(st+96, e12); mem_store(st+104, e13); mem_store(st+112, e14)
  mem_store(st+120, e15); mem_store(st+128, e16); mem_store(st+136, e17); mem_store(st+144, e18); mem_store(st+152, e19)
  mem_store(st+160, e20); mem_store(st+168, e21); mem_store(st+176, e22); mem_store(st+184, e23); mem_store(st+192, e24)
}

fn keccak_iota(st, rnd) {
  let rc = keccak_rc(rnd)
  let a0 = mem_load(st + 0) ^ rc
  mem_store(st + 0, a0)
}

fn keccak_round(st, rnd) {
  keccak_theta(st)
  keccak_rhopi(st)
  keccak_chi(st)
  keccak_iota(st, rnd)
}

fn keccak_f(st) {
  let rnd = 0
  while (rnd < 24) {
    keccak_round(st, rnd)
    rnd = rnd + 1
  }
}

fn sha3_256(input, input_len) {
  let rate = 136
  let st = malloc(200)
  let i = 0
  while (i < 25) { mem_store(st + i * 8, 0); i = i + 1 }

  let offset = 0
  while (offset < input_len) {
    let j = 0
    while (j < rate && offset + j < input_len) {
      let b = input[offset + j] & 0xFF
      let idx = j >> 3
      let shift = (j & 7) * 8
      let lane = mem_load(st + idx * 8)
      lane = lane ^ (b << shift)
      mem_store(st + idx * 8, lane)
      j = j + 1
    }
    if (j < rate) {
      let idx = j >> 3
      let shift = (j & 7) * 8
      let lane = mem_load(st + idx * 8)
      lane = lane ^ (0x06 << shift)
      mem_store(st + idx * 8, lane)
      j = j + 1
    }
    if (j < rate) {
      let idx = (rate - 1) >> 3
      let shift = ((rate - 1) & 7) * 8
      let lane = mem_load(st + idx * 8)
      lane = lane ^ (0x80 << shift)
      mem_store(st + idx * 8, lane)
    }
    keccak_f(st)
    offset = offset + rate
  }

  let out = malloc(32)
  let i = 0
  while (i < 32) {
    let lane_idx = i >> 3
    let shift = (i & 7) * 8
    let v = mem_load(st + lane_idx * 8)
    out[i] = (v >> shift) & 0xFF
    i = i + 1
  }
  return out
}

fn print_hex(out, len) {
  let i = 0
  while (i < len) {
    let b = out[i] & 0xFF
    let hi = (b >> 4) & 0xF
    let lo = b & 0xF
    let chi = hi + (hi > 9 ? 87 : 48)
    let clo = lo + (lo > 9 ? 87 : 48)
    putchar(chi)
    putchar(clo)
    i = i + 1
  }
  putchar(10)
}

fn main() {
  let out = sha3_256(0, 0)
  print_hex(out, 32)
  let msg = malloc(3)
  msg[0] = 97; msg[1] = 98; msg[2] = 99
  let out2 = sha3_256(msg, 3)
  print_hex(out2, 32)
}