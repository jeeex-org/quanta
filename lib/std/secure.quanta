fn krot(x, n) {
  return (x << n) | (x >> (64 - n))
}

fn theta(st) {
  let a00 = mem_load(st+0); let a01 = mem_load(st+8); let a02 = mem_load(st+16); let a03 = mem_load(st+24); let a04 = mem_load(st+32)
  let a10 = mem_load(st+40); let a11 = mem_load(st+48); let a12 = mem_load(st+56); let a13 = mem_load(st+64); let a14 = mem_load(st+72)
  let a20 = mem_load(st+80); let a21 = mem_load(st+88); let a22 = mem_load(st+96); let a23 = mem_load(st+104); let a24 = mem_load(st+112)
  let a30 = mem_load(st+120); let a31 = mem_load(st+128); let a32 = mem_load(st+136); let a33 = mem_load(st+144); let a34 = mem_load(st+152)
  let a40 = mem_load(st+160); let a41 = mem_load(st+168); let a42 = mem_load(st+176); let a43 = mem_load(st+184); let a44 = mem_load(st+192)

  let C0 = a00 ^ a10 ^ a20 ^ a30 ^ a40
  let C1 = a01 ^ a11 ^ a21 ^ a31 ^ a41
  let C2 = a02 ^ a12 ^ a22 ^ a32 ^ a42
  let C3 = a03 ^ a13 ^ a23 ^ a33 ^ a43
  let C4 = a04 ^ a14 ^ a24 ^ a34 ^ a44

  let D0 = C4 ^ krot(C1, 1)
  let D1 = C0 ^ krot(C2, 1)
  let D2 = C1 ^ krot(C3, 1)
  let D3 = C2 ^ krot(C4, 1)
  let D4 = C3 ^ krot(C0, 1)

  a00 ^= D0; a01 ^= D1; a02 ^= D2; a03 ^= D3; a04 ^= D4
  a10 ^= D0; a11 ^= D1; a12 ^= D2; a13 ^= D3; a14 ^= D4
  a20 ^= D0; a21 ^= D1; a22 ^= D2; a23 ^= D3; a24 ^= D4
  a30 ^= D0; a31 ^= D1; a32 ^= D2; a33 ^= D3; a34 ^= D4
  a40 ^= D0; a41 ^= D1; a42 ^= D2; a43 ^= D3; a44 ^= D4

  mem_store(st+0, a00); mem_store(st+8, a01); mem_store(st+16, a02); mem_store(st+24, a03); mem_store(st+32, a04)
  mem_store(st+40, a10); mem_store(st+48, a11); mem_store(st+56, a12); mem_store(st+64, a13); mem_store(st+72, a14)
  mem_store(st+80, a20); mem_store(st+88, a21); mem_store(st+96, a22); mem_store(st+104, a23); mem_store(st+112, a24)
  mem_store(st+120, a30); mem_store(st+128, a31); mem_store(st+136, a32); mem_store(st+144, a33); mem_store(st+152, a34)
  mem_store(st+160, a40); mem_store(st+168, a41); mem_store(st+176, a42); mem_store(st+184, a43); mem_store(st+192, a44)
}

fn rhopi(st) {
  let a00 = mem_load(st+0); let a01 = mem_load(st+8); let a02 = mem_load(st+16); let a03 = mem_load(st+24); let a04 = mem_load(st+32)
  let a10 = mem_load(st+40); let a11 = mem_load(st+48); let a12 = mem_load(st+56); let a13 = mem_load(st+64); let a14 = mem_load(st+72)
  let a20 = mem_load(st+80); let a21 = mem_load(st+88); let a22 = mem_load(st+96); let a23 = mem_load(st+104); let a24 = mem_load(st+112)
  let a30 = mem_load(st+120); let a31 = mem_load(st+128); let a32 = mem_load(st+136); let a33 = mem_load(st+144); let a34 = mem_load(st+152)
  let a40 = mem_load(st+160); let a41 = mem_load(st+168); let a42 = mem_load(st+176); let a43 = mem_load(st+184); let a44 = mem_load(st+192)

  let b00 = krot(a00, 0); let b01 = krot(a11, 36); let b02 = krot(a22, 3); let b03 = krot(a33, 41); let b04 = krot(a44, 18)
  let b10 = krot(a01, 1); let b11 = krot(a12, 44); let b12 = krot(a23, 10); let b13 = krot(a34, 45); let b14 = krot(a40, 2)
  let b20 = krot(a02, 62); let b21 = krot(a13, 6); let b22 = krot(a24, 43); let b23 = krot(a30, 15); let b24 = krot(a41, 61)
  let b30 = krot(a03, 28); let b31 = krot(a14, 55); let b32 = krot(a20, 25); let b33 = krot(a31, 21); let b34 = krot(a42, 56)
  let b40 = krot(a04, 27); let b41 = krot(a10, 20); let b42 = krot(a21, 39); let b43 = krot(a32, 8); let b44 = krot(a43, 14)

  mem_store(st+0, b00); mem_store(st+8, b10); mem_store(st+16, b20); mem_store(st+24, b30); mem_store(st+32, b40)
  mem_store(st+40, b01); mem_store(st+48, b11); mem_store(st+56, b21); mem_store(st+64, b31); mem_store(st+72, b41)
  mem_store(st+80, b02); mem_store(st+88, b12); mem_store(st+96, b22); mem_store(st+104, b32); mem_store(st+112, b42)
  mem_store(st+120, b03); mem_store(st+128, b13); mem_store(st+136, b23); mem_store(st+144, b33); mem_store(st+152, b43)
  mem_store(st+160, b04); mem_store(st+168, b14); mem_store(st+176, b24); mem_store(st+184, b34); mem_store(st+192, b44)
}

fn chi(st) {
  let b00 = mem_load(st+0); let b01 = mem_load(st+8); let b02 = mem_load(st+16); let b03 = mem_load(st+24); let b04 = mem_load(st+32)
  let b10 = mem_load(st+40); let b11 = mem_load(st+48); let b12 = mem_load(st+56); let b13 = mem_load(st+64); let b14 = mem_load(st+72)
  let b20 = mem_load(st+80); let b21 = mem_load(st+88); let b22 = mem_load(st+96); let b23 = mem_load(st+104); let b24 = mem_load(st+112)
  let b30 = mem_load(st+120); let b31 = mem_load(st+128); let b32 = mem_load(st+136); let b33 = mem_load(st+144); let b34 = mem_load(st+152)
  let b40 = mem_load(st+160); let b41 = mem_load(st+168); let b42 = mem_load(st+176); let b43 = mem_load(st+184); let b44 = mem_load(st+192)

  let e00 = b00 ^ ((~b01) & b02); let e01 = b01 ^ ((~b02) & b03); let e02 = b02 ^ ((~b03) & b04); let e03 = b03 ^ ((~b04) & b00); let e04 = b04 ^ ((~b00) & b01)
  let e10 = b10 ^ ((~b11) & b12); let e11 = b11 ^ ((~b12) & b13); let e12 = b12 ^ ((~b13) & b14); let e13 = b13 ^ ((~b14) & b10); let e14 = b14 ^ ((~b10) & b11)
  let e20 = b20 ^ ((~b21) & b22); let e21 = b21 ^ ((~b22) & b23); let e22 = b22 ^ ((~b23) & b24); let e23 = b23 ^ ((~b24) & b20); let e24 = b24 ^ ((~b20) & b21)
  let e30 = b30 ^ ((~b31) & b32); let e31 = b31 ^ ((~b32) & b33); let e32 = b32 ^ ((~b33) & b34); let e33 = b33 ^ ((~b34) & b30); let e34 = b34 ^ ((~b30) & b31)
  let e40 = b40 ^ ((~b41) & b42); let e41 = b41 ^ ((~b42) & b43); let e42 = b42 ^ ((~b43) & b44); let e43 = b43 ^ ((~b44) & b40); let e44 = b44 ^ ((~b40) & b41)

  mem_store(st+0, e00); mem_store(st+8, e01); mem_store(st+16, e02); mem_store(st+24, e03); mem_store(st+32, e04)
  mem_store(st+40, e10); mem_store(st+48, e11); mem_store(st+56, e12); mem_store(st+64, e13); mem_store(st+72, e14)
  mem_store(st+80, e20); mem_store(st+88, e21); mem_store(st+96, e22); mem_store(st+104, e23); mem_store(st+112, e24)
  mem_store(st+120, e30); mem_store(st+128, e31); mem_store(st+136, e32); mem_store(st+144, e33); mem_store(st+152, e34)
  mem_store(st+160, e40); mem_store(st+168, e41); mem_store(st+176, e42); mem_store(st+184, e43); mem_store(st+192, e44)
}

fn iota(st, crc) {
  let e00 = mem_load(st+0)
  e00 ^= crc
  mem_store(st+0, e00)
}

fn keccak_round(st, r) {
  theta(st)
  rhopi(st)
  chi(st)
  if (r == 0) { iota(st, 0x0000000000000001) }
  else if (r == 1) { iota(st, 0x0000000000008082) }
  else if (r == 2) { iota(st, 0x800000000000808a) }
  else if (r == 3) { iota(st, 0x8000000080008000) }
  else if (r == 4) { iota(st, 0x000000000000808b) }
  else if (r == 5) { iota(st, 0x0000000080000001) }
  else if (r == 6) { iota(st, 0x8000000080008081) }
  else if (r == 7) { iota(st, 0x0000000000008009) }
  else if (r == 8) { iota(st, 0x000000000000008a) }
  else if (r == 9) { iota(st, 0x0000000000000088) }
  else if (r == 10) { iota(st, 0x0000000080008009) }
  else if (r == 11) { iota(st, 0x800000008000000a) }
  else if (r == 12) { iota(st, 0x000000008000808b) }
  else if (r == 13) { iota(st, 0x800000000000008b) }
  else if (r == 14) { iota(st, 0x8000000000008089) }
  else if (r == 15) { iota(st, 0x8000000000008003) }
  else if (r == 16) { iota(st, 0x8000000000008002) }
  else if (r == 17) { iota(st, 0x8000000000000080) }
  else if (r == 18) { iota(st, 0x000000000000800a) }
  else if (r == 19) { iota(st, 0x8000000080008008) }
  else if (r == 20) { iota(st, 0x8000000080008009) }
  else if (r == 21) { iota(st, 0x800000008000000a) }
  else if (r == 22) { iota(st, 0x800000008000808b) }
  else if (r == 23) { iota(st, 0x8000000080008081) }
}

fn keccak_f(st) {
  let r = 0
  while (r < 24) {
    keccak_round(st, r)
    r = r + 1
  }
}

fn sha3_256(input, input_len) {
  let rate = 136
  let st = malloc(200)
  let i = 0
  while (i < 25) { mem_store(st + i * 8, 0); i = i + 1 }

  let offset = 0
  while (offset < input_len) {
    let j = 0
    while (j < rate && offset + j < input_len) {
      let b = input[offset + j] & 0xFF
      let idx = j >> 3
      let shift = (j & 7) * 8
      let lane = mem_load(st + idx * 8)
      lane = lane ^ (b << shift)
      mem_store(st + idx * 8, lane)
      j = j + 1
    }
    if (j < rate) {
      let idx = j >> 3
      let shift = (j & 7) * 8
      let lane = mem_load(st + idx * 8)
      lane = lane ^ (0x06 << shift)
      mem_store(st + idx * 8, lane)
      j = j + 1
    }
    if (j < rate) {
      let idx = (rate - 1) >> 3
      let shift = ((rate - 1) & 7) * 8
      let lane = mem_load(st + idx * 8)
      lane = lane ^ (0x80 << shift)
      mem_store(st + idx * 8, lane)
    }
    keccak_f(st)
    offset = offset + rate
  }

  let out = malloc(32)
  let i = 0
  while (i < 32) {
    let lane_idx = i >> 3
    let shift = (i & 7) * 8
    let v = mem_load(st + lane_idx * 8)
    out[i] = (v >> shift) & 0xFF
    i = i + 1
  }
  return out
}

fn print_hex(out, len) {
  let i = 0
  while (i < len) {
    let b = out[i] & 0xFF
    let hi = (b >> 4) & 0xF
    let lo = b & 0xF
    let chi = hi + (hi > 9 ? 87 : 48)
    let clo = lo + (lo > 9 ? 87 : 48)
    putchar(chi)
    putchar(clo)
    i = i + 1
  }
  putchar(10)
}

fn main() {
  let out = sha3_256(0, 0)
  print_hex(out, 32)
  let msg = malloc(3)
  msg[0] = 97; msg[1] = 98; msg[2] = 99
  let out2 = sha3_256(msg, 3)
  print_hex(out2, 32)
}