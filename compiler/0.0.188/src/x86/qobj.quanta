// === QOBJ: Module caching system ===
// Compiled module artifacts: IR + symbol table + relocations
// Loaded instead of re-tokenizing imports

// .qobj file format:
// [4] magic = 0x514F424A ("QOBJ")
// [4] version = 1
// [4] sym_count
// [sym_count × 24] symbol records (same as ELF symtab)
// [4] strtab_len
// [strtab_len] string table bytes

const QOBJ_MAGIC = 0x514F424A
const QOBJ_VERSION = 1

// Track which symbols are owned by current module vs imported
// sym_owner[si*8] = 1 if owned by current module, 0 if imported
let sym_owner = mmap(2000000)
let module_symc_start = 0  // symc value at start of current module

// Mark a symbol as owned by current module
fn mark_owned(si) {
  w64(sym_owner + si*8, 1)
}

// Check if symbol is owned by current module
fn is_owned(si) -> i64 {
  if r64(sym_owner + si*8) == 1 { return 1 }
  return 0
}

// Set module boundary (call before importing/compiling current module)
fn mark_module_start() {
  module_symc_start = symc
}

// Mark all new symbols as owned by current module
fn mark_new_owned() {
  let si = module_symc_start
  while si < symc {
    mark_owned(si)
    si = si + 1
  }
}

// Write current compilation state to .qobj file
// Writes ALL symbols (simpler than tracking owned/imported)
fn qobj_write(path) -> i64 {
  let fd = file_open(path, 577)
  if fd < 0 { return 0 }
  
  // Magic + version + sym_count
  let hdr = mmap(12)
  w32(hdr, QOBJ_MAGIC)
  w32(hdr + 4, QOBJ_VERSION)
  w32(hdr + 8, symc)
  file_write(fd, hdr, 12)
  
  // Write all symbols
  if symc > 0 {
    let sym_buf = mmap(symc * 24)
    let i = 0
    while i < symc {
      w32(sym_buf + i*24, r32(symtab + i*24))
      w32(sym_buf + i*24 + 4, r32(symtab + i*24 + 4))
      w64(sym_buf + i*24 + 8, r64(symtab + i*24 + 8))
      w64(sym_buf + i*24 + 16, r64(symtab + i*24 + 16))
      i = i + 1
    }
    file_write(fd, sym_buf, symc * 24)
  }
  
  // String table
  let str_hdr = mmap(4)
  w32(str_hdr, strtablen)
  file_write(fd, str_hdr, 4)
  if strtablen > 0 {
    file_write(fd, strtab, strtablen)
  }
  
  file_close(fd)
  return 1
}

// Import symbols from pre-compiled module cache
fn qobj_import(qobj_path) -> i64 {
  let fd = file_open(qobj_path, 0)
  if fd < 0 { return 0 }
  
  let hdr = mmap(12)
  let n = file_read(fd, hdr, 12)
  if n < 12 { file_close(fd); return 0 }
  
  let magic = r32(hdr)
  if magic != QOBJ_MAGIC { file_close(fd); return 0 }
  
  let sym_count = r32(hdr + 8)
  
  // Read symbols and add to current symtab
  let sym_buf = mmap(sym_count * 24)
  if sym_count > 0 {
    file_read(fd, sym_buf, sym_count * 24)
    let i = 0
    while i < sym_count {
      let dst = symc
      w32(symtab + dst * 24, r32(sym_buf + i * 24))
      w32(symtab + dst * 24 + 4, r32(sym_buf + i * 24 + 4))
      w64(symtab + dst * 24 + 8, r64(sym_buf + i * 24 + 8))
      w64(symtab + dst * 24 + 16, r64(sym_buf + i * 24 + 16))
      // Mark as imported (not owned)
      w64(sym_owner + dst * 8, 0)
      symc = symc + 1
      i = i + 1
    }
  }
  
  // Read string table
  let str_hdr = mmap(4)
  file_read(fd, str_hdr, 4)
  let strtab_len = r32(str_hdr)
  if strtab_len > 0 {
    let str_buf = mmap(strtab_len)
    file_read(fd, str_buf, strtab_len)
    let j = 0
    while j < strtab_len {
      w8(strtab + strtablen + j, r8(str_buf + j))
      j = j + 1
    }
    strtablen = strtablen + strtab_len
  }
  
  file_close(fd)
  return 1
}