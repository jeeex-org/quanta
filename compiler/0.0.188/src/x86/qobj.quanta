// === QOBJ: Module caching system ===
// Phase 2: Import names via strtab (not src pointers)

const QOBJ_MAGIC = 0x514F424A
const QOBJ_VERSION = 2

// Write current compilation state to .qobj file
// Stores function names as string bytes (portable across compilations)
fn qobj_write(path) -> i64 {
  let fd = file_open(path, 577)
  if fd < 0 { return 0 }
  
  // Count total bytes needed for function names + ret types
  let names_total_len = 0
  let i = 0
  while i < fnc {
    names_total_len = names_total_len + r64(fns + i*FNS + 8) + 1  // name + NUL
    names_total_len = names_total_len + r64(fns + i*FNS + 48) + 1  // ret type + NUL
    i = i + 1
  }
  
  // Magic + version + fn_count + names_total_len
  let hdr = mmap(16)
  w32(hdr, QOBJ_MAGIC)
  w32(hdr + 4, QOBJ_VERSION)
  w32(hdr + 8, fnc)
  w32(hdr + 12, names_total_len)
  file_write(fd, hdr, 16)
  
  // Write function entries: [name_offset, name_len, param_c, ret_offset, ret_len]
  // Offsets are relative to the start of the names blob
  if fnc > 0 {
    let fn_buf = mmap(fnc * 24)  // 24 bytes per function entry
    let names_blob = mmap(names_total_len)
    let name_off = 0
    i = 0
    while i < fnc {
      // Copy function name
      let name_ptr = r64(fns + i*FNS)
      let name_len = r64(fns + i*FNS + 8)
      let param_c = r64(fns + i*FNS + 32)
      let ret_ptr = r64(fns + i*FNS + 40)
      let ret_len = r64(fns + i*FNS + 48)
      
      // Write name to blob
      let j = 0
      while j < name_len {
        w8(names_blob + name_off + j, r8(name_ptr + j))
        j = j + 1
      }
      w8(names_blob + name_off + name_len, 0)  // NUL terminate
      
      // Write ret type to blob
      let ret_off = name_off + name_len + 1
      j = 0
      while j < ret_len {
        w8(names_blob + ret_off + j, r8(ret_ptr + j))
        j = j + 1
      }
      w8(names_blob + ret_off + ret_len, 0)  // NUL terminate
      
      // Write entry (offsets relative to names blob start)
      w32(fn_buf + i*24, name_off)
      w32(fn_buf + i*24 + 4, name_len)
      w32(fn_buf + i*24 + 8, param_c)
      w32(fn_buf + i*24 + 12, ret_off)
      w32(fn_buf + i*24 + 16, ret_len)
      w32(fn_buf + i*24 + 20, 0)  // padding
      
      name_off = ret_off + ret_len + 1
      i = i + 1
    }
    file_write(fd, fn_buf, fnc * 24)
    file_write(fd, names_blob, names_total_len)
  }
  
  file_close(fd)
  return 1
}

// Import functions from pre-compiled module cache
fn qobj_import(qobj_path) -> i64 {
  let fd = file_open(qobj_path, 0)
  if fd < 0 { return 0 }
  
  let hdr = mmap(16)
  let n = file_read(fd, hdr, 16)
  if n < 16 { file_close(fd); return 0 }
  
  let magic = r32(hdr)
  if magic != QOBJ_MAGIC { file_close(fd); return 0 }
  
  let fn_count = r32(hdr + 8)
  let names_blob_len = r32(hdr + 12)
  
  // Read function entries
  let fn_buf = mmap(fn_count * 24)
  if fn_count > 0 {
    file_read(fd, fn_buf, fn_count * 24)
  }
  
  // Read names blob
  let names_blob = mmap(names_blob_len)
  if names_blob_len > 0 {
    file_read(fd, names_blob, names_blob_len)
  }
  
  // Register functions
  let i = 0
  while i < fn_count {
    let name_off = r32(fn_buf + i*24)
    let name_len = r32(fn_buf + i*24 + 4)
    let param_c = r32(fn_buf + i*24 + 8)
    let ret_off = r32(fn_buf + i*24 + 12)
    let ret_len = r32(fn_buf + i*24 + 16)
    
    // Name pointer = names_blob + name_off (will be added to strtab)
    // For now, use names_blob directly as the name pointer
    // This works because names_blob is mmap'd and persists
    
    // Copy name to current strtab
    let name_ptr = strtab + strtablen
    let j = 0
    while j < name_len {
      w8(strtab + strtablen + j, r8(names_blob + name_off + j))
      j = j + 1
    }
    w8(strtab + strtablen + name_len, 0)
    strtablen = strtablen + name_len + 1
    
    // Copy ret type to current strtab
    let ret_ptr = strtab + strtablen
    j = 0
    while j < ret_len {
      w8(strtab + strtablen + j, r8(names_blob + ret_off + j))
      j = j + 1
    }
    w8(strtab + strtablen + ret_len, 0)
    strtablen = strtablen + ret_len + 1
    
    // Register function
    sfn(fnc, name_ptr, name_len, 0, 0, param_c, ret_ptr, ret_len)
    w64(fn_is_imported + fnc*8, 1)
    fnc = fnc + 1
    
    i = i + 1
  }
  
  file_close(fd)
  return 1
}