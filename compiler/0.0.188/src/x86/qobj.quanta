// === QOBJ: Module caching system ===
// Phase 3: IR linking with portable string-based function names

const QOBJ_MAGIC = 0x514F424A
let sym_owner = mmap(2000000)
let module_symc_start = 0

fn mark_owned(si) { w64(sym_owner + si*8, 1) }
fn is_owned(si) -> i64 { if r64(sym_owner + si*8) == 1 { return 1 }; return 0 }
fn mark_module_start() { module_symc_start = symc }

fn mark_new_owned() {
  let si = module_symc_start
  while si < symc { mark_owned(si); si = si + 1 }
}

// Write functions + IR to .qobj with portable string format
fn qobj_write(path) -> i64 {
  let fd = file_open(path, 577)
  if fd < 0 { return 0 }
  mark_new_owned()
  
  // Count total string bytes needed
  let total_str_bytes = 0
  let i = 0
  while i < fnc {
    total_str_bytes = total_str_bytes + r64(fns + i*FNS + 8) + 1  // name + NUL
    total_str_bytes = total_str_bytes + r64(fn_rettype_len + i*8) + 1  // ret + NUL
    i = i + 1
  }
  
  // Magic + version + fn_count + ir_count + total_str_bytes
  let hdr = mmap(20)
  w32(hdr, QOBJ_MAGIC)
  w32(hdr + 4, 4)  // version 4
  w32(hdr + 8, fnc)
  w32(hdr + 12, irc)
  w32(hdr + 16, total_str_bytes)
  file_write(fd, hdr, 20)
  
  // Write function entries: [name_off, name_len, param_c, ret_off, ret_len, ir_start, ir_count]
  // Offsets are relative to the start of the string blob
  if fnc > 0 {
    let fn_buf = mmap(fnc * 32)  // 32 bytes per function entry
    let str_blob = mmap(total_str_bytes)
    let str_off = 0
    i = 0
    while i < fnc {
      let name_ptr = r64(fns + i*FNS)
      let name_len = r64(fns + i*FNS + 8)
      let param_c = r64(fn_pcount + i*8)
      let ret_ptr = r64(fn_rettype_name + i*8)
      let ret_len = r64(fn_rettype_len + i*8)
      let ir_start = r64(fn_ir_start + i*8)
      let ir_count = r64(fn_ir_count + i*8)
      
      // Copy name to blob
      let j = 0
      while j < name_len {
        w8(str_blob + str_off + j, r8(name_ptr + j))
        j = j + 1
      }
      w8(str_blob + str_off + name_len, 0)
      
      // Copy ret type to blob
      let ret_off = str_off + name_len + 1
      j = 0
      while j < ret_len {
        w8(str_blob + ret_off + j, r8(ret_ptr + j))
        j = j + 1
      }
      w8(str_blob + ret_off + ret_len, 0)
      
      // Write entry
      w32(fn_buf + i*32, str_off)         // name offset
      w32(fn_buf + i*32 + 4, name_len)
      w32(fn_buf + i*32 + 8, param_c)
      w32(fn_buf + i*32 + 12, ret_off)    // ret offset
      w32(fn_buf + i*32 + 16, ret_len)
      w32(fn_buf + i*32 + 20, ir_start)
      w32(fn_buf + i*32 + 24, ir_count)
      w32(fn_buf + i*32 + 28, 0)  // padding
      
      str_off = ret_off + ret_len + 1
      i = i + 1
    }
    file_write(fd, fn_buf, fnc * 32)
    file_write(fd, str_blob, total_str_bytes)
  }
  
  // Write IR records
  if irc > 0 {
    let ir_buf = mmap(irc * 40)
    i = 0
    while i < irc {
      w64(ir_buf + i*40, r64(ir + i*IRS))
      w64(ir_buf + i*40 + 8, r64(ir + i*IRS + 8))
      w64(ir_buf + i*40 + 16, r64(ir + i*IRS + 16))
      w64(ir_buf + i*40 + 24, r64(ir + i*IRS + 24))
      w64(ir_buf + i*40 + 32, r64(ir + i*IRS + 32))
      i = i + 1
    }
    file_write(fd, ir_buf, irc * 40)
  }
  
  file_close(fd)
  return 1
}

// Import functions + IR from .qobj
fn qobj_import(qobj_path) -> i64 {
  let fd = file_open(qobj_path, 0)
  if fd < 0 { return 0 }
  
  let hdr = mmap(20)
  let n = file_read(fd, hdr, 20)
  if n < 20 { file_close(fd); return 0 }
  
  let magic = r32(hdr)
  if magic != QOBJ_MAGIC { file_close(fd); return 0 }
  
  let fn_count = r32(hdr + 8)
  let ir_count = r32(hdr + 12)
  let total_str_bytes = r32(hdr + 16)
  
  // Read function entries
  let fn_buf = mmap(fn_count * 32)
  if fn_count > 0 {
    file_read(fd, fn_buf, fn_count * 32)
  }
  
  // Read string blob
  let str_blob = mmap(total_str_bytes)
  if total_str_bytes > 0 {
    file_read(fd, str_blob, total_str_bytes)
  }
  
  // Read IR records
  let imported_ir = mmap(ir_count * 40)
  if ir_count > 0 {
    file_read(fd, imported_ir, ir_count * 40)
  }
  
  // Register functions
  let i = 0
  while i < fn_count {
    let name_off = r32(fn_buf + i*32)
    let name_len = r32(fn_buf + i*32 + 4)
    let param_c = r32(fn_buf + i*32 + 8)
    let ret_off = r32(fn_buf + i*32 + 12)
    let ret_len = r32(fn_buf + i*32 + 16)
    let ir_start = r32(fn_buf + i*32 + 20)
    let ir_count_fn = r32(fn_buf + i*32 + 24)
    
    // Copy name to current strtab
    let name_ptr = strtab + strtablen
    let j = 0
    while j < name_len {
      w8(strtab + strtablen + j, r8(str_blob + name_off + j))
      j = j + 1
    }
    w8(strtab + strtablen + name_len, 0)
    strtablen = strtablen + name_len + 1
    
    // Copy ret type to current strtab
    let ret_ptr = strtab + strtablen
    j = 0
    while j < ret_len {
      w8(strtab + strtablen + j, r8(str_blob + ret_off + j))
      j = j + 1
    }
    w8(strtab + strtablen + ret_len, 0)
    strtablen = strtablen + ret_len + 1
    
    // Register function
    let new_fi = fnc
    sfn(fnc, name_ptr, name_len, 0, 0, param_c, ret_ptr, ret_len)
    w64(fn_is_imported + fnc*8, 1)
    
    // Copy IR records for this function
    if ir_count_fn > 0 {
      w64(fn_ir_start + fnc*8, irc)
      w64(fn_ir_count + fnc*8, ir_count_fn)
      
      j = 0
      while j < ir_count_fn {
        let src_ir = imported_ir + (ir_start + j) * 40
        let dst_ir = irc
        w64(ir + dst_ir*IRS, r64(src_ir))
        w64(ir + dst_ir*IRS + 8, r64(src_ir + 8))
        w64(ir + dst_ir*IRS + 16, r64(src_ir + 16))
        w64(ir + dst_ir*IRS + 24, r64(src_ir + 24))
        w64(ir + dst_ir*IRS + 32, r64(src_ir + 32))
        irc = irc + 1
        j = j + 1
      }
    }
    
    fnc = fnc + 1
    i = i + 1
  }
  
  file_close(fd)
  return 1
}