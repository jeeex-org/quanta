// mmap wrapper for compatibility with existing simd_test pattern
// The builtin mmap takes 6 args (addr, len, prot, flags, fd, offset)
// This wrapper takes just len and returns an anonymous mapping

fn mmap(size) {
    return mmap(0, size, 3, 0x22, -1, 0)  // PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS
}
