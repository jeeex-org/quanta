// stdlib_gguf_meta_test -- scalar and array metadata reads must be exact.
//
// Both bugs here are in gguf.quanta, which every GGUF test depends on, so both
// were invisible until LFM2 needed them:
//
//  1. gguf_kv_float() read an f32 KV with f64of(mem_load(b)). f64of reinterprets
//     its argument as a 64-bit float pattern, but only 4 bytes had been read, so
//     the result was a zero-extended f32 pattern -- which is not a valid f64 and
//     denormalises to ~1e-315. Every f32 metadata value read as 0 or a denormal.
//     LFM2's rope.freq_base (1e7) and layer_norm_rms_epsilon (1e-5) both came
//     back 0.0, which would have produced a RoPE base of zero and no norm epsilon.
//     Fixed to widen through f32_to_f64(), which is exact for normals.
//
//  2. Numeric arrays recorded no count, element type or data offset: those three
//     were only stored inside the `etype == 8` (string) branch. An i32 array
//     reported count -1 and offset -1, so a caller seeking to that offset read
//     from before the start of the file. LFM2's lfm2.attention.head_count_kv is an
//     i32 array of 30 per-layer KV head counts.
//
// The string-array helpers (gguf_kv_arr_count / elem_off / elem_len / slurp)
// keep their `etype == 8` precondition on purpose: they walk length-prefixed
// elements and would read nonsense on a numeric array. Numeric arrays get their
// own accessors.

import std/fs
import std/gguf
import std/math

let MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

fn main() {
    if gguf_load(MODEL) != 0 { print("FAIL gguf_load"); return 1 }

    // ---- 1. f32 metadata --------------------------------------------------
    let rb = gguf_kv_find("lfm2.rope.freq_base")
    if rb < 0 { print("FAIL no rope.freq_base"); return 1 }
    let rope = gguf_kv_float(rb)
    // 1e7 exactly. Compared as bits: any denormal or zero fails this.
    if rope <= 9999999.0 || rope >= 10000001.0 {
        prints("FAIL rope_base bits=")
        print(rope)
        return 1
    }
    let eb = gguf_kv_find("lfm2.attention.layer_norm_rms_epsilon")
    if eb < 0 { print("FAIL no rms eps"); return 1 }
    let eps = gguf_kv_float(eb)
    // 1e-5. The old bug denormalised this to ~1e-315, which printed 0.000000.
    if eps <= 0.0 || eps >= 0.001 {
        prints("FAIL rms_eps bits=")
        print(eps)
        return 1
    }

    // ---- 2. numeric array metadata ---------------------------------------
    let kv = gguf_kv_find("lfm2.attention.head_count_kv")
    if kv < 0 { print("FAIL no head_count_kv"); return 1 }
    let cnt = gguf_kv_arr_count_any(kv)
    if cnt != 30 { prints("FAIL count_any="); print(cnt); return 1 }
    if gguf_kv_arr_etype(kv) != 5 { prints("FAIL etype="); print(gguf_kv_arr_etype(kv)); return 1 }
    if gguf_kv_arr_esize(kv) != 4 { prints("FAIL esize="); print(gguf_kv_arr_esize(kv)); return 1 }

    // The string accessor must STILL refuse a numeric array -- that guard is
    // what protects every string-array caller. If it stopped refusing, all of
    // gguf_kv_arr_elem_bytes() / slurp() would misread this array.
    if gguf_kv_arr_count(kv) != -1 { print("FAIL string accessor accepted a numeric array"); return 1 }

    // 8 layers carry 8 KV heads; the other 22 are conv-only and read 0. The
    // 8 nonzero positions are exactly the attention layers.
    let cell = mem_alloc(8)
    let i = 0
    let nonzero = 0
    while i < 30 {
        if gguf_kv_arr_elem_num(kv, i, cell) != 4 { prints("FAIL elem read at "); print(i); return 1 }
        let v = mem_load(cell)
        if v == 8 { nonzero = nonzero + 1 }
        if v != 0 && v != 8 { prints("FAIL nkv["); print(i); prints("]="); print(v); return 1 }
        i = i + 1
    }
    if nonzero != 8 { prints("FAIL attention layers="); print(nonzero); return 1 }

    print("OK gguf-meta")
    return 0
}