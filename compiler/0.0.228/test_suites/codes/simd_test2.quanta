// Test SIMD 2-wide operations
fn main() {
    let a = mmap(16)
    let b = mmap(16)
    let c = mmap(16)
    
    vec_set(a, 0, i2f(1))
    vec_set(a, 1, i2f(2))
    vec_set(b, 0, i2f(5))
    vec_set(b, 1, i2f(6))
    
    vec_add(c, a, b)
    
    let r0 = f2i(vec_get(c, 0))
    let r1 = f2i(vec_get(c, 1))
    
    // [1+5, 2+6] = [6, 8]
    if r0 != 6 { return 1 }
    if r1 != 8 { return 1 }
    
    return 0
}