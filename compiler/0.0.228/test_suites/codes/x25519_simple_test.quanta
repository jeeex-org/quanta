// x25519_simple_test.quanta — minimal x25519 test

import std/x25519

fn main() {
  println("Test 1: scalar=1, u=9...")
  let scalar = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(scalar + i, 0); i = i + 1 }
  mem_store8(scalar, 1)
  
  let u = mem_alloc(32)
  i = 0
  while i < 32 { mem_store8(u + i, 0); i = i + 1 }
  mem_store8(u, 9)
  
  let out = mem_alloc(32)
  x25519(scalar, u, out)
  
  println("Test 1 done")
  
  // Check out == u
  let match = 1
  i = 0
  while i < 32 {
    if mem_load8(out + i) != mem_load8(u + i) {
      match = 0
    }
    i = i + 1
  }
  
  if match == 1 {
    println("PASS")
  } else {
    println("FAIL")
  }
  
  println(0)
  exit(0)
}