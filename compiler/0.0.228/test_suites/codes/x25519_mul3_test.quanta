// x25519_mul3_test.quanta — test fe_mul with A24

import std/x25519

fn main() {
  println("Test fe_mul with A24...")
  
  let A24 = mem_alloc(8*8)
  fe_zero(A24)
  mem_store(A24, 121666)
  
  let t1 = mem_alloc(8*8)
  fe_zero(t1)
  mem_store(t1, 1)
  
  let out = mem_alloc(8*8)
  fe_mul(t1, A24, out)
  
  println("Done")
  println(0)
  exit(0)
}