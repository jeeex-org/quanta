import std/fs
import std/gguf

// Checks raw tensor records against the real model.
//
// HISTORY: this test asserted `gguf_tensor_offset(0) == 0` and
// `gguf_tensor_offset(1) == 215040000`. Those are the RELATIVE offsets stored in
// the tensor-info table, but gguf_tensor_offset() returns an ABSOLUTE file
// offset -- it adds gguf_data_offset() itself (gguf.quanta:373). Measured on the
// real file: tensor 0 is at absolute 8239136 with relative 0, and tensor 1 is at
// absolute 223279136 with relative 215040000.
//
// So the assertions could never both hold, and the test returned rc=1. It was
// simply never run: it was not in EXPECTED_STDLIB.tsv. That is the concrete cost
// of the ungated-loader gap recorded in docs/plans/model-loader-features.md --
// a broken test sat in the tree looking fine. Now that it is gated it checks
// both forms, which is the stronger statement anyway.
fn main() {
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { return 1 }

    // tensor 0: token_embd.weight, Q6_K (14), 262144000 elements, relative offset 0
    if gguf_tensor_dtype(0) != 14 { return 1 }
    if gguf_tensor_nelements(0) != 262144000 { return 1 }
    // Assert the ABSOLUTE value, not `offset - data_start`: that difference
    // cancels out any change to how the offset is composed, so it passed even
    // with gguf_tensor_offset() returning a relative value. Verified by
    // mutation -- dropping gguf_data_offset() from the accessor left this test
    // green. Measured absolute values: tensor 0 = 8239136, tensor 1 = 223279136.
    if gguf_tensor_offset(0) != 8239136 { return 1 }

    // tensor 1: token_embd_norm.weight, F32 (0), relative offset 215040000
    if gguf_tensor_dtype(1) != 0 { return 1 }
    if gguf_tensor_offset(1) != 223279136 { return 1 }

    // tensor 2: relative offset 215048192 -- proves the chain advances by the
    // tensor's own byte size, 2048 * 4 bytes.
    if gguf_tensor_offset(2) != 223287328 { return 1 }

    gguf_close()
    return 0
}
