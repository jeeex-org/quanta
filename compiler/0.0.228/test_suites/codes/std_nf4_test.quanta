import std/gguf

// NF4 (bitsandbytes) dequant test.
// 2-array format: packed 4-bit weights + f32 absmax scales.
// Reference: bitsandbytes csrc/kernels.cu

fn main() -> i64 {
    let failures = 0

    // ---- Test 1: 64 elements, blocksize=64, 1 block ----
    // absmax=[0.5] (f32 0x3F000000)
    // packed: 32 bytes, byte i = (high_nibble << 4) | low_nibble
    //   byte 0: nibbles [0, 1] -> values code[0]*0.5, code[1]*0.5
    //   byte 1: nibbles [2, 3] -> values code[2]*0.5, code[3]*0.5
    //   ...
    //   byte 31: nibbles [30, 31] -> values code[30]*0.5, code[31]*0.5
    // where code = NF4 codebook (16 entries, repeated twice)
    {
        let raw_q = mem_alloc(32)    // 32 bytes = 64 nibbles
        let raw_absmax = mem_alloc(4) // 1 f32
        let out = mem_alloc(512)      // 64 f64

        // absmax = [0.5]
        mem_store(raw_absmax, 0x3F000000)

        // packed bytes: byte i = (i%16) * 17, so both nibbles = i%16
        // byte 0 = 0x00, byte 1 = 0x11, ..., byte 15 = 0xFF, byte 16 = 0x00, ...
        // NF4 unpack: even j uses high nibble, odd j uses low nibble
        // So nibble for element j = (j/2) % 16
        let i = 0
        while i < 32 {
            let n = i % 16
            mem_store8(raw_q + i, n * 17)
            i = i + 1
        }

        dequant_nf4_flat(raw_q, raw_absmax, 64, 64, out)

        // NF4 codebook (from nf4_k):
        // 0: -1.0, 1: -0.696, 2: -0.525, 3: -0.395, 4: -0.284, 5: -0.185, 6: -0.091, 7: 0.0
        // 8: 0.0796, 9: 0.161, 10: 0.246, 11: 0.338, 12: 0.441, 13: 0.563, 14: 0.723, 15: 1.0
        let scale = f32_to_f64(raw_absmax)
        let ok = 1
        let j = 0
        while j < 64 {
            let nib = (j / 2) % 16  // codebook index: both nibbles of byte j/2 are (j/2)%16
            let expected = fmul(scale, f64of(nf4_k(nib)))
            let v = f64of(mem_load(out + j*8))
            if v != expected {
                print("NF4 T1 FAIL at ", j, ": got ", f64bits(v), " expected ", f64bits(expected), "\n")
                ok = 0
            }
            j = j + 1
        }
        if ok == 0 { failures = failures + 1 }
        else { print("NF4 T1 (64 elems, 1 block): PASS\n") }
    }

    // ---- Test 2: 128 elements, blocksize=64, 2 blocks ----
    // absmax = [1.0, 0.5] (f32 0x3F800000, 0x3F000000)
    // Block 0: all nibbles = 15 -> code[15] = 1.0 -> output = 1.0 * 1.0 = 1.0
    // Block 1: all nibbles = 0 -> code[0] = -1.0 -> output = -1.0 * 0.5 = -0.5
    {
        let raw_q = mem_alloc(64)    // 64 bytes = 128 nibbles
        let raw_absmax = mem_alloc(8) // 2 f32
        let out = mem_alloc(1024)     // 128 f64

        // absmax = [1.0, 0.5]
        mem_store(raw_absmax, 0x3F800000)
        mem_store(raw_absmax + 4, 0x3F000000)

        // Block 0: all bytes = 0xFF (nibbles 15, 15)
        let i = 0
        while i < 32 {
            mem_store8(raw_q + i, 0xFF)
            i = i + 1
        }
        // Block 1: all bytes = 0x00 (nibbles 0, 0)
        i = 0
        while i < 32 {
            mem_store8(raw_q + 32 + i, 0x00)
            i = i + 1
        }

        dequant_nf4_flat(raw_q, raw_absmax, 128, 64, out)

        let ok = 1
        // Block 0: all 1.0
        let j = 0
        while j < 64 {
            let v = f64of(mem_load(out + j*8))
            if v != 1.0 {
                print("NF4 T2 FAIL block0 at ", j, ": got ", f64bits(v), " expected 1.0\n")
                ok = 0
            }
            j = j + 1
        }
        // Block 1: all -0.5 (scale=0.5, code[0]=-1.0)
        let scale1 = f32_to_f64(raw_absmax + 4)
        let code0 = f64of(nf4_k(0))
        let expected1 = fmul(scale1, code0)
        j = 0
        while j < 64 {
            let v = f64of(mem_load(out + (64+j)*8))
            if v != expected1 {
                print("NF4 T2 FAIL block1 at ", j, ": got ", f64bits(v), " expected ", f64bits(expected1), "\n")
                ok = 0
            }
            j = j + 1
        }
        if ok == 0 { failures = failures + 1 }
        else { print("NF4 T2 (128 elems, 2 blocks): PASS\n") }
    }

    if failures > 0 {
        print("std_nf4_test: ", failures, " FAILURES\n")
        return 1
    }
    print("std_nf4_test: all pass\n")
    return 0
}
