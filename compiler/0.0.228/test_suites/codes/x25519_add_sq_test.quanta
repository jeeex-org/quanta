// x25519_add_sq_test.quanta — test fe_add then fe_sq

import std/x25519

fn main() {
  println("Test fe_add then fe_sq...")
  
  let a = mem_alloc(8*8)
  fe_zero(a)
  mem_store(a, 9)
  
  let b = mem_alloc(8*8)
  fe_zero(b)
  mem_store(b, 81)
  
  let t = mem_alloc(8*8)
  fe_add(a, b, t)
  println("add done")
  
  let out = mem_alloc(8*8)
  fe_sq(t, out)
  println("sq done")
  
  println("Done")
  println(0)
  exit(0)
}