// 0.0.121 closure captures are BY REFERENCE to the enclosing frame slot.
// Mutating the captured local afterwards IS seen by the closure, so f(1) = 100
// (NOT a value snapshot of 11). This is the expected by-ref behaviour; if you
// want value-snapshot semantics, that is a distinct feature not in 0.0.121.
fn main() {
    let y = 10
    let f = |x| { x + y }
    y = 99
    return f(1)        // 100 (by-ref: sees the mutated y)
}
