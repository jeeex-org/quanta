import std/map
// Comprehensive coverage of lib/std/map: new, put, get, has (incl. overwrite & miss).
fn main() {
  let ok = 0
  let m = map_new()
  map_put(m, "a", 11)
  map_put(m, "b", 22)
  map_put(m, "c", 33)
  map_put(m, "a", 10)   // overwrite
  if map_get(m, "a") == 10 { ok = ok + 1 }
  if map_get(m, "b") == 22 { ok = ok + 1 }
  if map_get(m, "c") == 33 { ok = ok + 1 }
  if map_get(m, "z") == -1 { ok = ok + 1 }   // miss
  if map_has(m, "a") == 1 { ok = ok + 1 }    // present
  if map_has(m, "z") == 0 { ok = ok + 1 }    // absent
  // total = 4 + 2 = 6
  exit(ok)   // expect 6
}
