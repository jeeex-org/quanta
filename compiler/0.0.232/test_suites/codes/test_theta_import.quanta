import std/sha3_constants_v2

fn keccak_theta(st) {
  let C = malloc(40)
  let i = 0
  while (i < 5) {
    let sum = 0
    let j = 0
    while (j < 5) {
      let idx = i + j * 5
      let lane = mem_load(st + idx * 8)
      sum = sum ^ lane
      j = j + 1
    }
    mem_store(C + i * 8, sum)
    i = i + 1
  }
  let i2 = 0
  while (i2 < 5) {
    let c_left = mem_load(C + ((i2 + 4) % 5) * 8)
    let c_right_raw = mem_load(C + ((i2 + 1) % 5) * 8)
    let c_right = ((c_right_raw << 1) | (c_right_raw >> 63)) & 0xFFFFFFFFFFFFFFFF
    let D = c_left ^ c_right
    let j2 = 0
    while (j2 < 5) {
      let idx2 = i2 + j2 * 5
      let lane2 = mem_load(st + idx2 * 8)
      mem_store(st + idx2 * 8, lane2 ^ D)
      j2 = j2 + 1
    }
    i2 = i2 + 1
  }
}

extern fn malloc(size: u64) -> u64

fn main() {
  let st = malloc(200)
  let i = 0
  while (i < 25) { mem_store(st + i * 8, 0); i = i + 1 }
  keccak_theta(st)
  exit(0)
}