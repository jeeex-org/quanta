import std/secure
fn main() {
  // krot(1, 32) should = 0x0000000100000000 (bit 0 -> bit 32)
  let a = krot(1, 32)
  let wa = 0x0000000100000000
  let da = a ^ wa
  // krot(1, 63) should = 0x8000000000000000 (bit 0 -> bit 63)
  let b = krot(1, 63)
  let wb = 0x8000000000000000
  let db = b ^ wb
  // krot(0x100000000, 1) should = 0x0000000200000000 (bit 32 -> bit 33)
  let c = krot(0x100000000, 1)
  let wc = 0x0000000200000000
  let dc = c ^ wc
  if da == 0 && db == 0 && dc == 0 { exit(0) } else { exit(1) }
}
