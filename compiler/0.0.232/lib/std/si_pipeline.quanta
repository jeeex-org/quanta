// std/si_pipeline.quanta - Self-Improvement Pipeline Orchestrator
// Ties together: spec_parser → spec_to_ir → code_synthesizer → test_generator

module std_si_pipeline;

import std/spec_parser
import std/spec_to_ir
import std/code_synthesizer
import std/test_generator

// SI Pipeline Phase 1: Detect gaps (parse gap_specs.json)
fn phase1_detect_gaps() -> i64 {
    prints("=== SI Phase 1: Gap Detection ===\n");
    let count = parse_gap_specs("gap_specs.json");
    printi(count); prints(" gaps detected\n");
    return count;
}

// SI Pipeline Phase 2: Generate IR from specs
fn phase2_generate_ir() -> i64 {
    prints("=== SI Phase 2: Generate IR ===\n");
    let specs_arr = load_gap_specs("gap_specs.json");
    if specs_arr == 0 { return 0; }
    let count = get_spec_count(specs_arr);
    printi(count); prints(" specs mapped to IR\n");
    return count;
}

// SI Pipeline Phase 3: Synthesize code from IR
fn phase3_synthesize() -> i64 {
    prints("=== SI Phase 3: Code Synthesis ===\n");
    let count = synthesize_all("gap_specs.json");
    printi(count); prints(" modules synthesized\n");
    return count;
}

// SI Pipeline Phase 4: Generate tests for synthesized code
fn phase4_generate_tests() -> i64 {
    prints("=== SI Phase 4: Test Generation ===\n");
    let count = generate_all("gap_specs.json");
    printi(count); prints(" tests generated\n");
    return count;
}

// SI Pipeline Phase 5: Run tests (placeholder - actual test running is done by CI)
fn phase5_run_tests() -> i64 {
    prints("=== SI Phase 5: Run Tests ===\n");
    prints("Tests are run by CI gate (./test_suites/scripts/run_tests.sh)\n");
    return 1;
}

// SI Pipeline Phase 6: Merge (placeholder - requires human review)
fn phase6_merge() -> i64 {
    prints("=== SI Phase 6: Merge ===\n");
    prints("Merge requires human review gate\n");
    return 1;
}

// Run full SI pipeline
fn run_pipeline() -> i64 {
    prints("\n");
    prints("╔══════════════════════════════════════════════════╗\n");
    prints("║  Quanta Self-Improvement Pipeline v1.0           ║\n");
    prints("╚══════════════════════════════════════════════════╝\n");
    prints("\n");

    let gaps = phase1_detect_gaps();
    if gaps == 0 {
        prints("No gaps detected. SI pipeline complete.\n");
        return 0;
    }

    let ir_count = phase2_generate_ir();
    let synth_count = phase3_synthesize();
    let test_count = phase4_generate_tests();
    let tests_passed = phase5_run_tests();
    let merged = phase6_merge();

    prints("\n");
    prints("╔══════════════════════════════════════════════════╗\n");
    prints("║  SI Pipeline Summary                             ║\n");
    prints("╠══════════════════════════════════════════════════╣\n");
    prints("║  Gaps detected:     "); printi(gaps); prints("\n");
    prints("║  IR specs mapped:   "); printi(ir_count); prints("\n");
    prints("║  Modules synthesized: "); printi(synth_count); prints("\n");
    prints("║  Tests generated:   "); printi(test_count); prints("\n");
    prints("║  Tests passed:      "); printi(tests_passed); prints("\n");
    prints("║  Merged:            "); printi(merged); prints("\n");
    prints("╚══════════════════════════════════════════════════╝\n");

    return 0;
}

fn init() -> i64 {
    return 0;
}

fn main() -> i64 {
    return run_pipeline();
}
