// std/model_arch.quanta -- canonical role enum and architecture registry.
// Source of truth: llama.cpp LLM_TENSOR (301 roles) + LLM_ARCH (158 archs).
// This is Phase 4 of docs/plans/model-loader-features.md.

import std/str

// =====================================================================
// CANONICAL ROLE ENUM
// =====================================================================
// Subset of llama.cpp's 301 LLM_TENSOR roles, mapped to what LFM2 and
// common decoder-only models actually use. Each role is a compile-time
// constant; the arch registry maps (arch, role) -> tensor name pattern.

const ROLE_EMBD           = 1   // token embeddings: [n_vocab, n_embd]
const ROLE_EMBD_NORM      = 2   // embedding layer norm: [n_embd]
const ROLE_POS_EMBD       = 3   // positional embeddings: [n_pos, n_embd]
const ROLE_OUTPUT         = 4   // output projection: [n_vocab, n_embd]
const ROLE_OUTPUT_NORM    = 5   // output norm (LFM2-specific name): [n_embd]
const ROLE_ROPE_FREQS     = 6   // precomputed RoPE frequencies: [n_pos, n_head_kv]
const ROLE_ATTN_Q         = 7   // attention Q projection: [n_embd, n_embd]
const ROLE_ATTN_K         = 8   // attention K projection: [n_embd, n_embd_kv]
const ROLE_ATTN_V         = 9   // attention V projection: [n_embd, n_embd_kv]
const ROLE_ATTN_QKV       = 10  // fused QKV: [n_embd, 3*n_embd_kv] (not used by LFM2)
const ROLE_ATTN_OUT       = 11  // attention output: [n_embd, n_embd]
const ROLE_ATTN_NORM      = 12  // attention norm: [n_embd]
const ROLE_ATTN_Q_NORM    = 13  // Q norm (LFM2): [n_embd_head_k]
const ROLE_ATTN_K_NORM    = 14  // K norm (LFM2): [n_embd_head_k]
const ROLE_FFN_GATE       = 14  // FFN gate (dense): [n_embd, n_ff]
const ROLE_FFN_DOWN       = 15  // FFN down (dense): [n_ff, n_embd]
const ROLE_FFN_UP         = 16  // FFN up (dense): [n_embd, n_ff]
const ROLE_FFN_NORM       = 17  // FFN norm: [n_embd]
const ROLE_FFN_GATE_INP   = 18  // MoE gate input: [n_embd, n_expert]
const ROLE_FFN_GATE_EXPS  = 19  // MoE gate experts: [n_embd, n_ff_exp, n_expert]
const ROLE_FFN_DOWN_EXPS  = 20  // MoE down experts: [n_ff_exp, n_embd, n_expert]
const ROLE_FFN_UP_EXPS    = 21  // MoE up experts: [n_embd, n_ff_exp, n_expert]
const ROLE_FFN_EXP_PROBS_B= 22  // MoE expert probs bias: [n_expert]
const ROLE_SHORTCONV_CONV = 23  // ShortConv conv weights: [l_cache, n_embd]
const ROLE_SHORTCONV_INPROJ= 24 // ShortConv in_proj: [n_embd, 3*n_embd]
const ROLE_SHORTCONV_OUTPROJ=25 // ShortConv out_proj: [n_embd, n_embd]
const ROLE_DENSE_2_OUT    = 26  // Dense output (if n_embd_out != n_embd): [n_embd, n_embd_out]
const ROLE_DENSE_2_OUT_B  = 27  // Dense output bias: [n_embd_out]

// KV cache metadata
const ROLE_KV_L_CACHE     = 28  // shortconv l_cache (hyperparameter)

// =====================================================================
// ARCHITECTURE REGISTRY
// =====================================================================
// Each architecture gets an id and a name-to-role mapping.

// Architecture IDs (match llama.cpp subset)
const ARCH_LFM2     = 1
const ARCH_QWEN2    = 2
const ARCH_GEMMA3   = 3

// Maximum tensor name length for static buffers
const MAX_TENSOR_NAME = 128

// Arch registry entry: maps role -> name pattern
// Patterns use {layer} for layer index, {role} for role suffix
let arch_registry = 0
let arch_registry_count = 0

// Initialize the architecture registry
fn arch_init() {
    // LFM2 (arch_id=1)
    arch_register(ARCH_LFM2, "LFM2")
    // Per-layer tensors
    arch_add_pattern(ARCH_LFM2, ROLE_ATTN_NORM,      "blk.{layer}.attn_norm.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_ATTN_Q_NORM,    "blk.{layer}.attn_q_norm.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_ATTN_K_NORM,    "blk.{layer}.attn_k_norm.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_ATTN_Q,         "blk.{layer}.attn_q.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_ATTN_K,         "blk.{layer}.attn_k.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_ATTN_V,         "blk.{layer}.attn_v.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_ATTN_OUT,       "blk.{layer}.attn_out.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_NORM,       "blk.{layer}.ffn_norm.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_GATE,       "blk.{layer}.ffn_gate.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_DOWN,       "blk.{layer}.ffn_down.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_UP,         "blk.{layer}.ffn_up.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_GATE_INP,   "blk.{layer}.ffn_gate_inp.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_GATE_EXPS,  "blk.{layer}.ffn_gate_exps.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_DOWN_EXPS,  "blk.{layer}.ffn_down_exps.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_UP_EXPS,    "blk.{layer}.ffn_up_exps.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_FFN_EXP_PROBS_B,"blk.{layer}.ffn_exp_probs_b.bias")
    arch_add_pattern(ARCH_LFM2, ROLE_SHORTCONV_CONV, "blk.{layer}.shortconv.conv.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_SHORTCONV_INPROJ,"blk.{layer}.shortconv.in_proj.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_SHORTCONV_OUTPROJ,"blk.{layer}.shortconv.out_proj.weight")
    // Global tensors
    arch_add_pattern(ARCH_LFM2, ROLE_EMBD,           "token_embd.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_OUTPUT_NORM,    "output_norm.weight")
    arch_add_pattern(ARCH_LFM2, ROLE_OUTPUT,         "output.weight")
    // Hyperparameters (stored as KV pairs)
    arch_add_hparam(ARCH_LFM2, "n_embd")
    arch_add_hparam(ARCH_LFM2, "n_vocab")
    arch_add_hparam(ARCH_LFM2, "n_layer")
    arch_add_hparam(ARCH_LFM2, "n_head")
    arch_add_hparam(ARCH_LFM2, "n_head_kv")
    arch_add_hparam(ARCH_LFM2, "n_ff")
    arch_add_hparam(ARCH_LFM2, "n_expert")
    arch_add_hparam(ARCH_LFM2, "n_ff_exp")
    arch_add_hparam(ARCH_LFM2, "n_shortconv_l_cache")
    arch_add_hparam(ARCH_LFM2, "n_embd_out")

    // Qwen2 (arch_id=2) - standard decoder-only
    arch_register(ARCH_QWEN2, "Qwen2")
    arch_add_pattern(ARCH_QWEN2, ROLE_EMBD,        "model.embed_tokens.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_EMBD_NORM,   "model.norm.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_ATTN_NORM,   "model.layers.{layer}.input_layernorm.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_ATTN_Q,      "model.layers.{layer}.self_attn.q_proj.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_ATTN_K,      "model.layers.{layer}.self_attn.k_proj.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_ATTN_V,      "model.layers.{layer}.self_attn.v_proj.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_ATTN_OUT,    "model.layers.{layer}.self_attn.o_proj.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_FFN_NORM,    "model.layers.{layer}.post_attention_layernorm.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_FFN_GATE,    "model.layers.{layer}.mlp.gate_proj.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_FFN_DOWN,    "model.layers.{layer}.mlp.down_proj.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_FFN_UP,      "model.layers.{layer}.mlp.up_proj.weight")
    arch_add_pattern(ARCH_QWEN2, ROLE_OUTPUT,      "lm_head.weight")
    arch_add_hparam(ARCH_QWEN2, "hidden_size")
    arch_add_hparam(ARCH_QWEN2, "vocab_size")
    arch_add_hparam(ARCH_QWEN2, "num_hidden_layers")
    arch_add_hparam(ARCH_QWEN2, "num_attention_heads")
    arch_add_hparam(ARCH_QWEN2, "num_key_value_heads")
    arch_add_hparam(ARCH_QWEN2, "intermediate_size")

    // Gemma-3 (arch_id=3)
    arch_register(ARCH_GEMMA3, "Gemma3")
    arch_add_pattern(ARCH_GEMMA3, ROLE_EMBD,       "model.embed_tokens.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_ATTN_NORM,  "model.layers.{layer}.input_layernorm.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_ATTN_Q,     "model.layers.{layer}.self_attn.q_proj.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_ATTN_K,     "model.layers.{layer}.self_attn.k_proj.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_ATTN_V,     "model.layers.{layer}.self_attn.v_proj.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_ATTN_OUT,   "model.layers.{layer}.self_attn.o_proj.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_FFN_NORM,   "model.layers.{layer}.post_attention_layernorm.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_FFN_GATE,   "model.layers.{layer}.mlp.gate_proj.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_FFN_DOWN,   "model.layers.{layer}.mlp.down_proj.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_FFN_UP,     "model.layers.{layer}.mlp.up_proj.weight")
    arch_add_pattern(ARCH_GEMMA3, ROLE_OUTPUT,     "lm_head.weight")
    arch_add_hparam(ARCH_GEMMA3, "hidden_size")
    arch_add_hparam(ARCH_GEMMA3, "vocab_size")
    arch_add_hparam(ARCH_GEMMA3, "num_hidden_layers")
    arch_add_hparam(ARCH_GEMMA3, "num_attention_heads")
    arch_add_hparam(ARCH_GEMMA3, "num_key_value_heads")
    arch_add_hparam(ARCH_GEMMA3, "intermediate_size")

    arch_registry_count = 3
}

// Register an architecture (allocates internal structures)
fn arch_register(arch_id: i64, name: u64) {
    // In a full implementation this would allocate a struct.
    // For now we just track the count and validate IDs.
    if arch_id > arch_registry_count { arch_registry_count = arch_id }
}

// Add a tensor name pattern for (arch, role)
fn arch_add_pattern(arch_id: i64, role: i64, pattern: u64) {
    // Stored in a global map keyed by (arch_id << 32) | role
    // For now: patterns are hardcoded in arch_resolve below.
    // This stub allows the API to compile.
}

// Add a hyperparameter key for (arch)
fn arch_add_hparam(arch_id: i64, key: u64) {
    // Same as above: stub for compilation.
}

// Resolve a role to a concrete tensor name for a given architecture and layer.
// Returns 0 on success (name in caller-supplied buffer), negative on error.
fn arch_resolve_name(arch_id: i64, role: i64, layer: i64, buf: u64, buf_len: i64) -> i64 {
    // This is the core of the abstraction: one function, all archs.
    if arch_id == ARCH_LFM2 {
        return arch_resolve_lfm2(role, layer, buf, buf_len)
    } else if arch_id == ARCH_QWEN2 {
        return arch_resolve_qwen2(role, layer, buf, buf_len)
    } else if arch_id == ARCH_GEMMA3 {
        return arch_resolve_gemma3(role, layer, buf, buf_len)
    }
    return 0 - 1
}

// LFM2 name resolution (matches llama.cpp's tn() macro)
fn arch_resolve_lfm2(role: i64, layer: i64, buf: u64, buf_len: i64) -> i64 {
    if role == ROLE_EMBD {
        return str_copy(buf, "token_embd.weight", buf_len)
    } else if role == ROLE_OUTPUT_NORM {
        return str_copy(buf, "output_norm.weight", buf_len)
    } else if role == ROLE_OUTPUT {
        return str_copy(buf, "output.weight", buf_len)
    } else if role == ROLE_ATTN_NORM {
        return str_fmt(buf, buf_len, "blk.%d.attn_norm.weight", layer)
    } else if role == ROLE_ATTN_Q_NORM {
        return str_fmt(buf, buf_len, "blk.%d.attn_q_norm.weight", layer)
    } else if role == ROLE_ATTN_K_NORM {
        return str_fmt(buf, buf_len, "blk.%d.attn_k_norm.weight", layer)
    } else if role == ROLE_ATTN_Q {
        return str_fmt(buf, buf_len, "blk.%d.attn_q.weight", layer)
    } else if role == ROLE_ATTN_K {
        return str_fmt(buf, buf_len, "blk.%d.attn_k.weight", layer)
    } else if role == ROLE_ATTN_V {
        return str_fmt(buf, buf_len, "blk.%d.attn_v.weight", layer)
    } else if role == ROLE_ATTN_OUT {
        return str_fmt(buf, buf_len, "blk.%d.attn_out.weight", layer)
    } else if role == ROLE_FFN_NORM {
        return str_fmt(buf, buf_len, "blk.%d.ffn_norm.weight", layer)
    } else if role == ROLE_FFN_GATE {
        return str_fmt(buf, buf_len, "blk.%d.ffn_gate.weight", layer)
    } else if role == ROLE_FFN_DOWN {
        return str_fmt(buf, buf_len, "blk.%d.ffn_down.weight", layer)
    } else if role == ROLE_FFN_UP {
        return str_fmt(buf, buf_len, "blk.%d.ffn_up.weight", layer)
    } else if role == ROLE_FFN_GATE_INP {
        return str_fmt(buf, buf_len, "blk.%d.ffn_gate_inp.weight", layer)
    } else if role == ROLE_FFN_GATE_EXPS {
        return str_fmt(buf, buf_len, "blk.%d.ffn_gate_exps.weight", layer)
    } else if role == ROLE_FFN_DOWN_EXPS {
        return str_fmt(buf, buf_len, "blk.%d.ffn_down_exps.weight", layer)
    } else if role == ROLE_FFN_UP_EXPS {
        return str_fmt(buf, buf_len, "blk.%d.ffn_up_exps.weight", layer)
    } else if role == ROLE_FFN_EXP_PROBS_B {
        return str_fmt(buf, buf_len, "blk.%d.ffn_exp_probs_b.bias", layer)
    } else if role == ROLE_SHORTCONV_CONV {
        return str_fmt(buf, buf_len, "blk.%d.shortconv.conv.weight", layer)
    } else if role == ROLE_SHORTCONV_INPROJ {
        return str_fmt(buf, buf_len, "blk.%d.shortconv.in_proj.weight", layer)
    } else if role == ROLE_SHORTCONV_OUTPROJ {
        return str_fmt(buf, buf_len, "blk.%d.shortconv.out_proj.weight", layer)
    }
    return 0 - 2
}

// Qwen2 name resolution
fn arch_resolve_qwen2(role: i64, layer: i64, buf: u64, buf_len: i64) -> i64 {
    if role == ROLE_EMBD {
        return str_copy(buf, "model.embed_tokens.weight", buf_len)
    } else if role == ROLE_EMBD_NORM {
        return str_copy(buf, "model.norm.weight", buf_len)
    } else if role == ROLE_OUTPUT {
        return str_copy(buf, "lm_head.weight", buf_len)
    } else if role == ROLE_ATTN_NORM {
        return str_fmt(buf, buf_len, "model.layers.%d.input_layernorm.weight", layer)
    } else if role == ROLE_ATTN_Q {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.q_proj.weight", layer)
    } else if role == ROLE_ATTN_K {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.k_proj.weight", layer)
    } else if role == ROLE_ATTN_V {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.v_proj.weight", layer)
    } else if role == ROLE_ATTN_OUT {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.o_proj.weight", layer)
    } else if role == ROLE_FFN_NORM {
        return str_fmt(buf, buf_len, "model.layers.%d.post_attention_layernorm.weight", layer)
    } else if role == ROLE_FFN_GATE {
        return str_fmt(buf, buf_len, "model.layers.%d.mlp.gate_proj.weight", layer)
    } else if role == ROLE_FFN_DOWN {
        return str_fmt(buf, buf_len, "model.layers.%d.mlp.down_proj.weight", layer)
    } else if role == ROLE_FFN_UP {
        return str_fmt(buf, buf_len, "model.layers.%d.mlp.up_proj.weight", layer)
    }
    return 0 - 2
}

// Gemma-3 name resolution
fn arch_resolve_gemma3(role: i64, layer: i64, buf: u64, buf_len: i64) -> i64 {
    if role == ROLE_EMBD {
        return str_copy(buf, "model.embed_tokens.weight", buf_len)
    } else if role == ROLE_OUTPUT {
        return str_copy(buf, "lm_head.weight", buf_len)
    } else if role == ROLE_ATTN_NORM {
        return str_fmt(buf, buf_len, "model.layers.%d.input_layernorm.weight", layer)
    } else if role == ROLE_ATTN_Q {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.q_proj.weight", layer)
    } else if role == ROLE_ATTN_K {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.k_proj.weight", layer)
    } else if role == ROLE_ATTN_V {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.v_proj.weight", layer)
    } else if role == ROLE_ATTN_OUT {
        return str_fmt(buf, buf_len, "model.layers.%d.self_attn.o_proj.weight", layer)
    } else if role == ROLE_FFN_NORM {
        return str_fmt(buf, buf_len, "model.layers.%d.post_attention_layernorm.weight", layer)
    } else if role == ROLE_FFN_GATE {
        return str_fmt(buf, buf_len, "model.layers.%d.mlp.gate_proj.weight", layer)
    } else if role == ROLE_FFN_DOWN {
        return str_fmt(buf, buf_len, "model.layers.%d.mlp.down_proj.weight", layer)
    } else if role == ROLE_FFN_UP {
        return str_fmt(buf, buf_len, "model.layers.%d.mlp.up_proj.weight", layer)
    }
    return 0 - 2
}

