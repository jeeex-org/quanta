// =====================================================================
// TENSOR KIND ENUM (for compute mapping in Phase 5)
// =====================================================================
// Each role implies a tensor kind that determines the compute path.
const KIND_MATRIX      = 1  // [rows, cols] -- mm_matvec
const KIND_MATRIX_T    = 2  // [cols, rows] -- mm_matvec_t (transposed)
const KIND_VECTOR      = 3  // [n] -- elementwise / add
const KIND_STATE       = 4  // per-layer recurrent state -- state update
const KIND_ROUTER      = 5  // router indices / probs -- special

// Get the tensor kind for a role
fn role_kind(role: i64) -> i64 {
    if role == ROLE_EMBD           { return KIND_MATRIX }
    if role == ROLE_EMBD_NORM      { return KIND_VECTOR }
    if role == ROLE_POS_EMBD       { return KIND_MATRIX }
    if role == ROLE_OUTPUT         { return KIND_MATRIX }
    if role == ROLE_OUTPUT_NORM    { return KIND_VECTOR }
    if role == ROLE_ROPE_FREQS     { return KIND_MATRIX }
    if role == ROLE_ATTN_Q         { return KIND_MATRIX }
    if role == ROLE_ATTN_K         { return KIND_MATRIX }
    if role == ROLE_ATTN_V         { return KIND_MATRIX }
    if role == ROLE_ATTN_QKV       { return KIND_MATRIX }
    if role == ROLE_ATTN_OUT       { return KIND_MATRIX }
    if role == ROLE_ATTN_NORM      { return KIND_VECTOR }
    if role == ROLE_ATTN_Q_NORM    { return KIND_VECTOR }
    if role == ROLE_ATTN_K_NORM    { return KIND_VECTOR }
    if role == ROLE_FFN_GATE       { return KIND_MATRIX }
    if role == ROLE_FFN_DOWN       { return KIND_MATRIX }
    if role == ROLE_FFN_UP         { return KIND_MATRIX }
    if role == ROLE_FFN_NORM       { return KIND_VECTOR }
    if role == ROLE_FFN_GATE_INP   { return KIND_MATRIX }
    if role == ROLE_FFN_GATE_EXPS  { return KIND_MATRIX }
    if role == ROLE_FFN_DOWN_EXPS  { return KIND_MATRIX }
    if role == ROLE_FFN_UP_EXPS    { return KIND_MATRIX }
    if role == ROLE_FFN_EXP_PROBS_B{ return KIND_VECTOR }
    if role == ROLE_SHORTCONV_CONV { return KIND_MATRIX }
    if role == ROLE_SHORTCONV_INPROJ{ return KIND_MATRIX }
    if role == ROLE_SHORTCONV_OUTPROJ{ return KIND_MATRIX }
    if role == ROLE_DENSE_2_OUT    { return KIND_MATRIX }
    if role == ROLE_DENSE_2_OUT_B  { return KIND_VECTOR }
    return KIND_MATRIX
}

