fn main() {
    // SIMD vec128: 16-byte buffers = 2x f64 packed double. Real SSE2/NEON
    // instructions (addpd / fadd v0.2d, mulpd / fmul v0.2d) operate on the
    // memory operands. Lanes set via vec_set, read via vec_get.
    let a = mmap(16)
    let b = mmap(16)
    let c = mmap(16)
    let d = mmap(16)
    vec_set(a, 0, i2f(3))          // a lane0 = 3.0
    vec_set(a, 1, i2f(4))          // a lane1 = 4.0
    vec_set(b, 0, i2f(1))          // b lane0 = 1.0
    vec_set(b, 1, i2f(2))          // b lane1 = 2.0
    vec_add(c, a, b)               // c = a+b = (4.0, 6.0)  via addpd/fadd v0.2d
    vec_mul(d, c, b)               // d = c*b = (4.0, 12.0) via mulpd/fmul v0.2d
    let r0 = f2i(vec_get(d, 0))    // 4
    let r1 = f2i(vec_get(d, 1))    // 12
    return r0 * 10 + r1            // 52
}
