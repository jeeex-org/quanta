// x25519_ladder_test2.quanta — test ladder step by step

import std/x25519

fn main() {
  println("Test ladder 1 iteration...")
  
  // Clamp scalar
  let k = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(k + i, 0); i = i + 1 }
  mem_store8(k, 1)
  mem_store8(k + 31, 64)
  
  // u = 9
  let u = mem_alloc(32)
  i = 0
  while i < 32 { mem_store8(u + i, 0); i = i + 1 }
  mem_store8(u, 9)
  
  // x1 = u
  let x1 = mem_alloc(8*8)
  fe_from_bytes(u, x1)
  
  // x2 = 1
  let x2 = mem_alloc(8*8)
  fe_one(x2)
  
  // z2 = 0
  let z2 = mem_alloc(8*8)
  fe_zero(z2)
  
  // x3 = u
  let x3 = mem_alloc(8*8)
  fe_from_bytes(u, x3)
  
  // z3 = 1
  let z3 = mem_alloc(8*8)
  fe_one(z3)
  
  // A24 = 121666
  let A24 = mem_alloc(8*8)
  fe_zero(A24)
  mem_store(A24, 121666)
  
  // Temp buffers
  let t0 = mem_alloc(8*8)
  let t1 = mem_alloc(8*8)
  let t2 = mem_alloc(8*8)
  let t3 = mem_alloc(8*8)
  let t4 = mem_alloc(8*8)
  
  println("Setup done")
  
  // One ladder step for bit 254 (which is 0 since k=1)
  let bit = 254
  let kbyte = bit >> 3
  let kbit = bit & 7
  let swap = (mem_load8(k + kbyte) >> kbit) & 1
  println("swap")
  println(swap)
  
  // Ladder step - do 2P first
  fe_add(x2, z2, t0)
  println("add1")
  fe_sq(t0, t2)
  println("sq1")
  fe_sub(x2, z2, t1)
  println("sub1")
  fe_sq(t1, t3)
  println("sq2")
  fe_mul(t2, t3, x2)
  println("mul1")
  
  // z2 = (t2 - t3) * t2 + A24 * (t2 - t3) * t3
  fe_sub(t2, t3, t4)
  println("sub2")
  fe_mul(t4, t2, t0)
  println("mul2")
  fe_mul(t4, t3, t1)
  println("mul3")
  fe_mul(t1, A24, t1)
  println("mul4")
  fe_add(t0, t1, z2)
  println("add2")
  
  // Now the x3, z3 step
  fe_add(x2, z2, t0)
  println("add3")
  fe_sub(x2, z2, t1)
  println("sub3")
  fe_add(x3, z3, t2)
  println("add4")
  fe_sub(x3, z3, t3)
  println("sub4")
  fe_mul(t0, t3, t4)
  println("mul5")
  fe_mul(t1, t2, t0)
  println("mul6")
  fe_add(t4, t0, t2)
  println("add5")
  fe_sq(t2, x3)
  println("sq3")
  fe_sub(t4, t0, t3)
  println("sub5")
  fe_sq(t3, t2)
  println("sq4")
  fe_mul(t2, x1, z3)
  println("mul7")
  
  println("Done")
  println(0)
  exit(0)
}