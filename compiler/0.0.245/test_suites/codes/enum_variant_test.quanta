// 0.0.63: user enums — qualified + bare variant resolution via match.
enum Color { Red, Green, Blue }
fn main() {
  let c = Color.Green
  let r1 = match c { Color.Red => 1, Color.Green => 2, Color.Blue => 3 }
  let g = Green          // bare variant (no Color. prefix)
  let r2 = match g { Color.Red => 11, Color.Green => 12, Color.Blue => 13 }
  return r1 * 10 + r2    // 2*10 + 12 = 32
}
