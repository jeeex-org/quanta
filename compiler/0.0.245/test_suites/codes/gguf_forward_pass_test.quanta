import std/fs
import std/gguf

const N_HIDDEN = 2048

// Test full forward pass through one layer
fn rms_norm(out, x, w, n) {
    let ms = i2f(0)
    let i = 0
    while i < n {
        let v = mem_load(x + i * 8)
        ms = fadd(ms, fmul(v, v))
        i = i + 1
    }
    ms = fdiv(ms, i2f(n))
    let ir = fdiv(i2f(1), sqrt(fadd(ms, i2f(1))))
    i = 0
    while i < n {
        mem_store(out + i * 8, fmul(fmul(mem_load(x + i * 8), ir), mem_load(w + i * 8)))
        i = i + 1
    }
}

fn dequant_q6k_block(raw, out) {
    let scale = mem_load8(raw) + mem_load8(raw + 1) * 256
    let gi = 0
    while gi < 64 {
        let b0 = mem_load8(raw + 2 + gi * 3)
        let b1 = mem_load8(raw + 2 + gi * 3 + 1)
        let b2 = mem_load8(raw + 2 + gi * 3 + 2)
        let q0 = b0 - (b0 / 64) * 64
        let q1 = (b0 / 64) + (b1 - (b1 / 16) * 16) * 4
        let q2 = (b1 / 16) + (b2 - (b2 / 4) * 4) * 16
        let q3 = b2 / 4
        mem_store(out + (gi * 4) * 8, scale * q0 / 63)
        mem_store(out + (gi * 4 + 1) * 8, scale * q1 / 63)
        mem_store(out + (gi * 4 + 2) * 8, scale * q2 / 63)
        mem_store(out + (gi * 4 + 3) * 8, scale * q3 / 63)
        gi = gi + 1
    }
}

fn main() {
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { return 1 }
    
    // Load token 0 embedding
    let token_embd = gguf_find_tensor("token_embd.weight")
    let offset = gguf_tensor_offset(token_embd)
    let raw = mem_alloc(210)
    lseek(gguf_fd, offset, 0)
    file_read(gguf_fd, raw, 210)
    
    let hidden = mem_alloc(N_HIDDEN * 8)
    dequant_q6k_block(raw, hidden)
    
    // Load norm weight
    let norm_idx = gguf_find_tensor("token_embd_norm.weight")
    let norm_off = gguf_tensor_offset(norm_idx)
    let norm_raw = mem_alloc(2048 * 4)
    lseek(gguf_fd, norm_off, 0)
    file_read(gguf_fd, norm_raw, 2048 * 4)
    
    // Apply RMSNorm (simplified - just check it doesn't crash)
    let normed = mem_alloc(N_HIDDEN * 8)
    let ms = i2f(0)
    let i = 0
    while i < 256 {
        let v = mem_load(hidden + i * 8)
        ms = fadd(ms, fmul(v, v))
        i = i + 1
    }
    ms = fdiv(ms, i2f(256))
    let ir = fdiv(i2f(1), sqrt(fadd(ms, i2f(1))))
    i = 0
    while i < 256 {
        mem_store(normed + i * 8, fmul(mem_load(hidden + i * 8), ir))
        i = i + 1
    }
    
    // Verify output is non-zero
    if mem_load(normed) == i2f(0) { return 1 }
    
    gguf_close()
    return 0
}