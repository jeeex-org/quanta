// x25519_inv_debug.quanta — debug fe_inv

import std/x25519

fn print_hex(label, ptr, n) {
  let s = ""
  let i = 0
  while i < n {
    let b = mem_load8(ptr + i)
    let hi = b >> 4; let lo = b & 0xf
    if hi < 10 { s = str(s, hi + 48) } else { s = str(s, hi + 87) }
    if lo < 10 { s = str(s, lo + 48) } else { s = str(s, lo + 87) }
    i = i + 1
  }
  println(s)
}

fn main() {
  println("Debug fe_inv(2)...")
  
  let a = mem_alloc(5*8)
  fe_zero(a)
  mem_store(a, 2)
  println("a = 2:")
  print_hex("a", a, 40)
  
  let inv = mem_alloc(5*8)
  fe_inv(a, inv)
  println("inv(2):")
  print_hex("inv", inv, 40)
  
  let prod = mem_alloc(5*8)
  fe_mul(a, inv, prod)
  println("2 * inv(2):")
  print_hex("prod", prod, 40)
  
  let one = mem_alloc(5*8)
  fe_one(one)
  println("expected 1:")
  print_hex("one", one, 40)
  
  println(0)
  exit(0)
}