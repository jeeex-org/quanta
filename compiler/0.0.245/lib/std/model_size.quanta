// ===========================================================================
// Model size class -- Phase 11.1
//
// Decides how much of itself a model is shown, from what the loader can
// actually measure rather than from a name. HashCortX does this at
// src/platform/tauri/hashcoder.js:1067:
//
//   HC.code.sizeOf = (billions) => (!(billions > 0) ? 'full'
//     : billions < 5 ? 'small' : billions < 15 ? 'mid' : 'full')
//
// and reads `billions` from Ollama's own metadata (details.parameter_size via
// /api/show), falling back to parsing digits out of the model NAME. Quanta can
// do better on the primary path: the exact parameter count is the sum of
// element counts over the tensor table, which the loader already holds.
//
// VERIFIED on the real LFM2.5 model:
//   sum of gguf_tensor_nelements over all 266 tensors = 2,697,198,592 = 2.70B,
//   which matches the model's own name. A 37-tensor reading would not.
//
// WHY UNKNOWN MEANS 'full', never 'small'
//
// HashCortX's rule is kept exactly: a figure we could not obtain must never
// DEGRADE a model. Falling back to 'small' would strip tools from a large model
// purely because we failed to measure it, which is the worst possible failure
// mode -- a silent capability cut that looks like a deliberate policy.
//
// WHAT IS DELIBERATELY NOT HERE
//
//   - No name parsing. The reference falls back to it because it has no other
//     option (a hosted model it did not load). Quanta HAS the tensor table, so
//     the fallback would only ever fire on a model whose count is genuinely
//     unavailable, where 'full' is the correct answer anyway. Parsing "7b" out
//     of a filename is a guess that can be wrong in both directions.
//   - No context sizing, no temperature, no tool selection. Those are 11.2,
//     11.3 and 11.4; keeping this function free of them makes it testable on
//     its own.
//
// NOT a hash table on purpose: it is two comparisons, and a lookup table would
// cost more to read than to execute.

// loader_traits is needed for qmodel_kind / QMODEL_GGUF / QMODEL_ST, which
// qmodel_size_class dispatches on. gguf_* comes from there too.
import std/loader_traits

let QSIZE_SMALL_BILLIONS = 5
let QSIZE_MID_BILLIONS = 15

let QSIZE_SMALL = 1
let QSIZE_MID = 2
let QSIZE_FULL = 3

// Classify an explicit parameter count. 0 or negative means "not measured".
fn qsize_class_of(total: i64) -> i64 {
    if total <= 0 { return QSIZE_FULL }
    // billions x1000 avoids a float divide and keeps the comparison exact.
    let b1000 = total / 1000000
    if b1000 < QSIZE_SMALL_BILLIONS * 1000 { return QSIZE_SMALL }
    if b1000 < QSIZE_MID_BILLIONS * 1000 { return QSIZE_MID }
    return QSIZE_FULL
}

// Exact parameter count of the currently open GGUF, summed over every tensor.
// Returns 0 when no model is loaded or the tensor table is unreadable, which
// qsize_class_of turns into QSIZE_FULL.
fn gguf_param_count() -> i64 {
    let n = gguf_num_tensors()
    if n <= 0 { return 0 }
    let total: i64 = 0
    let i = 0
    while i < n {
        let e = gguf_tensor_nelements(i)
        if e < 0 { return 0 }
        total = total + e
        i = i + 1
    }
    return total
}

// Size class of the open GGUF, without the caller having to count anything.
fn gguf_size_class() -> i64 {
    return qsize_class_of(gguf_param_count())
}

// Same, through the Phase 6 seam, so a caller holding a format-agnostic handle
// gets the same answer without caring which format it is. Falls back to 'full'
// for any format the seam cannot count, which is the safe direction.
fn qmodel_size_class(h: i64) -> i64 {
    let k = qmodel_kind(h)
    if k == QMODEL_GGUF { return gguf_size_class() }
    if k == QMODEL_ST {
        // safetensors: every tensor's shape product is its element count.
        let n = qmodel_num_tensors(h)
        if n <= 0 { return QSIZE_FULL }
        let total: i64 = 0
        let i = 0
        while i < n {
            let e = qmodel_nelements(h, i)
            if e <= 0 { return QSIZE_FULL }
            total = total + e
            i = i + 1
        }
        return qsize_class_of(total)
    }
    return QSIZE_FULL
}

// Test hooks: the boundary values, so a test can assert the tiers without
// needing a 15-billion-parameter model on disk.
fn qsize_of_billions(b: i64) -> i64 {
    return qsize_class_of(b * 1000000000)
}
