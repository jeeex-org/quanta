// loop_test: `loop` keyword with break/continue (general infinite-loop form).
// Verifies the loop keyword compiles and break/continue work inside it.
fn main() {
  let i=0 let s=0
  loop { i=i+1; if i>10 { break }; s=s+i }      // 1..10 sum = 55
  if s!=55 { return 1 }
  let j=0 let t=0
  loop { j=j+1; if j%2==0 { continue }; t=t+j; if j==9 { break } }  // odds 1..9 = 25
  if t!=25 { return 2 }
  return 0
}
