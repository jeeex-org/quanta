// x25519_ladder_loop_test.quanta — test ladder with loop

import std/x25519

fn main() {
  println("Test ladder loop...")
  
  // Clamp scalar
  let k = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(k + i, 0); i = i + 1 }
  mem_store8(k, 1)
  mem_store8(k + 31, 64)
  
  // u = 9
  let u = mem_alloc(32)
  i = 0
  while i < 32 { mem_store8(u + i, 0); i = i + 1 }
  mem_store8(u, 9)
  
  // x1 = u
  let x1 = mem_alloc(8*8)
  fe_from_bytes(u, x1)
  
  // x2 = 1
  let x2 = mem_alloc(8*8)
  fe_one(x2)
  
  // z2 = 0
  let z2 = mem_alloc(8*8)
  fe_zero(z2)
  
  // x3 = u
  let x3 = mem_alloc(8*8)
  fe_from_bytes(u, x3)
  
  // z3 = 1
  let z3 = mem_alloc(8*8)
  fe_one(z3)
  
  // A24 = 121666
  let A24 = mem_alloc(8*8)
  fe_zero(A24)
  mem_store(A24, 121666)
  
  // Temp buffers
  let t0 = mem_alloc(8*8)
  let t1 = mem_alloc(8*8)
  let t2 = mem_alloc(8*8)
  let t3 = mem_alloc(8*8)
  let t4 = mem_alloc(8*8)
  
  println("Setup done")
  
  // Ladder: process bits from bit 4 down to 0 (5 bits) using while loop
  let bit = 4
  let swap = 0
  while bit >= 0 {
    println("bit")
    println(bit)
    
    let kbyte = bit >> 3
    let kbit = bit & 7
    swap = (mem_load8(k + kbyte) >> kbit) & 1
    println("swap")
    println(swap)
    
    // Constant-time conditional swap
    if swap != 0 {
      i = 0
      while i < 8 {
        let tmp = mem_load(x2 + i*8)
        mem_store(t0 + i*8, tmp)
        mem_store(x2 + i*8, mem_load(x3 + i*8))
        mem_store(x3 + i*8, tmp)
        tmp = mem_load(z2 + i*8)
        mem_store(t1 + i*8, tmp)
        mem_store(z2 + i*8, mem_load(z3 + i*8))
        mem_store(z3 + i*8, tmp)
        i = i + 1
      }
    }
    
    println("swap done")
    
    // Ladder step
    fe_add(x2, z2, t0)
    println("add1")
    fe_sub(x2, z2, t1)
    println("sub1")
    fe_add(x3, z3, t2)
    println("add2")
    fe_sub(x3, z3, t3)
    println("sub2")
    fe_mul(t0, t3, t4)
    println("mul1")
    fe_mul(t1, t2, t0)
    println("mul2")
    fe_add(t4, t0, t2)
    println("add3")
    fe_sq(t2, x3)
    println("sq1")
    fe_sub(t4, t0, t3)
    println("sub3")
    fe_sq(t3, t2)
    println("sq2")
    fe_mul(t2, x1, z3)
    println("mul3")
    
    // 2P
    fe_add(x2, z2, t0)
    println("add4")
    fe_sq(t0, t2)
    println("sq3")
    fe_sub(x2, z2, t1)
    println("sub4")
    fe_sq(t1, t3)
    println("sq4")
    fe_mul(t2, t3, x2)
    println("mul4")
    fe_sub(t2, t3, t4)
    println("sub5")
    fe_mul(t4, t2, t0)
    println("mul5")
    fe_mul(t4, t3, t1)
    println("mul6")
    fe_mul(t1, A24, t1)
    println("mul7")
    fe_add(t0, t1, z2)
    println("add5")
    
    bit = bit - 1
  }
  
  // Final conditional swap
  if swap != 0 {
    i = 0
    while i < 8 {
      let tmp = mem_load(x2 + i*8)
      mem_store(x2 + i*8, mem_load(x3 + i*8))
      mem_store(x3 + i*8, tmp)
      tmp = mem_load(z2 + i*8)
      mem_store(z2 + i*8, mem_load(z3 + i*8))
      mem_store(z3 + i*8, tmp)
      i = i + 1
    }
  }
  
  // Result = x2 / z2
  fe_inv(z2, t0)
  fe_mul(x2, t0, t1)
  
  println("Done")
  println(0)
  exit(0)
}