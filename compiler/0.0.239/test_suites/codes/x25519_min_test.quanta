// x25519_min_test.quanta — minimal test to find crash

import std/x25519

fn main() {
  let u9 = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u9 + i, 0); i = i + 1 }
  mem_store8(u9, 9)
  
  let fe = mem_alloc(5*8)
  fe_from_bytes(u9, fe)
  
  let out = mem_alloc(32)
  fe_to_bytes(fe, out)
  
  // Just check first byte
  let b = mem_load8(out)
  if b == 9 { println(0); exit(0) }
  else { println(1); exit(1) }
}