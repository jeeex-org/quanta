fn test_hexval(c) {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 87 }
  if c >= 65 && c <= 70 { return c - 55 }
  return 0
}

fn test_hex_to_bytes(dst, hexstr, n) {
  let i = 0
  while i < n {
    let hi = test_hexval(mem_load8(hexstr + 8 + i * 2))
    let lo = test_hexval(mem_load8(hexstr + 8 + i * 2 + 1))
    mem_store8(dst + i, hi * 16 + lo)
    i = i + 1
  }
}

fn test_mem_eq(a, b, n) {
  let i = 0
  while i < n {
    if mem_load8(a + i) != mem_load8(b + i) { return 0 }
    i = i + 1
  }
  return 1
}

fn main() {
  // SHA3-224("") = 6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7
  let e224 = mem_alloc(28)
  sha3_224("", 0, e224)
  let ve224 = mem_alloc(28)
  test_hex_to_bytes(ve224, "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7", 28)
  if test_mem_eq(e224, ve224, 28) == 0 { exit(1) }

  // SHA3-256("") = a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a
  let e256 = mem_alloc(32)
  sha3_256("", 0, e256)
  let ve256 = mem_alloc(32)
  test_hex_to_bytes(ve256, "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", 32)
  if test_mem_eq(e256, ve256, 32) == 0 { exit(2) }

  // SHA3-384("") = 0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004
  let e384 = mem_alloc(48)
  sha3_384("", 0, e384)
  let ve384 = mem_alloc(48)
  test_hex_to_bytes(ve384, "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004", 48)
  if test_mem_eq(e384, ve384, 48) == 0 { exit(3) }

  // SHA3-512("") = a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26
  let e512 = mem_alloc(64)
  sha3_512("", 0, e512)
  let ve512 = mem_alloc(64)
  test_hex_to_bytes(ve512, "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26", 64)
  if test_mem_eq(e512, ve512, 64) == 0 { exit(4) }

  // SHAKE128("") first 32 = 7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26
  let s128 = mem_alloc(32)
  shake128("", 0, s128, 32)
  let vs128 = mem_alloc(32)
  test_hex_to_bytes(vs128, "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26", 32)
  if test_mem_eq(s128, vs128, 32) == 0 { exit(5) }

  // SHAKE256("") first 32 = 46b9dd2b0ba88d13233b3feb743eeb243fcd2176cdb303176b5343c364673d4d
  let s256 = mem_alloc(32)
  shake256("", 0, s256, 32)
  let vs256 = mem_alloc(32)
  test_hex_to_bytes(vs256, "46b9dd2b0ba88d13233b3feb743eeb243fcd2176cdb303176b5343c364673d4d", 32)
  if test_mem_eq(s256, vs256, 32) == 0 { exit(6) }

  exit(0)
}

import std/secure

extern fn malloc(size: u64) -> u64;