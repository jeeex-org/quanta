import std/secure
fn main() {
  let e = mem_alloc(200)
  sha3_256("", 0, e)
  let i = 0
  while i < 32 {
    let b = mem_load8(e + i)
    let hi = b >> 4
    let lo = b & 15
    let c1 = 0
    if hi < 10 { c1 = hi + 48 } else { c1 = hi + 87 }
    let c2 = 0
    if lo < 10 { c2 = lo + 48 } else { c2 = lo + 87 }
    mem_store8(e + 100 + i*2, c1)
    mem_store8(e + 100 + i*2 + 1, c2)
    i = i + 1
  }
  print(e + 100, 64)
  print("\n", 1)
  exit(0)
}
