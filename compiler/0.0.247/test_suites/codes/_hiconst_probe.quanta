fn main() {
  let a = 0x123456789ABCDEF0
  let hi = 0x800000000000808a
  let b = a ^ hi
  // expected: 0x123456789ABCDEF0 ^ 0x800000000000808a = 0x923456789ABC04FA
  let exp = 0x923456789ABC04FA
  let diff = b ^ exp
  // also test AND/OR with high-bit constant
  let c = a & 0x8000000000000000
  let expc = 0x8000000000000000
  let d2 = c ^ expc
  if diff == 0 && d2 == 0 { exit(0) } else { exit(1) }
}
