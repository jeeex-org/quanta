// stdlib_lfm2_pretok_test -- the native LFM2 pre-tokenizer must reproduce the
// reference split in tests/fixtures/pretok_ref.txt EXACTLY: same pre-token count,
// same byte offset, same byte length, for every block.
//
// The fixture is generated by scripts/audit/gen_pretok_ref.py from llama.cpp's
// own committed Unicode tables (src/unicode-data.cpp), NOT Python's unicodedata.
// Audit tooling only; this test and the native pre-tokenizer read the committed
// file. Exit 0 means every block matched.
//
// The two error classes this exists to catch, both of which shipped GREEN
// elsewhere: pretok_run kinds 3 and 6 are OPPOSITE character classes --
// [^\s\p{L}\p{N}] excludes whitespace, [^\r\n\p{L}\p{N}] does not -- so using
// one for the other splits " world" into " " + "world". And a Quanta string
// expression is the [u64 len][chars][NUL] HEADER pointer, so indexing a literal
// needs +8; reading at +0 returns the length and decodes base64 to garbage.
import std/fs
import std/lfm2_pretok

// Read one line into `line`, stripping the newline. Returns 0 at EOF.
// Whole-file buffered line reader. The fixture is small, and a per-byte
// read_raw() per input byte turns a 6 KB file into thousands of syscalls.
let buf_base = 0
let buf_len = 0
let buf_pos = 0

// Fixed generous capacity. The fixture is ~6 KB; a fixed buffer avoids
// lseek()-to-END, which does not return a usable file size here.
let buf_cap = 65536

fn load_all() {
    let fd = file_open("tests/fixtures/pretok_ref.txt", 0)
    if fd < 0 { return 0 }
    let b = mem_alloc(buf_cap)
    let got = read_raw(fd, b, buf_cap)
    file_close(fd)
    if got <= 0 { print("read got ", got); return 0 }
    buf_base = b
    buf_len = got
    buf_pos = 0
    return 1
}

// Copy the next line (without its newline) into `line`, leaving its length in
// *lenbox. Returns 0 at end of file.
fn next_line(line, maxline, lenbox) {
    if buf_pos >= buf_len { mem_store(lenbox, 0); return 0 }
    let n = 0
    while buf_pos < buf_len {
        let c = mem_load8(buf_base + buf_pos)
        buf_pos = buf_pos + 1
        if c == 10 { break }
        if n < maxline - 1 { mem_store8(line + n, c); n = n + 1 }
    }
    mem_store(lenbox, n)
    return 1
}

// base64 decode from `s` (length slen) into dst; returns byte count.
let b64rev = 0
let b64inited = 0
fn b64_init() {
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    b64rev = mem_alloc(128)
    let t = 0
    while t < 128 { mem_store8(b64rev + t, 255); t = t + 1 }
    t = 0
    // Quanta string literals are laid out [u64 len][chars][NUL], and a string
    // expression is the HEADER pointer -- so the first character is alpha+8.
    // Reading alpha+0 gives the length (6 or 64), which decodes to garbage.
    while t < 64 { mem_store8(b64rev + mem_load8(alpha + 8 + t), t); t = t + 1 }
    b64inited = 1
}
fn b64d(s, slen, dst) {
    if b64inited == 0 { b64_init() }
    let rev = b64rev
    let out = 0
    let acc = 0
    let bits = 0
    let j = 0
    while j < slen {
        let c = mem_load8(s + j)
        if c == 61 { j = j + 1; continue }
        let v = mem_load8(rev + c)
        if v == 255 { j = j + 1; continue }
        acc = (acc << 6) | v
        bits = bits + 6
        if bits >= 8 {
            bits = bits - 8
            mem_store8(dst + out, (acc >> bits) & 255)
            out = out + 1
        }
        j = j + 1
    }
    return out
}

// Parse a decimal run starting at `p`; leaves the chars consumed in
// pdec_used. A module global, not an out-parameter.
let pdec_used = 0

fn parse_dec(s, p, n) {
    let v = 0
    let k = 0
    while p + k < n {
        let c = mem_load8(s + p + k)
        if c < 48 || c > 57 { break }
        v = v * 10 + (c - 48)
        k = k + 1
    }
    pdec_used = k
    return v
}

let MAXTOK = 4096

fn main() {
    if load_all() == 0 { print("FAIL open"); return 1 }

    let maxline = 65536
    let line = mem_alloc(maxline)
    let lenbox = mem_alloc(8)
    let sbuf = mem_alloc(65536)
    let got_off = mem_alloc(MAXTOK * 8)
    let got_len = mem_alloc(MAXTOK * 8)
    let exp_off = mem_alloc(MAXTOK * 8)
    let exp_len = mem_alloc(MAXTOK * 8)

    let blocks = 0
    let fails = 0
    let total_tok = 0

    let inner_lines = 0
    // Bounded: a wrong pre-token length can make the split loop emit nothing and
    // the outer loop then reads past the block it is inside. Without a ceiling
    // this HANGS instead of failing, and the gate burns its full timeout while
    // saying nothing about why.
    let lines_seen = 0
    while next_line(line, maxline, lenbox) {
        lines_seen = lines_seen + 1
        if lines_seen > 4000 { print("FAIL runaway line scan"); return 9 }
        let l = mem_load(lenbox)
        // header must be "### ..."
        if !(l >= 3 && mem_load8(line) == 35 && mem_load8(line + 1) == 35 && mem_load8(line + 2) == 35) {
            continue
        }

        // skip "### " then the index, then the base64 payload
        let a = 3
        while a < l && mem_load8(line + a) == 32 { a = a + 1 }
        let bidx = parse_dec(line, a, l)
        a = a + pdec_used
        while a < l && mem_load8(line + a) == 32 { a = a + 1 }
        let n = b64d(line + a, l - a, sbuf)

        // split natively
        let i = 0
        let cnt = 0
        let stuck = 0
        let guard = 0
        while i < n && n > 0 {
            guard = guard + 1
            if guard > 4096 { print("FAIL runaway split in block ", bidx); return 9 }
            let off = 0
            let len = 0
            if pretok_next(sbuf, n, i) == 0 { break }
            off = pretok_off
            len = pretok_len
            if len == 0 { stuck = 1; break }
            if cnt < MAXTOK {
                mem_store(got_off + cnt * 8, off)
                mem_store(got_len + cnt * 8, len)
            }
            cnt = cnt + 1
            i = i + len
        }

        // read expected lines until the terminator
        let ecnt = 0
        let done = 0
        while next_line(line, maxline, lenbox) {
            let l2 = mem_load(lenbox)
            if l2 >= 3 && mem_load8(line) == 45 && mem_load8(line + 1) == 45 && mem_load8(line + 2) == 45 {
                done = 1
                break
            }
            if l2 == 0 { continue }
            inner_lines = inner_lines + 1
            if !(l2 >= 3 && mem_load8(line) >= 48 && mem_load8(line) <= 57) { print("GARBAGE LINE after block ", bidx); return 9 }
            let p = 0
            let o = parse_dec(line, p, l2)
            p = p + pdec_used
            while p < l2 && mem_load8(line + p) == 32 { p = p + 1 }
            let ln2 = parse_dec(line, p, l2)
            if ecnt < MAXTOK {
                mem_store(exp_off + ecnt * 8, o)
                mem_store(exp_len + ecnt * 8, ln2)
            }
            ecnt = ecnt + 1
        }

        blocks = blocks + 1
        total_tok = total_tok + cnt

        if stuck == 1 {
            print("FAIL block ", bidx, " zero-length pre-token at ", i)
            fails = fails + 1
            continue
        }
        if done == 0 {
            print("FAIL block ", bidx, " unterminated")
            fails = fails + 1
            continue
        }
        if cnt != ecnt {
            print("FAIL block ", bidx, " (", n, " bytes) count got=", cnt, " want=", ecnt)
            fails = fails + 1
            continue
        }
        let k = 0
        let bad = 0
        while k < cnt {
            if mem_load(got_off + k * 8) != mem_load(exp_off + k * 8) || mem_load(got_len + k * 8) != mem_load(exp_len + k * 8) {
                bad = bad + 1
                if bad < 5 {
                    print("  block ", bidx, " tok ", k, ": got ", mem_load(got_off + k * 8), "/", mem_load(got_len + k * 8),
                          " want ", mem_load(exp_off + k * 8), "/", mem_load(exp_len + k * 8))
                }
            }
            k = k + 1
        }
        if bad > 0 { fails = fails + 1 }
    }

    print("blocks=", blocks, " tokens=", total_tok, " fails=", fails)
    if fails == 0 && blocks > 0 { print("OK ptsmoke"); return 0 }
    print("FAIL ptsmoke"); return 1
}