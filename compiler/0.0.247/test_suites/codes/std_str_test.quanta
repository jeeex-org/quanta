import std/str
// Comprehensive coverage of lib/std/str. Asserts exact values.
// Quanta string literals carry an 8-byte header; raw bytes at strptr+8.
fn main() {
  let ok = 0
  // concat
  let c = concat("foo", "bar")
  if equals(c, "foobar") == 1 { ok = ok + 1 }
  if len(c) == 6 { ok = ok + 1 }
  // byte_at
  let s = "ABC"
  if byte_at(s, 0) == 65 { ok = ok + 1 }   // 'A'
  if byte_at(s, 1) == 66 { ok = ok + 1 }   // 'B'
  if byte_at(s, 2) == 67 { ok = ok + 1 }   // 'C'
  // byte_set (in-place mutation of a freshly allocated buffer)
  let buf = concat("AAA", "")
  byte_set(buf, 1, 88)                      // 'X'
  if byte_at(buf, 1) == 88 { ok = ok + 1 }
  // equals
  if equals("same", "same") == 1 { ok = ok + 1 }
  if equals("same", "diff") == 0 { ok = ok + 1 }
  // substr
  let sub = substr("hello world", 6, 5)     // "world"
  if equals(sub, "world") == 1 { ok = ok + 1 }
  if len(sub) == 5 { ok = ok + 1 }
  // parse_i64
  if parse_i64("12345") == 12345 { ok = ok + 1 }
  if parse_i64("-67") == -67 { ok = ok + 1 }
  if parse_i64("0") == 0 { ok = ok + 1 }
  // total = 2+3+1+2+2+3 = 13
  exit(ok)   // expect 13
}
