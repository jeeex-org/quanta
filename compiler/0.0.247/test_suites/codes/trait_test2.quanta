// trait_test2: trait + impl + factory + method call through a Drawable param.
// Real assertion: draw_shape(c) returns Circle.draw() == radius*2 == 10.
// (Was a no-op: draw_shape returned 0, main returned 0.)
trait Drawable {
    fn draw(self) -> int
}

struct Circle { radius }

impl Drawable for Circle {
    fn draw(self) -> int {
        self.radius * 2
    }
}

fn make(r) {
    return Circle(r)
}

fn draw_shape(d: Drawable) {
    return d.draw()
}

fn main() {
    let c = make(5)
    return draw_shape(c)   // 10
}
