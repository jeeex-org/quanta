import std/secure
fn main() {
  // input: lane0=1, all else 0 -> Aba=1, all other A*=0
  let Aba = 1
  let Abe = 0; let Abi = 0; let Abo = 0; let Abu = 0
  let Aga = 0; let Age = 0; let Agi = 0; let Ago = 0; let Agu = 0
  let Aka = 0; let Ake = 0; let Aki = 0; let Ako = 0; let Aku = 0
  let Ama = 0; let Ame = 0; let Ami = 0; let Amo = 0; let Amu = 0
  let Asa = 0; let Ase = 0; let Asi = 0; let Aso = 0; let Asu = 0
  let Ca = Aba^Aga^Aka^Ama^Asa
  let Ce = Abe^Age^Ake^Ame^Ase
  let Ci = Abi^Agi^Aki^Ami^Asi
  let Co = Abo^Ago^Ako^Amo^Aso
  let Cu = Abu^Agu^Aku^Amu^Asu
  let Da = Cu^krot(Ce, 1)
  let De = Ca^krot(Ci, 1)
  let Di = Ce^krot(Co, 1)
  let Do = Ci^krot(Cu, 1)
  let Du = Co^krot(Ca, 1)
  // expect Ca=1, Ce=Ci=Co=Cu=0, Da=De=Di=Do=Du=0
  if Ca != 1 { exit(1) }
  if Ce != 0 { exit(2) }
  if Ci != 0 { exit(3) }
  if Co != 0 { exit(4) }
  if Cu != 0 { exit(5) }
  if Da != 0 { exit(6) }
  if De != 0 { exit(7) }
  if Di != 0 { exit(8) }
  if Do != 0 { exit(9) }
  if Du != 0 { exit(10) }
  exit(0)
}
