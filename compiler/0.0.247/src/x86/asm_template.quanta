// asm_template.quanta — 0.0.232 Phase C2 (C4): %N substitution into asm!
// templates.
//
// Codegen resolves each %N to the operand's form and writes the SUBSTITUTED
// template into `src` past srclen (the established injection pattern —
// scanstructs injects the CmdResult name the same way). asm_tpl then points at
// the injected copy, so the assembler/hex paths operate unchanged.
//
// %N forms:
//   "r"/"=r"/"+r" -> 64-bit register NAME (rax..r15)
//   "m"           -> [regname]  (spill-home base; [REG] forms stage via r11)
//   "i"           -> decimal immediate

fn asm_reg_name(r) -> str {
    if r==0 { return "rax" }
    if r==1 { return "rcx" }
    if r==2 { return "rdx" }
    if r==3 { return "rbx" }
    if r==4 { return "rsp" }
    if r==5 { return "rbp" }
    if r==6 { return "rsi" }
    if r==7 { return "rdi" }
    if r==8 { return "r8" }
    if r==9 { return "r9" }
    if r==10 { return "r10" }
    if r==11 { return "r11" }
    if r==12 { return "r12" }
    if r==13 { return "r13" }
    if r==14 { return "r14" }
    if r==15 { return "r15" }
    return "rax"
}

// asm_substitute(tpl, tpl_end, blk, physregs) -> new template offset in src.
// tpl..tpl_end = original template text (inside quotes). blk = operand block.
// physregs = mem_alloc'd array of physical register numbers per operand.
// The substituted text is appended at srclen; srclen is advanced. Returns the
// offset of the substituted text's first byte.
fn asm_substitute(tpl, tpl_end, blk, physregs) -> i64 {
    let out = srclen
    let pos = out
    let n = r64(blk+0)
    let p = tpl
    while p < tpl_end {
        let c = r8(src+p)
        if c==37 && p+1 < tpl_end {   // '%'
            let d = r8(src+p+1)
            if d>=48 && d<=57 {
                let oi = d - 48
                if oi < n {
                    let ov = r64(blk + 16 + oi*32)
                    let cc = r64(blk + 16 + oi*32 + 8)
                    let pr = r64(physregs + oi*8)
                    if cc==ASM_C_M {
                        // [regname]
                        let nm = asm_reg_name(pr)
                        let nl2 = len(nm)
                        w8(src+pos, 91); pos = pos + 1
                        let k2 = 0
                        while k2 < nl2 { w8(src+pos+k2, r8(nm+8+k2)); k2 = k2 + 1 }
                        pos = pos + nl2
                        w8(src+pos, 93); pos = pos + 1
                    } else if cc==ASM_C_I {
                        // value captured at parse time (opt deletes the CONST)
                        let cval = r64(blk + 16 + oi*32 + 24)
                        pos = asm_dec_into(pos, cval)
                    } else {
                        let nm = asm_reg_name(pr)
                        let nl2 = len(nm)
                        let k2 = 0
                        while k2 < nl2 { w8(src+pos+k2, r8(nm+8+k2)); k2 = k2 + 1 }
                        pos = pos + nl2
                    }
                    p = p + 2
                    continue
                }
            }
        }
        w8(src+pos, c); pos = pos + 1
        p = p + 1
    }
    w8(src+pos, 0)
    srclen = pos + 1
    return out
}

// asm_dec_into: append the decimal value of v at pos in src. Returns new pos.
fn asm_dec_into(pos, v) -> i64 {
    let buf = mmap(24)
    let di = 0
    let dv = v
    let neg = 0
    if dv < 0 { neg = 1; dv = 0 - dv }
    if dv == 0 { w8(buf+di, 48); di = di + 1 }
    while dv > 0 { w8(buf+di, 48 + dv % 10); di = di + 1; dv = dv / 10 }
    if neg == 1 { w8(src+pos, 45); pos = pos + 1 }
    while di > 0 { di = di - 1; w8(src+pos, r8(buf+di)); pos = pos + 1 }
    return pos
}

// pconst_global(vr): constant value of vreg vr, walking the CURRENT ir buffer
// (bounded to [0, irc)). Used for "i" operands at emit time; if the vreg is not
// a compile-time constant the operand fails closed.
