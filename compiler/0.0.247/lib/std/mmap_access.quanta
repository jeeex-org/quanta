// mmap-based tensor access: load entire file into memory, access tensors via pointer arithmetic
// Avoids lseek + read for every tensor

let mmap_ptr = 0
let mmap_size = 0

fn mmap_load(path) {
    let fd = open(path, 0, 0)
    if fd < 0 { return -1 }
    
    // Get file size from lseek(SEEK_END), not fstat: file_stat returns EFAULT
    // on this target and leaves the buffer untouched, so reading st_size from
    // it always yielded 0 and every tensor read below would fault.
    let size = file_size(fd)
    
    // Read entire file into one big buffer
    mmap_size = size
    mmap_ptr = mem_alloc(size)
    file_read(fd, mmap_ptr, size)
    
    close(fd)
    return 0
}

// Read little-endian u64 at offset
fn mmap_read_u64(offset) {
    let b0 = mem_load8(mmap_ptr + offset)
    let b1 = mem_load8(mmap_ptr + offset + 1)
    let b2 = mem_load8(mmap_ptr + offset + 2)
    let b3 = mem_load8(mmap_ptr + offset + 3)
    let b4 = mem_load8(mmap_ptr + offset + 4)
    let b5 = mem_load8(mmap_ptr + offset + 5)
    let b6 = mem_load8(mmap_ptr + offset + 6)
    let b7 = mem_load8(mmap_ptr + offset + 7)
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216 + b4 * 4294967296 + b5 * 1099511627776 + b6 * 281474976710656 + b7 * 72057594037927936
}

// Get pointer to tensor data at offset
fn mmap_tensor_ptr(offset) {
    return mmap_ptr + offset
}

fn mmap_free() {
    mmap_ptr = 0
    mmap_size = 0
}