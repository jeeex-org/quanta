// 0.0.247: the f16/f32 conversions pinned against the REAL upstream library.
//
// The fixtures under tests/fixtures/ are generated by
// test_suites/scripts/gen_fp16_fixtures.py, which compiles
// test_suites/scripts/fp16_conv_oracle.c against the INSTALLED libggml-base and
// calls its exported ggml_fp16_to_fp32 / ggml_fp32_to_fp16 -- the same library
// the Q6_K dequant row was proven bit-exact against -- plus the host compiler's
// own (float) cast for the f64->f32 narrowing, which ggml has no entry point
// for. They are committed so a fresh clone re-runs the comparison without
// linking anything, and `gen_fp16_fixtures.py --check` re-derives them.
//
// COVERAGE
//   fp16_to_f32_table.bin   EXHAUSTIVE: all 65,536 f16 bit patterns.
//   fp32_to_fp16_*          131,072 cases: all 512 (sign x exponent) x 128
//                           mantissa patterns (every boundary and tie shape,
//                           then LCG-filled), PLUS an exhaustive sweep of all
//                           8,192 low-13-bit patterns -- the bits f16 drops,
//                           including the round bit and the sticky bits -- at
//                           the four exponents where the behaviour changes
//                           (0 f32-subnormal, 112 f16-subnormal/normal,
//                           143 f16-finite/overflow, 254 near-inf).
//   fp64_to_f32_*           65,536 cases: all 4,096 (sign x exponent) x 16
//                           mantissa patterns.
//
// ZERO TOLERANCE: one mismatch is a failure. The first mismatch prints its
// input and both bit patterns, so a red row names the failing value.
//
// read_raw/file_open/file_close come from std/fs (they are library functions,
// not builtins).
import std/fs

fn main() -> i64 {
    let bad = 0
    let i = 0

    // ================= f16 -> f32, all 65,536 patterns =================
    let tbl = mem_alloc(32768)                 // 262144 bytes
    let fd = file_open("tests/fixtures/fp16_to_f32_table.bin", 0)
    if fd < 0 { println("FAIL open fp16_to_f32_table.bin"); return 1 }
    let got = read_raw(fd, tbl, 262144)
    file_close(fd)
    if got != 262144 { println("FAIL short read fp16_to_f32_table.bin"); return 2 }
    i = 0
    while i < 65536 {
        let want = mem_load32(tbl + i*4)
        let have = f16bits_to_f32(i)
        if have != want {
            if bad == 0 {
                print("FAIL f16->f32 pattern ")
                println(i)
                print("  want ")
                println(want)
                print("  got  ")
                println(have)
            }
            bad = bad + 1
        }
        i = i + 1
    }
    print("f16->f32 exhaustive 65536 patterns, mismatches: ")
    println(bad)

    // ================= f32 -> f16, 131,072 cases =================
    let c32 = mem_alloc(65536)                 // 131072 * 4 bytes of cases
    let e32 = mem_alloc(32768)                 // 131072 * 2 bytes of expected
    let fd2 = file_open("tests/fixtures/fp32_to_fp16_cases.bin", 0)
    if fd2 < 0 { println("FAIL open fp32_to_fp16_cases.bin"); return 3 }
    if read_raw(fd2, c32, 524288) != 524288 { println("FAIL short read cases"); return 3 }
    file_close(fd2)
    let fd3 = file_open("tests/fixtures/fp32_to_fp16_expect.bin", 0)
    if fd3 < 0 { println("FAIL open fp32_to_fp16_expect.bin"); return 4 }
    if read_raw(fd3, e32, 262144) != 262144 { println("FAIL short read expect"); return 4 }
    file_close(fd3)
    let bad32 = 0
    i = 0
    while i < 131072 {
        let cv = mem_load32(c32 + i*4)
        let want = mem_load16(e32 + i*2)
        let have = f32bits_to_f16(cv)
        if have != want {
            if bad32 == 0 {
                print("FAIL f32->f16 case ")
                println(i)
                print("  in   0x")
                println(cv)
                print("  want ")
                println(want)
                print("  got  ")
                println(have)
            }
            bad32 = bad32 + 1
        }
        i = i + 1
    }
    print("f32->f16 131072 cases, mismatches: ")
    println(bad32)

    // ================= f64 -> f32, 65,536 cases =================
    let c64 = mem_alloc(65536)                 // 65536 * 8 bytes of cases
    let e64 = mem_alloc(32768)                 // 65536 * 4 bytes of expected
    let fd4 = file_open("tests/fixtures/fp64_to_f32_cases.bin", 0)
    if fd4 < 0 { println("FAIL open fp64_to_f32_cases.bin"); return 5 }
    if read_raw(fd4, c64, 524288) != 524288 { println("FAIL short read d2f cases"); return 5 }
    file_close(fd4)
    let fd5 = file_open("tests/fixtures/fp64_to_f32_expect.bin", 0)
    if fd5 < 0 { println("FAIL open fp64_to_f32_expect.bin"); return 6 }
    if read_raw(fd5, e64, 262144) != 262144 { println("FAIL short read d2f expect"); return 6 }
    file_close(fd5)
    let bad64 = 0
    i = 0
    while i < 65536 {
        let dv = f64of(mem_load(c64 + i*8))
        let want = mem_load32(e64 + i*4)
        let have = f64_to_f32bits(dv)
        if have != want {
            if bad64 == 0 {
                print("FAIL f64->f32 case ")
                println(i)
                print("  want ")
                println(want)
                print("  got  ")
                println(have)
            }
            bad64 = bad64 + 1
        }
        i = i + 1
    }
    print("f64->f32 65536 cases, mismatches: ")
    println(bad64)

    let total = bad + bad32 + bad64
    print("TOTAL mismatches: ")
    println(total)
    if total != 0 { return 100 }
    println("fp16 conversion oracle: zero mismatches")
    return 0
}
