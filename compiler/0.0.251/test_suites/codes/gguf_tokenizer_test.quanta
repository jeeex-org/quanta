import std/fs

// Test byte-level tokenizer
fn tokenize(text, tokens, max_len) {
    let n = len(text)
    if n > max_len { n = max_len }
    let i = 0
    while i < n {
        mem_store(tokens + i * 8, i2f(mem_load8(text + 8 + i)))
        i = i + 1
    }
    return n
}

fn main() {
    let text = "Hello"
    let tokens = mem_alloc(256 * 8)
    let n = tokenize(text, tokens, 256)
    
    if n != 5 { return 1 }
    if mem_load(tokens) != i2f(72) { return 1 }   // 'H'
    if mem_load(tokens + 8) != i2f(101) { return 1 }  // 'e'
    if mem_load(tokens + 16) != i2f(108) { return 1 } // 'l'
    if mem_load(tokens + 24) != i2f(108) { return 1 } // 'l'
    if mem_load(tokens + 32) != i2f(111) { return 1 } // 'o'
    
    return 0
}