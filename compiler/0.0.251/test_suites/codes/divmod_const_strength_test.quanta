// 0.0.238 gate row: division and modulo by a COMPILE-TIME CONSTANT.
//
// Every divisor below is a LITERAL in the checker body, so this row exercises the
// strength reduction itself: power-of-two divisors (1,2,4,8,128) become sar / and,
// and non-power-of-two divisors (3,5,7,1000,1000000,2147483647) become the magic
// multiply. The dividend is a runtime value loaded from an array, so nothing is
// constant-folded and the divisor is genuinely the only constant.
//
// Every expected q/r is hand-derived independently with FLOOR semantics. The
// load-bearing cases are the negatives and INT64_MIN: e.g. this row asserts
// -7 / 3 == -3 and -7 % 3 == 2, where C truncation would give -2 and -1.
// A failing divisor is reported as exit(100 + 2*k + rc): rc 1 = quotient, 2 = remainder.
// INT64_MIN is built under unsafe{} (see divmod_floor_semantics_test).
fn chkD0(a, q, r) {
    if a / 1 != q { return 1 }
    if a % 1 != r { return 2 }
    return 0
}
fn chkD1(a, q, r) {
    if a / 2 != q { return 1 }
    if a % 2 != r { return 2 }
    return 0
}
fn chkD2(a, q, r) {
    if a / 3 != q { return 1 }
    if a % 3 != r { return 2 }
    return 0
}
fn chkD3(a, q, r) {
    if a / 4 != q { return 1 }
    if a % 4 != r { return 2 }
    return 0
}
fn chkD4(a, q, r) {
    if a / 5 != q { return 1 }
    if a % 5 != r { return 2 }
    return 0
}
fn chkD5(a, q, r) {
    if a / 7 != q { return 1 }
    if a % 7 != r { return 2 }
    return 0
}
fn chkD6(a, q, r) {
    if a / 8 != q { return 1 }
    if a % 8 != r { return 2 }
    return 0
}
fn chkD7(a, q, r) {
    if a / 128 != q { return 1 }
    if a % 128 != r { return 2 }
    return 0
}
fn chkD8(a, q, r) {
    if a / 1000 != q { return 1 }
    if a % 1000 != r { return 2 }
    return 0
}
fn chkD9(a, q, r) {
    if a / 1000000 != q { return 1 }
    if a % 1000000 != r { return 2 }
    return 0
}
fn chkD10(a, q, r) {
    if a / 2147483647 != q { return 1 }
    if a % 2147483647 != r { return 2 }
    return 0
}
