fn chi(bba, bbe, bbi) {
  return bba ^ ((~bbe) & bbi)
}
fn main() {
  // use values that exercise all 64 bits
  let Bba = 0xF0F0F0F0F0F0F0F0
  let Bbe = 0x123456789ABCDEF0
  let Bbi = 0x0F0F0F0F0F0F0F0F
  let q = chi(Bba, Bbe, Bbi)
  // expected in C: ~Bbe = 0xEDCBA9876543210F; (& Bbi) = 0x0D0B09070503010F; (^ Bba) = 0xFDFBF9F7F5F3F1FF
  // compare
  let exp = 0xFD0FB9F7F5F3F1FF
  let diff = q ^ exp
  if diff == 0 { exit(0) } else { exit(1) }
}
