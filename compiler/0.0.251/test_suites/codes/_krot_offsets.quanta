import std/secure
fn main() {
  // For each distinct rho offset used in round 1, verify krot moves a known bit.
  // krot(0x8000000000000000, r) must set bit (63+r)&63.
  // Test all offsets that appear in the permutation.
  let offsets = [1, 3, 6, 8, 14, 18, 20, 21, 25, 27, 28, 36, 39, 41, 43, 44, 45, 55, 56, 61, 62, 2]
  let hi = 0x8000000000000000
  let k = 0
  while k < 22 {
    let r = offsets[k]
    let got = krot(hi, r)
    let wantbit = (63 + r) & 63
    let want = 0
    if wantbit == 63 { want = 0x8000000000000000 } else { want = 1 << wantbit }
    if got != want { exit(k + 1) }
    k = k + 1
  }
  exit(0)
}
