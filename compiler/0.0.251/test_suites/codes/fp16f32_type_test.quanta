// 0.0.247: f16 and f32 are REAL language types.
//
// Declarable, stored at 2 and 4 bytes per element, loadable and storable at
// those widths, convertible to and from f64 with round-to-nearest-even, and
// usable for arithmetic in f32 precision.
//
// This test PROVES THE WIDTHS, not the labels. Every storage assertion reads the
// raw bytes back with mem_load16/mem_load32 at an explicit offset, and the
// surrounding bytes are a 0xA5 sentinel, so "wrote 2 bytes here" is
// distinguishable from "wrote 4", "wrote 8", or "wrote nothing". Reading back
// the value alone would pass even for an 8-byte-wide store.
//
// Every expected bit pattern is computed by the host, not eyeballed
// (test_suites/scripts/gen_fp16_fixtures.py and a Python Fraction rounder for
// the exact decimal cases). Exit 0 = pass; every failure exits with a distinct
// code so a red row names WHICH claim broke.
fn main() -> i64 {
    // ================= f32 buffer: 4 bytes per element =================
    let b: f32[8] = mem_alloc(8)
    let i = 0
    while i < 64 { mem_store8(b + 8 + i, 165); i = i + 1 }   // 0xA5 sentinel over the storage
    b[0] = 1.5
    b[1] = 2.25
    b[2] = 0.0 - 3.5
    // element 0 occupies bytes 8..11, element 1 bytes 12..15, element 2 bytes 16..19
    if mem_load32(b + 8) != 1069547520 { exit(11) }     // 0x3FC00000 f32 1.5
    if mem_load32(b + 12) != 1074790400 { exit(12) }    // 0x40100000 f32 2.25
    if mem_load32(b + 16) != 3227516928 { exit(13) }    // 0xC0600000 f32 -3.5
    // the next element is still the sentinel: a FOUR-byte store, not eight
    if mem_load32(b + 20) != 2779096485 { exit(14) }    // 0xA5A5A5A5
    // and the value reads back
    if f64_to_f32bits(b[0]) != 1069547520 { exit(15) }
    if f64_to_f32bits(b[1]) != 1074790400 { exit(16) }
    if f64_to_f32bits(b[2]) != 3227516928 { exit(17) }
    // the last element is reachable at the top of the declared range
    b[7] = 0.25
    if mem_load32(b + 8 + 7*4) != 1048576000 { exit(18) }   // 0x3E800000 f32 0.25

    // ================= f16 buffer: 2 bytes per element =================
    let h: f16[8] = mem_alloc(8)
    let j = 0
    while j < 64 { mem_store8(h + 8 + j, 165); j = j + 1 }
    h[0] = 1.5
    h[1] = 0.0 - 2.0
    h[2] = 0.25
    h[3] = 0.0 - 3.5
    if mem_load16(h + 8) != 15872 { exit(21) }      // 0x3E00 f16 1.5
    if mem_load16(h + 10) != 49152 { exit(22) }     // 0xC000 f16 -2.0
    if mem_load16(h + 12) != 13312 { exit(23) }     // 0x3400 f16 0.25
    if mem_load16(h + 14) != 49920 { exit(24) }     // 0xC300 f16 -3.5
    // FOUR 2-byte elements wrote exactly 8 bytes; the sentinel from byte 16 on is
    // intact. A 4-byte-wide store would have clobbered bytes 14/15 on element 3.
    if mem_load32(h + 16) != 2779096485 { exit(25) }   // 0xA5A5A5A5
    // read back, widened to f32 exactly
    if f64_to_f32bits(h[0]) != 1069547520 { exit(26) }         // f16 1.5 -> f32 1.5
    if f16bits_to_f32(mem_load16(h + 8)) != 1069547520 { exit(27) }

    // ================= conversions, value level =================
    if f16bits_to_f32(15360) != 1065353216 { exit(31) }        // 0x3C00 -> 1.0f32
    if f32bits_to_f16(1065353216) != 15360 { exit(32) }        // 1.0f32 -> 0x3C00
    if f32bits_to_f64(1065353216) != f64bits(1.0) { exit(33) }
    if f16bits_to_f64(15872) != f64bits(1.5) { exit(34) }
    if f64_to_f32bits(0.1) != 1036831949 { exit(35) }          // 0x3DCCCCCD
    if f64_to_f32(0.1) != f32bits_to_f64(1036831949) { exit(36) }
    if f64_to_f16bits(1.5) != 15872 { exit(37) }
    if f64_to_f32bits(2.6 as f32) != 1076258406 { exit(38) }   // `as f32` narrows (RNE)

    // ================= f32 ARITHMETIC is really binary32 =================
    // 2^24 + 1 is EXACTLY 2^24 in binary32, so the difference is 0. In f64 the
    // same expression is exactly 1. Asserting BOTH directions is what proves the
    // two precisions are distinct, rather than both accidentally being f64.
    let big: f32 = 16777216.0
    let one: f32 = 1.0
    let r32 = (big + one) - big
    if f64_to_f32bits(r32) != 0 { exit(41) }
    let dbig = 16777216.0
    let done = 1.0
    let r64 = (dbig + done) - dbig
    if f64_to_f32bits(r64) != 1065353216 { exit(42) }          // 1.0
    // (1/3)*3 in f32 is exactly 1.0 again, and the intermediate is the f32
    // quotient, not a value rounded twice
    let x: f32 = 1.0
    let y: f32 = 3.0
    if f64_to_f32bits(x / y) != 1051372203 { exit(43) }        // 0x3EAAAAAB
    let q = x / y
    if f64_to_f32bits(q * y) != 1065353216 { exit(44) }

    // ================= f32 comparisons =================
    if x < one { exit(51) }
    if x > one { exit(52) }
    if x != one { exit(53) }
    if (x == one) == 0 { exit(54) }
    if (x <= one) == 0 { exit(55) }
    if (x >= one) == 0 { exit(56) }
    if y < x { exit(57) }
    if (y > x) == 0 { exit(58) }
    if (y >= x) == 0 { exit(59) }
    if y <= x { exit(60) }
    if y == x { exit(61) }
    if (y != x) == 0 { exit(62) }

    // ================= f16 PROMOTES to f32 to compute =================
    // This box has avx2 + f16c + fma and NO avx512-fp16, so there is no hardware
    // binary16 arithmetic. f16 is a storage format; an f16 operation is computed
    // in f32 and keeps f32 precision. 1/3 rounded to f16 would be 0x3555
    // (0.333251953125); the f32 quotient is 0x3EAAAAAB. Distinguishing them is
    // the proof that promotion happened rather than f16 rounding.
    let h1: f16 = 1.0
    let h2: f16 = 3.0
    if f64_to_f32bits(h1 / h2) != 1051372203 { exit(71) }
    if f64_to_f32bits(h1 / h2) == 1180000256 { exit(72) }      // 0x3555 widened

    // ================= mixed promotion: f32 with f64 is f64 =================
    // f16 < f32 < f64; an integer operand ranks f64. So f32 + f64 must NOT be
    // f32-rounded. (big2 + 1.0) - big2 is 1.0 only if the add was wide.
    let big2: f32 = 16777216.0
    let rw = (big2 + 1.0) - 16777216.0
    if f64_to_f32bits(rw) != 1065353216 { exit(73) }           // 1.0, i.e. f64 add

    // ================= literal suffixes are REAL typing =================
    if f64_to_f32bits(0.1f32) != 1036831949 { exit(81) }
    if f64_to_f16bits(0.1f16) != 11878 { exit(82) }
    // 1.0f32 is an f32, and it still promotes back to exactly 1.0 in an f64 context
    if f64bits(1.0f32) != f64bits(1.0) { exit(83) }
    // an f64 suffix is the same value it always was
    if f64bits(1.0f64) != f64bits(1.0) { exit(84) }
    // THE DOUBLE-ROUNDING PROBES. 7.038531e-26 (the classic Java float bug) and
    // 1.0000000596046448 round differently under "exact decimal -> f32" than
    // under "decimal -> f64 -> f32". The exact single rounding is what a type
    // suffix must mean, so these two literals pin fl_dexp2f32 against the
    // shortcut that would otherwise be an easy way to get this wrong.
    if f64_to_f32bits(7.038531e-26f32) != 363742205 { exit(85) }        // 0x15AE43FD, NOT 0x15AE43FE
    if f64_to_f32bits(1.0000000596046448f32) != 1065353217 { exit(86) } // 0x3F800001, NOT 0x3F800000
    // and the plain f64 literals of those same digits are UNCHANGED by 0.0.247
    if f64bits(7.038531e-26) != 4230507875723640832 { exit(87) }
    if f64bits(1.0000000596046448) != 4607182419068452864 { exit(88) }

    // ================= the f32/f16 formats' own edges =================
    if f32bits_to_f16(0) != 0 { exit(91) }
    if f32bits_to_f16(2147483648) != 32768 { exit(92) }        // -0.0f32 -> -0.0f16 (0x8000)
    if f32bits_to_f16(2139095040) != 31744 { exit(93) }        // +inf -> 0x7C00
    if f16bits_to_f32(31744) != 2139095040 { exit(94) }
    if f16bits_to_f32(1024) != 947912704 { exit(95) }          // f16 min normal 0x0400 -> 2^-14
    if f32bits_to_f16(947912704) != 1024 { exit(96) }
    // overflow rounds to infinity, exactly as the reference library does
    if f32bits_to_f16(1207959551) != 31744 { exit(97) }        // largest f32 that still rounds to inf
    println("fp16f32 type/width tests passed")
    return 0
}
