// stdlib_lfm2_bpe_test -- the native LFM2 tokenizer must reproduce upstream's
// token ids EXACTLY for every prompt in tests/fixtures/tokenizer_ref.txt.
//
// The fixture comes from scripts/audit/gen_tokenizer_ref.py, which drives
// llama.cpp's own test-tokenizer-0 against the real model. That binary is the
// oracle -- upstream's compiled code, not a transcription.
//
// Pipeline: std/lfm2_pretok (pre='lfm2') -> GPT-2 byte-level encode -> tokenize.
//
// pre='lfm2' sets ignore_merges in llama-vocab.cpp, so a pre-token that is
// itself a vocabulary entry is emitted as ONE token without any merge ranking
// (llama-vocab.cpp:618). That shortcut changes the output, not just the speed:
// "  " is in the vocab (266) but "  a" is not, so the two diverge.
import std/fs
import std/gguf
import std/gguf_bpe

// Whole-file buffered line reader. The fixture is small, and a per-byte
// read_raw() per input byte turns a 6 KB file into thousands of syscalls.
let buf_base = 0
let buf_len = 0
let buf_pos = 0

// Fixed generous capacity. The fixture is ~6 KB; a fixed buffer avoids
// lseek()-to-END, which does not return a usable file size here.
let buf_cap = 65536

fn load_all() {
    let fd = file_open("tests/fixtures/tokenizer_ref.txt", 0)
    if fd < 0 { return 0 }
    let b = mem_alloc(buf_cap)
    let got = read_raw(fd, b, buf_cap)
    file_close(fd)
    if got <= 0 { print("read got ", got); return 0 }
    buf_base = b
    buf_len = got
    buf_pos = 0
    return 1
}

// Copy the next line (without its newline) into `line`, leaving its length in
// *lenbox. Returns 0 at end of file.
fn next_line(line, maxline, lenbox) {
    if buf_pos >= buf_len { mem_store(lenbox, 0); return 0 }
    let n = 0
    while buf_pos < buf_len {
        let c = mem_load8(buf_base + buf_pos)
        buf_pos = buf_pos + 1
        if c == 10 { break }
        if n < maxline - 1 { mem_store8(line + n, c); n = n + 1 }
    }
    mem_store(lenbox, n)
    return 1
}

// base64 decode from `s` (length slen) into dst; returns byte count.
let b64rev = 0
let b64inited = 0
fn b64_init() {
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    b64rev = mem_alloc(128)
    let t = 0
    while t < 128 { mem_store8(b64rev + t, 255); t = t + 1 }
    t = 0
    // Quanta string literals are laid out [u64 len][chars][NUL], and a string
    // expression is the HEADER pointer -- so the first character is alpha+8.
    // Reading alpha+0 gives the length (6 or 64), which decodes to garbage.
    while t < 64 { mem_store8(b64rev + mem_load8(alpha + 8 + t), t); t = t + 1 }
    b64inited = 1
}
fn b64d(s, slen, dst) {
    if b64inited == 0 { b64_init() }
    let rev = b64rev
    let out = 0
    let acc = 0
    let bits = 0
    let j = 0
    while j < slen {
        let c = mem_load8(s + j)
        if c == 61 { j = j + 1; continue }
        let v = mem_load8(rev + c)
        if v == 255 { j = j + 1; continue }
        acc = (acc << 6) | v
        bits = bits + 6
        if bits >= 8 {
            bits = bits - 8
            mem_store8(dst + out, (acc >> bits) & 255)
            out = out + 1
        }
        j = j + 1
    }
    return out
}

// Parse a decimal run starting at `p`; leaves the chars consumed in
// pdec_used. A module global, not an out-parameter.
let pdec_used = 0

fn parse_dec(s, p, n) {
    let v = 0
    let k = 0
    while p + k < n {
        let c = mem_load8(s + p + k)
        if c < 48 || c > 57 { break }
        v = v * 10 + (c - 48)
        k = k + 1
    }
    pdec_used = k
    return v
}


let MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"
let MAXIDS = 4096

fn main() {
    if load_all() == 0 { print("FAIL open fixture"); return 1 }
    if gguf_load(MODEL) != 0 { print("FAIL gguf_load"); return 1 }
    if bpe_init_from_gguf() == 0 { print("FAIL bpe_init"); return 1 }

    let maxline = 65536
    let line = mem_alloc(maxline)
    let lenbox = mem_alloc(8)
    let sbuf = mem_alloc(65536)
    let ids = mem_alloc(MAXIDS * 8)

    let blocks = 0
    let fails = 0
    let total_ids = 0
    let lines_seen = 0

    while next_line(line, maxline, lenbox) {
        lines_seen = lines_seen + 1
        if lines_seen > 8000 { print("FAIL runaway line scan"); return 9 }
        let l = mem_load(lenbox)
        if !(l >= 3 && mem_load8(line) == 35 && mem_load8(line + 1) == 35 && mem_load8(line + 2) == 35) { continue }

        let a = 3
        while a < l && mem_load8(line + a) == 32 { a = a + 1 }
        let bidx = parse_dec(line, a, l)
        a = a + pdec_used
        while a < l && mem_load8(line + a) == 32 { a = a + 1 }
        let n = b64d(line + a, l - a, sbuf)

        let got = 0
        if n > 0 { got = bpe_encode(sbuf, n, ids, MAXIDS) }
        if got < 0 { print("FAIL block ", bidx, " bpe_encode error"); fails = fails + 1; continue }

        let k = 0
        let bad = 0
        let done = 0
        while next_line(line, maxline, lenbox) {
            let l2 = mem_load(lenbox)
            if l2 >= 3 && mem_load8(line) == 45 && mem_load8(line + 1) == 45 && mem_load8(line + 2) == 45 { done = 1; break }
            if l2 == 0 { continue }
            let p = 0
            let want = parse_dec(line, p, l2)
            if mem_load(ids + k * 8) != want {
                bad = bad + 1
                if bad < 4 { print("  block ", bidx, " tok ", k, " got ", mem_load(ids + k * 8), " want ", want) }
            }
            k = k + 1
        }
        if done == 0 { print("FAIL block ", bidx, " unterminated"); fails = fails + 1; continue }
        if k != got { print("FAIL block ", bidx, " count got=", got, " want=", k); fails = fails + 1; continue }
        if bad > 0 { print("FAIL block ", bidx, " mismatched=", bad); fails = fails + 1; continue }

        blocks = blocks + 1
        total_ids = total_ids + got
    }

    print("blocks=")
    print(blocks)
    print(" ids=")
    print(total_ids)
    print(" fails=")
    print(fails)
    if fails == 0 && blocks > 0 {
        // ---- round trip: encode -> decode must reproduce the input bytes ----
        //
        // Decode had NO coverage and did not exist before this round, so ids
        // could be produced but never turned back into text. A round trip is the
        // only cheap way to pin it: it catches a wrong byte-level inverse, an
        // off-by-one record read, and a leaked length prefix all at once.
        //
        // Note the calling convention: bpe_encode takes a RAW BYTE pointer, so a
        // string literal must be passed as (s + 8) with len(s). Passing the
        // string OBJECT encodes its 8-byte length header as text -- measured:
        // "Hello, world!" then came back as 13,0,0,0,0,0,0,0,"Hello,...".
        let rt_ids = mem_alloc(512 * 8)
        let rt_out = mem_alloc(4096)
        let cases = ["Hello, world!", "The capital of France is", "  spaced  out  ", "1234567890", "a"]
        let c = 0
        while c < 5 {
            let s = cases[c]
            let want_n = len(s)
            let got_n = bpe_encode(s + 8, want_n, rt_ids, 512)
            if got_n <= 0 { print("FAIL rt encode case "); print(c); return 1 }
            let back = bpe_decode(rt_ids, got_n, rt_out)
            if back != want_n { print("FAIL rt len case "); print(c); print(" got "); print(back); print(" want "); print(want_n); return 1 }
            let mm = 0
            let z = 0
            while z < want_n {
                if mem_load8(rt_out + z) != mem_load8(s + 8 + z) { mm = mm + 1 }
                z = z + 1
            }
            if mm != 0 { print("FAIL rt bytes case "); print(c); print(" mismatches "); print(mm); return 1 }
            c = c + 1
        }

        // an out-of-range id must be refused, not read out of bounds
        if bpe_decode_token(bpe_vocab_n + 10, rt_out) >= 0 { print("FAIL: out-of-range id decoded"); return 1 }
        if bpe_decode_token(0 - 1, rt_out) >= 0 { print("FAIL: negative id decoded"); return 1 }

        // ---- special tokens ----------------------------------------------
        //
        // llama.cpp splits the prompt on SPECIAL tokens before BPE. Without
        // this, "<|im_start|>" is tokenized as ordinary characters and the id
        // sequence differs from what llama.cpp feeds the model -- so any
        // comparison between the two is comparing different prompts.
        //
        // token_type is a flat i32 array: gguf_kv_arr_slurp() is for STRING
        // arrays and returns garbage here (it walks length-prefixed records),
        // which silently produced ZERO specials. Read elements via
        // gguf_kv_arr_elem_num.
        if bpe_special_count() <= 0 { print("FAIL: no special tokens found"); return 1 }
        let seen_bos = 0
        let seen_eos = 0
        let seen_im_start = 0
        let sp = 0
        while sp < bpe_special_count() {
            let id = bpe_special_id_at(sp)
            if id == 124894 { seen_bos = 1 }
            if id == 124900 { seen_eos = 1 }
            if id == 124899 { seen_im_start = 1 }
            sp = sp + 1
        }
        if seen_bos == 0 || seen_eos == 0 || seen_im_start == 0 {
            print("FAIL: expected special ids missing"); return 1
        }

        // descending-length order is what makes longest-match win.
        // Descending means each length must be <= the previous, so a violation
        // is l > prev. (Checked the other way round first and it reported a
        // failure on a correctly sorted list.)
        let prev = 1000000
        let order_ok = 1
        sp = 0
        while sp < bpe_special_count() {
            let l = bpe_token_len(bpe_special_id_at(sp))
            if l > prev { order_ok = 0 }
            prev = l
            sp = sp + 1
        }
        if order_ok == 0 { print("FAIL: specials not sorted by descending length"); return 1 }

        // A real chat prompt must yield the special ids as SINGLE tokens.
        // The prompt deliberately ENDS with <|im_end|> (no trailing newline):
        // with a trailing "\n" the final token is 207, not the special, and the
        // assertion below would be checking the wrong thing.
        let sp_prompt = "<|im_start|>user\nhi<|im_end|>"
        let sp_ids = mem_alloc(256 * 8)
        let sp_n = bpe_encode_special(sp_prompt + 8, len(sp_prompt), sp_ids, 256)
        if sp_n < 4 { print("FAIL: special prompt token count="); print(sp_n); return 1 }
        if mem_load(sp_ids + 0 * 8) != 124899 { print("FAIL: first token is not <|im_start|>"); return 1 }
        if mem_load(sp_ids + (sp_n - 1) * 8) != 124900 { print("FAIL: last token is not <|im_end|>"); return 1 }

        print("OK bpe")
        return 0
    }
    print("FAIL bpe")
    return 1
}
