// A6 (0.0.236): a `-> f64` user function whose parameter is written WITHOUT
// `: f64`, used in float arithmetic alongside an f64 constant.
//
// The parameter never got tagged as a float, so the SSE operand load chose
// fi2f_gp (cvtsi2sd) and CONVERTED an f64 bit pattern instead of moving it
// (fld_x/movq) -- silently returning garbage.
//
// Fixed at the CALL SITE (funcscan.quanta, scan_call_types): a parameter takes
// the type of the argument the caller passes, so `qmult(x)` inside reduce marks
// qmult's parameter float from reduce's own float parameter -- which the literal
// `reduce(0.5)` had already marked. The two earlier attempts are rejected for
// the reasons in docs/plans/bugs.md A6: an SSE-emit-site tag made which branch
// is taken depend on the tag that chose it, and a tag-pass rule had no evidence
// to propagate from.
//
// RED on 0.0.235: this exact program printed -4336984033343832063 (rc 1).
// GREEN on 0.0.236: 4602678819172646912 (rc 0). The dead-call sensitivity that
// hid this is documented in docs/research/call-order-f64-defect.md; the repro is
// tests/f64_call_order_defect.quanta, and the string twin is
// tests/a7_untyped_str_param_defect.quanta.
fn qmult(x) -> f64 {
    let y = x * (2.0 / 3.14159265358979323846)
    if y >= 4503599627370496.0 { return y }
    if y <= 0.0 - 4503599627370496.0 { return y }
    let magic = 4503599627370496.0
    return (y + magic) - magic
}

fn reduce(x) -> f64 {
    let ax = x
    if x < 0.0 { ax = 0.0 - x }
    let nf = qmult(x)
    if ax < 1048576.0 { return x - nf * f64of(4609753056924401664) }
    return x
}

fn main() {
    if f64bits(reduce(0.5)) == 4602678819172646912 { exit(0) }
    exit(1)
}
