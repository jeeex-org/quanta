// std/ir.quanta - IR representation for Quanta
// IR opcodes and data structures

const IR_NOP = 0;
const IR_CONST = 1;
const IR_PARAM = 2;
const IR_MOV = 3;
const IR_ADD = 4;
const IR_SUB = 5;
const IR_MUL = 6;
const IR_DIV = 7;
const IR_MOD = 8;
const IR_NEG = 9;
const IR_NOT = 10;
const IR_AND = 11;
const IR_OR = 12;
const IR_XOR = 13;
const IR_SHL = 14;
const IR_SHR = 15;
const IR_CMP = 16;
const IR_JMP = 17;
const IR_BR = 18;
const IR_CALL = 19;
const IR_CALL_IDX = 20;
const IR_RET = 21;
const IR_LABEL = 22;
const IR_STR = 23;
const IR_STOREG = 24;
const IR_LOADG = 25;
const IR_ALLOCA = 26;
const IR_FREE = 27;
const IR_CAPREAD = 28;
const IR_CLOSURE_CALL = 29;
const IR_F2I = 30;
const IR_I2F = 31;
const IR_FADD = 32;
const IR_FSUB = 33;
const IR_FMUL = 34;
const IR_FDIV = 35;
const IR_FCMP = 36;

module std_ir;

const IR_MAX_ARGS = 4;

fn opcode_name(op) {
    if op == IR_NOP { return "NOP"; }
    if op == IR_CONST { return "CONST"; }
    if op == IR_PARAM { return "PARAM"; }
    if op == IR_MOV { return "MOV"; }
    if op == IR_ADD { return "ADD"; }
    if op == IR_SUB { return "SUB"; }
    if op == IR_MUL { return "MUL"; }
    if op == IR_DIV { return "DIV"; }
    if op == IR_MOD { return "MOD"; }
    if op == IR_NEG { return "NEG"; }
    if op == IR_NOT { return "NOT"; }
    if op == IR_AND { return "AND"; }
    if op == IR_OR { return "OR"; }
    if op == IR_XOR { return "XOR"; }
    if op == IR_SHL { return "SHL"; }
    if op == IR_SHR { return "SHR"; }
    if op == IR_CMP { return "CMP"; }
    if op == IR_JMP { return "JMP"; }
    if op == IR_BR { return "BR"; }
    if op == IR_CALL { return "CALL"; }
    if op == IR_CALL_IDX { return "CALL_IDX"; }
    if op == IR_RET { return "RET"; }
    if op == IR_LABEL { return "LABEL"; }
    if op == IR_STR { return "STR"; }
    if op == IR_STOREG { return "STOREG"; }
    if op == IR_LOADG { return "LOADG"; }
    if op == IR_ALLOCA { return "ALLOCA"; }
    if op == IR_FREE { return "FREE"; }
    if op == IR_CAPREAD { return "CAPREAD"; }
    if op == IR_CLOSURE_CALL { return "CLOSURE_CALL"; }
    if op == IR_F2I { return "F2I"; }
    if op == IR_I2F { return "I2F"; }
    if op == IR_FADD { return "FADD"; }
    if op == IR_FSUB { return "FSUB"; }
    if op == IR_FMUL { return "FMUL"; }
    if op == IR_FDIV { return "FDIV"; }
    if op == IR_FCMP { return "FCMP"; }
    return "UNKNOWN";
}

fn is_arith(op) {
    return op >= IR_ADD && op <= IR_MOD;
}

fn is_float_arith(op) {
    return op >= IR_FADD && op <= IR_FDIV;
}

fn is_branch(op) {
    return op == IR_JMP || op == IR_BR;
}

fn is_call(op) {
    return op == IR_CALL || op == IR_CALL_IDX || op == IR_CLOSURE_CALL;
}

fn init() -> i64 {
    return 0;
}

fn main() -> i64 {
    return init();
}