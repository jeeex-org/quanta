// Register allocation under pressure: a binary op's SECOND operand must not
// evict the FIRST.
//
// The bug
//
// Every binary op emits:
//     let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2)
//     if rd!=r1 { rr(rd,r1) }; ra(rd,r2)
//
// aphys() falls back to afree() when the vreg has no register. afree() has no
// idea what the instruction being emitted still needs: with the register pool
// full it evicts the LAST map entry unconditionally. So aphys(a1) could evict
// a0 -- which had just been loaded a moment earlier -- and then be handed that
// same register. Both operands landed in one register and the op computed x+x.
//
// Measured at the single place it fires, with a probe printing a1/a2/allocfc:
//     P0 a1=41 a2=41 allocfc=21
//
// Reproducers, integers only, no floats anywhere:
//
//     fn seven(n) -> i64 { let a=n+1 ... let g=n+7   return g }
//     seven(1) -> 14   (want 8)          <- 7th binding computed n+n
//
//     fn s7(n) -> i64 { let a=n+1 ... let g=n+7   return a+b+c+d+e+f+g }
//     s7(1) -> 41 (want 35), s8 -> 57 (want 44), s9 -> 75 (want 54)
//
// Six live values were correct; seven is where the live count first exceeds the
// thirteen physical registers. allocfc=21 against 13 registers is the same fact.
//
// The fix: aphys_x(vr, ex) and afree_x(ex), used as `aphys_x(a1, a0)` at all 19
// binary-op sites, so the second operand's allocation can never take the first
// operand's register.
//
// EXPECTED VALUES ARE DERIVED, NEVER HAND-WRITTEN
//
// This test's first version asserted s7(10) == 91 and terms6(10) == 75. Both are
// wrong: the sums are 7n+28 and 6n+21, so 98 and 81. The compiler was right and
// the test was wrong -- the same class of mistake as writing pi's bit pattern as
// 10.0, which cost ten sessions chasing a compiler bug that did not exist. Every
// expectation below is computed from the formula in want().

fn eq(a: i64, b: i64) -> i64 { if a == b { return 1 } return 0 }

// want(n, terms) = sum(n+1 .. n+terms) = terms*n + terms*(terms+1)/2
fn want(n: i64, terms: i64) -> i64 { return terms*n + terms*(terms+1)/2 }

fn bind6(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6  return a+b+c+d+e+f }
fn bind7(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7  return a+b+c+d+e+f+g }
fn bind8(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7 let h=n+8  return a+b+c+d+e+f+g+h }
fn only7(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7  return g }
fn only8(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7 let h=n+8  return h }
fn rev(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7  return g+f+e+d+c+b+a }
fn odd(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7  return a+c+e+g }
fn ends(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7  return a+g }
fn mixed(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7  return (a+b)*(c+d)-(e+f) }
fn subs(n: i64) -> i64 { let a=n+1 let b=n+2 let c=n+3 let d=n+4 let e=n+5 let f=n+6 let g=n+7  return a-b-c-d-e-f-g }

// partial sums of the seven-term chain, staged so a break localises to one add
fn parts(n: i64) -> i64 {
    let a=n+1
    let b=n+2
    let c=n+3
    let d=n+4
    let e=n+5
    let f=n+6
    let g=n+7
    let s1 = a+b
    let s2 = s1+c
    let s3 = s2+d
    let s4 = s3+e
    let s5 = s4+f
    let s6 = s5+g
    return s6
}

fn main() -> i64 {
    let fails = 0

    // 1. Six terms: always correct. Guards against the fix regressing the
    //    common path.
    if eq(bind6(1), want(1,6)) != 1 { print("FAIL 1 bind6(1)="); print(bind6(1)); print(" want "); print(want(1,6)); print("\n") fails = fails + 1 }

    // 2. Seven terms -- the threshold. Returned 41 before the fix.
    if eq(bind7(1), want(1,7)) != 1 { print("FAIL 2 bind7(1)="); print(bind7(1)); print(" want "); print(want(1,7)); print("\n") fails = fails + 1 }

    // 3. Eight terms: the error grew with term count before the fix.
    if eq(bind8(1), want(1,8)) != 1 { print("FAIL 3 bind8(1)="); print(bind8(1)); print(" want "); print(want(1,8)); print("\n") fails = fails + 1 }

    // 4. The seventh BINDING alone returned n+n before the fix.
    if eq(only7(1), 8) != 1 { print("FAIL 4 only7(1)="); print(only7(1)); print(" want 8\n") fails = fails + 1 }

    // 5. And the eighth.
    if eq(only8(1), 9) != 1 { print("FAIL 5 only8(1)="); print(only8(1)); print(" want 9\n") fails = fails + 1 }

    // 6. Values past the single-byte immediate range, which took a different
    //    encoding path.
    if eq(bind7(10), want(10,7)) != 1 { print("FAIL 6 bind7(10)="); print(bind7(10)); print(" want "); print(want(10,7)); print("\n") fails = fails + 1 }
    if eq(bind7(0), want(0,7)) != 1 { print("FAIL 7 bind7(0)="); print(bind7(0)); print(" want "); print(want(0,7)); print("\n") fails = fails + 1 }
    if eq(bind7(100), want(100,7)) != 1 { print("FAIL 8 bind7(100)="); print(bind7(100)); print(" want "); print(want(100,7)); print("\n") fails = fails + 1 }

    // 9. Operand ORDER must not matter: the corruption was order-sensitive.
    if eq(parts(1), want(1,7)) != 1 { print("FAIL 9 parts(1)="); print(parts(1)); print(" want "); print(want(1,7)); print("\n") fails = fails + 1 }
    if eq(rev(1), want(1,7)) != 1 { print("FAIL 10 rev(1)="); print(rev(1)); print(" want "); print(want(1,7)); print("\n") fails = fails + 1 }

    // 11. Non-adjacent operands.
    if eq(odd(1), 2+4+6+8) != 1 { print("FAIL 11 odd(1)="); print(odd(1)); print(" want 20\n") fails = fails + 1 }

    // 12. A single two-operand op under the same pressure.
    if eq(ends(1), 2+8) != 1 { print("FAIL 12 ends(1)="); print(ends(1)); print(" want 10\n") fails = fails + 1 }

    // 13. Mixed multiply/subtract -- same emit path, both operand orders.
    let mw = (2+3)*(4+5)-(6+7)
    if eq(mixed(1), mw) != 1 { print("FAIL 13 mixed(1)="); print(mixed(1)); print(" want "); print(mw); print("\n") fails = fails + 1 }

    // 14. Subtraction, where an operand aliasing shows up as a lost term rather
    //     than a doubled one.
    if eq(subs(1), 2-3-4-5-6-7-8) != 1 { print("FAIL 14 subs(1)="); print(subs(1)); print(" want -31\n") fails = fails + 1 }

    if fails == 0 { print("std_regalloc: 14/14 PASS\n") return 0 }
    print("std_regalloc: FAILS="); print(fails); print("\n")
    return 1
}