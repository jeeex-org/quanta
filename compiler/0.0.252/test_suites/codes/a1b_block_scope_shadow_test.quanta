// A1b (0.0.237): an inner block's `let` must not rebind the enclosing variable.
//
// Defect: the binding table was only ever appended to, so a `let` inside a block
// stayed the resolution target for the rest of the enclosing function. A later
// store therefore landed in the INNER variable's storage -- a store into a
// different variable's storage, which is the shape of defect A1 (SIGSEGV) and a
// memory-corruption primitive for a language with raw pointers, mem_alloc, FFI,
// asm! and MMIO.
//
// Before the fix this program exits 99 (or 77/55/33 depending on which block
// form ran last); with block-scoped bindings it exits 42.
// NOTE: `let p = 99` inside a block and then READING `p` after the block is a
// compile error (undeclared variable) unless an outer `p` exists -- that is the
// fail-closed half of the same fix and is asserted in WIP.md's migration table.
fn main() {
    let p = 11
    let a = 1
    if a == 1 { let p = 99 }
    if p != 11 { exit(1) }
    let q = 0
    while q < 1 { let p = 77
        q = q + 1 }
    if p != 11 { exit(2) }
    let i = 0
    for i = 0; i < 2; i = i + 1 { let p = 55 }
    if p != 11 { exit(3) }
    { let p = 33 }
    if p != 11 { exit(4) }
    unsafe { let p = 22 }
    if p != 11 { exit(5) }
    exit(42)
}
