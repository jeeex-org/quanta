// param8: 8-parameter function — regression test for >6-arg corruption.
// Currently BROKEN in qc-1.0.0: param g (7th) reads 8 instead of 7,
// so this returns 37 instead of 36. The fix session must make it return 36.
fn s(a,b,c,d,e,f,g,h){return a+b+c+d+e+f+g+h}
fn main(){return s(1,2,3,4,5,6,7,8)}
