// packed_test -- Phase B2 (0.0.230): packed structs with sub-qword fields.
//
// A plain Quanta struct strides fields by 8 bytes. That cannot express an
// x86-64 IDT gate descriptor (16 bytes, fields at offsets 0, 2, 4, 5, 6, 8, 12).
// A `packed struct` lays fields out at their packed byte offsets, width from
// the `: type` annotation.
//
// The property under test is the LAYOUT, verified through real memory:
//   1. each field reads back exactly the value written
//   2. writing a sub-qword field does NOT disturb its neighbors (byte-precise
//      stores; packed fields never share bytes, so no RMW is required)
//   3. the IDT gate descriptor layout is expressible: 7 fields at the exact
//      x86-64 offsets, total 16 bytes
//   4. packed fields read as UNSIGNED (zero-extended) — documented semantics

// The real x86-64 IDT gate descriptor: 16 bytes, fields at 0,2,4,5,6,8.
packed struct IdtGate {
    off_lo: u16,
    sel: u16,
    ist: u8,
    type_attr: u8,
    off_mid: u16,
    off_hi: u32,
    zero: u32
}

packed struct Mixed {
    a: u8,
    b: u32,
    c: u16,
    d: u8,
    e: u64
}

fn main() -> i64 {
    let fails = 0

    // ---- 1/2/3. the IDT gate: write every field, read them all back ----
    let g = IdtGate { off_lo: 4660, sel: 8, ist: 1, type_attr: 143, off_mid: 52428, off_hi: 1, zero: 0 }
    // offsets: off_lo@0 sel@2 ist@4 type_attr@5 off_mid@6 off_hi@8 zero@12
    let v0 = g.off_lo
    let v1 = g.sel
    let v2 = g.ist
    let v3 = g.type_attr
    let v4 = g.off_mid
    let v5 = g.off_hi
    let v6 = g.zero
    print("gate: ")
    print(v0); print(" ")
    print(v1); print(" ")
    print(v2); print(" ")
    print(v3); print(" ")
    print(v4); print(" ")
    print(v5); print(" ")
    print(v6); print("\n")
    if v0 != 4660 { print("FAIL off_lo\n"); fails = fails + 1 }
    if v1 != 8 { print("FAIL sel\n"); fails = fails + 1 }
    if v2 != 1 { print("FAIL ist\n"); fails = fails + 1 }
    if v3 != 143 { print("FAIL type_attr\n"); fails = fails + 1 }
    if v4 != 52428 { print("FAIL off_mid\n"); fails = fails + 1 }
    if v5 != 1 { print("FAIL off_hi\n"); fails = fails + 1 }
    if v6 != 0 { print("FAIL zero\n"); fails = fails + 1 }

    // ---- neighbor isolation: overwrite ist and re-read sel/type_attr ----
    g.ist = 255
    let s2 = g.sel
    let t2 = g.type_attr
    if s2 != 8 { print("FAIL: writing ist disturbed sel\n"); fails = fails + 1 }
    if t2 != 143 { print("FAIL: writing ist disturbed type_attr\n"); fails = fails + 1 }
    // full-width neighbor too
    g.off_hi = 4294967295
    let m2 = g.off_mid
    if m2 != 52428 { print("FAIL: writing off_hi disturbed off_mid\n"); fails = fails + 1 }

    // ---- 4. mixed widths, including a trailing u64 ----
    // offsets: a@0 b@1 c@5 d@7 e@8, total 16
    let m = Mixed { a: 200, b: 305419896, c: 52428, d: 77, e: 9223372036854775807 }
    let ma = m.a
    let mb = m.b
    let mc = m.c
    let md = m.d
    let me = m.e
    print("mixed: ")
    print(ma); print(" ")
    print(mb); print(" ")
    print(mc); print(" ")
    print(md); print(" ")
    print(me); print("\n")
    if ma != 200 { print("FAIL m.a\n"); fails = fails + 1 }
    if mb != 305419896 { print("FAIL m.b\n"); fails = fails + 1 }
    if mc != 52428 { print("FAIL m.c\n"); fails = fails + 1 }
    if md != 77 { print("FAIL m.d\n"); fails = fails + 1 }
    if me != 9223372036854775807 { print("FAIL m.e\n"); fails = fails + 1 }

    // u8 wraps at 255 (zero-extend, unsigned semantics)
    m.a = 255
    let mx = m.a
    if mx != 255 { print("FAIL m.a 255\n"); fails = fails + 1 }

    if fails == 0 { print("packed: all pass\n") } else { print("packed: FAILURES\n"); return 1 }
    return 0
}
