// f64 arithmetic and comparison across function boundaries.
//
// Four independent defects hid here, and each was masked by the others. Any one
// of them alone would have been an intermittent, baffling failure, which is why
// this file tests the COMBINATION rather than each op alone.
//
// 1. PREFIX ORDER. Nearly every SSE encode in emitter.quanta was `66 48 0F ..` --
//    the operand-size prefix before REX, which is an illegal encoding. The CPU
//    raised #UD and EVERY binary doing float arithmetic died with SIGILL.
//    Integer arithmetic uses no prefixes at all, which is why the gate stayed
//    green: nothing else in the suite touches floats.
// 2. FLOAT PARAMS WERE UNTAGGED. `vfloat` was set for the results of float ops
//    and for f64 locals (via the IR_FCONST that produced them) but never for a
//    parameter, so `fn f(a: f64) -> f64 { a / 2.0 }` took the integer idiv path
//    and raised SIGFPE on the bit patterns. + - * survived only because their
//    integer and float paths happened to agree on the values first tried.
// 3. FLOAT RETURNS WERE UNTAGGED AT THE CALL SITE. IR_RET is a plain register
//    move and hands the bits back intact, but nothing told the caller, so
//    `f(1.0) == 0.1` compared 4607182418800017408 against 0.1.
// 4. FLOAT COMPARISONS WERE BITWISE. IR_EQ and friends used the integer rcmp
//    over the two bit patterns. That agrees with the truth for exactly
//    representable results (0.5, 0.25) and disagrees for the rest (0.1, 0.2), so
//    `0.1 == 0.1` passed when both sides folded the same way and failed once one
//    side had been through a call.
//
// Build:  qc float_arith_test.quanta out
// Run:    out ; echo $?   -- expect 42

// Division on a PARAMETER: defect 2. Raised SIGFPE before the fix.
fn half(x: f64) -> f64 {
    return x / 2.0;
}

// A returned float compared against a literal: defects 3 and 4.
fn identity(x: f64) -> f64 {
    return x;
}

fn divide(a: f64, b: f64) -> f64 {
    return a / b;
}

// A plain int function, to confirm the float work left integer calls alone.
// (Declared at top level: a NESTED `fn` inside main crashes the compiler with
// SIGILL on 0.0.217 as well as 0.0.218 -- a separate pre-existing bug, recorded
// here only so this test is not blamed for it.)
fn inc2(n: i32) -> i32 { return n + 1; }

fn main() -> i32 {
    // 1. float division on a parameter
    if half(10.0) != 5.0 { return 10; }
    if half(1.0) != 0.5 { return 11; }

    // 2. arithmetic on two parameters, fractional results (0.5 * 0.25 = 0.125)
    if half(0.5) != 0.25 { return 12; }

    // 3. a returned float compared to a non-dyadic literal. 0.1 is not exactly
    //    representable, so this is the case that a bitwise compare gets wrong.
    if identity(1.0) != 1.0 { return 13; }
    if identity(0.1) != 0.1 { return 14; }
    if identity(0.2) != 0.2 { return 15; }

    // 4. non-dyadic comparison, both sides through a call
    if identity(0.1) != identity(0.1) { return 16; }

    // 5. 1.0/3.0 is not representable; the compare must be on the value.
    let third = 1.0 / 3.0;
    if divide(1.0, 3.0) != third { return 17; }
    if divide(9.0, 3.0) != 3.0 { return 18; }

    // 6. the six comparisons, on values that are NOT all bitwise-distinct
    if !(0.1 < 0.2) { return 20; }
    if !(0.2 > 0.1) { return 21; }
    if !(0.1 <= 0.1) { return 22; }
    if !(0.1 >= 0.1) { return 23; }
    if (0.1 == 0.2) { return 24; }
    if !(0.1 != 0.2) { return 25; }
    // and negative zero / equal values
    if !(1.0 == 1.0) { return 26; }
    if !(1.0 != 2.0) { return 27; }

    // 7. integer arithmetic must be untouched by any of the above.
    //    Each line below states a TRUE fact about integers. Reaching a return
    //    code means the float work leaked into the integer path. (This section
    //    was originally written as `if <true condition> { return n; }`, which
    //    asserts the opposite of what it reads like -- the test returned 30 and
    //    32 on a compiler whose integer path was correct.)
    if 10 / 3 != 3 { return 30; }
    if 10 * 3 != 30 { return 31; }
    if 1 == 2 { return 32; }
    if 2 < 1 { return 33; }
    if inc2(1) != 2 { return 34; }
    if 7 % 3 != 1 { return 35; }
    if (1 << 4) != 16 { return 36; }
    if (255 & 15) != 15 { return 37; }

    return 42;
}
