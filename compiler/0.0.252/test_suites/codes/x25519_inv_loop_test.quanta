// x25519_inv_loop_test.quanta — test loop with fe_sq

import std/x25519

fn main() {
  println("Test loop with fe_sq...")
  let u9 = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u9 + i, 0); i = i + 1 }
  mem_store8(u9, 9)
  
  let fe = mem_alloc(5*8)
  fe_from_bytes(u9, fe)
  
  let fe2 = mem_alloc(5*8)
  
  let j = 0
  while j < 255 {
    fe_sq(fe, fe2)
    fe_copy(fe2, fe)
    j = j + 1
  }
  
  println("loop done")
  println(0)
  exit(0)
}