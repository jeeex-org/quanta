// x25519_sub_sq_test.quanta — test fe_sub then fe_sq

import std/x25519

fn main() {
  println("Test fe_sub then fe_sq...")
  
  let a = mem_alloc(8*8)
  fe_zero(a)
  mem_store(a, 81)
  
  let b = mem_alloc(8*8)
  fe_zero(b)
  mem_store(b, 9)
  
  let t = mem_alloc(8*8)
  fe_sub(a, b, t)
  println("sub done")
  
  let out = mem_alloc(8*8)
  fe_sq(t, out)
  println("sq done")
  
  println("Done")
  println(0)
  exit(0)
}