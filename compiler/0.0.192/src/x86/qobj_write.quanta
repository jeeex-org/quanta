// Write functions + IR to .qobj with portable string format
fn qobj_write(path) -> i64 {
  let fd = file_open(path, 577)
  if fd < 0 { return 0 }
  
  // Count functions with IR
  let fn_count = 0
  let total_name_bytes = 0
  let total_ir_records = 0
  let i = 0
  while i < fnc {
    let ir_count = r64(fn_ir_count + i*8)
    if ir_count > 0 {
      fn_count = fn_count + 1
      total_name_bytes = total_name_bytes + r64(fns + i*FNS + 8) + 1
      total_ir_records = total_ir_records + ir_count
    }
    i = i + 1
  }
  
  // Write header (20 bytes at offset 0)
  let hdr = mmap(64)
  w32(hdr, 0x514F424A)  // "QOBJ"
  w32(hdr + 4, 6)        // version
  w32(hdr + 8, fn_count) // fn_count
  w32(hdr + 12, total_ir_records) // ir_count
  w32(hdr + 16, total_name_bytes)
  file_write(fd, hdr, 20)
  
  // Write function entries (all entries first, then all name blobs)
  if fn_count > 0 {
    let str_off = 0
    i = 0
    while i < fnc {
      let ir_count = r64(fn_ir_count + i*8)
      if ir_count > 0 {
        let name_len = r64(fns + i*FNS + 8)
        
        // Write 32-byte entry at offset 0 (zeroed first)
        let entry = mmap(64)
        w32(entry, str_off)
        w32(entry + 4, name_len)
        w32(entry + 8, r64(fn_pcount + i*8))
        w32(entry + 12, 0)
        w32(entry + 16, 0)
        w32(entry + 20, 0)
        w32(entry + 24, 0)
        w32(entry + 28, 0)
        file_write(fd, entry, 32)
        
        str_off = str_off + name_len + 1
      }
      i = i + 1
    }
    
    // Now write all name blobs
    i = 0
    while i < fnc {
      let ir_count = r64(fn_ir_count + i*8)
      if ir_count > 0 {
        let name_ptr = r64(fns + i*FNS)  // offset into src data
        let name_len = r64(fns + i*FNS + 8)
        
        if name_len > 0 {
          // Copy name from src to local buffer and write
          let name_buf = mmap(name_len + 8)
          let j = 0
          while j < name_len {
            w8(name_buf + j, r8(src + 8 + name_ptr + j))
            j = j + 1
          }
          file_write(fd, name_buf, name_len)
        }
        
        // Write NUL terminator
        let nul = mmap(8)
        w8(nul, 0)
        file_write(fd, nul, 1)
      }
      i = i + 1
    }
    
    // Write IR records (40 bytes each)
    i = 0
    while i < fnc {
      let ir_count = r64(fn_ir_count + i*8)
      if ir_count > 0 {
        let ir_start = r64(fn_ir_start + i*8)
        let j = 0
        while j < ir_count {
          let ir_idx = ir_start + j
          let rec = mmap(64)
          w64(rec, r64(ir + ir_idx*IRS))
          w64(rec + 8, r64(ir + ir_idx*IRS + 8))
          w64(rec + 16, r64(ir + ir_idx*IRS + 16))
          w64(rec + 24, r64(ir + ir_idx*IRS + 24))
          w64(rec + 32, r64(ir + ir_idx*IRS + 32))
          file_write(fd, rec, 40)
          j = j + 1
        }
      }
      i = i + 1
    }
  }
  
  file_close(fd)
  return 1
}