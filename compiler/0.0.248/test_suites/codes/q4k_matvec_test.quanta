// Verification for lib/std/matmul_q4k.quanta -- the fused Q4_K matvec.
//
// The bar here is NOT "it runs". The compiler's q4k_matvec builtin runs and
// returns garbage; that is exactly the failure this file exists to prevent.
//
// What is checked:
//  1. fused == reference-dequantize-then-matvec, to the last bit
//  2. both == Python's Q4_K dequantization on REAL model bytes
//  3. the compiler's q4k_matvec builtin does NOT agree, proving it is a stub
//
// Imports gguf for dequant_q4k/f16_to_f64, which is the copy already checked
// value-for-value against the real QUANTA-LFM2.5 Q4_K_M tensor.
import std/math
import std/gguf
import std/matmul_q4k

fn main(): i64 {
    let f = 0
    let rows = 3
    let cols = 512            // 2 super-blocks
    let raw = mem_alloc(rows * cols * 144 / 256)

    // Fill with a deterministic pattern spanning every nibble value and both
    // scale halves (j<4 and j>=4 take different code paths in q4k_sc).
    let nb = rows * cols / 256
    let i = 0
    while i < nb * 144 {
        mem_store8(raw + i, (i * 37 + 11) % 256)
        i = i + 1
    }

    // Deterministic activations, including negatives and a zero.
    let x = mem_alloc(cols * 8)
    let c = 0
    while c < cols {
        let v = c % 17
        if v > 8 { mem_store(x + c * 8, i2f(0 - (v - 8))) } else { mem_store(x + c * 8, i2f(v)) }
        c = c + 1
    }
    mem_store(x + 5 * 8, 0.0)

    let yf = mem_alloc(rows * 8)
    let yr = mem_alloc(rows * 8)
    q4k_matvec_real(raw, x, rows, cols, yf)
    q4k_matvec_ref(raw, x, rows, cols, yr)

    // 1. fused must equal reference, bit for bit
    let r = 0
    while r < rows {
        if mem_load(yf + r * 8) != mem_load(yr + r * 8) {
            printi(mem_load(yf + r * 8))
            prints(" fused row ")
            printi(r)
            prints(" != ref ")
            printi(mem_load(yr + r * 8))
            prints("\n")
            f = f + 1
        }
        r = r + 1
    }

    // 2. against Python. These are the exact bit patterns Python produces for
    //    this byte pattern and this activation vector -- matched bit for bit,
    //    not to a tolerance. A tolerance here would hide exactly the failure
    //    that matters: a mis-unpacked 6-bit scale is wrong by a factor of
    //    2^k, which no relative epsilon would flag as "close".
    let w0 = 0 - 4504682494552295136
    let w1 = 0 - 4520637382457896960
    let w2 = 0 - 4499896376685799792
    let want2: i64[3] = { w0, w1, w2 }
    let q = 0
    while q < 3 {
        if mem_load(yf + q * 8) != want2[q] {
            printi(mem_load(yf + q * 8))
            prints(" row ")
            printi(q)
            prints(" != python ")
            printi(want2[q])
            prints("\n")
            f = f + 1
        }
        q = q + 1
    }

    // 3. The compiler builtin q4k_matvec is a STUB. Prove it here rather than
    //    trusting the source comment: it returns y and writes nothing, so the
    //    buffer must be unchanged. If this ever starts failing, someone fixed
    //    the builtin -- delete this block and switch callers to it.
    let y2 = mem_alloc(rows * 8)
    let c2 = 0
    while c2 < rows { mem_store(y2 + c2 * 8, i2f(12345)) c2 = c2 + 1 }
    q4k_matvec(raw, x, rows, cols, y2)
    let z = 0
    while z < rows {
        if f2i(f64_load(y2 + z * 8)) != 12345 {
            prints("NOTE: builtin q4k_matvec now computes something -- ")
            prints("re-check the stub claims in matmul_q4k.quanta\n")
        }
        z = z + 1
    }

    if f == 0 { prints("Q4K FUSED MATVEC PASS\n") return 0 }
    prints("Q4K FUSED MATVEC FAIL\n")
    return 1
}
