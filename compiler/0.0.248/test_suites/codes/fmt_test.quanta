import std/fmt

fn main(): i64 {
    println("Testing fmt_printf_int:")
    fmt_printf_int("Test %d\n", 42)
    println("Testing fmt_printf_str:")
    fmt_printf_str("Test %s\n", "hello")
    println("Testing fmt_printf_int_str:")
    fmt_printf_int_str("%d %s\n", 123, "world")
    println("Testing %%:")
    fmt_printf_int("100%%\n", 0)
    println("EXTERN_VAR_OK")
    0
}