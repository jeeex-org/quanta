// First part only - mut + move + ref on DIFFERENT variable
fn make() -> u64 {
    return 42
}

fn main() {
    // --- mut: rebindable local ---
    mut a = 10
    a = a + 5
    if a != 15 { return 1 }

    // --- ref: borrow alias of a mutable local (deref reads through) ---
    mut base = 100
    ref r = &base
    if *r != 100 { return 2 }      // r reads through to base
    base = 250
    if *r != 250 { return 3 }      // alias reflects the mutation

    // --- move: ownership transfer prefix (no-op semantics today) ---
    let v = 7
    let w = move v
    if w != 7 { return 4 }

    // --- composition: mut + move (no ref) ---
    mut m = 1
    m = m + 1
    let taken = move m
    if taken != 2 { return 5 }

    return 0
}