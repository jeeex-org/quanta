import std/fs

// Test: GGUF header parsing
fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { return 1 }
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    
    // Check magic
    if mem_load8(hdr) != 71 { close(fd); return 1 }
    
    // Check n_tensors > 0
    let n_tensors = mem_load(hdr + 16)
    if n_tensors <= 0 { close(fd); return 1 }
    
    close(fd)
    return 0
}