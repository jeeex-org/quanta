// trait_min: trait + single impl + method call returning a computed value.
// Real assertion: Circle.draw() returns radius*2 == 10.
// (Was a no-op: constructed Circle, returned 0.)
trait Drawable {
    fn draw(self) -> int
}

struct Circle {
    radius: int
}

impl Drawable for Circle {
    fn draw(self) -> int {
        self.radius * 2
    }
}

fn main() {
    let c = Circle { radius: 5 }
    return c.draw()   // 5 * 2 = 10
}
