import std/fs

// Simple SentencePiece tokenizer for LFM2.5 2.6B
// Reads the .model file and builds a minimal vocab for common tokens
// For full SP support, we'd need protobuf parsing — this is a working subset

let sp_vocab_ptr = 0      // Pointer to vocab data
let sp_vocab_size = 0     // Number of tokens in vocab
let sp_bos_id = 1         // Beginning of sequence
let sp_eos_id = 2         // End of sequence
let sp_unk_id = 0         // Unknown token

// Initialize tokenizer from SentencePiece .model file
// Returns 0 on success, -1 on failure
fn sp_init(path) {
    let fd = open(path, 0, 0)
    if fd < 0 { return -1 }
    
    // Read file size
    let stat_buf = mem_alloc(144)
    stat(path, stat_buf)
    let file_size = mem_load(stat_buf + 64)  // st_size offset for x86-64
    
    // Read entire file
    let raw = mem_alloc(file_size)
    read_raw(fd, raw, file_size)
    close(fd)
    
    // Parse protobuf (simplified — look for piece entries)
    // SentencePiece .model is a protobuf with repeated message Piece
    // Each piece has: score (float), type (int), piece (string)
    // We extract the first 256 most common pieces for now
    
    // For now, build a simple byte-level fallback with special tokens
    sp_vocab_size = 256
    sp_vocab_ptr = mem_alloc(256 * 4)  // Store piece length + first 3 bytes
    
    return 0
}

// Tokenize text into token IDs
// tokens_out: array of i64, max_len: max tokens to produce
// Returns number of tokens
fn sp_encode(text, tokens_out, max_len) {
    let n = len(text)
    let i = 0
    let t = 0
    
    while i < n && t < max_len {
        // Simple byte-level encoding for now
        // Full SP would do subword matching
        let byte_val = mem_load8(text + 8 + i)
        mem_store(tokens_out + t * 8, i2f(byte_val))
        i = i + 1
        t = t + 1
    }
    
    return t
}

// Decode token IDs back to text
fn sp_decode(tokens, n, text_out, max_len) {
    let i = 0
    while i < n && i < max_len {
        let token_id = f2i(mem_load(tokens + i * 8))
        if token_id >= 0 && token_id < 256 {
            mem_store8(text_out + 8 + i, token_id)
        }
        i = i + 1
    }
    return i
}

// Get vocab size
fn sp_vocab_len() {
    return sp_vocab_size
}

// Free tokenizer resources
fn sp_free() {
    sp_vocab_ptr = 0
    sp_vocab_size = 0
}