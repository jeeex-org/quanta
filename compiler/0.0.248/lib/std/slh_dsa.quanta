// Key generation
fn slh_dsa_keygen(): (u8[32], u8[64]) {
    let pk: u8[32]
    let sk: u8[64]
    // sk = SK_seed(16) || SK_prf(16) || PK_seed(16) || PK_root(16)
    // pk = PK_seed(16) || PK_root(16)
    return (pk, sk)
}

