fn main() {
    let addr = mmap(64)
    mem_store8(addr, 65)
    mem_store8(addr + 1, 66)
    mem_store8(addr + 2, 67)
    let b0 = mem_load8(addr)
    let b1 = mem_load8(addr + 1)
    let b2 = mem_load8(addr + 2)
    let val = b0 + b1 + b2
    mem_store(addr, val)
    let loaded = mem_load(addr)
    return loaded
}
