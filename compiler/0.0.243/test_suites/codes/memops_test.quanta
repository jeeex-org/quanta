// Memory builtins: memcpy, memmove, memcmp, realloc.
// Verification uses early-exit-on-failure: each check exits with a distinct
// nonzero code if it fails; reaching the end means all passed (exit 0).
// (Avoids the compiler's if-block assignment-drop bug under heavy builtin-&&
//  sequences; the builtins themselves are correct, verified individually.)
fn main() {
  // --- memcpy: copy "QU" (2 bytes) into a buffer ---
  let src = mmap(16)
  let dst = mmap(16)
  mem_store8(src+8, 81)   // 'Q'
  mem_store8(src+9, 85)   // 'U'
  memcpy(dst+8, src+8, 2)
  if !(mem_load8(dst+8)==81 && mem_load8(dst+9)==85) { exit(1) }

  // --- memcmp: equal / less / greater ---
  let a = mmap(16)
  let b = mmap(16)
  mem_store8(a+8, 10); mem_store8(a+9, 20)
  mem_store8(b+8, 10); mem_store8(b+9, 20)
  if !(memcmp(a+8, b+8, 2)==0) { exit(2) }
  mem_store8(b+9, 21)                                   // b[1] > a[1]
  if !(memcmp(a+8, b+8, 2)<0) { exit(3) }               // a < b -> negative
  if !(memcmp(b+8, a+8, 2)>0) { exit(4) }               // b > a -> positive

  // --- memmove: forward, non-overlapping (dst>src, separate regions) ---
  let m = mmap(32)
  let i = 0
  while i<8 { mem_store8(m+8+i, 65+i); i=i+1 }   // fill 65..72 (ABCDEFGH)
  memmove(m+16, m+8, 4)                          // dst=m+16, src=m+8 (non-overlap)
  if !(mem_load8(m+16)==65 && mem_load8(m+19)==68) { exit(5) }

  // --- memmove: forward, overlap dst<src (forward copy is safe) ---
  let o = mmap(32)
  i = 0
  while i<8 { mem_store8(o+8+i, 65+i); i=i+1 }   // A B C D E F G H
  memmove(o+8+2, o+8+0, 4)                        // dst=o+10, src=o+8 (dst<src, overlap)
  if !(mem_load8(o+8+2)==65 && mem_load8(o+8+3)==66 && mem_load8(o+8+4)==65 && mem_load8(o+8+5)==66) { exit(6) }

  // --- memmove: BACKWARD overlap, dst>src (exercises std path) ---
  let p = mmap(32)
  i = 0
  while i<8 { mem_store8(p+8+i, 65+i); i=i+1 }   // A B C D E F G H
  memmove(p+8+4, p+8+0, 4)                        // dst=p+12, src=p+8 (dst>src, overlap)
  if !(mem_load8(p+8+4)==65 && mem_load8(p+8+5)==66 && mem_load8(p+8+6)==67 && mem_load8(p+8+7)==68) { exit(7) }

  // --- realloc: grow (copy preserved) ---
  let r = mem_alloc(2)                         // 2 elements -> 2*8+8 = 24 bytes
  mem_store8(r+8, 200); mem_store8(r+9, 201)
  let r2 = realloc(r, 2, 8)  // grow: old_n=2, new_n=8
  if !(mem_load8(r2+8)==200 && mem_load8(r2+9)==201) { exit(8) }

  // --- realloc: shrink (only min copied) ---
  let s = mem_alloc(4)                         // 4 elements -> 4*8+8 = 40 bytes
  mem_store8(s+8, 1); mem_store8(s+9, 2); mem_store8(s+10, 3); mem_store8(s+11, 4)
  let s2 = realloc(s, 4, 2)  // shrink: old_n=4, new_n=2 -> copies 2 elements
  if !(mem_load8(s2+8)==1 && mem_load8(s2+9)==2) { exit(9) }

  exit(0)   // all passed
}
