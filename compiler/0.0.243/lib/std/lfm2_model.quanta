// LFM2 model descriptor table.
//
// Maps (layer, role) -> GGUF tensor index for all 266 descriptors of
// QUANTA-LFM2-2.6Bv1. This is a LOOKUP table over descriptors only: no tensor
// data is read and no weights are materialized. The tensor bytes stay on disk in
// their original quantized form and are matvec'd in place (see
// docs/plans/lfm2-native-inference-spec.md -- full f64 dequantization would be
// 20.1 GB, well past the MemoryMax=6G the binary runs under).
//
// Two things this deliberately does NOT do:
//
//   - It does not construct tensor names at runtime. A string PARAMETER in Quanta
//     is an opaque pointer with no length prefix, so a dynamically built
//     "blk.12.ffn_gate.weight" cannot be passed to gguf_find_tensor(). Instead
//     every descriptor is classified ONCE here by matching the literal role
//     suffixes against the raw name bytes. Lookup after that is pure arithmetic.
//
//   - It does not return a default for a missing tensor. Every accessor returns
//     the index or -1, and lfm2_require() turns -1 into a hard failure. A lookup
//     that silently returned 0 would hand the caller token_embd.weight and
//     produce a plausible, entirely wrong model.
//
// Verified against scripts/audit/read_formats_oracle.py: 266 descriptors,
// 8 attention layers [2,5,9,13,17,21,24,27], 22 conv-only layers, every
// (layer, role) pair resolved or explicitly absent.

import std/gguf

// Role ids. 13 roles, so a slot is layer*16 + role and stays under 8 bits.
const R_FFN_GATE    = 0
const R_FFN_UP      = 1
const R_FFN_DOWN    = 2
const R_FFN_NORM    = 3
const R_ATTN_NORM   = 4
const R_ATTN_Q      = 5
const R_ATTN_K      = 6
const R_ATTN_V      = 7
const R_ATTN_QNORM  = 8
const R_ATTN_KNORM  = 9
const R_ATTN_OUT    = 10
const R_CONV_CONV   = 11
const R_CONV_INPROJ = 12
const R_CONV_OUTPRJ = 13

const R_SLOTS = 14

// Global table: LFM2_SLOTS entries of tensor index, or -1.
let LFM2_SLOTS = 0
let LFM2_NLAYERS = 0

// True if the NUL-terminated name at `p` ENDS WITH the body of `suffix`.
//
// Matching the TAIL is enough and avoids needing the layer number in the
// pattern: "ffn_gate.weight" distinguishes the role on its own, and no LFM2
// role name is a suffix of another. The "blk.N." prefix is deliberately NOT
// part of the pattern -- matching a literal "N" would never match the real
// "blk.0.", "blk.12." etc.
//
// A string PARAMETER is a length-prefixed str object, so its length comes from
// len() and its body starts at suffix+8. (Verified: len(s) == 8 and s+8 == 'a'
// for "abcdefgh".)
fn name_ends_with(p, suffix) {
    let n = len(suffix)
    let ln = 0
    while mem_load8(p + ln) != 0 { ln = ln + 1 }
    if n > ln { return 0 }
    let at = p + ln - n
    let i = 0
    while i < n {
        if mem_load8(at + i) != mem_load8(suffix + 8 + i) { return 0 }
        i = i + 1
    }
    return 1
}

// Extract the layer number from "blk.<L>.<role>". Returns -1 if the name is not
// a block tensor. Reads digits directly; no string parsing needed.
fn layer_of(p) {
    if mem_load8(p + 0) != 98 { return -1 }          // 'b'
    if mem_load8(p + 1) != 108 { return -1 }         // 'l'
    if mem_load8(p + 2) != 107 { return -1 }         // 'k'
    if mem_load8(p + 3) != 46 { return -1 }          // '.'
    let c = mem_load8(p + 4)
    if c < 48 || c > 57 { return -1 }                // not a digit
    let L = 0
    let i = 4
    while mem_load8(p + i) >= 48 && mem_load8(p + i) <= 57 {
        L = L * 10 + (mem_load8(p + i) - 48)
        i = i + 1
    }
    if mem_load8(p + i) != 46 { return -1 }          // expect '.'
    return L
}

// Classify one descriptor name into a role id, or -1 if it matches no role.
//
// Patterns are role SUFFIXES only -- no "blk.N." prefix -- and the length is
// taken from len() rather than hardcoded, so a typo in a length cannot silently
// truncate a match. Order does not matter: no role suffix is a suffix of
// another (checked: ffn_gate / ffn_up / ffn_down / ffn_norm / attn_norm /
// attn_q / attn_k / attn_v / attn_q_norm / attn_k_norm / attn_output /
// shortconv.conv / shortconv.in_proj / shortconv.out_proj).
fn role_of(p) {
    if name_ends_with(p, "ffn_gate.weight")          { return R_FFN_GATE }
    if name_ends_with(p, "ffn_up.weight")            { return R_FFN_UP }
    if name_ends_with(p, "ffn_down.weight")          { return R_FFN_DOWN }
    if name_ends_with(p, "ffn_norm.weight")          { return R_FFN_NORM }
    if name_ends_with(p, "attn_norm.weight")         { return R_ATTN_NORM }
    if name_ends_with(p, "attn_q_norm.weight")       { return R_ATTN_QNORM }
    if name_ends_with(p, "attn_k_norm.weight")       { return R_ATTN_KNORM }
    if name_ends_with(p, "attn_q.weight")            { return R_ATTN_Q }
    if name_ends_with(p, "attn_k.weight")            { return R_ATTN_K }
    if name_ends_with(p, "attn_v.weight")            { return R_ATTN_V }
    if name_ends_with(p, "attn_output.weight")       { return R_ATTN_OUT }
    if name_ends_with(p, "shortconv.conv.weight")    { return R_CONV_CONV }
    if name_ends_with(p, "shortconv.in_proj.weight") { return R_CONV_INPROJ }
    if name_ends_with(p, "shortconv.out_proj.weight"){ return R_CONV_OUTPRJ }
    return -1
}

// Scan every descriptor and fill the role table. Returns the number of layers,
// or -1 if the model does not look like LFM2.
//
// Every slot is pre-filled with -1 first. A role that genuinely does not exist
// for a layer (attention layers have no conv; conv-only layers have no attn_q)
// must read back as -1, not as a leftover 0.
fn lfm2_build_table(nlayers) {
    if nlayers <= 0 || nlayers > 256 { return -1 }
    LFM2_SLOTS = mem_alloc(nlayers * R_SLOTS * 8)
    LFM2_NLAYERS = nlayers
    let total = nlayers * R_SLOTS
    let i = 0
    while i < total { mem_store(LFM2_SLOTS + i * 8, -1); i = i + 1 }

    let n = gguf_num_tensors()
    let t = 0
    let found = 0
    while t < n {
        let p = gguf_tensor_name(t)
        let L = layer_of(p)
        if L >= 0 && L < nlayers {
            let r = role_of(p)
            if r >= 0 {
                let slot = L * R_SLOTS + r
                // A duplicate here means the name scheme is not what we think it
                // is, and a silently-overwritten slot would make the model wrong
                // in a way that is very hard to see. Fail loudly.
                if mem_load(LFM2_SLOTS + slot * 8) != -1 { return -2 }
                mem_store(LFM2_SLOTS + slot * 8, t)
                found = found + 1
            }
        }
        t = t + 1
    }
    if found == 0 { return -1 }
    return nlayers
}

// Tensor index for (layer, role), or -1 if absent.
fn lfm2_slot(L, role) {
    if L < 0 || L >= LFM2_NLAYERS { return -1 }
    return mem_load(LFM2_SLOTS + (L * R_SLOTS + role) * 8)
}

// --- named accessors -------------------------------------------------------
// Each returns a tensor index or -1. Callers must check.

fn lfm2_ffn_gate(L)     { return lfm2_slot(L, R_FFN_GATE) }
fn lfm2_ffn_up(L)       { return lfm2_slot(L, R_FFN_UP) }
fn lfm2_ffn_down(L)     { return lfm2_slot(L, R_FFN_DOWN) }
fn lfm2_ffn_norm(L)     { return lfm2_slot(L, R_FFN_NORM) }
fn lfm2_attn_norm(L)    { return lfm2_slot(L, R_ATTN_NORM) }
fn lfm2_attn_q(L)       { return lfm2_slot(L, R_ATTN_Q) }
fn lfm2_attn_k(L)       { return lfm2_slot(L, R_ATTN_K) }
fn lfm2_attn_v(L)       { return lfm2_slot(L, R_ATTN_V) }
fn lfm2_attn_q_norm(L)  { return lfm2_slot(L, R_ATTN_QNORM) }
fn lfm2_attn_k_norm(L)  { return lfm2_slot(L, R_ATTN_KNORM) }
fn lfm2_attn_output(L)  { return lfm2_slot(L, R_ATTN_OUT) }
fn lfm2_conv_conv(L)    { return lfm2_slot(L, R_CONV_CONV) }
fn lfm2_conv_in_proj(L) { return lfm2_slot(L, R_CONV_INPROJ) }
fn lfm2_conv_out_proj(L){ return lfm2_slot(L, R_CONV_OUTPRJ) }

// True if this layer has attention (and therefore no short convolution).
fn lfm2_layer_is_attn(L) {
    if lfm2_attn_q(L) < 0 { return 0 }
    return 1
}

// The tied embedding / output projection. There is NO separate lm_head or
// output.weight in this model -- token_embd.weight [2048,128000] serves as both.
fn lfm2_token_embd()     { return gguf_find_tensor("token_embd.weight") }
fn lfm2_token_embd_norm(){ return gguf_find_tensor("token_embd_norm.weight") }