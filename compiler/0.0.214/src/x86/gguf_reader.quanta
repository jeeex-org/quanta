// GGUF Reader for Quanta — Parse GGUF model files natively
// Include in compiler: include "x86/gguf_reader.quanta"

// GGUF type constants
let GGUF_TYPE_F32 = 0
let GGUF_TYPE_F16 = 1
let GGUF_TYPE_Q4_0 = 2
let GGUF_TYPE_Q4_1 = 3
let GGUF_TYPE_Q5_0 = 6
let GGUF_TYPE_Q5_1 = 7
let GGUF_TYPE_Q8_0 = 8
let GGUF_TYPE_Q8_1 = 9
let GGUF_TYPE_Q2_K = 10
let GGUF_TYPE_Q3_K = 11
let GGUF_TYPE_Q4_K = 12
let GGUF_TYPE_Q5_K = 13
let GGUF_TYPE_Q6_K = 14
let GGUF_TYPE_Q8_K = 15
let GGUF_TYPE_IQ4_NL = 20
let GGUF_TYPE_IQ4_XS = 21

// GGGUF value type constants
let GGUF_VAL_U8 = 0
let GGUF_VAL_I8 = 1
let GGUF_VAL_U16 = 2
let GGUF_VAL_I16 = 3
let GGUF_VAL_U32 = 4
let GGUF_VAL_I32 = 5
let GGUF_VAL_U64 = 6
let GGUF_VAL_I64 = 7
let GGUF_VAL_F32 = 8
let GGUF_VAL_F64 = 9
let GGUF_VAL_BOOL = 10
let GGUF_VAL_STRING = 11
let GGUF_VAL_ARRAY = 12

// GGUF header
let GGUF_MAGIC = 0x46554747  // "GGUF" little-endian
let GGUF_VERSION = 3

// Reader state
let gguf_fd = -1
let gguf_size = 0
let gguf_data = 0  // mmap pointer
let gguf_pos = 0   // current read position
let gguf_n_tensors = 0
let gguf_tensor_infos = 0  // mmap'd array of tensor info
let gguf_tensor_data_offset = 0

// Open and mmap a GGUF file
fn gguf_open(path) {
    gguf_fd = file_open(path, 0)  // O_RDONLY
    if gguf_fd < 0 { return -1 }
    
    // Get file size — seek to end
    // Use lseek equivalent: we'll just mmap a large enough region
    // For now, assume we know the size or use stat
    // Simpler: read the header first, then figure out tensor data offset
    
    // Read header: magic(4) + version(8) + n_kv(8) + n_tensors(8)
    let hdr = mmap(28)
    let n = file_read(gguf_fd, hdr, 28)
    if n < 28 { file_close(gguf_fd); gguf_fd = -1; return -2 }
    
    let magic = r32(hdr)
    if magic != GGUF_MAGIC { file_close(gguf_fd); gguf_fd = -1; return -3 }
    
    let version = r64(hdr + 4)
    let n_kv = r64(hdr + 12)
    let n_tensors = r64(hdr + 20)
    
    gguf_n_tensors = n_tensors
    
    // Skip metadata key-value pairs
    let i = 0
    while i < n_kv {
        // Read key (string)
        let key = gguf_read_string()
        if key == 0 { break }
        
        // Read value type
        let vtype_buf = mmap(4)
        file_read(gguf_fd, vtype_buf, 4)
        let vtype = r32(vtype_buf)
        
        // Skip value based on type
        if vtype == GGUF_VAL_STRING {
            gguf_read_string()
        } else if vtype == GGUF_VAL_U32 {
            let skip = mmap(4)
            file_read(gguf_fd, skip, 4)
        } else if vtype == GGUF_VAL_I32 {
            let skip = mmap(4)
            file_read(gguf_fd, skip, 4)
        } else if vtype == GGUF_VAL_U64 {
            let skip = mmap(8)
            file_read(gguf_fd, skip, 8)
        } else if vtype == GGUF_VAL_I64 {
            let skip = mmap(8)
            file_read(gguf_fd, skip, 8)
        } else if vtype == GGUF_VAL_F32 {
            let skip = mmap(4)
            file_read(gguf_fd, skip, 4)
        } else if vtype == GGUF_VAL_F64 {
            let skip = mmap(8)
            file_read(gguf_fd, skip, 8)
        } else if vtype == GGUF_VAL_BOOL {
            let skip = mmap(1)
            file_read(gguf_fd, skip, 1)
        } else if vtype == GGUF_VAL_ARRAY {
            let atype_buf = mmap(4)
            file_read(gguf_fd, atype_buf, 4)
            let atype = r32(atype_buf)
            let alen_buf = mmap(8)
            file_read(gguf_fd, alen_buf, 8)
            let alen = r64(alen_buf)
            // Skip array elements (simplified — assumes all same type)
            if atype == GGUF_VAL_STRING {
                let j = 0
                while j < alen { gguf_read_string(); j = j + 1 }
            } else if atype == GGUF_VAL_U32 || atype == GGUF_VAL_I32 || atype == GGUF_VAL_F32 {
                let skip = mmap(alen * 4)
                file_read(gguf_fd, skip, alen * 4)
            } else if atype == GGUF_VAL_U64 || atype == GGUF_VAL_I64 || atype == GGUF_VAL_F64 {
                let skip = mmap(alen * 8)
                file_read(gguf_fd, skip, alen * 8)
            }
        }
        i = i + 1
    }
    
    // Now read tensor infos
    gguf_tensor_infos = mmap(n_tensors * 64)  // simplified: 64 bytes per tensor info
    
    // Store current position for later data reading
    // Read all tensor metadata
    let ti = 0
    while ti < n_tensors {
        let name = gguf_read_string()
        let ndims_buf = mmap(4)
        file_read(gguf_fd, ndims_buf, 4)
        let ndims = r32(ndims_buf)
        
        let dims = mmap(ndims * 8)
        file_read(gguf_fd, dims, ndims * 8)
        
        let dtype_buf = mmap(4)
        file_read(gguf_fd, dtype_buf, 4)
        let dtype = r32(dtype_buf)
        
        let offset_buf = mmap(8)
        file_read(gguf_fd, offset_buf, 8)
        let offset = r64(offset_buf)
        
        // Store: name_ptr, ndims, dims, dtype, offset
        w64(gguf_tensor_infos + ti*64, name)
        w64(gguf_tensor_infos + ti*64 + 8, ndims)
        w64(gguf_tensor_infos + ti*64 + 16, dims)
        w64(gguf_tensor_infos + ti*64 + 24, dtype)
        w64(gguf_tensor_infos + ti*64 + 32, offset)
        
        ti = ti + 1
    }
    
    return 0
}

// Read a string from current file position
fn gguf_read_string() {
    let len_buf = mmap(8)
    let n = file_read(gguf_fd, len_buf, 8)
    if n < 8 { return 0 }
    let len = r64(len_buf)
    let buf = mmap(len + 1)
    file_read(gguf_fd, buf, len)
    w8(buf + len, 0)  // null terminate
    return buf
}

// Close GGUF file
fn gguf_close() {
    if gguf_fd >= 0 {
        file_close(gguf_fd)
        gguf_fd = -1
    }
}

// Get tensor info by index
fn gguf_tensor_name(idx) { return r64(gguf_tensor_infos + idx*64) }
fn gguf_tensor_ndims(idx) { return r64(gguf_tensor_infos + idx*64 + 8) }
fn gguf_tensor_dims(idx) { return r64(gguf_tensor_infos + idx*64 + 16) }
fn gguf_tensor_dtype(idx) { return r64(gguf_tensor_infos + idx*64 + 24) }
fn gguf_tensor_offset(idx) { return r64(gguf_tensor_infos + idx*64 + 32) }

// Print all tensor names (for debugging)
fn gguf_print_tensors() {
    let i = 0
    while i < gguf_n_tensors {
        let name = gguf_tensor_name(i)
        let ndims = gguf_tensor_ndims(i)
        let dims = gguf_tensor_dims(i)
        let dtype = gguf_tensor_dtype(i)
        let offset = gguf_tensor_offset(i)
        
        // Print name
        print(name)
        print(" [")
        
        // Print dims
        let d = 0
        while d < ndims {
            if d > 0 { print("x") }
            print(r64(dims + d*8))
            d = d + 1
        }
        print("] type=")
        print(dtype)
        print(" offset=")
        print(offset)
        print("\n")
        
        i = i + 1
    }
}
