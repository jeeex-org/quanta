// x25519_inv_debug2.quanta — debug fe_inv step by step

import std/x25519

fn main() {
  println("Test fe_inv step by step...")
  
  let a = mem_alloc(8*8)
  fe_zero(a)
  mem_store(a, 2)
  
  let base = mem_alloc(8*8)
  fe_copy(a, base)
  
  let result = mem_alloc(8*8)
  fe_one(result)
  
  let tmp = mem_alloc(8*8)
  
  println("Before loop")
  let bit = 0
  while bit < 3 {
    println("bit")
    println(bit)
    fe_sq(result, tmp)
    fe_copy(tmp, result)
    println("after sq")
    fe_mul(result, base, tmp)
    fe_copy(tmp, result)
    println("after mul")
    bit = bit + 1
  }
  
  println("Done")
  println(0)
  exit(0)
}