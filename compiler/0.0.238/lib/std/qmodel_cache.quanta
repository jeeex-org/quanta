// std/qmodel_cache.quanta -- Phase 7.1: device residency with LRU eviction.
//
// WHAT THIS IS FOR
// ----------------
// A model's tensors live in host memory (mmap'd from the file). Running the
// matvecs on the GPU means those tensors have to be resident on the device, and
// the device is smaller than the host. This module keeps a bounded set of
// tensors on the device and evicts the least-recently-used one when a new
// upload would exceed the budget.
//
// WHY THE BUDGET IS EXPLICIT RATHER THAN "ALL OF VRAM"
// ---------------------------------------------------
// The natural test of an eviction policy is a workload that EVICTS. This box's
// model is 1589 MiB and the card has ~7.4 GiB free, so an "upload everything"
// policy never evicts and would exercise none of this. The budget is therefore a
// caller-set number, and the test drives it well below the model size so the
// eviction path actually runs.
//
// WHAT IS AND IS NOT CACHED
// -------------------------
// Only device residency is cached. The host side keeps using the loader's mmap
// (lib/std/loader_traits.quanta), so a tensor is never copied into a second host
// buffer -- an evicted tensor is simply no longer on the device and is re-read
// from the mmap on the next fetch. That also means there is no "dirty" state to
// write back: the device copy is always derived from read-only host data, so an
// eviction is always a free() and never a D2H copy. The plan sketched a dirty
// bit for a write-back case that this design does not have; keeping the bit
// would have implied a write path that does not exist.
//
// Layout per tensor, a mem_alloc'd table (mem_alloc does NOT zero, so it is
// cleared explicitly):
//   +0  device_ptr    0 = not resident
//   +8  nbytes        size of the device allocation
//   +16 last_tick     monotonic access counter, for LRU
//   +24 in_use        1 while a fetch is outstanding (never evicted)

import std/cuda_daemon

const QMC_ENTRY      = 32
// Per-slot tensor cap. The entry table is a FLAT allocation indexed by
// (slot, tensor), so the stride must be this, not the tensor count: sizing the
// allocation as QMC_MAX * QMC_ENTRY (256 bytes) while indexing with a 4096
// stride wrote far past the end of it. Allocate for the cap, use the cap.
const QMC_TMAX       = 4096
const QMC_DEV_PTR    = 0
const QMC_NBYTES     = 8
const QMC_TICK       = 16
const QMC_IN_USE     = 24

// One cache per qmodel handle. Sized to the loader's handle maximum so a handle
// always maps to a slot without a search.
const QMC_MAX = 8

let qmc_table = 0          // QMC_MAX * QMC_ENTRY per slot
let qmc_budget = 0         // QMC_MAX * 8
let qmc_used = 0           // QMC_MAX * 8
let qmc_ntensors = 0       // QMC_MAX * 8
let qmc_tick = 0           // global monotonic access counter
let qmc_ready = 0

// Stats, per slot: hits, misses, evictions, uploads, bytes_moved.
const QMC_STATS = 8
let qmc_stat = 0           // QMC_MAX * QMC_STATS * 8

fn qmc_init() {
    if qmc_ready != 0 { return }
    qmc_table    = mem_alloc(QMC_MAX * QMC_TMAX * QMC_ENTRY)
    qmc_budget   = mem_alloc(QMC_MAX * 8)
    qmc_used     = mem_alloc(QMC_MAX * 8)
    qmc_ntensors = mem_alloc(QMC_MAX * 8)
    qmc_stat     = mem_alloc(QMC_MAX * QMC_STATS * 8)
    let i = 0
    while i < QMC_MAX {
        mem_store(qmc_budget + i * 8, 0)
        mem_store(qmc_used + i * 8, 0)
        mem_store(qmc_ntensors + i * 8, 0)
        let s = 0
        while s < QMC_STATS { mem_store(qmc_stat + (i * QMC_STATS + s) * 8, 0); s = s + 1 }
        i = i + 1
    }
    // The entry table is indexed by (slot, tensor), so it is cleared lazily in
    // qmc_attach once the tensor count is known.
    qmc_ready = 1
}

fn qmc_slot(h) -> i64 {
    if h < 1 || h > QMC_MAX { return -1 }
    return h - 1
}

fn qmc_entry(slot, i) -> i64 {
    return qmc_table + (slot * QMC_TMAX + i) * QMC_ENTRY
}

fn qmc_stat_get(slot, which) -> i64 {
    return mem_load(qmc_stat + (slot * QMC_STATS + which) * 8)
}
fn qmc_stat_add(slot, which, v) {
    mem_store(qmc_stat + (slot * QMC_STATS + which) * 8, qmc_stat_get(slot, which) + v)
}

const QMC_HITS     = 0
const QMC_MISSES   = 1
const QMC_EVICTED  = 2
const QMC_UPLOADS  = 3
const QMC_BYTES    = 4

// Attach a cache to a model handle. `ntensors` is the model's tensor count and
// `budget` is the device byte budget. Returns 0, or a negative code.
//
// The budget is per-handle, so two models open at once do not share one pool.
fn qmodel_cache_init(h, ntensors, budget) -> i64 {
    qmc_init()
    let slot = qmc_slot(h)
    if slot < 0 { return -1 }
    if ntensors <= 0 || ntensors > QMC_TMAX { return -2 }
    if budget <= 0 { return -3 }

    // A budget below the largest single tensor would make a fetch impossible:
    // evicting everything still would not fit it. Reject up front rather than
    // failing later with a confusing eviction loop.
    mem_store(qmc_budget + slot * 8, budget)
    mem_store(qmc_ntensors + slot * 8, ntensors)
    mem_store(qmc_used + slot * 8, 0)
    let i = 0
    while i < ntensors {
        let e = qmc_entry(slot, i)
        mem_store(e + QMC_DEV_PTR, 0)
        mem_store(e + QMC_NBYTES, 0)
        mem_store(e + QMC_TICK, 0)
        mem_store(e + QMC_IN_USE, 0)
        i = i + 1
    }
    return 0
}

fn qmodel_cache_budget(h) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return -1 }
    return mem_load(qmc_budget + slot * 8)
}

fn qmodel_cache_used(h) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return -1 }
    return mem_load(qmc_used + slot * 8)
}

fn qmodel_cache_count(h) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return -1 }
    return mem_load(qmc_ntensors + slot * 8)
}

// Device pointer for tensor i, or 0 when it is not resident.
fn qmodel_device_ptr(h, i) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return 0 }
    let n = mem_load(qmc_ntensors + slot * 8)
    if i < 0 || i >= n { return 0 }
    return mem_load(qmc_entry(slot, i) + QMC_DEV_PTR)
}

// Access tick, for tests that need to see the ordering rather than assume it.
fn qmodel_cache_tick(h, i) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return -1 }
    let n = mem_load(qmc_ntensors + slot * 8)
    if i < 0 || i >= n { return -1 }
    return mem_load(qmc_entry(slot, i) + QMC_TICK)
}

fn qmodel_is_resident(h, i) -> i64 {
    return qmodel_device_ptr(h, i) != 0
}

// Mark a tensor in use so an eviction pass skips it. Returns the device pointer
// (0 if not resident). Pair with qmodel_release.
fn qmodel_acquire(h, i) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return 0 }
    let n = mem_load(qmc_ntensors + slot * 8)
    if i < 0 || i >= n { return 0 }
    let e = qmc_entry(slot, i)
    let p = mem_load(e + QMC_DEV_PTR)
    if p != 0 {
        // Pin it: an eviction pass must not take this one, and qmodel_evict must
        // refuse it directly. Setting in_use is the whole point of acquire --
        // touching only the tick made acquire a no-op for eviction purposes.
        mem_store(e + QMC_IN_USE, 1)
        mem_store(e + QMC_TICK, qmc_tick)
        qmc_tick = qmc_tick + 1
    }
    return p
}

fn qmodel_release(h, i) {
    let slot = qmc_slot(h)
    if slot < 0 { return }
    let n = mem_load(qmc_ntensors + slot * 8)
    if i < 0 || i >= n { return }
    mem_store(qmc_entry(slot, i) + QMC_IN_USE, 0)
}

// Evict the least-recently-used resident tensor that is not in use. Returns the
// index evicted, or -1 when there is nothing evictable.
fn qmodel_evict_lru(h) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return -1 }
    let n = mem_load(qmc_ntensors + slot * 8)
    let best = -1
    let best_tick = 0
    let i = 0
    while i < n {
        let e = qmc_entry(slot, i)
        let p = mem_load(e + QMC_DEV_PTR)
        if p != 0 && mem_load(e + QMC_IN_USE) == 0 {
            let t = mem_load(e + QMC_TICK)
            if best < 0 || t < best_tick { best = i; best_tick = t }
        }
        i = i + 1
    }
    if best < 0 { return -1 }
    qmodel_evict(h, best)
    return best
}

// Evict one tensor: free its device memory. There is no write-back -- the device
// copy is always derived from read-only host data, so nothing can be lost.
fn qmodel_evict(h, i) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return -1 }
    let n = mem_load(qmc_ntensors + slot * 8)
    if i < 0 || i >= n { return -1 }
    let e = qmc_entry(slot, i)
    let p = mem_load(e + QMC_DEV_PTR)
    if p == 0 { return -1 }
    // Never free a tensor with an outstanding fetch. The room-making pass skips
    // in-use entries; this is the direct call, and it has to refuse too or the
    // guarantee depends on which path the caller took.
    if mem_load(e + QMC_IN_USE) != 0 { return -1 }
    gpu_free(p)
    mem_store(qmc_used + slot * 8, mem_load(qmc_used + slot * 8) - mem_load(e + QMC_NBYTES))
    mem_store(e + QMC_DEV_PTR, 0)
    mem_store(e + QMC_NBYTES, 0)
    mem_store(e + QMC_TICK, 0)
    qmc_stat_add(slot, QMC_EVICTED, 1)
    return 0
}

// Make room for `nbytes` by evicting LRU entries. Returns 0 when there is room,
// or -1 when even a fully-evicted cache cannot fit it.
fn qmc_make_room(slot, nbytes) -> i64 {
    let budget = mem_load(qmc_budget + slot * 8)
    if nbytes > budget { return -1 }
    let n = mem_load(qmc_ntensors + slot * 8)
    while mem_load(qmc_used + slot * 8) + nbytes > budget {
        // Pick the LRU evictable entry directly (qmodel_evict_lru takes a
        // handle; here we already have the slot).
        let best = -1
        let best_tick = 0
        let i = 0
        while i < n {
            let e = qmc_entry(slot, i)
            if mem_load(e + QMC_DEV_PTR) != 0 && mem_load(e + QMC_IN_USE) == 0 {
                let t = mem_load(e + QMC_TICK)
                if best < 0 || t < best_tick { best = i; best_tick = t }
            }
            i = i + 1
        }
        if best < 0 { return -1 }      // everything resident is in use
        let e = qmc_entry(slot, best)
        gpu_free(mem_load(e + QMC_DEV_PTR))
        mem_store(qmc_used + slot * 8, mem_load(qmc_used + slot * 8) - mem_load(e + QMC_NBYTES))
        mem_store(e + QMC_DEV_PTR, 0)
        mem_store(e + QMC_NBYTES, 0)
        mem_store(e + QMC_TICK, 0)
        qmc_stat_add(slot, QMC_EVICTED, 1)
    }
    return 0
}

// Upload tensor `i` to the device. `stage_path` is a host file the caller has
// already written the tensor's bytes into -- the daemon's h2d takes a file, so
// the caller owns the host side (it can be the loader's mmap window written
// straight out, with no extra copy).
//
// Returns the device pointer, or 0 on failure.
fn qmodel_upload(h, i, stage_path, nbytes) -> i64 {
    let slot = qmc_slot(h)
    if slot < 0 { return 0 }
    let n = mem_load(qmc_ntensors + slot * 8)
    if i < 0 || i >= n { return 0 }
    if nbytes <= 0 { return 0 }
    let e = qmc_entry(slot, i)

    // Already resident: this is a hit, just touch it.
    let p = mem_load(e + QMC_DEV_PTR)
    if p != 0 {
        mem_store(e + QMC_TICK, qmc_tick)
        qmc_tick = qmc_tick + 1
        qmc_stat_add(slot, QMC_HITS, 1)
        return p
    }

    qmc_stat_add(slot, QMC_MISSES, 1)
    if qmc_make_room(slot, nbytes) != 0 { return 0 }

    let dev = gpu_malloc(nbytes)
    if dev == 0 { return 0 }
    if memcpy_h2d_async(stage_path, dev, nbytes) != 0 {
        gpu_free(dev)
        return 0
    }
    mem_store(e + QMC_DEV_PTR, dev)
    mem_store(e + QMC_NBYTES, nbytes)
    mem_store(e + QMC_TICK, qmc_tick)
    qmc_tick = qmc_tick + 1
    mem_store(qmc_used + slot * 8, mem_load(qmc_used + slot * 8) + nbytes)
    qmc_stat_add(slot, QMC_UPLOADS, 1)
    qmc_stat_add(slot, QMC_BYTES, nbytes)
    return dev
}

// Fetch: return a device pointer for tensor i, uploading it if needed. This is
// the call the matvec path makes.
fn qmodel_fetch(h, i, stage_path, nbytes) -> i64 {
    return qmodel_upload(h, i, stage_path, nbytes)
}

// Free every resident tensor for this handle.
fn qmodel_cache_flush(h) {
    let slot = qmc_slot(h)
    if slot < 0 { return }
    let n = mem_load(qmc_ntensors + slot * 8)
    let i = 0
    while i < n {
        let e = qmc_entry(slot, i)
        if mem_load(e + QMC_DEV_PTR) != 0 { qmodel_evict(h, i) }
        i = i + 1
    }
}

// Stats accessors.
fn qmodel_cache_hits(h) -> i64     { return qmc_stat_get(qmc_slot(h), QMC_HITS) }
fn qmodel_cache_misses(h) -> i64   { return qmc_stat_get(qmc_slot(h), QMC_MISSES) }
fn qmodel_cache_evicted(h) -> i64  { return qmc_stat_get(qmc_slot(h), QMC_EVICTED) }
fn qmodel_cache_uploads(h) -> i64  { return qmc_stat_get(qmc_slot(h), QMC_UPLOADS) }
fn qmodel_cache_bytes(h) -> i64    { return qmc_stat_get(qmc_slot(h), QMC_BYTES) }
