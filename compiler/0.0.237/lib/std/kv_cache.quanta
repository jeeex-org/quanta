// KV Cache for LFM2.5 2.6B
// 8 KV heads, 256 dim each, stores K and V for all past positions
// Avoids recomputing attention for previous tokens

let kv_k_ptr = 0      // K cache: [pos][head][dim] -> f64
let kv_v_ptr = 0      // V cache: [pos][head][dim] -> f64
let kv_pos = 0        // Current position (number of tokens cached)
let kv_max_len = 2048
let kv_n_heads = 8
let kv_head_dim = 256

fn kv_init(max_len) {
    kv_max_len = max_len
    kv_k_ptr = mem_alloc(max_len * kv_n_heads * kv_head_dim * 8)
    kv_v_ptr = mem_alloc(max_len * kv_n_heads * kv_head_dim * 8)
    kv_pos = 0
}

fn kv_free() {
    // No free in this runtime, but zero out state
    kv_pos = 0
}

fn kv_clear() {
    kv_pos = 0
}

fn kv_append(k, v) {
    // k, v are [n_heads * head_dim] vectors
    // Append to cache at position kv_pos
    let p = kv_pos * kv_n_heads * kv_head_dim * 8
    let i = 0
    while i < kv_n_heads * kv_head_dim {
        mem_store(kv_k_ptr + p + i * 8, mem_load(k + i * 8))
        mem_store(kv_v_ptr + p + i * 8, mem_load(v + i * 8))
        i = i + 1
    }
    kv_pos = kv_pos + 1
}

fn kv_get_k(pos, head, idx) {
    // Get K value at position pos, head, dimension idx
    return mem_load(kv_k_ptr + (pos * kv_n_heads + head) * kv_head_dim * 8 + idx * 8)
}

fn kv_get_v(pos, head, idx) {
    return mem_load(kv_v_ptr + (pos * kv_n_heads + head) * kv_head_dim * 8 + idx * 8)
}

fn kv_attn_scores(q, scores, n_heads, head_dim, q_idx) {
    // Compute attention scores for query q_idx against all cached K
    // scores[0..kv_pos] = q @ K[0..kv_pos]
    let pos = 0
    while pos < kv_pos {
        let score = i2f(0)
        let d = 0
        while d < head_dim {
            let qv = mem_load(q + (q_idx * head_dim + d) * 8)
            let kv = kv_get_k(pos, q_idx / (n_heads / kv_n_heads), d)
            score = fadd(score, fmul(qv, kv))
            d = d + 1
        }
        mem_store(scores + pos * 8, score)
        pos = pos + 1
    }
}

fn kv_attn_apply(v_out, probs, n_heads, head_dim, q_idx) {
    // Apply attention probs to cached V values
    // v_out[q_idx] = sum(probs[pos] * V[pos])
    let d = 0
    while d < head_dim {
        let sum = i2f(0)
        let pos = 0
        while pos < kv_pos {
            let p = mem_load(probs + pos * 8)
            let vv = kv_get_v(pos, q_idx / (n_heads / kv_n_heads), d)
            sum = fadd(sum, fmul(p, vv))
            pos = pos + 1
        }
        mem_store(v_out + (q_idx * head_dim + d) * 8, sum)
        d = d + 1
    }
}
