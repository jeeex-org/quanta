// std/qmodel_dtype.quanta -- Phase 7.2: unified dtype model.
//
// GGUF identifies tensors by a numeric dtype ID; safetensors by a string name.
// Both describe the same underlying set of formats, but the loader has no
// shared vocabulary: qmodel_bits() derives a bit width from nbytes/nelements,
// which is correct for whole-byte formats but cannot distinguish Q4_K from
// Q4_0 (both are 4 bits/element) and says nothing about block structure.
//
// This module defines QmodelDtype, a single enum covering every format both
// loaders accept, and the two mapping tables. qmodel_dtype() is the one call
// the rest of the loader makes; it dispatches on the handle's format kind and
// returns the same enum value regardless of which file format the tensor came
// from.

import std/str

// ===========================================================================
// QmodelDtype enum
// ===========================================================================

// Float formats
const QMD_F32  = 0
const QMD_F16  = 1
const QMD_BF16 = 2
const QMD_F64  = 3

// Integer formats
const QMD_I8   = 10
const QMD_U8   = 11
const QMD_I16  = 12
const QMD_U16  = 13
const QMD_I32  = 14
const QMD_U32  = 15
const QMD_I64  = 16
const QMD_U64  = 17
const QMD_BOOL = 18

// Quantized formats (whole-byte blocks)
const QMD_Q4_0 = 30
const QMD_Q4_1 = 31
const QMD_Q5_0 = 32
const QMD_Q5_1 = 33
const QMD_Q8_0 = 34
const QMD_Q8_1 = 35

// K-quantized formats (mixed-precision blocks)
const QMD_Q2_K = 40
const QMD_Q3_K = 41
const QMD_Q4_K = 42
const QMD_Q5_K = 43
const QMD_Q6_K = 44
const QMD_Q8_K = 45

// IQ formats (importance-weighted quantization)
const QMD_IQ2_XXS = 50
const QMD_IQ2_XS  = 51
const QMD_IQ3_XXS = 52
const QMD_IQ1_S   = 53
const QMD_IQ4_NL  = 54
const QMD_IQ3_S   = 55
const QMD_IQ3_M   = 56
const QMD_IQ2_S   = 57
const QMD_IQ2_M   = 58
const QMD_IQ4_XS  = 59
const QMD_IQ1_M   = 60

// Sub-byte formats
const QMD_F4   = 70
const QMD_MXF6 = 71
const QMD_MXFP4 = 72
const QMD_NVFP4 = 73

// Ternary formats
const QMD_TQ1_0 = 80
const QMD_TQ2_0 = 81

// Sentinel for "unknown / unsupported".
// `let`, not `const`: a const initializer must be a single non-negative literal
// in the current compiler; `const QMD_UNKNOWN = -1` parses but the name is never
// registered, so every use dies with "undeclared variable" (verified by bisection:
// const X = 5 compiles, const X = -1 and const X = 0 - 1 both fail).
let QMD_UNKNOWN = 0 - 1

// ===========================================================================
// GGUF dtype ID -> QmodelDtype
// ===========================================================================

fn gguf_dtype_to_qmodel(dtype: i64) -> i64 {
    if dtype == 0 { return QMD_F32 }
    if dtype == 1 { return QMD_F16 }
    if dtype == 2 { return QMD_Q4_0 }
    if dtype == 3 { return QMD_Q4_1 }
    if dtype == 6 { return QMD_Q5_0 }
    if dtype == 7 { return QMD_Q5_1 }
    if dtype == 8 { return QMD_Q8_0 }
    if dtype == 9 { return QMD_Q8_1 }
    if dtype == 10 { return QMD_Q2_K }
    if dtype == 11 { return QMD_Q3_K }
    if dtype == 12 { return QMD_Q4_K }
    if dtype == 13 { return QMD_Q5_K }
    if dtype == 14 { return QMD_Q6_K }
    if dtype == 15 { return QMD_Q8_K }
    if dtype == 16 { return QMD_IQ2_XXS }
    if dtype == 17 { return QMD_IQ2_XS }
    if dtype == 18 { return QMD_IQ3_XXS }
    if dtype == 19 { return QMD_IQ1_S }
    if dtype == 20 { return QMD_IQ4_NL }
    if dtype == 21 { return QMD_IQ3_S }
    if dtype == 22 { return QMD_IQ3_M }
    if dtype == 23 { return QMD_IQ2_S }
    if dtype == 24 { return QMD_IQ2_M }
    if dtype == 25 { return QMD_IQ4_XS }
    if dtype == 26 { return QMD_IQ1_M }
    if dtype == 27 { return QMD_BF16 }
    if dtype == 31 { return QMD_TQ1_0 }
    if dtype == 32 { return QMD_TQ2_0 }
    if dtype == 36 { return QMD_MXFP4 }
    if dtype == 37 { return QMD_NVFP4 }
    return QMD_UNKNOWN
}

// ===========================================================================
// safetensors dtype string -> QmodelDtype
// ===========================================================================

fn st_dtype_to_qmodel(name: u64) -> i64 {
    if equals(name, "F32") { return QMD_F32 }
    if equals(name, "F16") { return QMD_F16 }
    if equals(name, "BF16") { return QMD_BF16 }
    if equals(name, "F64") { return QMD_F64 }
    if equals(name, "I8") { return QMD_I8 }
    if equals(name, "U8") { return QMD_U8 }
    if equals(name, "I16") { return QMD_I16 }
    if equals(name, "U16") { return QMD_U16 }
    if equals(name, "I32") { return QMD_I32 }
    if equals(name, "U32") { return QMD_U32 }
    if equals(name, "I64") { return QMD_I64 }
    if equals(name, "U64") { return QMD_U64 }
    if equals(name, "BOOL") { return QMD_BOOL }
    if equals(name, "F8_E4M3") { return QMD_F32 }
    if equals(name, "F8_E5M2") { return QMD_F32 }
    if equals(name, "F4") { return QMD_F4 }
    if equals(name, "MXF6") { return QMD_MXF6 }
    if equals(name, "Q4_K") { return QMD_Q4_K }
    if equals(name, "Q5_K") { return QMD_Q5_K }
    if equals(name, "Q6_K") { return QMD_Q6_K }
    if equals(name, "Q8_0") { return QMD_Q8_0 }
    if equals(name, "Q8_1") { return QMD_Q8_1 }
    if equals(name, "Q4_0") { return QMD_Q4_0 }
    if equals(name, "Q4_1") { return QMD_Q4_1 }
    if equals(name, "Q5_0") { return QMD_Q5_0 }
    if equals(name, "Q5_1") { return QMD_Q5_1 }
    return QMD_UNKNOWN
}

// ===========================================================================
// QmodelDtype -> bits per element
// Returns -1 for sub-byte or block-quantized formats where bits/element
// is not a meaningful single number.
// ===========================================================================

fn qmodel_bits_of(dt: i64) -> i64 {
    if dt == QMD_F32 { return 32 }
    if dt == QMD_F16 { return 16 }
    if dt == QMD_BF16 { return 16 }
    if dt == QMD_F64 { return 64 }
    if dt == QMD_I8 { return 8 }
    if dt == QMD_U8 { return 8 }
    if dt == QMD_I16 { return 16 }
    if dt == QMD_U16 { return 16 }
    if dt == QMD_I32 { return 32 }
    if dt == QMD_U32 { return 32 }
    if dt == QMD_I64 { return 64 }
    if dt == QMD_U64 { return 64 }
    if dt == QMD_BOOL { return 1 }
    if dt == QMD_Q4_0 { return 4 }
    if dt == QMD_Q4_1 { return 4 }
    if dt == QMD_Q5_0 { return 5 }
    if dt == QMD_Q5_1 { return 5 }
    if dt == QMD_Q8_0 { return 8 }
    if dt == QMD_Q8_1 { return 8 }
    if dt == QMD_Q2_K { return 2 }
    if dt == QMD_Q3_K { return 3 }
    if dt == QMD_Q4_K { return 4 }
    if dt == QMD_Q5_K { return 5 }
    if dt == QMD_Q6_K { return 6 }
    if dt == QMD_Q8_K { return 8 }
    if dt == QMD_IQ2_XXS { return 2 }
    if dt == QMD_IQ2_XS { return 2 }
    if dt == QMD_IQ3_XXS { return 3 }
    if dt == QMD_IQ1_S { return 1 }
    if dt == QMD_IQ4_NL { return 4 }
    if dt == QMD_IQ3_S { return 3 }
    if dt == QMD_IQ3_M { return 3 }
    if dt == QMD_IQ2_S { return 2 }
    if dt == QMD_IQ2_M { return 2 }
    if dt == QMD_IQ4_XS { return 4 }
    if dt == QMD_IQ1_M { return 1 }
    if dt == QMD_F4 { return 4 }
    if dt == QMD_MXF6 { return 6 }
    if dt == QMD_MXFP4 { return 4 }
    if dt == QMD_NVFP4 { return 4 }
    if dt == QMD_TQ1_0 { return 1 }
    if dt == QMD_TQ2_0 { return 2 }
    return -1
}

// ===========================================================================
// QmodelDtype -> human-readable name (for error messages and debug output)
// Returns a pointer to a string literal (Quanta string = [u64 len][chars][NUL]).
// ===========================================================================

fn qmodel_dtype_name(dt: i64) -> str {
    if dt == QMD_F32 { return "F32" }
    if dt == QMD_F16 { return "F16" }
    if dt == QMD_BF16 { return "BF16" }
    if dt == QMD_F64 { return "F64" }
    if dt == QMD_I8 { return "I8" }
    if dt == QMD_U8 { return "U8" }
    if dt == QMD_I16 { return "I16" }
    if dt == QMD_U16 { return "U16" }
    if dt == QMD_I32 { return "I32" }
    if dt == QMD_U32 { return "U32" }
    if dt == QMD_I64 { return "I64" }
    if dt == QMD_U64 { return "U64" }
    if dt == QMD_BOOL { return "BOOL" }
    if dt == QMD_Q4_0 { return "Q4_0" }
    if dt == QMD_Q4_1 { return "Q4_1" }
    if dt == QMD_Q5_0 { return "Q5_0" }
    if dt == QMD_Q5_1 { return "Q5_1" }
    if dt == QMD_Q8_0 { return "Q8_0" }
    if dt == QMD_Q8_1 { return "Q8_1" }
    if dt == QMD_Q2_K { return "Q2_K" }
    if dt == QMD_Q3_K { return "Q3_K" }
    if dt == QMD_Q4_K { return "Q4_K" }
    if dt == QMD_Q5_K { return "Q5_K" }
    if dt == QMD_Q6_K { return "Q6_K" }
    if dt == QMD_Q8_K { return "Q8_K" }
    if dt == QMD_IQ2_XXS { return "IQ2_XXS" }
    if dt == QMD_IQ2_XS { return "IQ2_XS" }
    if dt == QMD_IQ3_XXS { return "IQ3_XXS" }
    if dt == QMD_IQ1_S { return "IQ1_S" }
    if dt == QMD_IQ4_NL { return "IQ4_NL" }
    if dt == QMD_IQ3_S { return "IQ3_S" }
    if dt == QMD_IQ3_M { return "IQ3_M" }
    if dt == QMD_IQ2_S { return "IQ2_S" }
    if dt == QMD_IQ2_M { return "IQ2_M" }
    if dt == QMD_IQ4_XS { return "IQ4_XS" }
    if dt == QMD_IQ1_M { return "IQ1_M" }
    if dt == QMD_F4 { return "F4" }
    if dt == QMD_MXF6 { return "MXF6" }
    if dt == QMD_MXFP4 { return "MXFP4" }
    if dt == QMD_NVFP4 { return "NVFP4" }
    if dt == QMD_TQ1_0 { return "TQ1_0" }
    if dt == QMD_TQ2_0 { return "TQ2_0" }
    return "UNKNOWN"
}
