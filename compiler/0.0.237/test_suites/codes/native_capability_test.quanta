// NATIVE capability proof: everything the extern "C" test does, done natively.
//
// dyn_extern_test.quanta needs --emit-dynamic because it calls libc's strlen and
// abs. This file must NOT need it. Quanta is a native language: if a program can
// only be written by reaching for extern "C", the language is missing something
// and extern is a workaround rather than a feature.
//
// If this test ever starts needing --emit-dynamic, native coverage has regressed.
//
// Build:  qc native_capability_test.quanta out     (no flags, no extern)
// Run:    out ; echo $?   -- expect 42
//
// Note the `string` annotations. A Quanta string is [8:len][bytes] and a literal
// with no contextual type resolves to the LENGTH, not the characters, so
// `let s = "abcde"` followed by `s[i]` reads the length field. Annotate, or let
// the type come from the callee signature, as every function below does.

// strlen, natively: len() on a string parameter.
fn my_strlen(s: string) -> i64 {
    return len(s)
}

// abs, natively. Branch instead of libc.
fn my_abs(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

// Byte access, natively: a string is [8:len][bytes], so the characters start at
// s+8 and are NUL-terminated, exactly as a C string would be.
fn byte_at(s: string, i: i64) -> i32 {
    return mem_load8(s + 8 + i)
}

// Write to a fd with no libc in the binary: the raw write(2) syscall.
fn write_all(fd: i32, buf: *u8, n: i64) -> i64 {
    return syscall(1, fd, buf, n)
}

fn print_str(s: string) -> i64 {
    return write_all(1, s + 8, len(s))
}

fn main() -> i32 {
    // String length, natively. libc strlen gives 5 here too.
    let n = my_strlen("abcde")
    if n != 5 { return 90 + n }

    // Byte indexing, natively.
    if byte_at("abcde", 0) != 97 { return 91 }
    if byte_at("abcde", 4) != 101 { return 92 }
    // NUL terminated, so a C consumer of the same bytes sees a C string.
    if byte_at("abcde", 5) != 0 { return 93 }

    // abs, natively.
    let a = my_abs(0 - 9)
    if a != 9 { return 80 + a }

    // Write to stdout with no libc in the binary at all.
    print_str("native quanta\n");

    // Raw memory, natively.
    let p = mmap(64)
    mem_store(p, 0x1234)
    if mem_load(p) != 0x1234 { return 70 }

    // The native allocator, natively. No libc malloc.
    let q = mem_alloc(8)
    if q == 0 { return 71 }
    mem_store8(q, 65)
    if mem_load8(q) != 65 { return 72 }
    mem_free(q)

    return 42
}
