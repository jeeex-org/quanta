import std/sha3_theta
import std/sha3_constants

fn main() {
  // Test keccak_theta with a known state
  let st = malloc(200)
  let i = 0
  while (i < 25) {
    mem_store(st + i * 8, 0)
    i = i + 1
  }
  // Set some known values
  mem_store(st + 0*8, 1)
  mem_store(st + 1*8, 2)
  mem_store(st + 2*8, 3)
  keccak_theta(st)
  // Just verify it runs without crashing
  exit(0)
}

extern fn malloc(size: u64) -> u64;