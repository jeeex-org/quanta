// Parallel matvec must match the serial result ELEMENT FOR ELEMENT.
//
// No tolerance: a weight that moves by one ULP is a different model. This was
// the test that caught the lseek/read race -- mismatches grew with worker count
// (2 -> 83 rows, 4 -> 499, 16 -> 926) because workers on the shared fd read each
// other's offsets.
//
// Uses a small tensor so it runs in the gate: the full 10752-row FFN gate is
// exercised by the ad-hoc benchmark, not here.
import std/gguf
import std/lfm2_mm

fn main() -> i64 {
    const P = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"
    if gguf_load(P) < 0 { return 1 }
    if mm_init(2048) != 0 { return 1 }

    let rows = 10752          // the tensor has exactly this many rows
    let cols = 2048
    let idx = gguf_find_tensor("blk.0.ffn_gate.weight")
    if idx < 0 { return 1 }

    let x = mem_alloc(cols * 8)
    let i = 0
    while i < cols {
        mem_store(x + i * 8, 0.01 + i2f(i) * 0.0001)
        i = i + 1
    }

    // serial reference
    let refbuf = mem_alloc(rows * 8)
    if mm_matvec_blk(idx, x, rows, cols, refbuf) != 0 { return 1 }

    let y = mem_alloc(rows * 8)
    let bad = 0

    // 1 worker must fall back to the serial path and agree trivially;
    // the others exercise real concurrency.
    let counts = [1, 2, 4, 8,]
    let ci = 0
    while ci < len(counts) {
        let nw = counts[ci]

        // zero first so a row nobody wrote is detectable
        let r = 0
        while r < rows { mem_store(y + r * 8, 0.0); r = r + 1 }

        mm_matvec_par(idx, x, rows, cols, y, nw)

        let diffs = 0
        r = 0
        while r < rows {
            if mem_load(y + r * 8) != mem_load(refbuf + r * 8) { diffs = diffs + 1 }
            r = r + 1
        }
        if diffs != 0 { bad = bad + 1 }
        ci = ci + 1
    }

    gguf_close()
    return bad            // 0 = pass at every worker count
}