// x25519_loop_test2.quanta — test the ladder loop

import std/x25519

fn main() {
  println("Test ladder loop...")
  
  let x1 = mem_alloc(8*8)
  let x2 = mem_alloc(8*8)
  let z2 = mem_alloc(8*8)
  let x3 = mem_alloc(8*8)
  let z3 = mem_alloc(8*8)
  
  // Initialize with u=9
  let u = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u + i, 0); i = i + 1 }
  mem_store8(u, 9)
  
  fe_from_bytes(u, x1)
  fe_one(x2)
  fe_zero(z2)
  fe_from_bytes(u, x3)
  fe_one(z3)
  
  println("init done")
  
  let bit = 3
  while bit >= 0 {
    println("bit=")
    println(bit)
    bit = bit - 1
  }
  
  println("loop done")
  println(0)
  exit(0)
}