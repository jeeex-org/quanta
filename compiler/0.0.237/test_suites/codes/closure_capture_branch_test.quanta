// 0.0.234 A1 regression: a capturing closure plus a branch in the same function
// used to crash qc with SIGSEGV (rc=139). codegen's IR_CAPREAD handler read `fi`
// expecting the current function index, but a `let fi=a0` in another branch of
// the same function shadowed it, so `cap_bodyvreg + (fi*CAP_MAX + a0)*8` computed
// a wild address and the compiler died on the store. Expected exit code: 23.
fn twiddle(y) {
    let f = |x| { x + y }
    let i = 0
    while i < 3 { i = i + f(1) }
    return i
}

fn main() {
    let y = 7
    let z = 9
    let g = |x| { x + y + z }
    let j = 0
    while j < 2 { j = j + g(1) }
    let k = 0
    if j > 0 { k = k + twiddle(5) }
    exit(j + k)
    return 0
}
