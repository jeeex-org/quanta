// trait_test: trait + struct + impl + method call returning a computed value.
// Real assertion: draw_shape(c) returns Circle.draw() == radius*2 == 10.
// (Was a no-op: draw_shape(c) result discarded, returned 0.)
trait Drawable {
    fn draw(self) -> int
}

struct Circle {
    radius: int
}

impl Drawable for Circle {
    fn draw(self) -> int {
        self.radius * 2
    }
}

fn draw_shape(d: Drawable) {
    return d.draw()
}

fn main() {
    let c = Circle { radius: 5 }
    return draw_shape(c)   // 10
}
