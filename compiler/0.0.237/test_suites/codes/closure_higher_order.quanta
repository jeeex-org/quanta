// P11 closure: passed as an fn-typed argument to a function (higher-order).
// The param must carry an fn type annotation so the callee routes the call
// through the closure ABI (IR_CLOSURE_CALL) instead of a direct symbol call.
fn apply(f: fn(i64) i64, x) { return f(x) }
fn main() {
    let doubler = |x| { x * 2 }
    return apply(doubler, 21)
}
