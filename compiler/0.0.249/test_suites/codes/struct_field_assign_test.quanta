// Field assignment (IR_ISTORE) + many-field struct with annotations
struct Vec3 {
    x: int
    y: int
    z: int
}
struct Player {
    name: int
    hp: int
    mp: int
    x: int
    y: int
    level: int
}
fn heal(p: Player) {
    p.hp = p.hp + 50
    return p.hp
}
fn main() {
    let v = Vec3 { x: 1, y: 2, z: 3 }
    let w = Vec3 { x: 10, y: 20, z: 30 }
    v.x = v.x + w.z   // 1 + 30 = 31
    v.y = v.z * 2     // 3*2 = 6
    let pl = Player { name: 7, hp: 30, mp: 10, x: 0, y: 0, level: 5 }
    let h = pl.heal() // 30+50 = 80
    return v.x + v.y + v.z + h + pl.level  // 31+6+3+80+5 = 125
}
