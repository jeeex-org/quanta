fn print_hex(v) {
  let i = 0
  while i < 8 {
    let bb = (v >> (i*8)) & 255
    let hi = bb >> 4
    let lo = bb & 15
    let c1 = 0
    if hi < 10 { c1 = hi + 48 } else { c1 = hi + 87 }
    let c2 = 0
    if lo < 10 { c2 = lo + 48 } else { c2 = lo + 87 }
    let buf = mem_alloc(2)
    w8(buf, c1); w8(buf+1, c2)
    print(buf, 2)
    mem_free(buf)
    i = i + 1
  }
}
fn main() {
  // x stored in memory, read back -> NOT a compile-time const, forces runtime ~
  let px = mem_alloc(8)
  w64(px, 0x0F0F0F0F0F0F0F0F)
  let x = r64(px)
  let nx = ~x
  print_hex(nx)
  print_str("\n")
  mem_free(px)
}
