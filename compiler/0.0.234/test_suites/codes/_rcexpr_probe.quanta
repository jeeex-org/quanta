import std/secure
fn get_rc_expr(r) {
  return keccak_rc(r + 1)
}
fn main() {
  let r = 2
  let a = get_rc_expr(r)
  let want = 0x8000000080008000  // RC[3]
  let diff = a ^ want
  // also test direct
  let b = keccak_rc(3)
  let diff2 = b ^ want
  if diff == 0 && diff2 == 0 { exit(0) } else { exit(1) }
}
