import std/gguf

// AWQ (Activation-aware Weight Quantization) dequant test.
//
// 3-buffer format (qweight, qzeros, scales), NOT GGUF.
// Reference: AutoAWQ awq/utils/packing_utils.py
//   AWQ_REVERSE_ORDER = [0, 4, 1, 5, 2, 6, 3, 7]
//   dequantize_gemm: unpack -> reverse_order -> mask -> (iw - iz) * scales

fn main() -> i64 {
    let failures = 0

    // ---- Test 1: 1 group, unit scale, zero zeros ----
    // in=8, out=8, group_size=8 (1 group)
    // qweight[0] = 0x76543210, all others = 0
    // qzeros[0] = 0
    // scales = all 1.0 (f16 0x3C00)
    // Expected: [0, 4, 1, 5, 2, 6, 3, 7] after reverse order
    {
        let raw_w = mem_alloc(32)
        let raw_z = mem_alloc(4)
        let raw_s = mem_alloc(16)
        let out = mem_alloc(64)

        let w = [0x76543210, 0, 0, 0, 0, 0, 0, 0]
        let i = 0
        while i < 8 {
            mem_store(raw_w + i*4, w[i])
            i = i + 1
        }
        mem_store(raw_z, 0)
        let j = 0
        while j < 8 {
            mem_store8(raw_s + j*2, 0x00)
            mem_store8(raw_s + j*2 + 1, 0x3C)
            j = j + 1
        }

        dequant_awq(raw_w, raw_z, raw_s, 8, 8, 8, out)

        // After reverse [0,4,1,5,2,6,3,7]: [0, 4, 1, 5, 2, 6, 3, 7]
        let expected = [0, 4, 1, 5, 2, 6, 3, 7]
        let ok = 1
        let k = 0
        while k < 8 {
            let v = f64of(mem_load(out + k*8))
            if v != i2f(expected[k]) {
                print("AWQ T1 FAIL at ", k, ": got ", f64bits(v), " expected ", f64bits(i2f(expected[k])), "\n")
                ok = 0
            }
            k = k + 1
        }
        if ok == 0 { failures = failures + 1 }
        else { print("AWQ T1 (1 group, unit scale): PASS\n") }
    }

    // ---- Test 2: 2 groups, non-zero zeros, non-unit scales ----
    // in=16, out=8, group_size=8 (2 groups)
    // qweight: all rows = 0x76543210
    // qzeros: group 0 = 0x11111111, group 1 = 0x22222222
    // scales: group 0 = 2.0 (f16 0x4000), group 1 = 0.5 (f16 0x3800)
    {
        let raw_w = mem_alloc(64)
        let raw_z = mem_alloc(8)
        let raw_s = mem_alloc(32)
        let out = mem_alloc(1024)  // 16*8 f64 = 128 elements

        let i = 0
        while i < 16 {
            mem_store(raw_w + i*4, 0x76543210)
            i = i + 1
        }
        mem_store(raw_z, 0x11111111)
        mem_store(raw_z + 4, 0x22222222)
        let j = 0
        while j < 8 {
            mem_store8(raw_s + j*2, 0x00)
            mem_store8(raw_s + j*2 + 1, 0x40)
            mem_store8(raw_s + (8+j)*2, 0x00)
            mem_store8(raw_s + (8+j)*2 + 1, 0x38)
            j = j + 1
        }

        dequant_awq(raw_w, raw_z, raw_s, 16, 8, 8, out)

        // Row 0 (group 0): scale=2.0, zeros=0x11111111
        //   nibbles of 0x76543210: [0,1,2,3,4,5,6,7]
        //   nibbles of 0x11111111: [1,1,1,1,1,1,1,1]
        //   diff: [-1,0,1,2,3,4,5,6]
        //   After reverse [0,4,1,5,2,6,3,7]: src[0]=-1, src[4]=3, src[1]=0, src[5]=4, src[2]=1, src[6]=5, src[3]=2, src[7]=6
        //   output = [-1,3,0,4,1,5,2,6] * 2.0 = [-2,6,0,8,2,10,4,12]
        let e00 = -2.0;  let e01 = 6.0;  let e02 = 0.0;  let e03 = 8.0
        let e04 = 2.0;   let e05 = 10.0; let e06 = 4.0;  let e07 = 12.0

        // Row 8 (group 1): scale=0.5, zeros=0x22222222
        //   nibbles of 0x22222222: [2,2,2,2,2,2,2,2]
        //   diff: [-2,-1,0,1,2,3,4,5]
        //   After reverse: src[0]=-2, src[4]=2, src[1]=-1, src[5]=3, src[2]=0, src[6]=4, src[3]=1, src[7]=5
        //   output = [-2,2,-1,3,0,4,1,5] * 0.5 = [-1,1,-0.5,1.5,0,2,0.5,2.5]
        let e10 = -1.0;  let e11 = 1.0;  let e12 = -0.5; let e13 = 1.5
        let e14 = 0.0;   let e15 = 2.0;  let e16 = 0.5;  let e17 = 2.5

        let ok = 1

        let v00 = f64of(mem_load(out + 0*8));   if v00 != e00 { print("AWQ T2 FAIL r0c0\n"); ok = 0 }
        let v01 = f64of(mem_load(out + 1*8));   if v01 != e01 { print("AWQ T2 FAIL r0c1\n"); ok = 0 }
        let v02 = f64of(mem_load(out + 2*8));   if v02 != e02 { print("AWQ T2 FAIL r0c2\n"); ok = 0 }
        let v03 = f64of(mem_load(out + 3*8));   if v03 != e03 { print("AWQ T2 FAIL r0c3\n"); ok = 0 }
        let v04 = f64of(mem_load(out + 4*8));   if v04 != e04 { print("AWQ T2 FAIL r0c4\n"); ok = 0 }
        let v05 = f64of(mem_load(out + 5*8));   if v05 != e05 { print("AWQ T2 FAIL r0c5\n"); ok = 0 }
        let v06 = f64of(mem_load(out + 6*8));   if v06 != e06 { print("AWQ T2 FAIL r0c6\n"); ok = 0 }
        let v07 = f64of(mem_load(out + 7*8));   if v07 != e07 { print("AWQ T2 FAIL r0c7\n"); ok = 0 }

        // Row 8 starts at element 8*out_features = 64, byte offset 512
        let v80 = f64of(mem_load(out + 512 + 0*8)); if v80 != e10 { print("AWQ T2 FAIL r8c0\n"); ok = 0 }
        let v81 = f64of(mem_load(out + 512 + 1*8)); if v81 != e11 { print("AWQ T2 FAIL r8c1\n"); ok = 0 }
        let v82 = f64of(mem_load(out + 512 + 2*8)); if v82 != e12 { print("AWQ T2 FAIL r8c2\n"); ok = 0 }
        let v83 = f64of(mem_load(out + 512 + 3*8)); if v83 != e13 { print("AWQ T2 FAIL r8c3\n"); ok = 0 }
        let v84 = f64of(mem_load(out + 512 + 4*8)); if v84 != e14 { print("AWQ T2 FAIL r8c4\n"); ok = 0 }
        let v85 = f64of(mem_load(out + 512 + 5*8)); if v85 != e15 { print("AWQ T2 FAIL r8c5\n"); ok = 0 }
        let v86 = f64of(mem_load(out + 512 + 6*8)); if v86 != e16 { print("AWQ T2 FAIL r8c6\n"); ok = 0 }
        let v87 = f64of(mem_load(out + 512 + 7*8)); if v87 != e17 { print("AWQ T2 FAIL r8c7\n"); ok = 0 }

        if ok == 0 { failures = failures + 1 }
        else { print("AWQ T2 (2 groups, non-zero zeros, non-unit scales): PASS\n") }
    }

    if failures > 0 {
        print("std_awq_test: ", failures, " FAILURES\n")
        return 1
    }
    print("std_awq_test: all pass\n")
    return 0
}
