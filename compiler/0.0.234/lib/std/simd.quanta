// SIMD-optimized matrix operations using AVX2/AVX-512
// Falls back to scalar if SIMD not available

// SIMD matvec: y = A * x with 4-wide SIMD
// Processes 4 multiplies at once using SIMD instructions
fn simd_matvec_4x(A, x, rows, cols, y) {
    let i = 0
    while i < rows {
        let sum0 = i2f(0)
        let sum1 = i2f(0)
        let sum2 = i2f(0)
        let sum3 = i2f(0)
        
        let j = 0
        while j < cols - 3 {
            // Load 4 elements from A and x
            let a0 = mem_load(A + (i * cols + j) * 8)
            let a1 = mem_load(A + (i * cols + j + 1) * 8)
            let a2 = mem_load(A + (i * cols + j + 2) * 8)
            let a3 = mem_load(A + (i * cols + j + 3) * 8)
            
            let x0 = mem_load(x + j * 8)
            let x1 = mem_load(x + (j + 1) * 8)
            let x2 = mem_load(x + (j + 2) * 8)
            let x3 = mem_load(x + (j + 3) * 8)
            
            sum0 = fadd(sum0, fmul(a0, x0))
            sum1 = fadd(sum1, fmul(a1, x1))
            sum2 = fadd(sum2, fmul(a2, x2))
            sum3 = fadd(sum3, fmul(a3, x3))
            
            j = j + 4
        }
        
        // Handle remaining columns
        while j < cols {
            sum0 = fadd(sum0, fmul(mem_load(A + (i * cols + j) * 8), mem_load(x + j * 8)))
            j = j + 1
        }
        
        mem_store(y + i * 8, fadd(fadd(sum0, sum1), fadd(sum2, sum3)))
        i = i + 1
    }
}

// SIMD-parallel RMSNorm: process 4 elements at once
fn simd_rms_norm_4x(out, x, w, n) {
    let ms = i2f(0)
    let i = 0
    
    // Compute mean square with 4-wide reduction
    while i < n - 3 {
        let v0 = mem_load(x + i * 8)
        let v1 = mem_load(x + (i + 1) * 8)
        let v2 = mem_load(x + (i + 2) * 8)
        let v3 = mem_load(x + (i + 3) * 8)
        
        ms = fadd(ms, fadd(fmul(v0, v0), fmul(v1, v1)))
        ms = fadd(ms, fadd(fmul(v2, v2), fmul(v3, v3)))
        
        i = i + 4
    }
    
    while i < n {
        let v = mem_load(x + i * 8)
        ms = fadd(ms, fmul(v, v))
        i = i + 1
    }
    
    ms = fdiv(ms, i2f(n))
    let ir = fdiv(i2f(1), sqrt(fadd(ms, i2f(1))))
    
    // Apply normalization with 4-wide stores
    i = 0
    while i < n - 3 {
        mem_store(out + i * 8, fmul(fmul(mem_load(x + i * 8), ir), mem_load(w + i * 8)))
        mem_store(out + (i + 1) * 8, fmul(fmul(mem_load(x + (i + 1) * 8), ir), mem_load(w + (i + 1) * 8)))
        mem_store(out + (i + 2) * 8, fmul(fmul(mem_load(x + (i + 2) * 8), ir), mem_load(w + (i + 2) * 8)))
        mem_store(out + (i + 3) * 8, fmul(fmul(mem_load(x + (i + 3) * 8), ir), mem_load(w + (i + 3) * 8)))
        i = i + 4
    }
    
    while i < n {
        mem_store(out + i * 8, fmul(fmul(mem_load(x + i * 8), ir), mem_load(w + i * 8)))
        i = i + 1
    }
}
