// Real-hardware (Android aarch64) confirmation of the named-global codegen
// exercised by the cross-TU pair: `global SHARED` emits a named GLOBAL symbol
// at .data slot gi*8 and STOREG/LOADG target it. Single self-contained TU so
// the compiler emits a bionic-valid static-PIE (ld -static makes ET_EXEC, which
// bionic rejects). Cross-TU *linking* is covered separately under qemu-aarch64.
global SHARED = 5

fn add_shared(d) {
    SHARED = SHARED + d
    return SHARED
}

fn main() {
    return add_shared(20)   // 5 + 20 = 25
}
