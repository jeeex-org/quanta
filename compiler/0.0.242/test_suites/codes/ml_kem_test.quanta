fn main() {
    // Test ML-KEM key generation
    let pk: u8[416]
    let sk: u8[1632]
    ml_kem_768_keygen(pk+8, sk+8)
    
    // Test encapsulation
    let ct: u8[512]
    let ss1: u8[32]
    ml_kem_768_encaps(pk+8, ct+8, ss1+8)
    
    // Test decapsulation
    let ss2: u8[32]
    ml_kem_768_decaps(sk+8, ct+8, ss2+8)
    
    // Verify shared secrets match
    let i: i64 = 0
    while i < 32 {
        if mem_load8(ss1+8+i) != mem_load8(ss2+8+i) {
            exit(1)
        }
        i = i + 1
    }
    
    exit(0)
}

import std/secure