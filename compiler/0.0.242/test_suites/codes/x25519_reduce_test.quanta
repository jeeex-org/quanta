// x25519_reduce_test.quanta — test fe_reduce in isolation

import std/x25519

fn print_hex(label, ptr, n) {
  let s = ""
  let i = 0
  while i < n {
    let b = mem_load8(ptr + i)
    let hi = b >> 4; let lo = b & 0xf
    if hi < 10 { s = str(s, hi + 48) } else { s = str(s, hi + 87) }
    if lo < 10 { s = str(s, lo + 48) } else { s = str(s, lo + 87) }
    i = i + 1
  }
  println(s)
}

fn main() {
  println("Debug fe_reduce...")
  
  let x = mem_alloc(5*8)
  fe_zero(x)
  mem_store(x, 123)
  println("x = 123:")
  print_hex("x", x, 40)
  
  fe_reduce(x)
  println("After reduce:")
  print_hex("x", x, 40)
  
  println(0)
  exit(0)
}