// Byte/endianness builtins: bswap, popcount, clz, ctz, rotl, rotr.
// Early-exit-on-failure (each check exits distinct nonzero on failure; exit 0 = all pass).
//
// NOTE: this test avoids 64-bit literals with the top bit set (0x80..) because the
// compiler has a pre-existing constant-emission bug for signed-high constants
// (see ROADMAP.md "64-bit constant bug"). All literals below keep the top bit clear.
fn main() {
  // bswap: swap bytes. Input low byte kept < 0x80 so the expected (top byte) is also clear.
  if !(bswap(0x0102030405060708) == 0x0807060504030201) { exit(1) }
  if !(bswap(0x1122334455667708) == 0x0877665544332211) { exit(2) }

  // popcount: count set bits.
  if !(popcount(0xB) == 3) { exit(3) }            // 0b1011 = 3
  if !(popcount(0x7FFFFFFFFFFFFFFF) == 63) { exit(4) }  // all but top bit = 63
  if !(popcount(0) == 0) { exit(5) }

  // clz: leading zeros.
  if !(clz(1) == 63) { exit(6) }                  // bit0 -> 63 leading zeros
  if !(clz(0) == 64) { exit(7) }                  // lzcnt(0)=64 on x86
  if !(clz(0x7FFFFFFFFFFFFFFF) == 1) { exit(8) }  // only top bit clear -> 1

  // ctz: trailing zeros.
  if !(ctz(8) == 3) { exit(9) }                   // bit3 -> 3
  if !(ctz(1) == 0) { exit(10) }                  // bit0 -> 0
  if !(ctz(0) == 64) { exit(11) }                 // tzcnt(0)=64 on x86

  // rol: rotate left.
  if !(rotl(0xFF, 8) == 0xFF00) { exit(12) }      // 0x00FF <<8 -> 0xFF00
  if !(rotl(1, 1) == 2) { exit(13) }              // 1<<1 = 2
  if !(rotl(0x123456789ABCDEF0, 64) == 0x123456789ABCDEF0) { exit(14) }  // full width = identity

  // ror: rotate right.
  if !(rotr(0xFF00, 8) == 0xFF) { exit(15) }      // 0xFF00 >>8 -> 0xFF
  if !(rotr(2, 1) == 1) { exit(16) }              // 2>>1 = 1
  if !(rotr(0x123456789ABCDEF0, 64) == 0x123456789ABCDEF0) { exit(17) }  // full width = identity

  exit(0)   // all passed
}
