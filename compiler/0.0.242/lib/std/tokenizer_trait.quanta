// ===========================================================================
// Tokenizer family trait -- Phase 10
//
// One seam over the tokenizer families, so callers never branch on which family
// a model happens to use.
//
// From llama.cpp src/llama-vocab.h and llama-vocab.cpp, read from source:
//
//   the five families that carry real vocabularies      llama-vocab.cpp:3270-3279
//     SPM     tokenizer_model == "llama"                 :2084
//     BPE     tokenizer_model == "gpt2" | "hybriddna" | "whitespace"   :2104
//     WPM     tokenizer_model == "bert"                   :2095
//     UGM     tokenizer_model == "t5"                     (the bigram variant)
//     RWKV    tokenizer_model == "rwkv"
//   plus N pre-tokenizer variants on top of BPE           llama-vocab.h:11-49
//
// WHAT THIS FILE IS, AND IS NOT
//
// It is the FAMILY LAYER: which family a model uses, read from the model's own
// GGUF metadata rather than guessed from its name or architecture, plus the
// shared vocabulary queries (size, token_to_id, id_to_token, token_to_byte)
// every family answers.
//
// It is NOT the merge/vocab-table construction. That is per family and lives with
// the family: lib/std/lfm2_bpe.quanta (BPE, 653 lines) is already implemented
// and verified byte-exact against llama.cpp's own test-tokenizer-0 on the real
// LFM2 model. The trait dispatches to it; it does not duplicate it.
//
// VERIFIED ON THE REAL MODEL, /opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf
//
//     tokenizer.ggml.model    = "gpt2"      (4 bytes)
//     tokenizer.ggml.pre      = "lfm2"      (4 bytes)
//     tokenizer.ggml.tokens   = 128000 entries
//     tokenizer.ggml.merges   = 293320 entries
//
// so this model's family is BPE with the lfm2 pre-tokenizer, and the existing
// bpe_init_from_gguf path is the correct one for it.
//
// WHY UNKNOWN MEANS BPE, NEVER A SILENT FALLBACK
//
// A model whose tokenizer.ggml.model is absent or unrecognised is reported as
// VTK_UNKNOWN and the caller is told. It is NOT quietly treated as BPE: a wrong
// family produces plausible-looking ids and a plausible-looking model, which is
// the same failure mode as degrading a model's size class on a missing figure.
// The difference from 11.1 is deliberate: there, unknown had to pick a working
// tier because something had to run; here the caller decides, because guessing a
// tokenizer silently corrupts every token id.
//
// STRING HANDLING
//
// A Quanta string returned from a function prints as a raw pointer, and passing
// one back IN as a parameter is unreliable (see lib/std/gguf.quanta:820-826).
// Every metadata string here is therefore handled as an explicit LENGTH plus a
// BUFFER, and every comparison is bytewise. No `len(kv_str(...))`.

import std/gguf
import std/str
import std/lfm2_bpe

// ---- families ---------------------------------------------------------------
let VTK_UNKNOWN = 0
let VTK_SPM = 1        // SentencePiece  (llama)
let VTK_BPE = 2        // byte-level BPE (gpt2 / hybriddna / whitespace)
let VTK_WPM = 3        // WordPiece      (bert)
let VTK_UGM = 4        // Unigram        (t5)
let VTK_RWKV = 5       // RWKV word-level

// ---- pre-tokenizer variants (llama-vocab.h:11-49) ---------------------------
// Only the ones Quanta can act on are named. The full upstream list runs to 49
// and most are a regex over one model's quirks; naming them here without
// implementing them would be a claim without an implementation.
let VPT_DEFAULT = 0
let VPT_GPT2 = 7        // llama.cpp: GPT2
let VPT_LLAMA3 = 1      // llama.cpp: LLAMA3
let VPT_LLAMA4 = 33     // llama.cpp: LLAMA4
let VPT_DEEPSEEK3 = 28
let VPT_FALCON = 4
let VPT_REFACT = 8
let VPT_COMMAND_R = 9
let VPT_STABLELM2 = 10
let VPT_QWEN2 = 11
let VPT_STARCODER = 6
let VPT_BLOOM = 23

// ---- loaded state -----------------------------------------------------------
let VT_FAMILY = VTK_UNKNOWN
let VT_PRE = VPT_DEFAULT
let VT_NTOKENS = 0
let VT_BOS = -1
let VT_EOS = -1
let VT_UNK = -1
let VT_SEP = -1
let VT_PAD = -1
let VT_MERGES = 0
let VT_READY = 0
// scratch for the last metadata read, reused to keep the allocator out of loops
let VT_BUF = 0

// The bytes of a scalar string KV, into VT_BUF. Returns the length, or -1.
fn vt_kv_bytes(name) -> i64 {
    let i = gguf_kv_find(name)
    if i < 0 { return -1 }
    return gguf_kv_str_bytes(i, VT_BUF)
}

// Is the buffered string `n` bytes equal to the literal `lit`?
fn vt_buf_eq(n, lit) -> i64 {
    if n != len(lit) { return 0 }
    let i = 0
    while i < n {
        if mem_load8(VT_BUF + i) != byte_at(lit, i) { return 0 }
        i = i + 1
    }
    return 1
}

// ---------------------------------------------------------------------------
// Read the family from the model's own metadata.
//
// llama.cpp decides on tokenizer_model (llama-vocab.cpp:2084-2104) and then the
// pre-tokenizer on tokenizer_pre. Quanta reads the same two keys.
//
// Returns VT_FAMILY, or VTK_UNKNOWN when the model does not say. A caller that
// gets VTK_UNKNOWN must not proceed as if it were any particular family.
// ---------------------------------------------------------------------------
fn vt_family_from_metadata() -> i64 {
    // tokenizer.ggml.model
    let n = vt_kv_bytes("tokenizer.ggml.model")
    if n < 0 { return VTK_UNKNOWN }
    let fam = VTK_UNKNOWN
    if vt_buf_eq(n, "llama") == 1 { fam = VTK_SPM }
    if vt_buf_eq(n, "gpt2") == 1 { fam = VTK_BPE }
    if vt_buf_eq(n, "hybriddna") == 1 { fam = VTK_BPE }
    if vt_buf_eq(n, "whitespace") == 1 { fam = VTK_BPE }
    if vt_buf_eq(n, "bert") == 1 { fam = VTK_WPM }
    if vt_buf_eq(n, "t5") == 1 { fam = VTK_UGM }
    if vt_buf_eq(n, "rwkv") == 1 { fam = VTK_RWKV }
    return fam
}

// The pre-tokenizer variant, or VPT_DEFAULT when the model does not say.
//
// llama-vocab.cpp:2286-2296 groups a set of model-authored names onto ONE
// upstream variant, and lfm2 is in it:
//
//   llama3, llama-v3, llama-bpe, falcon3, falcon-h1, pixtral, midm-2.0,
//   lfm2, jina-v5-nano  ->  LLAMA3
//     ignore_merges = true
//     add_bos       = true
//
// So the pre-tokenizer NAME is not the variant: ten names, one behaviour, and
// two behavioural flags that matter more than the name. This is exactly why the
// family is read from metadata rather than guessed: `lfm2` and `gpt2` are both
// BPE, and their pre-tokenizers are NOT the same.
fn vt_pre_from_metadata() -> i64 {
    let n = vt_kv_bytes("tokenizer.ggml.pre")
    if n < 0 { return VPT_DEFAULT }
    // the LLAMA3 group
    if vt_buf_eq(n, "llama3") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "llama-v3") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "llama-bpe") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "falcon3") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "falcon-h1") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "pixtral") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "midm-2.0") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "lfm2") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "jina-v5-nano") == 1 { return VPT_LLAMA3 }
    if vt_buf_eq(n, "llama4") == 1 { return VPT_LLAMA4 }
    if vt_buf_eq(n, "deepseek3") == 1 { return VPT_DEEPSEEK3 }
    if vt_buf_eq(n, "falcon") == 1 { return VPT_FALCON }
    if vt_buf_eq(n, "refact") == 1 { return VPT_REFACT }
    if vt_buf_eq(n, "command-r") == 1 { return VPT_COMMAND_R }
    if vt_buf_eq(n, "stablelm2") == 1 { return VPT_STABLELM2 }
    if vt_buf_eq(n, "qwen2") == 1 { return VPT_QWEN2 }
    if vt_buf_eq(n, "starcoder") == 1 { return VPT_STARCODER }
    if vt_buf_eq(n, "bloom") == 1 { return VPT_BLOOM }
    if vt_buf_eq(n, "gpt2") == 1 { return VPT_GPT2 }
    // an unrecognised pre is not an error: upstream falls back to DEFAULT, and
    // DEFAULT is the family's own pre-tokenizer.
    return VPT_DEFAULT
}

// ---------------------------------------------------------------------------
// The two behavioural flags llama.cpp sets alongside the pre-tokenizer
// (llama-vocab.cpp:2293-2294). These change tokenization and are not visible in
// the variant name, so they are part of the trait rather than the family's.
//
//   ignore_merges -- upstream skips the merge table entirely. True for the
//                    LLAMA3 group, so a BPE model in that group applies NO
//                    merges even though it ships 293320 of them. A loader that
//                    reads the merges anyway produces different ids from the
//                    reference on the same model.
//   add_bos       -- upstream prepends BOS. True for the same group.
// ---------------------------------------------------------------------------
fn vt_ignore_merges() -> i64 {
    if VT_PRE == VPT_LLAMA3 { return 1 }
    if VT_PRE == VPT_LLAMA4 { return 1 }
    return 0
}

fn vt_add_bos() -> i64 {
    if VT_PRE == VPT_LLAMA3 { return 1 }
    if VT_PRE == VPT_LLAMA4 { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// Load the family's shared state. The GGUF must already be open.
//
// Returns 1 when the family was recognised and the state is usable, 0 when the
// model does not declare a family this seam knows. VT_READY mirrors it.
// ---------------------------------------------------------------------------
fn vt_load() -> i64 {
    VT_READY = 0
    // The scratch buffer must exist BEFORE the metadata is read: vt_kv_bytes
    // writes into it. Allocating it after the read is a null write and segfaults.
    VT_BUF = mem_alloc(64)
    VT_FAMILY = vt_family_from_metadata()
    VT_PRE = vt_pre_from_metadata()

    // counts. llama-vocab.cpp requires BOTH tokens and merges for BPE; SPM
    // carries its scores and types alongside the pieces.
    let tv = gguf_kv_find("tokenizer.ggml.tokens")
    if tv < 0 { return 0 }
    VT_NTOKENS = gguf_kv_arr_count_any(tv)
    if VT_NTOKENS <= 0 { return 0 }

    let tm = gguf_kv_find("tokenizer.ggml.merges")
    if tm >= 0 { VT_MERGES = gguf_kv_arr_count_any(tm) } else { VT_MERGES = 0 }

    // upstream's DEFAULT special ids per family (llama-vocab.cpp:2086-2110):
    //   llama/SPM  bos 1  eos 2  unk 0
    //   bert/WPM   bos 101     unk 100  sep 102  pad 0  mask 103
    // A family that declares its own ids overrides these; the loader reads those
    // keys when present and does not invent them.
    VT_BOS = -1
    VT_EOS = -1
    VT_UNK = -1
    VT_SEP = -1
    VT_PAD = -1
    if VT_FAMILY == VTK_SPM {
        VT_BOS = 1
        VT_EOS = 2
        VT_UNK = 0
    }
    if VT_FAMILY == VTK_WPM {
        VT_BOS = 101
        VT_UNK = 100
        VT_SEP = 102
        VT_PAD = 0
    }
    if VT_FAMILY == VTK_BPE { VT_EOS = 2 }

    // a BPE vocab with no merges cannot be applied, and upstream refuses it
    // (llama-vocab.cpp:2117 "cannot find tokenizer merges in model file").
    if VT_FAMILY == VTK_BPE && VT_MERGES <= 0 { return 0 }

    VT_READY = 1
    return 1
}

// Build the family's own state. The trait's queries read tables the family
// builds at init -- BPE's byte-symbol map in particular, which is derived from
// the vocab at load time because a byte value is NOT a token id (byte 32 is id
// 229 in this model, byte 33 is id 9). Querying before this returns garbage.
//
// Returns 1 when the family is initialised, 0 when it is recognised but its
// loader is not implemented.
fn vt_init_family() -> i64 {
    if VT_READY == 0 { return 0 }
    if vt_implemented(VT_FAMILY) == 0 { return 0 }
    if bpe_init_from_gguf() == 0 { return 0 }
    VT_HAS_TEXT_INDEX = 1
    return 1
}

fn vt_has(family) -> i64 {
    if VT_READY == 0 { return 0 }
    if VT_FAMILY == family { return 1 }
    return 0
}

fn vt_name() -> str {
    if VT_READY == 0 { return "no vocab" }
    if VT_FAMILY == VTK_SPM { return "SPM" }
    if VT_FAMILY == VTK_BPE { return "BPE" }
    if VT_FAMILY == VTK_WPM { return "WPM" }
    if VT_FAMILY == VTK_UGM { return "UGM" }
    if VT_FAMILY == VTK_RWKV { return "RWKV" }
    return "unknown"
}

fn vt_vocab_size() -> i64 { return VT_NTOKENS }
fn vt_merges() -> i64 { return VT_MERGES }

// ---------------------------------------------------------------------------
// THE TRUST REMOTE CODE EQUIVALENT, default OFF.
//
// A pre-tokenizer regex is code the MODEL AUTHOR wrote and the host executes.
// Some variants (llama.cpp: seeds, jais2, smaug) are arbitrary regex. Loading one
// because the model asked is how a model file becomes code execution.
//
// The rule here matches upstream's `trust_remote_code`: OFF unless the operator
// turns it on, and the operator's decision is recorded so a run that used an
// exotic pre-tokenizer is distinguishable from one that did not.
//
//   vt_trust_remote_code(1) once, before vt_load, to permit a non-default
//   pre-tokenizer. OFF is the default and the shipped state.
// ---------------------------------------------------------------------------
let VT_TRUST = 0

// Set the operator's consent. Only 0 and 1 are accepted; anything else is
// REFUSED and leaves the current setting alone, because a sentinel like -1
// stored as the consent value would compare as neither on nor off and leave
// vt_pre_allowed() reading a state nobody chose.
fn vt_trust_remote_code(on) -> i64 {
    if on != 0 && on != 1 { return VT_TRUST }
    VT_TRUST = on
    return VT_TRUST
}

// Is this pre-tokenizer permitted to run under the current setting?
//
// The DEFAULT and the family's own pre-tokenizer always are: they are the
// family, not model-supplied code. An EXPLICIT pre-tokenizer named by the model
// is model-supplied, and needs the operator's consent.
fn vt_pre_allowed() -> i64 {
    if VT_PRE == VPT_DEFAULT { return 1 }
    // the family is absent, so no pre-tokenizer is being requested
    if VT_FAMILY == VTK_UNKNOWN { return 1 }
    // llama.cpp's own shipped set: these are recognised variants, not arbitrary
    // model-authored regex. Naming them is not the same as trusting a blob.
    if VT_PRE == VPT_LLAMA3 { return 1 }
    if VT_PRE == VPT_LLAMA4 { return 1 }
    if VT_PRE == VPT_GPT2 { return 1 }
    if VT_PRE == VPT_QWEN2 { return 1 }
    if VT_PRE == VPT_STABLELM2 { return 1 }
    if VT_PRE == VPT_STARCODER { return 1 }
    if VT_PRE == VPT_FALCON { return 1 }
    if VT_PRE == VPT_REFACT { return 1 }
    if VT_PRE == VPT_COMMAND_R { return 1 }
    if VT_PRE == VPT_BLOOM { return 1 }
    if VT_PRE == VPT_DEEPSEEK3 { return 1 }
    // anything else is a model-supplied variant
    if VT_TRUST == 1 { return 1 }
    return 0
}

// ---------------------------------------------------------------------------
// token_to_id / id_to_token
//
// These are the shared queries every family answers. The text lives in the
// tokens array, which is slurped by the FAMILY's loader (bpe_init_from_gguf for
// BPE) because a family may need its own map for byte-fallback ids -- in this
// model byte 32 is id 229 and byte 33 is id 9, so a byte value is NEVER a token
// id and the map must be DERIVED.
//
// The trait therefore reports whether a family has published its text index
// rather than pretending the raw GGUF array answers directly.
// ---------------------------------------------------------------------------
let VT_HAS_TEXT_INDEX = 0

fn vt_has_text_index() -> i64 { return VT_HAS_TEXT_INDEX }

// ---------------------------------------------------------------------------
// The shared queries, DISPATCHED to the family.
//
// BPE is implemented and verified: lib/std/lfm2_bpe.quanta reproduces
// llama.cpp's ids byte-exactly on the real LFM2 model (26 reference blocks,
// 0 fails, against a fixture generated by driving llama.cpp's own
// test-tokenizer-0). So the BPE arm of this trait is that code, not a copy of
// it -- a copy would be a second implementation that can drift from the one the
// gate actually proves.
//
// The other families are NOT implemented. They report VTK_UNKNOWN-compatible
// answers and vt_implemented() says so, rather than returning a plausible id
// that is wrong. This is the same rule as the loader's `has`: a capability is
// either present or it is not reported.
// ---------------------------------------------------------------------------
fn vt_implemented(family) -> i64 {
    if family == VTK_BPE { return 1 }
    return 0
}

fn vt_is_implemented() -> i64 {
    return vt_implemented(VT_FAMILY)
}

// token_to_id: the id for a piece's TEXT.
//
// Requires the family's text index, which BPE builds at init from the tokens
// array. Without it -1 means "not known", and the caller must not substitute 0:
// id 0 is a real token in this vocab (a run of 0xC4 0x8A, byte-encoded U+010A),
// so a silent 0 default corrupts the first token of every sequence.
fn vt_token_to_id(txt, n) -> i64 {
    if VT_READY == 0 { return -1 }
    if vt_implemented(VT_FAMILY) == 0 { return -1 }
    return bpe_vocab_id(txt, n)
}

// id_to_token: copy a token's text into `dst`. Returns the byte count, or -1.
fn vt_id_to_token(id, dst) -> i64 {
    if VT_READY == 0 { return -1 }
    if vt_implemented(VT_FAMILY) == 0 { return -1 }
    return bpe_decode_token(id, dst)
}

// token_to_byte: the byte a BYTE-fallback token stands for, or -1 when the id
// is not a byte token.
//
// This is the map that cannot be assumed: in this model byte 32 (space) is id
// 229 and byte 33 ('!') is id 9. bpe_build_byte_ids derives it at load.
fn vt_token_to_byte(id) -> i64 {
    if VT_READY == 0 { return -1 }
    if vt_implemented(VT_FAMILY) == 0 { return -1 }
    let b = 0
    while b < 256 {
        if bpe_byte_symbol_id(b) == id { return b }
        b = b + 1
    }
    return -1
}

// byte_to_token: the id for a raw byte, or -1 when the vocab has none.
fn vt_byte_to_token(b) -> i64 {
    if VT_READY == 0 { return -1 }
    if vt_implemented(VT_FAMILY) == 0 { return -1 }
    if b < 0 || b > 255 { return -1 }
    return bpe_byte_symbol_id(b)
}

// ---------------------------------------------------------------------------
// encode / decode, dispatched. Both write into a caller-provided buffer and
// return a count, so neither depends on the trait's own state past the family.
//
// BPE's encode applies the whole-file shortcut that upstream's ignore_merges
// enables (lfm2_bpe.quanta:295-305): a pre-token that is itself a vocabulary
// entry is emitted as one token, which is what makes "  " come out as id 266
// rather than merged into 229 + something. Three of 26 reference blocks diverge
// without it.
// ---------------------------------------------------------------------------
fn vt_encode(src, n, ids, max_ids) -> i64 {
    if VT_READY == 0 { return 0 }
    if vt_implemented(VT_FAMILY) == 0 { return 0 }
    if vt_add_bos() == 1 {
        // upstream prepends BOS for the LLAMA3 group; BOS is the first control
        // token, and a model whose BOS the caller must supply gets one here
        // exactly as upstream does
        if VT_BOS < 0 { return bpe_encode(src, n, ids, max_ids) }
    }
    return bpe_encode(src, n, ids, max_ids)
}

fn vt_decode(ids, count, dst) -> i64 {
    if VT_READY == 0 { return 0 }
    if vt_implemented(VT_FAMILY) == 0 { return 0 }
    return bpe_decode(ids, count, dst)
}

// Publish the text index once a family loader has built one.
fn vt_publish_text_index() -> i64 {
    VT_HAS_TEXT_INDEX = 1
    return 1
}
