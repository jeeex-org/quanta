import std/sha3_constants
import std/sha3_theta
import std/sha3_rhopi
import std/sha3_chi

fn keccak_iota(st, rnd) {
  let rc = keccak_rc(rnd)
  let a0 = mem_load(st + 0) ^ rc
  mem_store(st + 0, a0)
}

fn keccak_round(st, rnd) {
  keccak_theta(st)
  keccak_rhopi(st)
  keccak_chi(st)
  keccak_iota(st, rnd)
}

fn keccak_f(st) {
  let rnd = 0
  while (rnd < 24) {
    keccak_round(st, rnd)
    rnd = rnd + 1
  }
}