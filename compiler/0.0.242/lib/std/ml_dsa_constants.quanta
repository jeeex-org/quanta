// Barrett reduction constant
fn mldsa_qinv(): i64 { return 58728449 }  // floor(2^32 / q)

// Montgomery constant
fn mldsa_mont(): i64 { return 4194304 }   // 2^22 mod q

// Simple mod reduction
fn mldsa_mod_q(a: i64): i64 {
    let r: i64 = a % mldsa_q()
    if r < 0 {
        r = r + mldsa_q()
    }
    return r
}

// Barrett reduction for q=8380417
fn mldsa_barrett_reduce(a: i64): i64 {
    // a in [0, 2*q) -> a mod q
    let t: i64 = a - mldsa_q()
    if t >= 0 {
        return t
    }
    return a
}

// Montgomery reduction
fn mldsa_montgomery_reduce(a: i64): i64 {
    let t: i64 = (a * mldsa_qinv()) & 0xFFFFFFFF
    let u: i64 = (a + t * mldsa_q()) >> 32
    if u >= mldsa_q() {
        u = u - mldsa_q()
    }
    return u
}

