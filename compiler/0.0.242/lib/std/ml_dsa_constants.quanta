// ML-DSA (Dilithium) FIPS 204 constants
// Module-LWE/LWR parameters for ML-DSA-65 (security level 3)

fn mldsa_q(): i64 { return 8380417 }        // 2^23 - 2^13 + 1 = 8380417
fn mldsa_n(): i64 { return 256 }           // polynomial degree
fn mldsa_k(): i64 { return 4 }             // matrix rows (Dilithium-3: k=4)
fn mldsa_l(): i64 { return 4 }             // matrix cols (Dilithium-3: l=4)
fn mldsa_eta(): i64 { return 2 }           // noise parameter
fn mldsa_tau(): i64 { return 49 }          // number of +/-1 in challenge
fn mldsa_gamma1(): i64 { return 524288 }   // 2^19
fn mldsa_gamma2(): i64 { return 95232 }    // (q-1)/88
fn mldsa_beta(): i64 { return 196 }        // tau * eta
fn mldsa_omega(): i64 { return 55 }        // max # of non-zero in w1

// Symmetric primitive parameters
fn mldsa_crypto_seedbytes(): i64 { return 32 }
fn mldsa_crypto_crhbytes(): i64 { return 64 }
fn mldsa_crypto_rho_bytes(): i64 { return 32 }
fn mldsa_crypto_k_bytes(): i64 { return 32 }
fn mldsa_crypto_tr_bytes(): i64 { return 64 }

// Sizes
fn mldsa_polybytes(): i64 { return 320 }        // 256 * 23 / 8 = 736? Actually 256*5 = 1280/4 = 320
fn mldsa_polyvecbytes(): i64 { return 1280 }    // l * 320
fn mldsa_polyveclbytes(): i64 { return 1280 }   // k * 320
fn mldsa_packed_pkbytes(): i64 { return 1312 }  // rho (32) + t1 (k * 320)
fn mldsa_packed_skbytes(): i64 { return 2528 }  // rho(32) + K(32) + tr(64) + s1(l*320) + s2(k*320) + t0(k*416)
fn mldsa_packed_sigbytes(): i64 { return 3293 } // c_tilde(32) + z(l*320) + h(omega + k)

// NTT constants for q = 8380417
fn mldsa_root_of_unity(): i64 { return 1753 }   // primitive 512-th root
fn mldsa_root_of_unity_inv(): i64 { return 2895446 } // inverse
fn mldsa_ninv(): i64 { return 2567872 }         // 256^{-1} mod q

