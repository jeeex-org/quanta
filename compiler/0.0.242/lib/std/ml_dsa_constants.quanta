// Sample polynomial vector
fn mldsa_polyvec_gaussian(vec: i64[4][256], seed: u8[32]) {
    let i: i64 = 0
    while i < 4 {
        mldsa_poly_gaussian(vec[i], seed, i as u8)
        i = i + 1
    }
}