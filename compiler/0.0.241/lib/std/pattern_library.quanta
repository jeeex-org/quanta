// std/pattern_library.quanta - Phase 2: Pattern Library for Code Generation
// Real patterns for generating Quanta modules from specs

module std_pattern_library;

const PAT_LIB_CAP = 1000;

// Pattern types
const PATTERN_STUB = 0;
const PATTERN_VALIDATE = 1;
const PATTERN_COMPUTE = 2;
const PATTERN_TRANSFORM = 3;
const PATTERN_PERSIST = 4;

// Pattern registry
let pattern_names = mmap(PAT_LIB_CAP * 8);
let pattern_types = mmap(PAT_LIB_CAP * 8);
let pattern_impls = mmap(PAT_LIB_CAP * 8);
let pattern_count = 0;
let pattern_initialized = 0;

// String equality helper
fn str_equals(a, b) -> i64 {
    let la = len(a);
    let lb = len(b);
    if la != lb { return 0; }
    let i = 0;
    while i < la {
        if mem_load8(a + 8 + i) != mem_load8(b + 8 + i) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Register a pattern
fn register_pattern(name, ty, impl) -> i64 {
    if pattern_count >= PAT_LIB_CAP { return 0; }
    let name_copy = mem_alloc(len(name) + 9);
    mem_store(name_copy, len(name));
    let i = 0;
    while i < len(name) {
        mem_store8(name_copy + 8 + i, mem_load8(name + 8 + i));
        i = i + 1;
    }
    mem_store(pattern_names + pattern_count * 8, name_copy);
    mem_store(pattern_types + pattern_count * 8, ty);
    mem_store(pattern_impls + pattern_count * 8, impl);
    pattern_count = pattern_count + 1;
    return 1;
}

// Find pattern by name
fn find_pattern(name) -> i64 {
    let i = 0;
    while i < pattern_count {
        let pn = mem_load(pattern_names + i * 8);
        if str_equals(pn, name) { return i; }
        i = i + 1;
    }
    return -1;
}

// Get pattern type
fn get_pattern_type(idx) -> i64 {
    if idx < 0 || idx >= pattern_count { return -1; }
    return mem_load(pattern_types + idx * 8);
}

// Initialize pattern library (idempotent)
fn init() -> i64 {
    if pattern_initialized == 1 { return pattern_count; }
    pattern_initialized = 1;
    
    // Register built-in patterns
    register_pattern("accounting_gaap", PATTERN_VALIDATE, 0);
    register_pattern("accounting_ifrs", PATTERN_VALIDATE, 0);
    register_pattern("accounting_tax", PATTERN_COMPUTE, 0);
    register_pattern("accounting_audit", PATTERN_VALIDATE, 0);
    register_pattern("accounting_cost", PATTERN_COMPUTE, 0);
    register_pattern("accounting_revenue", PATTERN_COMPUTE, 0);
    register_pattern("accounting_lease", PATTERN_COMPUTE, 0);
    register_pattern("chain_tx", PATTERN_VALIDATE, 0);
    register_pattern("chain_block", PATTERN_VALIDATE, 0);
    register_pattern("chain_consensus", PATTERN_COMPUTE, 0);
    register_pattern("chain_p2p", PATTERN_PERSIST, 0);
    register_pattern("chain_crypto", PATTERN_COMPUTE, 0);
    register_pattern("quantum_qft", PATTERN_COMPUTE, 0);
    register_pattern("quantum_grover", PATTERN_COMPUTE, 0);
    register_pattern("quantum_shor", PATTERN_COMPUTE, 0);
    register_pattern("quantum_error_correction", PATTERN_VALIDATE, 0);
    register_pattern("ai_rope", PATTERN_COMPUTE, 0);
    register_pattern("ai_rmsnorm", PATTERN_COMPUTE, 0);
    register_pattern("ai_swiglu", PATTERN_COMPUTE, 0);
    register_pattern("ai_flash_attn", PATTERN_COMPUTE, 0);
    register_pattern("ai_kv_cache", PATTERN_TRANSFORM, 0);
    register_pattern("math_linalg", PATTERN_COMPUTE, 0);
    register_pattern("math_stats", PATTERN_COMPUTE, 0);
    register_pattern("math_fft", PATTERN_COMPUTE, 0);
    register_pattern("crypto_aes_gcm", PATTERN_COMPUTE, 0);
    register_pattern("crypto_sha3", PATTERN_COMPUTE, 0);
    register_pattern("crypto_x509", PATTERN_VALIDATE, 0);
    register_pattern("crypto_tls", PATTERN_VALIDATE, 0);
    register_pattern("crypto_ecdhe", PATTERN_COMPUTE, 0);
    return pattern_count;
}
