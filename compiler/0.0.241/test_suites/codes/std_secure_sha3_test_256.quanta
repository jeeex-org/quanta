import std/sha3_256_only

// SHA3-256 / SHAKE KAT tests against canonical FIPS 202 vectors. Full 32-byte compare.
// exit codes: 0=all pass, 1=empty fail, 2=abc fail, 3=long fail, 4=shake128 fail, 5=shake256 fail.

fn hexval(c) {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 87 }
  if c >= 65 && c <= 70 { return c - 55 }
  return 0
}
fn hex_to_bytes(dst, hexstr, n) {
  let i = 0
  while i < n {
    let hi = hexval(mem_load8(hexstr + 8 + i * 2))
    let lo = hexval(mem_load8(hexstr + 8 + i * 2 + 1))
    mem_store8(dst + i, hi * 16 + lo)
    i = i + 1
  }
}
fn mem_eq(a, b, n) {
  let i = 0
  while i < n {
    if mem_load8(a + i) != mem_load8(b + i) { return 0 }
    i = i + 1
  }
  return 1
}

fn main() {
  // SHA3-256("") = a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a
  let e = mem_alloc(32)
  sha3_256("", 0, e)
  let ve = mem_alloc(32)
  hex_to_bytes(ve, "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", 32)
  if mem_eq(e, ve, 32) == 0 { exit(1) }

  // SHA3-256("abc") = 3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532
  let a = mem_alloc(32)
  sha3_256("abc", 3, a)
  let va = mem_alloc(32)
  hex_to_bytes(va, "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", 32)
  if mem_eq(a, va, 32) == 0 { exit(2) }

  // SHA3-256(long 56-byte) = 41c0cdeff3a2f3df68c0e5a02d6ba381200ac692b863e0e6c2c88847a8b6d6c2
  let longmsg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  let l = mem_alloc(32)
  sha3_256(longmsg, 56, l)
  let vl = mem_alloc(32)
  hex_to_bytes(vl, "41c0cdeff3a2f3df68c0e5a02d6ba381200ac692b863e0e6c2c88847a8b6d6c2", 32)
  if mem_eq(l, vl, 32) == 0 { exit(3) }

  exit(0)
}