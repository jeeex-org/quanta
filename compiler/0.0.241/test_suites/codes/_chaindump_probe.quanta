import std/secure
fn dumpln(st, tag) {
  let e = mem_alloc(64)
  let k = 0
  while k < 4 {
    let lane = mem_load(st + k*8)
    let b = 0
    while b < 8 {
      let v = (lane >> (b*8)) & 255
      let hi = v >> 4; let lo = v & 15
      let c1 = 0; if hi < 10 { c1 = hi + 48 } else { c1 = hi + 87 }
      let c2 = 0; if lo < 10 { c2 = lo + 48 } else { c2 = lo + 87 }
      mem_store8(e + k*16 + b*2, c1)
      mem_store8(e + k*16 + b*2 + 1, c2)
      b = b + 1
    }
    k = k + 1
  }
  print(e, 64)
  print(tag, 4)
}
fn main() {
  let st = mem_alloc(200)
  let i = 0
  while i < 25 { mem_store(st + i*8, 0); i = i + 1 }
  mem_store(st + 0, 1)
  keccak_r0(st)
  dumpln(st, " after r0\n")
  keccak_r1(st)
  dumpln(st, " after r1\n")
  exit(0)
}
