// x25519_str_debug9.quanta — debug fe_mul call

import std/x25519

fn main() {
  println("Test fe_mul...")
  let u9 = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u9 + i, 0); i = i + 1 }
  mem_store8(u9, 9)
  
  let fe = mem_alloc(5*8)
  fe_from_bytes(u9, fe)
  
  let fe2 = mem_alloc(5*8)
  fe_copy(fe, fe2)
  
  let fe3 = mem_alloc(5*8)
  fe_mul(fe, fe2, fe3)
  println("fe_mul done")
  
  println(0)
  exit(0)
}