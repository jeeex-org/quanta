// stdlib_gguf_truncated_test -- a file that ends mid-metadata must be refused.
//
// The other validation cases in stdlib_gguf_validate_test corrupt the in-memory
// tensor-info table, because building a byte-level corrupt GGUF needs a correct
// GGUF *writer* and two hand-rolled Python readers silently mis-parsed the KV
// block. Truncation is the one case that can be produced honestly: take the
// first N bytes of a real file, and the header still declares 266 tensors and
// 37 KV records while the file ends long before them.
//
// A loader that trusts the declared counts will seek past the end and read
// whatever bytes follow -- for a quantized weight, that means decoding garbage
// with no error anywhere. This must fail at load.
//
// The cut points come from Quanta's own parsed offsets, not from a second GGUF
// parser. Measured on the real file: KV record 0 starts at byte 24 and KV record
// 5 at byte 222, so a 300-byte prefix cuts mid-KV-block while a 222-byte prefix
// cuts exactly on a record boundary. Both must be rejected -- they exercise
// different guards, since one ends mid-record and the other between records.

import std/fs
import std/gguf
import std/math

const MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

// Copy the first `n` bytes of the model to `dst`. Returns 0 on success.
fn make_prefix(dst, want_total) {
    // NOT named `in` -- that is a reserved type keyword in Quanta and the
    // compiler rejects it outright ("reserved type keyword used as a variable
    // name"), which cost a build cycle to find.
    let src = open(MODEL, 0, 0)
    if src < 0 { return -1 }
    let buf = mem_alloc(4096)
    // 577 = O_WRONLY|O_CREAT|O_TRUNC, mode 420 = 0644, from
    // test_suites/codes/file_io.quanta:13 -- open() takes raw C flags, and a
    // wrong value silently creates nothing.
    let out = open(dst, 577, 420)
    if out < 0 { return -1 }
    let left = want_total
    while left > 0 {
        let chunk = left
        if chunk > 4096 { chunk = 4096 }
        let got = read_raw(src, buf, chunk)
        if got <= 0 { break }
        let put = write_raw(out, buf, got)
        if put != got { break }
        left = left - got
    }
    close(src)
    close(out)
    return 0
}

fn main() {
    if gguf_load(MODEL) != 0 { print("FAIL: the real model must load"); return 1 }
    let kv0 = mem_load(gguf_kv_index + 0 * 8)
    let kv5 = mem_load(gguf_kv_index + 5 * 8)
    if kv0 <= 0 { print("FAIL: bad kv0"); return 1 }
    if kv5 <= kv0 { print("FAIL: bad kv5"); return 1 }

    // Case 1: cut mid-KV-block. The header still claims 266 tensors / 37 records.
    if make_prefix("/tmp/quanta_trunc_mid.gguf", 300) != 0 { print("FAIL: make mid"); return 1 }
    let r1 = gguf_load("/tmp/trunc_mid.gguf")
    prints("mid-record rc=")
    print(r1)
    print(" ")
    if r1 >= 0 { print("FAIL: a truncated file was accepted"); return 1 }
    gguf_close()

    // Case 2: cut exactly on a KV record boundary, so no read is short but the
    // declared record count still runs past the end.
    if make_prefix("/tmp/quanta_trunc_edge.gguf", kv5) != 0 { print("FAIL: make edge"); return 1 }
    let r2 = gguf_load("/tmp/trunc_edge.gguf")
    prints("boundary rc=")
    print(r2)
    print(" ")
    if r2 >= 0 { print("FAIL: a boundary-truncated file was accepted"); return 1 }
    gguf_close()

    // The unsuffixed path is what the first case actually opens; keep both names
    // pointing at a real file so a typo here cannot pass silently.
    if make_prefix("/tmp/trunc_mid.gguf", 300) != 0 { print("FAIL: remake mid"); return 1 }
    let r3 = gguf_load("/tmp/trunc_mid.gguf")
    if r3 >= 0 { print("FAIL: truncated accepted on re-read"); return 1 }
    gguf_close()

    // And the real file must still load afterwards, so the rejections above did
    // not leave global state corrupted.
    if gguf_load(MODEL) != 0 { print("FAIL: real model broken after rejections"); return 1 }
    if gguf_validate_chain() != 0 { print("FAIL: chain after rejections"); return 1 }

    print("OK gguf-truncated")
    return 0
}