import std/secure
fn main() {
  // krot(1, 1) must = 2
  if krot(1, 1) != 2 { exit(1) }
  // rotate high bit to pos 0: krot(0x8000000000000000, 1) = 1
  if krot(0x8000000000000000, 1) != 1 { exit(2) }
  // rotate pos 0 to pos 63: krot(1, 63) must = 0x8000000000000000
  if krot(1, 63) != 0x8000000000000000 { exit(3) }
  // krot(0x0F0F0F0F0F0F0F0F, 32) must swap halves: 0x0F0F0F0F0F0F0F0F
  if krot(0x0F0F0F0F0F0F0F0F, 32) != 0x0F0F0F0F0F0F0F0F { exit(4) }
  exit(0)
}
