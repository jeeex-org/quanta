// mmap1: mmap returns usable memory that does not collide with globals.
// Arch-neutral (x86 uses fixed GDATA, ARM64 is PIE): test BEHAVIOR, not addresses.
let g = 12345
let a = mmap(1048576)
fn r64x(p) { unsafe { return mem_load(p) } }
fn w64x(p,v) { unsafe { mem_store(p,v) } }
fn main() {
    if a <= 0 { return 1 }
    // write/read across the region
    w64x(a, 777)
    w64x(a+1048568, 888)
    if r64x(a) != 777 { return 2 }
    if r64x(a+1048568) != 888 { return 3 }
    // globals unclobbered
    if g != 12345 { return 4 }
    // second mmap is distinct
    let b = mmap(4096)
    if b <= 0 { return 5 }
    w64x(b, 111)
    if r64x(a) != 777 { return 6 }
    return 42
}
