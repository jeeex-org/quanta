// Test Q6_K dequantization - no imports
fn main() {
    let raw = mmap(16)
    mem_store8(raw, 63)
    mem_store8(raw + 1, 0)
    mem_store8(raw + 2, 63)
    
    let scale = mem_load8(raw) + mem_load8(raw + 1) * 256
    let b0 = mem_load8(raw + 2)
    let q0 = b0 - (b0 / 64) * 64
    
    if scale != 63 { return 1 }
    if q0 != 63 { return 1 }
    
    return 0
}