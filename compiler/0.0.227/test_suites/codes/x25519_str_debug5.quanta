// x25519_str_debug5.quanta — debug fe_to_bytes call

import std/x25519

fn main() {
  println("Test fe_to_bytes...")
  let u9 = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u9 + i, 0); i = i + 1 }
  mem_store8(u9, 9)
  
  let fe = mem_alloc(5*8)
  fe_from_bytes(u9, fe)
  
  let out = mem_alloc(32)
  fe_to_bytes(fe, out)
  println("fe_to_bytes done")
  
  println(0)
  exit(0)
}