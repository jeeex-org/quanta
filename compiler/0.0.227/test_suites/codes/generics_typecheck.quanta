// 0.0.101: compile-time generic type-argument checks.
// id<T>(x T) T { return x } is type-erased (all i64), but the CALL must now
// validate (a) type-arg arity == fn_genparams, and (b) each type-arg names an
// existing type (struct or i64). Bad instantiations are HARD compile errors.
fn id<T>(x T) T { return x }
fn main() {
    // VALID: single type-arg i64 matches <T>, arity 1 == 1.
    exit(id<i64>(42))
}