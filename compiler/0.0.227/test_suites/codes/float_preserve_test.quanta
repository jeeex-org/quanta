import std/fs

// Test float-preserving builtins
fn main() {
    // Test faddf: should return float bit-pattern, not truncate
    let a = i2f(1)
    let b = i2f(2)
    
    // fadd (old) should truncate to int
    let r1 = fadd(a, b)
    if r1 != 3 { return 1 }
    
    // faddf (new) should return float bit-pattern
    let r2 = faddf(a, b)
    if r2 != i2f(3) { return 2 }
    
    // Test fmulf: should do float multiply without truncation
    let x = i2f(3)
    let y = i2f(7)
    let r3 = fmulf(x, y)
    if r3 != i2f(21) { return 3 }
    
    // Test chained fmulf + faddf
    let c1 = fmulf(i2f(2), i2f(3))
    let c2 = fmulf(i2f(4), i2f(5))
    let c3 = faddf(c1, c2)
    if c3 != i2f(26) { return 4 }
    
    // Test fdivf
    let d1 = fdivf(i2f(15), i2f(3))
    if d1 != i2f(5) { return 5 }
    
    // Test fsubf
    let s1 = fsubf(i2f(10), i2f(3))
    if s1 != i2f(7) { return 6 }
    
    return 0
}