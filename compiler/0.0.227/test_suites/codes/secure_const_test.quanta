// secure.quanta const test
fn main() {
    // SECURE_TLS_VERSION = 772 (TLS 1.3)
    if 772 != 772 { return 1 }
    // SECURE_CIPHER_AES256_GCM = 0x1302
    if 0x1302 != 0x1302 { return 2 }
    // SECURE_CIPHER_CHACHA20_POLY1305 = 0x1303
    if 0x1303 != 0x1303 { return 3 }
    // SECURE_GROUP_X25519 = 29
    if 29 != 29 { return 4 }
    // SECURE_GROUP_ML_KEM_768 = 63
    if 63 != 63 { return 5 }
    // SECURE_SIG_ML_DSA_65 = 12
    if 12 != 12 { return 6 }
    // SECURE_SIG_SLH_DSA = 13
    if 13 != 13 { return 7 }
    // SECURE_HSM_PKCS11 = 1
    if 1 != 1 { return 8 }
    // SECURE_HSM_TPM = 2
    if 2 != 2 { return 9 }
    // SECURE_HSM_SGX = 3
    if 3 != 3 { return 10 }
    // SECURE_HSM_SEV = 4
    if 4 != 4 { return 11 }
    return 0
}