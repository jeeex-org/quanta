// The mapped GGUF window must produce BIT-IDENTICAL bytes to the pread path.
//
// Phase 7 item 1 (mmap + MADV_POPULATE_READ) changes where tensor bytes come
// from, not what they are. The invariant is the same one Phase 8 and Phase 8b
// restate: placement decides speed, never semantics. A tolerance would be
// useless here -- a copy that is 99.999% right still produces a different model,
// so this compares byte for byte and counts differences.
//
// It also pins the alignment bug that made the mapping silently absent:
// gguf_data_start is 8239136 for this model and 8239136 mod 4096 = 2080, and
// mmap at a non-page-aligned offset returns EINVAL. Before the fix the window
// simply never appeared and every read quietly fell back to pread, which is why
// this test asserts the mapping EXISTS rather than only comparing numbers.
import std/gguf
import std/fs

const Q4_PATH = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

fn main() -> i64 {
    let fails = 0

    let lr = gguf_load(Q4_PATH)
    if lr < 0 {
        print("FAIL: gguf_load rc=")
        print(lr)
        print("\n")
        return 1
    }

    // The window must be mapped. If this fails, the rest of the test is vacuous
    // because everything would be running through the pread fallback.
    if gguf_map_base == 0 {
        print("FAIL: data window not mapped (mmap offset must be page-aligned)\n")
        gguf_close()
        return 1
    }
    print("data window mapped\n")

    // gguf_map_off must be page-aligned, and the data start must lie inside it.
    if gguf_map_off % 4096 != 0 {
        print("FAIL: gguf_map_off is not page-aligned\n")
        fails = fails + 1
    }
    let doff = gguf_data_offset()
    if doff < gguf_map_off || doff - gguf_map_off >= gguf_map_len {
        print("FAIL: data start is not inside the mapped window\n")
        fails = fails + 1
    }

    // Compare raw bytes for a set of tensors: mapped vs pread, byte for byte.
    let names = [
        "blk.0.ffn_norm.weight",
        "blk.5.attn_k.weight",
        "blk.11.attn_k.weight",
        "output_norm.weight",
    ]

    let ni = 0
    while ni < 4 {
        let nm = names[ni]
        let idx = gguf_find_tensor(nm)
        if idx < 0 {
            print("skip (absent): ")
            write_str(1, nm)
            print("\n")
            ni = ni + 1
            continue
        }

        let off = gguf_tensor_offset(idx)
        let n = gguf_tensor_nbytes(idx)
        if n == 0 || n > 33554432 {
            print("skip (size): ")
            write_str(1, nm)
            print("\n")
            ni = ni + 1
            continue
        }

        let a = mem_alloc(n)
        let b = mem_alloc(n)

        // a: the loader's own mapped path
        let ra = gguf_read_bytes(off, a, n)
        // b: the pread path
        lseek(gguf_fd, off, 0)
        let rb = file_read(gguf_fd, b, n)

        if ra != rb {
            print("FAIL: read length mismatch on ")
            write_str(1, nm)
            print("\n")
            fails = fails + 1
        }

        let diff = 0
        let i = 0
        while i < n {
            if mem_load8(a + i) != mem_load8(b + i) { diff = diff + 1 }
            i = i + 1
        }
        if diff != 0 {
            print("FAIL: ")
            write_str(1, nm)
            print(" differs in ")
            print(diff)
            print(" of ")
            print(n)
            print(" bytes\n")
            fails = fails + 1
        }
        mem_free(a)
        mem_free(b)
        ni = ni + 1
    }

    // A read beyond the window must still work via the fallback, not return junk.
    let tail_off = gguf_map_off + gguf_map_len
    if tail_off + 16 < gguf_filesize {
        let t = mem_alloc(16)
        let rt = gguf_read_bytes(tail_off, t, 16)
        if rt != 16 {
            print("FAIL: fallback read past the window returned ")
            print(rt)
            print("\n")
            fails = fails + 1
        }
        mem_free(t)
    }

    // gguf_close must release the window, or every model swap leaks 256 MiB of
    // address space.
    gguf_close()
    if gguf_map_base != 0 {
        print("FAIL: mapping survived gguf_close\n")
        fails = fails + 1
    }

    if fails > 0 {
        print("std_gguf_mmap_test: ")
        print(fails)
        print(" FAILURES\n")
        return 1
    }
    print("std_gguf_mmap_test: all pass\n")
    return 0
}
