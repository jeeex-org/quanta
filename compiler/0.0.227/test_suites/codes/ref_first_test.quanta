// ref first, then move
fn make() -> u64 {
    return 42
}

fn main() {
    // --- ref first ---
    mut m2 = 10
    ref mr = &m2
    if *mr != 10 { return 1 }
    m2 = 20
    if *mr != 20 { return 2 }

    // --- then mut+move ---
    mut m = 1
    m = m + 1
    let taken = move m
    if taken != 2 { return 3 }

    return 0
}