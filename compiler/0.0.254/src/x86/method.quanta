// === METHOD / SELF (t8) ===
// obj.method(args) desugars to method(obj, args...): `self` is just the
// method's first parameter (a regular name, no new keyword). The method-call
// path only runs when user code uses `obj.NAME` (alpha); the compiler source
// never does, so it does not trip the allocator hazard.

// Global scratch buffer `segvreg` (declared in globals.quanta) holds the
// segment vregs between pass 1 and pass 2 of string interpolation.

// parse_call(nm, nl, mode): parse `name(args)` using the shared arg machinery
// and emit IR_CALL. mode: FI_LOCAL (bare call, local-first) or FI_GLOBAL ($( ),
// global-only). Returns the result vreg. Accepts an optional leading `selfv`
// (a vreg to prepend as param 0) for method calls.
fn parse_call(nm, nl, mode) {
    let selfv = -1
    return parse_call_impl(nm, nl, selfv, mode)
}

fn parse_method_call(selfv, mnm, ml) {
    return parse_call_impl(mnm, ml, selfv, FI_LOCAL)
}

// resolve_fn(nm, nl, mode): pick the function index per resolution mode.
fn resolve_fn(nm, nl, mode) {
    if mode==FI_GLOBAL { return findfn_global(nm, nl) }
    return resolve_call(nm, nl)
}

fn parse_call_impl(nm, nl, selfv, mode) {
    // P10: Check for generic type arguments <T, U> after function name
    // '<' and '>' are TT_OP (values 60/62) ? parser checks context
    let gen_args_count = 0
    let gen_args = mmap(8000)  // store type argument identifiers
    if tokp<tokc && tokt(tokp)==TT_OP && tokv(tokp)==60 {
        adv()  // consume '<'
        while tokp<tokc {
            if tokt(tokp)==TT_OP && tokv(tokp)==62 { adv(); break }
            if tokt(tokp)==TT_ID || tokt(tokp)==TT_KEY {
                w64(gen_args + gen_args_count*16, tokv(tokp))
                w64(gen_args + gen_args_count*16 + 8, tokln(tokp))
                gen_args_count = gen_args_count + 1
                adv()
                if tokp<tokc && tokt(tokp)==TT_PNCT && tokv(tokp)==44 { adv() }  // skip comma
            } else {
                adv()
            }
        }
        adv()  // consume '('
    }
    // t10: fnptr(FNAME) -> code pointer as a runtime value. Special-cased
    // because its argument is a compile-time function NAME, not a value expr.
    if nl==5&&r8(src+nm)=='f'&&r8(src+nm+1)=='n'&&r8(src+nm+2)=='p'&&r8(src+nm+3)=='t'&&r8(src+nm+4)=='r' {
        adv()  // consume '('
        if !(peek()==TT_ID) { compile_error(0, nm, nl) }
        let fnnm = pval(); let fnln = plen(); adv()  // consume FNAME
        mpnct(41)  // ')'
        let fi = resolve_fn(fnnm, fnln, mode)
        if fi<0 { compile_error(0, fnnm, fnln) }
        let vr = nv(); iremit(IR_FNPTR, vr, fi, 0, 0); return vr
    }
    // For non-generic calls, consume '('
    if tokp<tokc && tokt(tokp)==TT_PNCT && tokv(tokp)==40 {
        adv()   // consume '('
    }
    let base=argsp
    let ac=0
    // t8: if this is a method call, prepend self as the first argument (param 0).
    if selfv>=0 {
        w64(argstack + argsp*8, selfv)
        w64(arg_tgt + (base+ac)*8, ac)
        w8(arg_filled + (base*64 + ac), 1)
        argsp = argsp + 1
        ac = ac + 1
    }
    if !(peek()==TT_PNCT&&pval()==41) {
        while true {
            // t4: detect a named argument: ID immediately followed by ':'.
            let anm = 0
            if peek()==TT_ID && tokp+1<tokc && tokt(tokp+1)==TT_PNCT && tokv(tokp+1)==58 {
                anm = tokv(tokp)   // remember name src-ptr
                adv()              // consume name ID
                adv()              // consume ':'
            }
            // A call nested inside this argument runs parse_call_impl, which
            // does `argsp = base` (its own base == the arg counter as it stood
            // here) on the way out. That rewound the counter past every argument
            // THIS call had already collected, so `f(1, g())` lost the 1, and
            // with a struct field on the nested result the outer loop then read
            // the cursor from the wrong place and reported "undeclared variable"
            // for the field name.
            //
            // Restoring the counter around the argument expression keeps the
            // outer collection intact. The default-argument path already does
            // exactly this (`saved_a = argsp` ... `argsp = saved_a`); the
            // ordinary argument path did not.
            let saved_argsp = argsp
            let a=parse_expr()
            argsp = saved_argsp
            // target slot = argument order by default; remapped if named.
            let tgt = ac
            if anm!=0 {
                let callee = resolve_fn(nm, nl, mode)
                if callee>=0 {
                    let pidx = findparam(callee, anm, len_name_colon(anm))
                    if pidx>=0 { tgt = pidx } else { compile_error(2, nm, nl) }
                }
            }
            // Collect in ARGUMENT order (increment argsp so nested calls
            // get distinct bases), recording the target param index.
            w64(argstack + argsp*8, a)
            w64(arg_tgt + (base+ac)*8, tgt)
            w8(arg_filled + (base*64 + tgt), 1)   // t5: mark param index tgt as supplied
            argsp = argsp + 1
            ac = ac + 1
            if peek()==TT_PNCT&&pval()==44 { adv() } else { break }
        }
    }
    mpnct(41)
    let nargs=argsp-base
    // t5: fill omitted params with their default expressions.
    let dfn = resolve_fn(nm, nl, mode)
    if dfn>=0 {
        let dfull = r64(fn_pcount + dfn*8)
        let zz=0
        while zz<dfull {
            if r8(arg_filled + (base*64 + zz))==0 {
                let dr0 = r64(fn_defargs + (dfn*64 + zz)*16)
                let dr1 = r64(fn_defargs + (dfn*64 + zz)*16 + 8)
                if dr0!=0 && dr1>dr0 {
                    let saved_p = tokp; let saved_c = tokc; let saved_a = argsp
                    tokp = dr0; tokc = dr1
                    let dval = parse_expr()
                    tokp = saved_p; tokc = saved_c; argsp = saved_a
                    w64(argstack + argsp*8, dval)
                    w64(arg_tgt + (base+nargs)*8, zz)
                    argsp = argsp + 1
                    nargs = nargs + 1
                }
            }
            zz = zz + 1
        }
        let cz=0
        while cz<dfull {
            if r8(arg_filled + (base*64 + cz))==0 {
                let cdr0 = r64(fn_defargs + (dfn*64 + cz)*16)
                if cdr0==0 { compile_error(2, nm, nl) }
            }
            cz = cz + 1
        }
    }
    // t4: permute collected args from argument order into callee
    // parameter order so the MOV-emit below loads them correctly.
    let rk=0
    while rk<nargs {
        let p = r64(arg_tgt + (base+rk)*8)
        w64(arg_tmp + (base+p)*8, r64(argstack + (base+rk)*8))
        rk = rk + 1
    }
    let ck=0
        while ck<nargs { w64(argstack + (base+ck)*8, r64(arg_tmp + (base+ck)*8)); ck=ck+1 }
 // P10: generic type arguments were parsed earlier (lines 34-49) into
 // gen_args/gen_args_count; they are in function scope and still live
 // here. Do NOT re-declare them (that dropped the parsed args -> the
 // type-erased bug). Monomorphise below using the real values.
 let fchk=resolve_fn(nm,nl,mode)
        let effective_fi = fchk
        // 0.0.101: real compile-time generic checks (monomorphisation foundation).
        // Type args were parsed at lines 32-49 into gen_args/gen_args_count and
        // are NOT re-declared here (that was the type-erased bug). Validate them
        // before the call so a generic instantiated with a bad/wrong arity type
        // arg is a HARD compile error, not a silent type-erased call.
        if fchk>=0 && r64(fn_generic + fchk*8)!=0 {
            let gexp = r64(fn_genparams + fchk*8)
            // Type args are OPTIONAL at the call site (0.0.101): omitting them
            // keeps the type-erased default (single i64), preserving existing
            // call sites (generics_test, where_clause_test). When PROVIDED, they
            // are now validated: arity must match fn_genparams, and each type arg
            // must name an existing struct or the primitive i64.
            if gen_args_count > 0 {
                if gen_args_count != gexp {
                    compile_error(2, nm, nl)   // arity mismatch on generic type args
                    exit(1)
                }
                let gk = 0
                while gk < gen_args_count {
                    let gnm = r64(gen_args + gk*16)
                    let gln = r64(gen_args + gk*16 + 8)
                    let gsi = findstruct(gnm, gln)
                    if gsi == -1 {
                        if !(gln==3 && r8(src+gnm)=='i' && r8(src+gnm+1)=='6' && r8(src+gnm+2)=='4') {
                            compile_error(1, gnm, gln)  // unknown type in generic args
                            exit(1)
                        }
                    }
                    gk = gk + 1
                }
            }
        }
        let do_call=0
        if fchk>=0 { do_call=1 }
        if do_call==0 { if is_bltn(nm,nl)==1 { do_call=1 } }
        // P10: fn-typed param indirect call: name is not a function but IS a
        // param of the current fn declared as fn(...) -> ... -> the param's
        // vreg holds a [codeptr, env] tuple -> route through IR_CLOSURE_CALL.
        let fpar_pz = -1
        if do_call==0 && cur_fi>=0 {
            let pz2 = findparam(cur_fi, nm, nl)
            if pz2>=0 && r64(fn_parfn + (cur_fi*200 + pz2)*8)==1 { fpar_pz = pz2; do_call=1 }
        }
        // P10: fn-value LOCAL indirect call: `let f = double; f(21)`. The name
        // is not a function/builtin/param but IS a local vreg tagged 11 (fn
        // value bound via parse_let). Route through IR_CLOSURE_CALL with the
        // local's vreg as the tuple ptr. Marker: fpar_pz=-2 (distinct from the
        // fn-typed-PARAM case >=0).
        if do_call==0 {
            let fvl = vfind(nm, nl)
            if fvl>=0 && r64(vreg_type + fvl*8)==11 { fpar_pz = -2; do_call=1 }
        }
        if do_call==1 {
            // 0.0.114: call-site int->big promotion. For a known user callee,
            // any argument feeding a param declared `: big` (fn_parbig) that is
            // not already big is wrapped via big_from_i64. Done in a PRE-PASS
            // that rewrites the argstack slot in place, BEFORE avs is captured,
            // so the arg IR_MOV records below stay contiguous (codegen reads
            // args via irres(avs+i)).
            {
                let cfi_pb = findfn(nm, nl)
                if cfi_pb >= 0 {
                    let pk = base
                    while pk < argsp {
                        // arg_tgt[pk] = the DECLARED param index this argument
                        // feeds (handles named args + self prepend correctly).
                        let pz = r64(arg_tgt + pk*8)
                        if r64(fn_parbig + (cfi_pb*200 + pz)*8)==1 {
                            let av = r64(argstack + pk*8)
                            if r64(vreg_is_big + av*8)!=1 {
                                w64(argstack + pk*8, big_promote(av))
                            }
                        }
                        pk = pk + 1
                    }
                }
            }
            let avs=irc
            let k=base
            while k<argsp { let mv=nv(); iremit(IR_MOV,mv,r64(argstack+k*8),0,0); k=k+1 }
            argsp=base
            // 0.0.225: VARIADIC print(a, b, c, ...) for THREE OR MORE arguments.
            //
            // The emitter's print builtin only ever consumed argument 0, so every
            // other argument was silently dropped with no diagnostic:
            //     print("a=", 12, "\n")   ->  "a="
            //
            // Two arguments are NOT ambiguous: test_suites/codes/prints_family.quanta
            // documents `print(buf, len)` as a defined builtin form, and existing
            // callers rely on it (print(" rc2\n", 6) in _rc23_probe dumps exactly 6
            // bytes of a literal). Disambiguating by type instead -- treating a
            // string first argument as variadic -- broke those callers:
            // print("ABCDEFGH", 8) then printed "ABCDEFGH8". So argc decides:
            // 2 == the documented buf/len alias, 3+ == variadic.
            //
            // Fixing this in the emitter is not viable: the emitter sees only the
            // already-lowered IR, and a literal argument has no live vreg to
            // spill, so its spill home holds unrelated stack bytes (reading them
            // printed "n=201122", the bytes of the caller's own format string,
            // then SIGSEGV). So lower it HERE, where the arguments are still
            // known, into a sequence of ordinary single-argument prints -- the
            // same shape the println -> big_println rewrite below uses.
            if nl==5&&nargs>=3&&r8(src+nm)=='p'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='n'&&r8(src+nm+4)=='t' {
                // emit one single-argument print per argument, reusing the
                // EXISTING "print" name: with nargs==1 the emitter takes its
                // already-working single-argument path, so this needs no new
                // builtin and cannot regress the buf/len alias above.
                let _pk = 0
                let _retv = -1
                while _pk < nargs {
                    let _one = nv()
                    // Give every lowered call its OWN single-argument record.
                    // Pointing several calls at one shared arg block does not
                    // work: the emitter reads the argument slot off the CALL
                    // record, but a bare literal argument is an IR_CONST/IR_STR
                    // record with no spilled vreg behind it, so the read picked
                    // up the neighbouring record's fields -- printing the ARG
                    // COUNT as an extra leading value and running one byte past
                    // the end of the string ("n=3" came out as "n=30").
                    // Copying the operand into a fresh vreg first is what makes
                    // it a normal, spillable argument.
                    let _ar2 = avs + _pk
                    let _av2 = irres(_ar2)
                    let _op2 = irop(_ar2)
                    let _sv2 = _av2
                    if _op2==IR_MOV { _sv2 = ira0(_ar2) }
                    let _tmp2 = nv()
                    let _myrec = irc
                    iremit(IR_MOV,_tmp2,_sv2,0,0)
                    if r64(vreg_is_str + _sv2*8)==1 { w64(vreg_is_str + _tmp2*8, 1) }
                    if _op2==IR_STR { w64(vreg_is_str + _tmp2*8, 1) }
                    iremit(IR_CALL,_one,nm,1,_myrec)
                    _retv = _one
                    _pk = _pk + 1
                }
                return _retv
            }
            // 0.0.114: println(big) -> big_println(big). The emitter's println
            // builtin only knows int/string/float; a big operand would print a
            // raw pointer. Redirect the callee to std/big's big_println.
            if nl==7&&nargs==1&&r8(src+nm)=='p'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='n'&&r8(src+nm+4)=='t'&&r8(src+nm+5)=='l'&&r8(src+nm+6)=='n' {
                let _bv = irres(avs)
                // the arg record is IR_MOV dst<-src; the big tag lives on the
                // SOURCE vreg (the fresh dst vreg from nv() is untagged)
                if r64(vreg_is_big + _bv*8)!=1 && irop(avs)==IR_MOV { _bv = ira0(avs) }
                if r64(vreg_is_big + _bv*8)==1 {
                    let cnm = srclen
                    w8(src+cnm,98); w8(src+cnm+1,105); w8(src+cnm+2,103); w8(src+cnm+3,95)     // "big_"
                    w8(src+cnm+4,112); w8(src+cnm+5,114); w8(src+cnm+6,105); w8(src+cnm+7,110)  // "prin"
                    w8(src+cnm+8,116); w8(src+cnm+9,108); w8(src+cnm+10,110); w8(src+cnm+11,0)  // "tln\0"
                    srclen = cnm + 12
                    nm = cnm; nl = 11
                }
            }
            // 0.0.114: call-site int->big promotion. When the callee is a known
            // user function whose param z is declared `: big` (fn_parbig), an
            // argument that is not already big is wrapped via big_from_i64 so
            // the callee receives a real big pointer, never a raw int. Rewrite
            // the source of the arg's IR_MOV record in place (codegen reads
            // args via ira0(avs+k)).
            {
                let cfi = findfn(nm, nl)
                if cfi >= 0 {
                    let pz = 0
                    while pz < nargs {
                        if r64(fn_parbig + (cfi*200 + pz)*8) == 1 {
                            let arec = avs + pz
                            if irop(arec) == IR_MOV {
                                let av = ira0(arec)
                                if r64(vreg_is_big + av*8) != 1 {
                                    let pv = big_promote(av)
                                    w64(ir + arec*IRS + 16, pv)
                                }
                            }
                        }
                        pz = pz + 1
                    }
                }
            }
            // P10: fn-value LOCAL indirect call: fnb = the local's vreg (holds
            // a [codeptr, env] tuple from IR_FNVAL), caller args are the
            // collected args.
            if fpar_pz==-2 {
                let fvl = vfind(nm, nl)
                let vr2=nv(); iremit(IR_CLOSURE_CALL, vr2, fvl, avs, nargs); return vr2
            }
            // P10: fn-typed param indirect call: fnb = the param's vreg (holds
            // a [codeptr, env] tuple), caller args are the collected args.
            if fpar_pz>=0 {
                let pvr = -1
                let pi2 = varc-1
                while pi2>=0 {
                    let pvnm = r64(vars + pi2*VRS); let pvnl = r64(vars + pi2*VRS + 16)
                    if pvnl==nl {
                        let ok=1; let j2=0
                        while j2<nl { if r8(src+pvnm+j2)!=r8(src+nm+j2){ok=0;break}; j2=j2+1 }
                        if ok==1 { a1b_check(pi2, nm, nl); pvr=r64(vars+pi2*VRS+8); break }
                    }
                    pi2=pi2-1
                }
                let vr2=nv(); iremit(IR_CLOSURE_CALL, vr2, pvr, avs, nargs); return vr2
            }
            // t10: closure_call(fnb, args...) -> dedicated IR (env-shift + indirect call).
            if nl==12&&r8(src+nm)=='c'&&r8(src+nm+1)=='l'&&r8(src+nm+2)=='o'&&r8(src+nm+3)=='s'&&r8(src+nm+4)=='u'&&r8(src+nm+5)=='r'&&r8(src+nm+6)=='e'&&r8(src+nm+7)=='_'&&r8(src+nm+8)=='c'&&r8(src+nm+9)=='a'&&r8(src+nm+10)=='l'&&r8(src+nm+11)=='l' {
                // fnb is the first collected arg (argstack[base]); caller args start at avs+1.
                let fnbv = irres(avs)
                let vr2=nv(); iremit(IR_CLOSURE_CALL, vr2, fnbv, avs+1, nargs-1); return vr2
            }
            let vr2=nv()
            // P10: method-form push on an ARRAY (receiver not str-tagged) ->
            // qword append (IR_APUSH) and reassign the receiver to the new
            // array (mutating method semantics, like `result.push(x)`).
            let is_arr_push = 0
            if nl==4 && r8(src+nm)=='p' && r8(src+nm+1)=='u' && r8(src+nm+2)=='s' && r8(src+nm+3)=='h' {
                if selfv>=0 && r64(vreg_is_str + selfv*8)!=1 { is_arr_push = 1 }
            }
            if is_arr_push==1 {
                iremit(IR_APUSH, vr2, 0, nargs, avs)
                if selfv>=0 { iremit(IR_MOV, selfv, vr2, 0, 0) }  // result = new array
            } else {
                iremit(IR_CALL,vr2,nm,nargs,avs)
            }
        // G2: builtins str()/push() return a byte-stride string -> tag vr2.
        // nm is an offset; builtin names are at src+nm (same as is_bltn()).
        // P10: array push (is_arr_push) returns an ARRAY ? do NOT tag as str.
        if vr2>=0 && vr2<8192 {
            if nl==3&&r8(src+nm)=='s'&&r8(src+nm+1)=='t'&&r8(src+nm+2)=='r' { w64(vreg_is_str + vr2*8, 1) }
            // Removed: tagging "push" result as str. A user-defined fn push(...)
            // is a plain function, not a string. This str-tag corrupted calls
            // to any user fn literally named "push". Array-push method semantics
            // are handled by the is_arr_push path above (which does NOT tag str).
        }
        // Phase 4.3: if the callee returns a struct, tag vr2 so `q.field` works.
        if fchk>=0 {
            let rsi = r64(fn_retstruct + fchk*8)
            if rsi>=0 { w64(vreg_struct + vr2*8, rsi) }
            // 0.0.114: if the callee returns a big, tag vr2 big so chained
            // big ops (a + b where a = f()) keep routing to std/big.
            if r64(fn_retbig + fchk*8)==1 { w64(vreg_is_big + vr2*8, 1) }
            // 0.0.248: a callee DECLARED `-> f32` / `-> f16` returns that float
            // type, so the CALL RESULT carries it. Without this the value is
            // correctly narrowed by the callee's IR_RET (that is the A26 fix) but
            // the caller then treats it as an f64, so `ret32() * 2.0` would
            // compute in binary64 -- a declared type that survives the boundary
            // and is dropped one instruction later.
            let rf32 = r64(fn_retft + fchk*8)
            if rf32 != 0 { w64(vreg_ftype + vr2*8, rf32); w8(vfloat + vr2, 1) }
        }
        return vr2
    } else {
        // Undeclared, non-builtin call: hard compile error (no silent 0).
        compile_error(0, nm, nl)
    }
}

// build_str(a, b): emit str(a, b) exactly like the `..` desugar. Returns the
// result vreg (a string). Used by string-interpolation to combine segments.
fn build_str(a, b) {
    let cnm = srclen
    w8(src+cnm,115); w8(src+cnm+1,116); w8(src+cnm+2,114); w8(src+cnm+3,0)
    srclen = cnm + 4   // reserve the name slot; matches the `..` desugar so the
                       // interpolation walk's later literal writes never clobber it
    let cavs = irc
    let ma = nv(); iremit(IR_MOV, ma, a, 0, 0)
    let mb = nv(); iremit(IR_MOV, mb, b, 0, 0)
    let cr = nv()
    iremit(IR_CALL, cr, cnm, 2, cavs)
    w64(vreg_is_str + cr*8, 1)
    return cr
}

// parse_postfix_expr(vr): apply any trailing `[...]` to a primary that
// parse_primary produced as a VALUE rather than as a name.
//
// parse_primary's identifier branch has always handled `a[i]` and `a.f`. Every
// other primary -- an array literal, a call result, a parenthesised expression --
// returned immediately, so `f(x)[0]` and `[1,2][0]` had nothing to consume the
// bracket and the trailing tokens were left in the stream. That is the
// non-name-base half of parse_index_on's comment; this is where it gets fixed.
//
// Loops, so the result of one index can be indexed again.
fn parse_postfix_expr(vr) {
    let cur = vr
    while peek()==TT_PNCT && pval()==91 { cur = parse_postfix_expr(parse_index_on(cur)) }
    return parse_dot_chain(cur)
}

// parse_dot_chain: apply `.field` repeatedly to a base vreg that is already in
// hand -- a call result, a parenthesised expression, or the result of an index.
//
// Kept SEPARATE from parse_postfix_expr so the chain does not re-run the `[`
// loop on an already-consumed cursor. The single combined recursive version
// looked equivalent and was not: for `mk().b0.a0` the second entry saw a
// cursor the parser no longer expected and the compiler core-dumped, while
// `mk().b0` and `b.b0.a0` (the local path) both worked.

fn parse_dot_chain(cur) {
    // Iterative, not recursive. The previous tail-recursive form
    // (`return parse_dot_chain(out)`) worked for ONE link -- `mk().b0` -- and
    // core-dumped the COMPILER on the second: `mk().b0.a0`. The local path
    // (`x.b0.a0`) went through the `while` loop in parse_primary and was fine,
    // so the difference was the recursion, not the field lookup: the recursive
    // re-entry re-entered the fn's own frame while the caller was still holding
    // a live `cur`, and the second link's `iremit` then indexed the IR array
    // with a stale record index.
    //
    // One loop handles any number of links with the caller's frame intact.
    while true {
        if !(peek()==TT_PNCT && pval()==46) { return cur }
        let csi = r64(vreg_struct + cur*8)
        if csi < 0 { return cur }
        adv()
        if !(peek()==TT_ID) { return cur }
        let mn = pval()
        let ml = plen()
        let fc = r64(sdefs + csi*64 + 16)
        let fb = r64(sdefs + csi*64 + 24)
        let fidx = -1
        let fj = 0
        while fj < fc {
            let fp = r64(sfldtab + (fb+fj)*16)
            let fl = r64(sfldtab + (fb+fj)*16 + 8)
            if fl == ml {
                let ok = 1
                let fk = 0
                while fk < ml { if r8(src+fp+fk) != r8(src+mn+fk) { ok = 0; break }; fk = fk+1 }
                if ok == 1 { fidx = fj; break }
            }
            fj = fj + 1
        }
        if fidx < 0 { return parse_method_call(cur, mn, ml) }
        adv()
        let fi = nv()
        iremit(IR_CONST, fi, fidx, 0, 0)
        // B2: tag a packed field's index vreg with displacement+1/width (see the
        // struct-constructor site for why this is vreg-keyed, not IR-keyed).
        if csi>=0 && csi<structc && r64(sdefs + csi*64 + 32)==1 {
            w64(vreg_poff + fi*8, r64(sfld_off + (csi*64+fidx)*8) + 8 + 1)
            w64(vreg_pw + fi*8, r64(sfld_size + (csi*64+fidx)*8))
        }
        if peek()==TT_OP && pval()==61 {
            adv()
            let v = parse_expr()
            iremit(IR_ISTORE, 0, cur, fi, v)
            return cur
        }
        let out = nv()
        iremit(32, out, cur, fi, 0)   // IR_IDX: 8-byte load at base+idx*8 (struct field)
        // Tag with the FIELD's own struct type so the next link resolves.
        let ftype = r64(sfldtyp + (fb+fidx)*8)
        if ftype >= 0 { w64(vreg_struct + out*8, ftype) }
        if ftype == 0-2 { w64(vreg_is_str + out*8, 1) }
        cur = out
    }
}

// parse_index_on(base_vr): consume one `[...]` postfix against a base VREG that has
// already been produced -- a name, an array literal, a call result, or the result
// of a previous index. Returns the result VREG so the caller can chain.
//
// This lowering used to be inline in parse_primary, where it resolved its base with
// vfind(nm,nl)/gfind(nm,nl) and then RETURNED after the first `[...]`. Both halves
// were wrong:
//
//  1. A base that is not a name -- an array literal, a call result, a parenthesised
//     expression -- had nothing to resolve, so `f(x)[0]` and `[1,2][0]` failed.
//  2. It returned after one index, so `n[1][0]` left the `[0]` in the token stream.
//
// (2) was harmless in a `let` and fatal as a CALL argument. parse_call_impl:101 then
// saw `[` where it expected `,` or `)`, and mpnct() is lenient -- parse.quanta:13
// returns 0 on a mismatch and every caller ignores the result. The argument count
// silently over-counted, the permutation at 139-146 read an arg_tgt slot that was
// never written, and that garbage index reached `ir + idx*IRS + field`. The
// multiply overflowed and the COMPILER's own checked-arithmetic trap fired:
//
//     print(n[1][0])        SIGILL while compiling
//     print(len(n[1][0]))   SIGILL while compiling
//     print([70,80][0])     SIGILL while compiling
//     print(g()[0])         SIGILL while compiling
//
// A caller-side mistake reported as an illegal instruction inside the compiler,
// with no diagnostic and no line number -- the worst possible failure shape,
// because the traceback points at the compiler and not at the code that caused it.
fn parse_index_on(base_vr) {
    if peek()==TT_PNCT&&pval()==91 {  // index: a[idx] OR slice: a[lo:hi] / a[:hi] / a[lo:]
        adv()  // consume '['
        let is_slice = 0
        let lo_vr = -1
        let hi_vr = -1
        let e0 = -1
        if peek()==TT_PNCT&&pval()==58 {
            // a[:hi] ? no lower bound (defaults to 0)
            is_slice = 1
            adv()  // consume ':'
            if !(peek()==TT_PNCT&&pval()==93) { hi_vr = parse_expr() }
        } else {
            e0 = parse_expr()
            if peek()==TT_PNCT&&pval()==58 {
                is_slice = 1
                lo_vr = e0
                adv()  // consume ':'
                if !(peek()==TT_PNCT&&pval()==93) { hi_vr = parse_expr() }
            }
        }
        if is_slice==1 {
            mpnct(93)  // ']'
            let sstr = r64(vreg_is_str + base_vr*8)
            if sstr>=0 {
                let mn = "error: slice of string not supported (arrays only)\n"
                file_write(2, mn+8, len(mn)); exit(1)
            }
            // Slice lowering (pure IR ? works on x86 AND ARM64):
            //   lo = max(lo, 0);  hi = min(hi, len);  n = max(0, hi - lo)
            //   dst = TALLOC(n);  loop idx in 0..n: dst[idx] = base[lo+idx]
            // BOTH ends are clamped, so every index the loop makes is in range
            // and the IR_IDX bounds trap cannot fire.
            let zero=nv(); iremit(IR_CONST,zero,0,0,0)
            let len_vr=nv(); iremit(IR_ARRAY_LEN, len_vr, base_vr, 0, 0)
            let lo = lo_vr
            if lo<0 { lo = zero }
            let hi = hi_vr
            if hi<0 { hi = len_vr }
            // Clamp BOTH ends against the real length:
            //   lo   -> 0        (already done above)
            //   hi   -> len      <-- was MISSING; hi > len walked off the end
            //   n    -> max(0, hi-lo)
            //
            // Python, Rust and Go all clamp the high bound, so `b[0:99]` on a
            // 5-element array is the whole array rather than a trap. Without the
            // hi clamp the copy loop ran `n` iterations reading base[lo+idx],
            // the IR_IDX bounds trap fired once lo+idx reached len, and the
            // whole program died with SIGILL -- for what is an entirely ordinary
            // slice expression.
            //
            // A NEGATIVE lo also has to clamp: `b[-2:]` means the last two
            // elements in Python, but this language has no negative indexing, so
            // a negative bound is 0 (the same choice the existing `if lo<0` makes
            // for the omitted-bound sentinel).
            let oc=nv(); iremit(IR_LT, oc, hi, len_vr, 0)    // 1 = hi < len
            let one=nv(); iremit(IR_CONST, one, 1, 0, 0)
            let om=nv(); iremit(IR_SUB, om, one, oc, 0)      // 1 = hi >= len
            let t1=nv(); iremit(IR_MUL, t1, hi, oc, 0)       // hi*oc
            let t2=nv(); iremit(IR_MUL, t2, len_vr, om, 0)    // len*om
            let hic=nv(); iremit(IR_ADD, hic, t1, t2, 0)     // min(hi, len)
            let nraw=nv(); iremit(IR_SUB, nraw, hic, lo, 0)
            let neg=nv(); iremit(IR_LT, neg, nraw, zero, 0)
            let n=nv(); iremit(IR_MOV, n, nraw, 0, 0)
            let lafter=nl()
            iremit(IR_BR,0,neg,lafter,0)   // neg==0 (nraw>=0) -> skip clamp
            iremit(IR_MOV,n,zero,0,0)      // neg==1 -> n = 0 (empty slice)
            iremit(IR_LABEL,0,lafter,0,0)
            let dst=nv(); iremit(IR_ARRNEW, dst, n, 0, 0)   // runtime-count alloc
            let cond=nl(); let body=nl(); let end=nl()
            let idx_vr=nv(); iremit(IR_MOV, idx_vr, zero, 0, 0)
            iremit(IR_JMP,0,cond,0,0)
            iremit(IR_LABEL,0,cond,0,0)
            let cmp=nv(); iremit(IR_LT, cmp, idx_vr, n, 0)
            iremit(IR_BR,0,cmp,end,body)   // idx>=n -> end, else body
            iremit(IR_LABEL,0,body,0,0)
            let sio=nv(); iremit(IR_ADD, sio, lo, idx_vr, 0)
            let val=nv(); iremit(32, val, base_vr, sio, 0)   // base[lo+idx]
            iremit(IR_ISTORE,0,dst,idx_vr,val)               // dst[idx]=val
            let one=nv(); iremit(IR_CONST, one, 1, 0, 0)
            let nidx=nv(); iremit(IR_ADD, nidx, idx_vr, one, 0)
            let idx2=nv(); iremit(IR_MOV, idx2, nidx, 0, 0)
            iremit(IR_MOV, idx_vr, idx2, 0, 0)
            iremit(IR_JMP,0,cond,0,0)
            iremit(IR_LABEL,0,end,0,0)
            return dst
        }
        mpnct(93)
        let vr=nv(); iremit(32,vr,base_vr,e0,0)
        // 0.0.247: an element of a TYPED FLOAT BUFFER is loaded in that format,
        // so it is tagged here -- at parse time -- and arithmetic on it routes
        // to the f32 builtins. codegen's IR_IDX emits the matching width.
        let efw = r64(vreg_ewidth + base_vr*8)
        if efw==4 { w64(vreg_ftype + vr*8, 1) }
        else if efw==2 { w64(vreg_ftype + vr*8, 2) }
        return vr
    }
}


fn parse_primary() {
    // 0.0.246: a reserved-keyword token that names a BOUND parameter or local is
    // that variable, not a keyword.
    //
    // The signature scan now records parameters whose name lexes as a keyword
    // (is_param_name_tok, helpers.quanta), but the BODY reference still arrives
    // here as e.g. TT_AS or TT_TYPE -- parse_primary has no atom branch for
    // those tokens, so `as` silently compiled to 0 and `type` desynchronised the
    // parser into SIGILL (rc=132). Rewrite the token's TYPE to TT_ID in place and
    // fall through, so the existing identifier path (vfind / gfind / fn-value /
    // field-index-method postfix) handles it exactly as a plain name. Rewriting a
    // token in place is what funcscan already does to reshape `fn` signatures
    // (funcscan.quanta, the modifier-zeroing block), so it is the established
    // mechanism here.
    //
    // The guard is `vfind(...) >= 0`, so a keyword token that is NOT a bound name
    // is left untouched and every existing keyword path is unaffected: `x as i64`
    // (parse_as consumes `as` after the left operand), `for i in r`
    // (parse.quanta's for-in check runs before parse_primary), and `type X = i64`
    // (the statement dispatcher runs parse_type before any expression parse).
    {
        let ntk0 = peek()
        if ntk0==TT_AS || ntk0==TT_TYPE || ntk0==TT_IMPL || ntk0==TT_IN {
            if vfind(pval(), plen()) >= 0 { w64(toks + tokp*TKS, TT_ID) }
        }
    }
    if peek()==TT_ASM {  // P11: inline asm: asm!("hex bytes") ? raw machine code
        adv()  // consume 'asm'
        if !(peek()==TT_OP && pval()==33) {
            let mn = "error: expected '!' after asm\n"; file_write(2, mn+8, len(mn)); exit(1)
        }
        adv()  // consume '!'
        if !(peek()==TT_PNCT && pval()==40) {
            let mn = "error: expected '(' after asm!\n"; file_write(2, mn+8, len(mn)); exit(1)
        }
        adv()  // consume '('
        if peek()!=TT_STR {
            let mn = "error: expected string template in asm!\n"; file_write(2, mn+8, len(mn)); exit(1)
        }
        let sv=pval(); adv()  // string source offset (opening quote)
        // 0.0.232 Phase C2: optional operand chain after the template:
        //   asm!("tpl" : "c"(expr), "c"(expr) : "c"(expr) : "memory", "cc")
        // Groups in order: outputs, inputs, clobbers. Operand vregs are parsed
        // AFTER the template (their expressions may reference earlier locals).
        let vr=nv()
        let blk = 0
        let has_ops = 0
        if peek()==TT_PNCT && pval()==58 {   // ':'
            has_ops = 1
            // block layout: [0]=count [1]=clobbers then 3 slots per operand
            blk = mem_alloc((2 + ASM_MAX_OPS*4) * 8)
            w64(blk+0, 0); w64(blk+8, 0)
            let group = 0    // 0=outputs 1=inputs 2=clobbers
            adv()            // consume ':'
            let done = 0
            while done == 0 {
                if group < 2 {
                    // operand: "constraint" ( expr )
                    if peek()!=TT_STR {
                        let mn = "error: expected constraint string in asm! operands\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                    let cso = pval(); adv()
                    // The string token's value is the offset of the OPENING
                    // quote; the raw source continues to the closing quote.
                    // Constraint text = between the quotes.
                    let cso = cso + 1
                    let csl = 0
                    while r8(src+cso+csl)!=34 { csl = csl + 1 }
                    // constraint -> code
                    let cc = 0-1
                    if csl==1 && r8(src+cso)=='r' { cc = ASM_C_R }
                    else if csl==2 && r8(src+cso)=='=' && r8(src+cso+1)=='r' { cc = ASM_C_WR }
                    else if csl==2 && r8(src+cso)=='+' && r8(src+cso+1)=='r' { cc = ASM_C_RW }
                    else if csl==1 && r8(src+cso)=='m' { cc = ASM_C_M }
                    else if csl==1 && r8(src+cso)=='i' { cc = ASM_C_I }
                    if cc < 0 {
                        let mn = "error: unsupported asm! constraint (supported: r, =r, +r, m, i)\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                    if !(peek()==TT_PNCT && pval()==40) {
                        let mn = "error: expected '(' after asm! constraint\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                    adv()
                    // role: outputs are 0 (first group), inputs 1
                    let role = group
                    let ov = parse_expr()
                    if !(peek()==TT_PNCT && pval()==41) {
                        let mn = "error: expected ')' after asm! operand\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                    adv()
                    let n = r64(blk+0)
                    if n >= ASM_MAX_OPS {
                        let mn = "error: too many asm! operands (max 8)\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                    // "i" operands: capture the value AT PARSE TIME. At emit time
                    // the defining IR_CONST may be gone (opt folds it), and an
                    // emit-time scan returns 0 — the B2 lesson again.
                    let immv = 0
                    if cc == ASM_C_I {
                        // Inline scan for the defining IR_CONST. def_is_constval
                        // (codegen.quanta) returned -1 here even though the CONST
                        // exists — do not trust it at parse time; scan directly.
                        let kk = irc - 1
                        while kk >= 0 {
                            if irres(kk) == ov {
                                if irop(kk) == IR_CONST { immv = ira0(kk) }
                                else if irop(kk) == IR_MOV { ov = ira0(kk); kk = irc }
                                else { kk = 0-1 }
                            }
                            kk = kk - 1
                        }
                    }
                    w64(blk + 16 + n*32, ov)
                    w64(blk + 16 + n*32 + 8, cc)
                    w64(blk + 16 + n*32 + 16, role)
                    w64(blk + 16 + n*32 + 24, immv)
                    w64(blk+0, n+1)
                    w64(vreg_asmop + ov*8, blk)   // tag the operand vreg too (codegen reads via output vreg)
                } else {
                    // clobber: "memory" | "cc"
                    if peek()!=TT_STR {
                        let mn = "error: expected clobber string in asm!\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                    let cso = pval() + 1; adv()
                    let csl = 0
                    while r8(src+cso+csl)!=34 { csl = csl + 1 }
                    if csl==6 && r8(src+cso)=='m' && r8(src+cso+1)=='e' && r8(src+cso+2)=='m' && r8(src+cso+3)=='o' && r8(src+cso+4)=='r' && r8(src+cso+5)=='y' {
                        w64(blk+8, r64(blk+8) | 2)
                    } else if csl==2 && r8(src+cso)=='c' && r8(src+cso+1)=='c' {
                        w64(blk+8, r64(blk+8) | 4)
                    } else {
                        let mn = "error: unsupported asm! clobber (supported: memory, cc)\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                }
                // next: ',' same group, or ':' next group, or ')'
                if peek()==TT_PNCT && pval()==44 { adv(); continue }
                if peek()==TT_PNCT && pval()==58 {
                    adv()
                    group = group + 1
                    if group > 2 {
                        let mn = "error: too many asm! operand groups (max 3)\n"; file_write(2, mn+8, len(mn)); exit(1)
                    }
                    continue
                }
                done = 1
            }
        }
        if !(peek()==TT_PNCT && pval()==41) {
            let mn = "error: expected ')' in asm!\n"; file_write(2, mn+8, len(mn)); exit(1)
        }
        adv()  // consume ')'
        iremit(IR_ASM, vr, sv, 0, 0)
        if has_ops == 1 { w64(vreg_asmop + vr*8, blk) }
        return vr
    }
    if peek()==TT_MATCH { return parse_match() }   // P6.1b: match in expression position
    // HANG FIX (g6 class): `Some`/`None`/`Ok`/`Err` are valid expression
    // primaries (Option/Result variants). Handle them HERE, up front, advancing
    // tokp so the caller always makes progress. The TT_ID branch below also
    // handles them, but only after the struct/enum/scope machinery; if any of
    // that machinery returns without advancing (e.g. a variant reached in a
    // context where the surrounding statement parser re-invokes parse_unary),
    // the token cursor would never move and the compiler would emit unbounded
    // IR (rc=17). Handling them up front makes `return None` / `x = Ok(v)`
    // always terminate.
    if peek()==TT_ID {
        let hk = ktext(pval(), plen())
        if hk==H_SOME {
            adv()
            // A1b: `a` is the payload vreg (or -1 for a bare Some). Both arms
            // used to `let a`, which only worked because a block's bindings were
            // never popped -- the arm's binding leaked out and the use below
            // resolved to it. Declare it at the arm's own level instead; the
            // value is identical (-1, or the parsed expression's value).
            let a = -1
            if peek()==TT_PNCT && pval()==40 { adv(); a=parse_expr(); mpnct(41) }
            let vr=nv(); iremit(IR_SOME, vr, a, 0, 0); w64(vreg_enum+vr*8,-2); w64(vreg_enum_var+vr*8,1); return vr
        } else if hk==H_NONE {
            adv(); let vr=nv(); iremit(IR_NONE, vr, 0, 0, 0); w64(vreg_enum+vr*8,-2); w64(vreg_enum_var+vr*8,0); return vr
        } else if hk==H_OK {
            adv()
            let a = -1
            if peek()==TT_PNCT && pval()==40 { adv(); a=parse_expr(); mpnct(41) }
            let vr=nv(); iremit(IR_OK, vr, a, 0, 0); w64(vreg_enum+vr*8,-3); w64(vreg_enum_var+vr*8,1); return vr
        } else if hk==H_ERR {
            adv()
            let a = -1
            if peek()==TT_PNCT && pval()==40 { adv(); a=parse_expr(); mpnct(41) }
            let vr=nv(); iremit(IR_ERR, vr, a, 0, 0); w64(vreg_enum+vr*8,-3); w64(vreg_enum_var+vr*8,0); return vr
        }
    }
    if peek()==TT_NUM { let v=pval(); adv(); let vr=nv(); iremit(IR_CONST,vr,v,0,0); return parse_postfix_expr(vr) }
    if peek()==TT_BIGNUM {
        // Over-sized decimal literal: build a runtime string from the digit text
        // held in src[val..val+len], then lower to big_from_dec(string).
        let soff = pval(); let dlen = plen(); adv()
        // runtime string "digits" written at srclen
        let base = srclen
        w8(src+base, 34)                                   // opening quote
        let di = 0
        while di < dlen { w8(src+base+1+di, r8(src+soff+di)); di = di + 1 }
        w8(src+base+1+dlen, 34)                            // closing quote
        srclen = base + 2 + dlen
        let svr = nv(); iremit(IR_STR, svr, base, 0, 0); w64(vreg_is_str + svr*8, 1)
        // callee name "big_from_dec" written at srclen
        let nmoff = srclen
        w8(src+nmoff+0, 98); w8(src+nmoff+1,105); w8(src+nmoff+2,103); w8(src+nmoff+3,95)   // "big_"
        w8(src+nmoff+4,102); w8(src+nmoff+5,114); w8(src+nmoff+6,111); w8(src+nmoff+7,109)  // "from"
        w8(src+nmoff+8, 95); w8(src+nmoff+9,100); w8(src+nmoff+10,101); w8(src+nmoff+11,99)  // "_dec"
        w8(src+nmoff+12, 0)                                // "big_from_dec\0"
        srclen = nmoff + 13
        // Register the callee in the global call table (imported from std/big).
        let fi = resolve_fn(nmoff, 12, FI_GLOBAL)
        // When std/big was not imported the old code reported
        //     error: call to undeclared function: big_from_dec
        // naming an internal symbol the user never wrote, and located it at the
        // synthesized name (nmoff) -- which lies PAST the end of the user's own
        // source, so a 106-line file reported "line 383". Report at the user's
        // own literal instead and name the import that fixes it.
        if fi < 0 { compile_error(7, soff, dlen) }
        // 0.0.114 FIX: emit the argument as an IR_MOV record and pass its IR
        // index as a2 (the convention codegen's IR_CALL arg-loader expects:
        // it reads irres(a2+i)). The old argstack-index convention made codegen
        // read an unrelated IR record's vreg -> garbage pointer -> SIGSEGV on
        // every big literal after the first.
        let cavs = irc
        let mv = nv(); iremit(IR_MOV, mv, svr, 0, 0)
        let bvr = nv(); iremit(IR_CALL, bvr, nmoff, 1, cavs)
        w64(vreg_is_big + bvr*8, 1)   // 0.0.114: big literal result is a big
        return bvr
    }
    if peek()==TT_FNUM32 || peek()==TT_FNUM16 {
        // 0.0.247: a TYPED float literal. The suffix is no longer a discarded
        // no-op: `0.1f32` is the nearest BINARY32 to the decimal 0.1, computed
        // by an exact single rounding (fl_dexp2f32), and the f64 carrier holds
        // that f32 value exactly. Computed at parse time as an IR_FCONST so it
        // stays a compile-time constant, exactly like the f64 literal path.
        let ftk = peek()
        let exp10 = toke(tokp)
        let v=pval(); adv()
        let M = v >> 8
        let frac_digits = v & 255
        let cr = nv()
        if ftk==TT_FNUM32 {
            iremit(IR_FCONST, cr, fl_widen_f32(fl_dexp2f32(M, frac_digits, exp10)), 0, 0)
            w64(vreg_ftype + cr*8, 1)
        } else {
            iremit(IR_FCONST, cr, fl_widen_f16(fl_dexp2f16(M, frac_digits, exp10)), 0, 0)
            w64(vreg_ftype + cr*8, 2)
        }
        w8(vfloat + cr, 1)
        return cr
    }
    if peek()==TT_FNUM {
        // The exponent side word is read BEFORE adv(): tokp still points at the
        // float token, and adv() moves it to the next one. Reading afterwards
        // would pick up the following token's (always zero) side word and turn
        // every 1.0e3 into 1.0.
        let exp10 = toke(tokp)
        let v=pval(); adv()
        // Float value encoded by lexer as (M << 8) | frac_digits, with the SIGNED
        // decimal exponent in the token's side word.
        //
        // 0.0.221: the value is  M / 10^frac_digits * 10^fexp.
        //
        // Previously the exponent was folded into the mantissa by the lexer with
        // integer `val = val*10`, and 10^frac_digits was built here in i64. Both
        // overflow: 1.0e18 wrapped the mantissa to 0x8AC7230489E80000, and 1.0e-308
        // wanted 10^308 in an i64. Neither produced a diagnostic -- the compiler
        // died with SIGILL partway through codegen, so importing any module that
        // contained a large float literal silently emitted NO binary (exit 0, no
        // output file, no message).
        //
        // The exponent is now applied in FLOATING POINT by the emitter, so no
        // integer power of ten is ever formed. `scale` is still built in i64 but is
        // clamped: 10^k fits in i64 for k <= 18, and the lexer already guarantees
        // frac_digits <= 255, so the clamp is what keeps a pathological literal
        // from overflowing here.
        let M = v >> 8
        let frac_digits = v & 255
        // scale = 10^frac_digits, saturated rather than wrapped.
        //
        // The guard must be INT64_MAX/10 = 922337203685477580 (18 digits), NOT
        // 922337203685477 (15 digits). The shorter constant is smaller than
        // 10^15 = 1000000000000000, so from frac_digits==16 onward the loop
        // rejected the very value it had just built and substituted INT64_MAX:
        //     0.6931471805599453 -> M=6931471805599453 fd=16 scale=INT64_MAX
        //     6931471805599453 / 9223372036854775807 = 0.000751
        // which is precisely the value the compiler emitted for that literal.
        // Because ln2 appears as a literal in lib/std/gguf.quanta's gguf_exp,
        // the corruption propagated into every softmax in the tree.
        //
        // `scale` is no longer built or used. The literal's exact value is
        // (M / 10^frac_digits) * 10^exp10 == M * 10^(exp10 - frac_digits), which
        // is EXACTLY the (M, fd, fe) triple fl_dexp2f64 takes, so the saturated
        // power of ten was never needed for the value at all -- only for the old
        // runtime division, which is what this replaces.
        //
        // Emit the IEEE-754 bit pattern as a CONSTANT, computed at PARSE time.
        // That is the whole point: the literal is rounded exactly once,
        // correctly, instead of being rebuilt out of cvtsi2sd/divsd/mulsd at
        // run time where every step rounds and 24 of 41 test literals came out
        // 1-3 ULP wrong (1.0e308 came out one bit HIGH). That one corrupt
        // constant is what made gguf_exp's overflow guard hand back a stack
        // address instead of a float.
        //
        // vlit records that this constant is a LITERAL. vfloat cannot: aclr()
        // zeroes vfloat for every vreg after parsing, so the tag has to be
        // re-established by codegen.quanta's float re-mark pass -- and that pass
        // needs to know which constants are literals, which is exactly vlit.
        //
        // The opcode is IR_FCONST, not IR_CONST. A literal is a float, and the
        // opcode is how the emitter knows that without consulting any table:
        // aclr() clears vfloat for every vreg after parsing, so the re-mark pass
        // has to re-derive it, and a side table keyed by vreg or by record index
        // is wrong here. vreg numbers are reused across functions and record
        // indices are reused because irc is reset between compilation units --
        // either way a literal's mark lands on some other function's ordinary
        // integer constant, which then gets tagged float.
        //
        // Observed exactly that: scan_metadata()'s `meta_size` accumulated
        // correctly and came back as a float (4630263366890291200, not 8222757),
        // and gguf_load() then segfaulted on every run.
        //
        // The record says what it is. That cannot go stale.
        let cr = nv()
        iremit(IR_FCONST, cr, fl_dexp2f64(M, frac_digits, exp10), 0, 0)
        w8(vfloat + cr, 1)   // an f64 bit pattern IS a float vreg
        return cr
    }
    if peek()==TT_STR {
        let v=pval(); adv(); let vr=nv(); iremit(IR_STR,vr,v,0,0); w64(vreg_is_str + vr*8, 1)
        // Parse-time string interpolation. The lexer keeps the whole string
        // (incl. ${name}/$[name] text) as one literal token. Here we scan the
        // string bytes; if an interpolation is present we split into a str(...)
        // call whose literal segments are written as quote-framed strings at
        // srclen (safe at parse time, after lexing). Nested-if conditions only
        // (Quanta's && / || short-circuit is unreliable).
        let so=v+1; let slen=0
        while r8(src+so+slen)!=34 { slen=slen+1 }
        // detect any ${ident} / $[ident]
        let has_interp=0; let si=0
        while si<slen {
            let b=r8(src+so+si)
            if b==36 {
                if si+1<slen {
                    let b1=r8(src+so+si+1)
                    let isbr=0; if b1==123 { isbr=1 } else { if b1==91 { isbr=1 } }
                    if isbr==1 {
                        if si+2<slen {
                            if ialpha(r8(src+so+si+2)) { has_interp=1; si=slen }
                        }
                    }
                }
            }
            if has_interp==0 { si=si+1 }
        }
        if has_interp==0 { return vr }
        // Build the interpolation as a chain of binary str() calls (identical
        // to the proven `..` desugar). We walk segments left-to-right, keeping
        // an accumulator `acc` and combining each new segment via build_str().
        // No arrays / mmap needed. Scan conditions use nested-if only.
        let acc=0; let have_acc=0
        let seg_start=0; let i=0
        while i<=slen {
            let atend=0; if i==slen { atend=1 }
            let isref=0
            if atend==0 {
                if r8(src+so+i)==36 {
                    if i+1<slen {
                        let b1=r8(src+so+i+1)
                        let isbr=0; if b1==123 { isbr=1 } else { if b1==91 { isbr=1 } }
                        if isbr==1 { isref=1 }
                    }
                }
            }
            if atend==1 { isref=0 }
            if isref==1 {
                // flush literal [seg_start, i) first (it precedes the ref)
                if i>seg_start {
                    let seglen=i-seg_start
                    let ls=srclen
                    w8(src+ls,34); let k=0; while k<seglen { w8(src+ls+1+k, r8(src+so+seg_start+k)); k=k+1 }
                    w8(src+ls+1+seglen,34); w8(src+ls+2+seglen,0)
                    srclen=ls+2+seglen+1
                    let lv=nv(); iremit(IR_STR,lv,ls,0,0); w64(vreg_is_str+lv*8,1)
                    if have_acc==0 { acc=lv; have_acc=1 } else { acc=build_str(acc, lv) }
                }
                // resolve the ref
                let ob=r8(src+so+i+1); let cb=125; if ob==91 { cb=93 }
                let ns=i+2; let ne=ns
                let nep=0
                while nep==0 { if ne>=slen { nep=1 } else { if r8(src+so+ne)==cb { nep=1 } else { ne=ne+1 } } }
                let nm=so+ns; let nl2=ne-ns
                let sv=0
                if ob==123 {
                    let g=gfind(nm,nl2)
                    if g>=0 { sv=nv(); iremit(IR_LOADG,sv,g,0,0); w64(vreg_is_str+sv*8,1) } else { compile_error(1, nm, nl2); return 0 }
                } else {
                    let f=vfind(nm,nl2)
                    if f>=0 { sv=f } else { compile_error(1, nm, nl2); return 0 }
                }
                if have_acc==0 { acc=sv; have_acc=1 } else { acc=build_str(acc, sv) }
                i=ne+1; seg_start=i
            } else { i=i+1 }
        }
        // trailing literal [seg_start, slen)
        if seg_start<slen {
            let seglen=slen-seg_start
            let ls=srclen
            w8(src+ls,34); let k=0; while k<seglen { w8(src+ls+1+k, r8(src+so+seg_start+k)); k=k+1 }
            w8(src+ls+1+seglen,34); w8(src+ls+2+seglen,0)
            srclen=ls+2+seglen+1
            let lv=nv(); iremit(IR_STR,lv,ls,0,0); w64(vreg_is_str+lv*8,1)
            if have_acc==0 { acc=lv; have_acc=1 } else { acc=build_str(acc, lv) }
        }
        return acc
    }
    // ${name}: read-only GLOBAL reference. Resolves to a `global name`
    // declaration via gfind(); no such global -> compile error.
    if peek()==TT_DOLLAR {
        let nm=pval(); let nl=plen(); adv()
        let g=gfind(nm,nl)
        if g>=0 { let vr=nv(); iremit(IR_LOADG,vr,g,0,0); w64(vreg_is_str+vr*8,1); return vr }
        // undeclared global reference: report the token's source position.
        compile_error(1, nm, nl)
        return 0
    }
    // $[name]: read-only LOCAL handle. Resolves to the current function's local
    // via vfind(); no such local -> compile error.
    if peek()==TT_LOCAL {
        let nm=pval(); let nl=plen(); adv()
        let f=vfind(nm,nl)
        if f>=0 { w64(vreg_is_str+f*8,1); return f }
        compile_error(1, nm, nl)
        return 0
    }
    // P11: closure literal: |param1,param2,...| { expr }
    // Creates a [codeptr, env] tuple (same layout as IR_FNVAL/mk_any)
    // that can be called via IR_CLOSURE_CALL. Captures free variables
    // from the enclosing scope. Uses explicit braces so the main loop
    // parses the body like a normal function.
    // Precise lookahead: '|' followed by (ID or '|') and later '{'
    if peek()==TT_OP && pval()==124 {
        // Lookahead: find closing '|' then '{' - if both present, it's a closure
        let look = tokp + 1
        let is_closure = 0
        let found_pipe = 0
        let found_brace = 0
        if look < tokc {
            // Skip to first non-whitespace after opening '|'
            while look < tokc {
                let t = tokt(look)
                let v = tokv(look)
                if t == TT_ID || (t == TT_OP && v == 124) { found_pipe = 1; break }
                if t == TT_PNCT && v == 123 { found_brace = 1; found_pipe = 1; break }
                look = look + 1
                if look >= tokc { break }
            }
        }
        if found_pipe == 1 { is_closure = 1 }
        if is_closure == 1 {
            // Register closure body as a synthetic function
            // The MAIN LOOP will compile the body when it reaches this fn index
            let encl_fn = cur_fi
            let body_tok = tokp  // points to opening '|', parser will advance past syntax
            let cidx = reg_closure(encl_fn, body_tok)
            
            // Parse parameter list: |x,y,z|
            adv()  // consume opening '|'
            let paramc = 0
            let pnbase = fn_poff
            if peek()!=TT_OP || pval()!=124 {  // not |...| empty
                let pn=pval(); let pl=plen()
                if pl>0 { 
                    let pvr = nv()
                    // Store in fn_pnames like scanner does (for main loop)
                    w64(fn_pnames + fn_poff, pn); fn_poff = fn_poff + 8
                    w64(fn_pnames + fn_poff, pl); fn_poff = fn_poff + 8
                    vadd(pn, pl, pvr)  // also add to local vars for parser scope
                    paramc=paramc+1
                }
                adv()
                while peek()==TT_PNCT && pval()==44 {
                    adv()
                    let pn2=pval(); let pl2=plen()
                    if pl2>0 { 
                        let pvr2 = nv()
                        w64(fn_pnames + fn_poff, pn2); fn_poff = fn_poff + 8
                        w64(fn_pnames + fn_poff, pl2); fn_poff = fn_poff + 8
                        vadd(pn2, pl2, pvr2)
                        paramc=paramc+1
                    }
                    adv()
                }
            }
            // consume closing '|' (TT_OP value 124)
            if !(peek()==TT_OP && pval()==124) {
                let mn = "error: expected '|' after closure params\\n"
                file_write(2, mn+8, len(mn)); exit(1)
            }
            adv()
            // Expect opening '{' for closure body (like a normal function)
            if !(peek()==TT_PNCT && pval()==123) {
                let mn = "error: expected '{' after closure params\\n"
                file_write(2, mn+8, len(mn)); exit(1)
            }
            // Record body_tok as the '{' position for main loop
            let body_start = tokp
            // Skip body { ... } with brace tracking
            let brace_depth = 0
            while 1 {
                let t = peek()
                if t == TT_PNCT && pval() == 123 { brace_depth = brace_depth + 1 }
                else if t == TT_PNCT && pval() == 125 { 
                    brace_depth = brace_depth - 1
                    if brace_depth == 0 { adv(); break }
                }
                if t < 0 { break }
                adv()
            }
            
            // Store param count, base, and body_tok for main loop
            w64(fn_pcount + cidx*8, paramc)
            w64(fn_pbase + cidx*8, pnbase)
            w64(fns + cidx*FNS + 16, body_start)  // body_tok = '{' position
            w64(fns + cidx*FNS + 32, paramc)      // param_c

            // P11 (0.0.67): DISCOVER CAPTURES NOW, before emitting IR_CLOSURE.
            // The env array's size and contents must be known at construction
            // time, but the body is not parsed until its own turn in the main
            // compile loop -- by which point this IR_CLOSURE is already emitted
            // and the enclosing scope is gone. So scan the body's tokens here,
            // while the enclosing `vars` table is still live: any identifier that
            // is a local of THIS scope, is not one of the closure's own params,
            // and is not a known function, becomes a capture.
            let ci2 = body_start + 1
            while ci2 < tokp {
                if tokt(ci2)==TT_ID {
                    let inm = tokv(ci2); let inl = tokln(ci2)
                    // skip `name(` -- a call, not a captured value
                    let is_call = 0
                    if ci2+1 < tokp { if tokt(ci2+1)==TT_PNCT && tokv(ci2+1)==40 { is_call = 1 } }
                    // skip `.name` -- a field/method, not a free variable
                    let is_field = 0
                    if ci2 > 0 { if tokt(ci2-1)==TT_PNCT && tokv(ci2-1)==46 { is_field = 1 } }
                    if is_call==0 && is_field==0 {
                        // Is it one of the closure's own params? Those are bound
                        // in the local scope right now (vadd'd above).
                        let own = 0
                        let pk = 0
                        while pk < paramc {
                            let pn3 = r64(fn_pnames + pnbase + pk*16)
                            let pl3 = r64(fn_pnames + pnbase + pk*16 + 8)
                            if pl3==inl {
                                let ok3=1; let j3=0
                                while j3<inl { if r8(src+pn3+j3)!=r8(src+inm+j3) { ok3=0; break }; j3=j3+1 }
                                if ok3==1 { own = 1; break }
                            }
                            pk = pk + 1
                        }
                        if own == 0 {
                            // A local of the ENCLOSING scope -> capture by value.
                            let ov2 = vfind(inm, inl)
                            if ov2 >= 0 { cap_add(cidx, inm, inl, ov2) }
                        }
                    }
                }
                ci2 = ci2 + 1
            }

            // Emit IR_CLOSURE in enclosing function's IR: a0 = closure fn index
            let vr = nv()
            iremit(IR_CLOSURE, vr, cidx, 0, 0)
            w64(vreg_clo + vr*8, cidx)   // 0.0.121: tag so escape check can find captures
            return vr
        }
    }
    // 0.0.123: named-closure literal. `fn NAME(params){body}` at EXPRESSION
    // position is a closure value named NAME. Distinct from the statement-level
    // `fn` definition (funcscan, statement start) and the fn-less SIMPLE-SURFACE
    // shorthand (column-0 only). GUARD: only fire when `fn` is in VALUE position
    // (preceded by `=`/`(`/`,`/operator/keyword like `return`), never at a
    // statement start (`{`/`}`/`;`/tokp==0) -- so it cannot be mistaken for a
    // top-level or nested definition, and cannot fire during a tokp=0 pre-pass.
    if peek()==TT_KEY && ktext(pval(),plen())==1 {
        let is_value_pos = 0
        if tokp > 0 {
            let pt = tokt(tokp-1); let pv = tokv(tokp-1)
            if pt==TT_PNCT && (pv==123 || pv==125 || pv==59) { is_value_pos = 0 }
            else { is_value_pos = 1 }
        }
        if is_value_pos==1 {
        // need: fn KEYWORD, then ID name, then '('
        let nx = tokp + 1
        if nx<tokc && tokt(nx)==TT_ID && nx+1<tokc && tokt(nx+1)==TT_PNCT && tokv(nx+1)==40 {
            let nm = tokv(nx); let nl = tokln(nx)
            let encl_fn = cur_fi
            let cidx = reg_closure(encl_fn, tokp)
            // 0.0.131: remember the closure's self-name so the body can bind it as a
            // self-reference (enables self-recursion by name).
            w64(clo_selfnm + cidx*8, nm); w64(clo_selfnl + cidx*8, nl)
            // advance past `fn NAME(`
            adv(); adv(); adv()
            // parse param list: bind each param into the local scope + fn_pnames
            // (mirrors the lambda path so the main loop sees them as locals).
            let paramc = 0
            let pnbase = fn_poff
            let depth = 1
            while tokp<tokc && depth>0 {
                let tk = peek(); let tv = pval()
                if tk==TT_PNCT && tv==40 { depth=depth+1; adv(); continue }
                else if tk==TT_PNCT && tv==41 { depth=depth-1; if depth==0 { adv(); break } }
                else if tk==TT_PNCT && tv==44 && depth==1 {
                    // comma between params: bind the preceding param name
                    adv(); continue
                }
                // a param name (ID) at depth 1
                if depth==1 && tk==TT_ID {
                    let pn = pval(); let pl = plen()
                    if pl>0 {
                        let pvr = nv()
                        w64(fn_pnames + fn_poff, pn); fn_poff = fn_poff + 8
                        w64(fn_pnames + fn_poff, pl); fn_poff = fn_poff + 8
                        vadd(pn, pl, pvr)
                        paramc=paramc+1
                    }
                }
                adv()
            }
            // optional `:TYPE` return annotation -- skip until '{'
            if peek()==TT_PNCT && pval()==58 {
                adv()
                while tokp<tokc && !(peek()==TT_PNCT && pval()==123) { adv() }
            }
            if !(peek()==TT_PNCT && pval()==123) {
                let mn = "error: expected '{' after named-closure signature\n"
                file_write(2, mn+8, len(mn)); exit(1)
            }
            // Record body_tok as the '{' position for the main loop, and skip body.
            let body_start = tokp
            let brace_depth = 0
            while 1 {
                let t = peek()
                if t == TT_PNCT && pval() == 123 { brace_depth = brace_depth + 1 }
                else if t == TT_PNCT && pval() == 125 {
                    brace_depth = brace_depth - 1
                    if brace_depth == 0 { adv(); break }
                }
                if t < 0 { break }
                adv()
            }
            w64(fn_pcount + cidx*8, paramc)
            w64(fn_pbase + cidx*8, pnbase)
            w64(fns + cidx*FNS + 16, body_start)
            w64(fns + cidx*FNS + 32, paramc)
            // Discover captures from the body (mirrors lambda path).
            let ci2 = body_start + 1
            while ci2 < tokp {
                if tokt(ci2)==TT_ID {
                    let inm = tokv(ci2); let inl = tokln(ci2)
                    let is_call = 0
                    if ci2+1 < tokp { if tokt(ci2+1)==TT_PNCT && tokv(ci2+1)==40 { is_call = 1 } }
                    let is_field = 0
                    if ci2 > 0 { if tokt(ci2-1)==TT_PNCT && tokv(ci2-1)==46 { is_field = 1 } }
                    if is_call==0 && is_field==0 {
                        let own = 0
                        let pk = 0
                        while pk < paramc {
                            let pn3 = r64(fn_pnames + pnbase + pk*16)
                            let pl3 = r64(fn_pnames + pnbase + pk*16 + 8)
                            if pl3==inl {
                                let ok3=1; let j3=0
                                while j3<inl { if r8(src+pn3+j3)!=r8(src+inm+j3) { ok3=0; break }; j3=j3+1 }
                                if ok3==1 { own = 1; break }
                            }
                            pk = pk + 1
                        }
                        if own == 0 {
                            let ov2 = vfind(inm, inl)
                            if ov2 >= 0 { cap_add(cidx, inm, inl, ov2) }
                        }
                    }
                }
                ci2 = ci2 + 1
            }
            // Emit the closure tuple ONCE into vr (codeptr + env). Then make the
            // closure's OWN name available (a) as a real enclosing-scope local
            // (type 11, like `let f = fn..{}` does) so vr is materialized into a
            // home slot, and (b) as a CAPTURE of that home slot so the body can
            // read it and self-call by name (routes through IR_CLOSURE_CALL).
            // (a) is required: without a real local binding vr's home is never
            // written, so the by-ref capture reads garbage and the self-call jumps
            // to a bad address.
            let vr = nv()
            iremit(IR_CLOSURE, vr, cidx, 0, 0)
            w64(vreg_clo + vr*8, cidx)
            vadd(nm, nl, vr)
            w64(vreg_type + vr*8, 11)
            cap_add(cidx, nm, nl, vr)
            let bi = varc - 1
            w64(vars + bi*VRS + 8, vr)
            w64(vreg_type + vr*8, 11)
            return vr
        }
        }
    }
    // P10: array literal [ ... ] or [TYPE](), and the brace form { a, b, c }.
    //
    // Only the bracket form was parsed. A brace literal in EXPRESSION position --
    // `let s: i64[2] = { 2, 3 }` -- fell through to the default case and died with
    // "unexpected token in expression", which is why every test function in
    // lib/std/ai.quanta failed to compile and why ai.quanta took the compiler
    // down with it.
    //
    // This is deliberately reached ONLY from a '{' in expression position, which
    // is always an initialiser here. A struct body `struct P { x: i64 }` is
    // consumed by scanstructs from the token array before parse_primary runs, so
    // adding this gate does not touch struct declarations.
    // A '{' here is a brace LITERAL only if it is not a block delimiter. Blocks
    // are routed by the statement parser before parse_primary runs, except for
    // one case that matters: `match x { ... }` asks parse_expr for the scrutinee
    // and then claims the '{' itself, so if the scrutinee is just a name the '{'
    // must still be left for parse_match.
    //
    // A brace literal never contains '=>' -- match arms always do. So require the
    // contents to the first matching '}' to be free of '=>'; if one is there this
    // is a match body and is left alone.
    //
    // Without this, `match x { 1 => { return 42 } }` compiled to a literal and the
    // function returned 0 instead of taking the arm.
    if peek()==TT_PNCT&&pval()==123 {
        let isarm = 0
        let s2 = tokp
        let k2 = 0
        while k2 < 96 && s2 < tokc {
            if tokt(s2)==TT_OP && tokv(s2)==(61*256+62) { isarm = 1; s2 = tokc }   // '=>'
            s2 = s2 + 1
            k2 = k2 + 1
        }
        if isarm == 0 {
            adv()
            let belems=mmap(8000)   // stash element vregs
            let bcnt=0
            if !(peek()==TT_PNCT && pval()==125) {   // non-empty literal
                let be0=parse_expr(); w64(belems+bcnt*8, be0); bcnt=bcnt+1
                while peek()==TT_PNCT&&pval()==44 {
                    adv()
                    // Same trailing-comma guard as the bracket literal below:
                    // `}` ends the list, so `,}` must not add a phantom element.
                    if peek()==TT_PNCT && pval()==125 { break }
                    let be=parse_expr(); w64(belems+bcnt*8, be); bcnt=bcnt+1
                }
            }
            if peek()==TT_PNCT && pval()==125 { adv() }   // '}'
            let btr=nv(); iremit(IR_TALLOC,btr,bcnt,0,0)
            let bci=0
            while bci<bcnt {
                let bev=r64(belems+bci*8); let bfi=nv(); iremit(IR_CONST,bfi,bci,0,0)
                iremit(IR_ISTORE,0,btr,bfi,bev)
                bci=bci+1
            }
            return btr
        }
    }
    if peek()==TT_PNCT&&pval()==91 {
        if tokp+3<tokc && tokt(tokp)==TT_PNCT && tokv(tokp)==91 && tokt(tokp+1)==TT_ID && tokt(tokp+2)==TT_PNCT && tokv(tokp+2)==93 && tokt(tokp+3)==TT_PNCT && tokv(tokp+3)==40 && tokp+4<tokc && tokt(tokp+4)==TT_PNCT && tokv(tokp+4)==41 {
            adv(); adv(); adv(); adv(); adv()  // consume [ TYPE ] ( )
            let tr0=nv(); iremit(IR_TALLOC,tr0,0,0,0); return tr0
        }
        adv()
        let elems=mmap(8000)   // stash element vregs
        let cnt=0
        if peek()!=TT_PNCT || pval()!=93 {  // non-empty literal
            let e0=parse_expr(); w64(elems+cnt*8, e0); cnt=cnt+1
            // A trailing comma must NOT add a phantom element. `["a","b",]` has 2
            // elements, but the loop used to call parse_expr() unconditionally
            // after the comma, which parsed the `]` itself and counted it -- so
            // len() reported one too many and indexing the phantom slot read past
            // the allocation and segfaulted. Guard on the closer, the same shape
            // parse_index_on already uses for an empty slice bound.
            while peek()==TT_PNCT&&pval()==44 {
                adv()
                if peek()==TT_PNCT && pval()==93 { break }
                let e=parse_expr(); w64(elems+cnt*8, e); cnt=cnt+1
            }
        }
        mpnct(93)  // ']'
        let tr=nv(); iremit(IR_TALLOC,tr,cnt,0,0)
        let ci=0
        while ci<cnt {
            let ev=r64(elems+ci*8); let fi=nv(); iremit(IR_CONST,fi,ci,0,0)
            iremit(IR_ISTORE,0,tr,fi,ev)
            ci=ci+1
        }
        // An array literal is a VALUE, so `[8,9][1]` needs the postfix
        // applied here -- the identifier branch never runs for it.
        return parse_postfix_expr(tr)
    }
    if peek()==TT_PNCT&&pval()==40 {
        pdepth=pdepth+1
        if pdepth>PDEPTH_MAX {
            let mn = "error: expression nesting too deep\n"
            file_write(2, mn+8, len(mn)); exit(1)
        }
        adv(); let e=parse_expr()
        // G2 Part A: tuple literal (e1, e2, ...) -> IR_TALLOC(n) + IR_ISTORE each.
        // Reuses the B aggregate layout (header-carrying, qword stride); elements
        // are read back via the existing '.N' postfix (IR_IDX, base+idx*8).
        if peek()==TT_PNCT&&pval()==44 {
            let elems=mmap(8000); let cnt=0
            w64(elems+cnt*8, e); cnt=cnt+1
            while peek()==TT_PNCT&&pval()==44 {
                adv()
                // `)` ends the tuple, so a trailing comma must not add a
                // phantom element. Same guard as the bracket and brace literals.
                if peek()==TT_PNCT && pval()==41 { break }
                let ev=parse_expr(); w64(elems+cnt*8, ev); cnt=cnt+1
            }
            if mpnct(41)==0 { let mn="error: expected ')' in tuple literal\n"; file_write(2,mn+8,len(mn)); exit(1) }
            let tr=nv(); iremit(IR_TALLOC, tr, cnt, 0, 0)
            let ci=0
            while ci<cnt { let ev=r64(elems+ci*8); let fi=nv(); iremit(IR_CONST,fi,ci,0,0); iremit(IR_ISTORE,0,tr,fi,ev); ci=ci+1 }
            pdepth=pdepth-1; return tr
        }
        if mpnct(41)==0 {
            // No matching ')'. Reading a comma (e.g. `(1,2)`) is now a tuple
            // literal handled above; reaching here means a dangling '('.
            let mn = "error: expected ')' in parenthesized expression\n"
            file_write(2, mn+8, len(mn)); exit(1)
        }
        pdepth=pdepth-1; return parse_postfix_expr(e)
    }
    if peek()==TT_KEY {
        let v=pval(); let ln=plen(); let h=ktext(v,ln); let vr=nv()
        if h==10 { adv(); iremit(IR_CONST,vr,1,0,0); return vr }
        if h==11 { adv(); iremit(IR_CONST,vr,0,0,0); return vr }
        if h==12 { adv(); iremit(IR_CONST,vr,0,0,0); return vr }
        // P7 fix: type keywords (u8/u16/u32/u64/...) used as BUILTIN CALLS,
        // e.g. `u8(511)`. The tokenizer marks them TT_KEY for `let x: u64 = 5`
        // annotations, but as expression-primary they must route to parse_call
        // when followed by '(' ? otherwise `u8(511)` silently became CONST 0
        // (phantom value, `(511)` left unparsed). is_bltn matches the name at
        // src+v (same source-offset layout as TT_ID tokens). Consume the
        // keyword first (parse_call_impl's adv() then eats the '(').
        // 0.0.225: also route a KEYWORD-named USER function followed by '(' to
        // parse_call. try/catch/throw/defer lex as TT_KEY, so `try()` hit the
        // is_bltn() test, failed it (it is not a builtin), fell through to
        // IR_CONST 0 -- a phantom value with the '(...)' left unparsed. That is
        // the SIGILL: the compiler desynchronised and died emitting nothing.
        // `let a = try()` worked because no '(' followed, so it took the normal
        // variable path; `print(try())` failed because of the '('.
        if tokp+1<tokc && tokt(tokp+1)==TT_PNCT && tokv(tokp+1)==40 {
            if is_bltn(v,ln)==1 { adv(); return parse_call(v, ln, FI_LOCAL) }
            // a registered user function whose name collides with a keyword
            if findfn(v,ln)>=0 { adv(); return parse_call(v, ln, FI_LOCAL) }
        }
        adv(); iremit(IR_CONST,vr,0,0,0); return vr
    }
    if peek()==TT_CALL {
        // $(name) or $(name(args)): explicit EXTERNAL / GLOBAL function call.
        // Resolves via the GLOBAL table only (findfn_global), so it reaches the
        // top-level definition even when a local same-named function shadows it.
        let nm = pval(); let nl = plen(); adv()
        return parse_call(nm, nl, FI_GLOBAL)
    }
    if peek()==TT_SHCMD_RAW {
        // Raw command form: the lexer already captured the command as a quoted
        // string at srclen. We just need to emit IR_STR for it, then the
        // qc_sys_cmd call.
        if unsafe_depth==0 {
            let mn = "error: $$(cmd) requires unsafe{} (runs an external command)\n"
            file_write(2, mn+8, len(mn)); had_error=1; return 0
        }
        let str_at = pval(); let str_len = plen(); adv()  // consume TT_SHCMD_RAW
        // Emit IR_STR for the captured string.
        let vr = nv(); iremit(IR_STR, vr, str_at, 0, 0)
        w64(vreg_is_str + vr*8, 1)
        // Emit the qc_sys_cmd call.
        let cnm = srclen
        w8(src+cnm, 113); w8(src+cnm+1, 99); w8(src+cnm+2, 95); w8(src+cnm+3, 115); w8(src+cnm+4, 121); w8(src+cnm+5, 115); w8(src+cnm+6, 95); w8(src+cnm+7, 99); w8(src+cnm+8, 109); w8(src+cnm+9, 100); w8(src+cnm+10, 0)
        srclen = cnm + 11
        let vr2 = nv()
        iremit(IR_CALL, vr2, cnm, vr, 0)
        let cnm2 = srclen
        w8(src+cnm2, 67); w8(src+cnm2+1, 109); w8(src+cnm2+2, 100); w8(src+cnm2+3, 82); w8(src+cnm2+4, 101); w8(src+cnm2+5, 115); w8(src+cnm2+6, 117); w8(src+cnm2+7, 108); w8(src+cnm2+8, 116); w8(src+cnm2+9, 0)
        srclen = cnm2 + 10
        let crsi = findstruct(cnm2, 9)
        if crsi>=0 { w64(vreg_struct + vr2*8, crsi); w64(vreg_is_str + vr2*8, 0-1) }
        return vr2
    }
    if peek()==TT_SHCMD {
        // $$(cmd) runs an EXTERNAL command via fork/execve ? a privileged
        // escape from the memory-safe language. Secure-by-default: require it
        // to be wrapped in `unsafe {}`. Reject at compile time otherwise.
        if unsafe_depth==0 {
            let mn = "error: $$(cmd) requires unsafe{} (runs an external command)\n"
            file_write(2, mn+8, len(mn)); had_error=1; return 0
        }
        adv()  // consume TT_SHCMD
        let cmd = parse_expr()
        if !(peek()==TT_PNCT && pval()==41) {
            let mn = "error: expected ')' after $$ cmd\\n"; file_write(2, mn+8, len(mn)); exit(1)
        }
        adv()  // consume ')'
        let vr = nv()
        // Emit IR_CALL to builtin qc_sys_cmd (1 arg: cmd string). Name injected
        // into src arena past srclen (tokenization is done, never re-scanned).
        let cnm = srclen
        w8(src+cnm, 113); w8(src+cnm+1, 99); w8(src+cnm+2, 95); w8(src+cnm+3, 115); w8(src+cnm+4, 121); w8(src+cnm+5, 115); w8(src+cnm+6, 95); w8(src+cnm+7, 99); w8(src+cnm+8, 109); w8(src+cnm+9, 100); w8(src+cnm+10, 0)
        srclen = cnm + 11
        // FIX (0.0.55): pass the cmd vreg directly in the IR_CALL record's a1
        // slot. emit_bltn for qc_sys_cmd loads the cmd's data-section address from
        // the lit_addr map (populated by IR_STR codegen, keyed by the literal's
        // result vreg). This is bulletproof against vreg recycling: each $$ call
        // carries its OWN cmd vreg, and the map holds that call's literal address
        // at emit time (codegen runs IR_STR -> IR_CALL per call in order). a2=0.
        let vr = nv()
        iremit(IR_CALL, vr, cnm, cmd, 0)
        // Tag result vreg as CmdResult struct so .out/.code/.err field access
        // resolves via the struct table. Struct is already registered by
        // scanstructs at startup; inject its name here (parse time, safe).
        let cnm2 = srclen
        w8(src+cnm2, 67); w8(src+cnm2+1, 109); w8(src+cnm2+2, 100); w8(src+cnm2+3, 82); w8(src+cnm2+4, 101); w8(src+cnm2+5, 115); w8(src+cnm2+6, 117); w8(src+cnm2+7, 108); w8(src+cnm2+8, 116); w8(src+cnm2+9, 0)
        srclen = cnm2 + 10
        let crsi = findstruct(cnm2, 9)
        if crsi>=0 { w64(vreg_struct + vr*8, crsi); w64(vreg_is_str + vr*8, 0-1) }  // tag struct, clear any stale string tag
        return vr
    }
    if peek()==TT_ID {
            // Check for struct constructor: StructName(args) - MUST BE FIRST before enum lookahead
            let nm = pval(); let nl = plen()
            let si = findstruct(nm, nl)
            // P6.1b fix: hoist enum-lookahead locals to fn scope with =0 so they are
            // never used uninitialised when the enum-`if` (line 360) is skipped.
            let sep = 0; let vnm = 0; let vnl = 0; let ei = 0; let vidx = 0; let hk_enum = 0; let hk_var = 0
            if si >= 0 {
                adv()  // consume struct name
                if peek()==TT_PNCT && pval()==40 {
                    adv()  // consume '('
                    let fc = r64(sdefs + si*64 + 16)  // field count
                    let vr = nv(); iremit(IR_TALLOC, vr, fc, 0, 0)
                    let ac = 0
                    if !(peek()==TT_PNCT&&pval()==41) {
                        // Field SEPARATORS: loop on the DECLARED FIELD COUNT,
                        // not on commas.
                        //
                        // The struct-literal rewriter compacts `S { a: 1 b: 2 }`
                        // into `S(1 2)`. A loop that stopped at the first
                        // non-comma token parsed only the FIRST field and left
                        // `2` in the stream, corrupting every following
                        // statement -- the compiler core-dumped on every
                        // space-separated multi-field literal, while
                        // `S { a: 1, b: 2 }` and single-field literals worked.
                        //
                        // `fc` is the source of truth (sfldtyp already carries the
                        // per-field types), so both spellings are accepted and the
                        // loop can never under-parse. A present comma is still
                        // consumed, so `S(1, 2)` is unchanged.
                        while ac < fc {
                            let a = parse_expr()
                            let fi = nv(); iremit(IR_CONST, fi, ac, 0, 0)
                            // B2: tag a packed field's index vreg with its byte
                            // displacement+1 and width, so codegen needs no
                            // IR scan (the Tier-1 optimiser may delete the
                            // defining IR_CONST).
                            if r64(sdefs + si*64 + 32)==1 {
                                w64(vreg_poff + fi*8, r64(sfld_off + (si*64+ac)*8) + 8 + 1)
                                w64(vreg_pw + fi*8, r64(sfld_size + (si*64+ac)*8))
                            }
                            iremit(IR_ISTORE, 0, vr, fi, a)
                            ac = ac + 1
                            if peek()==TT_PNCT&&pval()==44 { adv() }
                        }
                    }
                    mpnct(41)  // consume ')'
                    w64(vreg_struct + vr*8, si)
                    return vr
                }
            }
            // P6.1b: Check for enum variant constructor BEFORE consuming the ID token.
            // We need to peek ahead: ID followed by '::' or '.' followed by ID.
            if tokp+1<tokc && (tokt(tokp+1)==TT_OP || tokt(tokp+1)==TT_PNCT) && (tokv(tokp+1)==58*256+58 || tokv(tokp+1)==46) && tokp+2<tokc && tokt(tokp+2)==TT_ID {
                nm=tokv(tokp); nl=tokln(tokp)
                sep = tokv(tokp+1)  // 58*256+58='::' or 46='.'
                vnm=tokv(tokp+2); vnl=tokln(tokp+2)
                // Check if this is an enum variant before consuming tokens
                ei=findenum(nm,nl)
                if ei>=0 {
                    vidx=evariant_idx(ei,vnm,vnl)
                    if vidx>=0 {
                        // It's a real enum variant - consume the three tokens
                        adv(); adv(); adv()
                        // It's a real enum variant
                        // A1b: the tuple and unit arms each used to `let vr`, so
                        // the use after the if/else resolved to the arm's leaked
                        // binding. Allocate vr once here, before the branch: the
                        // vreg NUMBER and allocation ORDER are unchanged (vr was
                        // the first nv() after fc in the tuple arm and the first
                        // in the unit arm), and both arms then write IR_TALLOC at
                        // the same place in the IR stream as before.
                        let vr=nv()
                        if peek()==TT_PNCT && pval()==40 {  // tuple payload
                            adv()
                            let fc=evariant_fcount(ei,vidx)
                            iremit(IR_TALLOC, vr, 1+fc, 0, 0)  // 1 word tag + payload
                            let ti=nv(); iremit(IR_CONST,ti,evariant_tag(ei,vidx),0,0)
                            let zi=nv(); iremit(IR_CONST,zi,0,0,0)
                            iremit(IR_ISTORE,0,vr,zi,ti)
                            let ac=0
                            if !(peek()==TT_PNCT&&pval()==41) {
                                while true {
                                    let a=parse_expr()
                                    if ac<fc {
                                        let fi=nv(); iremit(IR_CONST,fi,1+ac,0,0)
                                        iremit(IR_ISTORE,0,vr,fi,a)
                                    }
                                    ac=ac+1
                                    if peek()==TT_PNCT&&pval()==44 { adv() } else { break }
                                }
                            }
                            mpnct(41)
                        } else {
                            // unit variant (no payload)
                            iremit(IR_TALLOC, vr, 1, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,evariant_tag(ei,vidx),0,0)
                            let zi=nv(); iremit(IR_CONST,zi,0,0,0)
                            iremit(IR_ISTORE,0,vr,zi,ti)
                        }
                        w64(vreg_enum + vr*8, ei)
                        w64(vreg_enum_var + vr*8, vidx)
                        return vr
                    }
                }
                // Check for Option::Some / Option::None / Result::Ok / Result::Err
                // (builtins: NOT declared enums, so this must run even if findenum<0)
                hk_enum = ktext(nm,nl)
                hk_var = ktext(vnm,vnl)
                if hk_enum==H_OPTION || hk_enum==H_RESULT {
                    // consume the three tokens: Enum Variant  (Option :: Some)
                    adv(); adv(); adv()
                    // It's an Option or Result variant
                    if hk_enum==H_OPTION {
                        if hk_var==H_SOME {
                            if peek()==TT_PNCT && pval()==40 {
                                adv(); let a=parse_expr(); mpnct(41)
                                let vr=nv(); iremit(IR_SOME, vr, a, 0, 0)
                                w64(vreg_enum + vr*8, -2)  // tag as Option
                                w64(vreg_enum_var + vr*8, 1)  // Some = tag 1
                                return vr
                            }
                        } else if hk_var==H_NONE {
                            let vr=nv(); iremit(IR_NONE, vr, 0, 0, 0)
                            w64(vreg_enum + vr*8, -2)
                            w64(vreg_enum_var + vr*8, 0)
                            return vr
                        }
                    } else if hk_enum==H_RESULT {
                        if hk_var==H_OK {
                            if peek()==TT_PNCT && pval()==40 {
                                adv(); let a=parse_expr(); mpnct(41)
                                let vr=nv(); iremit(IR_OK, vr, a, 0, 0)
                                w64(vreg_enum + vr*8, -3)
                                w64(vreg_enum_var + vr*8, 1)
                                return vr
                            }
                        } else if hk_var==H_ERR {
                            if peek()==TT_PNCT && pval()==40 {
                                adv(); let a=parse_expr(); mpnct(41)
                                let vr=nv(); iremit(IR_ERR, vr, a, 0, 0)
                                w64(vreg_enum + vr*8, -3)
                                w64(vreg_enum_var + vr*8, 0)
                                return vr
                            }
                        }
                    }
                }
            }
                    // Check for bare Some/None/Ok/Err (built-in enum variants without Option:: prefix)
                    let hk_bare = ktext(nm, nl)
                    if hk_bare==H_SOME {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_TALLOC, vr, 2, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,1,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                            let fi=nv(); iremit(IR_CONST,fi,1,0,0); iremit(IR_ISTORE,0,vr,fi,a)
                            w64(vreg_enum + vr*8, -2)  // tag as Option
                            w64(vreg_enum_var + vr*8, 1)  // Some = tag 1
                            return vr
                        }
                    }
                    if hk_bare==H_NONE {
                        let vr=nv(); iremit(IR_TALLOC, vr, 1, 0, 0)
                        let ti=nv(); iremit(IR_CONST,ti,0,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                        w64(vreg_enum + vr*8, -2)
                        w64(vreg_enum_var + vr*8, 0)
                        return vr
                    }
                    if hk_bare==H_OK {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_TALLOC, vr, 2, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,1,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                            let fi=nv(); iremit(IR_CONST,fi,1,0,0); iremit(IR_ISTORE,0,vr,fi,a)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 1)
                            return vr
                        }
                    }
                    if hk_bare==H_ERR {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_TALLOC, vr, 2, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,0,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                            let fi=nv(); iremit(IR_CONST,fi,1,0,0); iremit(IR_ISTORE,0,vr,fi,a)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 0)
                            return vr
                        }
                    }
                    // Check for function call: name(args) - this comes AFTER enum/struct checks
                        // Not an enum variant, now consume the ID token for regular handling
                        let nm=pval(); let nl=plen(); adv()
                    // F7: compile-time constant substitution ? emit IR_CONST directly.
                    // A bare enum-variant name is registered as a MARKED const (bvmark()+ei*1048576+vidx);
                    // detect the mark and emit the heap unit-variant (consistent with match).
                    // cfind returns an INDEX (or -1); cval dereferences it, so the
                    // -1 case must be filtered BEFORE dereferencing or cval(-1) reads
                    // memory before the table.
                    let cvi = cfind(nm,nl)
                    let cv0 = -1
                    // A FLOAT const (ckind==2) must be handled BEFORE the
                    // bvmark() test below and before the cv0>=0 guard: an f64 bit
                    // pattern is an unremarkably large positive integer
                    // (2.5 -> 4612811918334230528 > bvmark()), so it would
                    // otherwise be read as an enum-variant mark, and a NEGATIVE
                    // float's pattern is < 0 so the guard would skip it
                    // entirely and the name would fail as "undeclared".
                    if cvi>=0 && ckind(cvi)==2 {
                        let fvr=nv()
                        iremit(IR_FCONST,fvr,cval(cvi),0,0)
                        w8(vfloat + fvr, 1)   // an f64 bit pattern IS a float vreg
                        return fvr
                    }
                    if cvi>=0 { cv0 = cval(cvi) }
                    // 0.0.243: the bare-enum-variant mark is keyed on the const's
                    // KIND (3), NOT on its value. The old test was
                    // `cv0 >= bvmark()`, i.e. "any const at or above 2^60 is an
                    // enum marker" -- but that range belongs to the USER. An f64
                    // bit pattern written as an integer const is >= 2^60 (2.5 ->
                    // 4612811918334230528), and so is any large integer, so
                    //     const V = 2305843009213693952
                    //     fn main() { print(V); return 0 }
                    // was decoded as a variant mark: bei = 2^40 and
                    // evariant_tag() indexed enums + 2^40*96, so the COMPILER
                    // segfaulted on a well-formed program. Reproduced on the
                    // 0.0.241 golden and on this tree; the threshold and the
                    // red-first row are in tests/const_large_int_test.quanta.
                    if cv0>=0 || ckind(cvi)==3 {
                        let cvr=nv()
                        if ckind(cvi)==3 {
                            let packed = cv0 - bvmark()
                            let bei = packed / 1048576
                            let bvidx = packed - bei*1048576
                            iremit(IR_TALLOC, cvr, 1, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,evariant_tag(bei,bvidx),0,0)
                            let zi=nv(); iremit(IR_CONST,zi,0,0,0)
                            iremit(IR_ISTORE,0,cvr,zi,ti)
                            w64(vreg_enum + cvr*8, bei)
                            w64(vreg_enum_var + cvr*8, bvidx)
                        } else if ckind(cvi)==1 {
                            // 0.0.225: a STRING const. cv0 is the offset of the
                            // opening quote in src, not a number. Emitting
                            // IR_CONST here put that raw offset in a vreg, so
                            // the program held a small integer where a char*
                            // was required: printing it showed the offset, and
                            // passing it to a function that reads the bytes
                            // segfaulted. IR_STR is what actually materialises
                            // the literal, and vreg_is_str is what tells the
                            // emitter this vreg holds a string.
                            iremit(IR_STR,cvr,cv0,0,0)
                            w64(vreg_is_str + cvr*8, 1)
                        } else {
                            iremit(IR_CONST,cvr,cv0,0,0)
                        }
                        return cvr
                    }
                    // Check for bare Some/None/Ok/Err (built-in enum variants without Option:: prefix)
                    let hk_bare = ktext(nm, nl)
                    if hk_bare==H_SOME {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_SOME, vr, a, 0, 0)
                            w64(vreg_enum + vr*8, -2)  // tag as Option
                            w64(vreg_enum_var + vr*8, 1)  // Some = tag 1
                            return vr
                        }
                    }
                    if hk_bare==H_NONE {
                        let vr=nv(); iremit(IR_NONE, vr, 0, 0, 0)
                        w64(vreg_enum + vr*8, -2)
                        w64(vreg_enum_var + vr*8, 0)
                        return vr
                    }
                    if hk_bare==H_OK {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_OK, vr, a, 0, 0)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 1)
                            return vr
                        }
                    }
                    if hk_bare==H_ERR {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_ERR, vr, a, 0, 0)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 0)
                            return vr
                        }
                    }
                    // Check for function call: name(args) or name<args>(args)
                    // Both '(' and '<' (for generic type args) trigger function call
                    // NOTE: tokp already advanced past the name (line 3029 adv()),
                    // so it points AT the '(' or '<' token now.
                    let is_call = 0
                    // Bare call: resolve LOCAL-FIRST (walk the scope chain). This
                    // is what makes a local fn shadow a same-named global.
                    let fchk = resolve_call(nm, nl)
                    if tokp<tokc && tokt(tokp)==TT_PNCT && tokv(tokp)==40 { is_call = 1 }
                    else if tokp<tokc && tokt(tokp)==TT_OP && tokv(tokp)==60 && fchk>=0 && r64(fn_generic + fchk*8)!=0 { is_call = 1 }
                    // P3: if bare call not a function, check if it's a module name followed by `.fn`
                    if is_call==0 && fchk<0 {
                        // check if nm is a registered module name
                        let mi = 0; let is_mod = 0
                        while mi < modc {
                            let mnm = r64(modtab + mi*16); let mnl = r64(modtab + mi*16 + 8)
                            if mnl == nl {
                                let ok = 1; let k = 0
                                while k < nl { if r8(src+mnm+k) != r8(src+nm+k) { ok = 0; break }; k = k+1 }
                                if ok == 1 { is_mod = 1; break }
                            }
                            mi = mi + 1
                        }
                        if is_mod == 1 && tokp<tokc && tokt(tokp)==TT_PNCT && tokv(tokp)==46 && tokp+1<tokc && tokt(tokp+1)==TT_ID {
                            let qn = mod_synth_name(nm, nl, tokv(tokp+1), tokln(tokp+1))
                            let ql = nl + 1 + tokln(tokp+1)
                            adv(); adv()   // consume '.' and member ID
                            let qcall = 0
                            if tokp<tokc && tokt(tokp)==TT_PNCT && tokv(tokp)==40 { qcall = 1 }
                            else if tokp<tokc && tokt(tokp)==TT_OP && tokv(tokp)==60 { qcall = 1 }
                            if qcall == 1 { return parse_postfix_expr(parse_call(qn, ql, FI_GLOBAL)) }
                        }
                    }
                    if is_call==1 {
                        // A call result is a VALUE, so a following `[...]` needs
                        // parse_postfix_expr -- the identifier branch below never
                        // runs for it.
                        return parse_postfix_expr(parse_call(nm, nl, FI_LOCAL))
                    }
        if peek()==TT_PNCT&&pval()==91 {  // index: a[idx] OR slice: a[lo:hi] / a[:hi] / a[lo:]
            // The base of the FIRST index is this name; the base of every later one
            // is the previous result. `while` rather than a single `if` is what
            // makes `n[1][0]` and `parts[i][j]` consume all of their brackets.
            let pv = -1
            let fv = vfind(nm, nl)
            if fv >= 0 { pv = fv }
            else {
                let gv = gfind(nm, nl)
                if gv >= 0 { let pg=nv(); iremit(IR_LOADG,pg,gv,0,0); pv = pg }
            }
            if pv < 0 { compile_error(1, nm, nl); return 0 }
            while peek()==TT_PNCT && pval()==91 { pv = parse_index_on(pv) }
            return pv
        }
        // Phase 4.3: postfix `.N` (tuple), `.field` (struct), `.method` (t8) ?
        // CHAINED (e.g. r.topleft.x). `selfv` holds the object vreg: for the
        // first `.` it is resolved from the name `nm`/`nl`; for later chain
        // links it is the previous field's result vreg (tagged via sfldtyp so
        // the next `.` resolves). All name lookups are INLINED ? calling a
        // user-fn with live locals trips the allocator clobber bug.
        let selfv = -1
        while peek()==TT_PNCT&&pval()==46 {
            adv()
            if peek()==TT_NUM {
                let fld=pval(); adv()
                let fi=nv(); iremit(IR_CONST,fi,fld,0,0)
                if selfv<0 {
                    // inline vfind(nm,nl)
                    let i = varc-1
                    while i>=0 {
                        vnm = r64(vars + i*VRS); vnl = r64(vars + i*VRS + 16)
                        if vnl==nl {
                            let ok=1; let j=0
                            while j<nl { if r8(src+vnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                            if ok==1 { a1b_check(i, nm, nl); selfv=r64(vars+i*VRS+8); break }
                        }
                        i=i-1
                    }
                    if selfv<0 {
                        // inline gfind(nm,nl)
                        let gi=0
                        while gi<gvarc {
                            if r64(gvars+gi*16+8)==nl {
                                let gnm=r64(gvars+gi*16); let ok=1; let j=0
                                while j<nl { if r8(src+gnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                                if ok==1 { selfv=nv(); iremit(IR_LOADG,selfv,gi,0,0); break }
                            }
                            gi=gi+1
                        }
                    }
                }
                if selfv<0 { compile_error(1, nm, nl); return 0 }
                if peek()==TT_OP&&pval()==61 { adv(); let v=parse_expr(); iremit(IR_ISTORE,0,selfv,fi,v); return 0 }
                let vr=nv(); iremit(32,vr,selfv,fi,0); selfv=vr
            } else if peek()==TT_ID {
                if selfv<0 {
                    // F7: compile-time constant substitution ? emit IR_CONST directly.
                    // cfind returns an INDEX (or -1), not the value; dereference
                    // only after confirming the entry exists. A string const
                    // must go through IR_STR so the literal is materialised.
                    let cvi2 = cfind(nm,nl)
                    if cvi2>=0 {
                        let vr=nv()
                        if ckind(cvi2)==2 {
                            // float const: exact IEEE-754 bits, float vreg.
                            iremit(IR_FCONST,vr,cval(cvi2),0,0)
                            w8(vfloat + vr, 1)
                        } else if ckind(cvi2)==1 {
                            iremit(IR_STR,vr,cval(cvi2),0,0)
                            w64(vreg_is_str + vr*8, 1)
                        } else {
                            iremit(IR_CONST,vr,cval(cvi2),0,0)
                        }
                        selfv=vr
                    }
                }
                if selfv<0 {
                    // inline vfind(nm,nl)
                    let i = varc-1
                    while i>=0 {
                        vnm = r64(vars + i*VRS); vnl = r64(vars + i*VRS + 16)
                        if vnl==nl {
                            let ok=1; let j=0
                            while j<nl { if r8(src+vnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                            if ok==1 { a1b_check(i, nm, nl); selfv=r64(vars+i*VRS+8); break }
                        }
                        i=i-1
                    }
                    if selfv<0 {
                        // inline gfind(nm,nl)
                        let gi=0
                        while gi<gvarc {
                            if r64(gvars+gi*16+8)==nl {
                                let gnm=r64(gvars+gi*16); let ok=1; let j=0
                                while j<nl { if r8(src+gnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                                if ok==1 { selfv=nv(); iremit(IR_LOADG,selfv,gi,0,0); break }
                            }
                            gi=gi+1
                        }
                    }
                }
                if selfv<0 { compile_error(1, nm, nl); return 0 }
                let mnm=pval(); let ml=plen()
                let si=r64(vreg_struct + selfv*8)
                if si>=0 {
                    // inline sfield_idx(si, mnm, ml)
                    let fc=r64(sdefs + si*64 + 16); let fb=r64(sdefs + si*64 + 24)
                    let fidx=-1; let fj=0
                    while fj<fc {
                        let fp=r64(sfldtab + (fb+fj)*16); let fl2=r64(sfldtab + (fb+fj)*16 + 8)
                        if fl2==ml {
                            let ok=1; let fk=0
                            while fk<ml { if r8(src+fp+fk)!=r8(src+mnm+fk){ok=0;break}; fk=fk+1 }
                            if ok==1 { fidx=fj; break }
                        }
                        fj=fj+1
                    }
                    if fidx>=0 {
                        adv()
                        let fi=nv(); iremit(IR_CONST,fi,fidx,0,0)
                        // B2: tag packed field index vreg (same rationale as the
                        // constructor site).
                        if r64(sdefs + si*64 + 32)==1 {
                            w64(vreg_poff + fi*8, r64(sfld_off + (si*64+fidx)*8) + 8 + 1)
                            w64(vreg_pw + fi*8, r64(sfld_size + (si*64+fidx)*8))
                        }
                        if peek()==TT_OP&&pval()==61 { adv(); let v=parse_expr(); iremit(IR_ISTORE,0,selfv,fi,v); return 0 }
                        let vr=nv(); iremit(32,vr,selfv,fi,0)
                        // tag result with field's struct type (enables next chain link)
                        let ftype=r64(sfldtyp + (fb+fidx)*8)
                        if ftype>=0 { w64(vreg_struct + vr*8, ftype) }
                        if ftype==0-2 { w64(vreg_is_str + vr*8, 1) }  // string field (out)
                        selfv=vr
                    } else {
                        adv(); return parse_method_call(selfv, mnm, ml)
                    }
                } else {
                    // P9: dyn-trait receiver -> dispatch via impl table. The
                    // impl method is registered in the fn table under its own
                    // name, so the standard method-call path (findfn by name)
                    // already resolves and calls it with selfv prepended as
                    // arg 0. The vreg_trait tag marks it as a dyn trait so a
                    // real vtable dispatch can replace this later.
                    adv(); return parse_method_call(selfv, mnm, ml)
                }
            } else {
                compile_error(1, nm, nl); return 0
            }
        }
        if selfv>=0 { return selfv }
        let f=vfind(nm,nl); if f>=0 { return f }
        let g=gfind(nm,nl); if g>=0 { let vr=nv(); iremit(IR_LOADG,vr,g,0,0); return vr }
        // P10: bare function name in value position (e.g. `map(arr, double)`)
        // -> IR_FNVAL builds a fn-value 2-tuple [codeptr, env=0] (same shape
        // mk_any makes, so fn-typed params called via IR_CLOSURE_CALL work).
        let ffi=findfn(nm,nl)
        if ffi>=0 {
            let vr=nv(); iremit(IR_FNVAL, vr, ffi, 0, 0)
            return vr
        }
        // P11 (0.0.67): CLOSURE CAPTURE. We are parsing a closure body and `nm`
        // is not a local, global, or function -- so it is a free variable. If it
        // names a local of the ENCLOSING function, capture it BY VALUE instead of
        // erroring: record the outer vreg, and in the body read the value back
        // out of the env array (env arrives in r10, see IR_CLOSURE_CALL).
        if cur_clo >= 0 {
            let ov = clo_outer_find(nm, nl)
            if ov >= 0 {
                let slot = cap_add(cur_clo, nm, nl, ov)
                let vr = nv(); iremit(IR_CAPREAD, vr, slot, 0, 0)
                vadd(nm, nl, vr)   // bind so repeat uses hit the local scope
                w64(cap_bodyvreg + (cur_clo*CAP_MAX + slot)*8, vr)
                return vr
            }
        }
        compile_error(1, nm, nl)  // undeclared variable -> hard error (no silent 0)
    }
    if peek()==TT_PNCT&&(pval()==91||pval()==123) {
        let mu = "error: unexpected token in expression\n"
        file_write(2, mu+8, len(mu)); exit(1)
    }
    // G4-fix: token-aware guard. `}` (125) and `,` (44) legitimately reach
    // parse_primary from the match arm parser: parse_match's trailing
    // `else if peek()==95 {wildcard} else {literal}` runs as a SEPARATE
    // statement after every arm (parse_if handles only one else), so its
    // literal branch calls parse_expr on the arm terminator. The match loop
    // consumes the token itself; emitting CONST-0 WITHOUT advancing yields
    // dead-but-skipped IR (the arm's IR_JMP end precedes it), matching the
    // known-good 9a7ec10 behavior. ALL other tokens hard-fail: emitting
    // CONST-0 without advancing on e.g. ':' or ')' loops forever
    // (g6 slice-hang: "source too many tokens/IR limit").
    if peek()==TT_PNCT&&(pval()==125||pval()==44) {
        let vr5=nv(); iremit(IR_CONST,vr5,0,0,0); return vr5
    }
    // Chained assignment `a = b = expr`: parse_expr must STOP at `=` and hand
    // control back to parse_assign, which then walks the chain. Reaching here on
    // a `=` meant the token was never consumed -- the CONST-0 fallthrough
    // returned without advancing the cursor, so the statement loop re-entered on
    // the same token and the desync cascaded into a corrupt instruction stream.
    // The compiler died with SIGILL on any such input; lib/std/rag.quanta used
    // `cmd = cmd = cmd + "..."` in six places, so `import std/rag` had never
    // compiled on any release (0.0.217 through 0.0.220).
    //
    // A bare `=` is never a valid primary, so stopping here -- without emitting
    // anything -- is what lets parse_assign see it. parse_assign's chain loop
    // does the real work.
    if peek()==TT_OP && pval()==61 {
        return 0
    }
    // 0.0.220 SAFETY NET: a TT_KEY that reached the end of parse_primary was
    // matched by no keyword handler, so it is not a keyword in expression
    // position -- treat it as an identifier. Without this, a keyword table entry
    // with no parser consumer silently returned CONST-0 WITHOUT advancing the
    // cursor, which desynced the token stream: `read_raw(fd, raw, 8)` parsed only
    // 2 arguments and was rejected with a bogus "wrong argument count for:
    // read_raw" (the real defect this line's absence caused). Consuming the
    // token here keeps the cursor honest and resolves the name through the
    // normal local -> global -> const path.
    if peek()==TT_KEY {
        let knm = pval(); let kln = plen(); adv()
        let kv = vfind(knm, kln); if kv>=0 { return kv }
        let kg = gfind(knm, kln)
        if kg>=0 { let kvr=nv(); iremit(IR_LOADG,kvr,kg,0,0); return kvr }
        let kc = cfind(knm, kln)
        if kc>=0 {
            let kvr=nv()
            // A string const must go through IR_STR (which materialises the
            // literal), not IR_CONST (which loads the raw table value as an
            // integer). Emitting IR_CONST for a string const handed the
            // compiled program a source-buffer OFFSET where a pointer was
            // required -- which is why passing such a const to a function
            // crashed while the same literal inline worked.
            if ckind(kc)==2 {
                // float const: exact IEEE-754 bits, float vreg.
                iremit(IR_FCONST,kvr,cval(kc),0,0)
                w8(vfloat + kvr, 1)
            }
            else if ckind(kc)==1 {
                iremit(IR_STR,kvr,cval(kc),0,0)
                w64(vreg_is_str + kvr*8, 1)
            }
            else { iremit(IR_CONST,kvr,cval(kc),0,0) }
            return kvr
        }
        // Genuinely unresolvable: keep the old no-advance behaviour so a real
        // missing keyword is still diagnosed by the statement-level error path
        // rather than being masked as a value.
        return 0
    }
    let vr5=nv(); iremit(IR_CONST,vr5,0,0,0); return vr5
}

