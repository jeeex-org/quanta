// Complete verify_status.quanta with all fixes
module std_verify_status;

import std/str
import std/vec
import std/map
import std/fs
import std/json

const MAX_LINE = 1048576; // 1MB
const MMAP_SZ = 2097152; // 2MB / 8 = 262144 slots

fn read_file_all(path) -> i64 {
    let fd = file_open(path, 0);
    if fd < 0 { return 0; }
    let buf = mmap((MAX_LINE + 7) / 8);
    let n = file_read(fd, buf, MAX_LINE);
    file_close(fd);
    if n <= 0 { return 0; }
    mem_store(buf, n);
    return buf;
}

fn write_file_all(path, content, len) -> i64 {
    let fd = file_open(path, 577);
    if fd < 0 { return -1; }
    let w = file_write(fd, content, len);
    file_close(fd);
    return w;
}

fn check_quanta_file(path) -> i64 {
    let buf = read_file_all(path);
    if buf == 0 { return 3; }
    let n = mem_load(buf);
    
    let lines = 0;
    let has_main = 0;
    let has_init = 0;
    let export_count = 0;
    let i = 0;
    
    while i < n {
        let c = mem_load8(buf + 8 + i);
        if c == 10 { lines = lines + 1; }
        i = i + 1;
    }
    
    let content = buf + 8;
    i = 0;
    while i < n - 3 {
        if mem_load8(content + i) == 102 && mem_load8(content + i + 1) == 110 && mem_load8(content + i + 2) == 32 {
            let j = i + 3;
            let name_start = j;
            while j < n && mem_load8(content + j) != 40 && mem_load8(content + j) != 32 && mem_load8(content + j) != 10 { j = j + 1; }
            let name_len = j - name_start;
            if name_len == 4 && mem_load8(content + name_start) == 109 && mem_load8(content + name_start + 1) == 97 && mem_load8(content + name_start + 2) == 105 && mem_load8(content + name_start + 3) == 110 {
                has_main = 1;
            } else if name_len == 4 && mem_load8(content + name_start) == 105 && mem_load8(content + name_start + 1) == 110 && mem_load8(content + name_start + 2) == 105 && mem_load8(content + name_start + 3) == 116 {
                has_init = 1;
            } else {
                export_count = export_count + 1;
            }
        }
        i = i + 1;
    }
    
    if lines < 20 { return 1; }
    if export_count == 0 && has_main == 1 { return 1; }
    if export_count < 3 { return 2; }
    return 0;
}

