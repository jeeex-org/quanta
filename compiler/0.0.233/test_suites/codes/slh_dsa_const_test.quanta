fn slh_dsa_n(): i64 { return 16 }
fn slh_dsa_w(): i64 { return 16 }
fn slh_dsa_h(): i64 { return 63 }
fn slh_dsa_d(): i64 { return 7 }
fn slh_dsa_k(): i64 { return 30 }
fn slh_dsa_a(): i64 { return 12 }
fn slh_dsa_len(): i64 { return 34 }

fn main() {
    let n: i64 = slh_dsa_n()
    let w: i64 = slh_dsa_w()
    let h: i64 = slh_dsa_h()
    let d: i64 = slh_dsa_d()
    let k: i64 = slh_dsa_k()
    let a: i64 = slh_dsa_a()
    let len: i64 = slh_dsa_len()
    if n != 16 { exit(1) }
    if w != 16 { exit(2) }
    if h != 63 { exit(3) }
    if d != 7 { exit(4) }
    if k != 30 { exit(5) }
    if a != 12 { exit(6) }
    if len != 34 { exit(7) }
    exit(0)
}