// User-wins across several builtin names at once, including a call CHAIN:
// user gcd calls user abs. Before 0.0.68 both were hijacked by float builtins,
// so gcd cascaded to a wrong answer.
fn abs(x) {
    if x < 0 { return 0 - x }
    return x
}
fn pow(base, exp) {
    let r = 1
    let i = 0
    while i < exp { r = r * base; i = i + 1 }
    return r
}
fn gcd(a, b) {
    let x = abs(a)
    let y = abs(b)
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    return x
}
fn main() {
    // pow(2,5)=32  gcd(-48,18)=6  -> 32 + 6 = 38
    return pow(2, 5) + gcd(0 - 48, 18)
}
