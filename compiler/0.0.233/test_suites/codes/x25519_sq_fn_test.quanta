// x25519_sq_fn_test.quanta — test fe_sq in function

import std/x25519

fn sq_loop(a, out, count) {
  let i = 0
  while i < count {
    fe_sq(a, out)
    fe_copy(out, a)
    i = i + 1
  }
}

fn main() {
  println("Test fe_sq in function...")
  
  let a = mem_alloc(8*8)
  fe_zero(a)
  mem_store(a, 9)
  
  let out = mem_alloc(8*8)
  sq_loop(a, out, 5)
  
  println("Done")
  println(0)
  exit(0)
}