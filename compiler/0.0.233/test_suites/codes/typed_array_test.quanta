// typed_array_test.quanta — 0.0.110 typed array/slice `T[]` annotation
// `let a: i64[] = [...]` parses and tags the binding as an array; indexing
// (a[idx]) already works via IR_IDX. Early-exit pattern (no live args across
// calls) to avoid the unrelated pre-existing allocator bug (ROADMAP Known Issues).
fn main() {
    let a: i64[] = [10,20,30,40]
    if !(a[0] == 10) { exit(1) }
    if !(a[3] == 40) { exit(2) }
    if !(a[1] + a[2] == 50) { exit(3) }
    let b: i64[] = [5,6]
    if !(b[1] == 6) { exit(4) }
    // mutation through index still supported on a typed-array binding
    a[0] = 99
    if !(a[0] == 99) { exit(5) }
    exit(0)
}
