// trait_only: trait declaration + a struct that implements it, with a real
// method-call assertion (Circle.draw() == radius*2 == 10).
// (Was a no-op: declared the trait, returned 0.)
trait Drawable {
    fn draw(self) -> int
}

struct Circle {
    radius: int
}

impl Drawable for Circle {
    fn draw(self) -> int {
        self.radius * 2
    }
}

fn main() {
    let c = Circle { radius: 5 }
    return c.draw()   // 10
}
