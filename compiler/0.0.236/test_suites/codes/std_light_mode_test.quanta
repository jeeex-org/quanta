// ===========================================================================
// std_light_mode_test.quanta
//
// Phase 11.4. From HashCortX src/js/code/light.js.
//
// The mechanism: for a model under ~5B the host does the machinery. The model is
// sent no tools and answers in plain text with whole files, and this test pins
// what the host makes of that answer.
//
// Expectations are derived from light.js, not from what the code happens to do.
// Where a behaviour is Quanta's own choice rather than the reference's, the test
// says so in a comment.
//
// Two compiler facts this test relies on, both verified while building it:
//   - `x != ""` is NOT a reliable "is non-empty" test. Two identical strings
//     compare != as TRUE, so every emptiness check here uses equals(x,"")==0.
//   - str_split returns a TYPED string list (length at the pointer, elements at
//     +8), which is not a std/vec (capacity at 0, length at +8).

import std/light_mode

let FAIL = 0

fn check(id, ok) -> i64 {
    if ok != 1 {
        print("  FAIL check "); print(id); print("\n")
        FAIL = FAIL + 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// 1. The tier gate. Small only: rewriting whole files costs tokens proportional
//    to file size, which is why a mid or full model is better on tool calls.
//    HashCortX allows an override either way.
// ---------------------------------------------------------------------------
fn t_enabled() -> i64 {
    check(1, lm_enabled(1, -1) == 1)      // small, no override -> on
    check(2, lm_enabled(2, -1) == 0)      // mid  -> off
    check(3, lm_enabled(3, -1) == 0)      // full -> off
    check(4, lm_enabled(2, 1) == 1)       // forced on
    check(5, lm_enabled(1, 0) == 0)       // forced off
    check(6, lm_enabled(3, 1) == 1)       // forced on wins over the tier
    return 0
}

// ---------------------------------------------------------------------------
// 2. The instruction names both halves of the reply format. A format the
//    prompt does not mention is a silent failure at this size, so this is a
//    property of the prompt, not of the parser.
// ---------------------------------------------------------------------------
fn t_system_mentions_format() -> i64 {
    check(10, len(LM_SYSTEM) > 200)
    check(11, lm_has(LM_SYSTEM, "FILE:") == 1)
    check(12, lm_has(LM_SYSTEM, "READ:") == 1)
    check(13, lm_has(LM_SYSTEM, "do not call tools") == 1)
    return 0
}

fn lm_has(s, sub) -> i64 {
    let n = len(s)
    let m = len(sub)
    if m > n { return 0 }
    let i = 0
    while i + m <= n {
        let j = 0
        let same = 1
        while j < m {
            if byte_at(s, i + j) != byte_at(sub, j) { same = 0; break }
            j = j + 1
        }
        if same == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// 3. The plain case: one whole file and one read request.
// ---------------------------------------------------------------------------
fn t_basic() -> i64 {
    lm_parse("FILE: a.js\n```\nlet x = 1\n```\nREAD: b.css\nI changed a.js")
    check(20, lm_writes() == 1)
    check(21, lm_reads() == 1)
    check(22, equals(lm_write_path(0), "a.js") == 1)
    // every file ends with a newline, so two files cannot run together
    check(23, equals(lm_write_body(0), "let x = 1\n") == 1)
    check(24, equals(lm_read_path(0), "b.css") == 1)
    check(25, equals(LM_SAID, "I changed a.js") == 1)
    check(26, LM_CUT == 0)
    return 0
}

// ---------------------------------------------------------------------------
// 4. A prose FILE: line is REFUSED. Writing a sentence over a real file destroys
//    work, so a body with no code-like line writes nothing. light.js
//    looksLikeFile. Quanta's rule: a words file (.md .txt .rst .tex) is always
//    taken as the file, because prose IS its content.
// ---------------------------------------------------------------------------
fn t_refuses_prose_body() -> i64 {
    lm_parse("FILE: a.js\n```\nI updated the stylesheet.\n```\nDone.")
    check(30, lm_writes() == 0)

    // the same prose under a .md IS the file
    lm_parse("FILE: notes.md\n```\nI updated the stylesheet.\n```\nDone.")
    check(31, lm_writes() == 1)
    check(32, equals(lm_write_body(0), "I updated the stylesheet.\n") == 1)

    // a file whose only line is a keyword is still code
    lm_parse("FILE: b.js\n```\nreturn\n```")
    check(33, lm_writes() == 1)

    // code detected by its trailing bracket
    lm_parse("FILE: c.js\n```\nfoo()\n```")
    check(34, lm_writes() == 1)

    // code detected by an opening brace
    lm_parse("FILE: d.js\n```\nfunction f() {\n```")
    check(35, lm_writes() == 1)

    // html
    lm_parse("FILE: e.html\n```\n<div>hi</div>\n```")
    check(36, lm_writes() == 1)
    return 0
}

// ---------------------------------------------------------------------------
// 5. `letter` is not the keyword `let`. A keyword must be followed by a word
//    boundary, or ordinary prose containing a declaration keyword mid-line
//    would be taken for code.
// ---------------------------------------------------------------------------
fn t_keyword_boundary() -> i64 {
    check(40, lm_starts_keyword("let x = 1", 0, 9) == 1)
    check(41, lm_starts_keyword("letter", 0, 6) == 0)
    check(42, lm_starts_keyword("classic", 0, 7) == 0)
    check(43, lm_starts_keyword("returned", 0, 8) == 0)
    check(44, lm_starts_keyword("const", 0, 5) == 1)
    return 0
}

// ---------------------------------------------------------------------------
// 6. Fabricated runs are discarded. Light mode runs the tests; a RUN: line and
//    the result under it are the model making them up. light.js
//    withoutMadeUpRuns.
// ---------------------------------------------------------------------------
fn t_strips_fake_runs() -> i64 {
    // a RUN: line with a fenced result block
    lm_parse("FILE: a.js\n```\nlet x = 1\n```\nRUN: npm test\n```\nall 12 tests pass\n```\nDone.")
    check(50, lm_writes() == 1)
    check(51, lm_has(LM_SAID, "RUN:") == 0)
    check(52, lm_has(LM_SAID, "all 12 tests pass") == 0)
    check(53, lm_has(LM_SAID, "Done.") == 1)

    // a RUN: line with a short result paragraph
    lm_parse("RUN: pytest\nAll tests pass.\nFinished.")
    check(54, lm_has(LM_SAID, "RUN:") == 0)
    check(55, lm_has(LM_SAID, "All tests pass") == 0)
    check(56, lm_has(LM_SAID, "Finished.") == 1)

    // a RUN: line whose following prose does NOT read like a result survives
    lm_parse("RUN: ls\nI listed the directory.\nFinished.")
    check(57, lm_has(LM_SAID, "RUN:") == 0)
    check(58, lm_has(LM_SAID, "I listed the directory.") == 1)

    // prose with no RUN: at all is untouched
    lm_parse("Everything passes and works.")
    check(59, lm_has(LM_SAID, "Everything passes") == 1)
    return 0
}

// ---------------------------------------------------------------------------
// 7. A reply that ends before its closing fence is `cut`, and the truncated body
//    is still taken -- a half change is more use than none, and the flag lets the
//    caller decide whether to apply it.
// ---------------------------------------------------------------------------
fn t_cut_off() -> i64 {
    lm_parse("FILE: a.js\n```\nlet x = 1\nlet y = 2")
    check(70, LM_CUT == 1)
    check(71, lm_writes() == 1)
    check(72, equals(lm_write_body(0), "let x = 1\nlet y = 2\n") == 1)

    // a FILE: line with no block at all
    lm_parse("FILE: a.js\n")
    check(73, LM_CUT == 1)
    check(74, lm_writes() == 0)

    // a complete reply is not cut
    lm_parse("FILE: a.js\n```\nlet x = 1\n```")
    check(75, LM_CUT == 0)
    return 0
}

// ---------------------------------------------------------------------------
// 8. A path written twice keeps its LAST body. light.js:227-230 -- this is what
//    stops a model that rewrites one file three times from applying all three.
// ---------------------------------------------------------------------------
fn t_last_write_wins() -> i64 {
    lm_parse("FILE: a.js\n```\nlet v = 1\n```\nFILE: a.js\n```\nlet v = 2\n```\nDone.")
    check(80, lm_writes() == 1)
    check(81, equals(lm_write_body(0), "let v = 2\n") == 1)

    // three times still one write
    lm_parse("FILE: a.js\n```\nlet v = 1\n```\nFILE: a.js\n```\nlet v = 2\n```\nFILE: a.js\n```\nlet v = 3\n```")
    check(82, lm_writes() == 1)
    check(83, equals(lm_write_body(0), "let v = 3\n") == 1)

    // two different paths stay separate
    lm_parse("FILE: a.js\n```\nlet a = 1\n```\nFILE: b.js\n```\nlet b = 2\n```")
    check(84, lm_writes() == 2)
    check(85, equals(lm_write_path(0), "a.js") == 1)
    check(86, equals(lm_write_path(1), "b.js") == 1)
    check(87, equals(lm_write_body(1), "let b = 2\n") == 1)
    return 0
}

// ---------------------------------------------------------------------------
// 9. Multi-line bodies survive intact, including blank lines and backticks.
// ---------------------------------------------------------------------------
fn t_multiline_body() -> i64 {
    lm_parse("FILE: a.js\n```\nfunction f() {\n  return 1\n}\n```\nDone.")
    check(90, lm_writes() == 1)
    check(91, equals(lm_write_body(0), "function f() {\n  return 1\n}\n") == 1)
    return 0
}

// ---------------------------------------------------------------------------
// 10. A question gets no writes and the prose is returned whole.
// ---------------------------------------------------------------------------
fn t_question_only() -> i64 {
    lm_parse("What does the parser do with a module level float?")
    check(100, lm_writes() == 0)
    check(101, lm_reads() == 0)
    check(102, equals(LM_SAID, "What does the parser do with a module level float?") == 1)
    check(103, LM_CUT == 0)
    return 0
}

// ---------------------------------------------------------------------------
// 11. A path containing a space is refused rather than guessed at. A small model
//     writing `FILE: my file.js` has already gone wrong, and guessing where the
//     name ends is worse than refusing. Quanta's choice, not the reference's.
// ---------------------------------------------------------------------------
fn t_path_with_space_refused() -> i64 {
    lm_parse("FILE: my file.js\n```\nlet x = 1\n```")
    check(110, lm_writes() == 0)
    // leading and trailing space is trimmed, not refused
    check(111, equals(lm_line_path("  FILE: a.js  ", 0, 13, "FILE:"), "a.js") == 1)
    return 0
}

// ---------------------------------------------------------------------------
// 12. An empty reply writes nothing and says nothing.
// ---------------------------------------------------------------------------
fn t_empty_reply() -> i64 {
    lm_parse("")
    check(120, lm_writes() == 0)
    check(121, lm_reads() == 0)
    check(122, equals(LM_SAID, "") == 1)
    check(123, LM_CUT == 0)
    return 0
}

fn main() -> i64 {
    t_enabled()
    t_system_mentions_format()
    t_basic()
    t_refuses_prose_body()
    t_keyword_boundary()
    t_strips_fake_runs()
    t_cut_off()
    t_last_write_wins()
    t_multiline_body()
    t_question_only()
    t_path_with_space_refused()
    t_empty_reply()

    print("std_light_mode: ")
    if FAIL == 0 {
        print("PASS (43 checks)\n")
        return 0
    }
    print("FAIL "); print(FAIL); print(" check(s)\n")
    return 1
}