// x25519_full_step_test.quanta — test full ladder step

import std/x25519

fn main() {
  println("Test full ladder step...")
  
  let x1 = mem_alloc(8*8)
  let x2 = mem_alloc(8*8)
  let z2 = mem_alloc(8*8)
  let x3 = mem_alloc(8*8)
  let z3 = mem_alloc(8*8)
  let A24 = mem_alloc(8*8)
  
  let t0 = mem_alloc(8*8)
  let t1 = mem_alloc(8*8)
  let t2 = mem_alloc(8*8)
  let t3 = mem_alloc(8*8)
  let t4 = mem_alloc(8*8)
  
  // Initialize with u=9
  let u = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u + i, 0); i = i + 1 }
  mem_store8(u, 9)
  
  fe_from_bytes(u, x1)
  fe_one(x2)
  fe_zero(z2)
  fe_from_bytes(u, x3)
  fe_one(z3)
  
  fe_zero(A24)
  mem_store(A24, 121666)
  
  println("init done")
  
  // Full ladder step (without swap)
  fe_add(x2, z2, t0)
  fe_sub(x2, z2, t1)
  fe_add(x3, z3, t2)
  fe_sub(x3, z3, t3)
  fe_mul(t0, t3, t4)
  fe_mul(t1, t2, t0)
  fe_add(t4, t0, t2)
  fe_sq(t2, x3)
  fe_sub(t4, t0, t3)
  fe_sq(t3, t2)
  fe_mul(t2, x1, z3)
  
  println("P+Q done")
  
  // 2P
  fe_add(x2, z2, t0)
  fe_sq(t0, t2)
  fe_sub(x2, z2, t1)
  fe_sq(t1, t3)
  fe_mul(t2, t3, x2)
  
  println("2P done")
  
  // z2 = 4 * A24 * t0 * t1 + t0 * t1 ??? 
  // Let's use simpler: z2 = 4 * A24 * x2 * z2 * (x2+z2)^2 + 4 * x2 * z2 * (x2-z2)^2
  // Actually we already have t0 = (x2+z2)^2, t1 = (x2-z2)^2
  // x2*z2 = (t0 - t1)/4
  // z2' = (t0 - t1) * t0 + A24 * (t0 - t1) * t1
  
  fe_sub(t0, t1, t4)  // t4 = t0 - t1
  fe_mul(t4, t0, t4)  // t4 = (t0-t1)*t0
  fe_mul(t4, A24, t3) // t3 = A24 * (t0-t1)*t0... wait wrong
  
  println("all ops done")
  println(0)
  exit(0)
}