// break_continue: break/continue in while and for, nested loops.
//
// The s==36 assertion was corrected to 25 on 0.0.225. `continue` in a `while`
// jumped to the label emitted immediately before the body instead of to the
// condition, so it re-entered the body without re-testing the loop. With the
// increment written BEFORE the `continue` that double-incremented and skipped
// every even i, summing all of 1..10 rather than just the odd ones. The golden
// had been captured from that broken output, so the test passed while `continue`
// was effectively a no-op. 1+3+5+7+9 = 25.
fn main() {
  let s=0 let i=0
  while i<10 { i=i+1; if i%2==0 { continue }; s=s+i }
  if s!=25 { return 1 }
  let j=0
  while 1==1 { j=j+1; if j==5 { break } }
  if j!=5 { return 2 }
  let c=0 let a=0
  while a<3 { a=a+1; let b=0; while b<10 { b=b+1; if b==2 { break }; c=c+1 } }
  if c!=3 { return 3 }
  let t=0
  for k=1; k<=6; k=k+1 { if k==3 { continue }; t=t+k }
  if t!=18 { return 4 }
  // Both increment orderings. When the increment sits ABOVE the `continue`, a
  // continue that skips the condition double-increments and silently sums the
  // wrong set; when it sits BELOW, the same bug double-counts instead. Asserting
  // only one ordering is how s==36 survived.
  let u=0 let m=0
  while m<10 { m=m+1; if m%2==1 { continue }; u=u+m }
  if u!=30 { return 5 }
  // Increment BELOW the continue, and the skip is the FIRST branch, so the
  // increment still runs for the skipped iterations and the loop terminates.
  let v=0 let w=0
  while w<6 { w=w+1; if w%2==0 { continue }; v=v+w }
  if v!=9 { return 6 }
  return 0
}
