// Chained method call on a struct-typed field result:
// ln.a is a Point, so ln.a.manhattan() must dispatch as a method on Point.
struct Point {
    x: int
    y: int
}
struct Line {
    a: Point
    b: Point
}
fn manhattan(p: Point) {
    return p.x + p.y
}
fn main() {
    let p1 = Point { x: 3, y: 4 }
    let p2 = Point { x: 7, y: 9 }
    let ln = Line { a: p1, b: p2 }
    let m1 = ln.a.manhattan()  // 3+4 = 7  (field -> method dispatch)
    let m2 = ln.b.manhattan()  // 7+9 = 16
    return m1 + m2             // 23
}
