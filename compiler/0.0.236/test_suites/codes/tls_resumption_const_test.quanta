// TLS Resumption constants test
fn tls_psk_ke(): i64 { return 0 }
fn tls_psk_dhe_ke(): i64 { return 1 }
fn tls_ticket_version(): i64 { return 1 }

fn main() {
    if tls_psk_ke() != 0 { return 1 }
    if tls_psk_dhe_ke() != 1 { return 2 }
    if tls_ticket_version() != 1 { return 3 }
    return 0
}