// x25519_mul4_test.quanta — test fe_mul(t2, x1, z3)

import std/x25519

fn main() {
  println("Test fe_mul(t2, x1)...")
  
  // x1 = 9
  let x1 = mem_alloc(8*8)
  fe_zero(x1)
  mem_store(x1, 9)
  
  // t2 = 81 (9^2)
  let t2 = mem_alloc(8*8)
  fe_zero(t2)
  mem_store(t2, 81)
  
  let z3 = mem_alloc(8*8)
  fe_mul(t2, x1, z3)
  
  println("Done")
  println(0)
  exit(0)
}