fn quic_version(): i64 { return 0x00000001 }
fn quic_pt_initial(): i64 { return 0x00 }
fn quic_pt_0rtt(): i64 { return 0x40 }
fn quic_pt_handshake(): i64 { return 0x80 }
fn quic_pt_1rtt(): i64 { return 0xC0 }
fn quic_frame_crypto(): i64 { return 0x06 }
fn quic_frame_ack(): i64 { return 0x02 }
fn quic_frame_stream(): i64 { return 0x08 }
fn quic_frame_max_data(): i64 { return 0x10 }
fn quic_max_cid_len(): i64 { return 20 }
fn quic_initial_max_data(): i64 { return 10485760 }
fn quic_initial_max_stream_data_bidi_local(): i64 { return 1048576 }
fn quic_initial_max_streams_bidi(): i64 { return 100 }
fn quic_default_idle_timeout(): i64 { return 30000 }
fn quic_max_packet_size(): i64 { return 1350 }
fn quic_state_initial(): i64 { return 0 }
fn quic_state_handshake(): i64 { return 1 }
fn quic_state_established(): i64 { return 2 }
fn quic_level_initial(): i64 { return 0 }
fn quic_level_1rtt(): i64 { return 3 }

fn main() {
    if quic_version() != 0x00000001 { exit(1) }
    if quic_pt_initial() != 0x00 { exit(2) }
    if quic_pt_1rtt() != 0xC0 { exit(3) }
    if quic_frame_crypto() != 0x06 { exit(4) }
    if quic_frame_ack() != 0x02 { exit(5) }
    if quic_frame_stream() != 0x08 { exit(6) }
    if quic_frame_max_data() != 0x10 { exit(7) }
    if quic_max_cid_len() != 20 { exit(8) }
    if quic_initial_max_data() != 10485760 { exit(9) }
    if quic_initial_max_stream_data_bidi_local() != 1048576 { exit(10) }
    if quic_initial_max_streams_bidi() != 100 { exit(11) }
    if quic_default_idle_timeout() != 30000 { exit(12) }
    if quic_max_packet_size() != 1350 { exit(13) }
    if quic_state_initial() != 0 { exit(14) }
    if quic_state_established() != 2 { exit(15) }
    if quic_level_initial() != 0 { exit(16) }
    if quic_level_1rtt() != 3 { exit(17) }
    exit(0)
}