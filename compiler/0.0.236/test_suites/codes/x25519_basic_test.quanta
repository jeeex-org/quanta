// x25519_basic_test.quanta — test basic ops

import std/x25519

fn print_hex(label, ptr, n) {
  let s = ""
  let i = 0
  while i < n {
    let b = mem_load8(ptr + i)
    let hi = b >> 4; let lo = b & 0xf
    if hi < 10 { s = str(s, hi + 48) } else { s = str(s, hi + 87) }
    if lo < 10 { s = str(s, lo + 48) } else { s = str(s, lo + 87) }
    i = i + 1
  }
  println(s)
}

fn main() {
  println("Test fe_zero...")
  let x = mem_alloc(5*8)
  fe_zero(x)
  println("fe_zero done")
  print_hex("x", x, 40)
  
  println("Test fe_one...")
  let y = mem_alloc(5*8)
  fe_one(y)
  println("fe_one done")
  print_hex("y", y, 40)
  
  println("Test fe_copy...")
  let z = mem_alloc(5*8)
  fe_copy(y, z)
  println("fe_copy done")
  print_hex("z", z, 40)
  
  println(0)
  exit(0)
}