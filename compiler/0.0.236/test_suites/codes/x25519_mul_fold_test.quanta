// x25519_mul_fold_test.quanta — test fe_mul with fold

import std/x25519

fn main() {
  println("Test fe_mul fold...")
  
  let a = mem_alloc(8*8)
  fe_zero(a)
  mem_store(a, 9)
  
  let b = mem_alloc(8*8)
  fe_zero(b)
  mem_store(b, 9)
  
  let out = mem_alloc(8*8)
  fe_mul(a, b, out)
  
  println("Done")
  println(0)
  exit(0)
}