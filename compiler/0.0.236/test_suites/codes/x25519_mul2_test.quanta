// x25519_mul2_test.quanta — test specific fe_mul

import std/x25519

fn main() {
  println("Test fe_mul case 2...")
  
  // Setup values
  let t2 = mem_alloc(8*8)
  fe_zero(t2)
  mem_store(t2, 1)  // x2 = 1
  
  let t3 = mem_alloc(8*8)
  fe_zero(t3)
  mem_store(t3, 0)  // z2 = 0
  
  let x2 = mem_alloc(8*8)
  fe_mul(t2, t3, x2)
  println("mul x2=1*0 done")
  
  // t2 - t3
  let t4 = mem_alloc(8*8)
  fe_sub(t2, t3, t4)
  println("sub t4 done")
  
  // t4 * t2
  let t0 = mem_alloc(8*8)
  fe_mul(t4, t2, t0)
  println("mul t4*t2 done")
  
  // t4 * t3
  let t1 = mem_alloc(8*8)
  fe_mul(t4, t3, t1)
  println("mul t4*t3 done")
  
  println("Done")
  println(0)
  exit(0)
}