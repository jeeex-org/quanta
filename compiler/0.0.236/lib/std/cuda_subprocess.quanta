// cuda_subprocess.quanta — file-based subprocess CUDA wrapper for Quanta Phase 7.
//
// Quanta's memory management is incompatible with CUDA driver's internal mmap,
// causing a segfault on the first CUDA call from a Quanta-compiled binary. The
// driver returns 0 from cudaSetDevice and then faults inside its own mmap.
//
// This module works around that by running every CUDA operation in a separate C
// helper process (scripts/audit/cuda_helper_file). Quanta writes a one-line
// command to CUDA_CMD_FILE, forks+execs the helper, and reads the reply from
// CUDA_RESULT_FILE.
//
// x86-64 syscalls: fork=57, execve=59, wait4=61, exit=60

import std/fs

const CUDA_HELPER_PATH = "/opt/tali/quanta/scripts/audit/cuda_helper_file"
const CUDA_CMD_FILE = "/tmp/cuda_cmd.txt"
const CUDA_RESULT_FILE = "/tmp/cuda_result.txt"

// Copy a Quanta string literal into a NUL-terminated raw byte buffer.
//
// A Quanta string is NOT a C string: the length is stored at [ptr] and the
// bytes live at [ptr+8]. Indexing one with s[i] therefore reads the length
// header as if it were a character, and comparing it against 0 ends the copy
// after zero bytes. Every command built that way reached the helper empty.
// len() and +8 are the only correct accessors.
//
// Returns the number of bytes written, not counting the NUL.
fn cuda_cstr(dst, s) -> i64 {
    let n = len(s)
    let i = 0
    while i < n {
        mem_store8(dst + i, mem_load8(s + 8 + i))
        i = i + 1
    }
    mem_store8(dst + n, 0)
    return n
}

// Append a Quanta string to a raw byte buffer at `pos`. Returns the new pos.
fn cuda_cat(dst, pos, s) -> i64 {
    let n = len(s)
    let i = 0
    while i < n {
        mem_store8(dst + pos + i, mem_load8(s + 8 + i))
        i = i + 1
    }
    return pos + n
}

// Append an integer in decimal to a raw byte buffer at `pos`. Returns new pos.
fn cuda_cat_u64(dst, pos, v) -> i64 {
    let tmp = mem_alloc(32)
    let tpos = 0
    if v == 0 {
        mem_store8(tmp, 48)
        tpos = 1
    }
    let x = v
    while x > 0 {
        mem_store8(tmp + tpos, 48 + (x % 10))
        x = x / 10
        tpos = tpos + 1
    }
    let out = pos
    while tpos > 0 {
        tpos = tpos - 1
        mem_store8(dst + out, mem_load8(tmp + tpos))
        out = out + 1
    }
    mem_free(tmp)
    return out
}

// Append an integer in lowercase hex to a raw byte buffer at `pos`.
// Returns the new pos.
fn cuda_cat_hex(dst, pos, v) -> i64 {
    let tmp = mem_alloc(32)
    let tpos = 0
    if v == 0 {
        mem_store8(tmp, 48)
        tpos = 1
    }
    let x = v
    while x > 0 {
        let d = x % 16
        if d < 10 { mem_store8(tmp + tpos, 48 + d) }
        else { mem_store8(tmp + tpos, 97 + d - 10) }
        x = x / 16
        tpos = tpos + 1
    }
    let out = pos
    while tpos > 0 {
        tpos = tpos - 1
        mem_store8(dst + out, mem_load8(tmp + tpos))
        out = out + 1
    }
    mem_free(tmp)
    return out
}

// Run the helper once and return its exit code.
// `cmd` is a NUL-terminated raw byte buffer, `n` its length without the NUL.
fn cuda_exec(cmd, n) -> i64 {
    // Write the command.
    let fd = open(CUDA_CMD_FILE, 577, 420)  // O_WRONLY|O_CREAT|O_TRUNC, 0644
    if fd < 0 { return -1 }
    write_raw(fd, cmd, n)
    close(fd)

    // Fork and exec through /bin/sh: a direct execve of the helper fails with
    // EACCES on this noexec mount, and /bin/sh can still run it.
    let pid = syscall(57, 0, 0, 0)
    if pid < 0 { return -1 }

    if pid == 0 {
        let sh = mem_alloc(16)
        let dash_c = mem_alloc(8)
        let cmdbuf = mem_alloc(256)
        let argv = mem_alloc(32)

        cuda_cstr(sh, "/bin/sh")
        cuda_cstr(dash_c, "-c")
        cuda_cstr(cmdbuf, CUDA_HELPER_PATH)

        mem_store(argv, sh)
        mem_store(argv + 8, dash_c)
        mem_store(argv + 16, cmdbuf)
        mem_store(argv + 24, 0)

        // execve(path, argv, envp). argv[0] is the program name, so it must be
        // the helper path rather than the "sh" we wrote into sh.
        mem_store(argv, cmdbuf)
        syscall(59, sh, argv, 0)
        syscall(60, 1)  // exit(1) if execve fails
    }

    let status = mem_alloc(8)
    let wpid = syscall(61, pid, status, 0)
    if wpid < 0 { return -1 }

    // wait4 status encodes the exit code in bits 8..15; raw syscall 61 returns
    // that word, not a bare exit code.
    let st = mem_load(status)
    return (st >> 8) & 0xFF
}

// Read the helper's reply. Returns a raw buffer, or 0 if there is none.
fn cuda_read_result() -> i64 {
    let fd = open(CUDA_RESULT_FILE, 0, 0)
    if fd < 0 { return 0 }
    let buf = mem_alloc(1024)
    let n = read_raw(fd, buf, 1023)
    close(fd)
    if n <= 0 { mem_free(buf); return 0 }
    mem_store8(buf + n, 0)
    return buf
}

// TRUE when the reply begins with "OK".
fn cuda_reply_ok(buf) -> i64 {
    if buf == 0 { return 0 }
    if mem_load8(buf) == 79 && mem_load8(buf + 1) == 75 { return 1 }
    return 0
}

// Parse a "0x..." hex pointer out of a reply. Returns 0 if there is none.
fn cuda_parse_ptr(buf) -> i64 {
    if buf == 0 { return 0 }
    let ptr = 0
    let k = 0
    while mem_load8(buf + k) != 0 {
        let c = mem_load8(buf + k)
        if c == 10 { break }
        if c == 48 && mem_load8(buf + k + 1) == 120 { k = k + 2; continue }  // "0x"
        if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) { break }
        ptr = ptr * 16
        if c >= 48 && c <= 57 { ptr = ptr + (c - 48) }
        else { ptr = ptr + (c - 97 + 10) }
        k = k + 1
    }
    return ptr
}

// Initialize the CUDA device. Returns 0 on success, -1 on failure.
fn cuda_init() -> i64 {
    let cmd = mem_alloc(16)
    let n = cuda_cat(cmd, 0, "init")
    mem_store8(cmd + n, 10)
    let rc = cuda_exec(cmd, n + 1)
    mem_free(cmd)
    if rc != 0 { return -1 }
    let resp = cuda_read_result()
    let ok = cuda_reply_ok(resp)
    if resp != 0 { mem_free(resp) }
    if ok == 0 { return -1 }
    return 0
}

// Allocate GPU memory. Returns the device pointer, or 0 on failure.
fn gpu_malloc(size) -> i64 {
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "malloc ")
    n = cuda_cat_u64(cmd, n, size)
    mem_store8(cmd + n, 10)
    let rc = cuda_exec(cmd, n + 1)
    mem_free(cmd)
    if rc != 0 { return 0 }
    let resp = cuda_read_result()
    let ptr = cuda_parse_ptr(resp)
    if resp != 0 { mem_free(resp) }
    return ptr
}

// Free GPU memory.
fn gpu_free(ptr) {
    if ptr == 0 { return }
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "free ")
    n = cuda_cat_hex(cmd, n, ptr)
    mem_store8(cmd + n, 10)
    cuda_exec(cmd, n + 1)
    mem_free(cmd)
    let resp = cuda_read_result()
    if resp != 0 { mem_free(resp) }
}

// Allocate pinned host memory. Returns the pointer, or 0 on failure.
fn host_alloc(size) -> i64 {
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "host_alloc ")
    n = cuda_cat_u64(cmd, n, size)
    mem_store8(cmd + n, 10)
    let rc = cuda_exec(cmd, n + 1)
    mem_free(cmd)
    if rc != 0 { return 0 }
    let resp = cuda_read_result()
    let ptr = cuda_parse_ptr(resp)
    if resp != 0 { mem_free(resp) }
    return ptr
}

// Free pinned host memory.
fn host_free(ptr) {
    if ptr == 0 { return }
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "host_free ")
    n = cuda_cat_hex(cmd, n, ptr)
    mem_store8(cmd + n, 10)
    cuda_exec(cmd, n + 1)
    mem_free(cmd)
    let resp = cuda_read_result()
    if resp != 0 { mem_free(resp) }
}

// Create a CUDA stream. Returns the handle, or 0 on failure.
fn stream_create() -> i64 {
    let cmd = mem_alloc(32)
    let n = cuda_cat(cmd, 0, "stream_create")
    mem_store8(cmd + n, 10)
    let rc = cuda_exec(cmd, n + 1)
    mem_free(cmd)
    if rc != 0 { return 0 }
    let resp = cuda_read_result()
    let ptr = cuda_parse_ptr(resp)
    if resp != 0 { mem_free(resp) }
    return ptr
}

// Synchronize a CUDA stream.
fn stream_sync(stream) {
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "stream_sync ")
    n = cuda_cat_hex(cmd, n, stream)
    mem_store8(cmd + n, 10)
    cuda_exec(cmd, n + 1)
    mem_free(cmd)
    let resp = cuda_read_result()
    if resp != 0 { mem_free(resp) }
}

// Copy a host file to a device pointer. src_file is a Quanta string.
fn memcpy_h2d_async(src_file, dst_ptr, size) -> i64 {
    let cmd = mem_alloc(512)
    let n = cuda_cat(cmd, 0, "h2d ")
    n = cuda_cat_hex(cmd, n, dst_ptr)
    mem_store8(cmd + n, 32)  // space
    n = n + 1
    n = cuda_cat(cmd, n, src_file)
    mem_store8(cmd + n, 32)
    n = n + 1
    n = cuda_cat_u64(cmd, n, size)
    mem_store8(cmd + n, 10)
    let rc = cuda_exec(cmd, n + 1)
    mem_free(cmd)
    let resp = cuda_read_result()
    let ok = cuda_reply_ok(resp)
    if resp != 0 { mem_free(resp) }
    if ok == 0 { return -1 }
    return 0
}

// Copy a device pointer into a host file. dst_file is a Quanta string.
fn memcpy_d2h_async(src_ptr, dst_file, size) -> i64 {
    let cmd = mem_alloc(512)
    let n = cuda_cat(cmd, 0, "d2h ")
    n = cuda_cat_hex(cmd, n, src_ptr)
    mem_store8(cmd + n, 32)
    n = n + 1
    n = cuda_cat(cmd, n, dst_file)
    mem_store8(cmd + n, 32)
    n = n + 1
    n = cuda_cat_u64(cmd, n, size)
    mem_store8(cmd + n, 10)
    let rc = cuda_exec(cmd, n + 1)
    mem_free(cmd)
    let resp = cuda_read_result()
    let ok = cuda_reply_ok(resp)
    if resp != 0 { mem_free(resp) }
    if ok == 0 { return -1 }
    return 0
}