// ===========================================================================
// Temperature ceiling and logit scaling -- Phase 11.3
//
// An agent copies text exactly, writes paths and arguments in a fixed shape,
// and reports what it ran. A model that samples widely does each of those
// wrongly now and then, and a SMALL model does so most, so it is held lowest.
// HashCortX states this at src/platform/tauri/hashcoder.js:1074 and implements
// it as:
//
//   TEMPERATURE_CEILING = { small: 0.1, mid: 0.2, full: 0.35 }
//   temperatureFor = (size, chosen) => {
//     const ceiling = TEMPERATURE_CEILING[size] ?? TEMPERATURE_CEILING.full
//     return isFinite(chosen) ? min(max(chosen, 0), ceiling) : min(0.15, ceiling)
//   }
//
// TWO RULES THAT ARE THE WHOLE POINT, both kept exactly:
//
// 1. The tier figure is a CEILING, never a target. A user who set the slider
//    LOWER is obeyed. A higher request is clamped down, not granted -- the
//    slider cannot buy more randomness than the model's size allows.
// 2. A missing or nonsensical user value falls back to 0.15, itself clamped by
//    the ceiling. So a small model gets 0.1 even when nothing was chosen.
//
// WHAT IS ADDED ON TOP OF THE REFERENCE
//
// HashCortX sends a temperature to a provider it did not load. Quanta runs the
// model, so it has to APPLY it, which means scaling logits before the softmax:
// dividing logits by T. That is the whole mechanism, and it is worth writing
// down because the special cases are where it goes wrong:
//
//   T <= 0     -> greedy (argmax). Dividing by zero is not "infinite
//                 temperature", it is NaN, so this is handled before any divide.
//   T == 1     -> a copy: the array is left untouched.
//   T < 1      -> sharpening, the usual "low temperature" behaviour.
//   T > 1      -> flattening.
//
// Logits are shifted by their max before dividing, because dividing a large
// positive logit by a small T can overflow f64 to +inf, and inf - inf in the
// softmax is NaN. The shift is exact in the sense that softmax(x) == softmax(x-c)
// for any c, so this changes no result -- only whether the arithmetic survives.
//
// No RNG here on purpose. Sampling needs one, and this phase does not: it
// rescales and reports. rand() is currently broken (it mmaps 8 bytes, then
// reads the POINTER rather than dereferencing it, so it segfaults), and a
// sampler built on it would be built on a known fault.

import std/math

// Ceilings by size class. Indexed to match QSIZE_SMALL / QSIZE_MID / QSIZE_FULL
// in std/model_size, but written as explicit cases so this file stands alone.
let QTEMP_CEILING_SMALL = 0.1
let QTEMP_CEILING_MID = 0.2
let QTEMP_CEILING_FULL = 0.35
let QTEMP_DEFAULT = 0.15

fn qtemp_ceiling_for(size: i64) -> f64 {
    if size == 1 { return QTEMP_CEILING_SMALL }
    if size == 2 { return QTEMP_CEILING_MID }
    return QTEMP_CEILING_FULL
}

// Resolve the temperature to actually use.
//   size   -- QSIZE_* class from qmodel_size_class
//   chosen -- the user's value; negative means "not set"
// Returns a value in [0, ceiling].
fn qtemp_for(size: i64, chosen: f64) -> f64 {
    let ceiling = qtemp_ceiling_for(size)
    if chosen < 0.0 {
        let d = QTEMP_DEFAULT
        if d > ceiling { return ceiling }
        return d
    }
    if chosen > ceiling { return ceiling }
    return chosen
}

// Scale `n` logits in place by 1/T, ready for softmax.
//
// T <= 0 means GREEDY, which is expressed here as a documented no-op: the caller
// should take argmax instead of sampling, and doing that with un-scaled logits
// is exactly right. We do not write -inf here because a later softmax would
// then produce NaN, and "tell the caller to be greedy" is clearer than "poison
// the array".
//
// T == 1 returns 1 immediately: a copy would be a pure cost, and the array is
// already in the right shape.
fn qtemp_scale(logits: u64, n: i64, t: f64) -> i64 {
    if n <= 0 { return 0 - 1 }
    if t <= 0.0 { return 1 }        // greedy: caller takes argmax, no scaling
    if t == 1.0 { return 0 }        // already correct

    // Shift by the max so a large positive logit over a small T cannot overflow.
    // softmax is shift-invariant, so this does not change the distribution.
    let mx = f64of(mem_load(logits))
    let i = 1
    while i < n {
        let x = f64of(mem_load(logits + i * 8))
        if x > mx { mx = x }
        i = i + 1
    }
    i = 0
    while i < n {
        let x = f64of(mem_load(logits + i * 8))
        let s = (x - mx) / t
        // A scaled logit that reached +inf or NaN is clamped rather than passed
        // on: a poisoned softmax produces NaN probabilities and then an
        // arbitrary token, which is far worse than a merely greedy one.
        if s > 700.0 { s = 700.0 }
        if s < 0.0 - 700.0 { s = 0.0 - 700.0 }
        mem_store(logits + i * 8, s)
        i = i + 1
    }
    return 0
}
