// cuda_daemon.quanta — persistent CUDA context, driven from Quanta.
//
// WHY A DAEMON
// ------------
// Quanta cannot call CUDA directly: cudaSetDevice returns 0 and the driver then
// faults inside its own mmap, because the address-space ceiling Quanta runs
// under is far below what the CUDA driver reserves. Running each call in its own
// helper process dodges that, but a device pointer from cudaMalloc does not
// survive a process boundary -- every new process gets a fresh CUDA context, so
// a fork-per-call design can allocate and can never copy.
//
// scripts/audit/cuda_daemon.c solves both: one long-lived process owns a single
// CUDA context, so the pointers it hands out stay valid. Pipes would be the
// natural transport but are unusable here -- pipe() returns 0 with garbage
// descriptors and socketpair() returns ENOSYS under this syscall wrapper -- so
// the transport is two files:
//
//   /tmp/quanta_cuda/queue   append-only: "<seq> <command>"
//   /tmp/quanta_cuda/result  append-only: "<seq> <reply>"
//
// The seq number is ours and is echoed back, which is what makes a timeout
// distinguishable from a reply: without it, a command that the daemon never
// answered would read as an empty result and look like success.

import std/fs

const CUDA_QUEUE  = "/tmp/quanta_cuda/queue"
const CUDA_RESULT = "/tmp/quanta_cuda/result"

// Sequence number for the next command. Monotonic, so a reply can always be
// matched to the command that asked for it.
let cuda_seq = 0
// How many result lines we have already consumed, so we never re-read a reply.
let cuda_result_pos = 0

// Copy a Quanta string literal into a NUL-terminated raw byte buffer.
//
// A Quanta string is not a C string: length sits at [ptr] and the bytes live at
// [ptr+8]. Indexing one as s[i] reads the length header as a character, and
// comparing that to 0 ends the copy immediately -- which is how an earlier
// version of this file sent the helper an empty command and made CUDA look
// broken. len() and +8 are the only correct accessors.
//
// Returns the byte count written, excluding the NUL.
fn cuda_cstr(dst, s) -> i64 {
    let n = len(s)
    let i = 0
    while i < n {
        mem_store8(dst + i, mem_load8(s + 8 + i))
        i = i + 1
    }
    mem_store8(dst + n, 0)
    return n
}

// Append a Quanta string to a raw buffer at pos. Returns the new pos.
fn cuda_cat(dst, pos, s) -> i64 {
    let n = len(s)
    let i = 0
    while i < n {
        mem_store8(dst + pos + i, mem_load8(s + 8 + i))
        // `i = i + 1`, NOT `i = pos + i + 1`. Advancing i by pos as well ran the
        // index past the end of the source string, so every character read came
        // back as zero and the filename arrived as blank spaces.
        i = i + 1
    }
    return pos + n
}

// Append a non-negative integer in decimal. Returns the new pos.
fn cuda_cat_u64(dst, pos, v) -> i64 {
    let tmp = mem_alloc(32)
    let tpos = 0
    if v == 0 {
        mem_store8(tmp, 48)
        tpos = 1
    }
    let x = v
    while x > 0 {
        mem_store8(tmp + tpos, 48 + (x % 10))
        x = x / 10
        tpos = tpos + 1
    }
    let out = pos
    while tpos > 0 {
        tpos = tpos - 1
        mem_store8(dst + out, mem_load8(tmp + tpos))
        out = out + 1
    }
    mem_free(tmp)
    return out
}

// Append a pointer in lowercase hex, as the daemon expects. Returns new pos.
fn cuda_cat_hex(dst, pos, v) -> i64 {
    let tmp = mem_alloc(32)
    let tpos = 0
    if v == 0 {
        mem_store8(tmp, 48)
        tpos = 1
    }
    let x = v
    while x > 0 {
        let d = x % 16
        if d < 10 { mem_store8(tmp + tpos, 48 + d) }
        else { mem_store8(tmp + tpos, 97 + d - 10) }
        x = x / 16
        tpos = tpos + 1
    }
    let out = pos
    while tpos > 0 {
        tpos = tpos - 1
        mem_store8(dst + out, mem_load8(tmp + tpos))
        out = out + 1
    }
    mem_free(tmp)
    return out
}

// Append a space.
fn cuda_cat_sp(dst, pos) -> i64 {
    mem_store8(dst + pos, 32)
    return pos + 1
}

// TRUE when the daemon's queue and result files exist.
fn cuda_daemon_ready() -> i64 {
    let f = open(CUDA_QUEUE, 0, 0)
    if f < 0 { return 0 }
    close(f)
    let g = open(CUDA_RESULT, 0, 0)
    if g < 0 { return 0 }
    close(g)
    return 1
}

// Move the result cursor past lines we have already handled.
fn cuda_drain_result() -> i64 {
    let fd = open(CUDA_RESULT, 0, 0)
    if fd < 0 { return 0 }
    let size = file_size(fd)
    close(fd)
    if size > cuda_result_pos {
        cuda_result_pos = size
    }
    return 0
}

// Read the reply for `seq`, leaving the cursor exactly where it should be.
//
// Returns 1 when the reply was found (body copied to out_len_ptr), 0 otherwise.
//
// THE BUG THIS FIXES, which is what "the CUDA daemon is unstable" actually was:
// the previous version advanced the cursor to the end of the LAST COMPLETE LINE
// in the buffer and only then looked for the wanted seq. If the wanted seq was
// not among the lines it had just read past, those lines were skipped forever.
//
// It fires whenever two replies land between two polls. Polling for seq 6 with
// "6 OK\n7 0x7f...\n" buffered moved the cursor past BOTH, returned seq 6, and
// the next poll for seq 7 started reading after its own reply -- 20000 spins,
// return 0, and the caller saw a failure for an operation that had SUCCEEDED.
// It showed up as flapping tests and looked like a daemon crash.
//
// Replies are appended in seq order, so the cursor only ever needs to move past
// lines that were actually consumed:
//   seq == want -> consume it, advance past it, return 1
//   seq <  want -> stale (already answered), advance past it, keep looking
//   seq >  want -> not arrived yet; do NOT advance past it, return 0
fn cuda_take_reply(seq, out_len_ptr) -> i64 {
    let fd = open(CUDA_RESULT, 0, 0)
    if fd < 0 { return 0 }
    let size = file_size(fd)
    if size <= cuda_result_pos {
        close(fd)
        return 0
    }
    lseek(fd, cuda_result_pos, 0)
    let buf = mem_alloc(4096)
    let n = read_raw(fd, buf, 4000)
    close(fd)
    if n <= 0 { mem_free(buf); return 0 }

    let consumed = 0        // bytes of complete lines we are allowed to skip
    let found = 0
    let start = 0
    while start < n {
        // Find the end of this line. No newline yet means it is still being
        // appended: stop, and leave it for the next call.
        let end = start
        while end < n && mem_load8(buf + end) != 10 { end = end + 1 }
        if end >= n { break }               // partial line

        // Parse "<seq> <body>".
        let got = 0
        let p = start
        while p < end {
            let c = mem_load8(buf + p)
            if c < 48 || c > 57 { break }
            got = got * 10 + (c - 48)
            p = p + 1
        }

        if got == seq {
            let b = p
            if b < end && mem_load8(buf + b) == 32 { b = b + 1 }
            let blen = end - b
            let i2 = 0
            while i2 < blen {
                mem_store8(out_len_ptr + i2, mem_load8(buf + b + i2))
                i2 = i2 + 1
            }
            mem_store8(out_len_ptr + blen, 0)
            consumed = end + 1
            found = 1
            break
        }
        if got < seq {
            // A reply to an older command. Safe to step over.
            consumed = end + 1
            start = end + 1
            continue
        }
        // got > seq: our reply has not arrived. Do not consume this line.
        break
    }

    // Advance ONLY past what we consumed. This is the fix: previously this moved
    // to the end of every complete line regardless of whether it was ours.
    cuda_result_pos = cuda_result_pos + consumed
    mem_free(buf)
    return found
}

// Send one command line to the daemon and wait for its reply.
// `cmd` is a raw NUL-terminated byte buffer, `n` its length.
// Returns a raw buffer holding the reply body, or 0 on failure.
fn cuda_call(cmd, n) -> i64 {
    cuda_seq = cuda_seq + 1
    let seq = cuda_seq

    // "<seq> <cmd>\n"
    let line = mem_alloc(n + 32)
    let p = cuda_cat_u64(line, 0, seq)
    p = cuda_cat_sp(line, p)
    let i = 0
    while i < n {
        mem_store8(line + p + i, mem_load8(cmd + i))
        i = i + 1
    }
    let ln = p + n
    mem_store8(line + ln, 10)

    // Append to the queue. O_APPEND keeps concurrent writers from clobbering.
    let fd = open(CUDA_QUEUE, 1089, 420)   // O_WRONLY|O_APPEND|O_CREAT
    if fd < 0 { mem_free(line); return 0 }
    write_raw(fd, line, ln + 1)
    close(fd)
    mem_free(line)

    // Poll for the reply. Bounded so a dead daemon cannot hang the caller.
    //
    // NOTE: cuda_take_reply fills `reply_buf`, not the buffer passed to it for
    // allocation. Returning `buf` here handed callers a block of zeros, so
    // cuda_reply_ok() never saw "OK" and every call looked like a failure even
    // when the daemon had answered correctly.
    let reply_buf = mem_alloc(4096)
    let tries = 0
    let got = 0
    while tries < 20000 {
        if cuda_take_reply(seq, reply_buf) == 1 { got = 1; break }
        // Busy-wait: there is no sleep builtin, and the round trip is a file
        // append, so spinning briefly is cheaper than a round of syscalls.
        tries = tries + 1
    }
    if got == 0 { mem_free(reply_buf); return 0 }
    return reply_buf
}

// TRUE when a reply body reports success.
fn cuda_reply_ok(body) -> i64 {
    if body == 0 { return 0 }
    if mem_load8(body) == 79 && mem_load8(body + 1) == 75 { return 1 }
    return 0
}

// Parse a "0x..." pointer out of a reply body. Returns 0 if there is none.
fn cuda_parse_ptr(body) -> i64 {
    if body == 0 { return 0 }
    let ptr = 0
    let k = 0
    while mem_load8(body + k) != 0 {
        let c = mem_load8(body + k)
        if c == 48 && mem_load8(body + k + 1) == 120 { k = k + 2; continue }
        if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) { break }
        ptr = ptr * 16
        if c >= 48 && c <= 57 { ptr = ptr + (c - 48) }
        else { ptr = ptr + (c - 97 + 10) }
        k = k + 1
    }
    return ptr
}

// Prepare the client side. Fails loudly if the daemon is not running, because
// every other call would otherwise fail in a much less obvious way.
fn cuda_init() -> i64 {
    if cuda_daemon_ready() == 0 { return -1 }
    // Skip everything already in the result file, then start seq numbering at 1.
    //
    // cuda_result_pos = 0 here was a real defect. It rewound the cursor to the
    // START of the file, so the first lookup (seq 1) matched a reply left by an
    // EARLIER init -- the daemon echoes seq numbers, and a second cuda_init
    // re-uses seq 1. The client then read a stale "OK" as the answer to a
    // different command, and every subsequent reply was off by one. It showed up
    // as cuda_pool_init returning -1 while the daemon log showed all four
    // stream_create calls succeeding.
    //
    // Draining (not rewinding) is the correct pairing with restarting the seq at
    // 1: the cursor must stay ahead of everything already written.
    cuda_drain_result()
    cuda_seq = 0
    let cmd = mem_alloc(16)
    let n = cuda_cstr(cmd, "init")
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return -1 }
    let ok = cuda_reply_ok(body)
    mem_free(body)
    if ok == 0 { return -1 }
    return 0
}

// Allocate device memory. Returns the pointer, or 0 on failure.
fn gpu_malloc(size) -> i64 {
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "malloc ")
    n = cuda_cat_u64(cmd, n, size)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return 0 }
    let ptr = cuda_parse_ptr(body)
    mem_free(body)
    return ptr
}

// Free device memory.
fn gpu_free(ptr) {
    if ptr == 0 { return }
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "free ")
    n = cuda_cat_hex(cmd, n, ptr)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body != 0 { mem_free(body) }
}

// Allocate pinned host memory. Returns the pointer, or 0 on failure.
fn host_alloc(size) -> i64 {
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "host_alloc ")
    n = cuda_cat_u64(cmd, n, size)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return 0 }
    let ptr = cuda_parse_ptr(body)
    mem_free(body)
    return ptr
}

// Free pinned host memory.
fn host_free(ptr) {
    if ptr == 0 { return }
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "host_free ")
    n = cuda_cat_hex(cmd, n, ptr)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body != 0 { mem_free(body) }
}

// Create a stream. Returns the handle, or 0 on failure.
fn stream_create() -> i64 {
    let cmd = mem_alloc(32)
    let n = cuda_cstr(cmd, "stream_create")
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return 0 }
    let h = cuda_parse_ptr(body)
    mem_free(body)
    return h
}

// Destroy a stream.
fn stream_destroy(stream) {
    if stream == 0 { return }
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "stream_destroy ")
    n = cuda_cat_hex(cmd, n, stream)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body != 0 { mem_free(body) }
}

// Synchronize a stream.
fn stream_sync(stream) {
    let cmd = mem_alloc(64)
    let n = cuda_cat(cmd, 0, "stream_sync ")
    n = cuda_cat_hex(cmd, n, stream)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body != 0 { mem_free(body) }
}

// Copy a host file to a device pointer. src_file is a Quanta string.
// Copies on the DEFAULT stream (0).
fn memcpy_h2d_async(src_file, dst_ptr, size) -> i64 {
    return memcpy_h2d_on(src_file, dst_ptr, size, 0)
}

// Copy a host file to a device pointer on a NAMED stream. src_file is a Quanta
// string.
//
// Phase 7 item 3/4. The reply means the copy has been ISSUED on that stream,
// not that it has finished: the daemon no longer synchronises before replying,
// which is precisely what lets several copies be in flight at once. Call
// stream_sync() on the stream when the data is actually needed.
fn memcpy_h2d_on(src_file, dst_ptr, size, stream) -> i64 {
    let cmd = mem_alloc(1024)
    let n = cuda_cat(cmd, 0, "h2d ")
    n = cuda_cat_hex(cmd, n, dst_ptr)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat(cmd, n, src_file)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_u64(cmd, n, size)
    if stream != 0 {
        n = cuda_cat_sp(cmd, n)
        n = cuda_cat_hex(cmd, n, stream)
    }
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return -1 }
    let ok = cuda_reply_ok(body)
    mem_free(body)
    if ok == 0 { return -1 }
    return 0
}

// Copy a device pointer into a host file. dst_file is a Quanta string.
// Copies on the DEFAULT stream (0).
fn memcpy_d2h_async(src_ptr, dst_file, size) -> i64 {
    return memcpy_d2h_on(src_ptr, dst_file, size, 0)
}

// Copy a device pointer into a host file on a NAMED stream.
//
// NOTE: d2h is NOT left asynchronous even though the copy is issued on the
// stream. The reply has to mean the bytes are on disk, and the file write
// cannot start until the transfer lands, so the daemon synchronises this stream
// before replying. H2D is the direction that can be pipelined.
fn memcpy_d2h_on(src_ptr, dst_file, size, stream) -> i64 {
    let cmd = mem_alloc(1024)
    let n = cuda_cat(cmd, 0, "d2h ")
    n = cuda_cat_hex(cmd, n, src_ptr)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat(cmd, n, dst_file)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_u64(cmd, n, size)
    if stream != 0 {
        n = cuda_cat_sp(cmd, n)
        n = cuda_cat_hex(cmd, n, stream)
    }
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return -1 }
    let ok = cuda_reply_ok(body)
    mem_free(body)
    if ok == 0 { return -1 }
    return 0
}

// ---------------------------------------------------------------------------
// Stream pool (Phase 7 item 3).
//
// A fixed set of streams handed out round-robin, so consecutive H2D copies land
// on different streams and overlap instead of serialising behind each other. The
// size is a compile-time constant rather than a pool sized to the workload: the
// point is to have more streams than any single copy pipeline needs, and a large
// enough pool would just queue work the caller never waits on.
const CUDA_POOL_N = 4
let cuda_pool = 0          // array of CUDA_POOL_N handles
let cuda_pool_next = 0     // round-robin cursor

// Create the pool. Returns the number of streams created, or -1 on failure.
fn cuda_pool_init() -> i64 {
    if cuda_pool != 0 { return CUDA_POOL_N }
    if cuda_init() != 0 { return -1 }
    cuda_pool = mem_alloc(CUDA_POOL_N * 8)
    // mem_alloc does NOT zero. Without this, a stream_create that fails on the
    // first iteration leaves slots 1..3 holding garbage, and the failure-path
    // cuda_pool_free() hands that garbage to cudaStreamDestroy -- which faults
    // inside libcuda instead of returning an error.
    let z = 0
    while z < CUDA_POOL_N { mem_store(cuda_pool + z * 8, 0); z = z + 1 }
    let made = 0
    let i = 0
    while i < CUDA_POOL_N {
        let h = stream_create()
        if h == 0 {
            // A pool is only useful if more than one stream exists; tear down
            // rather than hand back a "pool" that cannot overlap anything.
            cuda_pool_free()
            return -1
        }
        mem_store(cuda_pool + i * 8, h)
        made = made + 1
        i = i + 1
    }
    cuda_pool_next = 0
    return made
}

// Borrow the next stream, round-robin. Returns 0 if the pool is not up.
fn cuda_pool_lease() -> i64 {
    if cuda_pool == 0 { return 0 }
    let h = mem_load(cuda_pool + cuda_pool_next * 8)
    cuda_pool_next = cuda_pool_next + 1
    if cuda_pool_next >= CUDA_POOL_N { cuda_pool_next = 0 }
    return h
}

// Wait for every stream in the pool. This is the one barrier that matters: after
// it, every copy issued through the pool has landed.
fn cuda_pool_sync() -> i64 {
    if cuda_pool == 0 { return -1 }
    let i = 0
    while i < CUDA_POOL_N {
        let h = mem_load(cuda_pool + i * 8)
        // A cleared slot is a stream that was already destroyed. Syncing it
        // faults inside libcuda exactly like syncing a bogus pointer.
        if h != 0 { stream_sync(h) }
        i = i + 1
    }
    return 0
}

// Destroy every stream in the pool and release the handle array.
fn cuda_pool_free() {
    if cuda_pool == 0 { return }
    let i = 0
    while i < CUDA_POOL_N {
        let h = mem_load(cuda_pool + i * 8)
        if h != 0 {
            stream_destroy(h)
            // Clear the slot as we go. A second cuda_pool_free (the pool test
            // calls it on its failure path AND at the end) otherwise re-destroys
            // every handle, and a double cudaStreamDestroy SEGFAULTS INSIDE
            // libcuda -- it is not a returned error. Observed:
            //     #3 cuStreamDestroy_v2  #5 cudaStreamDestroy  #6 main
            // Clearing here makes the second call a no-op rather than a crash.
            mem_store(cuda_pool + i * 8, 0)
        }
        i = i + 1
    }
    mem_free(cuda_pool)
    cuda_pool = 0
    cuda_pool_next = 0
}


// ---------------------------------------------------------------------------
// Phase 6.2: GPU dequant + matvec.
//
// These drive the kernels in scripts/audit/quanta_gpu_kernels.cu through the
// daemon. All pointers are DEVICE addresses, so a tensor that is already
// resident can be dequantized or multiplied without a host round trip.
//
// dtype numbering follows GGUF: 0 = F32, 12 = Q4_K. Only those two are
// implemented in the kernel; anything else returns a negative code from the
// daemon, which surfaces here as a failure rather than as silent zeros.
// ---------------------------------------------------------------------------

const CUDA_DTYPE_F32  = 0
const CUDA_DTYPE_Q4_K = 12

// Dequantize a device-resident quantized tensor into a device f32 buffer.
// `src` and `dst` are device pointers; `nelem` is the element count.
fn gpu_dequant(dtype, src, dst, nelem) -> i64 {
    let cmd = mem_alloc(128)
    let n = cuda_cat(cmd, 0, "dequant ")
    n = cuda_cat_u64(cmd, n, dtype)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_hex(cmd, n, src)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_hex(cmd, n, dst)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_u64(cmd, n, nelem)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return -1 }
    let ok = cuda_reply_ok(body)
    mem_free(body)
    if ok == 0 { return -1 }
    return 0
}

// y = W @ x on the device. W is a device tensor of `rows` x `cols`, x and y are
// device f32 vectors. For a quantized W the kernel dequantizes on the fly, so
// no f32 copy of the weights is ever materialised.
fn gpu_matvec(dtype, w, x, y, rows, cols) -> i64 {
    let cmd = mem_alloc(192)
    let n = cuda_cat(cmd, 0, "matvec ")
    n = cuda_cat_u64(cmd, n, dtype)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_hex(cmd, n, w)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_hex(cmd, n, x)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_hex(cmd, n, y)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_u64(cmd, n, rows)
    n = cuda_cat_sp(cmd, n)
    n = cuda_cat_u64(cmd, n, cols)
    let body = cuda_call(cmd, n)
    mem_free(cmd)
    if body == 0 { return -1 }
    let ok = cuda_reply_ok(body)
    mem_free(body)
    if ok == 0 { return -1 }
    return 0
}


// Convert a device f32 buffer to device f64 (exact) -- the loader's buffers are
// f64, the kernels want f32, so this is the bridge in both directions.
fn gpu_f32_to_f64(src, dst, n) -> i64 {
    let cmd = mem_alloc(96)
    let n2 = cuda_cat(cmd, 0, "f32_to_f64 ")
    n2 = cuda_cat_hex(cmd, n2, src)
    n2 = cuda_cat_sp(cmd, n2)
    n2 = cuda_cat_hex(cmd, n2, dst)
    n2 = cuda_cat_sp(cmd, n2)
    n2 = cuda_cat_u64(cmd, n2, n)
    let body = cuda_call(cmd, n2)
    mem_free(cmd)
    if body == 0 { return -1 }
    let ok = cuda_reply_ok(body)
    mem_free(body)
    if ok == 0 { return -1 }
    return 0
}

// Narrow a device f64 buffer to f32 (a real narrowing -- this is the one that
// loses precision, and it is the step that makes the weights device-shaped).
fn gpu_f64_to_f32(src, dst, n) -> i64 {
    let cmd = mem_alloc(96)
    let n2 = cuda_cat(cmd, 0, "f64_to_f32 ")
    n2 = cuda_cat_hex(cmd, n2, src)
    n2 = cuda_cat_sp(cmd, n2)
    n2 = cuda_cat_hex(cmd, n2, dst)
    n2 = cuda_cat_sp(cmd, n2)
    n2 = cuda_cat_u64(cmd, n2, n)
    let body = cuda_call(cmd, n2)
    mem_free(cmd)
    if body == 0 { return -1 }
    let ok = cuda_reply_ok(body)
    mem_free(body)
    if ok == 0 { return -1 }
    return 0
}
