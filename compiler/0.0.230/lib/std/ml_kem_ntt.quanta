// ML-KEM NTT (Number Theoretic Transform) for polynomial multiplication
// Uses 256-point NTT with q=3329, primitive root=17
// In-place, iterative Cooley-Tukey

import std/ml_kem_constants

// Forward NTT (in-place, 7 layers)
fn ml_kem_ntt(a: i64[256]) {
    // Iterative NTT with precomputed zetas
    // We'll compute zetas on the fly for now
    let len: i64 = 128
    let layer: i64 = 0
    while layer < 7 {
        let start: i64 = 0
        while start < 256 {
            // Compute zeta for this position
            // zeta = ROOT_OF_UNITY ^ (bitrev(start/len, 7))
            let zeta: i64 = ml_kem_compute_zeta(start, layer)
            let j: i64 = 0
            while j < len {
                let u: i64 = a[start + j]
                let v: i64 = a[start + j + len]
                let t: i64 = ml_kem_mod_q(v * zeta)
                a[start + j] = ml_kem_mod_q(u + t)
                a[start + j + len] = ml_kem_mod_q(u - t)
                j = j + 1
            }
            start = start + 2 * len
        }
        len = len / 2
        layer = layer + 1
    }
}

// Compute NTT twiddle factor
fn ml_kem_compute_zeta(pos: i64, layer: i64): i64 {
    // For layer l (0=first, 6=last), stride = 2^(l+1)
    // zeta = ROOT_OF_UNITY ^ bitrev(pos/stride, 7)
    // Actually, standard Kyber uses different ordering
    // Let's use a simpler approach: hardcode the standard zetas array
    // For now, compute it
    let stride: i64 = 1 << (layer + 1)
    let idx: i64 = pos / stride
    // bitrev7 of idx
    let br: i64 = 0
    let k: i64 = 0
    while k < 7 {
        br = (br << 1) | (idx & 1)
        idx = idx >> 1
        k = k + 1
    }
    // ROOT_OF_UNITY^br mod q
    let pow: i64 = 1
    let e: i64 = 0
    let root: i64 = MLKEM_ROOT_OF_UNITY
    while e < br {
        pow = (pow * root) % MLKEM_Q
        e = e + 1
    }
    return pow
}

// Inverse NTT (in-place)
fn ml_kem_intt(a: i64[256]) {
    let len: i64 = 2
    let layer: i64 = 0
    while layer < 7 {
        let start: i64 = 0
        while start < 256 {
            let zeta: i64 = ml_kem_compute_zeta(start, 6 - layer)
            let j: i64 = 0
            while j < len {
                let u: i64 = a[start + j]
                let v: i64 = a[start + j + len]
                a[start + j] = ml_kem_mod_q(u + v)
                a[start + j + len] = ml_kem_mod_q((u - v) * zeta)
                j = j + 1
            }
            start = start + 2 * len
        }
        len = len * 2
        layer = layer + 1
    }
    // Multiply by n^{-1} = 256^{-1} mod q
    // 256 * 1255 = 321280 = 1 (mod 3329) -> 1255
    let ninv: i64 = 1255
    let i: i64 = 0
    while i < 256 {
        a[i] = ml_kem_mod_q(a[i] * ninv)
        i = i + 1
    }
}

// Pointwise multiplication in NTT domain
fn ml_kem_pointwise_mul(a: i64[256], b: i64[256]): i64[256] {
    let res: i64[256]
    let i: i64 = 0
    while i < 256 {
        res[i] = ml_kem_mod_q(a[i] * b[i])
        i = i + 1
    }
    return res
}

// Polynomial multiplication via NTT
// a, b: 256 coefficients in [0, q)
// returns: 256 coefficients (a * b) mod (X^256 + 1, q)
fn ml_kem_poly_mul(a: i64[256], b: i64[256]): i64[256] {
    let a_ntt: i64[256] = a
    let b_ntt: i64[256] = b
    ml_kem_ntt(a_ntt)
    ml_kem_ntt(b_ntt)
    let c_ntt: i64[256] = ml_kem_pointwise_mul(a_ntt, b_ntt)
    ml_kem_intt(c_ntt)
    return c_ntt
}

// Polynomial addition
fn ml_kem_poly_add(a: i64[256], b: i64[256]): i64[256] {
    let res: i64[256]
    let i: i64 = 0
    while i < 256 {
        res[i] = ml_kem_mod_q(a[i] + b[i])
        i = i + 1
    }
    return res
}

// Polynomial subtraction
fn ml_kem_poly_sub(a: i64[256], b: i64[256]): i64[256] {
    let res: i64[256]
    let i: i64 = 0
    while i < 256 {
        res[i] = ml_kem_mod_q(a[i] - b[i])
        i = i + 1
    }
    return res
}

// Polynomial negation
fn ml_kem_poly_neg(a: i64[256]): i64[256] {
    let res: i64[256]
    let i: i64 = 0
    while i < 256 {
        res[i] = ml_kem_mod_q(0 - a[i])
        i = i + 1
    }
    return res
}

// Encode polynomial to bytes (12 bits per coefficient -> 384 bytes)
fn ml_kem_poly_encode(a: i64[256]): u8[384] {
    let out: u8[384]
    let i: i64 = 0
    let out_idx: i64 = 0
    while i < 256 {
        // 12 bits per coefficient, packed
        let coeff: i64 = a[i] & 0xFFF  // 12 bits
        out[out_idx] = (coeff & 0xFF) as u8
        out[out_idx + 1] = ((coeff >> 8) & 0xFF) as u8
        // Wait, Kyber uses bit-packed encoding, not byte-aligned
        // Actually: 256 * 12 = 3072 bits = 384 bytes exactly
        // Standard encoding: continuous bit stream
        // We need a bit-level packer
        i = i + 1
        out_idx = out_idx + 2  // TEMP: just 2 bytes per coeff (16 bits)
    }
    return out
}

// Decode bytes to polynomial (12 bits per coefficient)
fn ml_kem_poly_decode(buf: u8[384]): i64[256] {
    let res: i64[256]
    let i: i64 = 0
    let buf_idx: i64 = 0
    while i < 256 {
        // TEMP: 2 bytes per coeff
        let lo: i64 = buf[buf_idx] as i64
        let hi: i64 = buf[buf_idx + 1] as i64
        res[i] = lo | (hi << 8)
        res[i] = ml_kem_mod_q(res[i])
        i = i + 1
        buf_idx = buf_idx + 2
    }
    return res
}

// Encode compressed polynomial (4 bits per coeff for 768)
fn ml_kem_poly_compress(a: i64[256]): u8[128] {
    let out: u8[128]
    let i: i64 = 0
    while i < 256 {
        // Compress to 4 bits: round(a * 16 / q) mod 16
        let t: i64 = (a[i] * 16 + MLKEM_Q / 2) / MLKEM_Q
        t = t & 0xF
        if (i & 1) == 0 {
            out[i / 2] = t as u8
        } else {
            out[i / 2] = out[i / 2] | (t << 4) as u8
        }
        i = i + 1
    }
    return out
}

// Decompress compressed polynomial (4 bits -> full range)
fn ml_kem_poly_decompress(buf: u8[128]): i64[256] {
    let res: i64[256]
    let i: i64 = 0
    while i < 256 {
        let t: i64
        if (i & 1) == 0 {
            t = buf[i / 2] & 0xF
        } else {
            t = (buf[i / 2] >> 4) & 0xF
        }
        // Decompress: round(t * q / 16)
        res[i] = ((t * MLKEM_Q) + 8) >> 4
        i = i + 1
    }
    return res
}

// Vector of k polynomials (k=3 for ML-KEM-768)
fn ml_kem_polyvec_ntt(vec: i64[3][256]) {
    let i: i64 = 0
    while i < 3 {
        ml_kem_ntt(vec[i])
        i = i + 1
    }
}

fn ml_kem_polyvec_intt(vec: i64[3][256]) {
    let i: i64 = 0
    while i < 3 {
        ml_kem_intt(vec[i])
        i = i + 1
    }
}

fn ml_kem_polyvec_pointwise_mul(a: i64[3][256], b: i64[3][256]): i64[3][256] {
    let res: i64[3][256]
    let i: i64 = 0
    while i < 3 {
        res[i] = ml_kem_pointwise_mul(a[i], b[i])
        i = i + 1
    }
    return res
}

fn ml_kem_polyvec_add(a: i64[3][256], b: i64[3][256]): i64[3][256] {
    let res: i64[3][256]
    let i: i64 = 0
    while i < 3 {
        res[i] = ml_kem_poly_add(a[i], b[i])
        i = i + 1
    }
    return res
}

fn ml_kem_polyvec_sub(a: i64[3][256], b: i64[3][256]): i64[3][256] {
    let res: i64[3][256]
    let i: i64 = 0
    while i < 3 {
        res[i] = ml_kem_poly_sub(a[i], b[i])
        i = i + 1
    }
    return res
}