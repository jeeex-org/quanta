import std/fs

// Test f32 conversion - just verify it doesn't crash
fn main() {
    // Test 1.0f32 = 0x3F800000
    let test = mem_alloc(4)
    mem_store8(test, 0)
    mem_store8(test + 1, 0)
    mem_store8(test + 2, 128)
    mem_store8(test + 3, 63)
    
    let b0 = mem_load8(test)
    let b1 = mem_load8(test + 1)
    let b2 = mem_load8(test + 2)
    let b3 = mem_load8(test + 3)
    
    // Just verify we read the bytes correctly
    if b0 != 0 { return 1 }
    if b1 != 0 { return 1 }
    if b2 != 128 { return 1 }
    if b3 != 63 { return 1 }
    
    return 0
}