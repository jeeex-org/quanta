// x25519_str_debug4.quanta — debug fe_from_bytes call

import std/x25519

fn main() {
  println("Test fe_from_bytes...")
  let u9 = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u9 + i, 0); i = i + 1 }
  mem_store8(u9, 9)
  
  let fe = mem_alloc(5*8)
  fe_from_bytes(u9, fe)
  println("fe_from_bytes done")
  
  println(0)
  exit(0)
}