// 0.0.91 regression: usize/u32/u64 as full type keywords.
// Verifies: type annotation parsed; arithmetic has correct width semantics
// (u32 wraps at 2^32; u64/usize are full 64-bit, no wrap at 2^32);
// casts to/from these types behave as documented.
fn main() {
  // usize: full 64-bit
  let a: usize = 70000
  let b = a + 1
  if b != 70001 { exit(201) }
  // u64: full 64-bit (no 2^32 wrap)
  let c: u64 = 4294967296
  let d = c + 1
  if d != 4294967297 { exit(202) }
  // u32: wraps at 2^32
  let e: u32 = 4294967295
  let f = e + 1
  if f != 0 { exit(203) }
  // u32 normal value
  let g: u32 = 70000
  let h = g + 1
  if h != 70001 { exit(204) }
  // casts: large value landing above 2^32
  let big = 5000000000
  let i = big as u32
  if i != 705032704 { exit(205) }    // 5e9 mod 2^32
  let j = big as u64
  if j != 5000000000 { exit(206) }
  let k = big as usize
  if k != 5000000000 { exit(207) }
  // u32 from a value that fits (no spurious mask)
  let m = 123456 as u32
  if m != 123456 { exit(208) }
  exit(7)                            // all correct
}
