// std_qmodel_dtype_test -- Phase 7.2: unified dtype model.
//
// Verifies the QmodelDtype unification end to end:
//   1. mapping tables: every GGUF numeric ID and every safetensors string maps
//      to the expected enum value (unit checks, independent of any model file)
//   2. qmodel_bits_of agrees with qmodel_bits for every whole-byte tensor of the
//      real GGUF model (cross-checks the enum against the derived bit width)
//   3. the real safetensors model resolves every tensor to a known enum
//   4. qmodel_dtype_name round-trips: name -> lookup -> same name
//
// Note: the GGUF and safetensors files are DIFFERENT networks, so there is no
// same-named tensor to compare across files; unification is proven by 1+4 (both
// formats produce identical enum values for the same format) and 2 (the enum
// agrees with the independently derived bit width).

import std/loader_traits
import std/qmodel_dtype

const GGUF_MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"
const ST_MODEL = "/opt/ai/models/qwen3.5-2b/model.safetensors-00001-of-00001.safetensors"

fn main() -> i64 {
    let fails = 0

    // ---- 1. mapping tables ----
    // GGUF: spot-check the load-bearing IDs (proven against the real model below).
    if gguf_dtype_to_qmodel(0) != QMD_F32 { print("FAIL: gguf 0 != F32\n"); fails = fails + 1 }
    if gguf_dtype_to_qmodel(1) != QMD_F16 { print("FAIL: gguf 1 != F16\n"); fails = fails + 1 }
    if gguf_dtype_to_qmodel(12) != QMD_Q4_K { print("FAIL: gguf 12 != Q4_K\n"); fails = fails + 1 }
    if gguf_dtype_to_qmodel(14) != QMD_Q6_K { print("FAIL: gguf 14 != Q6_K\n"); fails = fails + 1 }
    if gguf_dtype_to_qmodel(27) != QMD_BF16 { print("FAIL: gguf 27 != BF16\n"); fails = fails + 1 }
    if gguf_dtype_to_qmodel(999) != QMD_UNKNOWN { print("FAIL: gguf 999 != UNKNOWN\n"); fails = fails + 1 }
    // safetensors: same enum for the same format string.
    if st_dtype_to_qmodel("F32") != QMD_F32 { print("FAIL: st F32 != F32\n"); fails = fails + 1 }
    if st_dtype_to_qmodel("BF16") != QMD_BF16 { print("FAIL: st BF16 != BF16\n"); fails = fails + 1 }
    if st_dtype_to_qmodel("U8") != QMD_U8 { print("FAIL: st U8 != U8\n"); fails = fails + 1 }
    if st_dtype_to_qmodel("NOPE") != QMD_UNKNOWN { print("FAIL: st NOPE != UNKNOWN\n"); fails = fails + 1 }
    // Both spellings of the same quant format must land on ONE enum value.
    if gguf_dtype_to_qmodel(12) != st_dtype_to_qmodel("Q4_K") {
        print("FAIL: gguf Q4_K and st Q4_K disagree\n"); fails = fails + 1
    }
    if fails == 0 { print("mapping tables: OK\n") }

    // ---- 2. enum bit width vs derived bit width on the real GGUF model ----
    let hg = qmodel_open(GGUF_MODEL)
    if hg < 0 { print("FAIL: qmodel_open GGUF\n"); return 1 }
    let ntg = qmodel_num_tensors(hg)
    if ntg <= 0 { print("FAIL: no GGUF tensors\n"); return 1 }
    let unknown_g = 0
    let bits_bad = 0
    let i = 0
    while i < ntg {
        let dt = qmodel_dtype(hg, i)
        if dt == QMD_UNKNOWN { unknown_g = unknown_g + 1 }
        let be = qmodel_bits_of(dt)
        let bc = qmodel_bits(hg, i)
        // Whole-byte formats: enum width must equal the derived width.
        if be >= 8 && bc > 0 && be != bc {
            print("BITS MISMATCH t="); print(i)
            print(" enum="); print(be); print(" calc="); print(bc); print("\n")
            bits_bad = bits_bad + 1
        }
        i = i + 1
    }
    if unknown_g > 0 {
        print("FAIL: "); print(unknown_g); print(" GGUF tensors unknown dtype\n")
        fails = fails + 1
    } else {
        print("GGUF: all "); print(ntg); print(" tensors known dtype\n")
    }
    if bits_bad > 0 { fails = fails + 1 } else { print("bits consistency: OK\n") }

    // ---- 3. real safetensors model resolves every tensor ----
    let hs = qmodel_open(ST_MODEL)
    if hs < 0 { print("FAIL: qmodel_open safetensors\n"); return 1 }
    let nts = qmodel_num_tensors(hs)
    if nts <= 0 { print("FAIL: no ST tensors\n"); return 1 }
    let unknown_s = 0
    i = 0
    while i < nts {
        let dt = qmodel_dtype(hs, i)
        if dt == QMD_UNKNOWN { unknown_s = unknown_s + 1 }
        i = i + 1
    }
    if unknown_s > 0 {
        print("FAIL: "); print(unknown_s); print(" ST tensors unknown dtype\n")
        fails = fails + 1
    } else {
        print("safetensors: all "); print(nts); print(" tensors known dtype\n")
    }

    // ---- 4. name round-trip through the enum ----
    // qmodel_dtype_str must return the canonical name for the enum the dtype
    // mapped to; feeding that name back through the ST mapping must give the
    // same enum for every format the ST mapping knows.
    let rt_bad = 0
    i = 0
    while i < nts {
        let dt = qmodel_dtype(hs, i)
        let nm = qmodel_dtype_str(hs, i)
        let back = st_dtype_to_qmodel(nm)
        if back != dt {
            print("ROUNDTRIP t="); print(i); print(" dt="); print(dt)
            print(" name="); print(nm); print(" back="); print(back); print("\n")
            rt_bad = rt_bad + 1
            if rt_bad > 3 { print("...\n"); i = nts }
        }
        i = i + 1
    }
    if rt_bad > 0 {
        print("FAIL: "); print(rt_bad); print(" name round-trips broken\n")
        fails = fails + 1
    } else {
        print("name round-trip: OK\n")
    }

    qmodel_close(hg)
    qmodel_close(hs)

    if fails == 0 { print("qmodel_dtype: all pass\n"); return 0 }
    print("qmodel_dtype: FAILURES\n")
    return 1
}
