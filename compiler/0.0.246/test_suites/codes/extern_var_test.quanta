// Native variadic formatted output test
// Tests %d %s %% formats using native fmt_printf_* functions

import std/fmt

fn main(): i64 {
  let f2 = "%d %d\n"
  fmt_printf_int_str(f2, 11, "unused")  // second %d gets 0, but we only care about first
  let f7 = "%d %d %d %d %d %d %d\n"
  // We'll test with 2 ints + string
  let test_str = "test"
  fmt_printf_int_str("%d %d %s\n", 1, test_str)
  fmt_printf_int_str("%d %d %d %d %d %d %d\n", 1, "unused")
  // Test %% literal percent
  fmt_printf_int("100%%\n", 0)
  println("EXTERN_VAR_OK")
  0
}