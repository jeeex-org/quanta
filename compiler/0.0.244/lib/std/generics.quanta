// ============================================================================
// Standard Library Generic Types
// ============================================================================

// Option<T>
fn gen_option_some(t: gen_type[]): gen_type {
    let opt: gen_type
    opt.kind = gen_kind_enum()
    opt.type_id = 100  // Option type ID
    opt.args[0] = t[0]
    opt.arg_count = 1
    return opt
}

fn gen_option_none(t: gen_type[]): gen_type {
    return gen_option_some(t)
}

// Result<T, E>
fn gen_result_ok(t: gen_type[], e: gen_type[]): gen_type {
    let res: gen_type
    res.kind = gen_kind_enum()
    res.type_id = 101  // Result type ID
    res.args[0] = t[0]
    res.args[1] = e[0]
    res.arg_count = 2
    return res
}

fn gen_result_err(t: gen_type[], e: gen_type[]): gen_type {
    return gen_result_ok(t, e)
}

// Vec<T>
fn gen_vec_new(t: gen_type[]): gen_type {
    let vec: gen_type
    vec.kind = gen_kind_struct()
    vec.type_id = 102  // Vec type ID
    vec.args[0] = t[0]
    vec.arg_count = 1
    return vec
}

// Box<T>
fn gen_box_new(t: gen_type[]): gen_type {
    let box_t: gen_type
    box_t.kind = gen_kind_ptr()
    box_t.args[0] = t[0]
    box_t.arg_count = 1
    return box_t
}

// Rc<T> / Arc<T>
fn gen_rc_new(t: gen_type[]): gen_type {
    let rc: gen_type
    rc.kind = gen_kind_struct()
    rc.type_id = 103  // Rc type ID
    rc.args[0] = t[0]
    rc.arg_count = 1
    return rc
}

// HashMap<K, V>
fn gen_hashmap_new(k: gen_type[], v: gen_type[]): gen_type {
    let hm: gen_type
    hm.kind = gen_kind_struct()
    hm.type_id = 104  // HashMap type ID
    hm.args[0] = k[0]
    hm.args[1] = v[0]
    hm.arg_count = 2
    return hm
}

// Iterator<Item>
fn gen_iterator_item(item_ty: gen_type[]): gen_type {
    let iter: gen_type
    iter.kind = gen_kind_trait_object()
    iter.type_id = 200  // Iterator trait ID
    iter.args[0] = item_ty[0]
    iter.arg_count = 1
    return iter
}

// Future<Output>
fn gen_future_output(output_ty: gen_type[]): gen_type {
    let fut: gen_type
    fut.kind = gen_kind_trait_object()
    fut.type_id = 201  // Future trait ID
    fut.args[0] = output_ty[0]
    fut.arg_count = 1
    return fut
}

