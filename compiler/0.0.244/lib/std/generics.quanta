}

// ============================================================================
// Const Generics
// ============================================================================

struct gen_const_param {
    name: u8[64],
    id: i64,
    ty: gen_type,
    default_val: i64
}

fn gen_const_param_new(name: u8[], ty: gen_type[], default_val: i64): gen_const_param {
    let p: gen_const_param
    // Copy name
    let i: i64 = 0
    while i < 64 && name[i] != 0 {
        p.name[i] = name[i]
        i = i + 1
    }
    p.name[i] = 0
    p.ty = ty[0]
    p.default_val = default_val
    return p
}

// ============================================================================
// Generic Inference
// ============================================================================

struct gen_inference_ctx {
    vars: gen_infer_var[64],
    var_count: i64,
    obligations: gen_obligation[128],
    obligation_count: i64
}

struct gen_infer_var {
    id: i64,
    kind: i64,        // 0=type, 1=const, 2=lifetime
    lower_bound: gen_type,
    upper_bound: gen_type,
    resolved: gen_type,
    is_resolved: i64
}

struct gen_obligation {
    predicate: i64,   // 0=trait, 1=projection, 2=well-formed
    trait_id: i64,
    self_ty: gen_type,
    args: gen_type[16],
    arg_count: i64
}

// Unify two types
fn gen_unify(ctx: gen_inference_ctx[], a: gen_type[], b: gen_type[]): i64 {
    if a[0].kind == gen_kind_param() && b[0].kind == gen_kind_param() {
        if a[0].param_id == b[0].param_id { return 0 }
        // Unify type variables
        return gen_unify_vars(ctx, a[0].param_id, b[0].param_id)
    }
    if a[0].kind == gen_kind_param() {
        return gen_instantiate_var(ctx, a[0].param_id, b)
    }
    if b[0].kind == gen_kind_param() {
        return gen_instantiate_var(ctx, b[0].param_id, a)
    }
    
    // Both concrete - must match
    if a[0].kind != b[0].kind { return -1 }
    if a[0].kind == gen_kind_concrete() {
        if a[0].type_id != b[0].type_id { return -1 }
        return 0
    }
    
    // Composite types - unify arguments
    if a[0].arg_count != b[0].arg_count { return -1 }
    let i: i64 = 0
    while i < a[0].arg_count {
        if gen_unify(ctx, a[0].args + i, b[0].args + i) != 0 { return -1 }
        i = i + 1
    }
    return 0
}

fn gen_unify_vars(ctx: gen_inference_ctx[], var_a: i64, var_b: i64): i64 {
    // Merge two inference variables
    return 0
}

fn gen_instantiate_var(ctx: gen_inference_ctx[], var_id: i64, ty: gen_type[]): i64 {
    // Check occurs check
    // Check bounds
    // Set resolved type
    return 0
}

