// float_operand_path_test.quanta
//
// Covers the cvtsi2sd operand encoding on the INT path of fadd/fsub/fmul/fdiv.
// Those sites emitted `eb(242); eb(102)` == F2 66 48 0F 2A -- a stray 66 (the
// packed-SSE prefix) sitting between the mandatory F2 and the REX byte, which is
// not a decodable cvtsi2sd. arg1's sites also emitted `eb(72); eb(242)` ==
// 48 F2 0F 2A, with F2 after the REX. Both forms were wrong; 11 sites in total.
//
// Each case below forces an integer operand and checks the value survives, so a
// regression in either encoding shows up as a wrong exit code rather than as a
// silently wrong constant.
//
// Exit codes: 0 = all pass. Otherwise the first failing case's code is returned.

fn main() -> i64 {
    // int on both operands -- cvtsi2sd at arg0 and arg1
    if f2i(fadd(3, 4)) != 7 { return 1 }
    if f2i(fsub(9, 4)) != 5 { return 2 }
    if f2i(fmul(3, 4)) != 12 { return 3 }
    if f2i(fdiv(8, 4)) != 2 { return 4 }

    // mixed: float on arg1, int on arg0 (the asymmetric pair that was 48 F2)
    if fadd(3, 4.5) != 7.5 { return 5 }
    if fsub(9, 4.5) != 4.5 { return 6 }
    if fmul(2, 4.5) != 9.0 { return 7 }
    if fdiv(9, 4.5) != 2.0 { return 8 }

    // i2f feeding the float path, so the conversion itself is checked
    if fadd(i2f(3), 4.5) != 7.5 { return 9 }
    if f2i(fadd(i2f(2), i2f(3))) != 5 { return 10 }

    // negatives and a fractional result round-trip through the int->double path
    if f2i(fadd(0-3, 4)) != 1 { return 11 }
    if f2i(fmul(3, 4)) != 12 { return 12 }
    if f2i(fadd(1, 1)) != 2 { return 13 }

    return 0
}