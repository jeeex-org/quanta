import std/fs

// Test sampling: argmax and top-k filtering
fn main() {
    let logits = mem_alloc(4 * 8)
    mem_store(logits, i2f(10))
    mem_store(logits + 8, i2f(50))
    mem_store(logits + 16, i2f(30))
    mem_store(logits + 24, i2f(20))
    
    // Find argmax
    let max_val = mem_load(logits)
    let max_idx = 0
    let i = 1
    while i < 4 {
        let v = mem_load(logits + i * 8)
        if f2i(v) > f2i(max_val) {
            max_val = v
            max_idx = i
        }
        i = i + 1
    }
    
    if max_idx != 1 { return 1 }
    
    // Zero out below threshold (30)
    let threshold = i2f(30)
    i = 0
    while i < 4 {
        let v = mem_load(logits + i * 8)
        if f2i(v) < f2i(threshold) {
            mem_store(logits + i * 8, i2f(0))
        }
        i = i + 1
    }
    
    if mem_load(logits) != i2f(0) { return 1 }
    if mem_load(logits + 8) != i2f(50) { return 1 }
    if mem_load(logits + 16) != i2f(30) { return 1 }
    if mem_load(logits + 24) != i2f(0) { return 1 }
    
    return 0
}