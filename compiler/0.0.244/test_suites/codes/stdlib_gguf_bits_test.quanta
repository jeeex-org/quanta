// stdlib_gguf_bits_test -- sub-byte packing accessors must be exact.
//
// Needed for the HuggingFace quantization formats (GPTQ, AWQ, NF4, MLX), which
// pack 2-8 bits per element. Every GGUF dtype is a whole number of BYTES per
// block, so this is additive: gguf_tensor_nbytes() is already correct for all 35
// dtypes, verified against ggml's own struct sizes by
// scripts/audit/check_dtype_sizes.py (0 mismatches).
//
// WHAT THIS PINS
// --------------
// 1. bit order -- bit 0 is the LEAST significant. GGUF and safetensors pack low
//    bits first; GPTQ's qweight packs the LOW nibble first per int32. Reading
//    MSB-first transposes every value in a quantized tensor with no error.
// 2. fields that straddle a byte -- 3-, 5- and 6-bit MLX packings cannot be
//    expressed by any bytes-per-element model, because they do not land on a
//    byte boundary.
// 3. sign extension -- GPTQ and AWQ store SIGNED 4-bit values, NF4 and MLX
//    affine store unsigned. Getting this wrong yields plausible but wrong
//    weights, the same class of error as adding an AWQ zero-point that the file
//    never stored.
//
// EXPECTATIONS ARE COMPUTED, NOT HAND-WRITTEN
// -------------------------------------------
// Each value below is derived from the byte values by an independent bit-by-bit
// calculation. Two hand-written expectations were initially WRONG and both
// mistakes were in the expectation, not the implementation:
//
//   5 bits at offset 6: said 18, correct 30 -- misread bit 0 of 0xA7 as 0 (it is 1)
//   3 bits at offset 5: said 13, correct 5  -- assumed the field spills into byte
//                                              1, but bits 5,6,7 all fit in byte 0
//
// Both were caught by recomputing the expectation in Python before trusting the
// implementation's output. That ordering matters: had I adjusted the code to
// match a wrong hand-written number, both would now be wrong in agreement.

import std/fs
import std/gguf
import std/math

// bytes[0] = 0xB4 = 1011 0100, bytes[1] = 0xA7 = 1010 0111
// bit i (LSB-first) of 0xB4: 0,0,1,0,1,1,0,1
// bit i (LSB-first) of 0xA7: 1,1,1,0,0,1,0,1
// bytes[2] = 0x0F, bytes[3] = 0xF0

fn setup(p) {
    let i = 0
    while i < 8 { mem_store8(p + i, 0); i = i + 1 }
    mem_store8(p, 180)
    mem_store8(p + 1, 167)
    mem_store8(p + 2, 15)
    mem_store8(p + 3, 240)
    return 0
}

fn main() {
    let p = mem_alloc(8)
    setup(p)

    // ---- 1. bit order, LSB first ----
    // 0xB4 = 1011_0100b -> bit0=0 bit1=0 bit2=1 bit3=0 bit4=1 bit5=1 bit6=0 bit7=1
    if gguf_bit_at(p, 0) != 0 { print("FAIL bit0"); return 1 }
    if gguf_bit_at(p, 1) != 0 { print("FAIL bit1"); return 1 }
    if gguf_bit_at(p, 2) != 1 { print("FAIL bit2"); return 1 }
    if gguf_bit_at(p, 3) != 0 { print("FAIL bit3"); return 1 }
    if gguf_bit_at(p, 4) != 1 { print("FAIL bit4"); return 1 }
    if gguf_bit_at(p, 7) != 1 { print("FAIL bit7"); return 1 }

    // out-of-range bit indices return 0 rather than reading adjacent memory
    if gguf_bit_at(p, 8) != 0 { print("FAIL bit8 out of range"); return 1 }
    if gguf_bit_at(p, 0 - 1) != 0 { print("FAIL bit-1 out of range"); return 1 }

    // ---- 2. within-byte extraction ----
    // low nibble of 0xB4 = 0100b = 4
    if gguf_bits_extract(p, 0, 4) != 4 { print("FAIL nibble0"); return 1 }
    // high nibble of 0xB4 = 1011b = 11
    if gguf_bits_extract(p, 4, 4) != 11 { print("FAIL nibble1"); return 1 }

    // ---- 3. straddling fields ----
    // 3 bits at offset 5: byte0 bits 5,6,7 = 1,0,1. These all fit inside byte 0
    // (bits 5..7), so this is NOT a straddling case and byte 1 is not consulted.
    // LSB-first stream = 1,0,1 -> 1 + 0*2 + 1*4 = 5.
    // (An earlier version of this expectation said 13 by wrongly assuming the
    // field spilled into byte 1. It does not.)
    let v3 = gguf_bits_extract(p, 5, 3)
    if v3 != 5 { prints("FAIL extract3@5 got="); print(v3); print(" want=5"); return 1 }

    // 5 bits at offset 6: byte0 bits 6,7 = 0,1 ; byte1 bits 0,1,2 = 1,1,1
    // LSB-first stream = 0,1,1,1,1 -> value = 0 + 2 + 4 + 8 + 16 = 30
    // (An earlier comment said 18, from misreading bit0 of 0xA7 as 0. It is 1.)
    let v5 = gguf_bits_extract(p, 6, 5)
    if v5 != 30 { prints("FAIL extract5@6 got="); print(v5); print(" want=30"); return 1 }

    // 6 bits at offset 3: byte0 bits 3..7 = 0,1,1,0,1 ; byte1 bit0 = 1
    // LSB-first = 0,1,1,0,1,1 -> 0 + 2 + 4 + 0 + 16 + 32 = 54
    let v6 = gguf_bits_extract(p, 3, 6)
    if v6 != 54 { prints("FAIL extract6@3 got="); print(v6); print(" want=54"); return 1 }

    // a whole byte back
    if gguf_bits_extract(p, 0, 8) != 180 { print("FAIL whole byte"); return 1 }
    // zero-width and oversized requests are refused, not read out of bounds
    if gguf_bits_extract(p, 0, 0) != 0 { print("FAIL zero width"); return 1 }
    if gguf_bits_extract(p, 0, 33) != 0 { print("FAIL oversized width"); return 1 }

    // ---- 4. sign extension ----
    // 0x0F: low nibble 1111 -> unsigned 15, signed 4-bit -1
    if gguf_packed_read(p + 2, 0, 4, 0) != 15 { print("FAIL unsigned 0x0F"); return 1 }
    if gguf_packed_read(p + 2, 0, 4, 1) != 0 - 1 { print("FAIL signed 0x0F"); return 1 }
    // 0xF0: high nibble 1111 -> unsigned 15, signed -1
    if gguf_packed_read(p + 3, 1, 4, 0) != 15 { print("FAIL unsigned 0xF0 hi"); return 1 }
    if gguf_packed_read(p + 3, 1, 4, 1) != 0 - 1 { print("FAIL signed 0xF0 hi"); return 1 }
    // 0xB4 low nibble 0100 -> 4 both ways (sign bit clear)
    if gguf_packed_read(p, 0, 4, 1) != 4 { print("FAIL signed clear sign"); return 1 }
    // 0xB4 high nibble 1011 -> unsigned 11, signed 11-16 = -5
    if gguf_packed_read(p, 1, 4, 0) != 11 { print("FAIL unsigned 1011"); return 1 }
    if gguf_packed_read(p, 1, 4, 1) != 0 - 5 { print("FAIL signed 1011 -> -5"); return 1 }

    // ---- 5. packed addressing: element -> (byte, bit) ----
    // 4 bits per element: elements 0,1 in byte 0; 2,3 in byte 1
    if gguf_packed_byte(p, 0, 4) != p { print("FAIL packed byte 0"); return 1 }
    if gguf_packed_bit(p, 0, 4) != 0 { print("FAIL packed bit 0"); return 1 }
    if gguf_packed_byte(p, 1, 4) != p { print("FAIL packed byte 1"); return 1 }
    if gguf_packed_bit(p, 1, 4) != 4 { print("FAIL packed bit 1"); return 1 }
    if gguf_packed_byte(p, 2, 4) != p + 1 { print("FAIL packed byte 2"); return 1 }
    if gguf_packed_bit(p, 2, 4) != 0 { print("FAIL packed bit 2"); return 1 }
    // 3 bits per element: element 2 starts at bit 6, still inside byte 0.
    // This is the case that makes byte-address-only indexing wrong.
    if gguf_packed_byte(p, 2, 3) != p { print("FAIL 3-bit byte 2"); return 1 }
    if gguf_packed_bit(p, 2, 3) != 6 { print("FAIL 3-bit bit 2"); return 1 }
    if gguf_packed_byte(p, 3, 3) != p + 1 { print("FAIL 3-bit byte 3"); return 1 }
    if gguf_packed_bit(p, 3, 3) != 1 { print("FAIL 3-bit bit 3"); return 1 }

    // ---- 6. a packed sequence read element by element ----
    // 3-bit unsigned elements from 0xB4,0xA7,0x0F,0xF0 ...
    // Every value below is produced by one independent extraction routine over the
    // same bytes, not written out by hand:
    //     extract(start, n): for i in 0..n-1: v |= bit(bytes[(start+i)/8],
    //                                            (start+i)%8) << i
    // 3-bit elements LSB-first across 0xB4,0xA7,0x0F,0xF0:
    //   elem0 = extract3@0  = 4
    //   elem1 = extract3@3  = 6      (bits 3,4,5 of 0xB4 = 0,1,1)
    //   elem2 = extract3@6  = 6      (straddles into byte 1)
    //   elem3 = extract3@9  = 3
    // Three hand-written values here were wrong before this derivation replaced
    // them (elem1 said 2, elem2 said 3). Same failure as above, same fix.
    if gguf_packed_read(p, 0, 3, 0) != 4 { print("FAIL seq elem0"); return 1 }
    if gguf_packed_read(p, 1, 3, 0) != 6 { print("FAIL seq elem1"); return 1 }
    if gguf_packed_read(p, 2, 3, 0) != 6 { print("FAIL seq elem2"); return 1 }
    if gguf_packed_read(p, 3, 3, 0) != 3 { print("FAIL seq elem3"); return 1 }

    print("OK gguf-bits")
    return 0
}