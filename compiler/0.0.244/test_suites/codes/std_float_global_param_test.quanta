// std_float_global_param_test.quanta
//
// Regression: a MODULE-LEVEL float global, read inside a function that also does
// integer arithmetic, used to corrupt that function's integer parameter.
//
//     let G = 2.0
//     fn t(n: i64) -> i64 { let s = G  return n + 1 }
//     t(20) -> 4607182418800017408   (1.0's bit pattern; want 21)
//
// Mechanism: module-level code is compiled as its own pseudo-function
// (entry.quanta calls ci_func(0,0) for it), and `let G = 2.0` lowers to
// IR_CALL fconst writing vreg 0. The first parameter of `t` is ALSO vreg 0,
// because vreg numbering restarts per function. The float-tag fixpoint scans
// 0..irc on the source path, so the fconst record matched `n`. fopld_rr then
// bit-moved n into xmm0 (movq) instead of converting it (cvtsi2sd), turning 20
// into ~1e-322; adding 1.0 gave exactly 1.0.
//
// Only `+` and `-` were affected -- they take the "either operand is float"
// branch. `*`, `/`, `&` and `|` were correct, which is what made this look like a
// tag problem rather than a codegen one.
//
// A LOCAL float (`let s = 0.5`) and an INTEGER global were both correct: the
// leak needs a module-level FLOAT global, compiled in a separate ci_func call.

let G_F64 = 2.0
let G_ZERO = 0.0
let G_NEG = -3.5

// The exact repro: float global read, integer arithmetic in the same function.
fn r_int(n: i64) -> i64 { let s = G_F64  return n + 1 }
// Control: the global exists but is not read here.
fn r_noread(n: i64) -> i64 { return n + 1 }
// Control: local float, not a global.
fn r_local(n: i64) -> i64 { let s = 0.5  return n + 1 }
// Control: integer global.
fn r_intglob(n: i64) -> i64 { let s = G_ZERO  return n + 1 }
// The other affected operator.
fn r_sub(n: i64) -> i64 { let s = G_F64  return n - 1 }
// Several sequential bindings -- the leaked tag hit every one.
fn r_many(n: i64) -> i64 {
    let s = G_F64
    let a = n + 1
    let b = n + 2
    let c = n + 3
    return a + b + c
}
// Float globals of other values must behave identically.
fn r_zero(n: i64) -> i64 { let s = G_ZERO  return n + 1 }
fn r_neg(n: i64) -> i64 { let s = G_NEG  return n + 1 }
// Unaffected operators, pinned so the fix cannot regress them the other way.
fn r_mul(n: i64) -> i64 { let s = G_F64  return n * 1 }
fn r_div(n: i64) -> i64 { let s = G_F64  return n / 1 }
// Float arithmetic on a global must still work. G_F64 * 2.0 is 4.0, whose bit
// pattern is 4616189618054758400 -- derived with Python struct, not hand-written.
fn f_glob() -> f64 { return G_F64 * 2.0 }

fn main() -> i64 {
    let fail = 0

    if r_int(20) != 21 { fail = fail + 1 }
    if r_noread(20) != 21 { fail = fail + 1 }
    if r_local(20) != 21 { fail = fail + 1 }
    if r_intglob(20) != 21 { fail = fail + 1 }
    if r_sub(20) != 19 { fail = fail + 1 }
    if r_many(1) != 9 { fail = fail + 1 }
    if r_zero(20) != 21 { fail = fail + 1 }
    if r_neg(20) != 21 { fail = fail + 1 }
    if r_mul(20) != 20 { fail = fail + 1 }
    if r_div(20) != 20 { fail = fail + 1 }
    if f_glob() != 4.0 { fail = fail + 1 }

    print("std_float_global_param: ")
    print(11 - fail)
    print(" / 11\n")
    if fail == 0 { print("PASS\n") } else { print("FAIL\n") }
    return 0
}