// x25519_loop5_sq_test.quanta — test loop with 5 fe_sq

import std/x25519

fn main() {
  println("Test loop with 5 fe_sq...")
  
  let a = mem_alloc(8*8)
  fe_zero(a)
  mem_store(a, 9)
  
  let out = mem_alloc(8*8)
  let i = 0
  while i < 5 {
    fe_sq(a, out)
    fe_copy(out, a)
    i = i + 1
  }
  
  println("Done")
  println(0)
  exit(0)
}