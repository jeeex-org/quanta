// A user-defined function MUST win over a same-named compiler builtin.
// `abs` is an FPU builtin; before 0.0.68 only push/pop carried the user-wins
// guard, so this user fn was silently hijacked and abs(-42) returned 0 (the
// float builtin read the integer bits as a double). Silent wrong data.
fn abs(x) {
    if x < 0 { return 0 - x }
    return x
}
fn main() {
    return abs(0 - 42)      // 42, NOT 0
}
