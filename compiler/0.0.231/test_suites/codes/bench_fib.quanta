# Quanta benchmark twin of bench_fib.c — recursive Fibonacci, compute-bound.
# Keep this in lockstep with tests/bench_fib.c so cross-language timing is fair.
fn fib(n) {
    if n < 2 {
        return n
    }
    let a = fib(n - 1)
    let b = fib(n - 2)
    return a + b
}

fn main() {
    let r = fib(30)
    printi(r)
    return 0
}
