import std/gguf

// Phase 8b test: MoE expert offload job ring and three-state slot protocol.

fn main() -> i64 {
    let failures = 0

    // ---- Test 1: Initialize and free ----
    let rc = moe_init(4)
    if rc < 0 {
        print("FAIL: moe_init failed\n")
        return 1
    }
    moe_free()
    print("MoE T1 (init/free): PASS\n")

    // ---- Test 2: Submit and process jobs ----
    rc = moe_init(4)
    if rc < 0 {
        print("FAIL: moe_init failed\n")
        return 1
    }

    // Submit a job
    let rc2 = moe_submit_job(0, 0)
    if rc2 < 0 {
        print("FAIL: moe_submit_job failed\n")
        failures = failures + 1
    }

    // Process the job
    let rc3 = moe_process_job()
    if rc3 != 0 {
        print("FAIL: moe_process_job returned ", rc3, " (expected 0)\n")
        failures = failures + 1
    }

    // Mark consumed
    moe_mark_consumed(0)

    // Slot should be free now
    let slot = moe_alloc_slot()
    if slot < 0 {
        print("FAIL: moe_alloc_slot returned -1 after consumed\n")
        failures = failures + 1
    }

    moe_free()
    if failures == 0 { print("MoE T2 (submit/process/consume): PASS\n") }

    // ---- Test 3: Slot exhaustion ----
    rc = moe_init(2)
    if rc < 0 {
        print("FAIL: moe_init failed\n")
        return 1
    }

    // Submit 2 jobs (fills all slots)
    moe_submit_job(0, 0)
    moe_submit_job(0, 1)

    // Third submit should fail (no free slots)
    let rc4 = moe_submit_job(0, 2)
    if rc4 >= 0 {
        print("FAIL: moe_submit_job should have failed (no free slots)\n")
        failures = failures + 1
    }

    // Process one job
    moe_process_job()
    moe_mark_consumed(0)

    // Now a slot should be free
    let slot2 = moe_alloc_slot()
    if slot2 < 0 {
        print("FAIL: moe_alloc_slot returned -1 after processing\n")
        failures = failures + 1
    }

    moe_free()
    if failures == 0 { print("MoE T3 (slot exhaustion): PASS\n") }

    if failures > 0 {
        print("std_moe_offload_test: ", failures, " FAILURES\n")
        return 1
    }
    print("std_moe_offload_test: all pass\n")
    return 0
}
