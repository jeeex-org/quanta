// std_cuda_kernels_test -- Phase 6.2: GPU dequant + matvec from Quanta.
//
// The daemon already did alloc/copy/stream. What this covers is the part that
// needs device code: dequantizing a Q4_K tensor on the GPU and multiplying it,
// both without materialising an f32 copy of the weights.
//
// The check is against a CPU matvec computed here from the SAME bytes, so a
// kernel that is fast but wrong cannot pass. The Q4_K dequant is expected to be
// bit-exact (the kernel and lib/std/gguf.quanta use identical arithmetic); the
// matvec is compared with a relative tolerance because the GPU accumulates in
// f32 and this side sums in f64, so a different summation order is expected and
// only round-off level disagreement is acceptable.

import std/fs
import std/gguf
import std/cuda_daemon

// Build a Q4_K super-block with deterministic contents. 256 elements, 144 bytes:
//   +0 f16 d   +2 f16 dmin   +4 scales[12]   +16 qs[128]
const K_ROWS = 4
const K_COLS = 512          // 2 super-blocks per row
const K_BLK = K_COLS / 256
const K_ROWBYTES = K_BLK * 144

fn fill_block(p, seed) {
    // f16 values around 0.05 and 0.01: normal halves, small enough that the
    // products stay in f32 range for a 512-element row.
    mem_store16(p + 0, 0x2E66)   // ~0.05
    mem_store16(p + 2, 0x211C)   // ~0.01
    let i = 0
    while i < 12 {
        // FULL byte range, not 0..63.
        //
        // The (scale, min) table packs two 6-bit fields per byte, so bits 6-7 of
        // each byte are the HIGH BITS of the other field. A generator that only
        // wrote values < 64 left those bits zero, and then a decode that reads
        // the wrong byte for the high bits produces an identical result -- the
        // classic `sc[j-4]` vs `sc[j]` bug was invisible. Verified: with `% 64`
        // here, a deliberately broken kernel still passed. Using the full range
        // is also what a real Q4_K file contains.
        mem_store8(p + 4 + i, (seed * 61 + i * 37) % 256)
        i = i + 1
    }
    i = 0
    while i < 128 {
        mem_store8(p + 16 + i, (seed * 13 + i * 5) % 256)
        i = i + 1
    }
}

// CPU reference, mirroring q4k_sc/q4k_min/dequant_q4k in lib/std/gguf.quanta.
fn cpu_q4k_sc(j, sc) {
    if j < 4 { return mem_load8(sc + j) - (mem_load8(sc + j) >> 6) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo - (lo >> 4) * 16) + ((mem_load8(sc + j - 4) >> 6) * 16)
}
fn cpu_q4k_min(j, sc) {
    if j < 4 { return mem_load8(sc + j + 4) - (mem_load8(sc + j + 4) >> 6) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo >> 4 - (lo >> 4 >> 4) * 16) + ((mem_load8(sc + j) >> 6) * 16)
}

// Dequantize one block into out[0..255]. Uses the same f16->f64 helper the
// loader uses, so the CPU side is not a second independent implementation.
fn cpu_dequant_block(raw, out) {
    let d = f16_to_f64(raw)
    let dmin = f16_to_f64(raw + 2)
    let sc = raw + 4
    let q = raw + 16
    let chunk = 0
    let is = 0
    while chunk < 4 {
        let d1 = fmul(d, i2f(cpu_q4k_sc(is, sc)))
        let mm1 = fmul(dmin, i2f(cpu_q4k_min(is, sc)))
        let d2 = fmul(d, i2f(cpu_q4k_sc(is + 1, sc)))
        let mm2 = fmul(dmin, i2f(cpu_q4k_min(is + 1, sc)))
        let l = 0
        while l < 32 {
            // `byte` is a reserved keyword in Quanta, so the local is `b8`.
            let b8 = mem_load8(q + chunk * 32 + l)
            let lo = b8 - (b8 >> 4) * 16
            let hi = b8 >> 4
            mem_store(out + (chunk * 64 + l) * 8, f64bits(fmul(d1, i2f(lo)) - mm1))
            mem_store(out + (chunk * 64 + 32 + l) * 8, f64bits(fmul(d2, i2f(hi)) - mm2))
            l = l + 1
        }
        is = is + 2
        chunk = chunk + 1
    }
}

fn main() -> i64 {
    if cuda_daemon_ready() == 0 { print("SKIP: CUDA daemon not running\n"); return 0 }
    if cuda_init() != 0 { print("FAIL: cuda_init\n"); return 1 }

    let fails = 0

    // ---- one super-block, dequantized on both sides ----
    let host_w = mem_alloc(K_ROWS * K_ROWBYTES)
    let r = 0
    while r < K_ROWS {
        let b = 0
        while b < K_BLK {
            fill_block(host_w + r * K_ROWBYTES + b * 144, r * 3 + b + 1)
            b = b + 1
        }
        r = r + 1
    }

    // CPU reference weights: dequantize the whole matrix.
    let cpu_w = mem_alloc(K_ROWS * K_COLS * 8)
    r = 0
    while r < K_ROWS {
        let b = 0
        while b < K_BLK {
            cpu_dequant_block(host_w + r * K_ROWBYTES + b * 144, cpu_w + (r * K_COLS + b * 256) * 8)
            b = b + 1
        }
        r = r + 1
    }

    // ---- upload weights and the input vector ----
    let g_w = gpu_malloc(K_ROWS * K_ROWBYTES)
    if g_w == 0 { print("FAIL: gpu_malloc weights\n"); return 1 }

    let stage = "/tmp/cuda_kernels_stage.bin"
    let fd = open(stage, 577, 420)
    if fd < 0 { print("FAIL: open stage\n"); return 1 }
    write_raw(fd, host_w, K_ROWS * K_ROWBYTES)
    close(fd)
    if memcpy_h2d_async(stage, g_w, K_ROWS * K_ROWBYTES) != 0 {
        print("FAIL: h2d weights\n"); return 1
    }

    // ---- dequant on the GPU, into a device f32 buffer ----
    let g_deq = gpu_malloc(K_ROWS * K_COLS * 4)
    if g_deq == 0 { print("FAIL: gpu_malloc dequant out\n"); return 1 }
    if gpu_dequant(CUDA_DTYPE_Q4_K, g_w, g_deq, K_ROWS * K_COLS) != 0 {
        print("FAIL: gpu_dequant\n"); return 1
    }

    // Bring it back and compare bit for bit against the CPU dequant.
    let back = "/tmp/cuda_kernels_deq.bin"
    if memcpy_d2h_async(g_deq, back, K_ROWS * K_COLS * 4) != 0 {
        print("FAIL: d2h dequant\n"); return 1
    }
    let f2 = open(back, 0, 0)
    if f2 < 0 { print("FAIL: open deq back\n"); return 1 }
    let gpu_f32 = mem_alloc(K_ROWS * K_COLS * 4)
    read_raw(f2, gpu_f32, K_ROWS * K_COLS * 4)
    close(f2)

    let bitdiff = 0
    let i = 0
    while i < K_ROWS * K_COLS {
        // CPU side holds f64; compare the f32 truncation, which is what the
        // device buffer holds. A mismatch here is a real arithmetic difference,
        // not a width difference.
        // Compare the device f32 against the CPU f64 by widening the device
        // value. An f32 is exactly representable in f64, so the two agree iff
        // the device result is the correctly-rounded f32 of the CPU value --
        // which is what "bit-exact dequant" means here.
        let cpu64 = f64of(mem_load(cpu_w + i * 8))
        let gpu64 = f32_to_f64(gpu_f32 + i * 4)
        if gpu64 != cpu64 { bitdiff = bitdiff + 1 }
        i = i + 1
    }
    print("dequant Q4_K on GPU: "); print(K_ROWS * K_COLS); print(" elements, bit-differing=")
    print(bitdiff); print("\n")
    if bitdiff != 0 { print("FAIL: GPU dequant is not bit-exact\n"); fails = fails + 1 }

    // ---- matvec on the GPU against a CPU matvec over the CPU weights ----
    let x = mem_alloc(K_COLS * 8)
    i = 0
    while i < K_COLS {
        // small deterministic values, |x| < 1
        mem_store(x + i * 8, f64bits(fdiv(i2f((i * 37) % 100 - 50), i2f(64))))
        i = i + 1
    }
    let xstage = "/tmp/cuda_kernels_x.bin"
    let fx = open(xstage, 577, 420)
    if fx < 0 { print("FAIL: open x stage\n"); return 1 }
    write_raw(fx, x, K_COLS * 8)
    close(fx)

    let g_x = gpu_malloc(K_COLS * 4)
    let g_y = gpu_malloc(K_ROWS * 4)
    if g_x == 0 { print("FAIL: gpu_malloc x\n"); return 1 }
    if g_y == 0 { print("FAIL: gpu_malloc y\n"); return 1 }
    // The device wants f32. Upload x as f64 and narrow it ON THE DEVICE:
    // Quanta has no host f64->f32 builtin, and the device converter is exact
    // for the values used here.
    let g_x64 = gpu_malloc(K_COLS * 8)
    if g_x64 == 0 { print("FAIL: gpu_malloc x64\n"); return 1 }
    if memcpy_h2d_async(xstage, g_x64, K_COLS * 8) != 0 { print("FAIL: h2d x64\n"); return 1 }
    if gpu_f64_to_f32(g_x64, g_x, K_COLS) != 0 { print("FAIL: f64_to_f32\n"); return 1 }
    gpu_free(g_x64)

    if gpu_matvec(CUDA_DTYPE_Q4_K, g_w, g_x, g_y, K_ROWS, K_COLS) != 0 {
        print("FAIL: gpu_matvec\n"); return 1
    }

    let ystage = "/tmp/cuda_kernels_y.bin"
    if memcpy_d2h_async(g_y, ystage, K_ROWS * 4) != 0 { print("FAIL: d2h y\n"); return 1 }
    let fy = open(ystage, 0, 0)
    if fy < 0 { print("FAIL: open y back\n"); return 1 }
    let gpu_y = mem_alloc(K_ROWS * 4)
    read_raw(fy, gpu_y, K_ROWS * 4)
    close(fy)

    // CPU matvec in f64.
    let worst = 0.0
    r = 0
    while r < K_ROWS {
        let acc = 0.0
        let c = 0
        while c < K_COLS {
            acc = fadd(acc, fmul(f64of(mem_load(cpu_w + (r * K_COLS + c) * 8)), f64of(mem_load(x + c * 8))))
            c = c + 1
        }
        let got = f32_to_f64(gpu_y + r * 4)
        let den = acc
        if den < 0.0 { den = fsub(0.0, den) }
        let d = den
        if d < 0.000000000001 { d = 0.000000000001 }
        let diff = fsub(got, acc)
        if diff < 0.0 { diff = fsub(0.0, diff) }
        let rel = fdiv(diff, d)
        if rel > worst { worst = rel }
        r = r + 1
    }
    print("matvec Q4_K on GPU: worst relative error="); print(worst); print("\n")
    if worst > 0.00001 { print("FAIL: matvec error too large\n"); fails = fails + 1 }

    gpu_free(g_w)
    gpu_free(g_deq)
    gpu_free(g_x)
    gpu_free(g_y)

    if fails == 0 { print("cuda_kernels: all pass\n") } else { print("cuda_kernels: FAILURES\n") }
    return 0
}
