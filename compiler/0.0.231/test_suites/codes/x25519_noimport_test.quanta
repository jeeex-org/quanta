// x25519_noimport_test.quanta — test without import

fn print_hex(label, ptr, n) {
  let s = ""
  let i = 0
  while i < n {
    let b = mem_load8(ptr + i)
    let hi = b >> 4; let lo = b & 0xf
    if hi < 10 { s = str(s, hi + 48) } else { s = str(s, hi + 87) }
    if lo < 10 { s = str(s, lo + 48) } else { s = str(s, lo + 87) }
    i = i + 1
  }
  println(s)
}

fn main() {
  println("Test mem_alloc...")
  let x = mem_alloc(40)
  println("mem_alloc done")
  mem_store8(x, 0xaa)
  mem_store8(x+1, 0xbb)
  println("stored bytes")
  print_hex("x", x, 2)
  
  let y = mem_alloc(40)
  mem_store8(y, 0xcc)
  mem_store8(y+1, 0xdd)
  print_hex("y", y, 2)
  
  println(0)
  exit(0)
}