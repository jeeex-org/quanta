fn main() {
  let aba = 0x1111111111111111
  let aga = 0x2222222222222222
  let aka = 0x4444444444444444
  let ama = 0x8888888888888888
  let asa = 0x3333333333333333
  let ca = aba ^ aga ^ aka ^ ama ^ asa
  // expected: 0x1111^0x2222^0x4444^0x8888^0x3333 = 0xFFFFFFFFFFFFFFFF parity: 1^1... 
  // compute expected in a way independent: just sum xor
  let e = 0
  e = e ^ aba; e = e ^ aga; e = e ^ aka; e = e ^ ama; e = e ^ asa
  let diff = ca ^ e
  if diff == 0 { exit(0) } else { exit(1) }
}
