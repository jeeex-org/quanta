import std/sha3_256_only
import std/test_helpers

fn main() {
  // SHA3-256("") = a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a
  let e = mem_alloc(32)
  sha3_256("", 0, e)
  let ve = mem_alloc(32)
  hex_to_bytes(ve, "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", 32)
  if mem_eq(e, ve, 32) == 0 { exit(1) }
  exit(0)
}