// Real Implementation: Leases (ASC 842)
// Domain: accounting | Category: GAAP | Module: Leases

// Classify a lease: returns 1 for finance, 0 for operating
fn classify_lease(lease_term_pct: i64, pv_pct: i64, ownership_transfer: i64, purchase_option: i64) -> i64 {
    if ownership_transfer == 1 { return 1 }
    if purchase_option == 1 { return 1 }
    if lease_term_pct >= 75 { return 1 }
    if pv_pct >= 90 { return 1 }
    return 0
}

fn lease_liability(annual_payment: i64, lease_term_years: i64) -> i64 {
    if lease_term_years <= 0 { return 0 }
    return annual_payment * lease_term_years
}

fn right_of_use_asset(lease_liability: i64, prepaid: i64, initial_costs: i64, incentives: i64) -> i64 {
    return lease_liability + prepaid + initial_costs - incentives
}

fn finance_lease_interest(year: i64, liability_balance: i64, rate_pct: i64) -> i64 {
    if liability_balance <= 0 { return 0 }
    return (liability_balance * rate_pct) / 100
}

fn operating_lease_expense(total_payments: i64, lease_term_months: i64) -> i64 {
    if lease_term_months <= 0 { return 0 }
    return total_payments / lease_term_months
}

fn amortize_lease_liability(liability: i64, payment: i64, interest_portion: i64) -> i64 {
    let principal = payment - interest_portion
    let remaining = liability - principal
    if remaining < 0 { return 0 }
    return remaining
}
