// std/git.quanta - Git integration for Quanta

module std_git;

fn git_init() {
    return system("git init");
}

fn git_add(file) {
    return system("git add " + file);
}

fn git_commit(msg) {
    return system("git commit -m \"" + msg + "\"");
}

fn git_status() {
    return system("git status --porcelain");
}

fn git_diff(file) {
    return system("git diff " + file);
}

fn git_log(n) {
    return system("git log --oneline -" + n);
}

fn git_branch() {
    return system("git branch --show-current");
}

fn git_remote_url() {
    return system("git config --get remote.origin.url");
}

fn git_push() {
    return system("git push");
}

fn git_pull() {
    return system("git pull");
}

fn system(cmd) {
    // Placeholder - would use syscall in real implementation
    return 0;
}

fn init() -> i64 {
    return 0;
}