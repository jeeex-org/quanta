        flush_all(); eb(72); eb(137); eb(248); eb(72); eb(15); eb(200); return 1
    }    if nl==8&&r8(nm)=='p'&&r8(nm+1)=='o'&&r8(nm+2)=='p'&&r8(nm+3)=='c'&&r8(nm+4)=='o'&&r8(nm+5)=='u'&&r8(nm+6)=='n'&&r8(nm+7)=='t' {
        flush_all(); eb(72); eb(248); eb(243); eb(72); eb(15); eb(184); eb(192); return 1
    }    if nl==3&&r8(nm)=='c'&&r8(nm+1)=='l'&&r8(nm+2)=='z' {
        flush_all(); eb(72); eb(248); eb(243); eb(72); eb(15); eb(189); eb(192); return 1
    }    if nl==3&&r8(nm)=='c'&&r8(nm+1)=='t'&&r8(nm+2)=='z' {
        flush_all(); eb(72); eb(248); eb(243); eb(72); eb(15); eb(188); eb(192); return 1
    }    if nl==4&&r8(nm)=='r'&&r8(nm+1)=='o'&&r8(nm+2)=='t'&&r8(nm+3)=='l' {
        flush_all(); eb(72); eb(137); eb(241); eb(72); eb(211); eb(192); return 1
