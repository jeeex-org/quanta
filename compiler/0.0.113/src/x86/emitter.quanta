        eb(72); eb(139); eb(116); eb(36); eb(0)   // mov rsi, [rsp]  (old)  48 8B 74 24 00
        eb(72); eb(141); eb(118); eb(8)   // lea rsi, [rsi+8]  48 8D 76 08
        eb(252)                           // cld
        eb(243); eb(164)                  // rep movsb
        // munmap(old, old_n*8+8)
        eb(72); eb(139); eb(116); eb(36); eb(0)   // mov rsi, [rsp]  (old)  48 8B 74 24 00
        eb(72); eb(137); eb(247)          // mov rdi, rsi  (rdi=old)  48 89 F7
        eb(72); eb(139); eb(116); eb(36); eb(8)   // mov rsi, [rsp+8]  (old_n)  48 8B 74 24 08
        eb(72); eb(193); eb(230); eb(3)   // shl rsi, 3  (old_n*8)  48 C1 E6 03
        eb(72); eb(131); eb(198); eb(8)   // add rsi, 8  (old_n*8+8)  48 83 C6 08
        eb(184); ei(11)                   // mov eax, 11 (munmap)
        sysc()
        rr(0,3)                           // rax = rbx (new)
        eb(89); eb(94); eb(95)             // pop rdx, pop rsi, pop rdi (balance 3 pushes)
        return 1
    }
    // mem_load / mem_load8 / mem_store / mem_store8
    if nl>=8&&r8(nm)=='m'&&r8(nm+1)=='e'&&r8(nm+2)=='m'&&r8(nm+3)=='_' {
        flush_all()   // memory builtins clobber rdi/rsi/rax; spill live vregs first
        if r8(nm+4)=='l' {
            if nl==9 { eb(72); eb(15); eb(182); eb(7); return 1 }  // mem_load8: movzx rax,byte[rdi]
            eb(72); eb(139); eb(7); return 1                       // mem_load:  mov rax,[rdi]
        }
        if r8(nm+4)=='s' {
            if nl==10 { 
                eb(72); eb(133); eb(255)       // test rdi, rdi
                eb(116); eb(3)                 // jz +3 (skip the store when rdi==0)
                eb(64); eb(136); eb(55)        // mov [rdi], sil
                eb(72); eb(137); eb(240)       // mov rax, rsi  (return value)
                return 1 
            }        // mem_store8 (inline): null-guarded store, no ret
            eb(72); eb(137); eb(55); return 1                      // mem_store:  mov [rdi],rsi
        }
    }
    // Fallback to emit_bltn2 to keep each dispatch fn under the size ceiling.
    if emit_bltn2(nmi,nl,ii)==1 { return 1 }
    return 0
}
fn emit_bltn2(nmi,nl,ii) {
    let nm=src+nmi
    // 0.0.68: user functions win over builtins here too, with the same
    // primitive-intrinsic exception (see emit_bltn).
    if is_prim_intrin(nmi,nl)==0 {
        if findfn(nmi,nl)>=0 { return 0 }
    }

    // file_open / file_read / file_write / file_close
    if nl>=8&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='l'&&r8(nm+3)=='e'&&r8(nm+4)=='_' {
        let c5=r8(nm+5)
        if c5=='o' {                   // open(path, flags, mode)
            // path may be a Quanta string literal (needs +8 to skip the
            // length prefix) OR a raw C-string pointer (e.g. argv, no prefix).
            // Detect via the vreg_is_str tag, mirroring print()/echo().
            let _av = irres(ira2(ii))
            let _aisop = irop(ira2(ii))
            let _isstr = r64(vreg_is_str + _av*8)
            if _isstr!=1 && _aisop==IR_MOV {
                let _srcv = ira0(ira2(ii))
                if r64(vreg_is_str + _srcv*8)==1 { _isstr = 1 }
            }
            if _isstr!=1 && _aisop==IR_STR { _isstr = 1 }
            flush_all()   // syscalls clobber rdi/rsi/rdx/rax; spill live vregs first
            if _isstr==1 { argp8(7, ira2(ii), 0) }   // rdi = path + 8
            // else rdi already holds the raw pointer from IR_CALL arg load
            eb(184); ei(2); sysc(); return 1
        }
        if c5=='r' { eb(184); ei(0); sysc(); return 1 }                    // read
        if c5=='w' { eb(184); ei(1); sysc(); return 1 }                    // write
        if c5=='c' { eb(184); ei(3); sysc(); return 1 }                    // close
    }
    // 0.0.106: networking builtins (raw Linux syscalls). IR_CALL already loaded
    // rdi/rsi/rdx from args 0/1/2 (same convention as file_open). We only set
    // rax=syscall-num and issue the syscall; the result is in rax (fd/0/-errno).
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='o'&&r8(nm+2)=='c'&&r8(nm+3)=='k'&&r8(nm+4)=='e'&&r8(nm+5)=='t' {
        flush_all(); ri(0,41); sysc(); return 1   // socket(domain,type,proto) -> fd
    }
    if nl==7&&r8(nm)=='c'&&r8(nm+1)=='o'&&r8(nm+2)=='n'&&r8(nm+3)=='n'&&r8(nm+4)=='e'&&r8(nm+5)=='c'&&r8(nm+6)=='t' {
        flush_all(); ri(0,42); sysc(); return 1   // connect(fd,sa_ptr,len) -> 0
    }
    if nl==4&&r8(nm)=='b'&&r8(nm+1)=='i'&&r8(nm+2)=='n'&&r8(nm+3)=='d' {
        flush_all(); ri(0,49); sysc(); return 1   // bind(fd,sa_ptr,len) -> 0
    }
    if nl==6&&r8(nm)=='l'&&r8(nm+1)=='i'&&r8(nm+2)=='s'&&r8(nm+3)=='t'&&r8(nm+4)=='e'&&r8(nm+5)=='n' {
        flush_all(); ri(0,50); sysc(); return 1   // listen(fd,backlog) -> 0
    }
    if nl==6&&r8(nm)=='a'&&r8(nm+1)=='c'&&r8(nm+2)=='c'&&r8(nm+3)=='e'&&r8(nm+4)=='p'&&r8(nm+5)=='t' {
        flush_all(); ri(0,43); sysc(); return 1   // accept(fd,sa_ptr,len_ptr) -> newfd
    }
    // syscall(num, a, b, c, d, e, f): GENERIC raw Linux syscall (any arity 1..7).
    //   IR_CALL already did flush_all() and loaded args rdi/rsi/rdx/rcx/r8/r9
    //   (and pushed arg6+ on the stack). We do NOT rely on those registers;
    //   instead we reload each arg vreg from its SPILL HOME directly into the
    //   exact syscall-ABI register:
    //     rax=num, rdi=a, rsi=b, rdx=c, r10=d, r8=e, r9=f
    //   (the 4th syscall arg is r10, not rcx — that's why we reload from homes
    //   rather than just shuffling IR_CALL's registers; arg6 also lives on the
    //   stack in IR_CALL's layout, so reloading from home covers it too.)
    if nl==7&&r8(nm)=='s'&&r8(nm+1)=='y'&&r8(nm+2)=='s'&&r8(nm+3)=='c'&&r8(nm+4)=='a'&&r8(nm+5)=='l'&&r8(nm+6)=='l' {
        // arg count = ira1(ii); arg-start index = ira2(ii)
        let sc_cnt = ira1(ii)
        let sc_base = ira2(ii)
        // Load arg k from its vreg home into the matching syscall register.
        // target regs: 0=rax,7=rdi,6=rsi,2=rdx,10=r10,8=r8,9=r9
        let sk = 0
        while sk < sc_cnt {
            if sk < 7 {
                let sv = irres(sc_base + sk)
                if sk == 0 { rbp(0, spill_home(sv)) }      // rax = num
                if sk == 1 { rbp(7, spill_home(sv)) }      // rdi = a
                if sk == 2 { rbp(6, spill_home(sv)) }      // rsi = b
                if sk == 3 { rbp(2, spill_home(sv)) }      // rdx = c
                if sk == 4 { rbp(10, spill_home(sv)) }     // r10 = d
                if sk == 5 { rbp(8, spill_home(sv)) }      // r8  = e
                if sk == 6 { rbp(9, spill_home(sv)) }      // r9  = f
