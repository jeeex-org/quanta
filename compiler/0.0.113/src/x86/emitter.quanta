    // identically to mem_free so the two share one code path. RAII default:
    // owned bindings auto-call drop() at scope exit (see owned_scope_pop_one).
    if nl==4&&r8(nm)=='d'&&r8(nm+1)=='r'&&r8(nm+2)=='o'&&r8(nm+3)=='p' {
        flush_all()
        eb(87)                                    // push rdi  (save ptr at [rsp])
        eb(91)                                    // pop rbx   (rbx = ptr, callee-saved)
        eb(72); eb(139); eb(4); eb(37); ei(HEAP_CTRL)   // mov rax, [HEAP_CTRL]  (old head)
        eb(72); eb(137); eb(91); eb(8)                 // mov [rbx+8], rax  ([ptr+8] = old head)  48 89 58 08
        eb(72); eb(137); eb(27); eb(37); ei(HEAP_CTRL) // mov [HEAP_CTRL], rbx  (list head = ptr)  48 89 1C 25 imm32
        ri(R_RAX, 0)                               // rax = 0  (clean return value)
        return 1
    }
    // 0.0.113 PROBE: rsp() -> rax = current rsp (for stack layout discovery).
    if nl==3&&r8(nm)=='r'&&r8(nm+1)=='s'&&r8(nm+2)=='p' {
        flush_all()
        eb(72); eb(137); eb(228)   // mov rax, rsp  (48 89 E0)
        return 1
    }
