        eb(15); eb(182); mr(3,0,2)    // movzx eax, dl   (0F B6 C2) -> parity raw (1=even)
        eb(72); eb(129); mr(3,6,0); ei(1)   // xor eax,1 -> parity = 1 if ODD #bits
