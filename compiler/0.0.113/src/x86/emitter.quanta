    // 0.0.111: mem_realloc(ptr, newn) — new block via mmap(len=newn*8+8),
    //   copy min(old_count=[ptr], newn) qwords old+8 -> new+8 via rep movsq,
    //   return new. (Free-list recycling deferred; mem_alloc unchanged ->
    //   fixpoint-safe. The old block is simply leaked here; full GC later.)
    //   args: rdi=ptr, rsi=newn. returns new in rax.
    //   Uses callee-saved regs (rbx=ptr, r12=newn, r13=new) and the emitter's
    //   safe move helpers (no hand-encoded eb bytes) so it is hoist-safe.
    if nl==11&&r8(nm)=='m'&&r8(nm+1)=='e'&&r8(nm+2)=='m'&&r8(nm+3)=='_'&&r8(nm+4)=='r'&&r8(nm+5)=='e'&&r8(nm+6)=='a'&&r8(nm+7)=='l'&&r8(nm+8)=='l'&&r8(nm+9)=='o'&&r8(nm+10)=='c' {
        flush_all()
        rr(R_RBX, R_RDI)        // rbx = ptr (callee-saved)
        rr(R_R12, R_RSI)        // r12 = newn (callee-saved)
        rr(R_RSI, R_R12)        // rsi = newn
        rshl(R_RSI, 3)          // rsi *= 8   (newn*8)
        eb(72); eb(131); eb(198); eb(8)   // add rsi, 8   (newn*8+8)
        ri(R_RDI, 0x60000001)   // edi = hint addr
        ri(R_RDX, 3)            // edx = PROT_READ|WRITE
        ri(R_R10, 0x22)         // r10d = MAP_PRIVATE|ANON
        ri(R_R8, -1)            // r8d = fd -1
        ri(R_R9, 0)             // r9d = offset 0
        ri(R_RAX, 9)            // eax = 9 (mmap)
        sysc()                  // rax = new block
        rr(R_R13, R_RAX)        // r13 = new (callee-saved)
        ldx(R_RCX, R_RBX, 0)    // rcx = old_count = [ptr]
        rr(R_RDX, R_R12)        // rdx = newn
        rcmp(R_RCX, R_RDX)      // cmp rdx, rcx  (newn vs old_count)
        jcc32(5, 3)             // JGE (newn>=old_count) -> skip next (rcx stays old_count)
        rr(R_RCX, R_RDX)        // rcx = newn   (rcx = min)
        rr(R_RDI, R_R13)        // rdi = new
        eb(72); eb(131); eb(199); eb(8)   // add rdi, 8   (new+8)
        rr(R_RSI, R_RBX)        // rsi = ptr
        eb(72); eb(131); eb(198); eb(8)   // add rsi, 8   (ptr+8)
