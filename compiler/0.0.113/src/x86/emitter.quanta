    // Each Quanta function uses a SysV-style prologue (push rbp; mov rsp,rbp;
    // push callee-saved; sub $frame,rsp), so rbp is the live frame base. The
    // return address the enclosing function will resume at lives at [rbp+8]
    // (rbp itself holds the saved caller rbp; +8 is the slot the CALL pushed).
    // Reading [rbp+8] of the *executing* frame is the immediate caller return
    // address, and it is safe (within the mapped frame). No per-call
    // instrumentation, so this is fixpoint-safe. Single-level unwind.
    if nl==11&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='a'&&r8(nm+3)=='c'&&r8(nm+4)=='k'&&r8(nm+5)=='_'&&r8(nm+6)=='t'&&r8(nm+7)=='r'&&r8(nm+8)=='a'&&r8(nm+9)=='c'&&r8(nm+10)=='e' {
        flush_all()
        rbp(0, 8)                        // rax = [rbp+8] = immediate caller return address
        return 1
    }
    // mk_any(tag, val): t9 generics primitive. Returns a STACK-LOCAL 2-tuple
    // (ptr, len=16); [ptr]=tag, [ptr+8]=val. Caller may copy it (w64) if it
    // must outlive this frame (tuple/return semantics handle the copy).
    if nl==6&&r8(nm)=='m'&&r8(nm+1)=='k'&&r8(nm+2)=='_'&&r8(nm+3)=='a'&&r8(nm+4)=='n'&&r8(nm+5)=='y' {
