    // 0.0.111: mem_free(ptr) — push block onto free-list at HEAP_CTRL.
    // (Deferred reuse: mem_alloc left UNCHANGED to keep emitted bytes stable -> fixpoint-safe.)
    //   [ptr+8] = [HEAP_CTRL];  [HEAP_CTRL] = ptr
    if nl==8&&r8(nm)=='m'&&r8(nm+1)=='e'&&r8(nm+2)=='m'&&r8(nm+3)=='_'&&r8(nm+4)=='f'&&r8(nm+5)=='r'&&r8(nm+6)=='e'&&r8(nm+7)=='e' {
        // Match proven realloc pattern: flush_all() FIRST, then push rdi (ptr).
        // Reference ptr via a callee-saved reg (rbx) since flush_all may clobber
        // scratch. [ptr+8] = [HEAP_CTRL]; [HEAP_CTRL] = ptr.
        flush_all()
        eb(87)                                    // push rdi  (save ptr at [rsp])
        eb(91)                                    // pop rbx   (rbx = ptr, callee-saved)
        eb(72); eb(139); eb(4); eb(37); ei(HEAP_CTRL)   // mov rax, [HEAP_CTRL]  (old head)
        eb(72); eb(137); eb(91); eb(8)                 // mov [rbx+8], rax  ([ptr+8] = old head)  48 89 58 08
        eb(72); eb(137); eb(27); eb(37); ei(HEAP_CTRL) // mov [HEAP_CTRL], rbx  (list head = ptr)  48 89 1C 25 imm32
        ri(R_RAX, 0)                              // rax = 0  (clean return value)
        return 1
