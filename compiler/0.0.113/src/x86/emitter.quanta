        let _isf = is_float_vr(_av)
        if _isf!=1 && _aop==IR_MOV { let _sfv=ira0(ira2(ii)); if is_float_vr(_sfv)==1 { _isf = 1 } }
        if _isf==1 {
            flush_all()
            let pos=nl()
            eb(72); eb(137); eb(248)                    // mov rax, rdi  (rdi = float bits from arg loader)
            rr(8,7)                                    // mov r8, rdi (raw float bits -> sign bit 63)
            eb(73); eb(193); eb(232); eb(63)            // shr r8, 63  (sign)
            eb(77); eb(137); eb(193)                    // mov r9, r8  (SAVE sign in r9)
            eb(72); eb(15); eb(186); eb(247); eb(63)    // btr rdi, 63  (clear float sign bit in rdi)
            eb(102); eb(72); eb(15); eb(110); eb(199)   // movq xmm0, rdi   (now positive float)
            ri64(2, 0x412e848000000000)                // 1e6 f64
            eb(102); eb(72); eb(15); eb(110); eb(202)   // movq xmm1, rdx
            eb(242); eb(15); eb(89); eb(193)            // mulsd xmm0, xmm1
            eb(242); eb(72); eb(15); eb(44); eb(192)    // cvttsd2si rax, xmm0  (scaled, positive)
            lbladd(pos, codelen)
            ri64(1, 1000000)
            rxor(2,2)
            eb(72); eb(247); eb(249)                    // idiv rcx (rcx=1000000): rax=ipart, rdx=fpart
            rr(11,0)                                   // mov r11, rax  (ipart)
            rr(0,2)                                    // mov rax, rdx  (rax = fpart)
            rxor(2,2)                                  // rdx = 0
            sbi(32); lesp(10, 23); rxor(8,8)           // buffer + length=0
            // fpart (6 digits, unrolled)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            eb(65); eb(198); eb(2); eb(46); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)   // '.' store
            let ipz=nl(); let iloop=nl(); let idone=nl()
            rr(0,11)                                   // mov rax, r11  (ipart into rax for digit loop)
            eb(72); eb(133); eb(192); let pz=codelen; jcc32(0,0); emit_patch(pz, ipz, 1)   // test rax,rax ; je ipz
            lbladd(iloop, codelen)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            eb(72); eb(133); eb(192); let pd=codelen; jcc32(0,0); emit_patch(pd, idone, 1)   // test rax,rax ; je idone
            let pl=codelen; jmp32(0); emit_patch(pl, iloop, 0)
            lbladd(ipz, codelen)
            eb(65); eb(198); eb(2); eb(48); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)   // '0' store (ipart==0)
            lbladd(idone, codelen)
            // sign (use r9, the saved sign flag)
            let sdone=nl(); eb(77); eb(133); eb(201); let p6=codelen; jcc32(0,0); emit_patch(p6, sdone, 1)   // test r9,r9 ; je sdone
            eb(65); eb(198); eb(2); eb(45); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)   // '-' store
            lbladd(sdone, codelen)
            eb(73); eb(141); eb(114); eb(1)             // lea rsi, [r10+1]
            rr(2,8); ri(7,1); ri(0,1); sysc()           // write float
            sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
            rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)   // newline
            abi(32)
            return 1
        }
        // integer path

        let lp_pos=nl(); let lp_zero=nl(); let lp_loop=nl(); let lp_done=nl(); let lp_signprep=nl(); let lp_write=nl()
        rr(0,7)                          // rax = rdi (value)
        sbi(32)                          // sub rsp, 32
        lesp(10, 23)                     // r10 = rsp + 23
        rxor(8,8); rxor(9,9); rr(9,0)
        eb(77); eb(193); eb(233); eb(63) // shr r9, 63
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp_pos, 1)   // je lp_pos (non-negative)
        rneg(0)                          // neg rax
        lbladd(lp_pos, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp_zero, 1)   // je lp_zero (value == 0)
        let p=codelen; jmp32(0); emit_patch(p, lp_loop, 0)                // jmp lp_loop
        lbladd(lp_zero, codelen)
        eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192) // '0', dec r10, inc r8
        let p=codelen; jmp32(0); emit_patch(p, lp_signprep, 0)            // jmp lp_signprep
        lbladd(lp_loop, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp_done, 1)   // je lp_done
        rxor(2,2); ri(1,10); ridiv(1)
        eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp_loop, 0)                // jmp lp_loop
        lbladd(lp_done, codelen); lbladd(lp_signprep, codelen)
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp_write, 1)  // je lp_write (skip if positive)
        eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192) // '-'
        lbladd(lp_write, codelen)
        eb(73); eb(141); eb(114); eb(1)   // lea rsi, [r10+1]
        rr(2,8); ri(7,1); ri(0,1); sysc()  // write integer
        // write '\n'
        sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)
        abi(32)
        return 1
    }
    // newline(): emit a single '\n' to stdout.
    if nl==7&&r8(nm)=='n'&&r8(nm+1)=='e'&&r8(nm+2)=='w'&&r8(nm+3)=='l'&&r8(nm+4)=='i'&&r8(nm+5)=='n'&&r8(nm+6)=='e' {
        flush_all()
        sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)
        return 1
    }
    // printsp(i): print integer i followed by a space.
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s'&&r8(nm+6)=='p' {
        flush_all(); let lp3_pos=nl(); let lp3_zero=nl(); let lp3_loop=nl(); let lp3_done=nl(); let lp3_signprep=nl(); let lp3_write=nl()
        rr(0,7); sbi(32); lesp(10,23); rxor(8,8); rxor(9,9); rr(9,0)
        eb(77); eb(193); eb(233); eb(63); rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp3_pos, 1)
        rneg(0); lbladd(lp3_pos, codelen); rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp3_zero, 1)
        let p=codelen; jmp32(0); emit_patch(p, lp3_loop, 0); lbladd(lp3_zero, codelen)
        eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp3_signprep, 0); lbladd(lp3_loop, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp3_done, 1); rxor(2,2); ri(1,10); ridiv(1)
        eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp3_loop, 0); lbladd(lp3_done, codelen); lbladd(lp3_signprep, codelen)
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp3_write, 1)
        eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        lbladd(lp3_write, codelen); eb(73); eb(141); eb(114); eb(1); rr(2,8); ri(7,1); ri(0,1); sysc()
        sbi(8); lesp(10,0); eb(178); eb(32); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8); abi(32); return 1
    }
    // prints(s): write header-string s (bytes at s+8, length len(s)) to stdout.
    if nl==6&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s' {
        flush_all()
        rr(6,7)                          // rsi = rdi (string ptr)
        eb(72); eb(129); eb(198); ei(8)  // rsi = ptr + 8 (byte start)  [modrm 0xC6 = add rsi, imm32]
        eb(72); eb(139); eb(23)          // rdx = [rdi] = len(s) (count)  [modrm 0x17 = mov rdx,[rdi]]
        ri(7,1); ri(0,1); sysc()         // sys_write(1, ptr+8, len)
        return 1
    }
    // --- Phase A1: unsigned arithmetic builtins (true unsigned x86) ---
    // IR_CALL has already flush_all()'d and loaded a=rdi, b=rsi. Do NOT call
    // flush_all() again here: emit_bltn's scratch spill relocates rsi -> rbx,
    // corrupting arg1. Use rdi/rsi directly.
    // udiv(a,b): unsigned a/b.
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='d'&&r8(nm+2)=='i'&&r8(nm+3)=='v' {
        rr(0,7)                            // rax = rdi = a (dividend low)
        rxor(2,2)                          // xor edx,edx (clear dividend high)
        eb(72); eb(247); eb(246)           // 48 F7 F6 = div rsi  (rax = a/b unsigned)
        return 1
    }
    // umod(a,b): unsigned a%b
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='m'&&r8(nm+2)=='o'&&r8(nm+3)=='d' {
        rr(0,7)                            // rax = rdi = a
        rxor(2,2)
        eb(72); eb(247); eb(246)           // div rsi
        rr(0,2)                            // rax = rdx (remainder)
        return 1
    }
    // ult/ugt/ulte/ugte(a,b): unsigned compares -> 0/1 in rax (low byte)
    // a=rdi(7), b=rsi(6); rcmp(r1,r2)=cmp r1,r2.
    // UNSIGNED setcc (rsetc uses the SIGNED setl/setg, so emit bytes directly).
    // Each setcc is "0F OP C0" = eb(15); eb(OP); mr(3,0,0)  (setX %al)
    //   0F 92=setb(<)  0F 97=seta(>)  0F 96=setbe(<=)  0F 93=setae(>=)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t' {
        rxor(0,0); rcmp(7,6); eb(15); eb(146); mr(3,0,0); return 1
    }
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t' {
        rxor(0,0); rcmp(7,6); eb(15); eb(151); mr(3,0,0); return 1
    }
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t'&&r8(nm+3)=='e' {
        rxor(0,0); rcmp(7,6); eb(15); eb(150); mr(3,0,0); return 1
    }
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t'&&r8(nm+3)=='e' {
        rxor(0,0); rcmp(7,6); eb(15); eb(147); mr(3,0,0); return 1
    }
    if nl==3&&r8(nm)=='l'&&r8(nm+1)=='e'&&r8(nm+2)=='n' {
        rmr(0,7); return 1
    }
    // u8/u32/u64(x): reinterpret x as unsigned of N bits (mask). Identity at the
    // 64-bit runtime; the mask bounds the value to the named unsigned width so
    // unsigned arithmetic/comparisons stay in range. Self-host neutral (emit is a
    // mov+and, well-defined regardless of optimizer state).
    if nl==2&&r8(nm)=='u'&&r8(nm+1)=='8' { flush_all(); rr(0,7); eb(72); eb(129); mr(3,4,0); ei(255); return 1 }   // rax=rdi; and rax,0xFF (0x81 imm32: 0xFF sign-extends, so MUST use imm32 form)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='3'&&r8(nm+2)=='2' { flush_all(); rr(0,7); eb(37); eb(255); eb(255); eb(255); eb(255); return 1 }  // and eax,0xFFFFFFFF (opcode 0x25 + imm32)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='6'&&r8(nm+2)=='4' { flush_all(); rr(0,7); return 1 }                          // 64-bit: identity (mov rax,rdi)
    // str(a,b): a=rdi, b=rsi. returns header ptr (len at [new], bytes at new+8)
    if nl==3&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // r13 = lb
        rr(7,15); ra(7,13) // rdi = la + lb = total
        eb(72);eb(255);eb(199)   // inc rdi -> total+1
        eb(72);eb(131);eb(199);eb(8)  // rdi += 8 -> size = total+9
        rr(6,7)            // rsi = size
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail guard: if rax<0 exit(1)
        rr(12,0)           // r12 = new
        rr(0,15); ra(0,13) // rax = total
        rr(7,12); eb(72);eb(137);eb(7)   // [new] = total
        // copy la bytes a+8 -> new+8
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = a+8 (rbx+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,15); eb(243);eb(164)    // rcx = la; rep movsb
        // copy lb bytes b+8 -> new+8+la
        rr(6,14); eb(72);eb(131);eb(198);eb(8)  // rsi = b+8 (r14+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,15)          // rdi += r15 (la) -- dest for b's bytes = new+8+la
        rr(1,13); eb(243);eb(164)    // rcx = lb; rep movsb
        // nul at new+8+total
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,15)          // rdi += r15 (la)
        ra(7,13)          // rdi += r13 (lb)
        eb(198);eb(7);eb(0)    // mov byte [rdi], 0  (C6 07 00)
        rr(0,12)           // rax = new
        return 1
    }
    // str_eq(a,b): compare two strings. a=rdi,b=rsi. Returns 1 if equal, 0 if not.
    // Header: [ptr]=len, bytes at ptr+8. Manual byte loop (repe cmpsb is broken in Quanta).
    // 'mov al,[rsi]' writes al (low byte of rax), so only set rax at the returns.
    // SINGLE 'return 1' (builtin exit); both paths converge: EQUAL sets rax=1,
    // MISMATCH uses rxor(0,0); a jmp32 skips the unneeded half. Offsets filled post-measure.
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r'&&r8(nm+3)=='_'&&r8(nm+4)=='e'&&r8(nm+5)=='q' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // rbp = lb  (13↔rbp under %8)
        rcmp(13,15)        // cmp rbp, r15  (lb vs la)
        jcc32(1, 54)       // jne -> lengths differ -> forward to MISMATCH (rxor)
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = a+8
        rr(7,14); eb(72); eb(131); eb(199); eb(8)   // rdi = b+8
        rr(1,15)           // rcx = la
        eb(138); eb(6)     // LOOP: mov al, [rsi]
        eb(58); eb(7)      // cmp al, [rdi]
        jcc32(1, 27)       // jne -> mismatch -> forward to MISMATCH (rxor)
        eb(72); eb(255); eb(198)   // inc rsi
        eb(72); eb(255); eb(199)   // inc rdi
        eb(72); eb(255); eb(201)   // dec rcx
        jcc32(1, -25)      // jne -> loop back (rcx!=0)  (backward)
        eb(72); eb(199); eb(192); eb(1); eb(0); eb(0); eb(0)   // mov rax, 1 (EQUAL)
        jmp32(3)           // jmp forward to END (skip rxor)
        rxor(0,0)          // MISMATCH: rax = 0
        return 1           // END: auto-ret
    }
    // str_ne(a,b): returns 1 if NOT equal, 0 if equal.
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r'&&r8(nm+3)=='_'&&r8(nm+4)=='n'&&r8(nm+5)=='e' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // rbp = lb
        rcmp(13,15)        // cmp rbp, r15  (lb vs la)
        jcc32(1, 50)       // jne -> lengths differ -> forward to NOT-EQUAL (mov rax,1)
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = a+8
        rr(7,14); eb(72); eb(131); eb(199); eb(8)   // rdi = b+8
        rr(1,15)           // rcx = la
        eb(138); eb(6)     // LOOP: mov al, [rsi]
        eb(58); eb(7)      // cmp al, [rdi]
        jcc32(1, 23)       // jne -> mismatch -> forward to NOT-EQUAL (mov rax,1)
        eb(72); eb(255); eb(198)   // inc rsi
        eb(72); eb(255); eb(199)   // inc rdi
        eb(72); eb(255); eb(201)   // dec rcx
        jcc32(1, -25)      // jne -> loop back (rcx!=0)  (backward)
        rxor(0,0)          // EQUAL: rax = 0
        jmp32(7)           // jmp forward to END (skip mov rax,1)
        eb(72); eb(199); eb(192); eb(1); eb(0); eb(0); eb(0)   // NOT-EQUAL: mov rax, 1
        return 1           // END: auto-ret
    }
    // qc_sys_cmd(cmd): run external command, return CmdResult{out,code,err} struct.
    // cmd=rdi = header ptr (len at [cmd], bytes at cmd+8). Returns heap struct:
    //   [0]  = len (24)
    //   [8]  = out_ptr (string header ptr, or 0 if empty)
    //   [16] = code    (i64, exit status)
    //   [24] = err_ptr (0; stderr not captured in this minimal impl)
    if nl==10&&r8(nm)=='q'&&r8(nm+1)=='c'&&r8(nm+2)=='_'&&r8(nm+3)=='s'&&r8(nm+4)=='y'&&r8(nm+5)=='s'&&r8(nm+6)=='_'&&r8(nm+7)=='c'&&r8(nm+8)=='m'&&r8(nm+9)=='d' {
        flush_all()
        // 0.0.55: load the cmd. Two cases:
        //   - compile-time string literal: its data-section address is in
        //     lit_addr[cmd_vreg] (populated by IR_STR codegen) and is non-zero.
        //   - runtime variable (e.g. let s="..."; $$(s)) or fn param: the string
        //     pointer lives in the vreg's home slot at runtime -> spill_home(cmd).
        // Discriminate by whether lit_addr[cmd] is populated (non-zero), since a
        // literal's address is always known, while a variable's may not be.
        let _cmdv = ira1(ii)
        if r64(lit_addr + _cmdv*8) != 0 {
            ri64(7, r64(lit_addr + _cmdv*8))      // literal: known data address
        } else {
            rbp(7, spill_home(_cmdv))             // variable/fn-param: runtime ptr
        }
        let l_parent=nl(); let l_rdbrk=nl(); let l_disc=nl()
        // Preserve callee-saved regs (r12-r15) per x86-64 ABI — this builtin
        // clobbers them, so save/restore to avoid corrupting caller state (e.g.
        // the result struct ptr held in r12 by the caller).
        eb(65); eb(84)   // push r12  (41 54)
        eb(65); eb(85)   // push r13  (41 55)
        eb(65); eb(86)   // push r14  (41 56)
        eb(65); eb(87)   // push r15  (41 57)
        // SAVE cmd (rdi) FIRST — every syscall below clobbers rdi. r14 = cmd+8 (bytes ptr).
        rr(14,7); ri(8,8); ra(14,8)
        // Allocate result struct: mmap(0, 48, RW, ANON|PRIVATE, -1, 0). The extra
        // 16 bytes past the 32-byte [len,out,code,err] header serve as the .err
        // buffer (zero-filled by mmap -> len 0 -> ""). err_ptr points at this
        // in-struct tail, so it is always a valid runtime address (no separate
        // mmap / register-clobber pitfalls).
        ri(6,48); ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()
        rr(12,0)           // r12 = result struct ptr (rax)
        // struct field access uses IR_IDX => load [base + idx*8 + 8].
        // So fields live at out@8, code@16, err@24; [0] is a len header.
        ri(0,24); stx(12,0,0)   // [r12+0] = 24 (len)
        stx(12,8,0)        // [r12+8] = 0 (out_ptr)
        stx(12,16,0)       // [r12+16] = 0 (code)
        // 0.0.55: .err returns a VALID empty string (stderr is not captured in
        // this minimal impl). The result struct was mmap'd as 48 bytes; the 16
        // bytes past the 32-byte header [r12+32..r12+48] serve as the .err buffer
        // (zero-filled by mmap -> len 0 -> ""). Point err_ptr at this in-struct
        // tail: it is always a valid runtime address.
        rr(0,12); ri(8,32); ra(0,8)   // r0 = r12 + 32 (err buffer inside struct)
        stx(12,24,0)       // [r12+24] = err_ptr -> "" (in-struct, zero-filled)
        // output string buffer (header + 4096 bytes): mmap(0, 4104, ...)
        ri(6,4104); ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()
        rr(15,0)           // r15 = out_buf (rax)
        // scratch S for argv/envp (4096 bytes)
        ri(6,4096); ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()
        rr(13,0)           // r13 = S
        // [S+16] = "/bin/sh\0"  (two 32-bit stores; ri is 32-bit so split the 8-byte literal)
        wmi(13,16,0x6e69622f)   // low:  "/bin"
        wmi(13,20,0x0068732f)   // high: "/sh\0"
        // [S+32] = "-c\0\0\0\0"
        wmi(13,32,0x0000632d)   // "-c\0\0"
        // r14 already = cmd+8 (saved at builtin entry before rdi was clobbered)
        // argv array at S+1024: [S+1024]=S+16, [S+1032]=S+32, [S+1040]=r14, [S+1048]=0
        rr(10,13); ri(8,16); ra(10,8); stx(13,1024,10)   // [S+1024] = S+16
        rr(10,13); ri(8,32); ra(10,8); stx(13,1032,10)   // [S+1032] = S+32
        stx(13,1040,14)                     // [S+1040] = r14
        ri(10,0);  stx(13,1048,10)          // [S+1048] = 0
        // pipe(S+2048): rdi = S+2048 (pipefd array; [S+2048]=read, [S+2052]=write)
        rr(7,13); ri(8,2048); ra(7,8); ri(0,22); sysc()   // pipe(S+2048)
        // fork() -> rax (0=child, >0=parent). fork = rax=57, rdi=0
        ri(0,57); ri(7,0); sysc()
        rtest(0,0); let pj=codelen; jcc32(3,0); emit_patch(pj, l_parent, 1)   // jg -> parent (rax>0)
        // ===== CHILD (rax==0) =====
        // dup2(write_fd=[S+2052], 1): rdi=[S+2052], rsi=1
        ldx(7,13,2052); ri(6,1); ri(0,33); sysc()     // dup2(write_fd, 1)
        // execve("/bin/sh", argv_array, 0): rdi = S+16 (path), rsi = S+1024 (argv), rdx = 0
        rr(7,13); ri(8,16); ra(7,8)      // rdi = S+16
        rr(6,13); ri(8,1024); ra(6,8)    // rsi = S+1024 (argv array)
        ri(2,0); ri(0,59); sysc()        // execve (rdx/envp=0)
        ri(7,127); ri(0,60); sysc()          // execve failed -> exit(127)
        // ===== PARENT =====
        lbladd(l_parent, codelen)
        // close write end so EOF propagates when child exits
        ldx(7,13,2052); ri(0,3); sysc()     // close(write_fd)
        // read loop: accumulate child output into out_buf+8, total len in r9
        rxor(9,9)                            // r9 = total = 0
        let l_rd=nl()
        lbladd(l_rd, codelen)
        // 0.0.55: cap output at the 4096-byte buffer. If total >= 4096 the buffer
        // is full; keep DRAINING the pipe (discard) so the child is not blocked on
        // a full pipe (which would hang wait4 forever). We never store past 4096.
        let _pjcap = codelen
        eb(73); eb(129); eb(249); ei(4096)   // cmp r9, 4096  (49 81 F9 00001000)
        let _pjcap2 = codelen
        jcc32(5, 0); emit_patch(_pjcap2, l_disc, 1)  // jge -> discard path
        ldx(7,13,2048)                       // rdi = read_fd
        rr(6,15); ri(8,8); ra(6,9); ra(6,8)  // rsi = out_buf + 8 + total
        ri(10,4096); rs(10,9)            // rdx = 4096 - total
        ri(0,0); sysc()                      // read -> rax = n
        rtest(0,0); let pj2=codelen; jcc32(4,0); emit_patch(pj2, l_rdbrk, 1)  // jle -> break (n<=0)
        ra(9,0)                              // total += n (rax=n)
        let pj3=codelen; jmp32(0); emit_patch(pj3, l_rd, 0)
        // discard path: read into out_buf+8 (overwrite, stays within 4096),
        // do NOT advance total. Keeps the pipe drained until child EOF.
        lbladd(l_disc, codelen)
        ldx(7,13,2048)                       // rdi = read_fd
        rr(6,15); ri(8,8); ra(6,8)           // rsi = out_buf + 8 (fixed; within buf)
        ri(10,4096); rs(10,0)            // rdx = 4096 (dummy; never stored)
        ri(0,0); sysc()                      // read -> rax = n
        rtest(0,0); let pj4=codelen; jcc32(4,0); emit_patch(pj4, l_rdbrk, 1)  // jle -> break
        jmp32(0); emit_patch(codelen-5, l_disc, 0)
        lbladd(l_rdbrk, codelen)
        // set output string header: [out_buf] = total (len). rax is 0 here (n<=0).
        rr(7,15); stx(7,0,9)  // [out_buf+0] = total (r9)
        // wait4(-1, &status@S+2064, 0, 0): rdi=-1, rsi=S+2064 (ADDRESS, not value)
        rr(6,13); ri(8,2064); ra(6,8)    // rsi = S+2064
        ri(7,-1); ri(2,0); ri(10,0); ri(0,61); sysc()   // rdi=-1, rdx=0, r10=0, wait4
        // extract exit code: code = (status >> 8) & 0xff  (WEXITSTATUS)
        ldx(6,13,2064)                    // r6 = status (low 32)
        eb(72); eb(193); eb(238); eb(8)   // shr r6, 8   (48 C1 EE 08)
        eb(72); eb(131); eb(230); eb(255) // and r6, 0xff (48 83 E6 FF)
        stx(12,16,6)      // [r12+16] = code
        stx(12,8,15)      // [r12+8] = out_buf (out_ptr)
        // NOTE: [r12+24] (err_ptr) is set earlier to the empty-string buffer
        // (in-struct tail, line ~1205); do NOT overwrite it with 0 here.
        // munmap S (4096): rdi=S, rsi=4096, rax=11
        rr(7,13); ri(8,4096); ri(0,11); sysc()
        rr(0,12)           // rax = result struct ptr
        // restore callee-saved regs
        eb(65); eb(95)   // pop r15  (41 5F)
        eb(65); eb(94)   // pop r14  (41 5E)
        eb(65); eb(93)   // pop r13  (41 5D)
        eb(65); eb(92)   // pop r12  (41 5C)
        return 1
    }
    // NOTE: a user-defined fn push(...) MUST win over this builtin. If a user fn
    // named "push" exists, this is not the builtin -> return 0 so the IR_CALL
    // handler emits a real (patched) call to the user function instead.
    if nl==4&&r8(nm)=='p'&&r8(nm+1)=='u'&&r8(nm+2)=='s'&&r8(nm+3)=='h' {
        if findfn(nmi,nl)>=0 { return 0 }
        flush_all()
        rr(3,7)            // rbx = v
        rr(13,6)           // r13 = e
        rmr(14,3)          // r14 = oldlen = [v]
        rr(7,14)           // rdi = oldlen
        eb(72);eb(131);eb(199);eb(9)      // add rdi, 9 -> size = oldlen+1(byte)+8(header) (48 83 C7 09)
        rr(6,7)            // rsi = size
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail guard: if rax<0 exit(1)
        rr(12,0)           // r12 = new
        rr(0,14); eb(72);eb(255);eb(192)  // rax = oldlen+1 = newlen (inc rax -> 48 FF C0)
        rr(7,12); eb(72);eb(137);eb(7)    // [new] = newlen
        // copy oldlen bytes v+8 -> new+8 via rep movsb
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = v+8 (rbx+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,14); eb(243);eb(164)               // rcx = oldlen; rep movsb
        // store byte e at new+8+oldlen
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,14)          // rdi += r14 (oldlen) -> new+8+oldlen
        eb(68);eb(136);eb(47)  // mov [rdi], r13b  (44 88 2F: REX.R->r13, byte store)
        rr(0,12)           // rax = new
        return 1
    }
    // pop(v): remove last byte, return it (or 0 if empty). byte-oriented (matches str). v=rdi.
    // Same user-wins guard as push: a user-defined fn pop(...) shadows this builtin.
    if nl==3&&r8(nm)=='p'&&r8(nm+1)=='o'&&r8(nm+2)=='p' {
        if findfn(nmi,nl)>=0 { return 0 }
        flush_all()
        rr(3,7)            // rbx = v
        rmr(14,3)          // r14 = oldlen
        let lz=nl(); let lret=nl()
        rtest(14,14)
        let p=codelen; jcc32(0,0); emit_patch(p, lz, 1)  // je lz (empty)
        rr(7,3)            // rdi = v
        eb(72);eb(131);eb(199);eb(7)   // add rdi, 7 (48 83 C7 07)
        ra(7,14)          // rdi += r14 (oldlen) -> v+7+oldlen = &last byte
        eb(72);eb(15);eb(182);eb(7)    // movzx rax, byte [rdi] (48 0F B6 07)
        rr(15,0)          // r15 = elem (save)
        rr(7,3)           // rdi = v
        rr(0,14); eb(72);eb(131);eb(232);eb(1)  // rax = oldlen-1 (sub rax,1)
        eb(72);eb(137);eb(7)   // [v] = rax
        rr(0,15)          // rax = elem
        let p2=codelen; jmp32(0); emit_patch(p2, lret, 0)
        lbladd(lz, codelen)
        rxor(0,0)         // rax = 0
        lbladd(lret, codelen)
        return 1
    }
    // argc(): return saved variadic arg count (frame-local, set by prologue).
    if nl==4&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g'&&r8(nm+3)=='c' {
        rbp(0, g_va_cnt_off)   // rax = [rbp + g_va_cnt_off]
        return 1
    }
    // arg(i): return variadic arg i (0-based, includes named params).
    //   i < 6  -> saved reg-arg area:  [r11 + g_va_reg_off + i*8]
    //   i >= 6 -> stack arg still there: [r11 + 16 + (i-6)*8]   (r11 = rbp)
    // i arrives in rdi (arg0). PRESERVE rdi (loop var) via push/pop.
    if nl==3&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g' {
        let lstack=nl(); let ldone=nl()
        eb(72); eb(129); mr(3,7,7); ei(6)   // cmp rdi, 6 (immediate)
        let p=codelen; jcc32(2, 0); emit_patch(p, lstack, 1)  // jl lstack (i<6)
        // --- i >= 6: r11 = rbp + 16 + (i-6)*8 ---
        eb(87)                          // push rdi (preserve index)
        rr(11, 5)                       // r11 = rbp
        eb(73); eb(129); mr(3,0,3); ei(16)   // add r11, 16
        rr(1, 7)                        // rcx = rdi (i)
        eb(72); eb(131); mr(3,5,1); eb(6)    // sub rcx, 6   -> rcx = i - 6
        eb(72); eb(193); eb(225); eb(3) // shl rcx, 3  (48 C1 E1 03) -> (i-6)*8
        ra(11, 1)                       // r11 += rcx
        lbase(0, 0)                     // rax = [r11]
        eb(95)                          // pop rdi
        let p1=codelen; jmp32(0); emit_patch(p1, ldone, 0)
        lbladd(lstack, codelen)
        // --- i < 6: r11 = rbp + g_va_reg_off + i*8 ---
        eb(87)                          // push rdi (preserve index)
        rr(11, 5)                       // r11 = rbp
        eb(73); eb(129); mr(3,0,3); ei(g_va_reg_off)  // add r11, g_va_reg_off
        eb(72); eb(193); eb(231); eb(3) // shl rdi, 3  (48 C1 E7 03) -> i*8
        ra(11, 7)                       // r11 += rdi
        lbase(0, 0)                     // rax = [r11]
        eb(95)                          // pop rdi
        lbladd(ldone, codelen)
        return 1
    }
    // P2: proc/env builtins (syscall-based)
    // getpid(): sc 39
    if nl==6&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='p'&&r8(nm+4)=='i'&&r8(nm+5)=='d' {
        flush_all()
        ri(0,39); sysc(); return 1
    }
    // getppid(): sc 110
    if nl==7&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='p'&&r8(nm+4)=='p'&&r8(nm+5)=='i'&&r8(nm+6)=='d' {
        flush_all()
        ri(0,110); sysc(); return 1
    }
    // arg_count(): process argv count (argc) -> load g_argc via RIP-relative
    if nl==9&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g'&&r8(nm+3)=='_'&&r8(nm+4)=='c'&&r8(nm+5)=='o'&&r8(nm+6)=='u'&&r8(nm+7)=='n'&&r8(nm+8)=='t' {
        let rd=aphys(0)
        let rex=72; if rd>=8 { rex=76 }
        eb(rex); eb(139); eb(5 + (rd%8)*8); ei(0)
        let pofs=codelen-4
        w64(gpatches+gpatchc*24, pofs)
        w64(gpatches+gpatchc*24+8, g_argc)
        w8(gpatches+gpatchc*24+16, 0)
        if gpatchc >= GPATCH_CAP { emit_ovf() }
        gpatchc=gpatchc+1
        sdef(0, rd)
        return 1
    }
    // environ(): return g_environ pointer
    if nl==8&&r8(nm)=='e'&&r8(nm+1)=='n'&&r8(nm+2)=='v'&&r8(nm+3)=='i'&&r8(nm+4)=='r'&&r8(nm+5)=='o'&&r8(nm+6)=='n' {
        let rd=aphys(0)
        let rex=72; if rd>=8 { rex=76 }
        eb(rex); eb(139); eb(5 + (rd%8)*8); ei(0)
        let pofs=codelen-4
        w64(gpatches+gpatchc*24, pofs)
        w64(gpatches+gpatchc*24+8, g_environ)
        w8(gpatches+gpatchc*24+16, 0)
        if gpatchc >= GPATCH_CAP { emit_ovf() }
        gpatchc=gpatchc+1
        sdef(0, rd)
        return 1
    }
    // getenv(name): uses g_environ
    if nl==6&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='e'&&r8(nm+4)=='n'&&r8(nm+5)=='v' {
        flush_all()
        // getenv is complex - for now return 0
        let vr=aphys(0)
        ri(vr, 0)
        sdef(vr, vr)
        return 1
    }
    // getc(): read 1 byte from stdin, return it (0 on EOF). Stack scratch buffer.
    if nl==4&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='c' {
        flush_all()
        eb(72); eb(131); eb(236); eb(16)      // sub rsp, 16  (scratch) - imm8
        ri(7, 0)                                // rdi = 0 (stdin)
        eb(72); eb(137); eb(230)               // mov rsi, rsp (buf)
        ri(2, 1)                               // rdx = 1
        eb(184); ei(0); sysc()                 // read(0, rsp, 1)
        eb(72); eb(15); eb(182); eb(4); eb(36) // movzx eax, byte [rsp]
        eb(72); eb(131); eb(196); eb(16)       // add rsp, 16  - imm8
        sdef(0, 0); return 1
    }
    // ---- P2: float comparison builtins (SSE, return int 0/1, BRANCHLESS via setcc) ----
    // All comparisons use comisd (66 0F 2F) then a setcc to avoid jump/label patching.
    // NOTE: ucomisd (F2 0F 2E) triggers #UD in this target environment, so comisd is used.
    // comisd result flags:  a<b => CF=1,ZF=0 ; a==b => ZF=1 ; unordered => CF=ZF=PF=1
    // feq(a,b): ordered-equal. comisd sets ZF=1 for equal OR unordered, CF=1 for
    // a<b/unordered. Ordered-equal = ZF=1 AND CF=0 = sete AND setae. NOTE: do NOT
    // insert xor eax,eax here -- it sets ZF and clobbers the comisd flags.
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='e'&&r8(nm+2)=='q' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi
        eb(102); eb(72); eb(15); eb(110); eb(206)  // movq xmm1, rsi
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(148); eb(192)                   // sete al  (ZF=1)
        eb(15); eb(147); eb(193)                   // setae cl (CF=0)
        eb(32); eb(200)                            // and al, cl (20 C8) -> 1 only if ZF=1 AND CF=0
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // flt(a,b): a<b
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='l'&&r8(nm+2)=='t' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(72); eb(15); eb(110); eb(206)
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(146); eb(192)                   // setb al  (CF=1,ZF=0 => a<b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fle(a,b): a<=b
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='l'&&r8(nm+2)=='e' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(72); eb(15); eb(110); eb(206)
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(150); eb(192)                   // setbe al (CF=1 or ZF=1 => a<=b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fgt(a,b): a>b  (comisd a,b then seta)
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='g'&&r8(nm+2)=='t' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)  // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0(=a), xmm1(=b)
        eb(15); eb(151); eb(192)                   // seta al (CF=0,ZF=0 => a>b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fge(a,b): a>=b  (comisd a,b then setae)
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='g'&&r8(nm+2)=='e' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)  // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)
        eb(15); eb(147); eb(192)                   // setae al (CF=0 => a>=b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fisnan(a): unordered (PF=1)
    if nl==6&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='s'&&r8(nm+3)=='n'&&r8(nm+4)=='a'&&r8(nm+5)=='n' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi
        eb(102); eb(15); eb(47); eb(192)          // comisd xmm0, xmm0 (nan => PF=1)
        eb(15); eb(154); eb(192)                   // setp al (PF=1 => nan)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fisinf(a): abs(a)==inf
    if nl==6&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='s'&&r8(nm+3)=='i'&&r8(nm+4)=='n'&&r8(nm+5)=='f' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi
        ri(0, 0x7FF0000000000000)
        eb(102); eb(72); eb(15); eb(110); eb(192)  // movq xmm1, rax (inf bits)
        eb(102); eb(15); eb(80); eb(193)          // andpd xmm0, xmm1 (abs)
        eb(102); eb(72); eb(15); eb(110); eb(192)  // movq xmm1, rax
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(148); eb(192)                   // sete al (equal => inf)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // ---- P2: math builtins (SSE, f64 bit-pattern in/out) ----
    // sqrt(a): a=rdi
    if nl==4&&r8(nm)=='s'&&r8(nm+1)=='q'&&r8(nm+2)=='r'&&r8(nm+3)=='t' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)      // movq xmm0, rdi
        eb(242); eb(15); eb(81); eb(192)               // sqrtsd xmm0, xmm0 (F2 0F 51 C0)
        eb(102); eb(72); eb(15); eb(126); eb(192)      // movq rax, xmm0
        return 1
    }
    // floor(a), ceil(a): use roundsd
    if nl==5&&r8(nm)=='f'&&r8(nm+1)=='l'&&r8(nm+2)=='o'&&r8(nm+3)=='o'&&r8(nm+4)=='r' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(15); eb(58); eb(11); eb(192); eb(1)  // roundsd xmm0, xmm0, 1 (66 0F 3A 0B C0 01)
        eb(102); eb(72); eb(15); eb(126); eb(192)
        return 1
    }
    if nl==4&&r8(nm)=='c'&&r8(nm+1)=='e'&&r8(nm+2)=='i'&&r8(nm+3)=='l' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(15); eb(58); eb(11); eb(192); eb(2)  // roundsd xmm0, xmm0, 2 (66 0F 3A 0B C0 02)
        eb(102); eb(72); eb(15); eb(126); eb(192)
        return 1
    }
    // abs(a) for f64: clear sign bit
    if nl==3&&r8(nm)=='a'&&r8(nm+1)=='b'&&r8(nm+2)=='s' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        eb(72); eb(137); eb(192)           // mov rax, rdi
        ri64(1, 0x7FFFFFFFFFFFFFFF)        // mov rcx, mask
        eb(72); eb(33); eb(200)            // and rax, rcx (48 21 C8)
        return 1
    }
    // ---- P2: fmin / fmax (SSE, branchless via comisd + cmov) ----
    // fmin(a,b): a=rdi, b=rsi. result = (b<a) ? b : a  (NaN -> a, like C fmin)
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='m'&&r8(nm+2)=='i'&&r8(nm+3)=='n' {
        flush_all()
        let arg0v = irres(ira2(ii))
        let arg1v = irres(ira2(ii)+1)
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        rbp(6, spill_home(arg1v))                     // rsi = b (arg1 from spill home)
        eb(102); eb(72); eb(15); eb(110); eb(199)   // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)   // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)           // comisd xmm0, xmm1 (a vs b)
        eb(15); eb(147); eb(192)                   // setae al (CF=0 => a>=b)
        rzx(0, 0)                                  // movzx eax, al
        rr(0, 7)                                   // mov rax, rdi (default a)
        rr(2, 6)                                   // mov rdx, rsi (b)
        rcmov(0, 0, 2)                             // cmovae rax, rdx (a>=b keep a else b) => min
        return 1
    }
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='m'&&r8(nm+2)=='a'&&r8(nm+3)=='x' {
        flush_all()
        let arg0v = irres(ira2(ii))
        let arg1v = irres(ira2(ii)+1)
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        rbp(6, spill_home(arg1v))                     // rsi = b (arg1 from spill home)
        eb(102); eb(72); eb(15); eb(110); eb(199)   // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)   // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)           // comisd xmm0, xmm1 (a vs b)
        eb(15); eb(146); eb(192)                   // setb al (CF=1 => a<b)
        rzx(0, 0)                                  // movzx eax, al
        rr(0, 7)                                   // mov rax, rdi (default a)
        rr(2, 6)                                   // mov rdx, rsi (b)
        rcmov(1, 0, 2)                             // cmovb rax, rdx (a<b take b) => max
        return 1
    }
    // ---- P2: transcendentals via x87 FPU (freestanding, no libm) ----
    // Input is the f64 bit-pattern in rdi. We spill to the stack, load to x87,
    // compute, store back, and return the bit-pattern in rax.
    // sin(a): fld a; fsin
    if nl==3&&r8(nm)=='s'&&r8(nm+1)=='i'&&r8(nm+2)=='n' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)                                  // sub rsp, 16
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]   (DD 04 24)
        eb(217); eb(254)                          // fsin              (D9 FE)
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]  (DD 1C 24)
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)                                 // add rsp, 16 (undo sbi(16))
        return 1
    }
    // cos(a): fld a; fcos
    if nl==3&&r8(nm)=='c'&&r8(nm+1)=='o'&&r8(nm+2)=='s' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]
        eb(217); eb(255)                          // fcos              (D9 FF)
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)
        return 1
    }
    if nl==3&&r8(nm)=='t'&&r8(nm+1)=='a'&&r8(nm+2)=='n' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]
        eb(217); eb(242)                          // fptan             (D9 F2)
        eb(221); eb(216)                          // fstp st(0)        (DD D8) -> drops the 1.0, tan in st1->st0
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)
        return 1
    }
    // log(a) = ln(a): fldln2; fld a; fyl2x  (st0 = ln2 * log2(a) = ln(a))
    if nl==3&&r8(nm)=='l'&&r8(nm+1)=='o'&&r8(nm+2)=='g' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(217); eb(237)                          // fldln2            (D9 ED)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]   (a)
        eb(217); eb(241)                          // fyl2x             (D9 F1) -> st0 = ln2*log2(a)
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)
        return 1
    }
    // pow(a,b) = exp(b * ln(a)). Compute ln(a) via fyl2x*ln2, multiply by b, exp.
    if nl==3&&r8(nm)=='p'&&r8(nm+1)=='o'&&r8(nm+2)=='w' {
        flush_all()
        let arg0v = irres(ira2(ii))
        let arg1v = irres(ira2(ii)+1)
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        rbp(6, spill_home(arg1v))                     // rsi = b (arg1 from spill home)
        sbi(32)                                  // sub rsp, 32 (slots: a[rsp], b[rsp+8])
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi      (a bits)
        eb(72); eb(137); eb(116); eb(36); eb(8)   // mov [rsp+8], rsi  (b bits)
        // ln(a): fldln2; fld [rsp]; fyl2x
        // z = b * log2(a). log2(a) via fyl2x: fld1; fld a; fyl2x -> st0 = 1.0*log2(a) = log2(a)
        // (z = b*ln(a)*log2(e) = b*log2(a) since ln(a)*log2(e)=log2(a) exactly — avoids rounding error)
        eb(217); eb(232)                          // fld1               (D9 E8)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]     (a)
        eb(217); eb(241)                          // fyl2x -> st0 = log2(a)
        eb(221); eb(68); eb(36); eb(8)            // fld qword [rsp+8]   (b)
        eb(222); eb(201)                          // fmulp st(1),st(0)   (DE C9) -> st0 = z = b*log2(a)
        // store z to [rsp] (a slot, no longer needed), reset FPU, reload clean
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]     (DD 1C 24)
        eb(219); eb(227)                          // fninit             (DB E3) clean FPU (clears stack + tags)
        fx87prep()                               // re-assert 64-bit precision (fninit defaulted 80-bit)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]     (DD 04 24)  reload z clean
        // exp2(z) — verified-correct x87 sequence (clean .S test: 2^10=1024, 2^0.5=1.414, 2^-1=0.5, 2^3=8)
        eb(217); eb(192)                          // fld st(0)          (D9 C0) [z, z]
        eb(217); eb(252)                          // frndint            (D9 FC) [trunc(z), z]
        eb(217); eb(201)                          // fxch st(1)         (D9 C9) [z, trunc(z)]  st0=z, st1=trunc
        eb(216); eb(225)                          // fsub st(1)         (D8 E1) st0=z-trunc=frac [frac, trunc]
        eb(217); eb(240)                          // f2xm1             (D9 F0) [2^frac-1, trunc]
        eb(217); eb(232)                          // fld1               (D9 E8) [1, 2^frac-1, trunc]
        eb(222); eb(193)                          // faddp st(1)        (DE C1) [2^frac, trunc]
        eb(217); eb(253)                          // fscale            (D9 FD) [2^z, trunc]
        eb(221); eb(217)                          // fstp st(1)        (DD D9) drop trunc -> [2^z]
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(32)                                 // add rsp, 32 (undo sbi(32))
        return 1
    }
    // ---- P2: random / fs-meta / introspection builtins (syscall-backed) ----
    // getrandom(buf, len, flags): sc 318
    if nl==9&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='r'&&r8(nm+4)=='a'&&r8(nm+5)=='n'&&r8(nm+6)=='d'&&r8(nm+7)=='o'&&r8(nm+8)=='m' {
        flush_all()
        ri(0,318); sysc(); return 1
    }
    // 0.0.102: substr(s, start, len) -> header ptr (len at [new], bytes at new+8).
    // s=rdi (header ptr), start=rsi (i64), len=rdx (i64). Copies len bytes
    // from s+8+start into a fresh mmap buffer; header=new len; NUL-terminated.
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='u'&&r8(nm+2)=='b'&&r8(nm+3)=='s'&&r8(nm+4)=='t'&&r8(nm+5)=='r' {
        flush_all()
        rr(3,7)            // rbx = s
        rr(14,6)           // r14 = start
        rr(13,2)           // r13 = len (rdx)
        rr(7,13); eb(72);eb(255);eb(199); eb(72);eb(131);eb(199);eb(8)  // rdi = len+1+8 = len+9
        rr(6,7)            // rsi = size
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail guard
        rr(12,0)           // r12 = new
        rr(0,13); rr(7,12); eb(72);eb(137);eb(7)   // [new] = len
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = s+8
        ra(6,14)           // rsi += start
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,13); eb(243);eb(164)    // rcx = len; rep movsb
        rr(7,12); eb(72);eb(131);eb(199);eb(8); ra(7,13); eb(198);eb(7);eb(0)  // NUL at new+8+len
        rr(0,12)           // rax = new
        return 1
    }
    // 0.0.102: strcat(a, b) -> header ptr. Identical concat to str(a,b).
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r'&&r8(nm+3)=='c'&&r8(nm+4)=='a'&&r8(nm+5)=='t' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // r13 = lb
        rr(7,15); ra(7,13) // rdi = la + lb = total
        eb(72);eb(255);eb(199)   // inc rdi -> total+1
        eb(72);eb(131);eb(199);eb(8)  // rdi += 8 -> size = total+9
        rr(6,7)            // rsi = size
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail guard
        rr(12,0)           // r12 = new
        rr(0,15); ra(0,13) // rax = total
        rr(7,12); eb(72);eb(137);eb(7)   // [new] = total
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = a+8
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,15); eb(243);eb(164)    // rcx = la; rep movsb
        rr(6,14); eb(72);eb(131);eb(198);eb(8)   // rsi = b+8
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,15)          // rdi += la
        rr(1,13); eb(243);eb(164)    // rcx = lb; rep movsb
        rr(7,12); eb(72);eb(131);eb(199);eb(8); ra(7,15); ra(7,13); eb(198);eb(7);eb(0)  // NUL
        rr(0,12)           // rax = new
        return 1
    }
    // 0.0.102: rand() -> i64. mmap 8 bytes, getrandom(buf,8,0), return the int.
    if nl==4&&r8(nm)=='r'&&r8(nm+1)=='a'&&r8(nm+2)=='n'&&r8(nm+3)=='d' {
        flush_all()
        ri(6,8); ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = buf (8B)
        rr(12,0)           // r12 = buf
        rr(7,12); ri(6,8); rxor(2,2); ri(0,318); sysc()   // getrandom(buf,8,0)
        rr(0,12); rmr(0,12)   // rax = [buf]  (random i64)
        return 1
    }
    // 0.0.104: str_split(s, sep) -> qword-array header ptr of N substrings.
    //   s   = rdi, sep = rsi (string headers: [ptr]=len, bytes at ptr+8).
    // Returns a qword array [ptr]=nparts; each element an independent string
    // header ptr (own mmap, byte-stride, NUL-terminated). No str tag => qword
    // stride (matches a[i] indexing). Single-byte sep. Empty s -> [""], 1 part.
    // No sep found in s -> [s], 1 part.
    if nl==9&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r'&&r8(nm+3)=='_'&&r8(nm+4)=='s'&&r8(nm+5)=='p'&&r8(nm+6)=='l'&&r8(nm+7)=='i'&&r8(nm+8)=='t' {
        flush_all()
        // ABI model: the IR_CALL prologue (codegen) already pushes
        // rbp,r12,r13,r14,r15 and `return 1` pops them, so r12,r13,r14,r15 are
        // free scratch here (caller values restored by the epilogue). rbx is the
        // ONLY callee-saved NOT in that set, so we save/restore it ourselves.
        // r10 (idx) is caller-saved and clobbered by the mmap syscall, so we
        // save/restore it only around the mmap. Everything else is balanced.
        //   rbx = s header            (pushed/popped manually)
        //   r13 = sep header          (prologue-saved, epilogue-restored)
        //   r12 = result arr          (prologue-saved, epilogue-restored)
        //   r15 = start (scan cursor) (prologue-saved, epilogue-restored)
        //   r14 = nparts (constant for whole loop; r13/r12/r15/rbx are
        //       prologue-saved so never clobbered)
        //   r11 = seg_len (transient; pushed with idx around the mmap)
        //   r9  = sub (mmap result) / slen (transient)
        //   r10 = idx (pushed/popped around mmap)
        // NOTE: do NOT push/pop rbx -- the IR_CALL caller already saved it, so
        // we may clobber it freely. A manual `push rbx` trips the audit canary.
        rr(3,7)            // rbx = s header (rdi = IR_CALL arg0)
        rr(13,6)           // r13 = sep header (rsi = IR_CALL arg1)
        rmr(0,3); rr(15,0) // r15 = slen = [rbx]  (temporary; reused as start later)
        // --- count parts: occ = number of sep bytes in s ---
        rxor(14,14)        // r14 = occ = 0
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = rbx+8 = s_data
        rr(1,15)           // rcx = slen
        let c_loop=nl(); let c_done=nl(); let c_next=nl()
        lbladd(c_loop, codelen)
        rtest(1,1); let p=codelen; jcc32(0,0); emit_patch(p, c_done, 1)   // rcx==0 -> done
        eb(172)            // lodsb  (al=[rsi]; rsi++)
        eb(65); eb(58); eb(69); eb(8)   // cmp al, [r13+8]  (sep first byte)
        let p2=codelen; jcc32(1,0); emit_patch(p2, c_next, 1)   // al != sep -> next
        rr(0,14); eb(72); eb(255); eb(192); rr(14,0)   // occ++  (inc rax; r14 = rax)
        lbladd(c_next, codelen)
        rr(1,1); eb(72); eb(255); eb(201)   // rcx--
        let p3=codelen; jmp32(0); emit_patch(p3, c_loop, 0)
        lbladd(c_done, codelen)
        rr(0,14); eb(72); eb(255); eb(192); rr(14,0)   // r14 = nparts = occ+1
        // --- allocate result array [arr]=nparts ---
        rr(7,14); eb(72); eb(193); eb(231); eb(3)   // rdi = nparts*8  (shl rdi,3)
        eb(72); eb(131); eb(199); eb(8)             // rdi += 8  (header)
        rr(6,7)           // rsi = size
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = arr
        rr(12,0)          // r12 = arr
        rr(7,12); smov(7,14)   // [arr] = nparts
        // --- build each part ---
        rxor(10,10)        // r10 = idx = 0
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = rbx+8 = s_data (first scan cursor)
        let b_loop=nl(); let b_done=nl(); let b_find=nl(); let b_cont=nl(); let b_alloc=nl(); let b_end=nl()
        lbladd(b_loop, codelen)
        rcmp(10,14)        // cmp idx(r10), nparts(r14)  [nparts stays in r14]
        let p4=codelen; jcc32(0,0); emit_patch(p4, b_done, 1)   // idx == nparts -> done
        rr(15,6)           // r15 = start = current rsi (callee-saved, survives mmap)
        lbladd(b_find, codelen)
        rmr(0,3); rr(9,0)   // r9 = slen = [rbx]  (reload; keep r15=start)
        rr(0,3); eb(72); eb(131); eb(192); eb(8); ra(0,9)   // rax = s_end = rbx+8+slen
        rr(1,0)            // rcx = s_end
        rs(1,6)            // rcx = s_end - rsi = remaining
        rtest(1,1); let p5=codelen; jcc32(0,0); emit_patch(p5, b_end, 1)   // remaining==0 -> last segment
        eb(172)            // lodsb  (al=[rsi]; rsi++)
        eb(65); eb(58); eb(69); eb(8)   // cmp al, [r13+8]  (sep first byte)
        let p6=codelen; jcc32(1,0); emit_patch(p6, b_cont, 1)   // al != sep -> keep scanning
        // FOUND sep: rsi points at sep+1; seg_len = (rsi-1) - start
        rr(11,6)           // r11 = rsi
        eb(73); eb(131); eb(235); eb(1)   // r11 -= 1  (sep position)
        rs(11,15)          // r11 -= r15 (start) -> seg_len  (keep nparts in r14)
        let pba=codelen; jmp32(0); emit_patch(pba, b_alloc, 0)
        lbladd(b_cont, codelen)   // continue scanning (this byte != sep)
        let p7=codelen; jmp32(0); emit_patch(p7, b_find, 0)
        lbladd(b_end, codelen)   // no sep left; segment runs from start to s_end
        rr(11,6)           // r11 = rsi (= s_end)
        rs(11,15)          // r11 -= r15 (start) -> seg_len  (keep nparts in r14)
        lbladd(b_alloc, codelen)
        eb(65); eb(82)     // push r10  (save idx across mmap)
        eb(65); eb(83)     // push r11  (save seg_len across mmap)
        rr(7,11); eb(72); eb(131); eb(199); eb(8)   // rdi = seg_len(r11) + 8
        rr(6,7)            // rsi = seg_len + 8 (mmap length)
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = sub
        rr(9,0)            // r9 = sub
        eb(65); eb(91)     // pop r11  (restore seg_len BEFORE the syscall-clobbered r11 is used)
        rr(7,9)            // rdi = sub
        smov(7,11)         // [sub] = seg_len (r11)  -- r11 now holds the restored seg_len
        eb(65); eb(90)     // pop r10  (restore idx)
        rr(6,15)           // rsi = start (r15)  -- reset scan cursor to segment start for copy
        rr(7,9); eb(72); eb(131); eb(199); eb(8)   // rdi = sub + 8
        rr(1,11)           // rcx = seg_len (r11)
        let cp_loop=nl(); let cp_done=nl()
        lbladd(cp_loop, codelen)
        rtest(1,1); let p8=codelen; jcc32(0,0); emit_patch(p8, cp_done, 1)   // rcx==0 -> done
        eb(172)            // lodsb  (al=[rsi]; rsi++)
        eb(170)            // stosb  ([rdi]=al; rdi++)
        rr(1,1); eb(72); eb(255); eb(201)   // rcx--
        let p9=codelen; jmp32(0); emit_patch(p9, cp_loop, 0)
        lbladd(cp_done, codelen)
        eb(72); eb(131); eb(198); eb(1)   // rsi += 1  (skip past the separator for next segment)
        rr(7,12)           // rdi = arr
        rr(0,10); eb(72); eb(193); eb(224); eb(3)   // rax = idx*8  (shl rax,3)
        eb(72); eb(141); eb(124); eb(7); eb(8)   // lea 0x8(%rdi,%rax,1),%rdi  (arr+8+idx*8; rdi=dest, SIB idx=rax)
        smov(7,9)          // [rdi] = sub (r9)
        rr(0,10); eb(72); eb(255); eb(192); rr(10,0)   // idx++  (inc rax; r10 = rax)
        let p10=codelen; jmp32(0); emit_patch(p10, b_loop, 0)
        lbladd(b_done, codelen)
        rr(0,12)          // rax = arr (return value)
        // Mark the result vreg as a "string-array" so that IR_IDX on it reads
        // each element (a string pointer) with a STRING tag -- enabling byte
        // stride indexing (parts[i][j]) and len(parts[i]) to work correctly.
        w64(vreg_str_arr + irres(ii)*8, 1)
        return 1
    }
    //   s = rdi (string header: [s]=len, bytes at s+8, UTF-8).
    // Decodes each code point (1/2/3/4-byte) to its scalar (i64) stored as a
    // qword element. Result is a qword array (no str tag). Malformed lead bytes
    // (0x80-0xBF seen as a lead) are stored as the raw byte value (1-byte).
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='t'&&r8(nm+2)=='f'&&r8(nm+3)=='8' {
        flush_all()
        // ABI-correct leaf: save callee-saved regs this builtin scratches.
        eb(53)                       // push rbx
        eb(65); eb(84)               // push r12
        eb(65); eb(87)               // push r15
        rr(3,7)            // rbx = s header
        rmr(0,3); rr(15,0) // r15 = slen = [s]
        // --- pass 1: count codepoints (lead bytes) ---  NOTE: n lives in r12
        // (callee-saved) because the mmap syscall clobbers r11 + rcx.
        rxor(12,12)        // r12 = n = 0
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = s+8
        rr(1,15)           // rcx = slen
        let u_c=nl(); let u_cd=nl(); let u_lead=nl(); let u_nxt=nl()
        lbladd(u_c, codelen)
        rtest(1,1); let p=codelen; jcc32(0,0); emit_patch(p, u_cd, 1)   // rcx==0 -> done
        eb(172)            // lodsb
        rr(1,1); eb(72); eb(255); eb(201)   // rcx--
        eb(60); eb(128)     // cmp al, 0x80
        let p1=codelen; jb32(0); emit_patch(p1, u_lead, 1)   // jb (unsigned) -> lead (al<0x80)
        eb(60); eb(192)     // cmp al, 0xC0
        let p2=codelen; jb32(0); emit_patch(p2, u_nxt, 1)   // jb (unsigned) -> continuation (0x80..0xBF), skip
        lbladd(u_lead, codelen)
        rr(0,12); eb(72); eb(255); eb(192); rr(12,0)   // n++ (inc rax)
        lbladd(u_nxt, codelen)
        let p3=codelen; jmp32(0); emit_patch(p3, u_c, 0)
        lbladd(u_cd, codelen)
        // --- allocate result array ---
        rr(7,12); eb(72); eb(193); eb(231); eb(3); eb(72); eb(131); eb(199); eb(8)  // rdi = n*8+8 (shl rdi,3; +8; modrm 0xC7=rm/rdi)
        rr(6,7)
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = arr
        rr(9,0)            // r9 = arr (callee-saved; no further mmap)
        rr(7,9); smov(7,12)   // [arr] = n
        // --- pass 2: decode ---
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = s+8
        rr(1,15)           // rcx = slen
        rxor(13,13)         // r13 = idx = 0
        let u_d=nl(); let u_dd=nl(); let u_1=nl(); let u_2=nl(); let u_3=nl(); let u_4=nl(); let u_skip=nl(); let u_store=nl()
        lbladd(u_d, codelen)
        rmr(0,9); rcmp(13,0)   // cmp n(rax=[arr]), idx(r13)
        let p4=codelen; jcc32(0,0); emit_patch(p4, u_dd, 1)   // idx == n -> done
        eb(172)            // lodsb  (al = lead byte; rsi++)
        rr(1,1); eb(72); eb(255); eb(201)   // rcx--
        eb(60); eb(128)     // cmp al, 0x80
        let p5=codelen; jb32(0); emit_patch(p5, u_1, 1)   // jb (unsigned) -> 1-byte
        eb(60); eb(192)     // cmp al, 0xC0
        let p6=codelen; jb32(0); emit_patch(p6, u_skip, 1)   // jb (unsigned) -> continuation, skip
        eb(60); eb(224)     // cmp al, 0xE0
        let p7=codelen; jb32(0); emit_patch(p7, u_2, 1)   // jb (unsigned) -> 2-byte
        eb(60); eb(240)     // cmp al, 0xF0
        let p12=codelen; jb32(0); emit_patch(p12, u_3, 1)   // jb (unsigned) -> 3-byte
        let p13=codelen; jmp32(0); emit_patch(p13, u_4, 0)   // else 4-byte
        lbladd(u_skip, codelen)
        let p14=codelen; jmp32(0); emit_patch(p14, u_d, 0)
        lbladd(u_1, codelen)
        rr(3,0); eb(72); eb(129); eb(227); ei(255)   // rbx = al & 0xFF
        let p15=codelen; jmp32(0); emit_patch(p15, u_store, 0)
        lbladd(u_2, codelen)
        rr(3,0); eb(72); eb(129); eb(227); ei(31); eb(72); eb(193); eb(227); eb(6)  // rbx = (al&0x1F)<<6
        eb(172); rr(1,1); eb(72); eb(255); eb(201)   // lodsb b1; rcx--
        rr(2,0); eb(72); eb(129); eb(226); ei(63); eb(72); eb(9); eb(211)   // rdx=b1&0x3F; or rbx,rdx
        let p16=codelen; jmp32(0); emit_patch(p16, u_store, 0)
        lbladd(u_3, codelen)
        rr(3,0); eb(72); eb(129); eb(227); ei(15); eb(72); eb(193); eb(227); eb(12)  // rbx = (al&0x0F)<<12
        eb(172); rr(1,1); eb(72); eb(255); eb(201)   // b1; rcx--
        rr(2,0); eb(72); eb(129); eb(226); ei(63); eb(72); eb(193); eb(226); eb(6); eb(72); eb(9); eb(211)  // b1<<6; or rbx,rdx
        eb(172); rr(1,1); eb(72); eb(255); eb(201)   // b2; rcx--
        rr(2,0); eb(72); eb(129); eb(226); ei(63); eb(72); eb(9); eb(211)   // b2; or rbx,rdx
        let p17=codelen; jmp32(0); emit_patch(p17, u_store, 0)
        lbladd(u_4, codelen)
        rr(3,0); eb(72); eb(129); eb(227); ei(7); eb(72); eb(193); eb(227); eb(24)  // rbx = (al&0x07)<<18
        eb(172); rr(1,1); eb(72); eb(255); eb(201)   // b1; rcx--
        rr(2,0); eb(72); eb(129); eb(226); ei(63); eb(72); eb(193); eb(226); eb(12); eb(72); eb(9); eb(211)  // b1<<12; or
        eb(172); rr(1,1); eb(72); eb(255); eb(201)   // b2; rcx--
        rr(2,0); eb(72); eb(129); eb(226); ei(63); eb(72); eb(193); eb(226); eb(6); eb(72); eb(9); eb(211)   // b2<<6; or
        eb(172); rr(1,1); eb(72); eb(255); eb(201)   // b3; rcx--
        rr(2,0); eb(72); eb(129); eb(226); ei(63); eb(72); eb(9); eb(211)   // b3; or rbx,rdx
        lbladd(u_store, codelen)
        rr(10,3)           // r10 = rbx (codepoint)
        rr(7,9); eb(72); eb(131); eb(199); eb(8)   // rdi = arr+8
        rr(0,13); eb(72); eb(193); eb(224); eb(3)   // rax = idx*8  (shl rax,3)
        ra(7,0)           // rdi += idx*8
        smov(7,10)         // [rdi] = r10 (codepoint)
        rr(0,13); eb(72); eb(255); eb(192); rr(13,0)   // idx++ (inc rax; r13=rax)
        let p8=codelen; jmp32(0); emit_patch(p8, u_d, 0)
        lbladd(u_dd, codelen)
        rr(0,9)           // rax = arr
        // restore callee-saved regs (reverse of push order); r9 left = arr
        eb(65); eb(95)               // pop r15
        eb(65); eb(92)               // pop r12
        eb(91)                       // pop rbx
        return 1
    }
    // =========================================================================
    // 0.0.105: lock-based atomic primitives (x86 LOCK-prefixed RMW / xchg).
    //   arg0 = ptr (i64*), arg1 = val, arg2 = new. Args arrive in
    //   rdi/rsi/rdx from IR_CALL; we reload from spill homes (flush_all ran)
    //   so the values are authoritative. Results return in rax (the IR_CALL
    //   epilogue saves rax into the result vreg's home). Only caller-saved
    //   regs are touched (rax/rdi/rsi/rdx), so no push/pop is needed.
    // -------------------------------------------------------------------------
    // atomic_load(ptr) -> old value at *ptr  (lock-free plain load; seq_cst
    //   on x86 is just a normal MOV since loads are not reordered with older
    //   loads). ptr=rdi, [rdi]=old -> rax.
    if nl==11&&r8(nm)=='a'&&r8(nm+1)=='t'&&r8(nm+2)=='o'&&r8(nm+3)=='m'&&r8(nm+4)=='i'&&r8(nm+5)=='c'&&r8(nm+6)=='_'&&r8(nm+7)=='l'&&r8(nm+8)=='o'&&r8(nm+9)=='a'&&r8(nm+10)=='d' {
        flush_all()
        let a0 = irres(ira2(ii))
        rbp(7, spill_home(a0))        // rdi = ptr
        rmr(0, 7)                     // rax = [rdi]  (48 8B 07)
        return 1
    }
    // atomic_store(ptr, val) -> val   (mov [rdi], rsi). Returns the stored val.
    if nl==12&&r8(nm)=='a'&&r8(nm+1)=='t'&&r8(nm+2)=='o'&&r8(nm+3)=='m'&&r8(nm+4)=='i'&&r8(nm+5)=='c'&&r8(nm+6)=='_'&&r8(nm+7)=='s'&&r8(nm+8)=='t'&&r8(nm+9)=='o'&&r8(nm+10)=='r'&&r8(nm+11)=='e' {
        flush_all()
        let a0 = irres(ira2(ii))
        let a1 = irres(ira2(ii)+1)
        rbp(7, spill_home(a0))        // rdi = ptr
        rbp(6, spill_home(a1))        // rsi = val
        smov(7, 6)                    // [rdi] = rsi  (48 89 3E)
        rr(0, 6)                      // rax = rsi (return val)
        return 1
    }
    // atomic_add(ptr, val) -> old  (lock xadd [rdi], rsi; rax=old=rsi).
    if nl==10&&r8(nm)=='a'&&r8(nm+1)=='t'&&r8(nm+2)=='o'&&r8(nm+3)=='m'&&r8(nm+4)=='i'&&r8(nm+5)=='c'&&r8(nm+6)=='_'&&r8(nm+7)=='a'&&r8(nm+8)=='d'&&r8(nm+9)=='d' {
        flush_all()
        let a0 = irres(ira2(ii))
        let a1 = irres(ira2(ii)+1)
        rbp(7, spill_home(a0))        // rdi = ptr
        rbp(6, spill_home(a1))        // rsi = val
        eb(240); eb(72); eb(15); eb(193); eb(55)   // lock xadd [rdi], rsi (F0 48 0F C1 37)
        rr(0, 6)                      // rax = rsi (old value)
        return 1
    }
    // atomic_swap(ptr, val) -> old  (xchg [rdi], rsi; rax=old=rsi).
    if nl==11&&r8(nm)=='a'&&r8(nm+1)=='t'&&r8(nm+2)=='o'&&r8(nm+3)=='m'&&r8(nm+4)=='i'&&r8(nm+5)=='c'&&r8(nm+6)=='_'&&r8(nm+7)=='s'&&r8(nm+8)=='w'&&r8(nm+9)=='a'&&r8(nm+10)=='p' {
        flush_all()
        let a0 = irres(ira2(ii))
        let a1 = irres(ira2(ii)+1)
        rbp(7, spill_home(a0))        // rdi = ptr
        rbp(6, spill_home(a1))        // rsi = val
        eb(72); eb(135); eb(55)        // xchg [rdi], rsi (48 87 37)
        rr(0, 6)                      // rax = rsi (old value; rsi now holds the old mem value)
        return 1
    }
    // atomic_cmpxchg(ptr, oldv, newv) -> old mem value (lock cmpxchg [rdi], rdx).
    //   Expected (oldv) must be in rax for cmpxchg; ZF set if swapped; rax = old.
    if nl==14&&r8(nm)=='a'&&r8(nm+1)=='t'&&r8(nm+2)=='o'&&r8(nm+3)=='m'&&r8(nm+4)=='i'&&r8(nm+5)=='c'&&r8(nm+6)=='_'&&r8(nm+7)=='c'&&r8(nm+8)=='m'&&r8(nm+9)=='p'&&r8(nm+10)=='x'&&r8(nm+11)=='c'&&r8(nm+12)=='h'&&r8(nm+13)=='g' {
        flush_all()
        let a0 = irres(ira2(ii))
        let a1 = irres(ira2(ii)+1)
        let a2 = irres(ira2(ii)+2)
        rbp(7, spill_home(a0))        // rdi = ptr
        rbp(6, spill_home(a1))        // rsi = oldv
        rbp(2, spill_home(a2))        // rdx = newv
        rr(0, 6)                      // rax = oldv (cmpxchg compares [rdi] to rax)
        eb(240); eb(72); eb(15); eb(177); eb(23)   // lock cmpxchg [rdi], rdx (F0 48 0F B1 17)
        // rax = old memory value (returned)
        return 1
    }
    // argp8(reg, base, k): load arg k's spill-home pointer + 8 (skip the 8-byte
    // string length prefix) into reg. Quanta strings are [8:len][bytes]; syscall
    // path ABI needs base+8. Mirrors the reload-from-spill-home pattern used by
    // the generic syscall() helper.
    // unlink(path): sc 87  -- rdi = path+8 via argp8
    if nl==6&&r8(nm)=='u'&&r8(nm+1)=='n'&&r8(nm+2)=='l'&&r8(nm+3)=='i'&&r8(nm+4)=='n'&&r8(nm+5)=='k' {
        flush_all()
        argp8(7, ira2(ii), 0)
        ri(0,87); sysc(); return 1
    }
    // mkdir(path, mode): sc 83  -- rdi=path(+8 via argp8), rsi=mode via IR_CALL
    if nl==5&&r8(nm)=='m'&&r8(nm+1)=='k'&&r8(nm+2)=='d'&&r8(nm+3)=='i'&&r8(nm+4)=='r' {
        flush_all()
        let scb = ira2(ii)
        argp8(7, scb, 0)        // rdi = path + 8
        rbp(6, spill_home(irres(scb+1)))   // rsi = mode
        ri(0,83); sysc(); return 1
    }
    // chdir(path): sc 80  -- rdi = path+8 via argp8
    if nl==5&&r8(nm)=='c'&&r8(nm+1)=='h'&&r8(nm+2)=='d'&&r8(nm+3)=='i'&&r8(nm+4)=='r' {
        flush_all()
        argp8(7, ira2(ii), 0)
        ri(0,80); sysc(); return 1
    }
    // rename(old, new): sc 82  -- rdi=old+8, rsi=new+8 via argp8
    if nl==6&&r8(nm)=='r'&&r8(nm+1)=='e'&&r8(nm+2)=='n'&&r8(nm+3)=='a'&&r8(nm+4)=='m'&&r8(nm+5)=='e' {
        flush_all()
        let scb = ira2(ii)
        argp8(7, scb, 0)        // rdi = old + 8
        argp8(6, scb, 1)        // rsi = new + 8
        ri(0,82); sysc(); return 1
    }
    // stat(path, buf): newfstatat(AT_FDCWD, path, buf, 0) = sc 262
    //   rsi=path+8 (argp8), rdx=buf (raw), rdi=AT_FDCWD, r10=0
    if nl==4&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='a'&&r8(nm+3)=='t' {
        flush_all()
        let scb = ira2(ii)
        ri(7, -100)             // rdi = AT_FDCWD
        argp8(6, scb, 0)        // rsi = path + 8
        rbp(2, spill_home(irres(scb+1)))   // rdx = buf (raw pointer)
        ri(10, 0)               // r10 = 0 (flags)
        ri(0, 262); sysc(); return 1
    }
    // abort(): exit(134) = 128 + SIGABRT
    if nl==5&&r8(nm)=='a'&&r8(nm+1)=='b'&&r8(nm+2)=='o'&&r8(nm+3)=='r'&&r8(nm+4)=='t' {
        flush_all()
        ri(7,134); ri(0,60); sysc(); return 1
    }
    // debugbreak(): int3
    if nl==10&&r8(nm)=='d'&&r8(nm+1)=='e'&&r8(nm+2)=='b'&&r8(nm+3)=='u'&&r8(nm+4)=='g'&&r8(nm+5)=='b'&&r8(nm+6)=='r'&&r8(nm+7)=='e'&&r8(nm+8)=='a'&&r8(nm+9)=='k' {
        flush_all()
        eb(204); return 1
    }
    // 0.0.108: CPU intrinsics (hints / memory fences). All are void builtins;
    // emit the raw instruction bytes into CODE. They take no observable
    // argument except prefetch (an address); results are undefined-on-read but
    // the call site never requires a value.
    // pause(): spin-wait hint = F3 90
    if nl==5&&r8(nm)=='p'&&r8(nm+1)=='a'&&r8(nm+2)=='u'&&r8(nm+3)=='s'&&r8(nm+4)=='e' {
        flush_all(); eb(243); eb(144); return 1
    }
    // fence(): full memory fence mfence = 0F AE F0
    if nl==5&&r8(nm)=='f'&&r8(nm+1)=='e'&&r8(nm+2)=='n'&&r8(nm+3)=='c'&&r8(nm+4)=='e' {
        flush_all(); eb(15); eb(174); eb(240); return 1
    }
    // lfence(): 0F AE E8
    if nl==6&&r8(nm)=='l'&&r8(nm+1)=='f'&&r8(nm+2)=='e'&&r8(nm+3)=='n'&&r8(nm+4)=='c'&&r8(nm+5)=='e' {
        flush_all(); eb(15); eb(174); eb(232); return 1
    }
    // sfence(): 0F AE F8
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='f'&&r8(nm+2)=='e'&&r8(nm+3)=='n'&&r8(nm+4)=='c'&&r8(nm+5)=='e' {
        flush_all(); eb(15); eb(174); eb(248); return 1
    }
    // prefetch(addr): prefetchnta [rax] = 0F 18 08. addr = arg0, loaded from its
    // spill-home (register-allocation-independent; matches bitfield/stat).
    if nl==8&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='e'&&r8(nm+3)=='f'&&r8(nm+4)=='e'&&r8(nm+5)=='t'&&r8(nm+6)=='c'&&r8(nm+7)=='h' {
        flush_all()
        rbp(0, spill_home(irres(ira2(ii))))   // rax = addr (arg0)
        eb(15); eb(24); eb(8)                  // 0F 18 08  prefetchnta [rax]
        return 1
    }
    return 0
}

