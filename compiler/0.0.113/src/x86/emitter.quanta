    }
    if nl==7&&r8(nm)=='b'&&r8(nm+1)=='s'&&r8(nm+2)=='w'&&r8(nm+3)=='a'&&r8(nm+4)=='p'&&r8(nm+5)=='1'&&r8(nm+6)=='6' {
