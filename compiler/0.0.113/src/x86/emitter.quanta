    // a string (auto-detected via vreg_is_str), mirroring print()/echo() behavior.
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='l'&&r8(nm+6)=='n' {
        flush_all()
