    if nl==8&&r8(nm)=='b'&&r8(nm+1)=='i'&&r8(nm+2)=='t'&&r8(nm+3)=='f'&&r8(nm+4)=='i'&&r8(nm+5)=='e'&&r8(nm+6)=='l'&&r8(nm+7)=='d' {
