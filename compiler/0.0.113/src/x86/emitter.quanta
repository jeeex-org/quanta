        eb(73); eb(255); eb(192)         // inc r8
        lbladd(l_write, codelen)
        eb(73); eb(141); eb(114); eb(1)  // lea rsi, [r10+1]  (buffer start = rsp+24-len)
        rr(2,8)                          // rdx = r8 (length)
        ri(7,1)                          // rdi = 1 (stdout)
        ri(0,1)                          // rax = 1 (sys_write)
