import std/sha3_constants

extern fn malloc(size: u64) -> u64;

fn keccak_rhopi(st) {
  // Standard Keccak Rho + Pi (inverse pi for reading)
  // Pi: (x,y) -> (y, (2x+3y)%5) with linear index i = x + 5*y
  // Pi inverse mapping for 25 lanes:
  // Hardcoded Pi^{-1} array: Pi^{-1}[i] = source lane for destination i
  // Computed from Pi(x,y) = (y, (2x+3y)%5)
  let src_idx_arr = malloc(200)
  mem_store(src_idx_arr + 0*8, 0);   mem_store(src_idx_arr + 1*8, 6);   mem_store(src_idx_arr + 2*8, 12);  mem_store(src_idx_arr + 3*8, 18);  mem_store(src_idx_arr + 4*8, 24)
  mem_store(src_idx_arr + 5*8, 3);   mem_store(src_idx_arr + 6*8, 9);   mem_store(src_idx_arr + 7*8, 10);  mem_store(src_idx_arr + 8*8, 16);  mem_store(src_idx_arr + 9*8, 22)
  mem_store(src_idx_arr + 10*8, 1);  mem_store(src_idx_arr + 11*8, 7);  mem_store(src_idx_arr + 12*8, 13); mem_store(src_idx_arr + 13*8, 19); mem_store(src_idx_arr + 14*8, 20)
  mem_store(src_idx_arr + 15*8, 4);  mem_store(src_idx_arr + 16*8, 5);  mem_store(src_idx_arr + 17*8, 11); mem_store(src_idx_arr + 18*8, 17); mem_store(src_idx_arr + 19*8, 23)
  mem_store(src_idx_arr + 20*8, 2);  mem_store(src_idx_arr + 21*8, 8);  mem_store(src_idx_arr + 22*8, 14); mem_store(src_idx_arr + 23*8, 15); mem_store(src_idx_arr + 24*8, 21)

  // Rho offsets for each lane (standard Keccak r[x][y] for index x+5y)
  let rots_arr = malloc(200)
  mem_store(rots_arr + 0*8, 0);  mem_store(rots_arr + 1*8, 1);  mem_store(rots_arr + 2*8, 62); mem_store(rots_arr + 3*8, 28); mem_store(rots_arr + 4*8, 27)
  mem_store(rots_arr + 5*8, 36); mem_store(rots_arr + 6*8, 44); mem_store(rots_arr + 7*8, 6);  mem_store(rots_arr + 8*8, 55); mem_store(rots_arr + 9*8, 20)
  mem_store(rots_arr + 10*8, 3); mem_store(rots_arr + 11*8, 10); mem_store(rots_arr + 12*8, 43); mem_store(rots_arr + 13*8, 25); mem_store(rots_arr + 14*8, 39)
  mem_store(rots_arr + 15*8, 41); mem_store(rots_arr + 16*8, 45); mem_store(rots_arr + 17*8, 15); mem_store(rots_arr + 18*8, 21); mem_store(rots_arr + 19*8, 8)
  mem_store(rots_arr + 20*8, 18); mem_store(rots_arr + 21*8, 2);  mem_store(rots_arr + 22*8, 61); mem_store(rots_arr + 23*8, 56); mem_store(rots_arr + 24*8, 14)

  // Copy state to temp (B) for Pi
  let B = malloc(200)
  let i = 0
  while (i < 25) {
    mem_store(B + i * 8, mem_load(st + i * 8))
    i = i + 1
  }

  // Apply Rho + Pi inverse: st[i] = rot(B[Pi^{-1}(i)], r[Pi^{-1}(i)])
  i = 0
  while (i < 25) {
    let src = mem_load(src_idx_arr + i * 8)
    let lane = mem_load(B + src * 8)
    let rot = mem_load(rots_arr + src * 8)
    let rotated = (lane << rot) | (lane >> (64 - rot))
    mem_store(st + i * 8, rotated)
    i = i + 1
  }
}

extern fn malloc(size: u64) -> u64