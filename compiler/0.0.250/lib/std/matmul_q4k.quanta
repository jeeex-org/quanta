// Fused Q4_K_M matvec: y = W * x, dequantizing each super-block on the fly.
//
// WHY THIS FILE EXISTS
//
// The compiler has two builtins whose names promise exactly this:
//   q4k_matvec(W_q4, x_q8, rows, cols, y) -- emitter.quanta ~line 1546 is
//     literally `// Placeholder: just return y`. Verified: it returns its 5th
//     argument and writes NOTHING. It compiles, runs, and leaves the output
//     buffer untouched.
//   q4k_dot(W, x, n_blocks) -- ~line 1470. Its own comments say "For now,
//     assume scale = 1.0", "Simplified: just process first 2 nibbles",
//     "Actually, let's just process one block and return". Returns a partial
//     sum from a single nibble pair.
//
// Both are worse than absent: a missing builtin fails to compile, these
// silently produce wrong numbers. This file is the real implementation, in
// Quanta, where it can be tested.
//
// LAYOUT (authoritative -- from lib/std/gguf.quanta dequant_q4k, which was
// checked value-for-value against the real QUANTA-LFM2.5 Q4_K_M tensor):
//   Q4_K super-block = 144 bytes -> 256 weights
//     +0  f16 d        scale for sub-block scales
//     +2  f16 dmin     scale for sub-block mins
//     +4  u8 scales[12]  eight (scale,min) 6-bit pairs, bit-packed
//     +16 u8 qs[128]     4-bit quants, low nibble = even, high = odd
//
// NOTE: lib/std/matmul_fused.quanta also claims to do this and is WRONG -- it
// guesses "2 + 16 + 128 = 146 bytes" in its own comments. The real block is
// 144. Do not copy from it.
//
// ACCUMULATION
//
// The activation side is accumulated in f64 (the language's only float).
// For a Q4_K_M matvec at hidden 2560 the inner loop is 256 fma-equivalents
// per row; doing that in f32 would round 2560 additions into the result and
// visibly drift on the residual stream. The quant side is already exact
// integer nibble math, so f64 costs nothing in accuracy and only registers.
//
// This is the O(rows*cols) core of every layer, so it is also the thing
// that decides whether Quanta replaces llama-server or merely runs. It
// dequantizes each block exactly once per matvec and never materializes an
// f32 copy of the weights, so peak extra memory is one 256-element scratch
// buffer rather than rows*cols*8 bytes.

fn q4k_sc(j, sc) {
    if j < 4 { return mem_load8(sc + j) - (mem_load8(sc + j) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo - (lo / 16) * 16) + ((mem_load8(sc + j - 4) / 64) * 16)
}

fn q4k_min(j, sc) {
    if j < 4 { return mem_load8(sc + j + 4) - (mem_load8(sc + j + 4) / 64) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo / 16 - (lo / 16 / 16) * 16) + ((mem_load8(sc + j) / 64) * 16)
}

// One super-block's contribution: dequantize 256 weights and accumulate
// sum(w_i * x_i). Writes nothing but the accumulator.
fn q4k_block_dot(raw, x, n_blocks, bi): f64 {
    let bo = bi * 144
    let d    = f16_to_f64(raw + bo)
    let dmin = f16_to_f64(raw + bo + 2)
    let sc   = raw + bo + 4
    let q    = raw + bo + 16
    let xo   = bi * 256 * 8
    let acc  = 0.0

    let chunk = 0
    let is = 0
    while chunk < 4 {
        let s0 = q4k_sc(is, sc)
        let m0 = q4k_min(is, sc)
        let s1 = q4k_sc(is + 1, sc)
        let m1 = q4k_min(is + 1, sc)
        let d1  = fmul(d, i2f(s0))
        let mm1 = fmul(dmin, i2f(m0))
        let d2  = fmul(d, i2f(s1))
        let mm2 = fmul(dmin, i2f(m1))

        // low nibbles -> elements chunk*64 .. +31
        let l = 0
        while l < 32 {
            let b = mem_load8(q + l)
            let w = fsub(fmul(d1, i2f(b - (b / 16) * 16)), mm1)
            acc = fadd(acc, fmul(w, f64_load(x + xo + (chunk * 64 + l) * 8)))
            l = l + 1
        }
        // high nibbles -> elements chunk*64+32 .. +63
        let h = 0
        while h < 32 {
            let b = mem_load8(q + h)
            let w = fsub(fmul(d2, i2f(b / 16)), mm2)
            acc = fadd(acc, fmul(w, f64_load(x + xo + (chunk * 64 + 32 + h) * 8)))
            h = h + 1
        }
        q = q + 32
        is = is + 2
        chunk = chunk + 1
    }
    return acc
}

// y = W * x for a Q4_K_M matrix.
//   raw  : pointer to the quantized weights
//   x    : f64 activations, cols elements
//   rows : output rows
//   cols : input cols (must be a multiple of 256)
//   y    : f64 output, rows elements
fn q4k_matvec_real(raw, x, rows, cols, y) -> i64 {
    let nb = cols / 256
    let r = 0
    while r < rows {
        let wrow = raw + r * nb * 144
        let acc = 0.0
        let b = 0
        while b < nb {
            acc = fadd(acc, q4k_block_dot(wrow, x, nb, b))
            b = b + 1
        }
        mem_store(y + r * 8, acc)
        r = r + 1
    }
    return 0
}

// Same result, but dequantizing to a buffer first. Kept because it is the
// reference the fused path is tested against: if the two disagree, the fused
// path is wrong. Never use this on the hot path -- it allocates the full
// rows*cols f32 weight matrix, which is the thing fusion exists to avoid.
fn q4k_matvec_ref(raw, x, rows, cols, y) -> i64 {
    let w = mem_alloc(rows * cols * 8)
    dequant_q4k(raw, rows * cols, w)
    let r = 0
    while r < rows {
        let acc = 0.0
        let c = 0
        let base = r * cols * 8
        while c < cols {
            acc = fadd(acc, fmul(f64_load(w + base + c * 8), f64_load(x + c * 8)))
            c = c + 1
        }
        mem_store(y + r * 8, acc)
        r = r + 1
    }
    return 0
}