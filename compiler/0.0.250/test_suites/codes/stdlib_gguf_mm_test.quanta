// stdlib_lfm2_mm_test -- the bounded row-wise matvec must agree EXACTLY with the
// existing full-dequantize-then-matvec path, on both F32 and a real Q4_K tensor.
//
// Why this test exists: the model cannot be fully dequantized. ffn_gate alone is
// 22020096 elements = 176 MB as f64, and every layer plus the 262144000-element
// tied embedding comes to 20.1 GB against a 6 GB budget. So
// lib/std/gguf_mm.quanta walks one row at a time. That optimisation is only
// correct if it reproduces the reference path bit-for-bit, which is what is
// asserted here -- a tolerance test alone would pass if both paths were equally
// wrong, so the expected values come from gguf_matvec() over a fully
// dequantized tensor, a genuinely different code path.
//
// Two traps this pins, both of which produced plausible wrong answers first:
//
//   - mm_row_bytes: Q4_K is 144 bytes per 256 elements, not 18. The wrong size
//     reads a fraction of each row. Checked by the negative case below.
//
//   - gguf_read_tensor_bytes_at returns a BYTE COUNT, not a status. Accepting a
//     short read dequantizes a partly-stale buffer into a finite, plausible,
//     wrong answer rather than failing.

import std/fs
import std/gguf
import std/gguf_mm

let MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

fn check_tensor(t, label, tol) {
    let rows = gguf_tensor_dim(t, 0)
    let cols = gguf_tensor_dim(t, 1)
    print("--- ")
    print(label)
    print(" dtype=")
    print(gguf_tensor_dtype(t))
    print(" rows=")
    print(rows)
    print(" cols=")
    print(cols)

    let x = mem_alloc(cols * 8)
    let i = 0
    while i < cols {
        // i2f returns a float bit-pattern; a plain integer here would store an
        // integer value and the product would be meaningless.
        let v: f64 = i2f(i % 11) * 0.125
        mem_store(x + i * 8, v)
        i = i + 1
    }

    // reference: full dequantize into memory, then the existing matvec
    let W = mem_alloc(rows * cols * 8)
    if read_tensor_f64(t, W) == 0 { print("FAIL full dequant"); return 1 }
    let yA = mem_alloc(rows * 8)
    gguf_matvec(W, x, rows, cols, yA)

    // under test: one row at a time
    mm_init(cols)
    let yB = mem_alloc(rows * 8)
    let rc = mm_matvec(t, x, rows, cols, yB)
    if rc != 0 { print("FAIL mm_matvec rc="); print(rc); return 1 }

    let r = 0
    let bad = 0
    while r < rows {
        let a: f64 = f64of(mem_load(yA + r * 8))
        let b: f64 = f64of(mem_load(yB + r * 8))
        let d = a - b
        if d < 0 { d = 0 - d }
        if d > tol { bad = bad + 1 }
        r = r + 1
    }
    print(" mismatches=")
    print(bad)
    if bad != 0 { print("FAIL agree"); return 1 }
    return 0
}

fn main() {
    if gguf_load(MODEL) != 0 { print("FAIL gguf_load"); return 1 }

    // F32 tensor: blk.0.shortconv.conv.weight, 3 x 2048. Row = 8 KB.
    let f32t = gguf_find_tensor("blk.0.shortconv.conv.weight")
    if f32t < 0 { print("FAIL no conv tensor"); return 1 }
    if check_tensor(f32t, "f32 conv 3x2048", 1e-9) != 0 { return 1 }

    // Q4_K tensor: blk.0.shortconv.out_proj.weight, 2048 x 2048, 2.3 MB on
    // disk and 32 MB if materialized -- the case that matters.
    let qt = gguf_find_tensor("blk.0.shortconv.out_proj.weight")
    if qt < 0 { print("FAIL no out_proj tensor"); return 1 }
    if gguf_tensor_dtype(qt) != 12 { print("FAIL expected Q4_K, got dtype"); print(gguf_tensor_dtype(qt)); return 1 }
    if check_tensor(qt, "q4k out_proj 2048x2048", 1e-6) != 0 { return 1 }

    // The whole point: a row-wise pass must need a small fixed buffer, not a
    // copy of the tensor. If mm_rowraw scaled with the tensor this is not
    // holding, and the 20 GB problem is back.
    print("rowcap=")
    print(mm_rowcap)
    print("rawcap=")
    print(mm_rowraw_cap)
    let cols = gguf_tensor_dim(qt, 1)
    if mm_rowraw_cap >= cols * 8 { print("FAIL raw buffer is not row-bounded"); return 1 }

    // ---- mm_lookup_row must actually WRITE its destination --------------
    //
    // This had no coverage at all, and the omission cost a full debug round:
    // mm_lookup_row returned mm_load_row()'s status directly, so the caller's
    // buffer was never filled. The embedding came back as zeros, the entire
    // 30-layer stack then ran on a zero activation, and the logits were all
    // 0.000000 -- which reads as "the model produced nothing" rather than as a
    // missing copy. Asserting the bytes are non-zero AND equal to the row
    // dequantized independently is what would have caught it.
    let emb = gguf_find_tensor("token_embd.weight")
    if emb < 0 { print("FAIL no token_embd"); return 1 }
    // GGUF/ggml stores this as [n_embd, n_vocab], so ne[0] is the embedding
    // width and one token's row is n_embd contiguous values. Taking dim 1
    // yields n_vocab (128000) and every row assertion is then nonsense.
    let dm = gguf_tensor_dim(emb, 0)
    if dm != 2048 { print("FAIL unexpected n_embd="); print(dm); return 1 }
    if mm_rowcap < dm { print("FAIL rowcap < d_model"); return 1 }
    let dst = mem_alloc(dm * 8)
    // prefill with a sentinel so "never written" is distinguishable from "zero"
    let i = 0
    while i < dm { mem_store(dst + i * 8, 12345.0); i = i + 1 }
    if mm_lookup_row(emb, 0, dm, dst) != 0 { print("FAIL mm_lookup_row rc"); return 1 }
    let nz = 0
    let sentinel = 0
    i = 0
    while i < dm {
        let v: f64 = f64of(mem_load(dst + i * 8))
        if v != 0.0 { nz = nz + 1 }
        if v == 12345.0 { sentinel = sentinel + 1 }
        i = i + 1
    }
    if sentinel != 0 { print("FAIL: mm_lookup_row left the destination untouched"); return 1 }
    if nz == 0 { print("FAIL: embedding row is all zeros"); return 1 }

    // Row 1 must differ from row 0 -- this proves the row index is actually
    // used, and it is checkable without materializing the tensor. Comparing
    // against read_tensor_f64() is NOT an option here: token_embd is
    // 128000 x 2048 = 262144000 elements, 2 GB as f64, which is precisely the
    // tensor the row-wise path exists to avoid loading. Attempting it dies on
    // the memory cap.
    let dst2 = mem_alloc(dm * 8)
    let j = 0
    while j < dm { mem_store(dst2 + j * 8, 0.0); j = j + 1 }
    if mm_lookup_row(emb, 1, dm, dst2) != 0 { print("FAIL mm_lookup_row row 1"); return 1 }
    let diff = 0
    let nz2 = 0
    j = 0
    while j < dm {
        let a: f64 = f64of(mem_load(dst + j * 8))
        let b: f64 = f64of(mem_load(dst2 + j * 8))
        if a != b { diff = diff + 1 }
        if b != 0.0 { nz2 = nz2 + 1 }
        j = j + 1
    }
    if nz2 == 0 { print("FAIL: row 1 is all zeros"); return 1 }
    if diff == 0 { print("FAIL: row 0 and row 1 are identical"); return 1 }

    // And the same row read twice must be bit-identical (determinism).
    let dst3 = mem_alloc(dm * 8)
    if mm_lookup_row(emb, 0, dm, dst3) != 0 { print("FAIL mm_lookup_row reread"); return 1 }
    let drift = 0
    j = 0
    while j < dm {
        if f64of(mem_load(dst + j * 8)) != f64of(mem_load(dst3 + j * 8)) { drift = drift + 1 }
        j = j + 1
    }
    if drift != 0 { print("FAIL: row 0 not deterministic, drift="); print(drift); return 1 }

    print("OK mm")
    return 0
}