// naked_neg_test -- Phase B negative fixture (0.0.229).
//
// A naked fn with a PARAMETER must be a compile error: parameters are homed in
// the stack frame, and a naked fn has no frame. The plan's fail-closed rule:
// a compile error is correct, silent corruption is not.
//
// The gate compiles this file and REQUIRES a non-zero rc (see run_tests.sh,
// NAKED-NEG check). If this file ever compiles, the guard regressed.

naked fn broken(a: i64) -> i64 {
    asm!("b8 2a 00 00 00 c3")  // would ignore `a` entirely
}

fn main() -> i64 {
    return broken(1)
}
