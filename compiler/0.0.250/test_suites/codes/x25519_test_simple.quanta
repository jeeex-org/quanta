// x25519_test_simple.quanta — minimal test

import std/x25519

fn main() {
  let scalar = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(scalar + i, 0); i = i + 1 }
  mem_store8(scalar, 1)
  
  let u = mem_alloc(32)
  i = 0
  while i < 32 { mem_store8(u + i, 0); i = i + 1 }
  mem_store8(u, 9)
  
  let out = mem_alloc(32)
  x25519(scalar, u, out)
  
  println(0)
  exit(0)
}