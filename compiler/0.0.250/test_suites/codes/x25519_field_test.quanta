// x25519_field_test.quanta — test field operations in isolation

import std/x25519

fn hexval(c) {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 87 }
  if c >= 65 && c <= 70 { return c - 55 }
  return 0
}

fn hex_to_bytes(dst, hexstr, n) {
  let i = 0
  while i < n {
    let hi = hexval(mem_load8(hexstr + 8 + i * 2))
    let lo = hexval(mem_load8(hexstr + 8 + i * 2 + 1))
    mem_store8(dst + i, hi * 16 + lo)
    i = i + 1
  }
}

fn mem_eq(a, b, n) {
  let i = 0
  while i < n {
    if mem_load8(a + i) != mem_load8(b + i) { return 0 }
    i = i + 1
  }
  return 1
}

fn print_hex(label, ptr, n) {
  let s = ""
  let i = 0
  while i < n {
    let b = mem_load8(ptr + i)
    let hi = b >> 4; let lo = b & 0xf
    if hi < 10 { s = str(s, hi + 48) } else { s = str(s, hi + 87) }
    if lo < 10 { s = str(s, lo + 48) } else { s = str(s, lo + 87) }
    i = i + 1
  }
  println(s)
}

fn main() {
  println("Testing field operations...")
  
  // Test fe_from_bytes / fe_to_bytes roundtrip with u=9
  let u9 = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u9 + i, 0); i = i + 1 }
  mem_store8(u9, 9)
  
  let fe = mem_alloc(5*8)
  fe_from_bytes(u9, fe)
  
  let out = mem_alloc(32)
  fe_to_bytes(fe, out)
  
  println("u=9 roundtrip:")
  print_hex("in", u9, 32)
  print_hex("out", out, 32)
  
  if mem_eq(u9, out, 32) == 0 {
    println("FAIL: u=9 roundtrip")
    exit(1)
  }
  println("u=9 roundtrip PASS")
  
  // Test fe_add / fe_sub
  let a = mem_alloc(5*8)
  let b = mem_alloc(5*8)
  let c = mem_alloc(5*8)
  
  fe_one(a)
  fe_one(b)
  fe_add(a, b, c)
  // c should be 2
  let two = mem_alloc(5*8)
  fe_zero(two)
  mem_store(two, 2)
  
  let i2 = 0
  let ok = 1
  while i2 < 5 {
    if mem_load(c + i2*8) != mem_load(two + i2*8) { ok = 0 }
    i2 = i2 + 1
  }
  if ok == 0 { println("FAIL: fe_add 1+1=2"); exit(2) }
  println("fe_add PASS")
  
  fe_sub(c, a, b)  // c - a = 2 - 1 = 1
  fe_one(a)
  if mem_eq(b, a, 40) == 0 { println("FAIL: fe_sub"); exit(3) }
  println("fe_sub PASS")
  
  // Test fe_mul
  fe_one(a)
  mem_store(a, 3)  // a = 3
  fe_one(b)
  mem_store(b, 5)  // b = 5
  fe_mul(a, b, c)
  let fifteen = mem_alloc(5*8)
  fe_zero(fifteen)
  mem_store(fifteen, 15)
  if mem_eq(c, fifteen, 40) == 0 { println("FAIL: fe_mul 3*5=15"); exit(4) }
  println("fe_mul PASS")
  
  // Test fe_sq
  fe_zero(a)
  mem_store(a, 4)  // a = 4
  fe_sq(a, c)
  let sixteen = mem_alloc(5*8)
  fe_zero(sixteen)
  mem_store(sixteen, 16)
  if mem_eq(c, sixteen, 40) == 0 { println("FAIL: fe_sq 4^2=16"); exit(5) }
  println("fe_sq PASS")
  
  // Test fe_neg
  fe_zero(a)
  mem_store(a, 7)  // a = 7
  fe_neg(a, b)
  // p - 7
  let p_minus_7 = mem_alloc(5*8)
  let P0 = 0x7ffffffffffffed
  let P1 = 0x7ffffffffffffff
  let P2 = 0x7ffffffffffffff
  let P3 = 0x7ffffffffffffff
  let P4 = 0x7ffffffffffff
  mem_store(p_minus_7, P0 - 7)
  mem_store(p_minus_7 + 8, P1)
  mem_store(p_minus_7 + 16, P2)
  mem_store(p_minus_7 + 24, P3)
  mem_store(p_minus_7 + 32, P4)
  fe_reduce(p_minus_7)
  if mem_eq(b, p_minus_7, 40) == 0 { println("FAIL: fe_neg"); exit(6) }
  println("fe_neg PASS")
  
  // Test fe_inv: 2 * inv(2) = 1
  fe_zero(a)
  mem_store(a, 2)
  let inv2 = mem_alloc(5*8)
  fe_inv(a, inv2)
  fe_mul(a, inv2, c)
  fe_one(b)
  if mem_eq(c, b, 40) == 0 { 
    println("FAIL: fe_inv")
    print_hex("inv2", inv2, 40)
    print_hex("2*inv2", c, 40)
    print_hex("1", b, 40)
    exit(7) 
  }
  println("fe_inv PASS")
  
  println("All field ops PASS")
  println(0)
  exit(0)
}