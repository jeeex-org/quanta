// stdlib_model_arch_test -- canonical role vocabulary + arch registry.
//
// Phase 4 of docs/plans/model-loader-features.md. The point of this file is
// that ONE resolver serves every architecture: arch_resolve_name(arch, role,
// layer) returns the concrete tensor name for that arch. Before it, every
// model was a new special case with its own hardcoded name table.
//
// The names checked here are not invented -- they are what llama.cpp's per-arch
// tn() bindings produce (src/models/lfm2.cpp) and what the HF checkpoints on
// this box actually contain.

import std/model_arch
import std/str

fn main() {
    arch_init()

    // ---- role -> tensor kind ----
    // Weights are matrices; norms and biases are vectors. Getting this wrong
    // sends a matrix through the elementwise path (or vice versa).
    if role_kind(ROLE_ATTN_Q)      != 1 { print("FAIL: attn_q not MATRIX"); return 1 }
    if role_kind(ROLE_FFN_DOWN)    != 1 { print("FAIL: ffn_down not MATRIX"); return 1 }
    if role_kind(ROLE_SHORTCONV_CONV) != 1 { print("FAIL: shortconv.conv not MATRIX"); return 1 }
    if role_kind(ROLE_ATTN_NORM)   != 3 { print("FAIL: attn_norm not VECTOR"); return 1 }
    if role_kind(ROLE_ATTN_Q_NORM) != 3 { print("FAIL: attn_q_norm not VECTOR"); return 1 }
    if role_kind(ROLE_FFN_EXP_PROBS_B) != 3 { print("FAIL: exp_probs_b not VECTOR"); return 1 }

    // ---- LFM2 resolution, the arch this project actually runs ----
    let buf = mem_alloc(256)
    if arch_resolve_name(ARCH_LFM2, ROLE_EMBD, 0, buf, 256) < 0 { print("FAIL: lfm2 embd"); return 1 }
    if !equals(buf, "token_embd.weight") { print("FAIL: lfm2 embd name"); return 1 }
    if arch_resolve_name(ARCH_LFM2, ROLE_OUTPUT_NORM, 0, buf, 256) < 0 { print("FAIL: lfm2 out_norm"); return 1 }
    if !equals(buf, "output_norm.weight") { print("FAIL: lfm2 out_norm name"); return 1 }
    // per-layer: the layer index must actually appear
    if arch_resolve_name(ARCH_LFM2, ROLE_ATTN_Q, 5, buf, 256) < 0 { print("FAIL: lfm2 attn_q"); return 1 }
    if !equals(buf, "blk.5.attn_q.weight") { print("FAIL: lfm2 attn_q name"); return 1 }
    if arch_resolve_name(ARCH_LFM2, ROLE_SHORTCONV_CONV, 12, buf, 256) < 0 { print("FAIL: lfm2 sc.conv"); return 1 }
    if !equals(buf, "blk.12.shortconv.conv.weight") { print("FAIL: lfm2 sc.conv name"); return 1 }
    if arch_resolve_name(ARCH_LFM2, ROLE_SHORTCONV_INPROJ, 0, buf, 256) < 0 { print("FAIL: lfm2 sc.in_proj"); return 1 }
    if !equals(buf, "blk.0.shortconv.in_proj.weight") { print("FAIL: lfm2 sc.in_proj name"); return 1 }
    if arch_resolve_name(ARCH_LFM2, ROLE_FFN_GATE_EXPS, 3, buf, 256) < 0 { print("FAIL: lfm2 ffn_gate_exps"); return 1 }
    if !equals(buf, "blk.3.ffn_gate_exps.weight") { print("FAIL: lfm2 ffn_gate_exps name"); return 1 }

    // ---- a two-digit layer index must not truncate ----
    if arch_resolve_name(ARCH_LFM2, ROLE_ATTN_OUT, 27, buf, 256) < 0 { print("FAIL: lfm2 layer 27"); return 1 }
    if !equals(buf, "blk.27.attn_out.weight") { print("FAIL: lfm2 layer 27 name"); return 1 }

    // ---- Qwen2 uses a completely different naming scheme, same roles ----
    if arch_resolve_name(ARCH_QWEN2, ROLE_EMBD, 0, buf, 256) < 0 { print("FAIL: qwen2 embd"); return 1 }
    if !equals(buf, "model.embed_tokens.weight") { print("FAIL: qwen2 embd name"); return 1 }
    if arch_resolve_name(ARCH_QWEN2, ROLE_ATTN_Q, 7, buf, 256) < 0 { print("FAIL: qwen2 attn_q"); return 1 }
    if !equals(buf, "model.layers.7.self_attn.q_proj.weight") { print("FAIL: qwen2 attn_q name"); return 1 }
    if arch_resolve_name(ARCH_QWEN2, ROLE_FFN_GATE, 0, buf, 256) < 0 { print("FAIL: qwen2 ffn_gate"); return 1 }
    if !equals(buf, "model.layers.0.mlp.gate_proj.weight") { print("FAIL: qwen2 ffn_gate name"); return 1 }

    // ---- Gemma3 shares Qwen2's layer layout but not its embedding norm ----
    if arch_resolve_name(ARCH_GEMMA3, ROLE_ATTN_V, 2, buf, 256) < 0 { print("FAIL: gemma3 attn_v"); return 1 }
    if !equals(buf, "model.layers.2.self_attn.v_proj.weight") { print("FAIL: gemma3 attn_v name"); return 1 }

    // ---- an unknown role must FAIL, not silently return a wrong name ----
    if arch_resolve_name(ARCH_LFM2, 9999, 0, buf, 256) >= 0 { print("FAIL: unknown role resolved"); return 1 }
    // ---- an unknown arch must FAIL ----
    if arch_resolve_name(9999, ROLE_ATTN_Q, 0, buf, 256) >= 0 { print("FAIL: unknown arch resolved"); return 1 }
    // ---- a too-small buffer must FAIL, not overflow ----
    let tiny = mem_alloc(16)
    if arch_resolve_name(ARCH_QWEN2, ROLE_FFN_GATE, 0, tiny, 8) >= 0 { print("FAIL: tiny buffer accepted"); return 1 }

    // ---- str_fmt round-trip: the formatter itself ----
    let b2 = mem_alloc(128)
    if str_fmt(b2, 128, "blk.%d.x", 0) < 0 { print("FAIL: fmt 0"); return 1 }
    if !equals(b2, "blk.0.x") { print("FAIL: fmt 0 name"); return 1 }
    if str_fmt(b2, 128, "blk.%d.x", 12345) < 0 { print("FAIL: fmt 12345"); return 1 }
    if !equals(b2, "blk.12345.x") { print("FAIL: fmt 12345 name"); return 1 }
    if str_fmt(b2, 128, "a%db", 0 - 7) < 0 { print("FAIL: fmt negative"); return 1 }
    if !equals(b2, "a-7b") { print("FAIL: fmt negative name"); return 1 }

    print("OK model_arch")
    return 0
}
