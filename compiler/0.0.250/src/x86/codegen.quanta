// === COMPILE IR ? X86-64 ===
// Per function - emits code, records labels and patches
let func_code_starts = mmap(2000000)  // start offset of each func's code

// === OPTIMIZER (Tier-1, behind -O) ===

// Hard constraint: if opt_on==0, opt_func returns immediately and touches ZERO IR.
// As of 1.0.12 `opt_on` defaults to 1 (optimizer ON for every build); it is no
// longer opt-in. opt_func is called AFTER parse fills [0,irc) for the current
// function and BEFORE ci_func emits it. All rewrites are in-place (no IR record
// deletion ? label fixups in ci_func rely on indices and irc staying stable).
let opt_on = 1
// G2: overflow-trap gate. ON by default (secure by default): emits `jno +2; ud2`
// after signed add/sub/mul/neg -> SIGILL on overflow, eliminating the
// wraparound UB class from safe code. `unsafe {}` blocks suppress the trap for
// the ops they contain (so low-level primitives / compiler internals opt out).
// The flag `--no-overflow-trap` turns it OFF if a program deliberately relies on
// two's-complement wraparound and hasn't been ported.
let ovf_trap = 1
let cur_fnname = 0
let cur_fnnlen = 0
// P10: index of the function currently being compiled (for fn-param lookup).
let cur_fi = 0

// opt_func iterates over IR records with the GLOBAL loop counter `i` so the
// const-resolution helpers (op_is_const / op_const_val) can read it.
let opt_i = 0

// Const lookup scans BACKWARD from the current record, because a definition
// precedes its use. The scan must STOP at the start of the current function.
//
// It used to run to record 0 unconditionally, crossing function boundaries.
// That is invisible for most ops -- vreg numbers rarely collide across
// functions -- but it is a live hazard now that float literals are IR_FCONST:
// `opt_i` is the NEG record for a negative literal, and its operand vreg can
// match an IR_FCONST belonging to an EARLIER function, so op_const_val returns
// that function's constant. In test_f32_conv the `-maxf32` expectation then
// folded to -(the +maxf32 constant) instead of the literal written in the
// source, and the test failed with a plausible-looking but wrong number.
//
// The bound is opt_beg, which is the current function's first IR record.
fn op_is_const(vr) {
    let k = opt_i-1
    while k>=opt_beg {
        if irres(k)==vr && (irop(k)==IR_CONST || irop(k)==IR_FCONST) { return 1 }
        k=k-1
    }
    return 0
}
fn op_const_val(vr) {
    let k = opt_i-1
    while k>=opt_beg {
        if irres(k)==vr && (irop(k)==IR_CONST || irop(k)==IR_FCONST) { return ira0(k) }
        k=k-1
    }
    return 0
}
// 0.0.238: like op_is_const/op_const_val but restricted to IR_CONST, never
// IR_FCONST. The constant-divisor strength reduction needs an INTEGER divisor;
// IR_FCONST's payload is an IEEE-754 bit pattern, and feeding that to the magic
// multiplier would divide by a huge random-looking number. (The float-operand
// guard in IR_DIV/IR_MOD already routes every float case to SSE, so this is
// defence in depth, not the primary gate.)
fn op_is_iconst(vr) {
    let k = opt_i-1
    while k>=opt_beg {
        if irres(k)==vr && irop(k)==IR_CONST { return 1 }
        k=k-1
    }
    return 0
}
fn op_iconst_val(vr) {
    let k = opt_i-1
    while k>=opt_beg {
        if irres(k)==vr && irop(k)==IR_CONST { return ira0(k) }
        k=k-1
    }
    return 0
}

// === 0.0.238: constant division / modulo by strength reduction ===
//
// The language's integer division is FLOOR (verified on 0.0.237: -7/2 = -4,
// -7%2 = +1, 7/-2 = -4, 7%-2 = -1 — the remainder takes the DIVISOR's sign).
// That is what makes the reduction both simple and safe:
//
//   * d == 2^k, d > 0 :  a/d  = sar a, k      (arithmetic shift == floor for
//                                              signed a — no sign correction)
//                        a%d = a & (2^k - 1)  (two's complement low bits; for
//                                              a<0 this is exactly floor mod)
//   * d == 1          :  a/1 = a ;  a%1 = 0
//   * otherwise (d>=3, not a power of two, d <= 2^31-1): magic multiply.
//
// emit_cdiv_core emits the shared core of the magic case: it leaves the
// TRUNCATION quotient in RDX(2) and the TRUNCATION remainder in RCX(1). The
// callers turn that into floor (see IR_DIV / IR_MOD).
//
// Derivation of the magic recovery (Hacker's Delight signed magic, then the
// floor fix). With (M, sh) = compute_magic(d):
//     q0  = mulhi_s(a, M)            ; high 64 bits of the signed 128-bit product
//     if M < 0: q0 += a              ; the "add" arm of the magic recovery
//     q0 >>= sh                      ; arithmetic shift
//     q_t = q0 + (1 if a < 0)        ; == trunc(a/d)
//     r_t = a - q_t*d                ; == the truncation remainder (sign of a)
//     floor(a/d) = q_t + (r_t >> 63) ; r_t >> 63 is -1 iff r_t < 0, i.e. iff
//                                    ; a < 0 and d does not divide a
//     floor(a%d) = r_t + (d & (r_t >> 63))
//
// Verified in Python over 4,913,317 (d, a) pairs — every d in 3..400 plus a
// spread of large/near-boundary divisors, and for each d every a in
// -4000..4000 plus 2^63-1, -2^63, +-2^62, and 4000 random full-range int64 —
// with ZERO mismatches against Python's floor `//` and `%`. Note that both
// steps are needed: the "+1 when a<0" alone yields truncation (it matches
// floor only when d | a), and the magic's M can legitimately be negative for a
// positive d (d = 15 and d = 100 both do), so the add arm is load-bearing.
//
// Register use is rax/rcx/rdx only, so the callers' existing
// flush_clob(0,1,2) covers it. d is passed as an imm32 (three-operand imul), so
// the caller must guarantee 0 < d <= 2^31-1.
fn emit_cdiv_core(d, a0) {
    compute_magic(d)
    let M = magicM
    let sh = magicSh
    loadhome(1, a0)               // rcx = a   (kept: needed for r_t and for the M<0 arm)
    rr(0, 1)                      // rax = a   (imul's implicit multiplicand)
    ri64(2, M)                    // rdx = M
    rimul1(2)                     // rdx:rax = rax*M  ->  rdx = mulhi_s(a, M)
    if M < 0 { ra(2, 1) }         // rdx += a
    rsar_imm(2, sh)               // rdx = q0
    rr(0, 1); rsar_imm(0, 63)     // rax = a >> 63   (0, or -1 when a < 0)
    rs(2, 0)                      // rdx = q_t = trunc(a/d)
    rimul_imm(0, 2, d)            // rax = q_t * d
    rs(1, 0)                      // rcx = r_t = a - q_t*d   (sign of a)
}

fn op_is_float(vr) {
    // True if vr holds an f64 bit pattern.
    //
    // vfloat is the authority, set by method.quanta when a literal is lowered
    // (w64(vfloat+cr*8,1)), by codegen's prepass for i2f/fconst results, and by
    // entry.quanta for `-> f64` locals and parameters.  It is what the emit
    // path uses, so consulting it here keeps the two in agreement.
    //
    // Before this, the walk below ONLY recognised an IR_CALL named i2f and
    // returned 0 for everything else -- including a plain IR_CONST holding a
    // float literal.  Lowering literals from fconst() to IR_CONST therefore
    // made every float constant read as an integer: `let x: f64 = 1.0;
    // x / d` folded to 1, `x * d` trapped with SIGILL, and `x + d` produced
    // 9209861237972664320 (raw bit arithmetic on the patterns).
    if vr >= 0 && r8(vfloat+vr)==1 { return 1 }
    // Fall back to the def-chain walk for anything the table has not caught.
    // Bounded by opt_beg for the same reason as op_is_const: walking past the
    // current function can match a definition belonging to another one.
    let seen = mmap(256); let sp=0
    while sp<64 {
        w64(seen+sp*8, vr); sp=sp+1
        let k = irc-1
        let found = -1
        while k>=opt_beg {
            if irres(k)==vr {
                if irop(k)==IR_CALL {
                    let nm = ira0(k)
                    if r8(src+nm)=='i' && r8(src+nm+1)=='2' && r8(src+nm+2)=='f' { return 1 }
                    found = -2; break
                } else if irop(k)==IR_MOV { vr = ira0(k); found = 1; break }
                else { found = -2; break }
            }
            k=k-1
        }
        if found==-2 { return 0 }
        if found!=1 { return 0 }
    }
    return 0
}

fn constfold(i, op, r0, a0, a1) {
    // float operands: do NOT fold as integers (would corrupt float bit-patterns).
    // Leave the MUL/DIV/ADD/SUB for the emit path to handle via SSE.
    if (r8(vfloat+a0)==1 || r8(vfloat+a1)==1) { return 0 }
    // both operands foldable -> fold to a MOV r0, f
    // G2: when overflow trapping is ON, do NOT fold signed add/sub/mul ? the
    // emitted `jo` is a deliberate side effect that must survive. (Bitwise and
    // logical compares have no trap, so they still fold.)
    if ovf_trap==1 {
        if op==IR_ADD || op==IR_SUB || op==IR_MUL { return 0 }
    }
    let c0 = op_is_const(a0); let c1 = op_is_const(a1)
    if c0==1 && c1==1 {
        let v0 = op_const_val(a0); let v1 = op_const_val(a1); let f=0
        if op==IR_ADD { f=v0+v1 }
        else if op==IR_SUB { f=v0-v1 }
        else if op==IR_MUL { f=v0*v1 }
        // P6.1b FIX: width-typed unsigned arithmetic must wrap/truncate even
        // when const-folded. Without this, e.g. `let p:u16=65000; let q:u16=5000;
        // p+q` folds to the full 64-bit 70000 (losing the 0xFFFF wrap to 744).
        if op==IR_ADD || op==IR_SUB || op==IR_MUL {
            let wvt = 0
            if a0 < vreg_n { wvt = r64(vreg_type + a0*8) }
            if wvt < 1 || wvt > 3 { if a1 < vreg_n { wvt = r64(vreg_type + a1*8) } }
            // 1=u8, 7=char, 8=byte -> 0xFF ; 2=u16 -> 0xFFFF ; 3=u32 -> 0xFFFFFFFF
            if wvt == 1 || wvt == 7 || wvt == 8 { f = f & 0xFF }
            else if wvt == 2 { f = f & 0xFFFF }
            else if wvt == 3 { f = f & 0xFFFFFFFF }
        }
        else if op==IR_BAND { f=v0&v1 }
        else if op==IR_BOR { f=v0|v1 }
        else if op==IR_BXOR { f=v0^v1 }
        else if op==IR_OR { if v0!=0||v1!=0 { f=1 } else { f=0 } }
        else if op==IR_AND { if v0!=0&&v1!=0 { f=1 } else { f=0 } }
        else if op==IR_EQ { if v0==v1 { f=1 } else { f=0 } }
        else if op==IR_NE { if v0!=v1 { f=1 } else { f=0 } }
        else if op==IR_LT { if v0<v1 { f=1 } else { f=0 } }
        else if op==IR_GT { if v0>v1 { f=1 } else { f=0 } }
        else if op==IR_LE { if v0<=v1 { f=1 } else { f=0 } }
        else if op==IR_GE { if v0>=v1 { f=1 } else { f=0 } }
        w64(ir+opt_i*IRS, IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,f); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0)
        return 1
    }
    return 0
}

// P6.1b: width-mask an unsigned result. o0/o1 are the operand vreg numbers; if
// either is a declared unsigned width (1=u8,2=u16,3=u32), AND-mask rd to that
// width so arithmetic wraps/truncates. Bounds-checked (o<vreg_n) to avoid
// out-of-range vreg_type reads. u64/usize (4/5) are 64-bit -> no mask.
// Called from IR_ADD/SUB/MUL emit after sdef.
fn width_mask(o0, o1, rd) {
    let vt = 0
    if o0 < vreg_n { vt = r64(vreg_type + o0*8) }
    if vt < 1 || vt > 3 {
        if o1 < vreg_n { vt = r64(vreg_type + o1*8) }
    }
    // Width types that need runtime truncation:
    //   1=u8, 7=char, 8=byte  -> 0xFF
    //   2=u16                 -> 0xFFFF
    //   3=u32                 -> 0xFFFFFFFF
    // (4=u64, 5=usize are 64-bit -> no mask; 6=bool is logical 0/1 and is NOT
    //  width-masked on arithmetic ? bool math is plain integer, so true+true=2;
    //  0=signed -> no mask.)
    //
    // 0.0.249: the guard used to be `... && rd != 0`, i.e. it read `rd == 0` as
    // "no register was supplied". That is wrong: 0 is RAX, a perfectly good
    // result register. It was never caught because the old adistinct() emptied
    // the register map on every binary op, so RAX was always occupied when the
    // scan ran and adistinct() never returned it -- the mask simply never had to
    // handle rd==0. F1 lets values stay resident, adistinct() legitimately
    // returns RAX, and the truncation was then silently DROPPED:
    //
    //     pre-F1  : rd=r15            post-F1 (before this fix): rd=rax
    //                 ... add %r14,%r15                   ... add %r13,%rax
    //                 and $0xff,%r15        <-- present    (no mask at all)
    //
    // Measured: test_suites/codes/mixed_width_mask_test.quanta exited 103
    // instead of 7 (`let i = g + h` with u8 g=255, h=1 no longer wrapped to 0).
    //
    // All three call sites (IR_ADD / IR_SUB / IR_MUL) pass the live register
    // returned by adistinct(), which is never a sentinel, so the correct guard is
    // "a width type is in play" -- nothing else. There is no rd<0 or rd==-1 case
    // to preserve: an unallocated result is not representable at these sites.
    if vt==1||vt==7||vt==8||vt==2||vt==3 {
        // modrm: mod=11, reg=100 (AND), rm=result reg. The result may be an
        // extended register (r8-r15) when low registers are occupied, which
        // requires REX.B. Without it the mask encodes onto the wrong register
        // (e.g. rdx instead of r10) and the truncation is silently lost.
        let rm = 224 + (rd % 8)
        let rex = 72
        if rd >= 8 { rex = rex + 1 }
        if vt==1 || vt==7 || vt==8 { eb(rex); eb(129); eb(rm); ei(0xFF) }
        else if vt == 2 { eb(rex); eb(129); eb(rm); ei(0xFFFF) }
        else if vt == 3 { eb(rex); eb(193); eb(rm); eb(32); eb(rex); eb(193); eb(232 + (rd%8)); eb(32) }
    }
}

// G5: opt_func() and ci_func() both used to scan 0..irc. That is correct for a
// source function, whose IR is the whole live buffer, but WRONG for a
// cache-imported one: its slice lives in the module arena at [ir_beg, ir_end)
// while `irc` is the arena's total record count. Scanning 0..irc there walked
// every other function's records and dereferenced a bogus `src` offset, so the
// optimiser crashed before codegen even started. opt_beg/opt_opt_end describe the
// current function and are set by ci_func.
let opt_beg = 0
let opt_end = 0

fn opt_func() {
    if opt_on==0 { return }
    if had_error==1 { return }
    if opt_end <= opt_beg { return }
    // PRE-PASS: mark float vregs so constfold/emit handle them as floats.
    // i2f(x): int64 -> f64. Any IR_CALL named "i2f" yields a float result vreg.
    //
    // This must run BEFORE the folding loop below -- that is its whole purpose.
    // The fold guard is `if vfloat[a0] || vfloat[a1] then don't fold`, so an
    // untagged f64 literal looked like an integer and `1.0 / 3.0` folded to integer
    // 1/3 = 0. 6.0/3.0 and 1.0/2.0 read back correct only because integer division
    // happens to agree on exactly those.
    //
    // Two sources of a float vreg: an IR_FCONST literal, and an i2f conversion.
    // (IR_PARAM is tagged later, in the post-aclr pass, because aclr() clears
    // vfloat and this optimiser runs before aclr.)
    let pp=opt_beg
    while pp<opt_end {
        if irop(pp)==IR_FCONST {
            w8(vfloat+irres(pp), 1)
        }
        else if irop(pp)==IR_CALL {
            let nm = ira0(pp)
            if r8(src+nm)=='i' && r8(src+nm+1)=='2' && r8(src+nm+2)=='f' {
                w8(vfloat+irres(pp), 1)
            }
            // fconst(M, scale) is how the PARSER represents every f64 literal:
            // an IR_CALL named "fconst" whose result is the IEEE-754 bit pattern.
            // It was not tagged here, so a literal was not a float vreg as far as
            // the fold guard and the comparison/arithmetic emit paths were
            // concerned -- `0.25 < 0.5` took the INTEGER path and came out false.
            // (Nothing is named IR_FCONST in practice; the lexer's TT_FNUM is
            // lowered to this call in method.quanta.)
            else if r8(src+nm)=='f' && r8(src+nm+1)=='c' && r8(src+nm+2)=='o' {
                w8(vfloat+irres(pp), 1)
            }
        }
        pp=pp+1
    }
    // --- A: constant folding + algebraic identity (per-record, index-safe) ---
    opt_i=opt_beg
    while opt_i<opt_end {
        let op=irop(opt_i); let r0=irres(opt_i); let a0=ira0(opt_i); let a1=ira1(opt_i)
        if op==IR_ADD || op==IR_SUB || op==IR_MUL || op==IR_BAND || op==IR_BOR || op==IR_BXOR || op==IR_OR || op==IR_AND
          || op==IR_EQ || op==IR_NE || op==IR_LT || op==IR_GT || op==IR_LE || op==IR_GE {
            if constfold(opt_i,op,r0,a0,a1)==1 { opt_i=opt_i+1; continue }
            // Algebraic identities on a single constant operand.
            //
            // NEVER when either operand is a float. These rewrite the op into a
            // MOV or a fresh IR_CONST, which throws away the float result class:
            // `x * 2.0` folds to MOV x, and the multiply's SSE path (and with it
            // the correct value) disappears. The integer fold path above already
            // checks vfloat for exactly this reason; the identity path did not,
            // and widening op_is_const() to accept IR_FCONST exposed it --
            // test_full_inference started dying on an `imul` overflow trap
            // (jno/ud2) where a float multiply belonged.
            if r8(vfloat+a0)==1 || r8(vfloat+a1)==1 { opt_i=opt_i+1; continue }
            if op_is_const(a1)==1 {
                let v1 = op_const_val(a1)
                if op==IR_MUL && v1==1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_MUL && v1==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v1==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v1==-1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_ADD||op==IR_SUB||op==IR_BOR||op==IR_BXOR) && v1==0 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_DIV && v1==1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_SHL||op==IR_SHR) && v1==0 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_SHL||op==IR_SHR) && v1>0 && v1<64 && op_is_const(a0)==1 {
                    // FIX-0.0.50 (0.0.118): only fold when BOTH operands are
                    // constants. The compiler's own << / >> operators are broken
                    // for shift counts >= 31 (confirmed 1<<32 -> 0 at compile
                    // time), so compute the power-of-two via repeated *2
                    // (reliable) and apply with * / (reliable). If a0 is not a
                    // constant we must NOT use a0 (it is a vreg number, not a
                    // value) ? let it fall through to the runtime shift emit.
                    let va0 = op_const_val(a0)
                    let pw = 1
                    let pk = 0
                    while pk < v1 { pw = pw * 2; pk = pk + 1 }
                    let f = 0
                    if op==IR_SHL { f = va0 * pw } else { f = va0 / pw }
                    w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,f); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0)
                }
            }
            if op_is_const(a0)==1 {
                let v0 = op_const_val(a0)
                if op==IR_MUL && v0==1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_MUL && v0==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v0==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v0==-1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_ADD||op==IR_BOR||op==IR_BXOR) && v0==0 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_SUB && v0==0 { w64(ir+opt_i*IRS,IR_NEG); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
            }
            // x==x -> 1 ; x!=x -> 0  (same vreg operand)
            if a0==a1 {
                if op==IR_EQ { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_NE { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
            }
        } else if op==IR_NEG || op==IR_NOT || op==IR_BNOT {
            if op_is_const(a0)==1 {
                let f=0
                // 0.0.71: IR_NOT is LOGICAL not (`!x` / `not x`) -> 0/1.
                // IR_BNOT is BITWISE not (`~x`) -> ~x. They are DIFFERENT and
                // must fold differently.
                //
                // Previously both folded as ~x, so `!` meant two different things
                // depending on whether its operand was a constant:
                //   println(!0)            -> -1   (folded: bitwise)
                //   let a=0; println(!a)   ->  1   (runtime: logical)
                // The runtime lowering (xor/cmp/sete/movzx, see IR_NOT in
                // ci_func) is the correct one: all 36 unary-! sites in the
                // compiler's own sources are boolean tests -- `if !(tokt(p)==X)`,
                // `while !(...)`, `if !is_novf && !is_arm` -- and NONE uses `!`
                // for bitwise arithmetic. The folder was the outlier, and
                // bitwise_not.quanta only ever passed because every operand in it
                // is a constant, so it tested the buggy path exclusively and
                // froze that behaviour in as if it were the spec.
                if op==IR_NEG {
                    // Negating a CONSTANT. Two cases, and they must not be
                    // conflated:
                    //
                    //  - an f64 LITERAL. `-1.0` parses as unary minus over the
                    //    literal, so this is the sign of every negative float
                    //    constant in the tree. It must be the IEEE-754 SIGN
                    //    FLIP -- XOR the sign bit -- not `0 - x`. Subtracting the
                    //    bit pattern as an integer does not negate the float,
                    //    so every negative literal came out as a nonsense value:
                    //        let a = -1.0   -> -4607182418800017408
                    //        let c = -2.5   -> -4612811918334230528
                    //    lib/std/fs.quanta's f16_to_f64 opens with exactly that
                    //    shape (`let sign = 1.0` / `if .. { sign = -1.0 }`), so
                    //    every FP16 weight scale in the model decoded to garbage
                    //    and test_full_inference died on an imul overflow trap
                    //    inside dequant_q4k. The result is IR_FCONST so the
                    //    opcode still says "float"; folding to IR_CONST dropped
                    //    that tag as well as the value.
                    //
                    //  - an INTEGER literal. Plain `0 - x`, and IR_CONST.
                    //
                    // BOTH resolve the operand by scanning BACKWARD for a
                    // definition of its vreg, which is unsound: nv() is a global
                    // counter that resets between compilation units, so two
                    // constants in one function can share a vreg number and the
                    // scan can return the wrong one. That is not theoretical --
                    // it happened whenever an unrelated statement (a `print`,
                    // say) shifted vreg allocation:
                    //     check("+maxf32", p,  5183643170566569984)
                    //     check("-maxf32", p, -4039728866288205824)
                    // emitted want = -5183643170566569984, the PREVIOUS constant
                    // negated, and test_f32_conv failed on a number that is
                    // plausible enough to look like a converter bug.
                    //
                    // Fix: the operand of a folded unary op is the record
                    // DEFINITELY IMMEDIATELY PRECEDING it -- parse_unary() emits
                    // the literal and then the IR_NEG right after it, with
                    // nothing in between. So read that record directly instead of
                    // searching, which cannot pick a foreign definition.
                    //
                    // Floatness comes from the OPERAND RECORD'S OPCODE and
                    // nothing else -- not from vfloat[a0]. opt_func runs BEFORE
                    // aclr(), but the re-mark pass that populates vfloat has
                    // already run once by then, and it tags the ARGUMENT entries
                    // of any call to a `-> f64` function. An integer literal
                    // passed to such a function therefore arrives with
                    // vfloat==1, and deciding floatness from the tag made every
                    // negative INTEGER constant take the float path:
                    //     check("+maxf32", p,  5183643170566569984)   ok
                    //     check("-maxf32", p, -4039728866288205824)   came out
                    //     -5183643170566569984  = -(the previous constant)
                    // because XOR-ing bit 63 into an INTEGER is not its
                    // negation. `0 - x` is. Only an IR_FCONST operand -- a real
                    // float literal -- may take the sign-flip path.
                    let pk = opt_i-1
                    if pk >= opt_beg && irres(pk)==a0 && (irop(pk)==IR_CONST || irop(pk)==IR_FCONST) {
                        let b = ira0(pk)
                        if irop(pk)==IR_FCONST {
                            let SIGNBIT = 0 - 9223372036854775807 - 1
                            w64(ir+opt_i*IRS,IR_FCONST); w64(ir+opt_i*IRS+8,r0)
                            w64(ir+opt_i*IRS+16, b ^ SIGNBIT)
                            w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0)
                            // Tag the result HERE, not at parse time.
                            //
                            // This fold CREATES an IR_FCONST, and it runs AFTER
                            // the float-tagging pass at the top of opt_func, which
                            // is the only place a literal normally gets its
                            // vfloat tag before aclr(). So a NEGATIVE float
                            // literal was left untagged for the whole of
                            // opt_func, and every arithmetic on it took the
                            // INTEGER path over the bit pattern:
                            //     let q: f64 = 0.0 - 1.0
                            //     q * ln2      -> -4618953502541334033
                            //     (-ln2) * q  ->  4604418534313441775  (right)
                            // Only the positive literal worked, because the parser
                            // emitted it as an IR_FCONST that the tagging pass
                            // actually saw. That is why gguf_exp's whole negative
                            // half was garbage while exp(1), exp(2), exp(10)
                            // came out within 1-2 ULP.
                            w8(vfloat+r0, 1)
                            return 1
                        }
                        f=0-b
                    } else {
                        f=0-op_const_val(a0)
                    }
                }
                else if op==IR_NOT { if op_const_val(a0)==0 { f=1 } else { f=0 } }
                else { f=~op_const_val(a0) }
                w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,f); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0)
            }
        }
        opt_i=opt_i+1
    }
    // --- B: tail-call elimination (self-recursive, tail position only) ---
    // Detect IR_RET whose operand is the result of an IR_CALL to the SAME function
    // (name-pointer equality with cur_fnname). Rewrite into: move each call arg
    // into the corresponding incoming PARAM home slot, then JMP to a freshly
    // injected entry label (front-inserted; labels are by-id so index shift is safe).
    // We never delete records; the orphaned IR_CALL/temps are neutralized: the CALL
    // is rewritten to MOV res,res (harmless), and any remaining dead temps are
    // cleaned by the DCE no-op pass that runs AFTER this (but DCE already ran above,
    // so we neutralize the CALL here directly).
    opt_tailcall()

    // --- D: loop strength reduction (arithmetic-progression `while` loops) ---
    opt_loop_strength()

    // --- C: dead-code elimination (best-effort, index-safe, no record deletion) ---
    // A vreg V is LIVE if it is read by any op other than its defining op, or is
    // a RET operand, a CALL argument, or a PARAM target. Any op whose `res` is a
    // non-live vreg AND has no side effects (not CALL/RET/STR/STOREG) is turned
    // into a harmless `MOV res,res` no-op. We never delete records (label fixups
    // in ci_func rely on indices), so irc stays stable and the fixed point holds.
    // live_bits is a global (allocated once) to avoid per-function mmap collisions.
    // These three liveness scans were bounded by `irc`, the GLOBAL IR count of
    // the source translation unit. For a source function opt_beg=0 and
    // opt_end=irc, so `irc` was equivalent and the bug was invisible. For a
    // CACHE-IMPORTED function the slice is [opt_beg, opt_end) inside the module
    // arena while `irc` still describes the source TU -- so the scans walked an
    // unrelated range and then scan 2 rewrote IR_MOV over records that were not
    // even part of the function being compiled. Bound all three to the
    // optimiser's own window.
    // Scan 1: mark live vregs (clear [0,maxvr+1) first).
    let maxvr2=0
    let cl=opt_beg
    while cl<opt_end { let cr=irres(cl); if cr>maxvr2 { maxvr2=cr }; cl=cl+1 }
    let clr=0
    while clr<=maxvr2 { w8(live_bits+clr,0); clr=clr+1 }
    let j=opt_beg
    while j<opt_end {
        let op=irop(j)
        // operands that read vregs
        let o0=ira0(j); let o1=ira1(j); let o2=ira2(j)
        // every op reads o0,o1 (and o2 where relevant); mark them live
        if op!=IR_CONST && op!=IR_FCONST { w8(live_bits+o0,1) }
        if op!=IR_CONST && op!=IR_FCONST && op!=IR_BR && op!=IR_JMP { w8(live_bits+o1,1) }
        if op==IR_CALL {
            w8(live_bits+o2,1)   // arg-count IR index is live
            // mark each argument vreg live (the call reads irres(a2+i))
            let call_ac=ira1(j)   // arg count
            let call_as=ira2(j)   // arg-start IR index
            let call_ai=0
            while call_ai<call_ac {
                let call_arg_ir=call_as+call_ai
                if call_arg_ir<irc { w8(live_bits+irres(call_arg_ir),1) }
                call_ai=call_ai+1
            }
        }
        // A void IR_RET carries o0 = -1; live_bits+(-1) writes one byte BEFORE
        // the table. Only mark a real vreg.
        if op==IR_RET && o0>=0 { w8(live_bits+o0,1) }
        if op==IR_PARAM { w8(live_bits+o0,1) }   // PARAM target vreg is live
        if op==IR_STOREG { w8(live_bits+o0,1) }  // STOREG reads o0
        // NOTE: a defining op's own res is not auto-live; only marked if read above
        j=j+1
    }
    // Scan 2: no-op dead defs.
    let k=opt_beg
    while k<opt_end {
        let op=irop(k)
        if op==IR_CALL || op==IR_RET || op==IR_STR || op==IR_STOREG || op==IR_LABEL || op==IR_JMP || op==IR_BR || op==IR_FREE { k=k+1; continue }
        let res=irres(k)
        if w8(live_bits+res)==0 {
            // dead def -> no-op (MOV res,res). Keep index; harmless.
            //
            // NEVER for a CONSTANT or a folded literal. A constant has no
            // operands, so liveness has nothing to mark it and `live_bits[res]`
            // is 0 whenever the value is not read by a later IR op -- and a
            // literal passed straight to a call is read through the argument
            // record list, not through the IR op that defines it. Rewriting
            // such a record to `MOV res, res` DELETES the constant and leaves
            // the argument register holding whatever it last held, so the call
            // received a stale value from an earlier statement:
            //     check("+maxf32", p,  5183643170566569984)
            //     check("-maxf32", p, -4039728866288205824)
            // passed -5183643170566569984 -- the previous constant. That is
            // exactly what made test_f32_conv fail on a value that is
            // plausible enough to look like a converter defect.
            if op!=IR_CONST && op!=IR_FCONST {
                w64(ir+k*IRS, IR_MOV); w64(ir+k*IRS+8,res); w64(ir+k*IRS+16,res); w64(ir+k*IRS+24,0); w64(ir+k*IRS+32,0)
            }
        }
        k=k+1
    }
}

// Return the home vreg of PARAM slot `idx` in the current function's IR, else -1.
fn param_home_of(idx) {
    let p=0
    while p<irc {
        if irop(p)==IR_PARAM && ira0(p)==idx { return irres(p) }
        p=p+1
    }
    return -1
}

// Identifier length at src offset `a` (scan while [A-Za-z0-9_]).
fn sidlen(a) {
    let n=0
    while n<64 {
        let c=r8(src+a+n)
        if c>=97 && c<=122 { n=n+1; continue }
        if c>=65 && c<=90 { n=n+1; continue }
        if n>0 && c>=48 && c<=57 { n=n+1; continue }
        if c==95 { n=n+1; continue }
        break
    }
    return n
}
// Compare src-string at `a` (an identifier) against cur_fnname (fns-table string).
fn sname_eq(a) {
    if sidlen(a) != cur_fnnlen { return 0 }
    let n=0
    while n<cur_fnnlen {
        if r8(src+a+n) != r8(src+cur_fnname+n) { return 0 }
        n=n+1
    }
    return 1
}

// Pass B: tail-call elimination (self-recursive, tail position only).
// 0.0.230 Phase B2: byte displacement of a packed field from the struct base:
// field offset + 8-byte length header. Computed in ONE place with explicit
// parens so the displacement bytes cannot depend on operator-precedence guesses.


fn def_is_constval(vr) {
    let k = irc - 1
    while k >= 0 {
        if irres(k) == vr {
            if irop(k) == IR_MOV { return def_is_constval(ira0(k)) }
            if irop(k) == IR_CONST || irop(k) == IR_FCONST { return ira0(k) }
            return -1
        }
        k = k - 1
    }
    return -1
}

// Pass D: strength-reduce an arithmetic-progression `while` loop to closed form.
// Real IR shape emitted by parse_while for `while iv < C { sv = sv+iv; iv = iv+1 }`:
//   [p]   LABEL st
//   [p+1] CONST cvreg, C          (C compile-time constant)
//   [p+2] LT    cmp, iv, cvreg
//   [p+3] BR    cmp, en2, ct
//   [p+4] LABEL ct
//   [p+5] ADD   t1, sv, iv        (accumulator: operands {sv,iv})
//   [p+6] MOV   sv, t1
//   [p+7] CONST onev, 1
//   [p+8] ADD   t2, iv, onev      (counter: iv + 1)
//   [p+9] MOV   iv, t2
//   [p+10] JMP  st
//   [p+11] LABEL en2
// with iv initialized to a compile-time constant `lo` (resolved via def_is_constval)
// before the loop. Since lo and C are constants, count/sum are computed here and
// emitted as CONSTs (no runtime MUL/DIV):
//   count = max(0, C-lo);  sum = count*(2*lo+count-1)/2;  sv += sum;  iv = lo+count.
// Rewrites BR -> JMP Lc (skip the body) and appends the closed-form epilogue.
//
// CORRECTNESS / SCOPE: matches the 12-record pattern by opcode+operand identity;
// any deviation => loop left untouched (always correct). Closed form is valid for
// ANY integer lo, C (count clamped at 0 when C<=lo). Product count*(2lo+count-1)
// is always even => exact integer division.
//
fn opt_loop_strength() {
    // G2: the closed-form `sum = count*(2*lo+count-1)/2` is computed at COMPILE
    // time; for very large iteration counts it deliberately overflows i64. Wrap
    // in unsafe{} so the bootstrapping compiler (which runs this on user loops)
    // is exempt from the overflow trap during self-host.
    unsafe {
    if opt_on == 0 { return }
    if had_error == 1 { return }
    // Bound the pattern search to THIS function's IR slice: `irc` is the whole
    // live buffer for a source function but the whole module arena for a cached
    // one, so using it here would match patterns across function boundaries and
    // rewrite unrelated records.
    // `scan_end` is the ORIGINAL slice and stays fixed for the whole pass, even
    // after a reduction grows opt_end. Without that the scan would walk into the
    // records it just synthesised and could reduce the same loop twice.
    let scan_end = opt_end
    let n0 = scan_end
    // A function contains at most one arithmetic-progression while-loop that this
    // pattern matches, and the rewrite SHIFTS records, so scanning on after a
    // reduction would re-enter on the synthesised tail and rewrite it again.
    let reduced = 0
    let p = opt_beg
    while p < scan_end && reduced == 0 {
        let ok = 1
        if irop(p) != IR_LABEL { ok = 0 }
        if ok == 1 { if p + 12 >= n0 { ok = 0 } }
        if ok == 1 {
            let stl = ira0(p)
            if irop(p+1) != IR_CONST { ok = 0 }
            if ok == 1 { if irop(p+2) != IR_LT { ok = 0 } }
            if ok == 1 { if irop(p+3) != IR_BR { ok = 0 } }
            if ok == 1 { if irop(p+4) != IR_LABEL { ok = 0 } }
            if ok == 1 { if irop(p+5) != IR_ADD { ok = 0 } }
            if ok == 1 { if irop(p+6) != IR_MOV { ok = 0 } }
            if ok == 1 { if irop(p+7) != IR_CONST { ok = 0 } }
            if ok == 1 { if irop(p+8) != IR_ADD { ok = 0 } }
            if ok == 1 { if irop(p+9) != IR_MOV { ok = 0 } }
            if ok == 1 { if irop(p+10) != IR_JMP { ok = 0 } }
            if ok == 1 { if irop(p+11) != IR_LABEL { ok = 0 } }
            if ok == 1 {
                let cvreg = irres(p+1)
                let Cval  = ira0(p+1)
                let iv    = ira0(p+2)
                let cmp   = irres(p+2)
                let en2   = ira1(p+3)
                let ct    = ira2(p+3)
                if ira1(p+2) != cvreg { ok = 0 }
                if ok == 1 { if ira0(p+3) != cmp { ok = 0 } }
                if ok == 1 { if ira0(p+4) != ct { ok = 0 } }
                if ok == 1 { if ira0(p+10) != stl { ok = 0 } }
                if ok == 1 { if ira0(p+11) != en2 { ok = 0 } }
                let t1  = irres(p+5)
                let ad0 = ira0(p+5)
                let ad1 = ira1(p+5)
                let sv  = irres(p+6)
                if ira0(p+6) != t1 { ok = 0 }
                if ok == 1 {
                    let accok = 0
                    if ad0 == sv && ad1 == iv { accok = 1 }
                    if ad0 == iv && ad1 == sv { accok = 1 }
                    if accok == 0 { ok = 0 }
                }
                let onev = irres(p+7)
                if ok == 1 { if ira0(p+7) != 1 { ok = 0 } }
                let t2 = irres(p+8)
                if ok == 1 {
                    let stepok = 0
                    if ira0(p+8) == iv && ira1(p+8) == onev { stepok = 1 }
                    if ira0(p+8) == onev && ira1(p+8) == iv { stepok = 1 }
                    if stepok == 0 { ok = 0 }
                }
                if ok == 1 { if irres(p+9) != iv { ok = 0 } }
                if ok == 1 { if ira0(p+9) != t2 { ok = 0 } }
                if ok == 1 { if sv == iv { ok = 0 } }
                if ok == 1 {
                    let lo = 0
                    let found = 0
                    let s = p - 1
                    while s >= 0 {
                        if irop(s) == IR_MOV && irres(s) == iv {
                            let lv = def_is_constval(ira0(s))
                            if lv != -1 { lo = lv; found = 1 }
                            s = 0
                        }
                        s = s - 1
                    }
                    if found == 1 {
                        let count = Cval - lo
                        if count < 0 { count = 0 }
                        let sum = 0
                        if count > 0 { sum = count * (2 * lo + count - 1) / 2 }
                        let ivfinal = lo + count
                        let sumv = nv()
                        let Lc = nl()
                        // Rewrite the loop in place. The ten records p+1..p+10 are
                        // retired and the closed form needs only five slots, so the
                        // whole rewrite fits WITHOUT shifting the tail -- an earlier
                        // version inserted the closed form after p+11 and shifted
                        // everything up by five, which duplicated the records that
                        // followed and left the synthesised IR_LABEL unreachable.
                        //
                        // Layout:
                        //   p       IR_JMP   Lc     -- skip the original body
                        //   p+1..p+10  closed form + throwaway labels
                        //   p+11   IR_LABEL en2    -- the loop's exit, untouched
                        //   p+12..  the rest of the function, untouched
                        //
                        // The closed form must live INSIDE the slice. Appending it at
                        // ir+irc*IRS (the old behaviour) put it after the function's
                        // trailing IR_RET, where it was unreachable dead code: its
                        // IR_LABEL never bound, lblf() returned -1, and the guard
                        // jump kept a zero displacement -- an infinite loop. That is
                        // why this reduction had never actually fired.
                        w64(ir+p*IRS, IR_JMP); w64(ir+p*IRS+8, 0); w64(ir+p*IRS+16, Lc); w64(ir+p*IRS+24, 0); w64(ir+p*IRS+32, 0)
                        w64(ir+(p+1)*IRS, IR_LABEL); w64(ir+(p+1)*IRS+8, 0); w64(ir+(p+1)*IRS+16, Lc); w64(ir+(p+1)*IRS+24, 0); w64(ir+(p+1)*IRS+32, 0)
                        w64(ir+(p+2)*IRS, IR_CONST); w64(ir+(p+2)*IRS+8, sumv); w64(ir+(p+2)*IRS+16, sum); w64(ir+(p+2)*IRS+24, 0); w64(ir+(p+2)*IRS+32, 0)
                        w64(ir+(p+3)*IRS, IR_ADD); w64(ir+(p+3)*IRS+8, sv); w64(ir+(p+3)*IRS+16, sv); w64(ir+(p+3)*IRS+24, sumv); w64(ir+(p+3)*IRS+32, 0)
                        w64(ir+(p+4)*IRS, IR_CONST); w64(ir+(p+4)*IRS+8, iv); w64(ir+(p+4)*IRS+16, ivfinal); w64(ir+(p+4)*IRS+24, 0); w64(ir+(p+4)*IRS+32, 0)
                        w64(ir+(p+5)*IRS, IR_JMP); w64(ir+(p+5)*IRS+8, 0); w64(ir+(p+5)*IRS+16, en2); w64(ir+(p+5)*IRS+24, 0); w64(ir+(p+5)*IRS+32, 0)
                        // p+6..p+10 become throwaway labels: IR_LABEL is the one
                        // opcode whose emit does nothing but lbladd(), so it touches
                        // no vreg. A self-move no-op is NOT safe here -- IR_BR/IR_JMP
                        // carry res=0, and IR_MOV emits sdef(0,...) which relocates
                        // vreg 0's spill slot and clobbers live state.
                        let Ldead = nl()
                        let nq = 6
                        while nq < 11 {
                            let rq = ir+(p+nq)*IRS
                            w64(rq, IR_LABEL); w64(rq+8, 0); w64(rq+16, Ldead); w64(rq+24, 0); w64(rq+32, 0)
                            nq = nq + 1
                        }
                        reduced = 1
                    }
                }
            }
        }
        p = p + 1
    }
    }
}

fn opt_tailcall() {
    if opt_on==0 { return }
    if had_error==1 { return }
    if cur_fnname==0 { return }
    // Find a RETURN whose operand is the result vreg of a self CALL.
    let ri=opt_beg
    while ri<opt_end {
        if irop(ri)==IR_RET {
            let rv=ira0(ri)
            let ci2=opt_beg
            while ci2<opt_end {
                if irop(ci2)==IR_CALL && irres(ci2)==rv {
                    if sname_eq(ira0(ci2))==1 {
                        // === transform ===
                        let acnt=ira1(ci2); let avs=ira2(ci2)
                        let L=nl()  // entry label
                        // Reuse the CALL's arg-MOV record slots [avs..avs+acnt-1] as the
                        // param-moves (MOV param_home[i], argvr[i]). No mid-array shift.
                        let bad=0
                        let w=0
                        while w<acnt {
                            let argrec=avs+w
                            let argvr=0
                            if argrec>=opt_beg && argrec<opt_end { argvr=ira0(argrec) }
                            let ph=param_home_of(w)
                            if ph<0 { bad=1 }
                            w64(ir+argrec*IRS, IR_MOV); w64(ir+argrec*IRS+8, ph); w64(ir+argrec*IRS+16, argvr); w64(ir+argrec*IRS+24,0); w64(ir+argrec*IRS+32,0)
                            w=w+1
                        }
                        if bad==1 { return }  // param slot missing; bail (no corruption)
                        // CALL@ci2 -> JMP L
                        w64(ir+ci2*IRS, IR_JMP); w64(ir+ci2*IRS+8,0); w64(ir+ci2*IRS+16,L); w64(ir+ci2*IRS+24,0); w64(ir+ci2*IRS+32,0)
                        // RET@ri -> JMP L (base-case RET elsewhere stays)
                        w64(ir+ri*IRS, IR_JMP); w64(ir+ri*IRS+8,0); w64(ir+ri*IRS+16,L); w64(ir+ri*IRS+24,0); w64(ir+ri*IRS+32,0)
                        // Insert LABEL L AFTER the last IR_PARAM so the loop-back skips
                        // the param-from-stack reload (otherwise it clobbers our args).
                        // Single safe shift (+1) at (lastparam+1) <= front of body.
                        let lastparam=-1
                        let pp=opt_beg
                        while pp<opt_end {
                            if irop(pp)==IR_PARAM { lastparam=pp }
                            pp=pp+1
                        }
                        let ins=lastparam+1
                        let s2=irc-1
                        while s2>=ins {
                            w64(ir+(s2+1)*IRS, irop(s2))
                            w64(ir+(s2+1)*IRS+8, irres(s2))
                            w64(ir+(s2+1)*IRS+16, ira0(s2))
                            w64(ir+(s2+1)*IRS+24, ira1(s2))
                            w64(ir+(s2+1)*IRS+32, ira2(s2))
                            s2=s2-1
                        }
                        irc=irc+1
                        w64(ir+ins*IRS, IR_LABEL); w64(ir+ins*IRS+8,0); w64(ir+ins*IRS+16,L); w64(ir+ins*IRS+24,0); w64(ir+ins*IRS+32,0)
                        return
                    }
                }
                ci2=ci2+1
            }
        }
        ri=ri+1
    }
}

// ==== F2 analysis (0.0.250): block-level liveness for the flush filter =======
//
// Computes, once per function, the LIVE-IN and LIVE-OUT sets of every basic block
// in the IR slice, and publishes them for flush_all() (see the F2 block comment in
// emitter.quanta for why this is the lever, and the soundness argument).
//
// Conservative in one direction only: every approximation is chosen so that a
// value the analysis is unsure about stays LIVE, i.e. gets stored. Reads are
// over-reported (the a4_reads op classification plus all three operand slots of
// the general case), definitions are under-reported (control opcodes and
// IR_STOREG/IR_FREE never define), an out-of-range vreg is never covered, and the
// whole analysis is abandoned (f2_ok = 0 => store everything, 0.0.249 behaviour)
// on anything it cannot model exactly: the try/catch/throw and closure clusters,
// match/asm/FFI/vec128, an unresolved jump target, non-convergence, or tables
// that would not fit.
let F2_BIG = 2097152

fn f2_adduse(v, base) {
    if v < 0 { return 0 }
    if v >= f2_w { return 0 }
    if r8(f2_ldef + base + v) == 0 { w8(f2_lin + base + v, 1) }
    return 0
}

// f2_reads_b(j, base): add every vreg IR op j may READ to the block's use set.
fn f2_reads_b(j, base) {
    let op = irop(j)
    if op == IR_CONST || op == IR_FCONST { return 0 }
    if op == IR_PARAM { return 0 }
    if op == IR_LOADG { return 0 }
    if op == IR_LABEL || op == IR_JMP { return 0 }
    if op == IR_STR { return 0 }
    if op == IR_BR { f2_adduse(ira0(j), base); return 0 }
    if op == IR_RET { f2_adduse(ira0(j), base); return 0 }
    if op == IR_STOREG { f2_adduse(ira0(j), base); return 0 }
    if op == IR_CALL || op == IR_CALL_IDX {
        let ac = ira1(j); let st = ira2(j); let q = 0
        while q < ac { f2_adduse(irres(st+q), base); q = q + 1 }
        return 0
    }
    f2_adduse(ira0(j), base)
    f2_adduse(ira1(j), base)
    f2_adduse(ira2(j), base)
    return 0
}

// f2_def_b(j, base): add vreg IR op j DEFINITELY writes to the block's def set.
// Under-reporting only widens the live sets, so any op whose result slot is not a
// plain vreg is excluded rather than guessed at.
fn f2_def_b(j, base) {
    let op = irop(j)
    if op == IR_LABEL || op == IR_JMP || op == IR_BR || op == IR_RET { return 0 }
    if op == IR_STOREG || op == IR_FREE { return 0 }
    let r = irres(j)
    if r < 0 { return 0 }
    if r >= f2_w { return 0 }
    w8(f2_ldef + base + r, 1)
    return 0
}

fn f2_or_into(dst, srcp, n) {
    let q = 0
    while q < n { if r8(srcp+q)!=0 { w8(dst+q, 1) }; q = q + 1 }
    return 0
}

fn f2_close(bs, e, id, beg) {
    w64(f2_bstart + id*8, bs)
    w64(f2_bend + id*8, e)
    let j = bs
    while j < e { w64(f2_blk + (j-beg)*8, id); j = j + 1 }
    return 0
}

fn f2_analyze(beg, end, maxvr) {
    f2_ok = 0
    let span = end - beg
    if span <= 0 { return 0 }
    let W = maxvr + 1
    if W < 1 { return 0 }
    if W > 400000 { return 0 }
    if span > F2_IXCAP { return 0 }
    if span*8 > F2_BIG { return 0 }
    f2_base = beg
    f2_endat = end
    f2_w = W
    let i = 0
    while i < span { w64(f2_blk + i*8, 0-1); w64(f2_kind + i*8, 0); i = i + 1 }
    // ---- poison scan + label extent ----
    let minl = 0 - 1; let maxl = 0 - 1
    i = beg
    while i < end {
        let op = irop(i)
        if op == IR_CLOSURE || op == IR_CLOSURE_CALL || op == IR_FNVAL { return 0 }
        if op == IR_CAPREAD || op == IR_CAPWRITE { return 0 }
        if op == IR_TRY || op == IR_CATCH || op == IR_THROW { return 0 }
        if op == IR_TRY_PUSH || op == IR_TRY_END { return 0 }
        if op == IR_MATCH || op == IR_ASM || op == IR_FFI_CALL || op == IR_VEC128 { return 0 }
        if op == IR_LABEL {
            let L0 = ira0(i)
            if maxl < 0 { minl = L0; maxl = L0 }
            else { if L0 < minl { minl = L0 }; if L0 > maxl { maxl = L0 } }
        }
        i = i + 1
    }
    let nlbl = 0
    if maxl >= 0 { nlbl = maxl - minl + 1 }
    if nlbl > F2_LBLCAP { return 0 }
    let k = 0
    while k < nlbl { w64(f2_lbl + k*8, 0-1); k = k + 1 }
    // ---- basic blocks (split at IR_LABEL, and after IR_JMP/IR_BR/IR_RET) ----
    let nb = 0
    let bs = beg
    i = beg
    while i < end {
        let op = irop(i)
        if op == IR_LABEL {
            if i > bs { f2_close(bs, i, nb, beg); bs = i; nb = nb + 1 }
            w64(f2_lbl + (ira0(i)-minl)*8, nb)
            w64(f2_kind + (i-beg)*8, 1)
        }
        if op == IR_JMP { w64(f2_kind + (i-beg)*8, 2) }
        if op == IR_BR  { w64(f2_kind + (i-beg)*8, 3) }
        if op == IR_RET { w64(f2_kind + (i-beg)*8, 4) }
        if op == IR_JMP || op == IR_BR || op == IR_RET {
            f2_close(bs, i+1, nb, beg); bs = i+1; nb = nb + 1
        }
        i = i + 1
    }
    if bs < end { f2_close(bs, end, nb, beg); nb = nb + 1 }
    if nb <= 0 { return 0 }
    if nb > F2_NBCAP { return 0 }
    let tot = nb * W
    if tot > F2_BIG { return 0 }
    // ---- successor edges ----
    let b = 0; let ok = 1
    while b < nb {
        if ok == 1 {
        let e1 = r64(f2_bend + b*8)
        w64(f2_s1 + b*8, 0-1); w64(f2_s2 + b*8, 0-1)
        let lop = irop(e1-1)
        if lop == IR_JMP {
            let L1 = ira0(e1-1)
            if L1 < minl || L1 > maxl { ok = 0 }
            else {
                let t1 = r64(f2_lbl + (L1-minl)*8)
                if t1 < 0 { ok = 0 } else { w64(f2_s1 + b*8, t1) }
            }
        }
        else if lop == IR_BR {
            let L2 = ira1(e1-1)
            if L2 < minl || L2 > maxl { ok = 0 }
            else {
                let t2 = r64(f2_lbl + (L2-minl)*8)
                if t2 < 0 { ok = 0 } else { w64(f2_s1 + b*8, t2) }
            }
            if e1 < end { let fb1 = r64(f2_blk + (e1-beg)*8); if fb1 >= 0 { w64(f2_s2 + b*8, fb1) } }
        }
        else if lop == IR_RET { }
        else {
            if e1 < end { let fb2 = r64(f2_blk + (e1-beg)*8); if fb2 >= 0 { w64(f2_s1 + b*8, fb2) } }
        }
        }
        b = b + 1
    }
    if ok == 0 { return 0 }
    // ---- use / def per block ----
    let z = 0
    while z < tot { w8(f2_lin+z,0); w8(f2_lout+z,0); w8(f2_ldef+z,0); z = z + 1 }
    b = 0
    while b < nb {
        let s0 = r64(f2_bstart + b*8)
        let e0 = r64(f2_bend + b*8)
        let j0 = s0
        while j0 < e0 {
            f2_reads_b(j0, b*W)
            f2_def_b(j0, b*W)
            j0 = j0 + 1
        }
        b = b + 1
    }
    // ---- liveness fixpoint ----
    //   live_out(B) = OR live_in(S) over successors S
    //   live_in(B)  = use(B) | (live_out(B) \ def(B))     [lin starts as use(B)]
    let iter = 0; let changed = 1
    let cap = nb + 2
    if cap > 500 { cap = 500 }
    while iter < cap {
        if changed == 1 {
        changed = 0
        b = 0
        while b < nb {
            let base = b*W
            let q0 = 0
            while q0 < W { w8(f2_lout + base + q0, 0); q0 = q0 + 1 }
            let sa = r64(f2_s1 + b*8)
            let sb = r64(f2_s2 + b*8)
            if sa >= 0 { f2_or_into(f2_lout + base, f2_lin + sa*W, W) }
            if sb >= 0 { f2_or_into(f2_lout + base, f2_lin + sb*W, W) }
            q0 = 0
            while q0 < W {
                if r8(f2_lout+base+q0) != 0 {
                    if r8(f2_ldef+base+q0) == 0 {
                        if r8(f2_lin+base+q0) == 0 { w8(f2_lin+base+q0, 1); changed = 1 }
                    }
                }
                q0 = q0 + 1
            }
            b = b + 1
        }
        }
        iter = iter + 1
    }
    if changed == 1 { return 0 }
    f2_ok = 1
    return 1
}

fn ci_func(fi, is_main) {
    // Per-function IR slice. Source-parsed functions live in the live `ir` buffer
    // and own 0..irc. Cache-imported functions live in the module arena
    // (`qir_mod`) and own [ir_beg, ir_end). Both are indexed in ABSOLUTE IR
    // indices, so IR_CALL's argument-list pointer (a2) and branch targets (a0)
    // are already correct within whichever buffer they were captured in -- no
    // relocation is needed, provided the caller points `ir` at the right arena.
    let ir_beg = r64(fn_ir_start + fi*8)
    let ir_end = ir_beg + r64(fn_ir_count + fi*8)
    let is_cache = r64(qimp_is_cache + fi*8)
    if is_cache == 0 { ir_beg = 0; ir_end = irc }
    // Run the Tier-1 optimiser over THIS function's slice only. The source path
    // calls opt_func() externally; doing it here guarantees the same treatment
    // regardless of which arena the IR lives in.
    opt_beg = ir_beg
    opt_end = ir_end
    opt_func()
    // Remember how high the vreg numbering got, then reset it.
    //
    // aclr() (emitter.quanta) clears vr_init / vr_spill / vfloat with
    // `while i < vreg_n`. It runs LATER in this function than the reset below, so
    // by then vreg_n is already 0 and the loop body never executes: the per-vreg
    // side tables were NEVER cleared between functions.
    //
    // vfloat is what is_float_vr() reads, so a stale tag from a previously
    // compiled function survived into the next one. The symptom was a float
    // global whose arithmetic worked or failed depending on POSITION -- anything
    // emitted before it shifted the vreg numbering -- which is the signature of a
    // tag being inherited rather than derived. Disassembly confirmed it exactly:
    // one program emitted `movq %rax,%xmm0` + `addsd` (correct) and another
    // emitted `cvtsi2sd %rdx,%xmm0` + `addsd` for the identical expression,
    // where cvtsi2sd is fopld_rr's INTEGER path and the operand is the bit
    // pattern of the global read as a float.
    //
    // vreg_high carries the previous function's extent across the reset so aclr()
    // can actually clear it.
    vreg_high = vreg_n
    vreg_n = 0
    if is_cache == 1 {
      // Per-function context the source path establishes before parsing a body.
      // Without these an imported function inherits the previous function's label
      // counter, closure context, and operator-overload suppression.
      lblc = 0
      cur_clo = 0 - 1
      overload_suppressed = 0
      // The source path allocates every vreg through nv(), which initialises
      // vreg_is_str / vreg_is_big / vreg_clo / vreg_to_param to their
      // defaults. A cached function REUSES the vreg numbers baked into its
      // serialised IR and never calls nv(), so those tables still hold the
      // PREVIOUS function's values when codegen reads them.
      //
      // The initialisation MUST match nv() byte for byte. The previous version
      // of this block used w8() for vreg_is_str / vreg_is_big / vreg_clo
      // while nv() uses w64(). w8 writes a single byte, so the read-back
      // r64() returned the stale upper seven bytes of the slot -- an
      // arbitrary value, which is the same uninitialised-read class this
      // block exists to remove. That is what broke closure_named_fn.
      // Bounded to THIS function's IR slice, not the whole module. On the cache
      // path `ir` points at the module arena and `irc` is the module's total
      // record count, so scanning 0..irc walks every other function's records
      // and reads their vregs as if they belonged to this one.
      // Bounded to this function's IR within the LIVE buffer: ir_beg..irc.
      //
      // Not 0..irc: on the cache path `ir` is the module arena, so index 0 is
      // another function's first record.
      // Not ir_beg..ir_end: on the SOURCE path a function's closure bodies are
      // emitted into the same buffer AFTER the parent body, past ir_end, and
      // they carry the captured vregs this scan must see. Bounding to ir_end
      // truncated the range and cost closure_capture its vreg_clo state.
      let mvmax2 = 0
      let mv2 = ir_beg
      // Bound to THIS function's own slice. On the cache path `ir` is the module
      // arena and `irc` is the whole module's record count, so irc walks every
      // other cached function's records and takes the max vreg across all of
      // them. The init loop below then clears type/str/big/clo tags for vregs
      // that belong to a LATER function, and when that function is compiled its
      // own tags are already wrong -- which is how a cached function calling
      // two other cached functions returned a wrong value (chain(10) gave 12
      // instead of 38) while every single- and two-function module was correct.
      //
      // ir_end is right for both paths here: on the source path a function's
      // closure bodies are emitted past ir_end, but this block only runs when
      // is_cache==1, and a cached function has no closure bodies of its own.
      let mv2_end = ir_end
      while mv2 < mv2_end {
        let rv2 = irres(mv2)
        if rv2 > mvmax2 { mvmax2 = rv2 }
        mv2 = mv2 + 1
      }
      if mvmax2 > VREG_CAP { mvmax2 = VREG_CAP }
      let mi3 = 0
      while mi3 <= mvmax2 {
        w64(vreg_is_str + mi3*8, 0-1)
        w64(vreg_is_big + mi3*8, 0-1)
        w64(vreg_clo    + mi3*8, 0-1)
        w64(vreg_to_param + mi3*8, 0)
        w64(vreg_type + mi3*8, 0)
        mi3 = mi3 + 1
      }
      if r64(OPFN_SUPP + fi*8) == 1 { overload_suppressed = 1 }
      // Re-bind parameter names to their vregs. The cached slice carries the
      // IR_PARAM records (op 21) with the vreg each parameter occupies, but a
      // cache file stores no live scope table -- without this, vfind() cannot
      // resolve any parameter name and the body reads uninitialised vregs.
      // The name comes from the serialised param-name blob via fn_pnames.
      let pcount_c = r64(fn_pcount + fi*8)
      let pbase_c = r64(fn_pbase + fi*8)
      let ci2 = ir_beg
      let pseen = 0
      while ci2 < ir_end && pseen < pcount_c {
        if irop(ci2) == IR_PARAM {
          let pvr = ira0(ci2)
          let ppi = ira1(ci2)
          if ppi >= 0 && ppi < 8 {
            let pnm_c = r64(fn_pnames + pbase_c + ppi*16)
            let pnl_c = r64(fn_pnames + pbase_c + ppi*16 + 8)
            if pnl_c > 0 { vadd(pnm_c, pnl_c, pvr) }
            // Link the param vreg to its fn_parstr slot. Both find_str_source()
            // and arg_is_str() need this to recognise a string that arrived
            // through a parameter: vreg_is_str only ever gets set for the
            // vreg that IS the string, and a param vreg never is -- so with
            // this link missing, print()/echo() inside any function that took a
            // string printed the raw heap pointer instead of the text. That
            // silently affected every string-taking helper in the tree.
            // Key shape matches funcscan/objfmt: fi*200 + arg_index.
            w64(vreg_to_param + pvr*8, fi*200 + ppi)
          }
          pseen = pseen + 1
        }
        ci2 = ci2 + 1
      }
      // NOTE: generic type parameters are deliberately NOT re-allocated here.
      // Their IR_CONST marker records are already inside the cached function's
      // own IR slice, and their vreg numbers were fixed when that IR was first
      // parsed. Re-allocating them would shift every subsequent nv() and make the
      // cached function's vreg numbering disagree with the numbers baked into
      // its own records -- which is what produced null string pointers at run
      // time. The same applies to IR_PARAM: the cached slice carries those
      // records, so params are bound by re-walking the slice, not by re-emitting.
    }
    let pstart = patchc
    // Pre-scan IR to compute total string buffer size AND the true max vreg,
    // so the spill frame is sized to hold every vreg's home slot.  (compiler.py
    // sizes the frame from max_vreg; ci_func must match or spills for functions
    // with >2041 vregs run past the min_spill frame and corrupt locals.)
    let total_str=0
    let maxvr=0
    let psi=ir_beg
    while psi<ir_end {
        let pres=irres(psi); if pres>maxvr { maxvr=pres }
        if irop(psi)==IR_STR {
            let sp2=ira0(psi)+1; let ln2=0; let scp2=sp2
            while scp2<srclen&&r8(src+scp2)!=34 {
                ln2=ln2+1; if r8(src+scp2)==92&&scp2+1<srclen { scp2=scp2+2 } else { scp2=scp2+1 }
            }
            let bsz2=8+ln2+1; let pad2=bsz2%16; if pad2>0 { bsz2=bsz2+(16-pad2) }
            total_str=total_str+bsz2
        }
        psi=psi+1
    }
    vreg_n = maxvr + 1
    aclr()
    fclr()
    // RE-MARK float vregs (vfloat was cleared by aclr). i2f(x) yields a float
    // result; follow IR_MOV chains so the float flag reaches the MUL/ADD/SUB
    // operands. Iterate to a fixpoint (multi-level MOV chains). Runs after aclr.
    // ---- global float pre-pass ----
    //
    // Decide which module-level globals hold f64 BEFORE the vreg fixpoint below,
    // because that fixpoint consults gfloat when it tags IR_LOADG destinations.
    // Doing it inside the fixpoint was not enough: on the first sweep the tag for
    // a literal initialised inside a function (`g = 3.0` in main) is not yet known
    // at the point the store is visited, so the global stays untagged and every
    // read of it in the same function is untagged too.
    //
    //   let g = 0.0 ; (in main) g = 3.0 ; g + 1.0   ->  inf    want 4.0
    //
    // Two sources feed gfloat, and both are needed:
    //   1. scan_globals() records it from the DECLARATION's initialiser token
    //      (`let g = 3.0`).
    //   2. this pre-pass records it from any float STORE into the slot
    //      (`g = 3.0` inside a function), because the declaration of a slot that
    //      starts at 0.0 says nothing about what is later written to it.
    //
    // gfloat is only ever set 0 -> 1, never cleared, so a global cannot be
    // un-tagged by a later integer store into the same slot. That is deliberate:
    // an int store into a float global is a type error the caller should not rely
    // on, whereas the reverse -- the common case -- must keep working.
    {
        // Settle the vreg tags first, so `is_float_vr` on a stored value means
        // something. Two bounded rounds are enough: an f64 literal is already
        // tagged by the IR_CALL case below, and an assignment chain in one
        // function is at most one hop deep.
        let gr = 0
        while gr < 2 {
            gr = gr + 1
            let gp = ir_beg
            while gp < ir_end {
                if irop(gp)==IR_FCONST {
                    // An f64 literal IS a float vreg. Dumping the IR for
                    // `g = 3.0` shows op=38 (IR_FCONST) carrying the literal's
                    // bit pattern and writing vreg 0, which the following
                    // IR_STOREG then stores into the global -- so IR_FCONST, not
                    // IR_CALL, is what a literal assigned inside a function
                    // lowers to. The fixpoint below has an IR_FCONST case; this
                    // pre-pass needs one too, or the store is seen before its
                    // value is known to be a float.
                    if r8(vfloat+irres(gp))!=1 { w8(vfloat+irres(gp), 1) }
                }
                else if irop(gp)==IR_CALL {
                    let gnm = ira0(gp)
                    let gf64 = 0
                    if r8(src+gnm)=='i' && r8(src+gnm+1)=='2' && r8(src+gnm+2)=='f' { gf64 = 1 }
                    if r8(src+gnm)=='f' && r8(src+gnm+1)=='c' && r8(src+gnm+2)=='o' { gf64 = 1 }
                    if r8(src+gnm)=='f' && r8(src+gnm+1)=='6' && r8(src+gnm+2)=='4' { gf64 = 1 }
                    if gf64==1 && r8(vfloat+irres(gp))!=1 { w8(vfloat+irres(gp), 1) }
                }
                gp = gp + 1
            }
        }
        let gp = ir_beg
        while gp < ir_end {
            // iremit(IR_STOREG, 0, src_vreg, gvar_index): a0 is the source vreg
            // and a1 is the global index (helpers.quanta).
            if irop(gp)==IR_STOREG {
                let sgv = ira0(gp)
                let sgi = ira1(gp)
                if sgv>=0 && sgi>=0 && sgi<gvarc && is_float_vr(sgv)==1 {
                    w8(gfloat+sgi*8, 1)
                }
            }
            // A global READ of an already-known-float global is itself float, so
            // propagate through `let t = g` chains within this function.
            else if irop(gp)==IR_LOADG {
                let lgv = ira0(gp)
                let lgi = ira1(gp)
                if lgv>=0 && lgi>=0 && lgi<gvarc && r8(gfloat+lgi*8)==1 {
                    if r8(vfloat+lgv)!=1 { w8(vfloat+lgv, 1) }
                }
            }
            else if irop(gp)==IR_MOV {
                if r8(vfloat+ira0(gp))==1 && r8(vfloat+irres(gp))!=1 { w8(vfloat+irres(gp), 1) }
            }
            gp = gp + 1
        }
    }
    {
        let changed=1
        while changed==1 {
            changed=0
            let mp=ir_beg
            while mp<ir_end {
                if irop(mp)==IR_CALL {
                    let mnm = ira0(mp)
                    // A call yields a float result when it is:
                    //   - i2f(x)                     (int -> f64)
                    //   - fconst(M, scale)           (how the parser lowers an f64 literal)
                    //   - f64_load(p)                (the typed float load)
                    //   - a function declared `-> f64` (via fn_retflt)
                    //
                    // The last three are the ones an enclosing operation depends on.
                    // codegen's IR_CALL emit branch applies the fn_retflt tag itself,
                    // but only AS the call is emitted, and emit_bltn asks is_float_vr()
                    // about an operand while emitting the ENCLOSING call. A nested
                    // operand therefore has no tag yet and the float path is silently
                    // skipped:
                    //     fadd(f64_load(p), f64_load(p+8))   -> correct
                    //     fadd(f64_read(p), f64_read(p+8))   -> 1.0 instead of 6.0
                    // where f64_read is `fn f64_read(ptr: i64): f64 { return f64_load(ptr) }`
                    // -- same signature, same body, one extra call layer. Tagging every
                    // call here, before emission, removes the ordering dependency.
                    let mcf = -1
                    let mcn = 0
                    while mcn < 200 && r8(src+mnm+mcn)!=0 && r8(src+mnm+mcn)!=40 && r8(src+mnm+mcn)!=41 && r8(src+mnm+mcn)!=44 { mcn = mcn + 1 }
                    if mcn > 0 { mcf = findfn(mnm, mcn) }
                    let isf64 = 0
                    if r8(src+mnm)=='i' && r8(src+mnm+1)=='2' && r8(src+mnm+2)=='f' { isf64 = 1 }
                    if r8(src+mnm)=='f' && r8(src+mnm+1)=='c' && r8(src+mnm+2)=='o' { isf64 = 1 }
                    if r8(src+mnm)=='f' && r8(src+mnm+1)=='6' && r8(src+mnm+2)=='4' && r8(src+mnm+3)=='_' && r8(src+mnm+4)=='l' && r8(src+mnm+5)=='o' && r8(src+mnm+6)=='a' && r8(src+mnm+7)=='d' { isf64 = 1 }
                    if mcf>=0 && mcf<fnc && r64(fn_retflt + mcf*8)==1 { isf64 = 1 }
                    if isf64==1 {
                        if r8(vfloat+irres(mp))!=1 { w8(vfloat+irres(mp), 1); changed=1 }
                        // ALSO tag the ARGUMENT-LIST entries. emit_bltn reads an
                        // operand as vfloat[irres(ira2(ii)+k)] -- the record at the
                        // call's argument-list pointer -- which is NOT the same vreg
                        // as the call's own result. Tagging only the result left
                        // vfloat[arg0] == 0 when the enclosing fadd asked for it.
                        // Measured directly, encoding (is_float_vr(arg0),
                        // is_float_vr(arg1), vfloat[arg0], vfloat[arg1)) as digits:
                        //   fadd(1.0, 2.0)          -> 1111
                        //   fadd(f64_load(p), 1.0)  -> 1111
                        //   fadd(gg5(p), 1.0)       -> 0110   <- arg0 untagged
                        // where `fn gg5(q: i64): f64 { return mem_load(q) }` is a plain
                        // declared-f64 function. The arg entries were the gap.
                        let avp = ira2(mp)
                        if isf64==1 && avp>=0 && avp<ir_end {
                            let ak = 0
                            let an = ira1(mp)
                            while ak < an && avp+ak < ir_end {
                                let avr = irres(avp+ak)
                                if avr>=0 && r8(vfloat+avr)!=1 { w8(vfloat+avr, 1); changed=1 }
                                ak = ak + 1
                            }
                        }
                    }
                } else if irop(mp)==IR_LOADG {
                    // Reading a float module-level global yields an f64 bit
                    // pattern, so the destination vreg is a float. IR_LOADG was
                    // missing from this prepass entirely -- see gfloat in
                    // globals.quanta. This is the fix for `g + 1.0` returning
                    // inf, and for pow/log/fadd reading global operands wrongly.
                    let lgv = ira0(mp)
                    let lgi = ira1(mp)
                    if lgv>=0 && lgi>=0 && lgi<gvarc && r8(gfloat+lgi*8)==1 {
                        if r8(vfloat+lgv)!=1 { w8(vfloat+lgv, 1); changed=1 }
                    }
                } else if irop(mp)==IR_ISTORE {
                    // iremit(IR_ISTORE, 0, base, index, value): a0 = array, a2 = value.
                    let xa = ira0(mp)
                    let xv = ira2(mp)
                    if xa>=0 && xv>=0 && is_float_vr(xv)==1 && r64(vreg_farr+xa*8)!=1 {
                        w64(vreg_farr+xa*8, 1); changed=1
                    }
                } else if irop(mp)==IR_MOV {
                    if r8(vfloat+ira0(mp))==1 && r8(vfloat+irres(mp))!=1 { w8(vfloat+irres(mp), 1); changed=1 }
                    // Copy the float-ARRAY property along with the value. An array
                    // literal's base vreg and the vreg a load reads through are
                    // usually NOT the same: probed on `let arr = [3.0, 4.0]`, the
                    // IR_ISTORE recorded the array at vreg 2 while IR_IDX read its
                    // base from vreg 5, so the table never matched and the element
                    // stayed untagged. Same shape as the vreg_is_str propagation
                    // beside it.
                    if ira0(mp)>=0 && irres(mp)>=0 && r64(vreg_farr+ira0(mp)*8)==1 && r64(vreg_farr+irres(mp)*8)!=1 {
                        w64(vreg_farr+irres(mp)*8, 1); changed=1
                    }
                } else if irop(mp)==IR_RET {
                    // A `-> f64` function RETURNS a float, whatever its body happened
                    // to compute. Tag the vreg it returns.
                    //
                    // Without this the tag depended on the body's own source: a
                    // function returning a literal, an f64 parameter or i2f(x) was
                    // already tagged at the definition site and worked, while one
                    // returning `f64_load(p)` or `mem_load(p)` was not, and the
                    // caller's fadd took the integer path over the bit patterns.
                    // Measured on the same signature: literal body passes, load body
                    // does not. Declared type is the right source of truth.
                    if ira0(mp)>=0 && r64(fn_retflt + fi*8)==1 {
                        if r8(vfloat+ira0(mp))!=1 { w8(vfloat+ira0(mp), 1); changed=1 }
                    }
                } else if irop(mp)==IR_PARAM {
                    // A parameter declared `: f64` is a float vreg. This has to
                    // happen HERE, after aclr() has zeroed vfloat -- tagging at
                    // parse time is wiped before the emit pass runs.
                    //
                    // It was missing entirely, and the failure was quiet: + - * on a
                    // float parameter reached their SSE path only because the
                    // integer path happened to agree on the values first tried,
                    // while / fell through to the integer idiv and raised SIGFPE on
                    // the float bit patterns. Float LOCALS were always tagged, via
                    // the IR_FCONST that produced them, so `let a: f64 = 10.0;
                    // a / 2.0` worked and `fn f(a: f64) -> f64 { a / 2.0 }` did not.
                    // That asymmetry is what hid it.
                    let ppi = ira0(mp)
                    if r64(fn_parflt + (fi*200 + ppi)*8)==1 {
                        if r8(vfloat+irres(mp))!=1 { w8(vfloat+irres(mp), 1); changed=1 }
                    }
                } else if irop(mp)==IR_FCONST {
                    // An f64 literal IS a float vreg. IR_FCONST's own definition
                    // says "result vreg tagged float" but nothing here did it.
                    if r8(vfloat+irres(mp))!=1 { w8(vfloat+irres(mp), 1); changed=1 }
                } else if irop(mp)==IR_CALL {
                    // The parser lowers EVERY f64 literal (TT_FNUM) to an IR_CALL
                    // named "fconst" -- IR_FCONST is never emitted (see the note at
                    // the fold pass above). The fold pass did tag these, but aclr()
                    // zeroes vfloat for every vreg afterwards, so that tag was gone
                    // by the time the emit pass ran.
                    //
                    // That left `let r = 6.0` as an UNTAGGED vreg, and every
                    // arithmetic op whose floatness depended on it fell through to
                    // the integer path:
                    //
                    //     let r = 6.0
                    //     r / 2.0 -> 6.000000   (a1 inline literal is itself tagged)
                    //     r / 2   -> 0.000000   (a1 int vreg, vfloat[r]==0)
                    //     r + 2   -> hangs       (integer path, corrupt widths)
                    //
                    // The tell was that a FLOAT in a1 rescued the same expression:
                    // the float had to reach the op tagged, and `r` alone never was.
                    // The integer path ran on raw IEEE-754 bit patterns -- 6.0 is
                    // 4613937818241073152, and idiv by 2 leaves a denormal that
                    // prints as 0.000000.
                    let cnm = ira0(mp)
                    let is_fc = 0
                    if r8(src+cnm)=='f' && r8(src+cnm+1)=='c' && r8(src+cnm+2)=='o' { is_fc=1 }
                    if is_fc==0 && r8(src+cnm)=='i' && r8(src+cnm+1)=='2' && r8(src+cnm+2)=='f' { is_fc=1 }
                    if is_fc==1 {
                        if r8(vfloat+irres(mp))!=1 { w8(vfloat+irres(mp), 1); changed=1 }
                    }
                } else if irop(mp)==IR_MUL || irop(mp)==IR_ADD || irop(mp)==IR_SUB || irop(mp)==IR_FDIV {
                    // NOTE: an UNTYPED parameter used as a float (`fn f(a, b) { a*b }`)
                    // is not recoverable from the IR body alone. IR_PARAM's result
                    // vreg belongs to the CALLEE's vreg space and the caller's float
                    // vreg belongs to a different space, so no IR_MOV chain connects
                    // them -- the callee simply cannot see what was passed. `a * b`
                    // then took the integer imul path on the bit patterns, overflowed,
                    // and the emitted jno trap fired as SIGILL (exit 132).
                    //
                    // This block used to paper over that by propagating floatness from
                    // one operand to the other within the arithmetic op:
                    //
                    //     if vfloat+ira0==1 && vfloat+ira1!=1 { w8(vfloat+ira1,1) }
                    //
                    // That inference is UNSOUND and has been removed. It cannot
                    // distinguish "untyped parameter that received a float" from
                    // "genuine integer operand", so it tagged integer operands as
                    // float:
                    //
                    //     fn h(a,b){ return a*b }   h(2, 1.0)
                    //
                    // a0=a holds the integer 2 and is NOT tagged by any legitimate
                    // rule, but ira1 (b) is tagged, so the rule tagged a0 as float
                    // too. fopld then moved the raw integer 2 -- not its f64 value --
                    // into xmm0 as 0x0000000000000002, i.e. 1e-323, and the product
                    // came out 0.0 instead of 2.0. Every mixed float/int expression
                    // in the stdlib was corrupted by this rule.
                    //
                    // The correct source is the CALL SITE: scan_call_float() marks a
                    // parameter's fn_parflt bit from a float literal argument before
                    // codegen runs, and the IR_PARAM branch above turns that into a
                    // vfloat tag. An operand that is not tagged is genuinely an
                    // integer and is converted with cvtsi2sd by fopld. Nothing needs
                    // to guess.
                }
                mp=mp+1
            }
        }
    }
    // Prologue
    // Discard the fixpoint's float tags and re-derive only the two cases that
    // come from a type TABLE rather than from a record scan: a parameter declared
    // `: f64` (fn_parflt) and a call to a function declared `-> f64` (fn_retflt).
    //
    // Why discard the rest. The fixpoint above walks records and follows IR_MOV
    // chains, but on the source path ci_func scans 0..irc -- every function's
    // records live in one buffer and vreg numbering RESTARTS per function, so a
    // record in another function naming vreg 0 is indistinguishable from this
    // function's own vreg 0. A module-level float initialiser is compiled as its
    // own pseudo-function (entry.quanta, ci_func(0,0)) and lowers to IR_CALL
    // fconst writing vreg 0, which is also the first parameter's vreg:
    //
    //     let G = 2.0
    //     fn t(n: i64) -> i64 { let s = G  return n + 1 }
    //     t(20) -> 1.0's bit pattern   (want 21)
    //
    // fopld_rr then bit-moved n instead of converting it -- measured in the
    // emitted code as `movq %rbx,%xmm0` where `cvtsi2sd %rbx,%xmm0` was required.
    // 20 became 1e-322 and 1e-322 + 1.0 rounds to exactly 1.0.
    //
    // Nothing is lost: every float PRODUCER re-tables its own result as it is
    // EMITTED (IR_LOADG from gfloat, IR_FCONST, IR_NEG, and the arithmetic
    // branches all write w8(vfloat+res, 1)), so an f64 literal's vreg is re-tagged
    // from its own record during emit.
    {
        let z=0
        let zhi=vreg_n
        if vreg_high>zhi { zhi=vreg_high }
        while z<zhi+8 { w8(vfloat+z,0); z=z+1 }
        let tb=ir_beg
        while tb<ir_end {
            let top=irop(tb); let tres=irres(tb); let ta0=ira0(tb)
            if tres>=0 {
                if top==IR_PARAM && ta0>=0 && r64(fn_parflt + (fi*200 + ta0)*8)==1 { w8(vfloat+tres,1) }
                // 0.0.248: the same two table-driven cases for the f32/f16 FLOAT
                // TYPE. vreg_ftype is not cleared by aclr(), but this pass must
                // still cover a parameter and a call result, because those are the
                // declarations whose tags come from a TABLE rather than from the
                // record's own opcode.
                if top==IR_PARAM && ta0>=0 {
                    let tpft = r64(fn_parft + (fi*200 + ta0)*8)
                    if tpft != 0 { w64(vreg_ftype+tres*8, tpft) }
                }
                if top==IR_CALL {
                    let tl=0
                    while tl<200 && r8(src+ta0+tl)!=0 && r8(src+ta0+tl)!=40 && r8(src+ta0+tl)!=41 && r8(src+ta0+tl)!=44 { tl=tl+1 }
                    let tcf=-1
                    if tl>0 { tcf=findfn(ta0,tl) }
                    if tcf>=0 && tcf<fnc && r64(fn_retflt + tcf*8)==1 { w8(vfloat+tres,1) }
                    if tcf>=0 && tcf<fnc {
                        let trft = r64(fn_retft + tcf*8)
                        if trft != 0 { w64(vreg_ftype+tres*8, trft); w8(vfloat+tres,1) }
                    }
                }
            }
            tb=tb+1
        }
    }
    // 0.0.229 Phase B (B3): naked functions.
    //
    // `naked fn` means the body is hand-written machine code (via asm!) that
    // performs its own prologue/epilogue. The compiler emits NOTHING around it:
    // no push rbp, no saved registers, no frame allocation, and IR_RET becomes a
    // bare `ret` (the body moves its own return value into rax).
    //
    // FAIL CLOSED, per the plan: without a frame there are no spill slots, no
    // string buffers, and no parameter homes, so a naked body that would use any
    // of them is silent corruption. The only sound body is asm! (plus constants
    // the asm inlines itself) and the final return. Anything else — parameters,
    // calls, loads, arithmetic — is a compile error, not a fallback.
    let naked = r64(fn_naked + fi*8)
    if naked == 1 {
        // Parameters would need register homes in a frame that does not exist.
        if r64(fn_pcount + fi*8) > 0 {
            let mn = "error: naked fn cannot have parameters (no frame to home them)\n"
            file_write(2, mn+8, len(mn)); exit(1)
        }
        // Walk this function's IR: only IR_ASM and IR_RET are sound. IR_CONST is
        // deliberately NOT allowed: its result lands in a register the naked body
        // does not control, and the spill machinery that would save it is absent.
        let nb = ir_beg
        while nb < ir_end {
            let nop = irop(nb)
            if nop != IR_ASM && nop != IR_RET {
                let mn = "error: naked fn body may contain only asm! and return (no frame exists for spills/calls)\n"
                file_write(2, mn+8, len(mn)); exit(1)
            }
            nb = nb + 1
        }
    }
    if naked != 1 { xpush(5); rr(5,4) }
    // FIX-0.0.7: mark frame context. Every ci_func body has the push-rbp
    // prologue above, so [rbp+8] is a valid caller return address for any
    // builtin emitted below (stack_trace relies on this).
    g_in_frame = 1
    if naked != 1 { let mi=0; while mi<5 { xpush(r64(mather_saved+mi*8)); mi=mi+1 } }  // push RBX,R12-R15
    // Dynamic frame size based on max vreg count - ensure enough space for spill slots
    let spill_region = 48 + vreg_n * 8
    let frame_size = spill_region + total_str + 80
    // Minimum spill region to handle register pressure (like Python compiler).
    // NOTE: keep this SMALL. A huge floor (16384) inflated every trivial
    // function's frame to 16KB, which underflows the stack on low-ASLR-base
    // processes (kernel derives the stack base from a per-binary hash; small
    // binaries like t3.bin deterministically land ~16KB above the mapping
    // bottom, so sub rsp,0x4050 + a try-push's sub rsp,0x28 drops below the
    // guard page -> SIGSEGV). spill_region is already sized from vreg_n above,
    // so the floor only needs to cover register pressure for tiny functions.
    let min_spill = 1024
    if spill_region < min_spill { spill_region = min_spill; frame_size = spill_region + total_str + 80 }
    // Variadic functions: reserve a frame-local va area at the bottom of the
    // frame so nested variadic calls don't clobber each other. Layout (from the
    // lowest address upward): va_cnt (8 bytes) then va_reg[0..5] (48 bytes).
    let isvar = r64(fn_var + fi*8)
    if isvar==1 {
        frame_size = frame_size + 64   // va_cnt(8) + 6 regs(48) = 56, round to 64
        let rem2 = frame_size % 16
        if rem2 > 0 { frame_size = frame_size + (16 - rem2) }
    }
    let rem = frame_size % 16
    if rem > 0 { frame_size = frame_size + (16 - rem) }
    // Single frame allocation: spill slots + string buffers + 80-byte save area.
    if naked != 1 { sbi(frame_size) }  // sub rsp, frame_size (matches the single "add rsp, frame_size" epilogue); a naked fn has no frame
    // 0.0.121 BY-REF: if this is a closure body, the incoming env pointer (r10)
    // is clobberable. Save it into the bottom of the frame so CAPREAD/CAPWRITE
    // can reload it. frame_size is final here (== the reload's -(frame_size)).
    let ncaps = r64(cap_count + fi*8)
    if ncaps > 0 && naked != 1 {
        rr(11, 5)                          // r11 = rbp
        wbase(-(frame_size), 10)           // [r11 - frame_size] = r10 (env)
    }
    // Save rax to its spill-home slot. Use rbp-relative (in-frame) addressing,
    // NOT [rsp-0x50]: [rsp-0x50] lands BELOW rsp (red zone) and faults when the
    // stack base is low (ASLR-hash-seeded). [rbp-0x50] is inside the allocated
    // frame and is also how spill homes are read back (wbp/rbp convention).
    if naked != 1 { let csi = 80; wbp(csi * -1, 0) }
    // Variadic prologue: snapshot arg count (r10) and the first 6 register args
    // (rdi,rsi,rdx,rcx,r8,r9) into the frame-local va area. Stack args (i>=6)
    // remain on the stack at [rbp+16+...] and are read directly by arg().
    // We use r11 as the frame base (mov r11,rbp) so all stores avoid the
    // REX.B/rbp encoding conflict for extended destination registers.
    if isvar==1 && naked != 1 {
        g_va_cnt_off = -frame_size + 8               // [r11 + g_va_cnt_off]
        g_va_reg_off = -frame_size + 16              // va_reg[0] at [r11 + g_va_reg_off]
        rr(11, 5)                        // r11 = rbp
        wbase(g_va_cnt_off, 10)          // [r11 + g_va_cnt_off] = r10 (arg_cnt)
        wbase(g_va_reg_off + 0,  7)      // va_reg[0] = rdi
        wbase(g_va_reg_off + 8,  6)      // va_reg[1] = rsi
        wbase(g_va_reg_off + 16, 2)      // va_reg[2] = rdx
        wbase(g_va_reg_off + 24, 1)      // va_reg[3] = rcx
        wbase(g_va_reg_off + 32, 8)      // va_reg[4] = r8
        wbase(g_va_reg_off + 40, 9)      // va_reg[5] = r9
    }

    let str_off = -(frame_size - total_str)  // string buffer offset from frame base (below spill)
    let early_ret_lbl = -1   // P7: lazy epilogue label; IR_TRY jumps here on Err/None
    let r1=0; let ii=ir_beg
  let loop_depth = 0
  let loop_pinned = 0
    // A4: publish the next-use context for this function before any emission.
    // a4_at is -1 outside the loop below, which makes afree() fall back to LIFO.
    a4_end = ir_end
    a4_at = 0 - 1
    // F2 (0.0.250): compute this function's block liveness so flush_all() can skip
    // the block-boundary home stores whose value no later code reads. Only the
    // source path: a cached function's IR_CALL argument lists are re-based by the
    // module loader, and a wrong read set there would shrink a live set. Anything
    // f2_analyze() cannot model leaves f2_ok = 0, i.e. 0.0.249 behaviour.
    f2_ok = 0
    f2_at = 0 - 1
    if is_cache == 0 { f2_analyze(ir_beg, ir_end, maxvr) }
    while ii<ir_end {
        a4_at = ii
        f2_at = ii
        let op=irop(ii); let res=irres(ii); let a0=ira0(ii); let a1=ira1(ii); let a2=ira2(ii)
        if op==IR_CONST { let rd=aphys(res); if a0<0||a0>4294967295 { ri64(rd,a0) } else { ri(rd,a0) }; sdef(res, rd) }
        else if op==IR_FCONST {
            // An f64 LITERAL, already rounded exactly once at parse time by
            // fl_dexp2f64. a0 IS the IEEE-754 bit pattern, so this is the same
            // 64-bit materialisation IR_CONST does -- the float-ness is carried
            // by the opcode, which is why no side table is needed.
            //
            // This replaced an IR_CALL named "fconst" that rebuilt the value at
            // RUN time with cvtsi2sd/divsd/mulsd. Every one of those rounds, and
            // the errors compounded: 24 of 41 test literals came out 1-3 ULP
            // wrong, and 1.0e308 came out one bit HIGH. That single corrupt
            // constant is what made gguf_exp's overflow guard return a stack
            // address instead of a float.
            let rd=aphys(res); ri64(rd,a0); sdef(res, rd); w8(vfloat+res, 1)
        }
        // IR_MOV propagates the float tag but NOT the string tag, so
        // `let x = lit()` dropped `x`'s stringness even though lit() returned a
        // string. Every `let s = <string expr>` then fell back to the integer
        // print path and emitted the string header's low bytes. Propagate
        // vreg_is_str alongside vfloat; nv() has already reset res to -1, so
        // only a tagged source vreg clears it.
        else if op==IR_MOV { let rd=aphys(res); let rs=aphys(a0); if rd!=rs { rr(rd,rs) }; sdef(res, rd); w8(vfloat+res, r8(vfloat+a0)); w64(vreg_is_str+res*8, r64(vreg_is_str+a0*8)) }

        else if op==IR_ADD {
            // EITHER operand float -> SSE. This used to require BOTH to be float,
            // so `1.0 + 2` fell through to the integer add and added the raw bit
            // patterns (3.0 -> 1.0). An integer operand is converted with
            // cvtsi2sd by fopld; only if NEITHER is float is this integer add.
            if r8(vfloat+a0)==1 || r8(vfloat+a1)==1 {
                let r1=aphys(a0); let r2=aphys(a1)
            fopld_rr(a0, r1, 0, r1, r2); fopld_rr(a1, r2, 1, r1, r2)
                    let rd=adistinct(res,r1,r2)
                eb(242); eb(15); eb(88); eb(193)      // addsd xmm0, xmm1 (inline)
                fst_x(rd, 0)
                sdef(res, rd); w8(vfloat+res, 1)
            } else {
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; ra(rd,r2); if loop_depth == 0 { ovf_trap_emit(ii) }; sdef(res, rd); width_mask(a0, a1, rd) }
        }
        else if op==IR_SUB {
            // EITHER operand float, same as IR_ADD -- see the note there.
            if r8(vfloat+a0)==1 || r8(vfloat+a1)==1 {
                let r1=aphys(a0); let r2=aphys(a1)
                    fopld_rr(a0, r1, 0, r1, r2); fopld_rr(a1, r2, 1, r1, r2)
                    let rd=adistinct(res,r1,r2)
                eb(242); eb(15); eb(92); eb(193)       // subsd xmm0, xmm1 (inline; fsub is reserved)
                fst_x(rd, 0)
                sdef(res, rd); w8(vfloat+res, 1)
            } else {
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; rs(rd,r2); if loop_depth == 0 { ovf_trap_emit(ii) }; sdef(res, rd); width_mask(a0, a1, rd) }
        }
        else if op==IR_MUL {
            // EITHER operand float -> SSE. This required BOTH operands to be float,
            // so every mixed float*int product took the integer imul path and
            // multiplied the raw bit-patterns: `1.0 * 2` returned 0.0, and the whole
            // gguf_exp Taylor series (`term * r / i`) was dead. An integer operand
            // is converted with cvtsi2sd by fopld.
            if r8(vfloat+a0)==1 || r8(vfloat+a1)==1 {
                let r1=aphys(a0); let r2=aphys(a1)
