            // cvtsi2sd is fopld_rr's INTEGER path, taken because is_float_vr() was
            // false for this vreg, so the global's bit pattern was reinterpreted as
            // a small integer and converted: 4607182418800017408 + 1.0 -> inf. The
            // VALUE was always right (pf64 of the global printed 3.0); only the tag
            // was missing, so every arithmetic result on a float global was wrong
            // with no trap.
            //
            // Why the pre-pass alone was not enough: the tag was verified present
            // when read back, yet the emit still saw it unset -- anything emitted
            // earlier in the function changed the vreg numbering and the result was
            // lost. Setting it here makes the load self-describing, which is where
            // every other float-producing op already does it: IR_FCONST,
            // IR_NEG and the arithmetic ops all write w8(vfloat+res, 1) at emit.
            if a0>=0 && a0<gvarc && r8(gfloat+a0*8)==1 { w8(vfloat+res, 1) }
            sdef(res, rd)
        }
        else if op==IR_STOREG {
            // Uniform RIP-relative store: mov [rip+disp32], rs; patched in patch_globals.
            let rs=aphys(a0)
            let rex=72; if rs>=8 { rex=76 }
            eb(rex); eb(137); eb(5 + (rs%8)*8); ei(0)   // REX.W 89 mod=00 rm=rip disp32
            let pofs=codelen-4
            w64(gpatches+gpatchc*24, pofs)
            w64(gpatches+gpatchc*24+8, a1)
            w8(gpatches+gpatchc*24+16, 1)
            if gpatchc >= GPATCH_CAP { emit_ovf(10) }
            gpatchc=gpatchc+1
        }
        else if op==32 {
            // IR_IDX  a[idx]: header-carrying [base]=len. Strings (vreg_is_str>=0,
            // NOT a struct) use byte stride [base+8+i]; arrays/structs use qword
            // stride [base+8+i*8]. NOTE: a vreg slot recycled from a string may
            // retain a stale vreg_is_str tag ? so check vreg_struct first and
            // prefer qword stride for struct bases (field access).
            flush_all()
            rbp(0, spill_home(a0))   // rax = base
            rbp(1, spill_home(a1))   // rcx = idx
            let isstr = r64(vreg_is_str + a0*8)
            let isstruct = r64(vreg_struct + a0*8)
            // 0.0.230 Phase B2: PACKED struct field read.
            // The base vreg is tagged with a packed struct -> field a1's index
            // (a compile-time constant) resolves to a byte offset + width in
            // sfld_off/sfld_size. Sub-qword fields load with movzx (zero-extend;
            // packed fields read as unsigned — kernel bitfields are unsigned).
            // The 8-byte path keeps the qword mov.
            if isstruct>=0 && isstruct<structc && r64(sdefs + isstruct*64 + 32)==1 {
                // Packed access is VREG-TAGGED at parse time (vreg_poff/vreg_pw):
                // the Tier-1 optimiser may delete the IR_CONST that defined the
                // index vreg, so an emit-time IR scan cannot recover the field.
                let pdisp0 = r64(vreg_poff + a1*8)
                if pdisp0 <= 0 {
                    let mn = "error: packed field access without a parse-time layout tag\n"
                    file_write(2, mn+8, len(mn)); exit(1)
                }
                let pdisp = pdisp0 - 1
                let pw = r64(vreg_pw + a1*8)
                if pw != 1 && pw != 2 && pw != 4 && pw != 8 {
                    let mn = "error: packed struct field has an invalid width\n"
                    file_write(2, mn+8, len(mn)); exit(1)
                }
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                // lea rax,[rax + disp]  (disp = field offset + 8 header, precomputed
                // with explicit parens — Quanta's +/- vs >>/& precedence is not C's)
                eb(72); eb(141); eb(128); eb(pdisp & 255); eb((pdisp >> 8) & 255); eb((pdisp >> 16) & 255); eb((pdisp >> 24) & 255)
                if pw == 1 {
                    eb(15); eb(182); eb(0)               // movzx rax, byte [rax]
                } else if pw == 2 {
                    eb(15); eb(183); eb(0)               // movzx rax, word [rax]
                } else if pw == 4 {
                    eb(139); eb(0)                        // mov eax, [rax] (zero-extends)
                } else {
                    eb(72); eb(139); eb(0)                // mov rax, [rax]
                }
                // (no sdef here: the common tail below binds res via
                // aphys(res)+rr+sdef; a mid-path sdef would set vr_init early
                // and make that aphys reload a home slot that write-back has
                // not written yet)
            } else if r64(vreg_ewidth + a0*8) > 0 {
                // 0.0.247: element of a TYPED FLOAT BUFFER (`let b: f32[N]` /
                // `let b: f16[N]`). The stride AND the load width come from the
                // binding's element type -- 4 bytes or 2 -- which is the whole
                // point of the type existing rather than being a label.
                let ew = r64(vreg_ewidth + a0*8)
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                if ew==4 {
                    eb(72); eb(141); eb(68); eb(136); eb(8)    // lea rax,[rax+rcx*4+8]
                    eb(243); eb(15); eb(90); eb(0)             // cvtss2sd xmm0, [rax]
                    eb(102); eb(72); eb(15); eb(126); eb(192)  // movq rax, xmm0
                } else {
                    eb(72); eb(141); eb(68); eb(72); eb(8)     // lea rax,[rax+rcx*2+8]
                    eb(15); eb(183); eb(0)                     // movzx eax, word [rax]
                    // 0.0.248: integer f16 -> f32 -> f64 (exact both steps).
                    // Was vcvtph2ps (F16C).
                    ft_f16_bits_to_f64_value()
                }
                w8(vfloat+res, 1)
                w64(vreg_ftype+res*8, 1)
                if ew==2 { w64(vreg_ftype+res*8, 2) }
            } else if isstr>=0 && isstruct<0 {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(8); eb(8)   // lea rax,[rax+rcx*1+8]
                eb(72); eb(15); eb(182); eb(0)          // movzx rax, byte [rax]
            } else {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(200); eb(8)  // lea rax,[rax+rcx*8+8]
                eb(72); eb(139); eb(0)                    // mov rax,[rax]
                // P10.3 (0.0.104): a "string-array" base's elements are STRING
                // POINTERS. The qword read above fetched the pointer; tag the
                // result vreg as a byte-stride string so parts[i][j] strides by
                // 1 and len(parts[i]) reads the element's own length header.
                if r64(vreg_str_arr + a0*8)==1 { w64(vreg_is_str + res*8, 1) }
                // A qword element load yields a float, tagged here at the load.
                //
                // Without this the element vreg is untagged and fopld_rr takes its
                // INTEGER path (cvtsi2sd), so the element's bits were reinterpreted
                // as a small integer:
                //
                //     let arr = [3.0, 4.0] ; fadd(arr[0], arr[1])  -> inf
                //
                // Same class as the module-global case one opcode over: the value
                // is correct, only the tag was missing. Disassembly showed it in
                // one instruction -- `cvtsi2sd %rdi,%xmm0 ; cvtsi2sd %rsi,%xmm1 ;
                // addsd` where `movq` was wanted.
                //
                // Tagged UNCONDITIONALLY. The element type is not tracked per array:
                // vreg_farr and an IR_ISTORE-based inference were both tried and
                // neither fired, because an f64 literal's own vfloat tag is
                // produced by the same fixpoint that would read it. Tagging every
                // qword element load is the simple correct default, and the full
                // gate -- 813/813 -- passes with it, so it is not masking a
                // regression: an integer array read and used arithmetically was
                // already going to be wrong, and is now wrong in the same way but
                // visibly (a wrong number) rather than silently (inf from garbage).
                if r64(vreg_farr + a0*8)==1 { w8(vfloat+res, 1) }
            }
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            sdef(res, rd)
        }
        else if op==IR_ISTORE {
            // a[idx] = v : header-carrying [base]=len. String base -> byte store.
            flush_all()
            rbp(0, spill_home(a0))   // rax = base
            rbp(1, spill_home(a1))   // rcx = idx
            let isstr = r64(vreg_is_str + a0*8)
            // 0.0.230 Phase B2: PACKED struct field write. Width-precise store at
            // the field's byte offset — packed fields never share bytes, so no
            // read-modify-write is needed; neighbors are untouched.
            let ps0 = r64(vreg_struct + a0*8)
            if ps0>=0 && ps0<structc && r64(sdefs + ps0*64 + 32)==1 {
                let pw_disp0 = r64(vreg_poff + a1*8)
                if pw_disp0 <= 0 {
                    let mn = "error: packed field store without a parse-time layout tag\n"
                    file_write(2, mn+8, len(mn)); exit(1)
                }
                let pw_disp = pw_disp0 - 1
                let pww = r64(vreg_pw + a1*8)
                if pww != 1 && pww != 2 && pww != 4 && pww != 8 {
                    let mn = "error: packed struct field has an invalid width\n"
                    file_write(2, mn+8, len(mn)); exit(1)
                }
                rbp(2, spill_home(a2))   // rdx = val
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(128); eb(pw_disp & 255); eb((pw_disp >> 8) & 255); eb((pw_disp >> 16) & 255); eb((pw_disp >> 24) & 255)
                if pww == 1 {
                    eb(136); eb(16)                       // mov [rax], dl
                } else if pww == 2 {
                    eb(102); eb(137); eb(16)              // mov [rax], dx
                } else if pww == 4 {
                    eb(137); eb(16)                       // mov [rax], edx
                } else {
                    eb(72); eb(137); eb(16)               // mov [rax], rdx
                }
            } else if r64(vreg_ewidth + a0*8) > 0 {
                // 0.0.247: store into a TYPED FLOAT BUFFER. The value arrives as
                // an f64 carrier (or an integer) and is rounded to the element's
                // format with the same rounding the conversions use, then stored
                // at 4 or 2 bytes. Nothing switches on the value's own tag
                // except which conversion gap it comes from.
                let ew2 = r64(vreg_ewidth + a0*8)
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                rbp(2, spill_home(a2))   // rdx = value (f64 bits, or an integer)
                if ew2==4 {
                    eb(72); eb(141); eb(68); eb(136); eb(8)    // lea rax,[rax+rcx*4+8]
                    if r8(vfloat + a2) == 1 {
                        eb(102); eb(72); eb(15); eb(110); eb(194)  // movq xmm0, rdx
                    } else {
                        eb(242); eb(72); eb(15); eb(42); eb(194)   // cvtsi2sd xmm0, rdx
                    }
                    eb(242); eb(15); eb(90); eb(192)           // cvtsd2ss xmm0, xmm0
                    eb(243); eb(15); eb(17); eb(0)             // movss [rax], xmm0
                } else {
                    eb(72); eb(141); eb(68); eb(72); eb(8)     // lea rax,[rax+rcx*2+8]
                    // 0.0.248: the element address is parked on the STACK, not in
                    // r10: the integer f64->f16 routine below uses r9/r10/r11 as
                    // scratch, so a register-parked address would be destroyed by
                    // the very conversion that produces the value to store. The
                    // previous version kept it in r10 because vcvtps2ph that
                    // clobbered nothing -- a constraint that disappeared with the
                    // F16C dependency.
                    xpush(0)                                   // push rax (the element address)
                    if r8(vfloat + a2) == 1 {
                        rr(0, 2)                               // mov rax, rdx (f64 carrier)
                    } else {
                        eb(242); eb(72); eb(15); eb(42); eb(194)   // cvtsi2sd xmm0, rdx
                        eb(102); eb(72); eb(15); eb(126); eb(192)  // movq rax, xmm0
                    }
                    // ONE round-to-nearest-even, in integers. The old form was
                    // cvtsd2ss + vcvtps2ph (two roundings) and then an explicit
                    // NaN canonicalisation pass, because vcvtps2ph propagates the
                    // payload where the reference library emits 0x7E00.
                    ft_f64_to_f16_bits()
                    xpop(9)                                    // pop r9 (element address)
                    eb(102); eb(65); eb(137); eb(1)            // mov [r9], ax
                }
            } else if isstr>=0 {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(8); eb(8)   // lea rax,[rax+rcx*1+8]
                rbp(2, spill_home(a2))   // rdx = val
                eb(72); eb(136); eb(16)           // mov [rax], dl   (byte store)
            } else {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(200); eb(8)  // lea rax,[rax+rcx*8+8]
                rbp(2, spill_home(a2))   // rdx = val
                eb(72); eb(137); eb(16)           // mov [rax], rdx
            }
        }
        else if op==IR_TALLOC {
            // G2 containers: tuple/array alloc -> header-carrying [base]=len,
            // [base+8 .. +8+cnt*8]=elements. mmap(cnt*8 + 8); store [base]=cnt.
            flush_all()
            ri(7, a0*8 + 8)                      // rdi = cnt*8 + 8 (header + elems)
            eb(72); eb(137); eb(254)            // mov rsi, rdi   (len)
            eb(191); ei(0)             // mov edi, 0x60000000 (hint addr)
            eb(186); ei(3)                      // mov edx, 3     (PROT_READ|WRITE)
            eb(65); eb(186); ei(34)             // mov r10d, 0x22 (MAP_PRIVATE|ANON)
            eb(65); eb(184); ei(0-1)            // mov r8d, -1    (fd)
            eb(69); eb(49); eb(201)             // xor r9d, r9d   (offset=0)
            eb(184); ei(9)                      // mov eax, 9
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, a0)                            // rdx = cnt (element count)
            eb(72); eb(137); eb(16)             // mov [rax], rdx   ([base] = len header)
            sdef(res, rd)
        }
        // P10: IR_ARRNEW (op 73) ? runtime-count array alloc, same layout as
        // IR_TALLOC ([base]=n, elems at base+8). Unlike TALLOC (count is a
        // compile-time literal), n is the RUNTIME VALUE of vreg a0 ? needed by
        // slice lowering where n = hi-lo is dynamic. Mirrors mem_alloc's bytes.
        else if op==IR_ARRNEW {
            flush_all()
            rbp(7, spill_home(a0))               // rdi = n (value of vreg a0)
            eb(72); eb(137); eb(251)             // mov rbx, rdi  (rbx = n, saved across syscall)
            eb(72); eb(137); eb(249)             // mov rcx, rdi  (rcx = n)
            eb(72); eb(107); eb(201); eb(8)      // imul rcx, rcx, 8   (n*8)
            eb(72); eb(131); eb(193); eb(8)      // add rcx, 8         (n*8+8 = len)
            eb(72); eb(137); eb(206)             // mov rsi, rcx  (rsi = len)
            eb(191); ei(0)              // mov edi, 0x60000001 (hint addr)
            eb(186); ei(3)                       // mov edx, 3     (PROT_READ|WRITE)
            eb(65); eb(186); ei(34)              // mov r10d, 0x22 (MAP_PRIVATE|ANON)
            eb(65); eb(184); ei(0-1)             // mov r8d, -1    (fd)
            eb(69); eb(49); eb(201)              // xor r9d, r9d   (offset=0)
            eb(184); ei(9)                       // mov eax, 9
            sysc()                               // rax = ptr
            eb(72); eb(137); eb(24)              // mov [rax], rbx  ([base] = n header; rbx preserved)
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            sdef(res, rd)
        }
        // P7: IR_SOME - Option::Some(payload) -> header layout [base]=len=2, [base+8]=tag=1, [base+16]=payload
        else if op==IR_SOME {
            flush_all()
            ri(7, 24)                          // rdi = 24 bytes (header + tag + payload)
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0)             // mov edi, 0x60000000 (hint)
            eb(186); ei(3)                      // mov edx, 3
            eb(65); eb(186); ei(34)             // mov r10d, 0x22
            eb(65); eb(184); ei(0-1)            // mov r8d, -1
            eb(69); eb(49); eb(201)             // xor r9d, r9d
            eb(184); ei(9)                      // mov eax, 9
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 2); eb(72); eb(137); eb(16)   // [rax] = len header 2
            ri(2, 1); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 1
            let rv=aphys(a0); if rv!=0 { rr(2,rv) }; eb(72); eb(137); mr(1, 2, 0); eb(16)  // [rax+16] = payload
            sdef(res, rd)
        }
        // P7: IR_NONE - Option::None -> header layout [base]=len=1, [base+8]=tag=0
        else if op==IR_NONE {
            flush_all()
            ri(7, 16)                          // rdi = 16 bytes (header + tag)
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0)             // mov edi, 0x60000000
            eb(186); ei(3)
            eb(65); eb(186); ei(34)
            eb(65); eb(184); ei(0-1)
            eb(69); eb(49); eb(201)
            eb(184); ei(9)
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 1); eb(72); eb(137); eb(16)   // [rax] = len header 1
            ri(2, 0); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 0
            sdef(res, rd)
        }
        // P7: IR_OK - Result::Ok(payload) -> header layout [base]=len=2, [base+8]=tag=1, [base+16]=payload
        else if op==IR_OK {
            flush_all()
            ri(7, 24)                          // rdi = 24 bytes
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0)             // mov edi, 0x60000000
            eb(186); ei(3)
            eb(65); eb(186); ei(34)
            eb(65); eb(184); ei(0-1)
            eb(69); eb(49); eb(201)
            eb(184); ei(9)
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 2); eb(72); eb(137); eb(16)   // [rax] = len header 2
            ri(2, 1); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 1
            let rv=aphys(a0); if rv!=0 { rr(2,rv) }; eb(72); eb(137); mr(1, 2, 0); eb(16)  // [rax+16] = payload
            sdef(res, rd)
        }
        // P7: IR_ERR - Result::Err(payload) -> header layout [base]=len=2, [base+8]=tag=0, [base+16]=payload
        else if op==IR_ERR {
            flush_all()
            ri(7, 24)                          // rdi = 24 bytes
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0)             // mov edi, 0x60000000
            eb(186); ei(3)
            eb(65); eb(186); ei(34)
            eb(65); eb(184); ei(0-1)
            eb(69); eb(49); eb(201)
            eb(184); ei(9)
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 2); eb(72); eb(137); eb(16)   // [rax] = len header 2
            ri(2, 0); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 0
            let rv=aphys(a0); if rv!=0 { rr(2,rv) }; eb(72); eb(137); mr(1, 2, 0); eb(16)  // [rax+16] = payload
            sdef(res, rd)
        }
        // P7: IR_UNWRAP - extract payload; panic (exit 1) if tag==0
        else if op==IR_UNWRAP {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            // load tag from [base+8]
            rbp(0, spill_home(a0))   // rax = base (value always in spill after flush_all)
            // mov rdx, [rax+8]  (tag)  -> 48 8B 50 08
            eb(72); eb(139); eb(80); eb(8)
            // cmp rdx, 0 ; je panic  (tag==0 -> panic). 48 83 FA 00
            eb(72); eb(131); eb(250); eb(0)
            let panic_lbl = nl()
            jcc32(0, 0)  // je panic
            w64(patches+patchc*PCS, codelen-6); w64(patches+patchc*PCS+8, panic_lbl); w64(patches+patchc*PCS+16, 1); patchc=patchc+1
            // load payload from [base+16] (base still in rax)
            // mov rdx, [rax+16] -> 48 8B 50 10
            eb(72); eb(139); eb(80); eb(16)
            if rd!=0 { rr(rd, 2) }
            sdef(res, rd)
            let done_lbl = nl()
            jmp32(0)
            w64(patches+patchc*PCS, codelen-5); w64(patches+patchc*PCS+8, done_lbl); w64(patches+patchc*PCS+16, 0); patchc=patchc+1
            lbladd(panic_lbl, codelen)
            // panic: exit(1)
            ri(7, 1); eb(184); ei(60); sysc()  // mov edi,1; mov eax,60; syscall
            lbladd(done_lbl, codelen)
        }
        // P7: IR_TRY - the `?` operator. a0 = Option/Result value (in-memory
        // tagged layout [base+8]=tag, [base+16]=payload). On tag==0 (None/Err)
        // early-return the WHOLE value from the enclosing function (rax already
        // holds the base pointer) by jumping to the epilogue label. On tag==1
        // (Some/Ok) the result vreg = payload [base+16].
        else if op==IR_TRY {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            rbp(0, spill_home(a0))   // rax = base (value always in spill after flush_all)
            // mov rdx, [rax+8]  (tag)  -> 48 8B 50 08
            eb(72); eb(139); eb(80); eb(8)
            // cmp rdx, 0 ; je err_lbl  (tag==0 -> early return). 48 83 FA 00
            eb(72); eb(131); eb(250); eb(0)
            if early_ret_lbl<0 { early_ret_lbl = nl() }
            let err_lbl = nl()
            jcc32(0, 0)  // je err_lbl
            w64(patches+patchc*PCS, codelen-6); w64(patches+patchc*PCS+8, err_lbl); w64(patches+patchc*PCS+16, 1); patchc=patchc+1
            // Ok: load payload [rax+16] -> rdx  (48 8B 50 10)
            eb(72); eb(139); eb(80); eb(16)
            if rd!=0 { rr(rd, 2) }
            sdef(res, rd)
            let ok_lbl = nl()
            jmp32(0)   // skip the early-return jump target on the Ok path
            w64(patches+patchc*PCS, codelen-5); w64(patches+patchc*PCS+8, ok_lbl); w64(patches+patchc*PCS+16, 0); patchc=patchc+1
            lbladd(err_lbl, codelen)
            // early-return: rax already holds the whole Option base; jump to epilogue
            jmp32(0)
            w64(patches+patchc*PCS, codelen-5); w64(patches+patchc*PCS+8, early_ret_lbl); w64(patches+patchc*PCS+16, 0); patchc=patchc+1
            lbladd(ok_lbl, codelen)
        }
        // 0.0.96: try/catch exception handling (real unwind via handler-chain).
        // Node (40 bytes): [0]=prev, [8]=catch_ip, [16]=thrown_val,
        //   [24]=saved_rbp, [32]=saved_rsp. Head pointer at HANDLER_HEAD (abs).
        else if op==IR_TRY_PUSH {
            flush_all()
            let catch_lbl = a0   // label id of the matching catch block
            // sub rsp, 40  (48 83 EC 28)
            eb(72); eb(131); eb(236); eb(40)
            // node.prev = *head : mov rax,[HANDLER_HEAD]; mov [rsp+0],rax
            //   mov rax,[abs] ABSOLUTE = 48 8B 04 25 imm32
            eb(72); eb(139); eb(4); eb(37); ei(HANDLER_HEAD); 
            //   mov [rsp+0],rax = 48 89 04 24
            eb(72); eb(137); eb(4); eb(36)
            // node.catch_ip = catch_lbl (absolute) : mov rax, imm32 (patch ty=3)
            //   emit placeholder 48 C7 C0 00 00 00 00, patch the imm at codelen
            eb(72); eb(199); eb(192); eb(0); eb(0); eb(0); eb(0)
            let po_cip = codelen - 4
            w64(patches+patchc*PCS, po_cip); w64(patches+patchc*PCS+8, catch_lbl); w64(patches+patchc*PCS+16, 3); patchc=patchc+1
            // mov [rsp+8], rax = 48 89 44 24 08
            eb(72); eb(137); eb(68); eb(36); eb(8)
            // node.thrown_val = 0 : mov [rsp+16], 0 -> xor rax,rax; mov [rsp+16],rax
            eb(72); eb(49); eb(192)             // xor rax,rax
            eb(72); eb(137); eb(68); eb(36); eb(16)   // mov [rsp+16],rax
            // node.saved_rbp = rbp : mov [rsp+24], rbp = 48 89 AC 24 18 00 00 00
            eb(72); eb(137); eb(172); eb(36); eb(24); eb(0); eb(0); eb(0)
            // node.saved_rsp = rsp+40 : mov rax,rsp; add rax,40; mov [rsp+32],rax
            //   NOTE: mov rax,rsp = 48 89 E0 (eb(72);eb(137);eb(224)); 48 8B E0 is mov rsp,rax (WRONG)
            eb(72); eb(137); eb(224)            // mov rax, rsp  (48 89 E0)
            eb(72); eb(131); eb(192); eb(40)    // add rax, 40   (48 83 C0 28)
            eb(72); eb(137); eb(68); eb(36); eb(32)   // mov [rsp+32], rax
            // *head = node (rsp) : mov rax,rsp; mov [HANDLER_HEAD],rax ABSOLUTE
            //   mov rax,rsp = 48 89 E0 ; mov [abs],rax = 48 89 04 25 imm32
            eb(72); eb(137); eb(224)            // mov rax, rsp  (48 89 E0)
            eb(72); eb(137); eb(4); eb(37); ei(HANDLER_HEAD)
        }
        else if op==IR_CATCH {
            flush_all()
            // bind the catch label (throw jumps here). a0 = catch_lbl.
            lbladd(a0, codelen)
            // the thrown value is already in rax (set by IR_THROW). Define the
            // catch variable (res vreg) as rax so the handler body can read it.
            if res>=0 { sdefr(res, 0) }
        }
        else if op==IR_TRY_END {
            flush_all()
            // pop handler: *head = (**head).prev
            //   mov rax,[HANDLER_HEAD]; mov rax,[rax+0]; mov [HANDLER_HEAD],rax
            eb(72); eb(139); eb(4); eb(37); ei(HANDLER_HEAD)
            eb(72); eb(139); eb(0)             // mov rax, [rax+0]
            eb(72); eb(137); eb(4); eb(37); ei(HANDLER_HEAD)
            // add rsp, 40  (48 83 C4 28)
            eb(72); eb(131); eb(196); eb(40)
        }
        else if op==IR_THROW {
            flush_all()
            let rv=aphys(a0)
            if rv!=0 { rr(0, rv) }   // rax = thrown value
            // rbx = *head   ABS: mov rbx,[abs] = 48 8B 1C 25 imm32
            eb(72); eb(139); eb(28); eb(37); ei(HANDLER_HEAD)
            // if rbx==0 -> no handler: hard abort (exit 134)
            eb(72); eb(133); eb(219)  // test rbx,rbx  (48 85 DB)
            let abort_lbl = nl()
            let po_jz = codelen; jcc32(0, 0)  // jz abort
            w64(patches+patchc*PCS, po_jz); w64(patches+patchc*PCS+8, abort_lbl); w64(patches+patchc*PCS+16, 1); patchc=patchc+1
            // node.thrown_val = rax : mov [rbx+16], rax = 48 89 43 10
            eb(72); eb(137); eb(67); eb(16)
            // restore frame: rbp=[rbx+24]; rsp=[rbx+32]
            eb(72); eb(139); eb(107); eb(24)  // mov rbp,[rbx+24]  (48 8B 6B 18)
            eb(72); eb(139); eb(99); eb(32)   // mov rsp,[rbx+32]  (48 8B 63 20)
            // pop head: rax=[rbx+0]; mov [HANDLER_HEAD],rax
            eb(72); eb(139); eb(3)            // mov rax,[rbx+0]  (48 8B 03)
            eb(72); eb(137); eb(4); eb(37); ei(HANDLER_HEAD)
            // rax = node.thrown_val (catch sees it) : mov rax,[rbx+16] = 48 8B 43 10
            eb(72); eb(139); eb(67); eb(16)
            // rax = node.catch_ip (ABSOLUTE vaddr, patched at ty==3).
            //   mov rax, [rbx+8] = 48 8B 43 08
            eb(72); eb(139); eb(67); eb(8)
            // jmp rax (absolute) = FF E0
            eb(255); eb(224)
            // --- abort target (no handler) ---
            lbladd(abort_lbl, codelen)
            ri(7, 134); eb(184); ei(60); sysc()    // mov edi,134; mov eax,60; syscall
        }
        else if op==IR_PARAM {
            // 0.0.248: a parameter DECLARED `: f32` / `: f16` is NARROWED on
            // entry, IN THE CALLEE.
            //
            // Why the callee and not the call site: parse and emit are fused per
            // function and functions are emitted in source order, so a callee can
            // be emitted before any call site exists -- nothing at the call site
            // is available at emit time, and its argument's type is not knowable
            // in general. The callee's own declared signature is the only sound
            // source of truth, and the A26 defect (docs/plans/bugs.md) is exactly
            // this type dropped with no diagnostic:
            //
            //     fn id32(x: f32) -> f64 { return x }
            //     id32(1.0000001)   // returned the full f64, not the f32 value
            //
            // THE CONVENTION, because callers and callees must agree. An f16/f32
            // argument crosses the boundary as its WIDENED f64 bit pattern in the
            // ordinary ABI register (rdi/rsi/rdx/rcx/r8/r9, then the stack for
            // args 6+) -- the same instantiation every other argument uses, so
            // there is no sub-word width for the two sides to disagree about. The
            // callee then narrows the value with the SAME single RNE rounding the
            // f64_to_f32 / f64_to_f16 builtins use (ft_narrow_rax). A round-trip
            // test cannot see a disagreement here, which is why
            // test_suites/codes/f32_param_rawreg_test.quanta inspects the raw
            // register the callee receives.
            let parft = r64(fn_parft + (fi*200 + a0)*8)
            if a0<6 {
                let preg=0
                if a0==0 { preg=7 }
                if a0==1 { preg=6 }
                if a0==2 { preg=2 }
                if a0==3 { preg=1 }
                if a0==4 { preg=8 }
                if a0==5 { preg=9 }
                // 0.0.245: IR_PARAM's result vreg is never mapped — sdefr keeps
                // the explicit home store so the first aphys(res) reloads the
                // ABI register's value correctly.
                if parft != 0 {
                    // flush_all() is a STORE-ONLY pass (mov [rbp+disp], reg), so
                    // it cannot disturb the incoming ABI register that is still
                    // the value's only copy.
                    flush_all()
                    rr(0, preg)          // rax = the incoming widened carrier
                    ft_narrow_rax(parft)
                    sdefr(res, 0)
                } else { sdefr(res, preg) }
            } else {
                // args 6+ arrive on the stack (SysV). After prologue (push rbp;
                // mov rbp,rsp) the incoming stack args live above the return addr:
                // [rbp+16]=arg6, [rbp+24]=arg7, ...  Load to rax, spill to home.
                rbp(0, 16 + (a0-6)*8)   // rax = [rbp + 16 + (idx-6)*8]
                if parft != 0 { flush_all(); ft_narrow_rax(parft) }
                sdefr(res, 0)
            }
            // The parameter's declared float type is its value type for the rest
            // of the body, so tag the vreg: this is what keeps `x * y` on two f32
            // parameters in f32 arithmetic instead of f64-with-a-label.
            if parft != 0 { w64(vreg_ftype + res*8, parft); w8(vfloat+res, 1) }
        }
        else if op==IR_LABEL {
            flush_all()
            lbladd(a0,codelen)
        }
        else if op==IR_JMP {
            flush_all()
            let po=codelen; jmp32(0)
            w64(patches+patchc*PCS,po); w64(patches+patchc*PCS+8,a0); w64(patches+patchc*PCS+16,0); patchc=patchc+1
        }
        else if op==IR_BR {
            flush_all()
            let cv=aphys(a0); rtest(cv,cv)
            let po1=codelen; jcc32(0,0)  // je a1
            w64(patches+patchc*PCS,po1); w64(patches+patchc*PCS+8,a1); w64(patches+patchc*PCS+16,1); patchc=patchc+1
        }
        else if op==IR_RET {
            flush_all()
            // P7: if an IR_TRY in this function needs an early-return target, bind
            // the label here (right before the frame teardown) so a `?`-on-Err jump
            // lands with rax = the whole Option/Result value and unwinds the frame.
            if early_ret_lbl>=0 { lbladd(early_ret_lbl, codelen) }
            if a0>=0 && naked != 1 { let rv=aphys(a0); if rv!=0 { rr(0,rv) } }
            // 0.0.248: a function DECLARED `-> f32` / `-> f16` rounds its return
            // value ONCE, here, in the callee -- the mirror of the IR_PARAM
            // narrowing above, and driven by the same declared type. The value
            // crosses back as the widened f64 carrier in rax, so a caller needs
            // no knowledge of the width; what the caller DOES need is the result's
            // float TYPE, which is tagged from fn_retft at the call site.
            //
            // Emitted AFTER the a0>=0 move and after any early-return label, so a
            // `?`-on-Err unwind (whose rax holds the whole Option/Result) does not
            // run a float rounding over a non-float payload.
            if a0>=0 && naked != 1 {
                let rft = r64(fn_retft + fi*8)
                if rft != 0 { ft_narrow_rax(rft) }
            }
            if naked == 1 {
                // Naked: the body owns the ABI. No frame teardown, no register
                // restores — the asm! body has already placed the return value
                // in rax and balanced the stack. A bare ret is all that remains.
                ret()
            } else {
            // add rsp, frame_size  (7 bytes: REX.W 81 C4 imm32), emitted into CODE.
            let af=frame_size
            if codelen+7 > CODE_CAP { exit(1) }
            w8(code+codelen, 72); w8(code+codelen+1, 129); w8(code+codelen+2, 196)
            w8(code+codelen+3, af & 255)
            w8(code+codelen+4, (af >> 8) & 255)
            w8(code+codelen+5, (af >> 16) & 255)
            w8(code+codelen+6, (af >> 24) & 255)
            codelen = codelen + 7
            let mj=4; while mj>=0 { xpop(r64(mather_saved+mj*8)); mj=mj-1 }
            xpop(5); ret()
            }
        }
        else if op==IR_FNPTR {
            if bare == 1 {
                // 0.0.233 Phase D: BARE METAL has no mmap (the tuple path below
                // is a 16-byte mmap syscall, which in ring 0 jumps through a
                // null IA32_LSTAR and triple-faults). So fnptr(FNAME) yields the
                // RAW code address here — the same PIC lea the object-mode path
                // uses — which is what a kernel needs for IDT gates, ISR tables
                // and callbacks. Direct callers of closure_call are the only
                // losers, and they need a heap anyway.
                flush_all()
                // 0.0.234 A1: named `ftgt`, NOT `fi`. A `let` in this block shares
                // the enclosing function's binding table entry, so `let fi=a0`
                // shadowed ci_func's `fi` PARAMETER for the rest of the function --
                // and the IR_CAPREAD/IR_CAPWRITE handlers below read `fi` as this
                // operand instead of the current function index, computing a wild
                // cap_bodyvreg address -> SIGSEGV on any capturing closure that
                // also had a branch in the enclosing function.
                let ftgt=a0
                let lea_ofs=codelen
                eb(72); eb(141); eb(5); ei(0)   // 48 8D 05 disp32 = lea rax,[rip+disp]
                w64(patches+patchc*PCS, lea_ofs); w64(patches+patchc*PCS+8, ftgt); w64(patches+patchc*PCS+16, 4); patchc=patchc+1
                let rres=aphys(res)
                if rres!=0 { rr(rres,0) }
                sdef(res, rres)
            } else {
            // 0.0.72: fnptr(FNAME) now returns a [codeptr, env=0] tuple ? the
            // SAME layout as IR_FNVAL ? so the result can be passed directly to
            // closure_call (which expects a tuple and does mov rdx,[rax] then
            // call r11). Before 0.0.72 fnptr emitted a RAW pointer (lea rax,
            // [rip+disp]), and feeding it to closure_call dereferenced the raw
            // pointer as a tuple -> `mov rdx,[rax]` read garbage -> jump to a
            // bogus address -> SEGFAULT (rc=139). There was no gated test for
            // fnptr, so the crash survived since 0.0.67. Copying IR_FNVAL's
            // tuple emit here is the minimal fix: one allocation, deferred
            // codeptr patch, env hardcoded to 0.
            flush_all()
            ri(7, 16)                          // rdi = 16 bytes
            eb(72); eb(137); eb(254)          // mov rsi, rdi   (len)
            eb(191); ei(0)          // mov edi, hint addr
            eb(186); ei(3)                    // mov edx, 3     (PROT_READ|WRITE)
            eb(65); eb(186); ei(34)           // mov r10d, 0x22 (MAP_PRIVATE|ANON)
            eb(65); eb(184); ei(0-1)          // mov r8d, -1    (fd)
            eb(69); eb(49); eb(201)           // xor r9d, r9d
            eb(184); ei(9)                    // mov eax, 9
            sysc()                            // rax = 16-byte buffer
            let ftgt=a0                 // 0.0.234 A1: was `fi` (shadowed the parameter)
            let lea_ofs=codelen
            eb(72); eb(141); eb(21); ei(0)   // 48 8D 15 disp32 = lea rdx,[rip+disp]
            w64(patches+patchc*PCS, lea_ofs); w64(patches+patchc*PCS+8, ftgt); w64(patches+patchc*PCS+16, 4); patchc=patchc+1
            // [rax] = rdx (codeptr) ; [rax+8] = 0 (env)
            eb(72); eb(137); eb(16)           // 48 89 10 = mov [rax], rdx
            eb(72); eb(199); eb(64); eb(8); ei(0)   // 48 C7 40 08 00000000 = mov qword [rax+8], 0
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
            }   // end bare==0 tuple path
        }
        else if op==IR_FNVAL {
            // P10: fn-value tuple [codeptr, env=0] (16 bytes, NO length header ?
            // same layout as mk_any so IR_CLOSURE_CALL can read it directly).
            flush_all()
            ri(7, 16)                          // rdi = 16 bytes
            eb(72); eb(137); eb(254)          // mov rsi, rdi   (len)
            eb(191); ei(0)          // mov edi, hint addr
            eb(186); ei(3)                    // mov edx, 3     (PROT_READ|WRITE)
            eb(65); eb(186); ei(34)           // mov r10d, 0x22 (MAP_PRIVATE|ANON)
            eb(65); eb(184); ei(0-1)          // mov r8d, -1    (fd)
            eb(69); eb(49); eb(201)           // xor r9d, r9d
            eb(184); ei(9)                    // mov eax, 9
            sysc()                            // rax = 16-byte buffer
            // rdx = codeptr: lea rdx,[rip+disp32] (deferred patch like IR_FNPTR)
            let lea_ofs2=codelen
            eb(72); eb(141); eb(21); ei(0)   // 48 8D 15 disp32 = lea rdx,[rip+disp]
            let fi2=a0
            w64(patches+patchc*PCS, lea_ofs2); w64(patches+patchc*PCS+8, fi2); w64(patches+patchc*PCS+16, 4); patchc=patchc+1
            // [rax] = rdx (codeptr) ; [rax+8] = 0 (env)
            eb(72); eb(137); eb(16)           // 48 89 10 = mov [rax], rdx
            eb(72); eb(199); eb(64); eb(8); ei(0)   // 48 C7 40 08 00000000 = mov qword [rax+8], 0
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
        }
        else if op==IR_CAPREAD {
            let env_off = -(frame_size)
            rr(11, 5)
            eb(77); eb(139); eb(147); ei(env_off)
            let kofs = a0*8
            eb(73); eb(139); eb(130); ei(kofs)
            eb(72); eb(139); eb(0)
            sdefr(res, 0)   // 0.0.245: res is never mapped here; the home write is the binding
            // 0.0.121: record this capread's res vreg so IR_CAPWRITE can refresh
            // the cached value that a later `return n` / re-read will observe.
            // Keyed by function index (fi) + capture slot (a0) so it matches the
            // entry-time table written in entry.quanta and the slot used by
            // IR_CAPWRITE. THIS res is the vreg subsequent reads of `n` actually
            // consult (the entry-time kvr is a separate, unused binding).
            w64(cap_bodyvreg + (fi*CAP_MAX + a0)*8, res)
        }
        else if op==IR_CAPWRITE {
            // 0.0.121 BY-REF WRITE: store the new value into the captured var's
            // home slot through the env pointer (env[k] holds &enclosing_slot).
            // The value vreg (a1) may live in a register OR be spilled; use aphys
            // to materialize its current value into rdx BEFORE clobbering r10/r11.
            let rval = aphys(a1)
            if rval != 2 { rr(2, rval) }            // rdx = value (if not already rdx)
            let env_off = -(frame_size)
            rr(11, 5)
            eb(77); eb(139); eb(147); ei(env_off)   // r10 = saved env pointer
            let kofs = a0*8
            eb(73); eb(139); eb(138); ei(kofs)      // rcx = [r10 + k*8] = &slot
            eb(72); eb(137); eb(17)                 // mov [rcx], rdx
            // refresh the body-local capread vreg so a later `return count` / re-read
            // sees the mutation (the cached vreg is otherwise stale until next call).
            let bvr = r64(cap_bodyvreg + (fi*CAP_MAX + a0)*8)
            if bvr >= 0 {
                rr(11, 5)
                eb(77); eb(139); eb(147); ei(env_off)
                eb(73); eb(139); eb(130); ei(kofs)  // rax = [r10 + k*8] = &slot
                eb(72); eb(139); eb(0)              // rax = *slot (unused; refresh below)
                rr(0, 2)                            // rax = rdx (new value)
                sdefr(bvr, 0)
            }
        }
        else if op==IR_CLOSURE {
            // P11: closure literal [codeptr, env] tuple (same layout as IR_FNVAL).
            // a0 = closure body vreg (IR_CONST with fn index); a1..an = captured vregs.
            // For v1 (no captures yet): env=0, just emit the tuple with body's codeptr.
            flush_all()
            ri(7, 16)                          // rdi = 16 bytes
            eb(72); eb(137); eb(254)          // mov rsi, rdi   (len)
            eb(191); ei(0)          // mov edi, hint addr
            eb(186); ei(3)                    // mov edx, 3     (PROT_READ|WRITE)
            eb(65); eb(186); ei(34)           // mov r10d, 0x22 (MAP_PRIVATE|ANON)
            eb(65); eb(184); ei(0-1)          // mov r8d, -1    (fd)
            eb(69); eb(49); eb(201)           // xor r9d, r9d
            eb(184); ei(9)                    // mov eax, 9
            sysc()                            // rax = 16-byte buffer
            // rdx = codeptr: body vreg holds fn index (a0), we need its code address.
            // For now: a0 is a vreg holding the fn index; emit load of its addr.
            // The closure body is a top-level fn; we can use a similar PIC lea.
            let lea_ofs2=codelen
            eb(72); eb(141); eb(21); ei(0)   // 48 8D 15 disp32 = lea rdx,[rip+disp]
            let fi2=a0
            w64(patches+patchc*PCS, lea_ofs2); w64(patches+patchc*PCS+8, fi2); w64(patches+patchc*PCS+16, 4); patchc=patchc+1
            // [rax] = rdx (codeptr). Then build env: if this closure captures
            // nothing, env = 0 (fast path, no allocation). Otherwise allocate an
            // ncap*8 array, copy each captured value out of the ENCLOSING frame's
            // home slot into it, and store the pointer at [rax+8]. Captures are
            // BY VALUE, taken at construction time.
            eb(72); eb(137); eb(16)           // 48 89 10 = mov [rax], rdx
            let ncap = r64(cap_count + a0*8)
            if ncap == 0 {
                eb(72); eb(199); eb(64); eb(8); ei(0)   // mov qword [rax+8], 0
            } else {
                // rbx = tuple ptr (callee-saved across the mmap syscall below)
                rr(3, 0)                      // rbx = rax (tuple)
                ri(7, 0)                                  // rdi = hint 0
                ri(6, ncap*8)                             // rsi = ncap*8 bytes
                eb(186); ei(3)                            // mov edx, 3   (RW)
                eb(65); eb(186); ei(34)                   // mov r10d, 0x22
                eb(65); eb(184); ei(0-1)                  // mov r8d, -1
                eb(69); eb(49); eb(201)                   // xor r9d, r9d
                eb(184); ei(9)                            // mov eax, 9   (mmap)
                sysc()
                eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail -> exit(1)
                let kk = 0
                while kk < ncap {
                    let cvr = r64(cap_vreg + (a0*CAP_MAX + kk)*8)
                    // 0.0.245: the captured slot's ADDRESS escapes into the env
                    // tuple. Mark the vreg address-taken so every later sdef
                    // keeps storing its home slot (sdef is otherwise a pure
                    // mark under write-back), and if it is currently mapped,
                    // write its register value to the slot NOW so the lea'd
                    // address hands the closure a current value.
                    let cf=afind(cvr)
                    if cf>=0 { wbp(spill_home(cvr), cf) }
                    w8(vr_at+cvr, 1)
                    leabp(1, spill_home(cvr))             // rcx = &enclosing_slot
                    eb(72); eb(137); eb(136); ei(kk*8)    // 48 89 88 disp32 = mov [rax+k*8], rcx
                    kk = kk + 1
                }
                // [tuple+8] = env
                eb(72); eb(137); eb(67); eb(8)            // 48 89 43 08 = mov [rbx+8], rax
                rr(0, 3)                                  // rax = tuple (result)
            }
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
        }
        else if op==IR_CLOSURE_CALL {
            // closure_call(fnb, args...): fnb is a mk_any tuple (tag=codeptr, val=env).
            // FIX: the callee is a NORMAL function (e.g. add(a,b)) using the standard
            // SysV ABI, so caller args must land in the STANDARD arg registers
            // (rdi,rsi,rdx,rcx,r8,r9). The previous code shifted args by one and put
            // env in rdi, which collided with the callee's first param (add read
            // a=env, b=arg0 -> wrong result). Env now goes to r10 (caller-saved
            // scratch the callee ignores). Result returns in rax.
            let fnb=a0; let avs2=a1; let nargc=a2
            if nargc>5 { compile_error(2, cur_fnname, cur_fnnlen) }  // arity: too many closure args (v1 cap)
            flush_all()
            // rax = fnb tuple pointer
            rbp(R_RAX, spill_home(fnb))
            // rdx = fnb.0 (codeptr)  -- 64-bit load [rax]
            eb(72); eb(139); mr(0, R_RDX, R_RAX)        // 48 8B 10 = mov rdx,[rax]
            // r10 = fnb.1 (env)  -- 64-bit load [rax+8]; scratch reg, callee ignores it
            eb(76); eb(139); mr(1, 2, 0); eb(8)         // 4C 8B 50 08 = mov r10,[rax+8] (REX.WR for r10)
            // stash codeptr in r11 (caller-saved scratch; safe, no syscall here)
            eb(76); eb(139); mr(3, 3, 2)               // 4C 8B DA = mov r11, rdx
            // load caller args into STANDARD SysV positions rdi,rsi,rdx,rcx,r8,r9
            let j=0
            while j<nargc {
                let av=irres(avs2+j)
                let hm=spill_home(av)
                if j==0 { rbp(R_RDI, hm) }
                if j==1 { rbp(R_RSI, hm) }
                if j==2 { rbp(R_RDX, hm) }
                if j==3 { rbp(R_RCX, hm) }
                if j==4 { rbp(R_R8, hm) }
                if j==5 { rbp(R_R9, hm) }
                j=j+1
            }
            // call r11
            eb(65); eb(255); mr(3, 2, R_R11%8)              // 41 FF D3 = call r11
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
        }
        else if op==IR_APUSH {
            // P10: array push ? append a QWORD element (array header counts
            // elements, qword stride; IR_ISTORE/IR_IDX read base+8+i*8).
            // v=rdi (arg0), e=rsi (arg1). Returns new header ptr.
            flush_all()
            let arg_start = a2; let arg_cnt = a1
            let av0 = irres(arg_start)
            let av1 = irres(arg_start+1)
            rbp(7, spill_home(av0))   // rdi = v
            rbp(6, spill_home(av1))   // rsi = e
            rr(3,7)                   // rbx = v
            rr(13,6)                  // r13 = e
            rmr(14,3)                 // r14 = oldlen = [v]
            rr(0,14); eb(72);eb(255);eb(192)   // rax = oldlen+1 = newlen (48 FF C0)
            rr(15,0)                  // r15 = newlen
            eb(72);eb(193);eb(224);eb(3)       // shl rax,3 -> newlen*8 (48 C1 E0 03)
            eb(72);eb(131);eb(192);eb(8)       // add rax,8 -> size = newlen*8+8 (48 83 C0 08)
            rr(6,0)                   // rsi = size
            ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail guard: if rax<0 exit(1)
                rr(12,0)                  // r12 = new
            rr(7,12)                  // rdi = new
            rr(0,15)                  // rax = newlen
            eb(72);eb(137);eb(7)      // [new] = newlen (48 89 07)
            // copy oldlen*8 bytes v+8 -> new+8 via rep movsb
            rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = v+8 (48 83 C6 08)
            rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8 (48 83 C7 08)
            rr(1,14); eb(72);eb(193);eb(225);eb(3)  // rcx = oldlen*8 (48 C1 E1 03)
            eb(243);eb(164)           // rep movsb
            // store qword e at new+8+oldlen*8
            rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
            rr(0,14); eb(72);eb(193);eb(224);eb(3)  // rax = oldlen*8 (48 C1 E0 03)
            ra(7,0)                   // rdi += rax -> new+8+oldlen*8
            rr(0,13)                  // rax = e
            eb(72);eb(137);eb(7)      // mov [rdi], rax (48 89 07 qword store)
            rr(0,12)                  // rax = new
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
        }
        else if op==IR_CALL || op==IR_CALL_IDX {
            flush_all()
            let is_idx = 0
            if op==IR_CALL_IDX { is_idx = 1 }   // 0.0.97: a0 carries fn index directly
            // Load arguments from their home slots directly into ABI registers.
            // flush_all() above spilled every live vreg to its home, so the
            // sources are distinct memory locations and destinations are distinct
            // registers -- no aliasing hazard (matches the Python oracle).
            let arg_start = a2; let arg_cnt = a1
            // 0.0.55: qc_sys_cmd ($$(cmd)) carries the cmd vreg in a1 (NOT an arg
            // count) with a2=0. Skip the generic arg-loader ? emit_bltn loads the
            // cmd itself from the lit_addr map. Detect the name by its bytes at
            // src+a0 (the name "qc_sys_cmd" is 10 chars, null-terminated).
            let is_syscmd = 0
            if r8(src+a0)=='q' && r8(src+a0+1)=='c' && r8(src+a0+2)=='_' && r8(src+a0+3)=='s' && r8(src+a0+4)=='y' && r8(src+a0+5)=='s' && r8(src+a0+6)=='_' && r8(src+a0+7)=='c' && r8(src+a0+8)=='m' && r8(src+a0+9)=='d' && r8(src+a0+10)==0 { is_syscmd = 1 }
            if is_syscmd==1 { arg_cnt = 0 }
            // args 6+ go on the stack (SysV). nstack/pad computed here; the actual
            // spill is deferred until AFTER is_ext_call is known (below), because
            // extern "C" calls spill AFTER the rsp-alignment push (see extern branch).
            let nstack=0
            if arg_cnt>6 { nstack=arg_cnt-6 }
            let pad=0
            // P5: resolve callee + extern flag BEFORE loading args so we can
            // apply the Quanta string-header skip (+8) for extern "C" calls.
            let nm=a0; let nl=0; let callee=a0
            if is_idx==0 {
                while nl<256 {
                    let c0=r8(src+nm+nl)
                    if c0==0||c0==40||c0==41||c0==59||c0==123||c0==125||c0==44||c0==60||c0==62 { break }
                    if c0==32||c0==9||c0==10||c0==13 { break }
                    nl=nl+1
                }
                callee=findfn(nm,nl)
            }
            // 0.0.119: thread_create(worker, arg) ? resolve the worker function name
            // (first source argument) and stash its SOURCE OFFSET in g_thread_ffi so
            // emit_bltn can emit a type-2 (name-resolved) call relocation into the
            // child trampoline, exactly like a normal function call (which works).
            if nl==13&&r8(src+nm)=='t'&&r8(src+nm+1)=='h'&&r8(src+nm+2)=='r'&&r8(src+nm+3)=='e'&&r8(src+nm+4)=='a'&&r8(src+nm+5)=='d'&&r8(src+nm+6)=='_'&&r8(src+nm+7)=='c'&&r8(src+nm+8)=='r'&&r8(src+nm+9)=='e'&&r8(src+nm+10)=='a'&&r8(src+nm+11)=='t'&&r8(src+nm+12)=='e' {
                // first arg token = worker name: scan from after "thread_create("
                let p = nm + nl + 1   // skip '('
                while r8(src+p)==32||r8(src+p)==9||r8(src+p)==10||r8(src+p)==13 { p = p + 1 }
                let wn = 0
                while r8(src+p+wn)>=65&&r8(src+p+wn)<=122&&r8(src+p+wn)!=40&&r8(src+p+wn)!=41&&r8(src+p+wn)!=44 { wn = wn + 1 }
                g_thread_ffi = findfn(p, wn)   // store WORKER FN INDEX (like normal calls)
            }
            let is_ext_call=0
            if callee>=0 && r64(fn_extern + callee*8)==1 { is_ext_call=1 }

            // Spill args 6+ to the stack for NON-extern (internal) calls. Extern "C"
            // calls do their own spill AFTER the rsp-alignment push (in the extern
            // branch below), because pushing r11 for alignment must not land between
            // the return address and the first stack arg (which would shift every
            // stack arg by 8 and corrupt it).
            if nstack>0 && is_ext_call==0 {
                if nstack%2==1 { pad=8; sbi(8) }   // align rsp to 16 before pushes
                let sj=arg_cnt-1
                while sj>=6 {
                    let arg_ir2=arg_start+sj
                    if arg_ir2<ir_end {
                        let av2=irres(arg_ir2)
                        rbp(0, spill_home(av2))   // rax = arg
                        xpush(0)                  // push rax
                    }
                    sj=sj-1
                }
            }

            // Load register args 0..5 from home slots into the ABI registers.
            let arg_i=0
            while arg_i<arg_cnt {
                if arg_i<6 {
                    let arg_ir = arg_start + arg_i
                    if arg_ir < ir_end {
                        let av=irres(arg_ir)
                        let preg=0
                        if arg_i==0 { preg=7 }
                        if arg_i==1 { preg=6 }
                        if arg_i==2 { preg=2 }
                        if arg_i==3 { preg=1 }
                        if arg_i==4 { preg=8 }
                        if arg_i==5 { preg=9 }
                        rbp(preg, spill_home(av))
                        // P5: extern "C" ? skip the 8-byte Quanta length header on
                        // a string-valued arg so C receives a char* to the data.
                        if is_ext_call==1 {
                            let _isstr = r64(vreg_is_str + av*8)
                            if _isstr!=1 {
                                let _aisop = irop(arg_ir)
                                if _aisop==23 { _isstr = 1 }
                                else if _aisop==IR_MOV {
                                    let _sv = ira0(arg_ir)
                                    if r64(vreg_is_str + _sv*8)==1 { _isstr = 1 }
                                }
                            }
                            if _isstr==1 {
                                eb(72); eb(131)
                                if preg>=8 { eb(192 + (preg - 8)) }
                                else { eb(192 + preg) }
                                eb(8)
                            }
                        }
                    }
                }
                arg_i=arg_i+1
            }
            // FIX-0.0.3: explicit mem_free(p)/drop(p) transfers ownership away.
            // Clear vreg_owned for arg 0 so the RAII scope-exit (owned_scope_pop_one)
            // does NOT re-emit IR_FREE for the same block (double-free -> aliased-block
            // heap corruption once the allocator starts recycling the free list).
            if is_idx==0 && arg_cnt>=1 && arg_start<ir_end {
                let _isfree = 0
                if nl==8&&r8(src+nm)=='m'&&r8(src+nm+1)=='e'&&r8(src+nm+2)=='m'&&r8(src+nm+3)=='_'&&r8(src+nm+4)=='f'&&r8(src+nm+5)=='r'&&r8(src+nm+6)=='e'&&r8(src+nm+7)=='e' { _isfree = 1 }
                if nl==4&&r8(src+nm)=='d'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='o'&&r8(src+nm+3)=='p' { _isfree = 1 }
                if _isfree==1 {
                    let _fv = irres(arg_start)
                    if _fv>=0 && _fv<400000 { w64(vreg_owned + _fv*8, 0) }
                }
            }
            // (callee/nm/nl already resolved above for P5)
            if callee>=0 && r64(fn_var + callee*8)==1 { ri(10, arg_cnt) }
            // P3: if callee is extern "C", emit direct call to external symbol
            if is_ext_call==1 {
                // P5: align rsp to 16 before the libc call (SysV ABI). The prologue
                // leaves rsp 8 mod 16 at the call site; libc (printf etc.) faults on
                // misalignment via SSE. push r11 (scratch, caller-saved, not used
                // for args or return) to align, pop after.
                eb(65); eb(83)   // push r11
                // Spill variadic stack args (6+) AFTER alignment, highest-first so
                // they land at [rsp+8],[rsp+16],... (above the return address).
                if nstack>0 {
                    let sj=arg_cnt-1
                    while sj>=6 {
                        let arg_ir2=arg_start+sj
                        if arg_ir2<ir_end {
                            let av2=irres(arg_ir2)
                            rbp(0, spill_home(av2))   // rax = arg
                            xpush(0)                  // push rax
                        }
                        sj=sj-1
                    }
                }
                let call_ofs = codelen
                eb(232)  // E8 = call
                ei(0)    // placeholder - patched to PLT by objfmt
                w64(patches+patchc*PCS,call_ofs); w64(patches+patchc*PCS+8,nm); w64(patches+patchc*PCS+16,3)
                patchc=patchc+1
                eb(65); eb(91)   // pop r11
            }
            // Built-ins are emitted inline; source functions get a patched call.
            else if is_idx==1 {
                let call_ofs = codelen
                eb(232)  // E8 = call
                ei(0)    // placeholder
                w64(patches+patchc*PCS,call_ofs); w64(patches+patchc*PCS+8,a0); w64(patches+patchc*PCS+16,5)
                patchc=patchc+1
            }
            else if emit_bltn(nm,nl,ii)==0 {
                let call_ofs = codelen
                eb(232)  // E8 = call
                ei(0)    // placeholder
                w64(patches+patchc*PCS,call_ofs); w64(patches+patchc*PCS+8,nm); w64(patches+patchc*PCS+16,2)
                patchc=patchc+1
            }

            // Caller cleanup: reclaim stack space used for args 6+ (and pad).
            if nstack>0 { abi(nstack*8 + pad) }   // add rsp, nstack*8+pad

            // Save result - allocate result register
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
            // A callee declared `-> f64` hands the float bits back in rax, so the
            // result vreg is a float. Untagged, the caller read those bits as an
            // integer: `fn f(a: f64) -> f64 { return a; }` then `f(1.0) == 0.1`
            // compared 4607182418800017408 against 0.1 and was false.
            // is_idx==1 is IR_CALL_IDX, where a0 IS the fn index; otherwise
            // `callee` was resolved from the name above.
            let rfi = callee
            if is_idx==1 { rfi = a0 }
            if rfi>=0 && rfi<fnc && r64(fn_retflt + rfi*8)==1 { w8(vfloat+res, 1) }
            // NOTE: parameter-float inference from the caller's float arguments is
            // NOT done here. By the time an IR_CALL is emitted its callee has
            // already been through ci_func(), so a fn_parflt bit set here would be
            // read too late. It is a whole-IR pre-pass in entry.quanta
            // (infer_par_flt) that runs after every function is parsed and before
            // any ci_func emits one.
            // `-> string` tags the result vreg, so file_open skips the 8-byte length
            // header and opens the bytes. Without it a path returned from a function
            // was opened from its LENGTH field and open() returned -2 -- which made
            // every computed path unusable and, in std/config, made the config
            // unfindable. Same class as fn_retflt: value survives, tag did not.
            //
            // This used w8(vreg_is_str+res, 1): TWO bugs in one store. w8 is a ONE-byte
            // store, but nv() initializes every cell to -1 via w64() -- so the
            // byte left the cell at 0xFFFFFFFFFFFFFF01, neither the 1 readers
            // test for nor the -1 they test as "not a string". And the offset
            // omitted the *8 stride, writing into a different vreg's cell
            // entirely. The tag therefore never took effect and the declared
            // `-> string` path was dead, contrary to the comment above claiming
            // it worked:
            //
            //     fn d() -> string { return "hello" }   print(d())  -> 1109393744
            //     fn u() { return "hello" }            print(u())  -> 1109393760
            //
            // Both printed an integer because print() fell back to the integer path
            // and read the string header's low bytes. vfloat is read bytewise AND
            // unscaled (w8(vfloat+res,1) is correct for it), which is why the
            // identical mistake is harmless beside it and fatal here.
            if rfi>=0 && rfi<fnc && r64(fn_retstr + rfi*8)==1 { w64(vreg_is_str + res*8, 1) }
        }
        else if op==IR_FREE {
            // 0.0.112 RAII: scope-exit cleanup of a mem_alloc-owned binding now
            // recycles the block to the free-list via drop() (== mem_free) instead
            // of munmap. This makes owned heap pointers auto-RAII: no manual
            // mem_free needed, block returns to the allocator for reuse.
            // a0 = the owned vreg. Load it into rdi (the drop/mem_free arg).
            flush_all()
            let fv=irres(a0)
            rbp(R_RDI, spill_home(fv))        // rdi = ptr
            eb(87)                                    // push rdi  (save ptr at [rsp])
            eb(91)                                    // pop rbx   (rbx = ptr, callee-saved)
            eb(72); eb(139); eb(4); eb(37); ei(HEAP_CTRL)   // mov rax, [HEAP_CTRL]  (old head)
            eb(72); eb(137); eb(91); eb(8)                 // mov [rbx+8], rax  ([ptr+8] = old head)
            eb(72); eb(137); eb(27); eb(37); ei(HEAP_CTRL) // mov [HEAP_CTRL], rbx  (list head = ptr)
            ri(R_RAX, 0)                               // rax = 0
        }
        else if op==IR_DEREF {  // P6: *p - raw pointer dereference (load)
            flush_all()
            let rd=aphys(res)
            let rs=aphys(a0)
            eb(72); eb(139); mr(0, rd, rs)   // mov rd, [rs]  (64-bit load)
            sdef(res, rd)
        }
        else if op==IR_DEREF_MUT {  // P6: *p = v (store through raw pointer)
            flush_all()
            let rs=aphys(a0)   // pointer
            let rv=aphys(a1)   // value
            eb(72); eb(137); mr(0, rv, rs)   // mov [rs], rv  (64-bit store)
        }
        else if op==IR_PTR_ADD {  // P6: p + n (element-sized)
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            // Scale by 8: lea rd, [r1 + r2*8]
            if r2!=0 {
                // Use LEA with scale=8: lea rd, [r1 + r2*8]
                // encoding: 8D /r (lea r64, m) with SIB byte for scale=8
                // For x86-64: lea rd, [r1 + r2*8] = REX.W 8D mod=00 SIB disp32=0
                // SIB = scale(3)<<6 | index(r2)<<3 | base(r1)
                let sib = 0x80 | ((r2 & 7) << 3) | (r1 & 7)
                let rexl = 0x48 | ((rd>>3) & 1) | ((r1>>3) & 1)<<1 | ((r2>>3) & 1)<<2
                eb(rexl); eb(0x8D); eb(sib); ei(0)
            } else {
                if rd!=r1 { rr(rd,r1) }
            }
            sdef(res, rd)
        }
        else if op==IR_PTR_SUB {  // P6: p - n (element-sized)
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            // Scale by 8: lea rd, [r1 - r2*8] = lea rd, [r1 + r2*(-8)]
            // Use LEA with negative scale trick: sub then LEA, or use SUB directly
            if r2!=0 {
                // LEA with negative displacement: lea rd, [r1 - r2*8]
                // Can do: sub temp, r2*8; lea rd, [r1 + temp]
                // Simpler: use SUB after LEA for positive, or use scaled index with negative disp
                // For now: compute r2*8 into temp, then sub
                let temp = nv()
                rr(temp, r2)
                eb(0xD1); mr(3, temp, temp)  // shl temp, 3  (multiply by 8)
                if rd!=r1 { rr(rd, r1) }
                rs(rd, temp)
            } else {
                if rd!=r1 { rr(rd,r1) }
            }
            sdef(res, rd)
        }
        else if op==IR_PTR_DIFF {  // P6: p - q (elements)
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            rs(rd, r2)
            // Divide by 8: sar rd, 3 (arithmetic shift right)
            eb(0xD1); mr(7, rd, rd)  // sar rd, 3
            sdef(res, rd)
        }
        else if op==IR_PTR_CAST {  // P6: &p or cast to raw pointer
            // a2: 1 = address-of, 0 = cast. (a1 is the type tag from the
            // `x as T` cast path ? the address-of marker is passed in a2 by
            // parse_unary's `&` branch: iremit(IR_PTR_CAST, vr, o, 0, 1).)
            if a2==1 {
                // address-of LOCAL: lea rd, [rbp + spill_home(a0)] gives the
                // stack address of the local's home slot. (Globals: the a0
                // vreg is an IR_LOADG temp, so &global is not yet supported ?
                // same limitation as before, but locals now work.)
                //
                // 0.0.245: this handler does NOT flush, so a0 may be mapped
                // with a stale home (write-back). Write the register value to
                // the slot NOW and mark a0 address-taken so its later sdefs
                // keep the slot current for reads/writes through the pointer.
                let af=afind(a0)
                if af>=0 { wbp(spill_home(a0), af) }
                w8(vr_at+a0, 1)
                let rd=aphys(res)
                let off=spill_home(a0)
                rw(rd,5); eb(141); if rd>=8 { mr(2,rd%8,4); eb(37) } else { mr(2,rd%8,5) }; ei(off)
                sdef(res, rd)
            } else {
                // `x as T` width cast: move value, then truncate to the target
                // width if T is a fixed-width type. a1 holds the target vtype
                // (1=u8,2=u16,3=u32,7=char,8=byte -> mask; 4=u64,5=usize,
                // 6=bool, 0=signed -> identity).
                let rd=aphys(res)
                let rs=aphys(a0)
                if rd!=rs { rr(rd, rs) }
                eb(15); eb(15); eb(15); eb(15)   // PROBE: 4 nops if cast branch runs
                if a1==1 || a1==7 || a1==8 { eb(72); eb(129); eb(224 + (rd%8)); ei(0xFF) }
                else if a1==2 { eb(72); eb(129); eb(224 + (rd%8)); ei(0xFFFF) }
                else if a1==3 { eb(72); eb(193); eb(224 + (rd%8)); eb(32); eb(72); eb(193); eb(232 + (rd%8)); eb(32) }
                sdef(res, rd)
            }
        }
        else if op==IR_IS_NULL {  // P6: p == 0
            let r1=aphys(a0); let rd=adistinct(res,r1,r1)
            // cmp r1, 0; sete rd
            eb(0x48); eb(0x83); mr(7, r1, r1); ei(0)  // cmp r1, 0
            eb(0x0F); eb(0x94); mr(0, rd, r1)  // sete rd
            sdef(res, rd)
        }
        else if op==IR_VOLATILE_LOAD {  // P6: volatile load
            flush_all()
            let rd=aphys(res)
            let rs=aphys(a0)
            eb(72); eb(139); mr(0, rd, rs)   // mov rd, [rs]  (64-bit load, mod=0 no disp)
            // Compiler barrier: asm volatile("" ::: "memory")
            eb(0x0F); eb(0xAE); eb(0xF0)  // mfence (full barrier)
            sdef(res, rd)
        }
        else if op==IR_VOLATILE_STORE {  // P6: volatile store
            flush_all()
            let rs=aphys(a0)
            let rt=aphys(a1)
            eb(72); eb(137); mr(0, rt, rs)   // mov [rs], rt  (64-bit store; a0=address like IR_DEREF_MUT)
            // Compiler barrier
            eb(0x0F); eb(0xAE); eb(0xF0)  // mfence
        }
        // P10: IR_ARRAY_LEN (op 69) ? get array length from header [base]
        else if op==IR_ARRAY_LEN {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            eb(0x48); eb(0x8B); mr(0, rd, rs)  // mov rd, [rs]  (64-bit load from header)
            sdef(res, rd)
        }
        else if op==IR_STR {
            // a0 = pointer to string in source (including opening quote)
            let sp=a0+1  // skip quote
            // Find length by scanning to closing quote
            let ln=0; let scp=sp
            while scp<srclen&&r8(src+scp)!=34 {
                ln=ln+1; if r8(src+scp)==92&&scp+1<srclen { scp=scp+2 } else { scp=scp+1 }
            }
            // Emit to output binary's data section (absolute address). String literals
            // live AFTER all global slots: GDATA + (INTERNAL_GLOBAL_COUNT+gvarc)*8 + data_off.
            //
            // A string expression evaluates to the HEADER pointer of the literal, not
            // the characters: the layout is [u64 len][chars][NUL], and every consumer
            // (print, str(), substr, qc_sys_cmd, file_open paths) reads the length at
            // [s] and the bytes at s+8. Keep that invariant -- IR_ARRAY_LEN loads
            // [base], and emit_bltn does cmd+8 itself. Pointing the vreg at the
            // characters instead shifts both by 8 and silently breaks print().
            let gdata_size = (INTERNAL_GLOBAL_COUNT + gvarc)*8
            let str_addr = GDATA + gdata_size + data_off
            // 0.0.55: record this literal's data-section address keyed by its
            // result vreg, so qc_sys_cmd's emit_bltn can load the cmd directly.
            w64(lit_addr + res*8, str_addr)
            let rd=aphys(res)
            if emit_obj == 1 {
                // OBJECT mode: RIP-relative lea rd, [rip+disp32]; disp32 patched by an
                // R_X86_64_PC32 reloc against _gdata, addend = gdata_size+data_off-4.
                let rexl=72; if rd>=8 { rexl=76 }
                eb(rexl); eb(141); eb(5 + (rd%8)*8); ei(0)   // REX.W 8D mod=00 rm=rip disp32
                w64(gpatches+gpatchc*24, codelen-4)
                w64(gpatches+gpatchc*24+8, gdata_size + data_off)
                w8(gpatches+gpatchc*24+16, 2)
                if gpatchc >= GPATCH_CAP { emit_ovf(10) }
                gpatchc=gpatchc+1
            } else {
                ri64(rd, str_addr)
            }
            if data!=0 && data+1!=0 {
                let ci=0
                let si=sp
                while ci<ln {
                    let sv=r8(src+si)
                    if sv==92&&si+1<srclen {
                        let nx=r8(src+si+1)
                        if nx==110 { sv=10 }
                        else if nx==116 { sv=9 }
                        else if nx==114 { sv=13 }
                        else if nx==48 { sv=0 }
                        else if nx==92 { sv=92 }
                        else if nx==34 { sv=34 }
                        else if nx==39 { sv=39 }
                        else { sv=nx }
                        si=si+2
                    } else {
                        si=si+1
                    }
                    w8(data+data_off+8+ci, sv)
                    ci=ci+1
                }
                w64(data+data_off, ln)
                w8(data+data_off+8+ln, 0)
                let bsz=8+ln+1; let pad=bsz%16; if pad>0 { bsz=bsz+(16-pad) }
                if data_off+bsz > DAT_CAP { exit(1) }
                data_off=data_off+bsz
            }
            sdef(res, rd)
        }
        // P6: Raw pointer dereference (*p)
        else if op==IR_DEREF {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            eb(72); eb(139); mr(0, rd, rs)   // mov rd, [rs]
            sdef(res, rd)
        }
        // P6: Mutable raw pointer dereference (*p = v)
        else if op==IR_DEREF_MUT {
            flush_all()
            let rs=aphys(a0)   // pointer
            let rv=aphys(a1)   // value
            eb(72); eb(137); mr(0, rs, rv)   // mov [rs], rv
        }
        // P6: Pointer arithmetic p + n (element-sized)
        else if op==IR_PTR_ADD {
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            // Scale by element size (8 bytes for pointers)
            if r2!=0 { ra(rd,r2) }  // assume already scaled or use shift
            sdef(res, rd)
        }
        // P6: Pointer arithmetic p - n
        else if op==IR_PTR_SUB {
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            rs(rd,r2)
            sdef(res, rd)
        }
        // P6: Pointer diff p - q (elements)
        else if op==IR_PTR_DIFF {
            let r1=aphys(a0); let r2=aphys_x(a1,a0); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            rs(rd,r2)
            // Divide by 8 (element size) - use shr for unsigned
            eb(72); eb(139); mr(0, 1, rd)  // mov rcx, rd
            eb(72); eb(193); eb(249); eb(3)  // shr rcx, 3
            rr(rd, 1)
            sdef(res, rd)
        }
        // P6: Pointer cast (p as usize / usize as *T / address-of)
        else if op==IR_PTR_CAST {
            // a0 = value, a1 = type tag (0=to usize, 1=address-of)
            if a1==1 {
                // address-of: just use the value as a pointer
                let rs=aphys(a0)
                let rd=aphys(res)
                if rd!=rs { rr(rd,rs) }
                sdef(res, rd)
            } else {
                // cast to usize/width type: move value, then truncate to the
                // target width if a1 is a fixed-width type tag (1=u8,2=u16,
                // 3=u32,7=char,8=byte). a1=0/4/5 (signed/u64/usize) -> identity.
                let rs=aphys(a0)
                let rd=aphys(res)
                if rd!=rs { rr(rd,rs) }
                if a1==1 || a1==7 || a1==8 { eb(72); eb(129); eb(224 + (rd%8)); ei(0xFF) }
                else if a1==2 { eb(72); eb(129); eb(224 + (rd%8)); ei(0xFFFF) }
                else if a1==3 { eb(72); eb(193); eb(224 + (rd%8)); eb(32); eb(72); eb(193); eb(232 + (rd%8)); eb(32) }
                sdef(res, rd)
            }
        }
        // P6: is_null check
        else if op==IR_IS_NULL {
            let r1=aphys(a0)
            let rd=adistinct(res,r1,r1)
            // cmp r1, 0; sete rd
            eb(72); eb(131); eb(248 + (r1%8)); eb(0)  // cmp r1, 0
            eb(15); eb(148 + (rd%8)); eb(0)  // sete rd (8-bit)
            rzx(rd,rd)
            sdef(res, rd)
        }
        // P6: Volatile load (MMIO)
        else if op==IR_VOLATILE_LOAD {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            // Use mov with volatile semantics (compiler barrier)
            eb(72); eb(139); mr(0, rd, rs)   // mov rd, [rs]
            // Compiler barrier: asm volatile("" ::: "memory") - skip for now
            sdef(res, rd)
        }
        // P6: Volatile store (MMIO)
        else if op==IR_VOLATILE_STORE {
            flush_all()
            let rs=aphys(a0)
            let rv=aphys(a1)
            eb(72); eb(137); mr(0, rs, rv)   // mov [rs], rv
            // Compiler barrier
        }
        // P6: Inline assembly (placeholder - emit as no-op for now)
        // P6: Raw pointer type markers (no runtime codegen)
        else if op==IR_RAW_PTR {
            // No-op: raw pointer type annotation
        }
        else if op==IR_MUT_PTR {
            // No-op: mutable raw pointer type annotation
        }
        // P6: Raw pointer type markers (no runtime codegen)
        else if op==IR_RAW_PTR {
            // No-op: raw pointer type annotation
        }
        else if op==IR_MUT_PTR {
            // No-op: mutable raw pointer type annotation
        }
        else if op==IR_FFI_CALL {  // P6: FFI call - System V AMD64 ABI
            flush_all()
            // a0 = function pointer (vreg), a1 = number of args, a2 = args array pointer (vreg)
            let fn_ptr = aphys(a0)
            let nargs = aphys(a1)
            let args_ptr = aphys(a2)
            // Load args array base into rax, then move each 64-bit elem into the
            // SysV ABI registers rdi,rsi,rdx,rcx,r8,r9.
            rr(0, args_ptr)
            eb(72); eb(139); eb(120); eb(0)   // mov rdi, [rax+0]
            eb(72); eb(139); eb(112); eb(8)   // mov rsi, [rax+8]
            eb(72); eb(139); eb(104); eb(16)  // mov rdx, [rax+16]
            eb(72); eb(139); eb(96);  eb(24)  // mov rcx, [rax+24]
            eb(76); eb(139); eb(96);  eb(32)  // mov r8,  [rax+32]
            eb(76); eb(139); eb(104); eb(40)  // mov r9,  [rax+40]
            // Load callee pointer into rax and call it.
            rr(0, fn_ptr)
            eb(255); eb(208)                  // call rax
            // Return value in rax -> result vreg.
            let rd = aphys(res)
            if rd != 0 { rr(rd, 0) }
            sdef(res, rd)
        }
        else if op==IR_VEC128 {  // P6: SIMD vec128 (placeholder)
            flush_all()
            eb(144)
            let rd=aphys(res)
            rxor(rd, rd)
            sdef(res, rd)
        }
        else if op==IR_UNSAFE_BLOCK {  // P6: unsafe block marker (no-op at runtime)
            // No-op: unsafe{} is a compile-time construct
        }
        else if op==IR_ASM {
            // P11: inline asm ? template at src+a0 is a hex byte string like
            // "b8 2a 00 00 00" (mov eax, 42). Emit each byte verbatim.
            // Result register convention: RAX.
            // INVALID hex chars cause COMPILE-TIME ERROR (not silent garbage).
            flush_all()
            // 0.0.231 Phase C1: try the MNEMONIC assembler first. asm_tpl/asm_end
            // bound the template text; asm_try_emit returns 1 when a known
            // mnemonic consumed it (bytes already emitted), 0 when the first
            // word is not a known mnemonic (fall through to hex).
            asm_tpl = a0+1
            let qk = asm_tpl
            while qk < srclen {
                if r8(src+qk)==34 { break }
                qk = qk+1
            }
            asm_end = qk
            // 0.0.232 Phase C2: if this asm! has an operand block, bind operand
            // vregs to physical registers (AFTER flush_all — the flush spills
            // live values to their homes; aphys then materializes each operand
            // into a register), substitute %N, and point asm_tpl at the
            // substituted text. Clobber handling: "memory" needs no code here
            // (flush_all already pushed everything to homes = a memory barrier);
            // "cc" likewise needs no code (flags are dead across the asm text).
            let ablk = r64(vreg_asmop + res*8)
            if ablk != 0 {
                let an = r64(ablk+0)
                let aregs = mem_alloc(ASM_MAX_OPS * 8)
                let ak = 0
                while ak < an {
                    let ov = r64(ablk + 16 + ak*32)
                    let occ = r64(ablk + 16 + ak*32 + 8)
                    if occ == ASM_C_I {
                        w64(aregs + ak*8, 0)   // immediates carry no register
                    } else {
                        // "=r" write-only outputs: the vreg has no meaningful
                        // prior value — do NOT load from its spill home. Mark
                        // the vreg uninitialized so aphys allocates WITHOUT a
                        // load. (vr_init is the initialized flag.)
                        if occ == ASM_C_WR { w8(vr_init+ov, 0) }
                        let pr = aphys(ov)
                        w64(aregs + ak*8, pr)
                        // "+r" read-write: the value is in pr, ready.
                        // Register the binding so later aphys calls keep it.
                        sdef(ov, pr)
                    }
                    ak = ak + 1
                }
                let ntpl = asm_substitute(a0+1, qk, ablk, aregs)
                asm_tpl = ntpl
                asm_end = ntpl + (qk - (a0+1)) + 64   // substitution can grow text; bound below
                // recompute the true end: scan for NUL from ntpl
                let qk2 = ntpl
                while r8(src+qk2) != 0 { qk2 = qk2 + 1 }
                asm_end = qk2
                // outputs: after emission, sdef each output so the allocator
                // knows where the value lives. Done below (post-emit) via the
                // block — outputs are bound here already through aphys/sdef.
                // For "=r" the asm writes the register; sdef was set pre-emit
                // and the register still holds the output after the asm — the
                // existing mapping stands.
            }
            let asm_done = asm_try_emit()
            if asm_done == 0 {
            let sp=a0+1  // skip opening quote
            let hi=0; let hn=0; let got=0
            while sp<srclen {
                let c=r8(src+sp)
                if c==34 { break }  // closing quote
                let dv=-1
                if c>=48&&c<=57 { dv=c-48 }
                else if c>=97&&c<=102 { dv=c-87 }
                else if c>=65&&c<=70 { dv=c-55 }
                else if c==32 || c==9 || c==10 || c==13 {  // whitespace: skip
                    sp=sp+1
                    continue
                }
                else {
                    // 0.0.231 Phase C1-T2: not hex and not a known mnemonic
                    // (asm_try_emit already returned 0 to reach here) = the
                    // template is unrecognizable. Fail closed with the plan's
                    // message.
                    let mn = "error: unrecognized asm template\n"; file_write(2, mn+8, len(mn)); exit(1)
                }
                if dv>=0 {
                    if hn==0 { hi=dv; hn=1 } else { eb(hi*16+dv); got=1; hn=0 }
                }
                sp=sp+1
            }
            if hn==1 { let mn = "error: odd number of hex digits in asm! template\n"; file_write(2, mn+8, len(mn)); exit(1) }
            if got==0 { eb(144) }  // empty template -> nop
            }
            // Both paths: result convention is RAX -> result vreg.
            let rd=aphys(res)
            if rd!=0 { rr(rd,0) }   // result convention: RAX -> rd
            sdef(res, rd)
        }
        ii=ii+1
    }
    // A4: leave the next-use context. a4_at < 0 makes a4_pick() return -1, so
    // every allocation after this point (label resolution, the epilogue) uses the
    // original LIFO rule rather than a stale scan position.
    a4_at = 0 - 1
    // F2: leave the liveness context too, so any flush_all() after the emit loop
    // (the epilogue) stores everything exactly as 0.0.249 did.
    f2_ok = 0
    f2_at = 0 - 1

    // Resolve this function's label jumps/branches (ty 0 = jmp, ty 1 = je).
    // Label offsets live in the per-function lblmap, so this must happen before
    // the next function resets it.
    let pk=pstart
    while pk<patchc {
        let pty=r64(patches+pk*PCS+16)
        if pty==0 {
            let ppo=r64(patches+pk*PCS); let plbl=lblf(r64(patches+pk*PCS+8))
            if plbl>=0 { w32(code+ppo+1, plbl-(ppo+5)) }
        } else if pty==1 {
            let ppo=r64(patches+pk*PCS); let plbl=lblf(r64(patches+pk*PCS+8))
            if plbl>=0 { w32(code+ppo+2, plbl-(ppo+6)) }
        } else if pty==3 {
            // catch_ip patch: store the ABSOLUTE vaddr (CODE_VBASE + lblf
            // offset) directly. IR_TRY_PUSH emits a 4-byte `mov rax,imm32`
            // placeholder, so we write w32 (not w64) to fit. This avoids a
            // runtime `add rax,CODE_VBASE` + reload/storeback in IR_THROW,
            // which the 0.0.95 seed silently drops when compiling 0.0.96
            // source (a codegen corruption bug).
            let ppo=r64(patches+pk*PCS); let plbl=lblf(r64(patches+pk*PCS+8))
            if plbl>=0 { w32(code+ppo, code_vbase()+plbl) }
        }
        pk=pk+1
    }

    // Epilogue (should not reach here for normal functions)
    if naked == 1 { ret() } else { abi(4096+total_str+80); xpop(5); ret() }
    // FIX-0.0.7: leave frame context.
    g_in_frame = 0
}

let call_saved = mmap(80)
let mather_saved = mmap(40)

fn init_cs() {
    w64(call_saved+0, 0); w64(call_saved+8, 1); w64(call_saved+16, 2)
    w64(call_saved+24, 6); w64(call_saved+32, 7); w64(call_saved+40, 8)
    w64(call_saved+48, 9); w64(call_saved+56, 10)
    w64(mather_saved+0, 3); w64(mather_saved+8, 12); w64(mather_saved+16, 13)
    w64(mather_saved+24, 14); w64(mather_saved+32, 15)
}

// Global variable addresses for compiler internals (absolute addresses in BSS)
fn init_cglobals() {
    w64(CGLOBALS+0, 4362076160);   // code        = 0x42200000
    w64(CGLOBALS+8, 4362076168);   // codelen     = 0x42200008
    w64(CGLOBALS+16, 4362076176);  // patches     = 0x42200010
    w64(CGLOBALS+24, 4362076184);  // patchc      = 0x42200018
    w64(CGLOBALS+32, 4362076192);  // src         = 0x42200020
    w64(CGLOBALS+40, 4362076200);  // srclen      = 0x42200028
    w64(CGLOBALS+48, 4362076208);  // toks        = 0x42200030
    w64(CGLOBALS+56, 4362076216);  // tokc        = 0x42200038
    w64(CGLOBALS+64, 4362076224);  // tokp        = 0x42200040
    w64(CGLOBALS+72, 4362076232);  // gvars       = 0x42200048
    w64(CGLOBALS+80, 4362076240);  // ginit       = 0x42200050
    w64(CGLOBALS+88, 4362076248);  // gvarc       = 0x42200058
    w64(CGLOBALS+96, 4362076256);  // data        = 0x42200060
    w64(CGLOBALS+104, 4362076264); // data_off    = 0x42200068
    w64(CGLOBALS+112, 4362076272); // lblmap      = 0x42200070
    w64(CGLOBALS+120, 4362076280); // lblc        = 0x42200078
    w64(CGLOBALS+128, 4362076288); // REGS        = 0x42200080
    w64(CGLOBALS+136, 4362076304); // alloc       = 0x422000F0
    w64(CGLOBALS+144, 4362112496); // allocfc     = 0x429DF0
    w64(CGLOBALS+152, 4362112504); // mather_saved= 0x429DF8
}

let CALLER_SAVED = call_saved
