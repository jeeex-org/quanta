    // print: 2-arg print(buf,len) OR 1-arg unified print(x) auto-detecting
    // string vs int via arg0's vreg_is_str tag. In IR_CALL: a1=arg count,
    // a2=arg-start. So argc = ira1(ii); arg0 vreg = irres(ira2(ii)).
    if nl==5&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t' {
        let _pargc = ira1(ii)
        if _pargc==2 {
            // print(buf, len): write(1, buf, len)
            flush_all()
            eb(72); eb(137); eb(242)     // mov rdx, rsi   (count = len)
            eb(72); eb(137); eb(254)     // mov rsi, rdi   (buf = buf)
            eb(191); ei(1)               // mov edi, 1
            eb(184); ei(1)               // mov eax, 1
            sysc(); return 1
        } else {
            let _av = irres(ira2(ii))
            let _aisop = irop(ira2(ii))
            let _isstr = r64(vreg_is_str + _av*8)
            if _isstr!=1 && _aisop==IR_MOV {
                let _srcv = ira0(ira2(ii))
                if r64(vreg_is_str + _srcv*8)==1 { _isstr = 1 }
            }
            if _isstr!=1 && _aisop==IR_STR { _isstr = 1 }
            if _isstr==1 {
                flush_all(); rr(6,7); eb(72); eb(129); eb(198); ei(8); eb(72); eb(139); eb(23); ri(7,1); ri(0,1); sysc(); return 1
            } else {
                flush_all(); let l_pos=nl(); let l_zero=nl(); let l_loop=nl(); let l_done=nl(); let l_signprep=nl(); let l_write=nl()
                rr(0,7); sbi(32); lesp(10, 23); rxor(8,8); rxor(9,9); rr(9,0)
                eb(77); eb(193); eb(233); eb(63); rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, l_pos, 1)
                rneg(0); lbladd(l_pos, codelen); rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, l_zero, 1)
                let p=codelen; jmp32(0); emit_patch(p, l_loop, 0); lbladd(l_zero, codelen)
                eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
                let p=codelen; jmp32(0); emit_patch(p, l_signprep, 0); lbladd(l_loop, codelen)
                rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, l_done, 1); rxor(2,2); ri(1,10); ridiv(1)
                eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
                let p=codelen; jmp32(0); emit_patch(p, l_loop, 0); lbladd(l_done, codelen); lbladd(l_signprep, codelen)
                rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, l_write, 1)
                eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
                lbladd(l_write, codelen); eb(73); eb(141); eb(114); eb(1); rr(2,8); ri(7,1); ri(0,1); sysc(); abi(32); return 1
            }
        }
    }
    // echo(x): 1-arg unified print (same as print). argc = ira1(ii); arg0 = irres(ira2(ii)).
    if nl==4&&r8(nm)=='e'&&r8(nm+1)=='c'&&r8(nm+2)=='h'&&r8(nm+3)=='o' {
        let _ave = irres(ira2(ii))
        let _aeop = irop(ira2(ii))
        let _isstre = r64(vreg_is_str + _ave*8)
        if _isstre!=1 && _aeop==IR_MOV {
            let _esv = ira0(ira2(ii))
            if r64(vreg_is_str + _esv*8)==1 { _isstre = 1 }
        }
        if _isstre!=1 && _aeop==IR_STR { _isstre = 1 }
        if _isstre==1 {
            flush_all(); rr(6,7); eb(72); eb(129); eb(198); ei(8); eb(72); eb(139); eb(23); ri(7,1); ri(0,1); sysc(); return 1
        } else {
            flush_all(); let el_pos=nl(); let el_zero=nl(); let el_loop=nl(); let el_done=nl(); let el_signprep=nl(); let el_write=nl()
            rr(0,7); sbi(32); lesp(10, 23); rxor(8,8); rxor(9,9); rr(9,0)
            eb(77); eb(193); eb(233); eb(63); rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, el_pos, 1)
            rneg(0); lbladd(el_pos, codelen); rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, el_zero, 1)
            let p=codelen; jmp32(0); emit_patch(p, el_loop, 0); lbladd(el_zero, codelen)
            eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            let p=codelen; jmp32(0); emit_patch(p, el_signprep, 0); lbladd(el_loop, codelen)
            rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, el_done, 1); rxor(2,2); ri(1,10); ridiv(1)
            eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            let p=codelen; jmp32(0); emit_patch(p, el_loop, 0); lbladd(el_done, codelen); lbladd(el_signprep, codelen)
            rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, el_write, 1)
            eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            lbladd(el_write, codelen); eb(73); eb(141); eb(114); eb(1); rr(2,8); ri(7,1); ri(0,1); sysc(); abi(32); return 1
        }
    }
    // printi(val): write decimal representation of the integer in rdi to stdout.
    if nl==6&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='i' {
        flush_all()   // spill all live vregs; after this any register is safe to clobber
        let l_pos=nl(); let l_zero=nl(); let l_loop=nl(); let l_done=nl(); let l_signprep=nl(); let l_write=nl()
        rr(0,7)                          // rax = rdi (value)
        sbi(32)                          // sub rsp, 32  (decimal digit buffer)
        lesp(10, 23)                      // r10 = rsp + 23  (direct buffer pointer, high end)
        rxor(8,8)                        // r8 = len = 0
        rxor(9,9)                        // r9 = sign = 0
        rr(9,0)                          // r9 = value (for sign-bit extraction)
        eb(77); eb(193); eb(233); eb(63) // shr r9, 63   (sign bit)
        rtest(9,9)
        let p=codelen; jcc32(0,0); emit_patch(p, l_pos, 1)   // je l_pos (non-negative)
        rneg(0)                          // neg rax (make positive)
        lbladd(l_pos, codelen)
        rtest(0,0)
        let p=codelen; jcc32(0,0); emit_patch(p, l_zero, 1)  // je l_zero (value == 0)
        let p=codelen; jmp32(0); emit_patch(p, l_loop, 0)    // jmp l_loop
        lbladd(l_zero, codelen)
        eb(178); eb(48)                  // mov dl, '0'  (0x30)
        eb(65); eb(136); eb(18)          // mov [r10], dl  (REX.B->r10, reg=2=dl)
        eb(73); eb(255); eb(202)         // dec r10
        eb(73); eb(255); eb(192)         // inc r8
        let p=codelen; jmp32(0); emit_patch(p, l_signprep, 0) // jmp l_signprep
        lbladd(l_loop, codelen)
        rtest(0,0)
        let p=codelen; jcc32(0,0); emit_patch(p, l_done, 1)   // je l_done (no more digits)
        rxor(2,2)                        // xor rdx, rdx
        ri(1,10)                         // rcx = 10
        ridiv(1)                         // rax = quotient, rdx = remainder (digit)
        eb(72); eb(129); eb(194); ei(48) // add rdx, 0x30  (digit -> ascii)
        eb(65); eb(136); eb(18)          // mov [r10], dl  (REX.B->r10, reg=2=dl)
        eb(73); eb(255); eb(202)         // dec r10
        eb(73); eb(255); eb(192)         // inc r8
        let p=codelen; jmp32(0); emit_patch(p, l_loop, 0)     // jmp l_loop
        lbladd(l_done, codelen)
        lbladd(l_signprep, codelen)
        rtest(9,9)
        let p=codelen; jcc32(0,0); emit_patch(p, l_write, 1)  // je l_write (skip if positive)
        eb(178); eb(45)                  // mov dl, '-'  (0x2D)
        eb(65); eb(136); eb(18)          // mov [r10], dl  (REX.B->r10, reg=2=dl)
        eb(73); eb(255); eb(202)         // dec r10
        eb(73); eb(255); eb(192)         // inc r8
        lbladd(l_write, codelen)
        eb(73); eb(141); eb(114); eb(1)  // lea rsi, [r10+1]  (buffer start = rsp+24-len)
        rr(2,8)                          // rdx = r8 (length)
        ri(7,1)                          // rdi = 1 (stdout)
        ri(0,1)                          // rax = 1 (sys_write)
        sysc()
        abi(32)
        return 1
    }
    // println(x): print x followed by a newline. x may be an integer (decimal) or
    // a string (auto-detected via vreg_is_str), mirroring print()/echo() behavior.
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='l'&&r8(nm+6)=='n' {
        flush_all()
        // String auto-detect (mirror print/echo): arg0 vreg = irres(ira2(ii)).
        let _av = irres(ira2(ii))
        let _aop = irop(ira2(ii))
        let _isstr = r64(vreg_is_str + _av*8)
        if _isstr!=1 && _aop==IR_MOV { let _sv=ira0(ira2(ii)); if r64(vreg_is_str + _sv*8)==1 { _isstr = 1 } }
        if _isstr!=1 && _aop==IR_STR { _isstr = 1 }
        if _isstr==1 {
            // write the string bytes (header ptr in rdi), then a newline
            rr(6,7); eb(72); eb(129); eb(198); ei(8); eb(72); eb(139); eb(23); ri(7,1); ri(0,1); sysc()  // writes(s)
            sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)                                  // newline
            rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)
            return 1
        }
        // float auto-detect: resolve arg vreg back through MOV chains to a float builtin.
        let _isf = is_float_vr(_av)
        if _isf!=1 && _aop==IR_MOV { let _sfv=ira0(ira2(ii)); if is_float_vr(_sfv)==1 { _isf = 1 } }
        if _isf==1 {
            flush_all()
            let pos=nl()
            eb(72); eb(137); eb(248)                    // mov rax, rdi  (rdi = float bits from arg loader)
            rr(8,7)                                    // mov r8, rdi (raw float bits -> sign bit 63)
            eb(73); eb(193); eb(232); eb(63)            // shr r8, 63  (sign)
            eb(77); eb(137); eb(193)                    // mov r9, r8  (SAVE sign in r9)
            eb(72); eb(15); eb(186); eb(247); eb(63)    // btr rdi, 63  (clear float sign bit in rdi)
            eb(102); eb(72); eb(15); eb(110); eb(199)   // movq xmm0, rdi   (now positive float)
            ri64(2, 0x412e848000000000)                // 1e6 f64
            eb(102); eb(72); eb(15); eb(110); eb(202)   // movq xmm1, rdx
            eb(242); eb(15); eb(89); eb(193)            // mulsd xmm0, xmm1
            eb(242); eb(72); eb(15); eb(44); eb(192)    // cvttsd2si rax, xmm0  (scaled, positive)
            lbladd(pos, codelen)
            ri64(1, 1000000)
            rxor(2,2)
            eb(72); eb(247); eb(249)                    // idiv rcx (rcx=1000000): rax=ipart, rdx=fpart
            rr(11,0)                                   // mov r11, rax  (ipart)
            rr(0,2)                                    // mov rax, rdx  (rax = fpart)
            rxor(2,2)                                  // rdx = 0
            sbi(32); lesp(10, 23); rxor(8,8)           // buffer + length=0
            // fpart (6 digits, unrolled)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            eb(65); eb(198); eb(2); eb(46); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)   // '.' store
            let ipz=nl(); let iloop=nl(); let idone=nl()
            rr(0,11)                                   // mov rax, r11  (ipart into rax for digit loop)
            eb(72); eb(133); eb(192); let pz=codelen; jcc32(0,0); emit_patch(pz, ipz, 1)   // test rax,rax ; je ipz
            lbladd(iloop, codelen)
            rxor(2,2); ri(1,10); ridiv(1); eb(128); eb(194); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
            eb(72); eb(133); eb(192); let pd=codelen; jcc32(0,0); emit_patch(pd, idone, 1)   // test rax,rax ; je idone
            let pl=codelen; jmp32(0); emit_patch(pl, iloop, 0)
            lbladd(ipz, codelen)
            eb(65); eb(198); eb(2); eb(48); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)   // '0' store (ipart==0)
            lbladd(idone, codelen)
            // sign (use r9, the saved sign flag)
            let sdone=nl(); eb(77); eb(133); eb(201); let p6=codelen; jcc32(0,0); emit_patch(p6, sdone, 1)   // test r9,r9 ; je sdone
            eb(65); eb(198); eb(2); eb(45); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)   // '-' store
            lbladd(sdone, codelen)
            eb(73); eb(141); eb(114); eb(1)             // lea rsi, [r10+1]
            rr(2,8); ri(7,1); ri(0,1); sysc()           // write float
            sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
            rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)   // newline
            abi(32)
            return 1
        }
        // integer path

        let lp_pos=nl(); let lp_zero=nl(); let lp_loop=nl(); let lp_done=nl(); let lp_signprep=nl(); let lp_write=nl()
        rr(0,7)                          // rax = rdi (value)
        sbi(32)                          // sub rsp, 32
        lesp(10, 23)                     // r10 = rsp + 23
        rxor(8,8); rxor(9,9); rr(9,0)
        eb(77); eb(193); eb(233); eb(63) // shr r9, 63
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp_pos, 1)   // je lp_pos (non-negative)
        rneg(0)                          // neg rax
        lbladd(lp_pos, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp_zero, 1)   // je lp_zero (value == 0)
        let p=codelen; jmp32(0); emit_patch(p, lp_loop, 0)                // jmp lp_loop
        lbladd(lp_zero, codelen)
        eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192) // '0', dec r10, inc r8
        let p=codelen; jmp32(0); emit_patch(p, lp_signprep, 0)            // jmp lp_signprep
        lbladd(lp_loop, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp_done, 1)   // je lp_done
        rxor(2,2); ri(1,10); ridiv(1)
        eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp_loop, 0)                // jmp lp_loop
        lbladd(lp_done, codelen); lbladd(lp_signprep, codelen)
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp_write, 1)  // je lp_write (skip if positive)
        eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192) // '-'
        lbladd(lp_write, codelen)
        eb(73); eb(141); eb(114); eb(1)   // lea rsi, [r10+1]
        rr(2,8); ri(7,1); ri(0,1); sysc()  // write integer
        // write '\n'
        sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)
        abi(32)
        return 1
    }
    // newline(): emit a single '\n' to stdout.
    if nl==7&&r8(nm)=='n'&&r8(nm+1)=='e'&&r8(nm+2)=='w'&&r8(nm+3)=='l'&&r8(nm+4)=='i'&&r8(nm+5)=='n'&&r8(nm+6)=='e' {
        flush_all()
        sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)
        return 1
    }
    // printsp(i): print integer i followed by a space.
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s'&&r8(nm+6)=='p' {
        flush_all(); let lp3_pos=nl(); let lp3_zero=nl(); let lp3_loop=nl(); let lp3_done=nl(); let lp3_signprep=nl(); let lp3_write=nl()
        rr(0,7); sbi(32); lesp(10,23); rxor(8,8); rxor(9,9); rr(9,0)
        eb(77); eb(193); eb(233); eb(63); rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp3_pos, 1)
        rneg(0); lbladd(lp3_pos, codelen); rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp3_zero, 1)
        let p=codelen; jmp32(0); emit_patch(p, lp3_loop, 0); lbladd(lp3_zero, codelen)
        eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp3_signprep, 0); lbladd(lp3_loop, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp3_done, 1); rxor(2,2); ri(1,10); ridiv(1)
        eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp3_loop, 0); lbladd(lp3_done, codelen); lbladd(lp3_signprep, codelen)
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp3_write, 1)
        eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        lbladd(lp3_write, codelen); eb(73); eb(141); eb(114); eb(1); rr(2,8); ri(7,1); ri(0,1); sysc()
        sbi(8); lesp(10,0); eb(178); eb(32); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8); abi(32); return 1
    }
    // prints(s): write header-string s (bytes at s+8, length len(s)) to stdout.
    if nl==6&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s' {
        flush_all()
        rr(6,7)                          // rsi = rdi (string ptr)
        eb(72); eb(129); eb(198); ei(8)  // rsi = ptr + 8 (byte start)  [modrm 0xC6 = add rsi, imm32]
        eb(72); eb(139); eb(23)          // rdx = [rdi] = len(s) (count)  [modrm 0x17 = mov rdx,[rdi]]
        ri(7,1); ri(0,1); sysc()         // sys_write(1, ptr+8, len)
        return 1
    }
    // --- Phase A1: unsigned arithmetic builtins (true unsigned x86) ---
    // IR_CALL has already flush_all()'d and loaded a=rdi, b=rsi. Do NOT call
    // flush_all() again here: emit_bltn's scratch spill relocates rsi -> rbx,
    // corrupting arg1. Use rdi/rsi directly.
    // udiv(a,b): unsigned a/b.
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='d'&&r8(nm+2)=='i'&&r8(nm+3)=='v' {
        rr(0,7)                            // rax = rdi = a (dividend low)
        rxor(2,2)                          // xor edx,edx (clear dividend high)
        eb(72); eb(247); eb(246)           // 48 F7 F6 = div rsi  (rax = a/b unsigned)
        return 1
    }
    // umod(a,b): unsigned a%b
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='m'&&r8(nm+2)=='o'&&r8(nm+3)=='d' {
        rr(0,7)                            // rax = rdi = a
        rxor(2,2)
        eb(72); eb(247); eb(246)           // div rsi
        rr(0,2)                            // rax = rdx (remainder)
        return 1
    }
    // ult/ugt/ulte/ugte(a,b): unsigned compares -> 0/1 in rax (low byte)
    // a=rdi(7), b=rsi(6); rcmp(r1,r2)=cmp r1,r2.
    // UNSIGNED setcc (rsetc uses the SIGNED setl/setg, so emit bytes directly).
    // Each setcc is "0F OP C0" = eb(15); eb(OP); mr(3,0,0)  (setX %al)
    //   0F 92=setb(<)  0F 97=seta(>)  0F 96=setbe(<=)  0F 93=setae(>=)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t' {
        rxor(0,0); rcmp(7,6); eb(15); eb(146); mr(3,0,0); return 1
    }
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t' {
        rxor(0,0); rcmp(7,6); eb(15); eb(151); mr(3,0,0); return 1
    }
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t'&&r8(nm+3)=='e' {
        rxor(0,0); rcmp(7,6); eb(15); eb(150); mr(3,0,0); return 1
    }
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t'&&r8(nm+3)=='e' {
        rxor(0,0); rcmp(7,6); eb(15); eb(147); mr(3,0,0); return 1
    }
    if nl==3&&r8(nm)=='l'&&r8(nm+1)=='e'&&r8(nm+2)=='n' {
        rmr(0,7); return 1
    }
    // u8/u32/u64(x): reinterpret x as unsigned of N bits (mask). Identity at the
    // 64-bit runtime; the mask bounds the value to the named unsigned width so
    // unsigned arithmetic/comparisons stay in range. Self-host neutral (emit is a
    // mov+and, well-defined regardless of optimizer state).
    if nl==2&&r8(nm)=='u'&&r8(nm+1)=='8' { flush_all(); rr(0,7); eb(72); eb(129); mr(3,4,0); ei(255); return 1 }   // rax=rdi; and rax,0xFF (0x81 imm32: 0xFF sign-extends, so MUST use imm32 form)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='3'&&r8(nm+2)=='2' { flush_all(); rr(0,7); eb(37); eb(255); eb(255); eb(255); eb(255); return 1 }  // and eax,0xFFFFFFFF (opcode 0x25 + imm32)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='6'&&r8(nm+2)=='4' { flush_all(); rr(0,7); return 1 }                          // 64-bit: identity (mov rax,rdi)
    // str(a,b): a=rdi, b=rsi. returns header ptr (len at [new], bytes at new+8)
    if nl==3&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // r13 = lb
        rr(7,15); ra(7,13) // rdi = la + lb = total
        eb(72);eb(255);eb(199)   // inc rdi -> total+1
        eb(72);eb(131);eb(199);eb(8)  // rdi += 8 -> size = total+9
        rr(6,7)            // rsi = size
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail guard: if rax<0 exit(1)
        rr(12,0)           // r12 = new
        rr(0,15); ra(0,13) // rax = total
        rr(7,12); eb(72);eb(137);eb(7)   // [new] = total
        // copy la bytes a+8 -> new+8
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = a+8 (rbx+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,15); eb(243);eb(164)    // rcx = la; rep movsb
        // copy lb bytes b+8 -> new+8+la
        rr(6,14); eb(72);eb(131);eb(198);eb(8)  // rsi = b+8 (r14+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,15)          // rdi += r15 (la) -- dest for b's bytes = new+8+la
        rr(1,13); eb(243);eb(164)    // rcx = lb; rep movsb
        // nul at new+8+total
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,15)          // rdi += r15 (la)
        ra(7,13)          // rdi += r13 (lb)
        eb(198);eb(7);eb(0)    // mov byte [rdi], 0  (C6 07 00)
        rr(0,12)           // rax = new
        return 1
    }
    // str_eq(a,b): compare two strings. a=rdi,b=rsi. Returns 1 if equal, 0 if not.
    // Header: [ptr]=len, bytes at ptr+8. Manual byte loop (repe cmpsb is broken in Quanta).
    // 'mov al,[rsi]' writes al (low byte of rax), so only set rax at the returns.
    // SINGLE 'return 1' (builtin exit); both paths converge: EQUAL sets rax=1,
    // MISMATCH uses rxor(0,0); a jmp32 skips the unneeded half. Offsets filled post-measure.
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r'&&r8(nm+3)=='_'&&r8(nm+4)=='e'&&r8(nm+5)=='q' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // rbp = lb  (13↔rbp under %8)
        rcmp(13,15)        // cmp rbp, r15  (lb vs la)
        jcc32(1, 54)       // jne -> lengths differ -> forward to MISMATCH (rxor)
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = a+8
        rr(7,14); eb(72); eb(131); eb(199); eb(8)   // rdi = b+8
        rr(1,15)           // rcx = la
        eb(138); eb(6)     // LOOP: mov al, [rsi]
        eb(58); eb(7)      // cmp al, [rdi]
        jcc32(1, 27)       // jne -> mismatch -> forward to MISMATCH (rxor)
        eb(72); eb(255); eb(198)   // inc rsi
        eb(72); eb(255); eb(199)   // inc rdi
        eb(72); eb(255); eb(201)   // dec rcx
        jcc32(1, -25)      // jne -> loop back (rcx!=0)  (backward)
        eb(72); eb(199); eb(192); eb(1); eb(0); eb(0); eb(0)   // mov rax, 1 (EQUAL)
        jmp32(3)           // jmp forward to END (skip rxor)
        rxor(0,0)          // MISMATCH: rax = 0
        return 1           // END: auto-ret
    }
    // str_ne(a,b): returns 1 if NOT equal, 0 if equal.
    if nl==6&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r'&&r8(nm+3)=='_'&&r8(nm+4)=='n'&&r8(nm+5)=='e' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // rbp = lb
        rcmp(13,15)        // cmp rbp, r15  (lb vs la)
        jcc32(1, 50)       // jne -> lengths differ -> forward to NOT-EQUAL (mov rax,1)
        rr(6,3); eb(72); eb(131); eb(198); eb(8)   // rsi = a+8
        rr(7,14); eb(72); eb(131); eb(199); eb(8)   // rdi = b+8
        rr(1,15)           // rcx = la
        eb(138); eb(6)     // LOOP: mov al, [rsi]
        eb(58); eb(7)      // cmp al, [rdi]
        jcc32(1, 23)       // jne -> mismatch -> forward to NOT-EQUAL (mov rax,1)
        eb(72); eb(255); eb(198)   // inc rsi
        eb(72); eb(255); eb(199)   // inc rdi
        eb(72); eb(255); eb(201)   // dec rcx
        jcc32(1, -25)      // jne -> loop back (rcx!=0)  (backward)
        rxor(0,0)          // EQUAL: rax = 0
        jmp32(7)           // jmp forward to END (skip mov rax,1)
        eb(72); eb(199); eb(192); eb(1); eb(0); eb(0); eb(0)   // NOT-EQUAL: mov rax, 1
        return 1           // END: auto-ret
    }
    // qc_sys_cmd(cmd): run external command, return CmdResult{out,code,err} struct.
    // cmd=rdi = header ptr (len at [cmd], bytes at cmd+8). Returns heap struct:
    //   [0]  = len (24)
    //   [8]  = out_ptr (string header ptr, or 0 if empty)
    //   [16] = code    (i64, exit status)
    //   [24] = err_ptr (0; stderr not captured in this minimal impl)
    if nl==10&&r8(nm)=='q'&&r8(nm+1)=='c'&&r8(nm+2)=='_'&&r8(nm+3)=='s'&&r8(nm+4)=='y'&&r8(nm+5)=='s'&&r8(nm+6)=='_'&&r8(nm+7)=='c'&&r8(nm+8)=='m'&&r8(nm+9)=='d' {
        flush_all()
        // 0.0.55: load the cmd. Two cases:
        //   - compile-time string literal: its data-section address is in
        //     lit_addr[cmd_vreg] (populated by IR_STR codegen) and is non-zero.
        //   - runtime variable (e.g. let s="..."; $$(s)) or fn param: the string
        //     pointer lives in the vreg's home slot at runtime -> spill_home(cmd).
        // Discriminate by whether lit_addr[cmd] is populated (non-zero), since a
        // literal's address is always known, while a variable's may not be.
        let _cmdv = ira1(ii)
        if r64(lit_addr + _cmdv*8) != 0 {
            ri64(7, r64(lit_addr + _cmdv*8))      // literal: known data address
        } else {
            rbp(7, spill_home(_cmdv))             // variable/fn-param: runtime ptr
        }
        let l_parent=nl(); let l_rdbrk=nl(); let l_disc=nl()
        // Preserve callee-saved regs (r12-r15) per x86-64 ABI — this builtin
        // clobbers them, so save/restore to avoid corrupting caller state (e.g.
        // the result struct ptr held in r12 by the caller).
        eb(65); eb(84)   // push r12  (41 54)
        eb(65); eb(85)   // push r13  (41 55)
        eb(65); eb(86)   // push r14  (41 56)
        eb(65); eb(87)   // push r15  (41 57)
        // SAVE cmd (rdi) FIRST — every syscall below clobbers rdi. r14 = cmd+8 (bytes ptr).
        rr(14,7); ri(8,8); ra(14,8)
        // Allocate result struct: mmap(0, 48, RW, ANON|PRIVATE, -1, 0). The extra
        // 16 bytes past the 32-byte [len,out,code,err] header serve as the .err
        // buffer (zero-filled by mmap -> len 0 -> ""). err_ptr points at this
        // in-struct tail, so it is always a valid runtime address (no separate
        // mmap / register-clobber pitfalls).
        ri(6,48); ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()
        rr(12,0)           // r12 = result struct ptr (rax)
        // struct field access uses IR_IDX => load [base + idx*8 + 8].
        // So fields live at out@8, code@16, err@24; [0] is a len header.
        ri(0,24); stx(12,0,0)   // [r12+0] = 24 (len)
        stx(12,8,0)        // [r12+8] = 0 (out_ptr)
        stx(12,16,0)       // [r12+16] = 0 (code)
        // 0.0.55: .err returns a VALID empty string (stderr is not captured in
        // this minimal impl). The result struct was mmap'd as 48 bytes; the 16
        // bytes past the 32-byte header [r12+32..r12+48] serve as the .err buffer
        // (zero-filled by mmap -> len 0 -> ""). Point err_ptr at this in-struct
        // tail: it is always a valid runtime address.
        rr(0,12); ri(8,32); ra(0,8)   // r0 = r12 + 32 (err buffer inside struct)
        stx(12,24,0)       // [r12+24] = err_ptr -> "" (in-struct, zero-filled)
        // output string buffer (header + 4096 bytes): mmap(0, 4104, ...)
        ri(6,4104); ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()
        rr(15,0)           // r15 = out_buf (rax)
        // scratch S for argv/envp (4096 bytes)
        ri(6,4096); ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()
        rr(13,0)           // r13 = S
        // [S+16] = "/bin/sh\0"  (two 32-bit stores; ri is 32-bit so split the 8-byte literal)
        wmi(13,16,0x6e69622f)   // low:  "/bin"
        wmi(13,20,0x0068732f)   // high: "/sh\0"
        // [S+32] = "-c\0\0\0\0"
        wmi(13,32,0x0000632d)   // "-c\0\0"
        // r14 already = cmd+8 (saved at builtin entry before rdi was clobbered)
        // argv array at S+1024: [S+1024]=S+16, [S+1032]=S+32, [S+1040]=r14, [S+1048]=0
        rr(10,13); ri(8,16); ra(10,8); stx(13,1024,10)   // [S+1024] = S+16
        rr(10,13); ri(8,32); ra(10,8); stx(13,1032,10)   // [S+1032] = S+32
        stx(13,1040,14)                     // [S+1040] = r14
        ri(10,0);  stx(13,1048,10)          // [S+1048] = 0
        // pipe(S+2048): rdi = S+2048 (pipefd array; [S+2048]=read, [S+2052]=write)
        rr(7,13); ri(8,2048); ra(7,8); ri(0,22); sysc()   // pipe(S+2048)
        // fork() -> rax (0=child, >0=parent). fork = rax=57, rdi=0
        ri(0,57); ri(7,0); sysc()
        rtest(0,0); let pj=codelen; jcc32(3,0); emit_patch(pj, l_parent, 1)   // jg -> parent (rax>0)
        // ===== CHILD (rax==0) =====
        // dup2(write_fd=[S+2052], 1): rdi=[S+2052], rsi=1
        ldx(7,13,2052); ri(6,1); ri(0,33); sysc()     // dup2(write_fd, 1)
        // execve("/bin/sh", argv_array, 0): rdi = S+16 (path), rsi = S+1024 (argv), rdx = 0
        rr(7,13); ri(8,16); ra(7,8)      // rdi = S+16
        rr(6,13); ri(8,1024); ra(6,8)    // rsi = S+1024 (argv array)
        ri(2,0); ri(0,59); sysc()        // execve (rdx/envp=0)
        ri(7,127); ri(0,60); sysc()          // execve failed -> exit(127)
        // ===== PARENT =====
        lbladd(l_parent, codelen)
        // close write end so EOF propagates when child exits
        ldx(7,13,2052); ri(0,3); sysc()     // close(write_fd)
        // read loop: accumulate child output into out_buf+8, total len in r9
        rxor(9,9)                            // r9 = total = 0
        let l_rd=nl()
        lbladd(l_rd, codelen)
        // 0.0.55: cap output at the 4096-byte buffer. If total >= 4096 the buffer
        // is full; keep DRAINING the pipe (discard) so the child is not blocked on
        // a full pipe (which would hang wait4 forever). We never store past 4096.
        let _pjcap = codelen
        eb(73); eb(129); eb(249); ei(4096)   // cmp r9, 4096  (49 81 F9 00001000)
        let _pjcap2 = codelen
        jcc32(5, 0); emit_patch(_pjcap2, l_disc, 1)  // jge -> discard path
        ldx(7,13,2048)                       // rdi = read_fd
        rr(6,15); ri(8,8); ra(6,9); ra(6,8)  // rsi = out_buf + 8 + total
        ri(10,4096); rs(10,9)            // rdx = 4096 - total
        ri(0,0); sysc()                      // read -> rax = n
        rtest(0,0); let pj2=codelen; jcc32(4,0); emit_patch(pj2, l_rdbrk, 1)  // jle -> break (n<=0)
        ra(9,0)                              // total += n (rax=n)
        let pj3=codelen; jmp32(0); emit_patch(pj3, l_rd, 0)
        // discard path: read into out_buf+8 (overwrite, stays within 4096),
        // do NOT advance total. Keeps the pipe drained until child EOF.
        lbladd(l_disc, codelen)
        ldx(7,13,2048)                       // rdi = read_fd
        rr(6,15); ri(8,8); ra(6,8)           // rsi = out_buf + 8 (fixed; within buf)
        ri(10,4096); rs(10,0)            // rdx = 4096 (dummy; never stored)
        ri(0,0); sysc()                      // read -> rax = n
        rtest(0,0); let pj4=codelen; jcc32(4,0); emit_patch(pj4, l_rdbrk, 1)  // jle -> break
        jmp32(0); emit_patch(codelen-5, l_disc, 0)
        lbladd(l_rdbrk, codelen)
        // set output string header: [out_buf] = total (len). rax is 0 here (n<=0).
        rr(7,15); stx(7,0,9)  // [out_buf+0] = total (r9)
        // wait4(-1, &status@S+2064, 0, 0): rdi=-1, rsi=S+2064 (ADDRESS, not value)
        rr(6,13); ri(8,2064); ra(6,8)    // rsi = S+2064
        ri(7,-1); ri(2,0); ri(10,0); ri(0,61); sysc()   // rdi=-1, rdx=0, r10=0, wait4
        // extract exit code: code = (status >> 8) & 0xff  (WEXITSTATUS)
        ldx(6,13,2064)                    // r6 = status (low 32)
        eb(72); eb(193); eb(238); eb(8)   // shr r6, 8   (48 C1 EE 08)
        eb(72); eb(131); eb(230); eb(255) // and r6, 0xff (48 83 E6 FF)
        stx(12,16,6)      // [r12+16] = code
        stx(12,8,15)      // [r12+8] = out_buf (out_ptr)
        // NOTE: [r12+24] (err_ptr) is set earlier to the empty-string buffer
        // (in-struct tail, line ~1205); do NOT overwrite it with 0 here.
        // munmap S (4096): rdi=S, rsi=4096, rax=11
        rr(7,13); ri(8,4096); ri(0,11); sysc()
        rr(0,12)           // rax = result struct ptr
        // restore callee-saved regs
        eb(65); eb(95)   // pop r15  (41 5F)
        eb(65); eb(94)   // pop r14  (41 5E)
        eb(65); eb(93)   // pop r13  (41 5D)
        eb(65); eb(92)   // pop r12  (41 5C)
        return 1
    }
    // NOTE: a user-defined fn push(...) MUST win over this builtin. If a user fn
    // named "push" exists, this is not the builtin -> return 0 so the IR_CALL
    // handler emits a real (patched) call to the user function instead.
    if nl==4&&r8(nm)=='p'&&r8(nm+1)=='u'&&r8(nm+2)=='s'&&r8(nm+3)=='h' {
        if findfn(nmi,nl)>=0 { return 0 }
        flush_all()
        rr(3,7)            // rbx = v
        rr(13,6)           // r13 = e
        rmr(14,3)          // r14 = oldlen = [v]
        rr(7,14)           // rdi = oldlen
        eb(72);eb(131);eb(199);eb(9)      // add rdi, 9 -> size = oldlen+1(byte)+8(header) (48 83 C7 09)
        rr(6,7)            // rsi = size
        ri(7,0); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        eb(72); eb(131); eb(248); eb(0); eb(125); eb(12); eb(191); ei(1); eb(184); ei(60); eb(15); eb(5)  // mmap-fail guard: if rax<0 exit(1)
        rr(12,0)           // r12 = new
        rr(0,14); eb(72);eb(255);eb(192)  // rax = oldlen+1 = newlen (inc rax -> 48 FF C0)
        rr(7,12); eb(72);eb(137);eb(7)    // [new] = newlen
        // copy oldlen bytes v+8 -> new+8 via rep movsb
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = v+8 (rbx+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,14); eb(243);eb(164)               // rcx = oldlen; rep movsb
        // store byte e at new+8+oldlen
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,14)          // rdi += r14 (oldlen) -> new+8+oldlen
        eb(68);eb(136);eb(47)  // mov [rdi], r13b  (44 88 2F: REX.R->r13, byte store)
        rr(0,12)           // rax = new
        return 1
    }
    // pop(v): remove last byte, return it (or 0 if empty). byte-oriented (matches str). v=rdi.
    // Same user-wins guard as push: a user-defined fn pop(...) shadows this builtin.
    if nl==3&&r8(nm)=='p'&&r8(nm+1)=='o'&&r8(nm+2)=='p' {
        if findfn(nmi,nl)>=0 { return 0 }
        flush_all()
        rr(3,7)            // rbx = v
        rmr(14,3)          // r14 = oldlen
        let lz=nl(); let lret=nl()
        rtest(14,14)
        let p=codelen; jcc32(0,0); emit_patch(p, lz, 1)  // je lz (empty)
        rr(7,3)            // rdi = v
        eb(72);eb(131);eb(199);eb(7)   // add rdi, 7 (48 83 C7 07)
        ra(7,14)          // rdi += r14 (oldlen) -> v+7+oldlen = &last byte
        eb(72);eb(15);eb(182);eb(7)    // movzx rax, byte [rdi] (48 0F B6 07)
        rr(15,0)          // r15 = elem (save)
        rr(7,3)           // rdi = v
        rr(0,14); eb(72);eb(131);eb(232);eb(1)  // rax = oldlen-1 (sub rax,1)
        eb(72);eb(137);eb(7)   // [v] = rax
        rr(0,15)          // rax = elem
        let p2=codelen; jmp32(0); emit_patch(p2, lret, 0)
        lbladd(lz, codelen)
        rxor(0,0)         // rax = 0
        lbladd(lret, codelen)
        return 1
    }
    // argc(): return saved variadic arg count (frame-local, set by prologue).
    if nl==4&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g'&&r8(nm+3)=='c' {
        rbp(0, g_va_cnt_off)   // rax = [rbp + g_va_cnt_off]
        return 1
    }
    // arg(i): return variadic arg i (0-based, includes named params).
    //   i < 6  -> saved reg-arg area:  [r11 + g_va_reg_off + i*8]
    //   i >= 6 -> stack arg still there: [r11 + 16 + (i-6)*8]   (r11 = rbp)
    // i arrives in rdi (arg0). PRESERVE rdi (loop var) via push/pop.
    if nl==3&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g' {
        let lstack=nl(); let ldone=nl()
        eb(72); eb(129); mr(3,7,7); ei(6)   // cmp rdi, 6 (immediate)
        let p=codelen; jcc32(2, 0); emit_patch(p, lstack, 1)  // jl lstack (i<6)
        // --- i >= 6: r11 = rbp + 16 + (i-6)*8 ---
        eb(87)                          // push rdi (preserve index)
        rr(11, 5)                       // r11 = rbp
        eb(73); eb(129); mr(3,0,3); ei(16)   // add r11, 16
        rr(1, 7)                        // rcx = rdi (i)
        eb(72); eb(131); mr(3,5,1); eb(6)    // sub rcx, 6   -> rcx = i - 6
        eb(72); eb(193); eb(225); eb(3) // shl rcx, 3  (48 C1 E1 03) -> (i-6)*8
        ra(11, 1)                       // r11 += rcx
        lbase(0, 0)                     // rax = [r11]
        eb(95)                          // pop rdi
        let p1=codelen; jmp32(0); emit_patch(p1, ldone, 0)
        lbladd(lstack, codelen)
        // --- i < 6: r11 = rbp + g_va_reg_off + i*8 ---
        eb(87)                          // push rdi (preserve index)
        rr(11, 5)                       // r11 = rbp
        eb(73); eb(129); mr(3,0,3); ei(g_va_reg_off)  // add r11, g_va_reg_off
        eb(72); eb(193); eb(231); eb(3) // shl rdi, 3  (48 C1 E7 03) -> i*8
        ra(11, 7)                       // r11 += rdi
        lbase(0, 0)                     // rax = [r11]
        eb(95)                          // pop rdi
        lbladd(ldone, codelen)
        return 1
    }
    // P2: proc/env builtins (syscall-based)
    // getpid(): sc 39
    if nl==6&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='p'&&r8(nm+4)=='i'&&r8(nm+5)=='d' {
        flush_all()
        ri(0,39); sysc(); return 1
    }
    // getppid(): sc 110
    if nl==7&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='p'&&r8(nm+4)=='p'&&r8(nm+5)=='i'&&r8(nm+6)=='d' {
        flush_all()
        ri(0,110); sysc(); return 1
    }
    // arg_count(): process argv count (argc) -> load g_argc via RIP-relative
    if nl==9&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g'&&r8(nm+3)=='_'&&r8(nm+4)=='c'&&r8(nm+5)=='o'&&r8(nm+6)=='u'&&r8(nm+7)=='n'&&r8(nm+8)=='t' {
        let rd=aphys(0)
        let rex=72; if rd>=8 { rex=76 }
        eb(rex); eb(139); eb(5 + (rd%8)*8); ei(0)
        let pofs=codelen-4
        w64(gpatches+gpatchc*24, pofs)
        w64(gpatches+gpatchc*24+8, g_argc)
        w8(gpatches+gpatchc*24+16, 0)
        if gpatchc >= GPATCH_CAP { emit_ovf() }
        gpatchc=gpatchc+1
        sdef(0, rd)
        return 1
    }
    // environ(): return g_environ pointer
    if nl==8&&r8(nm)=='e'&&r8(nm+1)=='n'&&r8(nm+2)=='v'&&r8(nm+3)=='i'&&r8(nm+4)=='r'&&r8(nm+5)=='o'&&r8(nm+6)=='n' {
        let rd=aphys(0)
        let rex=72; if rd>=8 { rex=76 }
        eb(rex); eb(139); eb(5 + (rd%8)*8); ei(0)
        let pofs=codelen-4
        w64(gpatches+gpatchc*24, pofs)
        w64(gpatches+gpatchc*24+8, g_environ)
        w8(gpatches+gpatchc*24+16, 0)
        if gpatchc >= GPATCH_CAP { emit_ovf() }
        gpatchc=gpatchc+1
        sdef(0, rd)
        return 1
    }
    // getenv(name): uses g_environ
    if nl==6&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='e'&&r8(nm+4)=='n'&&r8(nm+5)=='v' {
        flush_all()
        // getenv is complex - for now return 0
        let vr=aphys(0)
        ri(vr, 0)
        sdef(vr, vr)
        return 1
    }
    // getc(): read 1 byte from stdin, return it (0 on EOF). Stack scratch buffer.
    if nl==4&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='c' {
        flush_all()
        eb(72); eb(131); eb(236); eb(16)      // sub rsp, 16  (scratch) - imm8
        ri(7, 0)                                // rdi = 0 (stdin)
        eb(72); eb(137); eb(230)               // mov rsi, rsp (buf)
        ri(2, 1)                               // rdx = 1
        eb(184); ei(0); sysc()                 // read(0, rsp, 1)
        eb(72); eb(15); eb(182); eb(4); eb(36) // movzx eax, byte [rsp]
        eb(72); eb(131); eb(196); eb(16)       // add rsp, 16  - imm8
        sdef(0, 0); return 1
