    // ---- P2: float comparison builtins (SSE, return int 0/1, BRANCHLESS via setcc) ----
    // All comparisons use comisd (66 0F 2F) then a setcc to avoid jump/label patching.
    // NOTE: ucomisd (F2 0F 2E) triggers #UD in this target environment, so comisd is used.
    // comisd result flags:  a<b => CF=1,ZF=0 ; a==b => ZF=1 ; unordered => CF=ZF=PF=1
    // feq(a,b): ordered-equal. comisd sets ZF=1 for equal OR unordered, CF=1 for
    // a<b/unordered. Ordered-equal = ZF=1 AND CF=0 = sete AND setae. NOTE: do NOT
    // insert xor eax,eax here -- it sets ZF and clobbers the comisd flags.
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='e'&&r8(nm+2)=='q' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi
        eb(102); eb(72); eb(15); eb(110); eb(206)  // movq xmm1, rsi
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(148); eb(192)                   // sete al  (ZF=1)
        eb(15); eb(147); eb(193)                   // setae cl (CF=0)
        eb(32); eb(200)                            // and al, cl (20 C8) -> 1 only if ZF=1 AND CF=0
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // flt(a,b): a<b
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='l'&&r8(nm+2)=='t' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(72); eb(15); eb(110); eb(206)
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(146); eb(192)                   // setb al  (CF=1,ZF=0 => a<b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fle(a,b): a<=b
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='l'&&r8(nm+2)=='e' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(72); eb(15); eb(110); eb(206)
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(150); eb(192)                   // setbe al (CF=1 or ZF=1 => a<=b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fgt(a,b): a>b  (comisd a,b then seta)
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='g'&&r8(nm+2)=='t' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)  // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0(=a), xmm1(=b)
        eb(15); eb(151); eb(192)                   // seta al (CF=0,ZF=0 => a>b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fge(a,b): a>=b  (comisd a,b then setae)
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='g'&&r8(nm+2)=='e' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)  // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)
        eb(15); eb(147); eb(192)                   // setae al (CF=0 => a>=b)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fisnan(a): unordered (PF=1)
    if nl==6&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='s'&&r8(nm+3)=='n'&&r8(nm+4)=='a'&&r8(nm+5)=='n' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi
        eb(102); eb(15); eb(47); eb(192)          // comisd xmm0, xmm0 (nan => PF=1)
        eb(15); eb(154); eb(192)                   // setp al (PF=1 => nan)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // fisinf(a): abs(a)==inf
    if nl==6&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='s'&&r8(nm+3)=='i'&&r8(nm+4)=='n'&&r8(nm+5)=='f' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)  // movq xmm0, rdi
        ri(0, 0x7FF0000000000000)
        eb(102); eb(72); eb(15); eb(110); eb(192)  // movq xmm1, rax (inf bits)
        eb(102); eb(15); eb(80); eb(193)          // andpd xmm0, xmm1 (abs)
        eb(102); eb(72); eb(15); eb(110); eb(192)  // movq xmm1, rax
        eb(102); eb(15); eb(47); eb(193)          // comisd xmm0, xmm1
        eb(15); eb(148); eb(192)                   // sete al (equal => inf)
        eb(15); eb(182); eb(192)                   // movzx eax, al
        return 1
    }
    // ---- P2: math builtins (SSE, f64 bit-pattern in/out) ----
    // sqrt(a): a=rdi
    if nl==4&&r8(nm)=='s'&&r8(nm+1)=='q'&&r8(nm+2)=='r'&&r8(nm+3)=='t' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)      // movq xmm0, rdi
        eb(242); eb(15); eb(81); eb(192)               // sqrtsd xmm0, xmm0 (F2 0F 51 C0)
        eb(102); eb(72); eb(15); eb(126); eb(192)      // movq rax, xmm0
        return 1
    }
    // floor(a), ceil(a): use roundsd
    if nl==5&&r8(nm)=='f'&&r8(nm+1)=='l'&&r8(nm+2)=='o'&&r8(nm+3)=='o'&&r8(nm+4)=='r' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(15); eb(58); eb(11); eb(192); eb(1)  // roundsd xmm0, xmm0, 1 (66 0F 3A 0B C0 01)
        eb(102); eb(72); eb(15); eb(126); eb(192)
        return 1
    }
    if nl==4&&r8(nm)=='c'&&r8(nm+1)=='e'&&r8(nm+2)=='i'&&r8(nm+3)=='l' {
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199)
        eb(102); eb(15); eb(58); eb(11); eb(192); eb(2)  // roundsd xmm0, xmm0, 2 (66 0F 3A 0B C0 02)
        eb(102); eb(72); eb(15); eb(126); eb(192)
        return 1
    }
    // abs(a) for f64: clear sign bit
    if nl==3&&r8(nm)=='a'&&r8(nm+1)=='b'&&r8(nm+2)=='s' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        eb(72); eb(137); eb(192)           // mov rax, rdi
        ri64(1, 0x7FFFFFFFFFFFFFFF)        // mov rcx, mask
        eb(72); eb(33); eb(200)            // and rax, rcx (48 21 C8)
        return 1
    }
    // ---- P2: fmin / fmax (SSE, branchless via comisd + cmov) ----
    // fmin(a,b): a=rdi, b=rsi. result = (b<a) ? b : a  (NaN -> a, like C fmin)
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='m'&&r8(nm+2)=='i'&&r8(nm+3)=='n' {
        flush_all()
        let arg0v = irres(ira2(ii))
        let arg1v = irres(ira2(ii)+1)
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        rbp(6, spill_home(arg1v))                     // rsi = b (arg1 from spill home)
        eb(102); eb(72); eb(15); eb(110); eb(199)   // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)   // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)           // comisd xmm0, xmm1 (a vs b)
        eb(15); eb(147); eb(192)                   // setae al (CF=0 => a>=b)
        rzx(0, 0)                                  // movzx eax, al
        rr(0, 7)                                   // mov rax, rdi (default a)
        rr(2, 6)                                   // mov rdx, rsi (b)
        rcmov(0, 0, 2)                             // cmovae rax, rdx (a>=b keep a else b) => min
        return 1
    }
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='m'&&r8(nm+2)=='a'&&r8(nm+3)=='x' {
        flush_all()
        let arg0v = irres(ira2(ii))
        let arg1v = irres(ira2(ii)+1)
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        rbp(6, spill_home(arg1v))                     // rsi = b (arg1 from spill home)
        eb(102); eb(72); eb(15); eb(110); eb(199)   // movq xmm0, rdi (a)
        eb(102); eb(72); eb(15); eb(110); eb(206)   // movq xmm1, rsi (b)
        eb(102); eb(15); eb(47); eb(193)           // comisd xmm0, xmm1 (a vs b)
        eb(15); eb(146); eb(192)                   // setb al (CF=1 => a<b)
        rzx(0, 0)                                  // movzx eax, al
        rr(0, 7)                                   // mov rax, rdi (default a)
        rr(2, 6)                                   // mov rdx, rsi (b)
        rcmov(1, 0, 2)                             // cmovb rax, rdx (a<b take b) => max
        return 1
    }
    // ---- P2: transcendentals via x87 FPU (freestanding, no libm) ----
    // Input is the f64 bit-pattern in rdi. We spill to the stack, load to x87,
    // compute, store back, and return the bit-pattern in rax.
    // sin(a): fld a; fsin
    if nl==3&&r8(nm)=='s'&&r8(nm+1)=='i'&&r8(nm+2)=='n' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)                                  // sub rsp, 16
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]   (DD 04 24)
        eb(217); eb(254)                          // fsin              (D9 FE)
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]  (DD 1C 24)
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)                                 // add rsp, 16 (undo sbi(16))
        return 1
    }
    // cos(a): fld a; fcos
    if nl==3&&r8(nm)=='c'&&r8(nm+1)=='o'&&r8(nm+2)=='s' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]
        eb(217); eb(255)                          // fcos              (D9 FF)
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)
        return 1
    }
    if nl==3&&r8(nm)=='t'&&r8(nm+1)=='a'&&r8(nm+2)=='n' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]
        eb(217); eb(242)                          // fptan             (D9 F2)
        eb(221); eb(216)                          // fstp st(0)        (DD D8) -> drops the 1.0, tan in st1->st0
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)
        return 1
    }
    // log(a) = ln(a): fldln2; fld a; fyl2x  (st0 = ln2 * log2(a) = ln(a))
    if nl==3&&r8(nm)=='l'&&r8(nm+1)=='o'&&r8(nm+2)=='g' {
        flush_all()
        let arg0v = irres(ira2(ii))
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        sbi(16)
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi (CORRECT: 48 89 3C 24, mod=00 no disp)
        eb(217); eb(237)                          // fldln2            (D9 ED)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]   (a)
        eb(217); eb(241)                          // fyl2x             (D9 F1) -> st0 = ln2*log2(a)
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(16)
        return 1
    }
    // pow(a,b) = exp(b * ln(a)). Compute ln(a) via fyl2x*ln2, multiply by b, exp.
    if nl==3&&r8(nm)=='p'&&r8(nm+1)=='o'&&r8(nm+2)=='w' {
        flush_all()
        let arg0v = irres(ira2(ii))
        let arg1v = irres(ira2(ii)+1)
        rbp(7, spill_home(arg0v))                     // rdi = a (arg0 from spill home)
        rbp(6, spill_home(arg1v))                     // rsi = b (arg1 from spill home)
        sbi(32)                                  // sub rsp, 32 (slots: a[rsp], b[rsp+8])
        fx87prep()                               // force 64-bit FPU precision
        eb(72); eb(137); eb(60); eb(36)   // mov [rsp], rdi      (a bits)
        eb(72); eb(137); eb(116); eb(36); eb(8)   // mov [rsp+8], rsi  (b bits)
        // ln(a): fldln2; fld [rsp]; fyl2x
        // z = b * log2(a). log2(a) via fyl2x: fld1; fld a; fyl2x -> st0 = 1.0*log2(a) = log2(a)
        // (z = b*ln(a)*log2(e) = b*log2(a) since ln(a)*log2(e)=log2(a) exactly — avoids rounding error)
        eb(217); eb(232)                          // fld1               (D9 E8)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]     (a)
        eb(217); eb(241)                          // fyl2x -> st0 = log2(a)
        eb(221); eb(68); eb(36); eb(8)            // fld qword [rsp+8]   (b)
        eb(222); eb(201)                          // fmulp st(1),st(0)   (DE C9) -> st0 = z = b*log2(a)
        // store z to [rsp] (a slot, no longer needed), reset FPU, reload clean
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]     (DD 1C 24)
        eb(219); eb(227)                          // fninit             (DB E3) clean FPU (clears stack + tags)
        fx87prep()                               // re-assert 64-bit precision (fninit defaulted 80-bit)
        eb(221); eb(4); eb(36)                    // fld qword [rsp]     (DD 04 24)  reload z clean
        // exp2(z) — verified-correct x87 sequence (clean .S test: 2^10=1024, 2^0.5=1.414, 2^-1=0.5, 2^3=8)
        eb(217); eb(192)                          // fld st(0)          (D9 C0) [z, z]
        eb(217); eb(252)                          // frndint            (D9 FC) [trunc(z), z]
        eb(217); eb(201)                          // fxch st(1)         (D9 C9) [z, trunc(z)]  st0=z, st1=trunc
        eb(216); eb(225)                          // fsub st(1)         (D8 E1) st0=z-trunc=frac [frac, trunc]
        eb(217); eb(240)                          // f2xm1             (D9 F0) [2^frac-1, trunc]
        eb(217); eb(232)                          // fld1               (D9 E8) [1, 2^frac-1, trunc]
        eb(222); eb(193)                          // faddp st(1)        (DE C1) [2^frac, trunc]
        eb(217); eb(253)                          // fscale            (D9 FD) [2^z, trunc]
        eb(221); eb(217)                          // fstp st(1)        (DD D9) drop trunc -> [2^z]
        eb(221); eb(28); eb(36)                   // fstp qword [rsp]
        eb(72); eb(139); eb(4); eb(36)            // mov rax, [rsp]
        abi(32)                                 // add rsp, 32 (undo sbi(32))
        return 1
    }
    // ---- P2: random / fs-meta / introspection builtins (syscall-backed) ----
    // getrandom(buf, len, flags): sc 318
    if nl==9&&r8(nm)=='g'&&r8(nm+1)=='e'&&r8(nm+2)=='t'&&r8(nm+3)=='r'&&r8(nm+4)=='a'&&r8(nm+5)=='n'&&r8(nm+6)=='d'&&r8(nm+7)=='o'&&r8(nm+8)=='m' {
        flush_all()
        ri(0,318); sysc(); return 1
    }
    // argp8(reg, base, k): load arg k's spill-home pointer + 8 (skip the 8-byte
    // string length prefix) into reg. Quanta strings are [8:len][bytes]; syscall
    // path ABI needs base+8. Mirrors the reload-from-spill-home pattern used by
    // the generic syscall() helper.
    // unlink(path): sc 87
    if nl==6&&r8(nm)=='u'&&r8(nm+1)=='n'&&r8(nm+2)=='l'&&r8(nm+3)=='i'&&r8(nm+4)=='n'&&r8(nm+5)=='k' {
        flush_all()
        ri(3, 8); ra(7, 3)        // rdi (path from IR_CALL) += 8
        ri(0,87); sysc(); return 1
    }
    // mkdir(path, mode): sc 83
    if nl==5&&r8(nm)=='m'&&r8(nm+1)=='k'&&r8(nm+2)=='d'&&r8(nm+3)=='i'&&r8(nm+4)=='r' {
        flush_all()
        let scb = ira2(ii)
        argp8(7, scb, 0)        // rdi = path + 8
        rbp(6, spill_home(irres(scb+1)))   // rsi = mode
        ri(0,83); sysc(); return 1
    }
    // chdir(path): sc 80
    if nl==5&&r8(nm)=='c'&&r8(nm+1)=='h'&&r8(nm+2)=='d'&&r8(nm+3)=='i'&&r8(nm+4)=='r' {
        flush_all()
        ri(3, 8); ra(7, 3)        // rdi (path from IR_CALL) += 8
        ri(0,80); sysc(); return 1
    }
    // rename(old, new): sc 82
    if nl==6&&r8(nm)=='r'&&r8(nm+1)=='e'&&r8(nm+2)=='n'&&r8(nm+3)=='a'&&r8(nm+4)=='m'&&r8(nm+5)=='e' {
        flush_all()
        ri(3, 8); ra(7, 3)        // rdi (old path from IR_CALL) += 8
        rbp(6, spill_home(irres(ira2(ii)+1)))   // rsi = new
        ri(0,82); sysc(); return 1
    }
    // stat(path, buf): newfstatat(AT_FDCWD, path, buf, 0) = sc 262
    if nl==4&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='a'&&r8(nm+3)=='t' {
        flush_all()
        let scb = ira2(ii)
        ri(7,-100)              // rdi = AT_FDCWD
        argp8(6, scb, 0)        // rsi = path + 8
        rbp(2, spill_home(irres(scb+1)))   // rdx = buf
        ri(10,0)                // r10 = 0 (flags)
        ri(0,262); sysc(); return 1
    }
    // abort(): exit(134) = 128 + SIGABRT
    if nl==5&&r8(nm)=='a'&&r8(nm+1)=='b'&&r8(nm+2)=='o'&&r8(nm+3)=='r'&&r8(nm+4)=='t' {
        flush_all()
        ri(7,134); ri(0,60); sysc(); return 1
    }
    // debugbreak(): int3
    if nl==10&&r8(nm)=='d'&&r8(nm+1)=='e'&&r8(nm+2)=='b'&&r8(nm+3)=='u'&&r8(nm+4)=='g'&&r8(nm+5)=='b'&&r8(nm+6)=='r'&&r8(nm+7)=='e'&&r8(nm+8)=='a'&&r8(nm+9)=='k' {
        flush_all()
        eb(204); return 1
    }
    return 0
}

