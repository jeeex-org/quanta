// cross-TU DATA global: USING TU (--no-start, no entry point)
// Imports the global defined in mtu_glob_def and writes it from this TU
// (proving the WRITE crosses the TU boundary and lands in the def TU's slot).
extern "C" global SHARED

fn add_shared(d) {
    SHARED = SHARED + d
    return SHARED
}
