import std/secure

fn test_hexval(c) {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 87 }
  if c >= 65 && c <= 70 { return c - 55 }
  return 0
}

fn test_hex_to_bytes(dst, hexstr, n) {
  let i = 0
  while i < n {
    let hi = test_hexval(mem_load8(hexstr + 8 + i * 2))
    let lo = test_hexval(mem_load8(hexstr + 8 + i * 2 + 1))
    mem_store8(dst + i, hi * 16 + lo)
    i = i + 1
  }
}

fn test_mem_eq(a, b, n) {
  let i = 0
  while i < n {
    if mem_load8(a + i) != mem_load8(b + i) { return 0 }
    i = i + 1
  }
  return 1
}

fn main() {
  let e = mem_alloc(32)
  sha3_256("", 0, e)
  let ve = mem_alloc(32)
  test_hex_to_bytes(ve, "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", 32)
  if test_mem_eq(e, ve, 32) == 0 { exit(1) }
  exit(0)
}

extern fn malloc(size: u64) -> u64