import std/secure
fn main() {
  let rc2 = keccak_rc(2)
  let rc3 = keccak_rc(3)
  let want2 = 0x800000000000808a
  let want3 = 0x8000000080008000
  let d2 = rc2 ^ want2
  let d3 = rc3 ^ want3
  // print rc2, rc3 as hex to see actual values
  let e = mem_alloc(64)
  let i = 0
  while i < 8 { let v=(rc2>>(i*8))&255; let hi=v>>4; let lo=v&15; let c1=0; if hi<10 {c1=hi+48} else {c1=hi+87}; let c2=0; if lo<10 {c2=lo+48} else {c2=lo+87}; mem_store8(e+i*2,c1); mem_store8(e+i*2+1,c2); i=i+1 }
  print(e, 16); print(" rc2\n", 6)
  let j = 0
  while j < 8 { let v=(rc3>>(j*8))&255; let hi=v>>4; let lo=v&15; let c1=0; if hi<10 {c1=hi+48} else {c1=hi+87}; let c2=0; if lo<10 {c2=lo+48} else {c2=lo+87}; mem_store8(e+j*2,c1); mem_store8(e+j*2+1,c2); j=j+1 }
  print(e, 16); print(" rc3\n", 6)
  if d2 == 0 && d3 == 0 { exit(0) } else { exit(1) }
}
