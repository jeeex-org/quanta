fn main() {
  let bba = 0xF0F0F0F0F0F0F0F0
  let bbe = 0x123456789ABCDEF0
  let bbi = 0x0F0F0F0F0F0F0F0F
  let e = bba ^ ((~bbe) & bbi)
  let r = e ^ 0x800000000000808a
  // expected: e = bba ^ ((~bbe)&bbi); then r = e ^ RC2
  let nbbe = (~bbe) & bbi
  let ee = bba ^ nbbe
  let want = ee ^ 0x800000000000808a
  let diff = r ^ want
  if diff == 0 { exit(0) } else { exit(1) }
}
