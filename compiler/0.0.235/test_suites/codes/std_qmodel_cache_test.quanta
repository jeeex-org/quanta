// std_qmodel_cache_test -- Phase 7.1: device residency with LRU eviction.
//
// The budget here is deliberately far below the model size. This box's model is
// 1589 MiB and the card has ~7.4 GiB free, so an "upload everything" policy
// would never evict and would exercise none of the eviction path. A cache test
// that never evicts proves nothing, so the budget is set to a few tens of MiB.
//
// What is checked, and why each one is a real property rather than a restatement
// of the implementation:
//   1. a fetch makes a tensor resident, and a second fetch of the same tensor is
//      a HIT that returns the SAME device pointer (no re-upload, no leak)
//   2. uploading past the budget evicts, and `used` never exceeds the budget
//   3. the evicted tensor is the LEAST-RECENTLY-USED one, not merely some one
//      (asserted by touching a tensor and requiring it to survive an eviction
//      that takes its neighbour)
//   4. an in-use tensor is never evicted (a fetch in flight must not have its
//      memory pulled out from under it)
//   5. the bytes actually land: a dequant on the resident tensor matches the
//      same dequant computed from the host bytes, so "resident" means the right
//      bytes are there and not just that a pointer was returned
//
// (5) is the one that matters most. A cache that returns plausible pointers and
// never checks the contents would pass 1-4 while storing nothing.

import std/fs
import std/gguf
import std/loader_traits
import std/cuda_daemon
import std/qmodel_cache

const MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

// Sized from the model's actual tensor sizes, measured rather than assumed.
// The 4-bit tensors are 12386304 bytes (11.8 MiB) each. The budget must hold
// EXACTLY TWO of them:
//
//   * hold only one (20 MiB) and a single fetch evicts the previous one, so the
//     LRU property cannot be observed at all -- there is never a choice of
//     victim. The first version of this test asserted "the recently-used tensor
//     survived" under that budget, which is impossible: only one tensor is ever
//     resident, and the assertion failed on a cache that was behaving correctly.
//   * hold three or more and no eviction is forced.
//
// Two resident slots is the only size at which "which one goes?" is a real
// question. 2 * 12386304 = 24772608, so 25 MiB.
const BUDGET = 25 * 1024 * 1024

// Read a tensor's LRU tick through the cache's public surface. Added for the
// test: asserting "the LRU was evicted" requires being able to see the ordering
// the cache is using, rather than guessing it.
fn qmodel_tick_of(h, i) -> i64 {
    return qmodel_cache_tick(h, i)
}

// CPU reference for the Q4_K (scale, min) pair, mirroring gguf.quanta's
// q4k_sc/q4k_min. The test carries its own copy on purpose: the point is to
// check the device against an independent statement of the layout, so importing
// the implementation under test would defeat it.
fn qmc_cpu_sc(j, sc) {
    if j < 4 { return mem_load8(sc + j) - (mem_load8(sc + j) >> 6) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo - (lo >> 4) * 16) + ((mem_load8(sc + j - 4) >> 6) * 16)
}
fn qmc_cpu_min(j, sc) {
    if j < 4 { return mem_load8(sc + j + 4) - (mem_load8(sc + j + 4) >> 6) * 64 }
    let lo = mem_load8(sc + j + 4)
    return (lo >> 4 - (lo >> 4 >> 4) * 16) + ((mem_load8(sc + j) >> 6) * 16)
}

// Stage a tensor's bytes into a host file the daemon can h2d from. Uses the
// loader's read, so the bytes are the model's real bytes.
fn stage_tensor(h, idx, path, nbytes) -> i64 {
    let buf = mem_alloc(nbytes)
    let got = qmodel_read(h, idx, buf, nbytes)
    if got != nbytes { return -1 }
    let fd = open(path, 577, 420)
    if fd < 0 { return -1 }
    write_raw(fd, buf, nbytes)
    close(fd)
    mem_free(buf)
    return 0
}

fn main() -> i64 {
    if cuda_daemon_ready() == 0 { print("SKIP: CUDA daemon not running\n"); return 0 }
    if cuda_init() != 0 { print("FAIL: cuda_init\n"); return 1 }

    let h = qmodel_open(MODEL)
    if h < 0 { print("FAIL: qmodel_open\n"); return 1 }
    let nt = qmodel_num_tensors(h)
    if nt <= 0 { print("FAIL: no tensors\n"); return 1 }

    if qmodel_cache_init(h, nt, BUDGET) != 0 { print("FAIL: cache_init\n"); return 1 }
    if qmodel_cache_budget(h) != BUDGET { print("FAIL: budget not stored\n"); return 1 }

    let fails = 0

    // Pick four small tensors that individually fit and together exceed BUDGET.
    // Walking the table for the smallest ones keeps this robust to a model whose
    // tensor order differs from what one might assume.
    // 4-bit tensors: large enough that two cannot share the budget, so the
    // eviction path is guaranteed to run.
    let picks = mem_alloc(4 * 8)
    let pick_nb = mem_alloc(4 * 8)
    let found = 0
    let i = 0
    while i < nt && found < 4 {
        let nb = qmodel_nbytes(h, i)
        // Each pick must be > budget/3 so that THREE cannot fit, and <= budget/2
        // so that TWO always do.
        if nb > BUDGET / 3 && nb <= BUDGET / 2 {
            mem_store(picks + found * 8, i)
            mem_store(pick_nb + found * 8, nb)
            found = found + 1
        }
        i = i + 1
    }
    if found < 4 {
        print("FAIL: need 4 tensors sized (budget/3, budget/2]; found=")
        print(found); print("\n"); return 1
    }

    let stage = "/tmp/qmc_stage.bin"

    // ---- 1. fetch makes it resident; refetch is a hit with the same pointer ----
    let t0 = mem_load(picks + 0)
    let nb0 = mem_load(pick_nb + 0)
    if stage_tensor(h, t0, stage, nb0) != 0 { print("FAIL: stage t0\n"); return 1 }

    let p1 = qmodel_fetch(h, t0, stage, nb0)
    if p1 == 0 { print("FAIL: first fetch returned 0\n"); return 1 }
    if qmodel_is_resident(h, t0) == 0 { print("FAIL: not resident after fetch\n"); return 1 }

    let p2 = qmodel_fetch(h, t0, stage, nb0)
    if p2 != p1 { print("FAIL: refetch returned a different pointer (re-uploaded)\n"); return 1 }
    if qmodel_cache_hits(h) != 1 { print("FAIL: hit not counted\n"); return 1 }
    if qmodel_cache_uploads(h) != 1 { print("FAIL: upload count wrong\n"); return 1 }
    print("fetch/hit: same pointer, hits=1 uploads=1\n")

    // ---- 2 + 3. eviction happens, respects the budget, and takes the LRU ----
    //
    // Do NOT pre-judge which tensor is the LRU. Two earlier versions of this
    // test did, and both assertions were wrong while the cache was right:
    //   * with a budget holding only ONE tensor, "the recently-used one
    //     survived" is impossible -- there is never a choice of victim;
    //   * with a budget holding two, the acquire() that touched t0 bumped its
    //     tick, so t0 was the OLDEST and evicting it was correct.
    // The property to assert is the definition, not a guess: the victim must be
    // the resident, not-in-use entry with the smallest tick.
    let t1 = mem_load(picks + 8)
    let nb1 = mem_load(pick_nb + 8)
    if stage_tensor(h, t1, stage, nb1) != 0 { print("FAIL: stage t1\n"); return 1 }
    let q1 = qmodel_fetch(h, t1, stage, nb1)
    if q1 == 0 { print("FAIL: fetch t1\n"); return 1 }

    let t2 = mem_load(picks + 16)
    let nb2 = mem_load(pick_nb + 16)
    if stage_tensor(h, t2, stage, nb2) != 0 { print("FAIL: stage t2\n"); return 1 }

    // Snapshot the resident set and its ticks BEFORE the fetch that forces room.
    let before_res = mem_alloc(4 * 8)
    let before_tick = mem_alloc(4 * 8)
    let k = 0
    while k < 4 {
        let ti = mem_load(picks + k * 8)
        mem_store(before_res + k * 8, qmodel_is_resident(h, ti))
        mem_store(before_tick + k * 8, qmodel_tick_of(h, ti))
        k = k + 1
    }

    let evicted_before = qmodel_cache_evicted(h)
    let p3 = qmodel_fetch(h, t2, stage, nb2)
    if p3 == 0 { print("FAIL: fetch t2\n"); return 1 }

    let used = qmodel_cache_used(h)
    if used > BUDGET { print("FAIL: used exceeds budget\n"); fails = fails + 1 }
    print("after 3 fetches: used="); print(used); print(" budget="); print(BUDGET)
    print(" evicted="); print(qmodel_cache_evicted(h)); print("\n")

    if qmodel_cache_evicted(h) > evicted_before {
        // Find the victim: the one that WAS resident and now is not.
        let victim = -1
        let lru_tick = 0
        let lru_idx = -1
        k = 0
        while k < 4 {
            let ti = mem_load(picks + k * 8)
            let was = mem_load(before_res + k * 8)
            let now = qmodel_is_resident(h, ti)
            if was != 0 && now == 0 { victim = ti }
            if was != 0 {
                let tk = mem_load(before_tick + k * 8)
                if lru_idx < 0 || tk < lru_tick { lru_idx = ti; lru_tick = tk }
            }
            k = k + 1
        }
        if victim < 0 {
            print("FAIL: an eviction was counted but nothing left the cache\n")
            fails = fails + 1
        } else if victim != lru_idx {
            print("FAIL: victim was not the LRU (victim="); print(victim)
            print(" lru="); print(lru_idx); print(")\n")
            fails = fails + 1
        } else {
            print("LRU eviction: victim is the resident entry with the smallest tick\n")
        }
    } else {
        print("FAIL: three tensors did not force an eviction under this budget\n")
        fails = fails + 1
    }

    // ---- 4. an in-use tensor is never evicted ----
    // qmodel_evict refuses to free an in-use entry, and the eviction pass that
    // makes room skips it. Both are checked: a cache that frees memory out from
    // under an outstanding fetch is the failure this guards.
    let t3 = mem_load(picks + 24)
    let nb3 = mem_load(pick_nb + 24)
    if stage_tensor(h, t3, stage, nb3) != 0 { print("FAIL: stage t3\n"); return 1 }

    if qmodel_is_resident(h, t2) != 0 {
        let before_ptr = qmodel_device_ptr(h, t2)
        qmodel_acquire(h, t2)                      // marks it in use
        let ev = qmodel_evict(h, t2)               // must refuse
        let after_ptr = qmodel_device_ptr(h, t2)
        if ev == 0 || after_ptr != before_ptr {
            print("FAIL: qmodel_evict freed an in-use tensor\n")
            fails = fails + 1
        } else {
            print("in-use tensor refused eviction\n")
        }
        // A fetch that needs room must skip the pinned entry and succeed anyway.
        let p4 = qmodel_fetch(h, t3, stage, nb3)
        if qmodel_device_ptr(h, t2) != before_ptr {
            print("FAIL: a pinned tensor was evicted by the room-making pass\n")
            fails = fails + 1
        } else {
            print("pinned tensor survived the room-making pass\n")
        }
        qmodel_release(h, t2)
        if p4 == 0 {
            print("NOTE: t3 could not be fetched while t2 was pinned\n")
        }
    } else {
        print("NOTE: t2 not resident; in-use check skipped\n")
    }

    // ---- 5. the bytes are really there ----
    // Dequantize a resident Q4_K tensor on the device and compare against the
    // same dequant computed on the host from the loader's bytes. This is the
    // check that distinguishes "a pointer was returned" from "the right bytes
    // are on the device".
    let qidx = -1
    i = 0
    while i < nt {
        if qmodel_bits(h, i) == 4 { qidx = i; i = nt } else { i = i + 1 }
    }
    if qidx < 0 {
        print("NOTE: no 4-bit tensor found; content check skipped\n")
    } else {
        let qnb = qmodel_nbytes(h, qidx)
        if qnb > BUDGET { print("NOTE: 4-bit tensor larger than budget; content check skipped\n") }
        else {
            if stage_tensor(h, qidx, stage, qnb) != 0 { print("FAIL: stage 4bit\n"); return 1 }
            let dev = qmodel_fetch(h, qidx, stage, qnb)
            if dev == 0 { print("FAIL: fetch 4bit\n"); return 1 }

            let nel = qmodel_nelements(h, qidx)
            let nblk = nel / 256
            if nblk <= 0 || (nel - nblk * 256) != 0 {
                print("NOTE: 4-bit tensor is not a whole number of 256-blocks; skipped\n")
            } else {
                // CPU dequant of the first block, from the loader's bytes.
                let raw = mem_alloc(144)
                if qmodel_read(h, qidx, raw, 144) != 144 { print("FAIL: read 4bit head\n"); return 1 }
                let d = f16_to_f64(raw)
                let dmin = f16_to_f64(raw + 2)
                let sc = raw + 4
                let q = raw + 16
                let expect = mem_alloc(256 * 8)
                let chunk = 0
                let is = 0
                while chunk < 4 {
                    let d1 = fmul(d, i2f(qmc_cpu_sc(is, sc)))
                    let mm1 = fmul(dmin, i2f(qmc_cpu_min(is, sc)))
                    let d2 = fmul(d, i2f(qmc_cpu_sc(is + 1, sc)))
                    let mm2 = fmul(dmin, i2f(qmc_cpu_min(is + 1, sc)))
                    let l = 0
                    while l < 32 {
                        let b8 = mem_load8(q + chunk * 32 + l)
                        let lo = b8 - (b8 >> 4) * 16
                        let hi = b8 >> 4
                        mem_store(expect + (chunk * 64 + l) * 8, f64bits(fsub(fmul(d1, i2f(lo)), mm1)))
                        mem_store(expect + (chunk * 64 + 32 + l) * 8, f64bits(fsub(fmul(d2, i2f(hi)), mm2)))
                        l = l + 1
                    }
                    is = is + 2
                    chunk = chunk + 1
                }

                // Dequant the resident device tensor and bring it back.
                let dout = gpu_malloc(256 * 4)
                if dout == 0 { print("FAIL: gpu_malloc dout\n"); return 1 }
                if gpu_dequant(CUDA_DTYPE_Q4_K, dev, dout, 256) != 0 {
                    print("FAIL: gpu_dequant on resident tensor\n"); return 1
                }
                let dback = "/tmp/qmc_deq.bin"
                if memcpy_d2h_async(dout, dback, 256 * 4) != 0 { print("FAIL: d2h\n"); return 1 }
                let fd = open(dback, 0, 0)
                if fd < 0 { print("FAIL: open dback\n"); return 1 }
                let got = mem_alloc(256 * 4)
                read_raw(fd, got, 256 * 4)
                close(fd)

                let diff = 0
                let k = 0
                while k < 256 {
                    if f32_to_f64(got + k * 4) != f64of(mem_load(expect + k * 8)) { diff = diff + 1 }
                    k = k + 1
                }
                print("resident tensor content: 256 elements dequantized, differing=")
                print(diff); print("\n")
                if diff != 0 {
                    print("FAIL: the resident bytes are not the tensor's bytes\n")
                    fails = fails + 1
                }
                gpu_free(dout)
            }
        }
    }

    print("cache stats: hits="); print(qmodel_cache_hits(h))
    print(" misses="); print(qmodel_cache_misses(h))
    print(" uploads="); print(qmodel_cache_uploads(h))
    print(" evicted="); print(qmodel_cache_evicted(h))
    print(" bytes="); print(qmodel_cache_bytes(h)); print("\n")

    qmodel_cache_flush(h)
    if qmodel_cache_used(h) != 0 { print("FAIL: flush left bytes resident\n"); fails = fails + 1 }
    qmodel_close(h)

    if fails == 0 { print("qmodel_cache: all pass\n") } else { print("qmodel_cache: FAILURES\n") }
    return 0
}
