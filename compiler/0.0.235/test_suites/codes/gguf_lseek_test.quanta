import std/fs

// Test lseek is fixed (was using syscall 8/mprotect, now 6/lseek)
fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { return 1 }
    
    // Read header at offset 0
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    let magic1 = mem_load8(hdr)
    
    // Seek to offset 100
    lseek(fd, 100, 0)
    let buf = mem_alloc(4)
    read_raw(fd, buf, 4)
    
    // Seek back to 0
    lseek(fd, 0, 0)
    read_raw(fd, hdr, 24)
    let magic2 = mem_load8(hdr)
    
    // Verify magic is consistent (71 = 'G')
    if magic1 != 71 { close(fd); return 1 }
    if magic2 != 71 { close(fd); return 1 }
    
    close(fd)
    return 0
}