// Real Implementation: Financial Instruments
// Domain: accounting | Category: GAAP | Module: Financial Instruments

fn cecl_loss_allowance(exposure_at_default: i64, pd_bps: i64, lgd_pct: i64) -> i64 {
    let loss = (exposure_at_default * pd_bps * lgd_pct) / 1000000
    if loss < 0 { return 0 }
    return loss
}

fn classify_investment(percent_ownership: i64, intent_to_hold: i64, active_market: i64) -> i64 {
    if percent_ownership >= 20 and percent_ownership < 50 { return 4 }
    if percent_ownership >= 50 { return 0 }
    if intent_to_hold == 1 { return 1 }
    if active_market == 1 { return 3 }
    return 2
}

fn fair_value_level(quoted_prices: i64, observable_inputs: i64) -> i64 {
    if quoted_prices == 1 { return 1 }
    if observable_inputs == 1 { return 2 }
    return 3
}

fn effective_interest_amortized_cost(carrying_value: i64, effective_rate_pct: i64) -> i64 {
    return (carrying_value * effective_rate_pct) / 100
}

fn hedge_effectiveness(hedge_instrument_change: i64, hedged_item_change: i64) -> i64 {
    if hedge_instrument_change == 0 { return 0 }
    let ratio = (hedge_instrument_change * 100) / hedged_item_change
    if ratio >= 80 and ratio <= 125 { return 1 }
    if ratio >= -125 and ratio <= -80 { return 1 }
    return 0
}

fn is_derivative(has_underlyings: i64, requires_no_initial_investment: i64, net_settlement: i64) -> i64 {
    if has_underlyings == 1 and requires_no_initial_investment == 1 and net_settlement == 1 {
        return 1
    }
    return 0
}

fn impairment_trigger(unrealized_loss_pct: i64, intent_sell_before_recovery: i64) -> i64 {
    if intent_sell_before_recovery == 1 { return 1 }
    if unrealized_loss_pct > 30 { return 1 }
    return 0
}
