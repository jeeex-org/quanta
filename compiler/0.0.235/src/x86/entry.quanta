            if r64(fn_parflt + (fi*200 + pz)*8)==1 { w8(vfloat+vr, 1) }
            // P9: tag param vreg with trait type (negative encoding)
            if ptyp < 0-1 { w64(vreg_trait + vr*8, (ptyp * -1) - 2) }
            // 0.0.114: tag param vreg big when declared `: big`
            if r64(fn_parbig + (fi*200 + pz)*8)==1 { w64(vreg_is_big + vr*8, 1) }
                                        // A parameter declared `: str` / `: string` is a string
                                        // vreg. Same shape as the float, big and struct tagging
                                        // directly above.
                                        //
                                        // fn_parstr was allocated in 0.0.166 and read by
                                        // find_str_source() and by print()/echo()/file_open(), and
                                        // funcscan.quanta writes the flag from the signature -- but
                                        // nothing applied it to the vreg. So every string-typed
                                        // parameter came back untagged and printing it emitted the
                                        // raw heap pointer instead of the text:
                                        //     fn f(s: str) { println(s) }
                                        //     fn main() { f("hello") return 0 }   ->  1109393744
                                        //
                                        // Locals were never affected -- `let x: str = "hi"` prints
                                        // fine -- because a local's tag comes from the IR_STR that
                                        // produced it. That asymmetry is what hid this: every
                                        // string-taking helper in the tree was affected, and no
                                        // local-only test could see it.
                                        // w64, NOT w8. nv() initialises every vreg_is_str cell to -1 via w64(), so a
                            // ONE-BYTE store leaves the cell at 0xFFFFFFFFFFFFFF01 --
                            // neither the 1 that string readers test for, nor the -1
                            // they treat as "not a string". This exact mistake
                            // already killed the declared `-> string` return tag; see
                            // codegen.quanta's IR_RET branch for the same story. vfloat
                            // is read bytewise, which is why w8 is correct THERE and
                            // fatal here.
                            if r64(fn_parstr + (fi*200 + pz)*8)==1 { w64(vreg_is_str + vr*8, 1) }
                                        // Link the vreg to its fn_parstr slot. find_str_source()
                                        // walks the MOV/STR/PARAM chain and, on IR_PARAM,
                                        // consults vreg_to_param + fn_parstr; nv() zeroes
                                        // vreg_to_param for every fresh vreg and the only writer
                                        // was codegen's CACHED-IR path, so on a normal compile
                                        // this stayed 0 and find_str_source() concluded "not a
                                        // string param". Key shape is fi*200 + param_index,
                                        // matching funcscan.quanta, codegen.quanta and
                                        // objfmt.quanta.
                                        w64(vreg_to_param + vr*8, fi*200 + pz)
                                        pc=pc+1
                                        pz=pz+1
                    }
                    // P10: Bind generic type parameters in function body scope
                    let gen_count = r64(fn_genparams + fi*8)
                    if gen_count>0 {
                        let gen_base = r64(fn_genparam_base + fi*8)
                        let gz = 0
                        while gz<gen_count {
                            let gnm = r64(fn_genparam_names + gen_base + gz*16)
                            let gnl = r64(fn_genparam_names + gen_base + gz*16 + 8)
                            let vr = nv()
                            // Create a type marker vreg for this generic parameter
                            iremit(IR_CONST, vr, gz, 0, 0)
                            // Tag as generic type parameter
                            w64(vreg_type + vr*8, 10)
                            vadd(gnm, gnl, vr)
                            gz = gz + 1
                        }
                    }
        
        // P10: cur_fi must be set BEFORE parse_block so that parse_call_impl's
        // fn-typed-param lookup (findparam(cur_fi, ...)) sees THIS function's
        // param table while the body is parsed ? not the previous fn's (the
        // register-slot hazard: cross-block state must live in globals).
        cur_fi=fi
// P11 (0.0.67): if THIS fn is a closure body (anonymous: name length 0
        // with a parent), set cur_clo so parse_primary turns a free variable
        // into a capture instead of a hard error. Also bind each capture already
        // known for this closure to an IR_CAPREAD vreg, so a name captured on an
        // earlier parse pass still resolves.
        cur_clo = 0 - 1
        if fn_nlen(fi)==0 && r64(fn_parent + fi*8)>=0 {
            cur_clo = fi
            let kk = 0
            let kn = r64(cap_count + fi*8)
            while kk < kn {
                let knm = r64(cap_name + (fi*CAP_MAX + kk)*8)
                let knl = r64(cap_nlen + (fi*CAP_MAX + kk)*8)
                let kvr = nv(); iremit(IR_CAPREAD, kvr, kk, 0, 0); vadd(knm, knl, kvr)
                // 0.0.131: tag the capture vreg as a fn-value (type 11) when it is
                // this closure's OWN self-name, so a self-call `fact(n-1)` inside
                // the body resolves via vfind to a type-11 local and routes through
                // IR_CLOSURE_CALL. Harmless for value-only captures.
                let _sn = r64(clo_selfnm + fi*8); let _snl = r64(clo_selfnl + fi*8)
                if _snl>0 && knl==_snl {
                    let _m=1; let _j=0
                    while _j<_snl { if r8(src+_sn+_j)!=r8(src+knm+_j) { _m=0; break }; _j=_j+1 }
                    if _m==1 { w64(vreg_type + kvr*8, 11) }
                }
                w64(cap_bodyvreg + (fi*CAP_MAX + kk)*8, kvr)
                kk = kk + 1
            }
        }
        // 0.0.97: operator-overload suppression. Inside an operator-named fn
        // body (e.g. `fn +(a,b)`), the same operator must resolve to the BUILTIN
        // primitive ? otherwise `fn +(a,b){ return a + b }` would infinitely
        // recurse through the overload. So set overload_suppressed when the fn
        // name's first byte is an operator symbol.
        overload_suppressed = 0
        if r64(OPFN_SUPP + fi*8) == 1 {
            overload_suppressed = 1
        }
        // Push this function onto the scope stack so that local-first call
        // resolution (resolve_call -> fn_curscope) is scoped to THIS function's
        // body. Popped after the body is parsed.
        fn_push(fi)

        // IR start was already marked immediately after vclr(); irc=0 above,
        // before the param-binding and generic-marker emits. Only the body is
        // parsed from here.

                    parse_block()
        // 0.0.150: borrow check (record phase only, no enforcement)
        borrow_check_fn(0, irc)
        iremit(IR_RET,0,-1,0,0)
        fn_pop()
        // P11 (0.0.67): snapshot this function's locals so any closure body
        // compiled LATER (closures always get a higher fn index) can resolve a
        // captured name to the vreg that held it in THIS frame.
        clo_scope_save(fi)
        cur_clo = 0 - 1

        cur_fnname=fn_name(fi); cur_fnnlen=fn_nlen(fi)

        // Compile IR to code.  fn_cofs must be the START offset of the code.
        let cstart=codelen
        w64(func_code_starts+(fi+1)*8,cstart)
        // P4: record main's code offset for the startup-stub bl patch (global, unshadowable)
        if fn_nlen(fi)==4 && r8(src+fn_name(fi))==109 && r8(src+fn_name(fi)+1)==97 && r8(src+fn_name(fi)+2)==105 && r8(src+fn_name(fi)+3)==110 { g_main_ofs = cstart }
        // Tier-1 IR opt now runs inside ci_func(), bounded to the function's own IR
        // slice so it behaves identically for source and cache-imported IR.
        cur_fnname=fn_name(fi); cur_fnnlen=fn_nlen(fi)
        // IR count updated by sfn() when irc > fn_ir_start[fi]
        sfn(fi,fn_name(fi),fn_nlen(fi),fn_btok(fi),cstart,pc,r64(fn_rettype_name+fi*8),r64(fn_rettype_len+fi*8))
      ci_func(fi,0)

        fi=fi+1
    }

    // --emit-qobj mode: write .qobj module cache after all functions compiled (IR captured)
    if emit_qobj == 1 {
        qobj_write(out_p, srcp)
        exit(0)
    }

    // 0.0.121: deferred escape-hazard verification. Captures are registered
    // lazily during closure-body parse (which runs AFTER the enclosing fn's
    // parse_ret), so check_closure_escape is deferred and run now, once every
    // function and closure body has been parsed and its captures resolved.
    escape_run()

    // Resolve function-call patches (ty==2) now that all offsets are known.
    // In object mode (emit_obj==1) these are NOT resolved here ? p5_elf_obj
    // emits R_X86_64_PC32 relocations against the function symbols instead.
    if emit_obj == 0 {
    let pi=0
    while pi<patchc {
        if r64(patches+pi*PCS+16)==2 {
            let po=r64(patches+pi*PCS)
            let tg=r64(patches+pi*PCS+8)
            let tg_nl=0
            while tg_nl<256 {
                let c0=r8(src+tg+tg_nl)
                if c0==0||c0==40||c0==41||c0==59||c0==123||c0==125||c0==44||c0==60||c0==62 { break }
                if c0==32||c0==9||c0==10||c0==13 { break }
                tg_nl=tg_nl+1
            }
            let tfi=findfn(tg,tg_nl)
            if tfi>=0 {
                // P3: skip extern functions (resolved at link time, not via internal patching)
                // BUT: bare extern functions that match builtins must be resolved to builtin code.
                let is_ext = r64(fn_extern + tfi*8)
                if is_ext==1 {
                    // Check if this extern function is a builtin we can resolve
                    let fn_nm = fn_name(tfi)
                    let fn_nl = fn_nlen(tfi)
                    // malloc (6 chars) -> builtin mem_alloc alias
                    // free (4 chars) -> builtin mem_free
                    // mem_alloc (9 chars) -> builtin
                    // mem_free (8 chars) -> builtin
                    // mem_realloc (11 chars) -> builtin
                    // drop (4 chars) -> builtin
                    // exit (4 chars) -> builtin
                    // mmap (4 chars) -> builtin
                    let is_malloc = (fn_nl==6 && r8(src+fn_nm)==109 && r8(src+fn_nm+1)==97 && r8(src+fn_nm+2)==108 && r8(src+fn_nm+3)==108 && r8(src+fn_nm+4)==111 && r8(src+fn_nm+5)==99)
                    let is_free = (fn_nl==4 && r8(src+fn_nm)==102 && r8(src+fn_nm+1)==114 && r8(src+fn_nm+2)==101 && r8(src+fn_nm+3)==101)
                    let is_mem_alloc = (fn_nl==9 && r8(src+fn_nm)==109 && r8(src+fn_nm+1)==101 && r8(src+fn_nm+2)==109 && r8(src+fn_nm+3)==95 && r8(src+fn_nm+4)==97 && r8(src+fn_nm+5)==108 && r8(src+fn_nm+6)==108 && r8(src+fn_nm+7)==111 && r8(src+fn_nm+8)==99)
                    let is_mem_free = (fn_nl==8 && r8(src+fn_nm)==109 && r8(src+fn_nm+1)==101 && r8(src+fn_nm+2)==109 && r8(src+fn_nm+3)==95 && r8(src+fn_nm+4)==102 && r8(src+fn_nm+5)==114 && r8(src+fn_nm+6)==101 && r8(src+fn_nm+7)==101)
                    let is_mem_realloc = (fn_nl==11 && r8(src+fn_nm)==109 && r8(src+fn_nm+1)==101 && r8(src+fn_nm+2)==109 && r8(src+fn_nm+3)==95 && r8(src+fn_nm+4)==114 && r8(src+fn_nm+5)==101 && r8(src+fn_nm+6)==97 && r8(src+fn_nm+7)==108 && r8(src+fn_nm+8)==108 && r8(src+fn_nm+9)==111 && r8(src+fn_nm+10)==99)
                    let is_drop = (fn_nl==4 && r8(src+fn_nm)==100 && r8(src+fn_nm+1)==114 && r8(src+fn_nm+2)==111 && r8(src+fn_nm+3)==112)
                    let is_exit = (fn_nl==4 && r8(src+fn_nm)==101 && r8(src+fn_nm+1)==120 && r8(src+fn_nm+2)==105 && r8(src+fn_nm+3)==116)
                    let is_mmap = (fn_nl==4 && r8(src+fn_nm)==109 && r8(src+fn_nm+1)==109 && r8(src+fn_nm+2)==97 && r8(src+fn_nm+3)==112)
                    if is_malloc||is_free||is_mem_alloc||is_mem_free||is_mem_realloc||is_drop||is_exit||is_mmap {
                        // Resolve to the function's own code offset (it's a builtin, so it was compiled)
                        let tofs=r64(func_code_starts+(tfi+1)*8)
                        w8(code+po,232); w32(code+po+1, tofs-(po+5))
                    }
                    // else: leave as-is for dynamic linker
                } else {
                    // func_code_starts[tfi+1] = code start for user function tfi (0=__init, 1=first user fn)
                    let tofs=r64(func_code_starts+(tfi+1)*8)
                    w8(code+po,232); w32(code+po+1, tofs-(po+5))
                }
            } else { file_write(2, src+tg, tg_nl); file_write(2, 0x100000+0, 1); exit(7) }
        } else if r64(patches+pi*PCS+16)==5 {
            // 0.0.97: IR_CALL_IDX ? patches+8 carries the fn INDEX directly.
            // Resolve to that function's code offset (no name lookup).
            let po5=r64(patches+pi*PCS)
            let tfi5=r64(patches+pi*PCS+8)
            let tofs5=r64(func_code_starts+(tfi5+1)*8)
            w8(code+po5,232); w32(code+po5+1, tofs5-(po5+5))
        } else if r64(patches+pi*PCS+16)==4 {
            // fnptr lea (x86 exec mode): patch rip-relative disp. patches+8 = fi.
            // OFFSETS (same convention as ty==2). The lea is 7 bytes; both cof and the
            // patch offset are code-buffer offsets, so disp = cof - (po3+7).
            let po3=r64(patches+pi*PCS)
            let tfi=r64(patches+pi*PCS+8)
            let cof=r64(func_code_starts+(tfi+1)*8)
            let disp=cof-(po3+7)
            w32(code+po3+3, disp)
        } else if r64(patches+pi*PCS+16)==3 {
            // extern "C" call in exec mode: handled by exec_extern_patches(),
            // which write_elf calls once the dynamic layout is final.
        }
        pi=pi+1
    }
    // ARM64 fnptr patches (exec mode only): resolve the adrp/add PC-relative to
    // the function's link-time code address. The relocation site and global index
    // were recorded by the global-access handler. Object mode emits relocations
    // in p5_elf_obj instead.
    patch_globals()
    }   // end if emit_obj==0 (call-patch resolution skipped in object mode)

    // Post-parse arity check (single-pass parser can't check during parse:
    // forward calls / recursion reference a function whose param count is
    // only recorded after its body is parsed). Now that all fns are known,
    // scan IR_CALL instructions (a0=name, a1=arg count) and verify the call
    // count matches the callee's declared param count.
    let pi2=0
    while pi2<irc {
        if irop(pi2)==17 {
            let cnm=ira0(pi2); let carc=ira1(pi2)
            let cnl=len_name(cnm)
            let cfi=findfn(cnm, cnl)
            if cfi>=0 {
                let cpc = fn_pc(cfi)
                if r64(fn_var + cfi*8)==1 {
                    if carc < cpc { compile_error(2, cnm, cnl) }  // variadic: need >= fixed
                } else {
                    // t5: allow omitting trailing defaulted params.
                    let cmin = r64(fn_pdfixed + cfi*8)
                    if carc != cpc && carc < cmin { compile_error(2, cnm, cnl) }
                }
            }
        }
        pi2=pi2+1
    }

    // If a hard compile error was recorded (e.g. call to an undeclared
    // function), abort the compiler here BEFORE writing any ELF output.
    // Returning N makes the startup stub exit(N); this is the reliable
    // abort path (exit() builtin is unreliable inside the compiler).
    if had_error==1 { exit(7) }

    // G1: secure-by-default audit report (stderr, non-intrusive). A CI gate can
    // parse this line; a non-zero count on stdlib/app-core is actionable. The
    // compiler's own source uses zero unsafe (verified), so WIP self-host keeps it 0.
    if unsafe_count > 0 {
        let ua = "note: "
        let ub = " 'unsafe' block(s) parsed (secure-by-default audit)\n"
        file_write(2, ua+8, len(ua))
        // write unsafe_count as decimal to stderr (no itoa builtin available)
        let n = unsafe_count; let buf = mmap(32); let bi = 0
        if n == 0 { w8(buf, 48); bi = 1 }
        else {
            while n > 0 { w8(buf+bi, 48 + (n - (n/10)*10)); bi=bi+1; n=n/10 }
        }
        // digits were stored least-significant-first; write them most-significant-first
        let wi = 0
        while wi < bi { file_write(2, buf + (bi-1-wi), 1); wi = wi+1 }
        file_write(2, ub+8, len(ub))
    }

    // Patch the startup stub's call to __init and main's code offset.
    // Pick main's slot. Scan only NON-cache slots: an imported module may
    // legitimately define a function the local file also imports, and matching
    // a cached slot here would patch the startup stub to an imported function
    // instead of the entry point.
    let mfi=0-1; let mk=0
    while mk<fnc {
        if r64(qimp_is_cache + mk*8)==0 {
          if fn_nlen(mk)==4 {
            let mnm=fn_name(mk)
            if r8(src+mnm)==109&&r8(src+mnm+1)==97&&r8(src+mnm+2)==105&&r8(src+mnm+3)==110 { mfi=mk }
          }
        }
        mk=mk+1
    }
    if mfi < 0 { mfi = 0 }
    g_main_fi = mfi
    // ARM64: object mode -> emit .o with relocations (defer to p5_elf_obj,
    // which emits R_AARCH64_CALL26 relocs + EM_AARCH64). Otherwise patch the
    // startup stub's bl __init / bl main to absolute offsets and emit a
    // whole-program static-PIE ELF.
    // x86-64: object mode -> emit .o with relocations; else whole-program ELF.
    if emit_obj == 1 {
        p5_elf_obj(out_p)
        exit(0)
    }
    if do_link == 1 {
        // --link mode: link object file with libc using system ld
        // srcp = input .o file, out_p = output executable
        link_object_with_libc(srcp, out_p)
        exit(0)
    }
    w32(code+init_call+1, r64(func_code_starts+0)-(init_call+5))
    // g_main_ofs is set by the compile loop at the exact moment main's code is
    // emitted -- for source functions AND for cache-imported ones. Reading it
    // here is authoritative; re-deriving the offset from the slot table can
    // pick a different function when imported slots are interleaved.
    // func_code_starts[(mfi+1)] is the recorded start of main's code, and mfi is
    // resolved above over NON-cache slots only, so this is the entry point for
    // both source and cache-imported layouts.
    w32(code+stub_call+1, r64(func_code_starts+(mfi+1)*8)-(stub_call+5))
    write_elf(out_p)
    exit(0)
}

// Quick init
fn kregs() {
    return 0
}


// Patch every extern "C" CALL in exec mode to its PLT stub.
//
// Split out of the main patch loop and called from write_elf AFTER the dynamic
// block's layout is final, because the loop that owns it runs first. Two things
// made that ordering necessary. (1) The layout was recomputed here from
// independent guesses -- dynstr_size pinned at 200 where elf.quanta sizes it
// from the real name bytes, hash_size 32 against 20, got_size 8*(n+3) against
// 24+n*8 -- and every guess put the stub somewhere else. (2) Even a correct
// recomputation was not correct enough: the vaddr depends on the RW segment's
// base, which depends on the string-literal bytes laid down by codegen, and that
// count is only final inside write_elf. Reading it 0x18 low made every CALL
// overshoot its stub by exactly the string table and land in the middle of the
// file image, which faulted on the first call.
fn exec_extern_patches() {
    if emit_dynamic == 0 { return }
    if emit_obj != 0 { return }
    // The code segment begins at BASE + elf_ht: 64 (ELF64 header) + 56 * 6
    // (PHDR, LOAD_RX, LOAD_RW, INTERP, DYNAMIC, GNU_STACK).
    let elf_ht = 64 + 56 * 6
    let pi = 0
    while pi < patchc {
        if r64(patches+pi*PCS+16)==3 {
            // extern "C" call in exec mode. patches+8 = source offset of the
            // callee's name.
            let po3 = r64(patches+pi*PCS)
            let tg = r64(patches+pi*PCS+8)
            let tg_nl = 0
            while tg_nl < 256 {
                let c0 = r8(src+tg+tg_nl)
                if c0==0||c0==40||c0==41||c0==59||c0==123||c0==125||c0==44||c0==60||c0==62 { break }
                if c0==32||c0==9||c0==10||c0==13 { break }
                tg_nl = tg_nl + 1
            }
            let tfi = findfn(tg, tg_nl)
            if tfi >= 0 && r64(fn_extern + tfi*8)==1 {
                // Which PLT stub: the nth extern, in declaration order.
                let ext_idx = 0
                let fi2 = 0
                while fi2 < fnc {
                    if r64(fn_extern + fi2*8) == 1 {
                        if fi2 == tfi { break }
                        ext_idx = ext_idx + 1
                    }
                    fi2 = fi2 + 1
                }
                // g_dyn_ext + 208 is .plt_vaddr + 16, the first per-symbol stub,
                // published by publish_dyn_layout() during write_elf's size
                // phase. Stubs are 16 bytes apart.
                let plt_entry_vaddr = r64(g_dyn_ext + 208) + ext_idx * 16
                // E8 rel32, measured from the end of the CALL instruction.
                w32(code+po3+1, plt_entry_vaddr - (BASE + elf_ht + po3 + 5))
            }
        }
        pi = pi + 1
    }
}

