// link_object_with_libc: links a Quanta --emit-obj object file with libc using system ld
// Replaces quanta_link.sh ? native implementation in Quanta compiler
// obj_path: path to input .o file (raw C string from argv), out_path: path to output executable (raw C string)
fn link_object_with_libc(obj_path, out_path) {
    // Find the glibc dynamic linker (PT_INTERP)
    let interp = 0
    let c0 = "/lib64/ld-linux-x86-64.so.2"
    let c1 = "/lib/ld-linux-x86-64.so.2"
    let c2 = "/usr/lib64/ld-linux-x86-64.so.2"
    let c3 = "/usr/lib/ld-linux-x86-64.so.2"
    
    let fd0 = file_open(c0+8, 0)
    if fd0 >= 0 { file_close(fd0); interp = c0+8 }
    else {
        let fd1 = file_open(c1+8, 0)
        if fd1 >= 0 { file_close(fd1); interp = c1+8 }
        else {
            let fd2 = file_open(c2+8, 0)
            if fd2 >= 0 { file_close(fd2); interp = c2+8 }
            else {
                let fd3 = file_open(c3+8, 0)
                if fd3 >= 0 { file_close(fd3); interp = c3+8 }
            }
        }
    }
    
    if interp == 0 {
        let err = "error: glibc dynamic linker not found\n"
        file_write(2, err+8, len(err))
        exit(3)
    }
    
    // Build argv array for execve with proper C strings (NUL-terminated)
    // obj_path and out_path are raw C strings from argv (no Quanta header)
    let argv = mmap(128)
    let arg_buf = mmap(256)  // buffer for NUL-terminated strings
    let buf_pos = 0
    
    // argv[0] = "/usr/bin/ld.bfd"
    let ld_bin = "/usr/bin/ld.bfd"
    let i = 0
    while r8(ld_bin+8+i) != 0 { w8(arg_buf+buf_pos, r8(ld_bin+8+i)); buf_pos=buf_pos+1; i=i+1 }
    w8(arg_buf+buf_pos, 0); buf_pos=buf_pos+1
    w64(argv+0, arg_buf)
    
    // argv[1] = obj_path (raw C string, no header)
    i = 0
    let base = buf_pos
    while r8(obj_path+i) != 0 { w8(arg_buf+buf_pos, r8(obj_path+i)); buf_pos=buf_pos+1; i=i+1 }
    w8(arg_buf+buf_pos, 0); buf_pos=buf_pos+1
    w64(argv+8, arg_buf+base)
    
    // argv[2] = "-o"
    i = 0
    base = buf_pos
    let arg_o = "-o"
    while r8(arg_o+8+i) != 0 { w8(arg_buf+buf_pos, r8(arg_o+8+i)); buf_pos=buf_pos+1; i=i+1 }
    w8(arg_buf+buf_pos, 0); buf_pos=buf_pos+1
    w64(argv+16, arg_buf+base)
    
    // argv[3] = out_path (raw C string, no header)
    i = 0
    base = buf_pos
    while r8(out_path+i) != 0 { w8(arg_buf+buf_pos, r8(out_path+i)); buf_pos=buf_pos+1; i=i+1 }
    w8(arg_buf+buf_pos, 0); buf_pos=buf_pos+1
    w64(argv+24, arg_buf+base)
    
    // argv[4] = "-lc"
    i = 0
    base = buf_pos
    let arg_lc = "-lc"
    while r8(arg_lc+8+i) != 0 { w8(arg_buf+buf_pos, r8(arg_lc+8+i)); buf_pos=buf_pos+1; i=i+1 }
    w8(arg_buf+buf_pos, 0); buf_pos=buf_pos+1
    w64(argv+32, arg_buf+base)
    
    // argv[5] = "--dynamic-linker"
    i = 0
    base = buf_pos
    let arg_dl = "--dynamic-linker"
    while r8(arg_dl+8+i) != 0 { w8(arg_buf+buf_pos, r8(arg_dl+8+i)); buf_pos=buf_pos+1; i=i+1 }
    w8(arg_buf+buf_pos, 0); buf_pos=buf_pos+1
    w64(argv+40, arg_buf+base)
    
    // argv[6] = interp (Quanta string with header)
    i = 0
    base = buf_pos
    while r8(interp+i) != 0 { w8(arg_buf+buf_pos, r8(interp+i)); buf_pos=buf_pos+1; i=i+1 }
    w8(arg_buf+buf_pos, 0); buf_pos=buf_pos+1
    w64(argv+48, arg_buf+base)
    
    w64(argv+56, 0)
    
    // Use the new execve builtin (raw syscall wrapper) for direct execve
    // Build argv array as a flat buffer of C strings + pointer array
    // We'll use mmap for the scratch space and build everything there
    
    // Allocate scratch buffer for all strings and argv array
    let S = mmap(4096)
    
    // Write "/usr/bin/ld.bfd" at S+16
    let i = 0
    let ld_bin = "/usr/bin/ld.bfd"
    while r8(ld_bin+8+i) != 0 { w8(S+16+i, r8(ld_bin+8+i)); i=i+1 }
    w8(S+16+i, 0)
    let path_off = 16
    let path_len = i+1
    
    // Write obj_path at S+path_off+path_len
    i = 0
    while r8(obj_path+i) != 0 { w8(S+path_off+path_len+i, r8(obj_path+i)); i=i+1 }
    w8(S+path_off+path_len+i, 0)
    let obj_off = path_off+path_len
    let obj_len = i+1
    
    // Write out_path at S+obj_off+obj_len
    i = 0
    while r8(out_path+i) != 0 { w8(S+obj_off+obj_len+i, r8(out_path+i)); i=i+1 }
    w8(S+obj_off+obj_len+i, 0)
    let out_off = obj_off+obj_len
    let out_len = i+1
    
    // Write "-o" at S+out_off+out_len
    i = 0
    let arg_o = "-o"
    while r8(arg_o+8+i) != 0 { w8(S+out_off+out_len+i, r8(arg_o+8+i)); i=i+1 }
    w8(S+out_off+out_len+i, 0)
    let o_off = out_off+out_len
    let o_len = i+1
    
    // Write "-lc" at S+o_off+o_len
    i = 0
    let arg_lc = "-lc"
    while r8(arg_lc+8+i) != 0 { w8(S+o_off+o_len+i, r8(arg_lc+8+i)); i=i+1 }
    w8(S+o_off+o_len+i, 0)
    let lc_off = o_off+o_len
    let lc_len = i+1
    
    // Write "--dynamic-linker" at S+lc_off+lc_len
    i = 0
    let arg_dl = "--dynamic-linker"
    while r8(arg_dl+8+i) != 0 { w8(S+lc_off+lc_len+i, r8(arg_dl+8+i)); i=i+1 }
    w8(S+lc_off+lc_len+i, 0)
    let dl_off = lc_off+lc_len
    let dl_len = i+1
    
    // Write interp at S+dl_off+dl_len
    i = 0
    while r8(interp+i) != 0 { w8(S+dl_off+dl_len+i, r8(interp+i)); i=i+1 }
    w8(S+dl_off+dl_len+i, 0)
    let interp_off = dl_off+dl_len
    let interp_len = i+1
    
    // Build argv pointer array at S+2048
    let argv_arr = 2048
    w64(S+argv_arr+0, S+path_off)      // argv[0] = path
    w64(S+argv_arr+8, S+obj_off)       // argv[1] = obj_path
    w64(S+argv_arr+16, S+o_off)        // argv[2] = "-o"
    w64(S+argv_arr+24, S+out_off)      // argv[3] = out_path
    w64(S+argv_arr+32, S+lc_off)       // argv[4] = "-lc"
    w64(S+argv_arr+40, S+dl_off)       // argv[5] = "--dynamic-linker"
    w64(S+argv_arr+48, S+interp_off)   // argv[6] = interp
    w64(S+argv_arr+56, 0)              // argv[7] = NULL
    
    // Call execve builtin (path, argv, envp=0)
    execve(S+path_off, S+argv_arr, 0)
    
    // If execve returns, it failed
    exit(127)
}

// === MAIN ===
fn main(argc, argv) {
    kregs(); init_regs(); init_fregs(); init_cs(); setcc_init(); setcc_flt_init();
    // Phase 4.3: mark all vregs as "not a struct" (-1). mmap zero-fills, which
    // would collide with struct index 0, so explicitly init to -1.
    let vsi_init = 0
    while vsi_init < VREG_CAP { w64(vreg_struct + vsi_init*8, 0-1); w64(vreg_is_str + vsi_init*8, 0-1); w64(vreg_str_arr + vsi_init*8, 0-1); w64(vreg_is_big + vsi_init*8, 0-1); vsi_init = vsi_init+1 }
    if argc<2 { exit(13) }
    // --- A: optimization is ALWAYS ON (1.0.12). `-O` is accepted as a harmless
    // no-op flag for backward compatibility; opt_on is already 1 (global default).
    // Source/output use the simple convention: first non-flag argv = source,
    // next non-flag argv = output.
    let out_p = 0
    let srcp = 0
    let ai = 1
    // Android/Termux runs our ET_DYN via the bionic linker, which inserts the
    // program's own path as an extra argv slot (argc+1, self path at argv[1]).
    // Detect that by sniffing argv[1] for our own ELF magic and skip it.
    if argc>=2 {
        let sfp = r64(argv+1*8)
        // FIX 0.0.233: only sniff PATHS. When argv[1] is a "--" flag (e.g.
        // `qc --bare src out`), file_open fails and the old code exited
        // 14 — every flag-first invocation died. Flags are never ELF paths.
        let sniff_ok = 1
        if r8(sfp)==45 && r8(sfp+1)==45 { sniff_ok = 0 }
        let sfd = 0-1
        if sniff_ok == 1 { sfd = file_open(sfp, 0) }
        if sfd>=0 {
            let magbuf = mmap(16)
            let mn = file_read(sfd, magbuf, 4)
            file_close(sfd)
            if mn==4 && r8(magbuf)==127 && r8(magbuf+1)==69 && r8(magbuf+2)==76 && r8(magbuf+3)==70 { ai = 2 }
        }
    }
    while ai<argc {
        let ap=r64(argv+ai*8)
        // Declared here, not inside the flag branch: the argv step after the
        // branch has to know whether this element was `--lib`, and a value
        // declared in the branch is not in scope there.
        let is_lib=0
        // ignore any "-O" (and other "-X" flags) when picking source/output
        if !(r8(ap)==45 && r8(ap+1)==79) {
            // G2: overflow trap is ON by default (secure by default). Two flags:
            //   --overflow-trap      : accepted as a no-op (explicit opt-in)
            //   --no-overflow-trap   : turn the trap OFF (for code that relies on
            //                          two's-complement wraparound and isn't ported)
            if r8(ap)==45 && r8(ap+1)==45 {
                // Check for flags that start with "--"
                let is_ovf = 1; let ki=0
                let ovfstr = "overflow-trap"
                // argv strings are raw (no header); Quanta string literals carry an
                // 8-byte header, so read ovfstr starting at +8.
                while ki<13 { if r8(ap+2+ki) != r8(ovfstr+8+ki) { is_ovf=0; break }; ki=ki+1 }
                if is_ovf==1 { ovf_trap = 1 }
                else {
                    // try "--no-overflow-trap" (16 chars)
                    let is_novf = 1; let kj=0
                    let novfstr = "no-overflow-trap"
                    while kj<17 { if r8(ap+2+kj) != r8(novfstr+8+kj) { is_novf=0; break }; kj=kj+1 }
                    if is_novf==1 { ovf_trap = 0 }
                }
                
                let is_arm = 0   // x86-only build: no ARM target selection
                
                // P5: try "--emit-obj" (relocatable .o + linker, object-format pillar)
                let is_obj=1; let oa=0
                let emobj = "emit-obj"
                while oa<8 { if r8(ap+2+oa) != r8(emobj+8+oa) { is_obj=0; break }; oa=oa+1 }
                if is_obj==1 { emit_obj=1 }
                
                // P5.2: try "--emit-dynamic" (dynamic ELF with PT_INTERP + libc, for extern "C")
                let is_dyn=1; let od=0
                let emdyn = "emit-dynamic"
                while od<12 { if r8(ap+2+od) != r8(emdyn+8+od) { is_dyn=0; break }; od=od+1 }
                if is_dyn==1 { emit_dynamic=1 }

                // `--lib <soname>` (repeatable): add a DT_NEEDED entry.
                //
                // The value is the NEXT argv element, not part of this one. argv
                // strings are raw C strings (no 8-byte Quanta header), so it is
                // read from ap directly. Ignored without --emit-dynamic, since a
                // static binary has no dynamic section to put a DT_NEEDED in.
                let ol2=0
                let lstr2 = "lib"
                while ol2<3 { if r8(ap+2+ol2) != r8(lstr2+8+ol2) { break }; ol2=ol2+1 }
                if ol2==3 && ai+1 < argc {
                    is_lib=1
                    add_dyn_lib_c(r64(argv+(ai+1)*8))
                }

                
                // P5.1: try "--no-start" (9 chars) ? secondary object TU
                let is_nostart=1; let kc=0
                let nostr = "no-start"
                while kc<9 { if r8(ap+2+kc) != r8(nostr+8+kc) { is_nostart=0; break }; kc=kc+1 }
                if is_nostart==1 { no_start=1 }

                // 0.0.233 Phase D: "--bare" (4 chars) ? bare-metal ELF: the
                // 32-bit PVH prefix + Xen note (globals.quanta: bare).
                let is_bare=1; let bk=0; let is_bareflag=0
                let bstr = "bare"
                while bk<4 { if r8(ap+2+bk) != r8(bstr+8+bk) { is_bare=0; break }; bk=bk+1 }
                if is_bare==1 {
                    // "--bare" = "--" + 4 letters; ap+2+4 is the NUL.
                    if r8(ap+2+4)==0 { bare = 1; is_bareflag = 1 }
                }
                
                // P5.3: try "--link" (6 chars) ? link object file with libc (replaces quanta_link.sh)
                let is_link=1; let ol=0
                let lstr = "link"
                while ol<4 { if r8(ap+2+ol) != r8(lstr+8+ol) { is_link=0; break }; ol=ol+1 }
                if is_link==1 { do_link=1 }
                
                // P5.4: try "--emit-qobj" (11 chars) ? emit .qobj module cache
                let is_qobj=1; let oq=0
                let qobjstr = "emit-qobj"
                while oq<9 { if r8(ap+2+oq) != r8(qobjstr+8+oq) { is_qobj=0; break }; oq=oq+1 }
                if is_qobj==1 { emit_qobj=1 }
                
                if !is_novf && !is_arm && !is_obj && !is_nostart && !is_dyn && !is_link && !is_qobj && !is_lib && !is_bareflag {
                    if srcp==0 { srcp=ap } else if out_p==0 { out_p=ap }
                }
                // For --link, we do NOT capture the flag itself as srcp/out_p.
                // The NEXT two args (object file + output) will be captured in subsequent iterations.
            } else {
                if srcp==0 { srcp=ap }
                else if out_p==0 { out_p=ap }
            }
        }
        // `--lib`'s value is a separate argv element; step over it here so it is
        // never mistaken for the source or the output path. Without this,
        // `qc --emit-dynamic --lib libcuda.so.1 in.qc out` took "libcuda.so.1" as
        // srcp and "in.qc" as out_p.
        if is_lib==1 && ai+1 < argc { ai=ai+1 }
        ai=ai+1
    }
    
    // Seed DT_NEEDED with libc.so.6, unconditionally, when dynamic linking is on.
    //
    // Done after the flag loop so `--lib` order cannot affect it, and
    // unconditionally rather than only when no --lib was given, because libc is
    // the C runtime every dynamic executable ends up wanting and a program that
    // lists only libcuda.so.1 would otherwise fail to start if it also calls
    // printf. An explicit --no-libc is the way to opt out, and belongs here if a
    // real case needs it (nothing in the tree does today).
    // The literal is passed inline, not via a local. `let lc = "libc.so.6"` then
    // add_dyn_lib(lc) put a value in `lc` whose meaning the compiler does not
    // guarantee to be the literal's address -- and the soname that actually
    // reached .dynstr was "abs", the first extern, so the local was reading
    // reused storage by the time it was used. One expression, no local.
    // Passed through add_dyn_lib_c (the RAW form) with the +8 skipped, because
    // a Quanta literal is [8:len][bytes] and this compiler gives no guarantee
    // that a literal used as an argument still means the literal: the soname
    // that reached .dynstr was "abs", the first extern symbol, so the argument
    // slot was reused before the callee read it. Writing the bytes into dyn_libs
    // from a literal the callee never dereferences avoids depending on that.
    if emit_dynamic == 1 {
        // Copy the seeded soname into a global first; see g_libc_soname. Then
        // hand it to the raw-string path, which is the same one --lib uses and
        // the only one proven to survive the call.
        let si = 0
        while si < 9 { mem_store8(g_libc_soname + si, mem_load8("libc.so.6" + 8 + si)); si = si + 1 }
        mem_store8(g_libc_soname + 9, 0)
        add_dyn_lib_c(g_libc_soname)
    }

    // Handle --link early: link object file with libc and exit
    if do_link == 1 {
        if srcp == 0 || out_p == 0 {
            let err = "usage: qc --link <input.o> <output>\n"
            file_write(2, err+8, len(err))
            exit(1)
        }
        // Debug: print what we're linking
        link_object_with_libc(srcp, out_p)
        exit(0)
    }
    
    // 0.0.226: refuse an output path that is the source path.
    //
    // `qc SRC SRC` read SRC and then opened SRC for writing as the output,
    // replacing the source with a compiled binary. That is not hypothetical:
    // lib/std/gguf.quanta (155 KB of source) was destroyed this way and had to
    // be rebuilt from git.
    //
    // Two things make this need care:
    //
    // 1. srcp/out_p are RAW C strings from argv (no 8-byte Quanta length
    //    header). The `stat` builtin is not usable here: it emits argp8(),
    //    which adds 8 to the path, so it would stat the path with its first 8
    //    characters cut off -- "/tmp/x.quanta" becomes "x.quanta", usually
    //    ENOENT, and the check would silently never fire. newfstatat is issued
    //    through syscall() instead, which passes arguments raw.
    //
    // 2. Compared by (st_dev, st_ino), not by the path bytes. "./x.quanta" and
    //    "x.quanta" are different strings naming one file, and a symlink adds a
    //    third name; a text compare would miss exactly the cases that matter.
    //    stat follows symlinks, which is what is wanted -- writing through a
    //    symlink to the source destroys the source.
    //
    // Checked before the source is opened and before any output mode runs
    // (ELF, --emit-obj, --emit-qobj, --link), because all of them write out_p.
    // AT_FDCWD = -100; syscall 262 = newfstatat.
    if srcp != 0 && out_p != 0 {
        let rs = syscall(262, -100, srcp, stat_buf, 0, 0, 0)
        // If the output does not exist yet there is nothing to clobber, so a
        // failed stat on out_p skips the check rather than failing the compile.
        if rs == 0 {
            let ro = syscall(262, -100, out_p, stat_buf_out, 0, 0, 0)
            if ro == 0 {
                let sdev = mem_load(stat_buf + 0)
                let sino = mem_load(stat_buf + 8)
                let odev = mem_load(stat_buf_out + 0)
                let oino = mem_load(stat_buf_out + 8)
                if sdev == odev && sino == oino {
                    let msg = "error: output path is the source path (refusing to overwrite the input)\n"
                    file_write(2, msg+8, len(msg))
                    exit(1)
                }
            }
        }
    }

    let fd=file_open(srcp,0)
    if fd<0 { exit(14) }
    // FIX-0.0.9 (LOW): a source file larger than the 16MB read buffer was
    // silently truncated ? file_read stops at 16777216 bytes and the old
    // post-expansion check only caught the EXPANSION overflow, so a 17MB main
    // file compiled its first 16MB with no diagnostic (mid-token truncation
    // silently changes semantics). Pre-check the real size via stat() and
    // fail closed with a message before reading.
    let srcsz = stat(srcp, stat_buf)
    if srcsz==0 {
        let fsize = r64(stat_buf + 48)   // st_size at offset 48 (x86-64 struct stat)
        if fsize >= 16777216 {
            let mt = "error: source file exceeds 16MB limit\n"
            file_write(2, mt+8, len(mt)); exit(1)
        }
    }
    let mlen = file_read(fd, mainsrc, 16777216); file_close(fd)
    if mlen<=0 { exit(15) }
    // Compile-time #import expansion: inline all imported sources into 'src'.
    // fill include prefix byte-buffers: "std/" and "ext/"
    w8(imp_std_pfx+0, 115); w8(imp_std_pfx+1, 116); w8(imp_std_pfx+2, 100); w8(imp_std_pfx+3, 47)  // "std/"
    w8(imp_ext_pfx+0, 101); w8(imp_ext_pfx+1, 120); w8(imp_ext_pfx+2, 116); w8(imp_ext_pfx+3, 47)  // "ext/"
    w8(imp_lib_pfx+0, 108); w8(imp_lib_pfx+1, 105); w8(imp_lib_pfx+2, 98); w8(imp_lib_pfx+3, 47)  // "lib/"
    imp_err = 0; imp_seenc = 0
    srclen = 0
    // top-level include dir = dirname of the main source path (so a relative
    // quoted include in the main file resolves next to it).
    imp_dir_from(srcp, src_strlen(srcp))
    expand_includes(mainsrc, mlen, 0)
    // SIMPLE-SURFACE: detect if this looks like a pure script (no top-level
    // fn/struct/enum/global/const). If so, rewrite bare `name () {` to `fn name () {`
    // then wrap in `fn main(){...}`. This runs BEFORE final wrap check so
    // the final wrap sees the rewritten "fn main" and skips.
    let is_pure_script = 1
    let si = 0
    while si < srclen {
        let prev = 0; if si>0 { prev = r8(src+si-1) }
        if si==0 || prev==10 || prev==32 || prev==9 || prev==13 {
            if r8(src+si)==102 && r8(src+si+1)==110 && r8(src+si+2)==32 { is_pure_script=0 }      // "fn "
            else if r8(src+si)==115 && r8(src+si+1)==116 && r8(src+si+2)==114 && r8(src+si+3)==117 && r8(src+si+4)==99 && r8(src+si+5)==116 && r8(src+si+6)==32 { is_pure_script=0 } // "struct "
            else if r8(src+si)==101 && r8(src+si+1)==110 && r8(src+si+2)==117 && r8(src+si+3)==109 && r8(src+si+4)==32 { is_pure_script=0 } // "enum "
            else if r8(src+si)==103 && r8(src+si+1)==108 && r8(src+si+2)==111 && r8(src+si+3)==98 && r8(src+si+4)==97 && r8(src+si+5)==108 && r8(src+si+6)==32 { is_pure_script=0 } // "global "
            else if r8(src+si)==99 && r8(src+si+1)==111 && r8(src+si+2)==110 && r8(src+si+3)==115 && r8(src+si+4)==116 && r8(src+si+5)==32 { is_pure_script=0 } // "const "
        }
        si = si + 1
    }
    // Rewrite bare `name () {` -> `fn name () {` for EVERY file (not just pure
    // scripts). `fn`-prefixed defs are skipped via skip_fn, so a file mixing
    // `fn main(){}` and bare `helper(){}` compiles. `fn` is now optional.
    {
        let bi = 0
            while bi < srclen {
                let c0 = r8(src+bi)
                // Only convert identifiers at statement start (column 0 / start
                // of file). Excludes indented control flow like `else if (x) {`
                // which also matches name(){} but is NOT a function definition.
                if (c0>=65&&c0<=90)||(c0>=97&&c0<=122)||c0==95 {
