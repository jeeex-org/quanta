import std/fs
import std/kv_cache

// Test KV cache: append and retrieve
fn main() {
    kv_init(128)
    
    // Append 3 tokens
    let k = mem_alloc(8 * 256 * 8)
    let v = mem_alloc(8 * 256 * 8)
    
    // Token 0
    mem_store(k, i2f(10))
    mem_store(v, i2f(100))
    kv_append(k, v)
    
    // Token 1
    mem_store(k, i2f(20))
    mem_store(v, i2f(200))
    kv_append(k, v)
    
    // Token 2
    mem_store(k, i2f(30))
    mem_store(v, i2f(300))
    kv_append(k, v)
    
    // Verify
    if kv_pos != 3 { return 1 }
    
    // Check K values
    if kv_get_k(0, 0, 0) != i2f(10) { return 1 }
    if kv_get_k(1, 0, 0) != i2f(20) { return 1 }
    if kv_get_k(2, 0, 0) != i2f(30) { return 1 }
    
    // Check V values
    if kv_get_v(0, 0, 0) != i2f(100) { return 1 }
    if kv_get_v(1, 0, 0) != i2f(200) { return 1 }
    if kv_get_v(2, 0, 0) != i2f(300) { return 1 }
    
    // Test clear
    kv_clear()
    if kv_pos != 0 { return 1 }
    
    return 0
}