// external_call: verifies the explicit GLOBAL function-call sigil $(func) and
// $(func(args)) — both forms compile and run as top-level (global) calls.
// $(func) is a thin alias of $(func()); bare func()/func is local-first.

fn add(a, b) { return a + b }
fn forty_two() { return 42 }

// $(func) consumed: let x = $(forty_two)
// $(func(args)) consumed: printi($(add(3,4)))
// bare func() statement: forty_two()
// $(func()) explicit-paren alias
main() {
    let x = $(forty_two)
    if x != 42 { return 1 }
    if $(add(3, 4)) != 7 { return 2 }
    if $(forty_two()) != 42 { return 3 }
    forty_two()            // bare call statement (local/global)
    if $(add(10, 5)) != 15 { return 4 }
    0
}
