// x25519_mul_specific_test.quanta — test fe_mul(t0, t3, t4)

import std/x25519

fn main() {
  println("Test fe_mul specific values...")
  
  let t0 = mem_alloc(8*8)
  fe_zero(t0)
  mem_store(t0, 1)  // x2 + z2 = 1 + 0 = 1
  
  let t3 = mem_alloc(8*8)
  fe_zero(t3)
  mem_store(t3, 9)  // x3 - z3 = 9 - 1 = 8
  
  let t4 = mem_alloc(8*8)
  fe_mul(t0, t3, t4)
  
  println("Done")
  println(0)
  exit(0)
}