// Key Derivation constants test
fn kdf_algo_pbkdf2(): i64 { return 1 }
fn kdf_algo_scrypt(): i64 { return 2 }
fn kdf_algo_argon2id(): i64 { return 3 }
fn kdf_algo_hkdf(): i64 { return 4 }

fn ks_type_secret(): i64 { return 1 }
fn ks_type_private_key(): i64 { return 2 }
fn ks_type_certificate(): i64 { return 3 }
fn ks_type_hsm_handle(): i64 { return 4 }

fn rotation_daily(): i64 { return 86400 }
fn rotation_weekly(): i64 { return 604800 }
fn rotation_monthly(): i64 { return 2592000 }
fn rotation_yearly(): i64 { return 31536000 }

fn main() {
    if kdf_algo_pbkdf2() != 1 { return 1 }
    if kdf_algo_scrypt() != 2 { return 2 }
    if kdf_algo_argon2id() != 3 { return 3 }
    if kdf_algo_hkdf() != 4 { return 4 }
    if ks_type_secret() != 1 { return 5 }
    if ks_type_private_key() != 2 { return 6 }
    if ks_type_certificate() != 3 { return 7 }
    if ks_type_hsm_handle() != 4 { return 8 }
    if rotation_daily() != 86400 { return 9 }
    if rotation_weekly() != 604800 { return 10 }
    if rotation_monthly() != 2592000 { return 11 }
    if rotation_yearly() != 31536000 { return 12 }
    return 0
}