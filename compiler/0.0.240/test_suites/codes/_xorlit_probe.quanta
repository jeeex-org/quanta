fn main() {
  let a = 0x123456789ABCDEF0
  // literal XOR with high-bit constant
  let bl = a ^ 0x800000000000808a
  let expl = 0x923456789ABC04FA
  let dl = bl ^ expl
  // vreg XOR with same constant
  let hi = 0x800000000000808a
  let bv = a ^ hi
  let dv = bv ^ expl
  if dl == 0 && dv == 0 { exit(0) } else { exit(1) }
}
