// Audit log constants test
fn log_entry_x509(): i64 { return 0 }
fn log_entry_precert(): i64 { return 1 }
fn log_entry_general(): i64 { return 2 }

fn th_version(): i64 { return 1 }
fn th_struct_size(): i64 { return 116 }

fn bundle_version(): i64 { return 1 }

fn prov_struct_size(): i64 { return 48 }
fn mat_struct_size(): i64 { return 24 }

fn spdx_version(): i64 { return 2 }
fn spdx_struct_size(): i64 { return 60 }

fn cdx_version(): i64 { return 1 }
fn cdx_struct_size(): i64 { return 52 }

fn attest_struct_size(): i64 { return 72 }

fn trillian_op_add(): i64 { return 0 }
fn trillian_op_get(): i64 { return 1 }
fn trillian_op_prove(): i64 { return 2 }
fn trillian_op_verify(): i64 { return 3 }

fn main() {
    if log_entry_x509() != 0 { return 1 }
    if log_entry_precert() != 1 { return 2 }
    if log_entry_general() != 2 { return 3 }
    if th_version() != 1 { return 4 }
    if th_struct_size() != 116 { return 5 }
    if bundle_version() != 1 { return 6 }
    if prov_struct_size() != 48 { return 7 }
    if mat_struct_size() != 24 { return 8 }
    if spdx_version() != 2 { return 9 }
    if spdx_struct_size() != 60 { return 10 }
    if cdx_version() != 1 { return 11 }
    if cdx_struct_size() != 52 { return 12 }
    if attest_struct_size() != 72 { return 13 }
    if trillian_op_add() != 0 { return 14 }
    if trillian_op_get() != 1 { return 15 }
    if trillian_op_prove() != 2 { return 16 }
    if trillian_op_verify() != 3 { return 17 }
    return 0
}