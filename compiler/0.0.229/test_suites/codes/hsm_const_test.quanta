// HSM constants test
fn pkcs11_ckr_ok(): i64 { return 0 }
fn pkcs11_cko_private_key(): i64 { return 3 }
fn pkcs11_ckk_ml_kem(): i64 { return 100 }
fn pkcs11_ckk_ml_dsa(): i64 { return 101 }
fn pkcs11_ckk_slh_dsa(): i64 { return 102 }
fn pkcs11_ckm_ml_kem_key_pair_gen(): i64 { return 200 }
fn pkcs11_ckm_ml_dsa_key_pair_gen(): i64 { return 210 }
fn pkcs11_ckm_slh_dsa_key_pair_gen(): i64 { return 220 }

fn tpm_rh_srk(): i64 { return 0x40000000 }
fn tpm_rh_owner(): i64 { return 0x40000001 }
fn tpm_rh_endorsement(): i64 { return 0x4000000B }
fn tpm_cc_create_primary(): i64 { return 0x0131 }
fn tpm_cc_create(): i64 { return 0x0153 }
fn tpm_cc_load(): i64 { return 0x0157 }
fn tpm_cc_get_random(): i64 { return 0x017B }
fn tpm_cc_sign(): i64 { return 0x0182 }
fn tpm_cc_attest(): i64 { return 0x018F }

fn sgx_report_size(): i64 { return 432 }
fn sgx_quote_size(): i64 { return 1024 }
fn sev_report_size(): i64 { return 1024 }

fn hsm_backend_pkcs11(): i64 { return 1 }
fn hsm_backend_tpm(): i64 { return 2 }
fn hsm_backend_sgx(): i64 { return 3 }
fn hsm_backend_sev(): i64 { return 4 }

fn main() {
    if pkcs11_ckr_ok() != 0 { return 1 }
    if pkcs11_cko_private_key() != 3 { return 2 }
    if pkcs11_ckk_ml_kem() != 100 { return 3 }
    if pkcs11_ckk_ml_dsa() != 101 { return 4 }
    if pkcs11_ckk_slh_dsa() != 102 { return 5 }
    if pkcs11_ckm_ml_kem_key_pair_gen() != 200 { return 6 }
    if pkcs11_ckm_ml_dsa_key_pair_gen() != 210 { return 7 }
    if pkcs11_ckm_slh_dsa_key_pair_gen() != 220 { return 8 }
    if tpm_rh_srk() != 0x40000000 { return 9 }
    if tpm_rh_owner() != 0x40000001 { return 10 }
    if tpm_rh_endorsement() != 0x4000000B { return 11 }
    if tpm_cc_create_primary() != 0x0131 { return 12 }
    if tpm_cc_create() != 0x0153 { return 13 }
    if tpm_cc_load() != 0x0157 { return 14 }
    if tpm_cc_get_random() != 0x017B { return 15 }
    if tpm_cc_sign() != 0x0182 { return 16 }
    if tpm_cc_attest() != 0x018F { return 17 }
    if sgx_report_size() != 432 { return 18 }
    if sgx_quote_size() != 1024 { return 19 }
    if sev_report_size() != 1024 { return 20 }
    if hsm_backend_pkcs11() != 1 { return 21 }
    if hsm_backend_tpm() != 2 { return 22 }
    if hsm_backend_sgx() != 3 { return 23 }
    if hsm_backend_sev() != 4 { return 24 }
    return 0
}