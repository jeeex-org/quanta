fn main() {
    println(parity(11))
    println(parity(15))
    println(parity(0))
    println(parity(255))
    let x = 0x12345678
    println(bitfield(x, 0, 8))
    println(bitfield(x, 8, 8))
    println(bitfield(x, 16, 16))
    println(bitfield(x, 4, 4))
    println(bitfield(x, 28, 4))
    println(bswap16(0x1234))
    println(bswap32(0x12345678))
    println(bswap64(0x1122334455667788))
}
