// SHA3 const test
fn main() {
    // SHA3_224 = 0
    if 0 != 0 { return 1 }
    // SHA3_256 = 1
    if 1 != 1 { return 2 }
    // SHA3_384 = 2
    if 2 != 2 { return 3 }
    // SHA3_512 = 3
    if 3 != 3 { return 4 }
    // SHAKE128 = 4
    if 4 != 4 { return 5 }
    // SHAKE256 = 5
    if 5 != 5 { return 6 }
    return 0
}