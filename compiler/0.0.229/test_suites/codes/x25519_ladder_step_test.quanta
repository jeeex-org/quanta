// x25519_ladder_step_test.quanta — test one ladder step

import std/x25519

fn main() {
  println("Test one ladder step...")
  
  let x1 = mem_alloc(8*8)
  let x2 = mem_alloc(8*8)
  let z2 = mem_alloc(8*8)
  let x3 = mem_alloc(8*8)
  let z3 = mem_alloc(8*8)
  let A24 = mem_alloc(8*8)
  
  let t0 = mem_alloc(8*8)
  let t1 = mem_alloc(8*8)
  let t2 = mem_alloc(8*8)
  let t3 = mem_alloc(8*8)
  let t4 = mem_alloc(8*8)
  
  // Initialize with u=9
  let u = mem_alloc(32)
  let i = 0
  while i < 32 { mem_store8(u + i, 0); i = i + 1 }
  mem_store8(u, 9)
  
  fe_from_bytes(u, x1)
  fe_one(x2)
  fe_zero(z2)
  fe_from_bytes(u, x3)
  fe_one(z3)
  
  fe_zero(A24)
  mem_store(A24, 121666)
  
  println("init done")
  
  // One ladder step
  // t0 = x2 + z2
  fe_add(x2, z2, t0)
  println("t0 = x2 + z2 done")
  
  // t1 = x2 - z2
  fe_sub(x2, z2, t1)
  println("t1 = x2 - z2 done")
  
  // t2 = x3 + z3
  fe_add(x3, z3, t2)
  println("t2 = x3 + z3 done")
  
  // t3 = x3 - z3
  fe_sub(x3, z3, t3)
  println("t3 = x3 - z3 done")
  
  // t4 = t0 * t3
  fe_mul(t0, t3, t4)
  println("t4 = t0 * t3 done")
  
  // t0 = t1 * t2
  fe_mul(t1, t2, t0)
  println("t0 = t1 * t2 done")
  
  println("all ops done")
  println(0)
  exit(0)
}