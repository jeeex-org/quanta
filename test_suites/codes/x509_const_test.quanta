// X.509 const test
fn main() {
    // X509_CERT_VERSION = 2
    if 2 != 2 { return 1 }
    // X509_SERIAL_NUMBER = 1
    if 1 != 1 { return 2 }
    // X509_SIGNATURE_ALGO = 8 (ML-DSA-65)
    if 8 != 8 { return 3 }
    // X509_ISSUER_CN = "Test CA"
    if 0 != 0 { return 4 }
    // X509_SUBJECT_CN = "test.example.com"
    if 0 != 0 { return 5 }
    // X509_NOT_BEFORE = 1704067200
    if 1704067200 != 1704067200 { return 6 }
    // X509_NOT_AFTER = 1735689600
    if 1735689600 != 1735689600 { return 7 }
    // X509_PUBLIC_KEY_ALGO = 5 (ML-KEM-768)
    if 5 != 5 { return 8 }
    // X509_BASIC_CONSTRAINTS_CA = 1
    if 1 != 1 { return 9 }
    // X509_KEY_USAGE_DIGITAL_SIG = 128
    if 128 != 128 { return 10 }
    // X509_KEY_USAGE_KEY_ENC = 32
    if 32 != 32 { return 11 }
    // X509_SAN_DNS = "test.example.com"
    if 0 != 0 { return 12 }
    return 0
}