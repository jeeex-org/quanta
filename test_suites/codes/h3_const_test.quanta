fn h3_version(): i64 { return 0x00000001 }
fn h3_frame_data(): i64 { return 0x00 }
fn h3_frame_headers(): i64 { return 0x01 }
fn h3_frame_settings(): i64 { return 0x04 }
fn h3_frame_push_promise(): i64 { return 0x05 }
fn h3_frame_goaway(): i64 { return 0x07 }
fn h3_frame_max_push_id(): i64 { return 0x0D }
fn h3_err_no_error(): i64 { return 0x0100 }
fn h3_err_general_protocol_error(): i64 { return 0x0101 }
fn h3_settings_qpack_max_table_capacity(): i64 { return 0x01 }
fn h3_settings_max_field_section_size(): i64 { return 0x02 }
fn h3_settings_qpack_blocked_streams(): i64 { return 0x03 }
fn h3_settings_enable_connect_protocol(): i64 { return 0x08 }
fn h3_default_max_field_section_size(): i64 { return 16384 }
fn h3_default_qpack_blocked_streams(): i64 { return 100 }
fn h3_stream_type_control(): i64 { return 0x00 }
fn h3_stream_type_request(): i64 { return 0x02 }
fn h3_stream_type_qpack_encoder(): i64 { return 0x03 }
fn h3_stream_type_qpack_decoder(): i64 { return 0x04 }

fn main() {
    if h3_version() != 0x00000001 { exit(1) }
    if h3_frame_data() != 0x00 { exit(2) }
    if h3_frame_headers() != 0x01 { exit(3) }
    if h3_frame_settings() != 0x04 { exit(4) }
    if h3_frame_goaway() != 0x07 { exit(5) }
    if h3_frame_max_push_id() != 0x0D { exit(6) }
    if h3_err_no_error() != 0x0100 { exit(7) }
    if h3_err_general_protocol_error() != 0x0101 { exit(8) }
    if h3_settings_qpack_max_table_capacity() != 0x01 { exit(9) }
    if h3_settings_max_field_section_size() != 0x02 { exit(10) }
    if h3_default_max_field_section_size() != 16384 { exit(11) }
    if h3_default_qpack_blocked_streams() != 100 { exit(12) }
    if h3_stream_type_control() != 0x00 { exit(13) }
    if h3_stream_type_request() != 0x02 { exit(14) }
    if h3_stream_type_qpack_encoder() != 0x03 { exit(15) }
    if h3_stream_type_qpack_decoder() != 0x04 { exit(16) }
    exit(0)
}