// P11 closure captures: a closure body may reference a local of the enclosing
// function. Captured BY VALUE into a heap env array at construction time; the
// body reads it back out of env (passed in r10 by the closure-call ABI).
fn main() {
    let y = 10
    let f = |x| { x + y }
    return f(5)        // 15
}
