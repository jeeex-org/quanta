// Supply Chain Security constants test
fn policy_type_allow(): i64 { return 0 }
fn policy_type_deny(): i64 { return 1 }
fn policy_type_require(): i64 { return 2 }
fn policy_type_attest(): i64 { return 3 }

fn slsa_level_0(): i64 { return 0 }
fn slsa_level_1(): i64 { return 1 }
fn slsa_level_2(): i64 { return 2 }
fn slsa_level_3(): i64 { return 3 }

fn attest_type_build(): i64 { return 0 }
fn attest_type_test(): i64 { return 1 }
fn attest_type_deploy(): i64 { return 2 }
fn attest_type_scan(): i64 { return 3 }
fn attest_type_review(): i64 { return 4 }

fn trillian_op_add(): i64 { return 0 }
fn trillian_op_get(): i64 { return 1 }
fn trillian_op_prove(): i64 { return 2 }
fn trillian_op_verify(): i64 { return 3 }

fn main() {
    if policy_type_allow() != 0 { return 1 }
    if policy_type_deny() != 1 { return 2 }
    if policy_type_require() != 2 { return 3 }
    if policy_type_attest() != 3 { return 4 }
    if slsa_level_0() != 0 { return 5 }
    if slsa_level_1() != 1 { return 6 }
    if slsa_level_2() != 2 { return 7 }
    if slsa_level_3() != 3 { return 8 }
    if attest_type_build() != 0 { return 9 }
    if attest_type_test() != 1 { return 10 }
    if attest_type_deploy() != 2 { return 11 }
    if attest_type_scan() != 3 { return 12 }
    if attest_type_review() != 4 { return 13 }
    if trillian_op_add() != 0 { return 14 }
    if trillian_op_get() != 1 { return 15 }
    if trillian_op_prove() != 2 { return 16 }
    if trillian_op_verify() != 3 { return 17 }
    return 0
}