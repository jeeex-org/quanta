// simple_min: compute the minimum of two ints with a conditional (no std lib).
// Real assertion: returns the smaller value; would fail if the branch/compare
// were broken. (Was a no-op: just `return 0`.)
fn main() {
    let a = 12
    let b = 5
    let m = a
    if b < a { m = b }
    return m   // 5
}
