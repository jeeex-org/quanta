// THE ACCEPTANCE ROW for 0.0.259 ATOMICS: the loader's failing pattern.
//
// WHAT IT IS. A concurrent claim/accumulate loop -- the shape a work-stealing
// matvec dispatcher needs -- run over 2048 rows with N workers, where the RESULT
// IS CHECKED EXACTLY:
//
//   * every one of the 2048 rows is claimed and processed EXACTLY ONCE
//     (a per-row write counter, so a duplicate claim is a failure rather than a
//     silently-overwritten cell),
//   * the accumulated total equals 0+1+...+2047 = 2096128 exactly,
//   * the claim counter ends at exactly 2048 + N (each worker's terminating
//     claim overshoots by one; that number is a fingerprint of the loop's shape,
//     not a tolerance),
//   * and it is run at 1, 2, 4 and 8 workers, checking EVERY row -- not a
//     reduction -- because 0.0.258's own thread_concurrent_test documents the
//     same doctrine for the static-slice pool.
//
// WHY IT IS RED ON 0.0.258, AND WHY IT IS BOUNDED. This row claims with
// `atomic_add(&ws_next, 1)` -- a counter living in a GLOBAL, which is how the
// loader would naturally write it and which is precisely the shape that was
// measured wrong. On 0.0.258 `&global` returned the address of a TEMPORARY, so
// every worker incremented a private cell: the claim value came back 0 forever,
// every worker re-processed row 0, rows 1..2047 were never touched, and the
// total was wrong. (Measured directly: `atomic_add(&g,1)` returned 0 on every
// call and left g at 0.) That is the 931-of-2048-rows-wrong silent miscompile.
//
// The loop carries a STEP BUDGET on purpose. The unbounded form HANGS on
// 0.0.258 (measured: rc 124 under the 15 s harness cap), and a row that eats a
// 15 s timeout on every red run is a row that trains people to ignore the gate.
// With the budget the broken counter produces a WRONG ANSWER immediately, which
// is the failure it actually is. Both shapes are exercised: the same loop is run
// again with the counter in a HEAP CELL reached through a global pointer -- the
// shape lib/std/gguf_mm.quanta's pool protocol already used, and which worked on
// 0.0.258 -- so the row also pins that the fix did not break it.
//
// rc: 0 = pass, otherwise the first failing case number.
let WS_N = 2048
let WS_BUDGET = 6000

// --- shape A: counter in a GLOBAL, claimed with &global (RED on 0.0.258) -----
let ws_next = 0
let ws_sum = 0
let ws_dup = 0
let ws_rows = 0

fn ws_worker_g(t) {
    let steps = 0
    let i = atomic_add(&ws_next, 1)
    while i < WS_N && steps < WS_BUDGET {
        let c = mem_load(ws_rows + i * 8) + 1
        mem_store(ws_rows + i * 8, c)
        if c > 1 { atomic_add(&ws_dup, 1) }
        atomic_add(&ws_sum, i)
        steps = steps + 1
        i = atomic_add(&ws_next, 1)
    }
    return steps
}

// --- shape B: counter in a HEAP CELL reached through a global pointer ---------
let wsh_next = 0
let wsh_sum = 0
let wsh_dup = 0
let wsh_rows = 0

fn ws_worker_h(t) {
    let steps = 0
    let i = atomic_add(wsh_next, 1)
    while i < WS_N && steps < WS_BUDGET {
        let c = mem_load(wsh_rows + i * 8) + 1
        mem_store(wsh_rows + i * 8, c)
        if c > 1 { atomic_add(wsh_dup, 1) }
        atomic_add(wsh_sum, i)
        steps = steps + 1
        i = atomic_add(wsh_next, 1)
    }
    return steps
}

// Every row exactly once, the total exact, the claim count exact.
// Returns 0, or 1..3 naming what was wrong.
fn ws_check(nw, nnext, nsum, ndup, nrows) -> i64 {
    let want = 0
    let r = 0
    while r < WS_N {
        want = want + r
        r = r + 1
    }
    // 1: a row was claimed more than once, or never
    r = 0
    while r < WS_N {
        if mem_load(nrows + r * 8) != 1 { return 1 }
        r = r + 1
    }
    // 2: the accumulator is not the exact sum of the row indices
    if nsum != want { return 2 }
    // 3: the claim counter is not exactly WS_N + nw
    if nnext != WS_N + nw { return 3 }
    if ndup != 0 { return 1 }
    return 0
}

fn ws_alloc() {
    ws_rows = mem_alloc(WS_N * 8)
    wsh_rows = mem_alloc(WS_N * 8)
    wsh_next = mem_alloc(8)
    wsh_sum = mem_alloc(8)
    wsh_dup = mem_alloc(8)
    let r = 0
    while r < WS_N {
        mem_store(ws_rows + r * 8, 0)
        mem_store(wsh_rows + r * 8, 0)
        r = r + 1
    }
}

// Run shape A at nw workers. rc 0 = pass, else 10+c / 20+c etc.
fn ws_run_g(nw) -> i64 {
    ws_next = 0
    ws_sum = 0
    ws_dup = 0
    let r = 0
    while r < WS_N { mem_store(ws_rows + r * 8, 0); r = r + 1 }
    let slots = mem_alloc(nw * 8)
    let t = 0
    while t < nw {
        mem_store(slots + t * 8, thread_create(ws_worker_g, t))
        t = t + 1
    }
    t = 0
    while t < nw {
        thread_join(mem_load(slots + t * 8))
        t = t + 1
    }
    let bad = ws_check(nw, ws_next, ws_sum, ws_dup, ws_rows)
    if bad != 0 { return 10 + bad }
    return 0
}

fn ws_run_h(nw) -> i64 {
    mem_store(wsh_next, 0)
    mem_store(wsh_sum, 0)
    mem_store(wsh_dup, 0)
    let r = 0
    while r < WS_N { mem_store(wsh_rows + r * 8, 0); r = r + 1 }
    let slots = mem_alloc(nw * 8)
    let t = 0
    while t < nw {
        mem_store(slots + t * 8, thread_create(ws_worker_h, t))
        t = t + 1
    }
    t = 0
    while t < nw {
        thread_join(mem_load(slots + t * 8))
        t = t + 1
    }
    let bad = ws_check(nw, mem_load(wsh_next), mem_load(wsh_sum), mem_load(wsh_dup), wsh_rows)
    if bad != 0 { return 20 + bad }
    return 0
}

fn main() -> i64 {
    ws_alloc()
    let nw = 1
    while nw <= 8 {
        let a = ws_run_g(nw)
        if a != 0 { return a }
        let b = ws_run_h(nw)
        if b != 0 { return b }
        nw = nw * 2
    }
    return 0
}
