// Regression test: unsigned width semantics. u8/u16/u32 arithmetic must
// wrap/truncate to the declared bit width (not silently stay 64-bit).
// Expect (each on its own line): 0 0 0 44
fn main() {
  let a: u8 = 255
  a = a + 1
  printi(a); println(0)        // 255+1 wraps to 0

  let b: u16 = 65535
  b = b + 1
  printi(b); println(0)        // 65535+1 wraps to 0

  let c: u32 = 4294967295
  c = c + 1
  printi(c); println(0)        // 4294967295+1 wraps to 0

  let d: u8 = 100
  d = d * 3
  printi(d); println(0)        // 300 truncates to 44 (300 & 0xFF)
  return 0
}
