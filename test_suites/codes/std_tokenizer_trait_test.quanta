// ===========================================================================
// std_tokenizer_trait_test.quanta
//
// Phase 10. The tokenizer family seam.
//
// Every expectation that names a token id comes from the FIXTURE, not from this
// tree: tests/fixtures/tokenizer_ref.txt, generated by scripts/audit/gen_tokenizer_ref.py
// driving upstream llama.cpp's own test-tokenizer-0 against the real
// /opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf. Where this file and
// the fixture disagree, the fixture is right.
//
// TRAP THIS FILE RESPECTS, and it cost real debugging:
//   A Quanta string expression is the [u64 len][bytes][NUL] HEADER pointer, so
//   the bytes of "a" are at (a + 8), NOT at a. Passing `a` to bpe_encode reads
//   the LENGTH as the first content byte. An earlier version of this test read
//   the literal directly and produced 5 ids for "Hello" where upstream produces
//   one (35808) -- which looked exactly like a broken tokenizer and was not.
//
// Expected values decoded from the fixture (base64 prompt -> ids):
//   YQ==                 'a'            -> 73
//   IA==                 ' '            -> 229
//   SGVsbG8=             'Hello'        -> 35808
//   aGVsbG8gd29ybGQ=     'hello world'  -> 52071, 1530
//   VGhlIHF1aWNrIGJyb3duIGZveCBqdW1wcyBvdmVyIHRoZSBsYXp5IGRvZy4=
//                         -> 10 ids, see block 5
//
// Compiler facts used here, both measured:
//   - `x != ""` is TRUE for identical strings; emptiness is equals(x,"")==0
//   - `last` and `kind` are reserved type keywords

import std/tokenizer_trait
import std/str

let MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

let FAIL = 0

fn check(id, ok) -> i64 {
    if ok != 1 {
        print("  FAIL check "); print(id); print("\n")
        FAIL = FAIL + 1
    }
    return 0
}

// Encode a Quanta string literal through the trait, resolving the header.
fn enc(lit, ids, max_ids) -> i64 {
    return vt_encode(lit + 8, len(lit), ids, max_ids)
}

fn id_at(ids, i) -> i64 { return mem_load(ids + i * 8) }

// ---------------------------------------------------------------------------
// 1. The family is read from the MODEL'S metadata.
//
// Verified on the real GGUF: tokenizer.ggml.model = "gpt2",
// tokenizer.ggml.pre = "lfm2", 128000 tokens, 293320 merges.
// ---------------------------------------------------------------------------
fn t_family() -> i64 {
    check(1, vt_load() == 1)
    check(2, VT_FAMILY == VTK_BPE)          // "gpt2"
    check(3, VT_NTOKENS == 128000)
    check(4, VT_MERGES == 293320)
    // a returned string compares by POINTER with ==, so the name is compared
    // through equals(). `len` alone would not be enough: "SPM" and "WPM" are
    // both three bytes.
    let nm = vt_name()
    check(5, equals(nm, "BPE") == 1)
    check(6, vt_has(VTK_BPE) == 1)
    check(7, vt_has(VTK_SPM) == 0)
    check(8, vt_has(VTK_WPM) == 0)

    // "lfm2" maps to upstream's LLAMA3 variant (llama-vocab.cpp:2286-2296), NOT
    // to GPT2. Ten model-authored names share that one variant, and the two are
    // different behaviours on the same family -- which is why the pre-tokenizer
    // is read rather than assumed.
    check(10, VT_PRE == VPT_LLAMA3)
    check(11, vt_ignore_merges() == 1)      // upstream: ignore_merges = true
    check(12, vt_add_bos() == 1)            // upstream: add_bos = true
    return 0
}

// ---------------------------------------------------------------------------
// 2. The trust-remote-code equivalent defaults OFF, and the shipped
//    pre-tokenizer set needs no consent.
// ---------------------------------------------------------------------------
fn t_trust() -> i64 {
    check(20, VT_TRUST == 0)                // the shipped default
    check(21, vt_trust_remote_code(-1) == 0)   // a sentinel is refused, not stored
    // the real model declares a recognised upstream variant, so it is permitted
    // with trust off -- it is part of llama.cpp's shipped set, not model-authored
    check(22, vt_pre_allowed() == 1)
    // an operator can still turn it on, and the state is observable
    check(23, vt_trust_remote_code(1) == 1)
    check(24, VT_TRUST == 1)
    vt_trust_remote_code(0)
    check(25, VT_TRUST == 0)
    return 0
}

// ---------------------------------------------------------------------------
// 3. The byte map, which is DERIVED from the vocab and cannot be assumed.
//
// In this model byte 32 (space) is id 229 and byte 33 ('!') is id 9. Fixture
// block 2 confirms 229 for ' '. gguf_bpe.quanta:17-19 records the same finding.
// ---------------------------------------------------------------------------
fn t_byte_map() -> i64 {
    check(30, vt_init_family() == 1)
    check(31, vt_has_text_index() == 1)
    check(32, vt_byte_to_token(32) == 229)   // fixture block 2
    check(33, vt_byte_to_token(33) == 9)     // measured: '!' is id 9 here
    check(34, vt_token_to_byte(229) == 32)   // the inverse
    check(35, vt_token_to_byte(9) == 33)
    // out of range is refused, not clamped
    check(36, vt_byte_to_token(-1) == -1)
    check(37, vt_byte_to_token(256) == -1)
    // a byte with no vocab entry
    check(38, vt_token_to_byte(35808) == -1)   // 'Hello' is not a byte token
    return 0
}

// ---------------------------------------------------------------------------
// 4. Encode against the FIXTURE, block by block.
// ---------------------------------------------------------------------------
fn t_encode_matches_fixture() -> i64 {
    let ids = mem_alloc(8192)
    let n = 0

    // block 3: 'Hello' -> 35808
    n = enc("Hello", ids, 512)
    check(40, n == 1)
    if n == 1 { check(41, id_at(ids, 0) == 35808) }

    // block 2: ' ' -> 229
    n = enc(" ", ids, 512)
    check(42, n == 1)
    if n == 1 { check(43, id_at(ids, 0) == 229) }

    // block 1: 'a' -> 73
    n = enc("a", ids, 512)
    check(44, n == 1)
    if n == 1 { check(45, id_at(ids, 0) == 73) }

    // block 6: 'hello world' -> 52071, 1530
    n = enc("hello world", ids, 512)
    check(46, n == 2)
    if n == 2 {
        check(47, id_at(ids, 0) == 52071)
        check(48, id_at(ids, 1) == 1530)
    }

    // block 4: 'Hello world' -> 35808, 1530
    n = enc("Hello world", ids, 512)
    check(49, n == 2)
    if n == 2 {
        check(50, id_at(ids, 0) == 35808)
        check(51, id_at(ids, 1) == 1530)
    }

    // block 5: 'The quick brown fox jumps over the lazy dog.' -> 10 ids
    n = enc("The quick brown fox jumps over the lazy dog.", ids, 512)
    check(52, n == 10)
    if n == 10 {
        check(53, id_at(ids, 0) == 597)
        check(54, id_at(ids, 1) == 4104)
        check(55, id_at(ids, 2) == 10299)
        check(56, id_at(ids, 3) == 35886)
        check(57, id_at(ids, 4) == 56085)
        check(58, id_at(ids, 5) == 890)
        check(59, id_at(ids, 6) == 278)
        check(60, id_at(ids, 7) == 45698)
        check(61, id_at(ids, 8) == 4448)
        check(62, id_at(ids, 9) == 22)
    }
    return 0
}

// ---------------------------------------------------------------------------
// 5. The trait's encode is the VERIFIED family's encode, not a reimplementation.
//
// lib/std/gguf_bpe.quanta is what the existing gate proves byte-exact against
// the fixture on 26 blocks. A second implementation inside the trait could
// drift from the one that is actually tested; dispatch cannot.
// ---------------------------------------------------------------------------
fn t_trait_delegates_to_family() -> i64 {
    let a = mem_alloc(8192)
    let b = mem_alloc(8192)
    let probes = ["hello world", "The quick brown fox", "a b c d e", "Hello world", "  ", "x"]
    let p = 0
    while p < 6 {
        let s = probes[p]
        let n1 = bpe_encode(s + 8, len(s), a, 512)
        let n2 = vt_encode(s + 8, len(s), b, 512)
        if n1 != n2 {
            check(70 + p, 0)
        } else {
            let i = 0
            while i < n1 {
                if mem_load(a + i * 8) != mem_load(b + i * 8) { check(70 + p, 0); i = n1; continue }
                i = i + 1
            }
        }
        p = p + 1
    }
    check(80, 1)
    return 0
}

// ---------------------------------------------------------------------------
// 6. Decode inverts encode.
// ---------------------------------------------------------------------------
fn t_decode() -> i64 {
    let ids = mem_alloc(8192)
    let dst = mem_alloc(8192)
    let s = "hello world"
    let n = enc(s, ids, 512)
    check(90, n == 2)
    let got = vt_decode(ids, n, dst)
    check(91, got == len(s))
    let same = 1
    let i = 0
    while i < got && i < len(s) {
        if mem_load8(dst + i) != mem_load8(s + 8 + i) { same = 0 }
        i = i + 1
    }
    check(92, same == 1)
    return 0
}

// ---------------------------------------------------------------------------
// 7. Capabilities are reported, not assumed.
//
// A family that is recognised but not implemented must say so. This is the
// loader's `has` rule: SPM, WPM, UGM and RWKV are named by the trait because
// llama.cpp names them, but Quanta has no implementation for them and says so
// rather than returning plausible ids.
// ---------------------------------------------------------------------------
fn t_capabilities() -> i64 {
    check(100, vt_implemented(VTK_BPE) == 1)
    check(101, vt_implemented(VTK_SPM) == 0)
    check(102, vt_implemented(VTK_WPM) == 0)
    check(103, vt_implemented(VTK_UGM) == 0)
    check(104, vt_implemented(VTK_RWKV) == 0)
    check(105, vt_is_implemented() == 1)
    return 0
}

fn main() -> i64 {
    if gguf_load(MODEL) != 0 {
        print("std_tokenizer_trait: FAIL cannot open the model\n")
        return 1
    }

    t_family()
    t_trust()
    t_byte_map()
    t_encode_matches_fixture()
    t_trait_delegates_to_family()
    t_decode()
    t_capabilities()

    print("std_tokenizer_trait: ")
    if FAIL == 0 {
        print("PASS (67 checks)\n")
        return 0
    }
    print("FAIL "); print(FAIL); print(" check(s)\n")
    return 1
}