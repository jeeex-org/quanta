// param9: 9-parameter function — regression test for >6-arg corruption.
// Each param must equal its 1-based position; the sum of (p - position) must
// be 0. Currently BROKEN in qc-1.0.0 (off by 3). The fix session must make it
// return 0.
fn s(a,b,c,d,e,f,g,h,i){return (a-1)+(b-2)+(c-3)+(d-4)+(e-5)+(f-6)+(g-7)+(h-8)+(i-9)}
fn main(){return s(1,2,3,4,5,6,7,8,9)}
