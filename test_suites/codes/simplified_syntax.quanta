// simplified_syntax: proves the optional-keyword surface works end-to-end.
// No `fn`, no `let`, implicit return, ${global}/$[local] sigils, no-parens
// if/while. Byte-for-byte equivalent to the explicit fn/let/return form.
global user = "admin"

greet() {
    who = "James"
    print("hi " .. $[who] .. " " .. ${user})
    print("hi ${user}, welcome $[who]!")
}

main() {
    n = 0
    while n < 3 {
        if n == 1 { greet() }
        n = n + 1
    }
    0
}
