import std/str
import std/fs
// Comprehensive coverage of lib/std/fs: open, write_str, read_str, write_raw, read_raw, close.
fn main() {
  let ok = 0
  // write_str + read_str round trip
  let fd = open("rt.txt", 577, 420)
  let wn = write_str(fd, "hello-quanta")
  close(fd)
  let fd2 = open("rt.txt", 0, 0)
  let got = read_str(fd2, 64)
  close(fd2)
  if wn == 12 { ok = ok + 1 }
  if len(got) == 12 { ok = ok + 1 }
  if equals(got, "hello-quanta") == 1 { ok = ok + 1 }

  // write_raw + read_raw round trip (raw byte buffer, no string header)
  let fd3 = open("raw.txt", 577, 420)
  let out = mem_alloc(8)
  mem_store8(out + 0, 10)
  mem_store8(out + 1, 20)
  mem_store8(out + 2, 30)
  mem_store8(out + 3, 40)
  let wr = write_raw(fd3, out, 4)
  close(fd3)
  let fd4 = open("raw.txt", 0, 0)
  let inb = mem_alloc(8)
  let rr = read_raw(fd4, inb, 4)
  close(fd4)
  if wr == 4 { ok = ok + 1 }
  if rr == 4 { ok = ok + 1 }
  if mem_load8(inb + 0) == 10 { ok = ok + 1 }
  if mem_load8(inb + 1) == 20 { ok = ok + 1 }
  if mem_load8(inb + 2) == 30 { ok = ok + 1 }
  if mem_load8(inb + 3) == 40 { ok = ok + 1 }
  // counts: write_str/read_str block (3: wn==12, len==12, equals==1)
  //          + write_raw/read_raw block (6: wr==4, rr==4, 4 byte checks)  = 9 total
  exit(ok)   // expect 9
}
