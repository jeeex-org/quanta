// prints_family: output builtins prints(str), printsp(int), println(int),
// newline(), print(buf,len), printi(int). Golden stdout captured from x86 and
// asserted equal on ARM.
fn main() {
  prints("AB")      // string bytes: "AB"
  printi(42)        // "42"
  newline()         // "\n"
  printsp(7)        // "7 "
  println(9)        // "9\n"
  print("X"+8, 1)   // "X"
  exit(0)
}
