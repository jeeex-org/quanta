// reg_alias: regression test for the callee load-then-store-to-same-addr
// aliasing bug. A function that reads memory then writes back to the same
// address (or an address derived from the read value), invoked repeatedly,
// MUST leave every iteration's write intact. If the allocator caches a stale
// memory value, iterations after the first are corrupted.
// Repro derived from references/callee-load-store-aliasing-bug-2026-08-13.md.
fn push(p, val) {
  let len = mem_load(p)
  mem_store(p + 16 + len * 8, val)
  mem_store(p, len + 1)
}
fn main() {
  let buf = mem_alloc(200); mem_store(buf, 0)
  push(buf,1); push(buf,2); push(buf,3); push(buf,4)
  push(buf,5); push(buf,6); push(buf,7); push(buf,8)
  // expect buf[16..] = 1,2,3,4,5,6,7,8
  if mem_load(buf+16) != 1 { return 1 }
  if mem_load(buf+24) != 2 { return 2 }
  if mem_load(buf+32) != 3 { return 3 }
  if mem_load(buf+40) != 4 { return 4 }
  if mem_load(buf+48) != 5 { return 5 }
  if mem_load(buf+56) != 6 { return 6 }
  if mem_load(buf+64) != 7 { return 7 }
  if mem_load(buf+72) != 8 { return 8 }
  return 0
}
