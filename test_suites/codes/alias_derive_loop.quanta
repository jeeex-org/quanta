// Regression test: load a value, derive a second value from it, then store the
// derived value to a DIFFERENT address, called in a loop. Guards against
// cross-iteration live-vreg bleed / aliasing corruption. Expect 1 2 3 4.
fn derive(b, c) {
  let v = mem_load(b)
  mem_store(b, v + 1)      // advance src so next iter sees the new value
  mem_store(c, v + 1)      // dst mirrors the per-iteration derived value
  return 0
}
fn main() {
  let src = mem_alloc(16)
  let dst = mem_alloc(16)
  mem_store(src, 0)
  mem_store(dst, 0)
  let i = 0
  while i < 4 {
    derive(src, dst)
    let v = mem_load(dst)
    printi(v)
    println(0)
    i = i + 1
  }
  return 0
}
