import std/math
import std/str
// 0.0.235 A2: `abs` and `pow` come from std/math and return f64, so this sum was
// a FLOAT handed to exit() -- which takes the low byte of the bit pattern, so the
// test only "passed" because nothing asserted the value. Convert explicitly and
// assert the real total: abs(-42)=42 + gcd(48,18)=6 + pow(2,7)=128 + len("hi!")=3.
fn main() {
  let a = abs(-42)
  let g = gcd(48, 18)
  let p = pow(2, 7)
  let s = concat("hi", "!")
  exit(f2i(a) + g + f2i(p) + len(s))
}
