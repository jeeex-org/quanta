// Phase 7 items 2/3/4: pinned staging + round-robin stream pool.
//
// The point of this test is that H2D on a NAMED stream is ASYNC: the reply means
// the copy was issued, not that it finished. So several copies are issued across
// several streams BEFORE any synchronisation, and only then is the pool drained
// and the data checked. If the daemon synchronised before replying, this would
// still pass -- which is why the round-robin lease is checked separately, since
// that is the part that actually changes the behaviour.
import std/fs
import std/cuda_daemon

fn main() -> i64 {
    let fails = 0

    if cuda_daemon_ready() == 0 { print("FAIL: daemon not running\n"); return 1 }

    // ---- pool ----
    let made = cuda_pool_init()
    if made != 4 {
        print("FAIL: pool init made=")
        print(made)
        print(" expected 4\n")
        return 1
    }
    print("pool: 4 streams created\n")

    // Round-robin: four leases must be four DISTINCT streams, and the fifth must
    // repeat the first.
    let s0 = cuda_pool_lease()
    let s1 = cuda_pool_lease()
    let s2 = cuda_pool_lease()
    let s3 = cuda_pool_lease()
    let s4 = cuda_pool_lease()
    let distinct = 1
    if s0 == s1 { distinct = 0 }
    if s0 == s2 { distinct = 0 }
    if s0 == s3 { distinct = 0 }
    if s1 == s2 { distinct = 0 }
    if s1 == s3 { distinct = 0 }
    if s2 == s3 { distinct = 0 }
    if distinct == 0 { print("FAIL: pool handed out a duplicate stream\n"); fails = fails + 1 }
    if s4 != s0 { print("FAIL: pool did not wrap round-robin\n"); fails = fails + 1 }
    else { print("round-robin: 4 distinct, wraps correctly\n") }

    // ---- four concurrent H2D on four streams, one sync at the end ----
    let g = gpu_malloc(65536)
    if g == 0 { print("FAIL: gpu_malloc\n"); cuda_pool_free(); return 1 }

    // Stage 4 distinct payloads, each 8 elements, into 4 files.
    let k = 0
    while k < 4 {
        let buf = mem_alloc(8 * 8)
        let j = 0
        while j < 8 {
            // payload k = (k+1)*100 + j
            mem_store(buf + j*8, (k + 1) * 100 + j)
            j = j + 1
        }
        let path = "/tmp/pool_stage.bin"
        let fd = open(path, 577, 420)
        if fd < 0 { print("FAIL: open stage\n"); fails = fails + 1; break }
        write_raw(fd, buf, 8 * 8)
        close(fd)

        let st = cuda_pool_lease()
        // Issue on its own stream: NO sync here.
        if memcpy_h2d_on(path, g + k * 8 * 8, 8 * 8, st) != 0 {
            print("FAIL: h2d on stream\n")
            fails = fails + 1
        }
        k = k + 1
    }
    print("4 H2D issued without synchronising\n")

    // One barrier for the whole pool.
    if cuda_pool_sync() != 0 { print("FAIL: pool sync\n"); fails = fails + 1 }
    print("pool drained\n")

    // Read back the whole 64 KiB region and check all four payloads landed.
    if memcpy_d2h_on(g, "/tmp/pool_back.bin", 65536, 0) != 0 {
        print("FAIL: d2h\n")
        fails = fails + 1
    } else {
        let f2 = open("/tmp/pool_back.bin", 0, 0)
        if f2 < 0 { print("FAIL: open back\n"); fails = fails + 1 }
        else {
            let back = mem_alloc(65536)
            let n = read_raw(f2, back, 65536)
            close(f2)
            let bad = 0
            let k2 = 0
            while k2 < 4 {
                let j = 0
                while j < 8 {
                    let want = (k2 + 1) * 100 + j
                    let got = mem_load(back + (k2 * 8 + j) * 8)
                    if got != want { bad = bad + 1 }
                    j = j + 1
                }
                k2 = k2 + 1
            }
            print("n=")
            print(n)
            print(" wrong=")
            print(bad)
            print(" of 32\n")
            if bad > 0 { print("FAIL: payload mismatch\n"); fails = fails + 1 }
            else { print("all 4 payloads verified after one sync\n") }
        }
    }

    cuda_pool_free()
    gpu_free(g)

    if fails > 0 {
        print("cuda_pool: ")
        print(fails)
        print(" FAILURES\n")
        return 1
    }
    print("cuda_pool: all pass\n")
    return 0
}
