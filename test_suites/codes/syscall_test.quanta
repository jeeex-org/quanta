// syscall family: generic raw syscall (any arity 1..7) via the `syscall`
// builtin. Exercises 1-arg (getpid), 3-arg (write), and 4-arg (getrandom)
// paths through the unified spill-home loader in emit_bltn.
fn main() {
  let ok = 0
  // 1-arg: getpid (syscall 39) -> positive pid
  let pid = syscall(39, 0, 0, 0, 0, 0, 0)
  if pid > 0 { ok = ok + 1 }
  // 3-arg: write(1, "OK", 2) -> returns 2
  let s = mmap(16)
  mem_store8(s + 8, 79)   // 'O'
  mem_store8(s + 9, 75)   // 'K'
  let w = syscall(1, 1, s + 8, 2, 0, 0, 0)
  if w == 2 { ok = ok + 1 }
  // 4-arg: getrandom(318, buf, 16, 0) -> returns 16
  let buf = mmap(16)
  let g = syscall(318, buf, 16, 0, 0, 0, 0)
  if g == 16 { ok = ok + 1 }
  exit(ok)   // expect 3
}
