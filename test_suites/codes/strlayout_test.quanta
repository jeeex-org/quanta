// strlayout_test -- what does a Quanta string value actually look like?
// Dumps the bytes before/after a string literal's value and len(s), so the
// payload offset can be measured instead of assumed.

fn dump(tag, base, n) -> i64 {
    print(tag)
    let i = 0
    while i < n {
        let b = mem_load8(base + i)
        print(" ")
        print(b)
        i = i + 1
    }
    print("\n")
    return 0
}

fn main() -> i64 {
    let s = "Quanta ring0: IDT demo\n"
    print("len(s) = ")
    print(len(s))
    print("\n")
    dump("s-16..s   :", s - 16, 16)
    dump("s..s+24   :", s, 24)
    return 0
}
