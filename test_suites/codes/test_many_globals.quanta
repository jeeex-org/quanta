// Reproduce the self-compiler bug: many mmap globals
let a = mmap(1048576)
let b = mmap(4000000)
let c = mmap(2000000)
let d = mmap(128000)
let e = mmap(33554432)
let f = mmap(8000000)
let g = mmap(24000)
let h = mmap(8192)
let i = mmap(64000)
let j = mmap(64000)
let k = mmap(32000)
let l = mmap(800)
let m = mmap(800)
let n = mmap(112)
let o = mmap(32000)

fn main() {
    mem_store8(a, 42)
    let v = mem_load8(a)
    return v
}
