// OCSP constants test
fn ocsp_response_successful(): i64 { return 0 }
fn ocsp_cert_good(): i64 { return 0 }
fn ocsp_cert_revoked(): i64 { return 1 }
fn ocsp_cert_unknown(): i64 { return 2 }

fn main() {
    if ocsp_response_successful() != 0 { return 1 }
    if ocsp_cert_good() != 0 { return 2 }
    if ocsp_cert_revoked() != 1 { return 3 }
    if ocsp_cert_unknown() != 2 { return 4 }
    return 0
}