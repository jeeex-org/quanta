// stdlib_test: validates len/str/push/pop collection builtins + for-loop
// Header layout: vec/vstr = [8: len][elems/bytes at +8]
fn main(){
  // --- for-loop ---
  let s=0
  for i=1; i<=5; i=i+1 { s=s+i }
  printi(s)          // 15

  // --- str concat ---
  let a=str("AB","CD")
  print(a+8, len(a))  // ABCD 4

  // --- len ---
  printi(len("pushpop"))  // 7

  // --- push ---
  let v=str("AB","CD")    // header to a string-vector
  let w=push(v,'X')
  print(w+8, len(w))      // ABCDX 5

  // --- pop ---
  let e=pop(w)
  printi(e)               // 88 ('X')
  print(v+8, len(v))      // ABCD 4 (original unchanged)

  exit(0)
}
