// Array push and a closure literal in the SAME program: proves IR_APUSH and
// IR_CLOSURE are distinct opcodes. If they ever collide again, the push result
// gets tagged as a fn value and this returns the wrong sum.
fn main() {
    let r = [10]
    r.push(20)
    let f = |x| { x + 2 }
    return r[0] + r[1] + f(3)      // 10 + 20 + 5 = 35
}
