import std/big

fn main() {
    // === operator-level routing (0.0.117) ===
    let a: big = -5
    let b: big = 3
    let c: big = -3
    let d: big = -9

    // --- signed add/sub/mul via operators ---
    big_println(a + b)        // -2
    big_println(a - b)        // -8
    big_println(a * b)        // -15
    big_println(a + a)        // -10
    big_println(b - a)        // 8
    big_println(a * a)        // 25

    // --- signed ordering via operators ---
    big_println(a < b)        // 1 (-5 < 3)
    big_println(b < a)        // 0
    big_println(a <= a)       // 1
    big_println(a >= b)       // 0
    big_println(c > d)        // 1 (-3 > -9)
    big_println(c <= d)       // 0

    // --- bitwise via operators (two's complement, sign-aware) ---
    let x: big = 12          // 0b1100
    let y: big = 10          // 0b1010
    big_println(x & y)       // 8
    big_println(x | y)       // 14
    big_println(x ^ y)       // 6
    let neg: big = -12
    big_println(neg & 7)     // 4
    big_println(neg | 1)     // -11

    // --- shift via operators (sign-preserving) ---
    big_println(x << 3)      // 96
    big_println(x >> 2)      // 3
    big_println(neg << 1)    // -24
    big_println(neg >> 1)    // -6

    // --- mixed int <op> big promotes correctly ---
    big_println(a + 3)        // -2
    big_println(7 & x)        // 4
    big_println(2 * b)        // 6
}
