// Regression test: the `?` operator (P7 / IR_TRY).
// - On Some/Ok it extracts the payload.
// - On None/Err it EARLY-RETURNS the whole function (subsequent code must NOT run).
// Expect: 7 (from get(1)?) then STOP — get(0)? early-returns, so 99 is never printed.
fn get(ok: i64) -> i64? {
  if ok > 0 { return Some(7) }
  return None
}
fn main() {
  let a = get(1)?
  printi(a); println(0)
  let b = get(0)?
  printi(b); println(0)
  println(99)
  return 0
}
