// Chained float builtins: the result of fadd feeds fmul.
//
// The comment here used to say "return the truncated integer", which was the
// defect: fadd/fmul stored their result with 66 48 0F 2C (CVTTSD2SI) instead of
// 66 48 0F 7E (MOVQ), so a chained call fed a small integer into the next one.
// Fixed in 0.0.220 -- the builtins now return an f64 bit pattern, and the
// integer is requested with f2i().
//
// Also covers the second half of that fix: fmul's operand is fadd's result, so
// the vfloat result tag has to survive the chain.

fn main() {
  let s = fadd(i2f(2), i2f(3))     // 2.0 + 3.0 = 5.0
  let p = fmul(s, i2f(4))           // 5.0 * 4.0 = 20.0
  exit(f2i(p))                      // 20
}
