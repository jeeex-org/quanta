// fnptr(FNAME) -> code pointer as a runtime value, then CALL it through the
// closure_call ABI (same path closure_test exercises). Verifies fnptr() both
// constructs AND invokes correctly: add(3,4) == 7.
// (Was a no-op: only checked fnptr() didn't error, returned 0.)
fn add(a, b) {
    return a + b
}

fn main() {
    let p = fnptr(add)
    let f = mk_any(p, 0)
    let r = closure_call(f, 3, 4)
    return r   // 3 + 4 = 7
}
