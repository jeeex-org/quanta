// Quanta RAG CLI - Pure Quanta
// Orchestrates: python3 embed → sqlite3 search → curl inference
// All heavy lifting done by external tools, Quanta does I/O and control flow

import std/io
import std/str
import std/vec

// Query the RAG pipeline
fn rag_query(query, model) {
    // Step 1: Compute embedding via Python
    print("[1/4] Computing embedding...\n")
    let emb = exec("python3 /opt/tali/quanta/scripts/rag_embed_file.py '" + query + "'")
    
    // Step 2: Search sqlite3 for similar chunks
    print("[2/4] Searching knowledge base...\n")
    let search_sql = "SELECT source||'|'||content FROM chunks WHERE embedding IS NOT NULL "
    search_sql = search_sql + "ORDER BY vec_distance_euclidean(embedding, X'" + emb + "') "
    search_sql = search_sql + "LIMIT 5"
    let results = exec("sqlite3 /opt/tali/ti/ai/rag/vectors.db \"" + search_sql + "\"")
    
    // Step 3: Build context
    print("[3/4] Building prompt...\n")
    let context = rag_parse_results(results)
    
    // Step 4: Call LLM
    print("[4/4] Generating answer...\n")
    let port = "1235"
    if str_equals(model, "e4b") { port = "1236" }
    
    let answer = rag_call_llm(context, query, port)
    
    // Display
    print("\n")
    print("============================================================\n")
    print("ANSWER\n")
    print("============================================================\n")
    print(answer)
    print("\n")
    print("============================================================\n")
}

// Parse sqlite3 pipe-delimited results
fn rag_parse_results(raw) -> vec {
    let lines = str_split(raw, "\n")
    let chunks = vec_new()
    let i = 0
    while i < vec_len(lines) {
        if str_len(lines[i]) > 0 {
            vec_push(chunks, lines[i])
        }
        i = i + 1
    }
    return chunks
}

// Call llama-server
fn rag_call_llm(context, query, port) -> str {
    let prompt = "You are a Quanta language expert. Use ONLY the context below.\n"
    prompt = prompt + "DO NOT reference Python, Rust, C++, or other languages.\n"
    prompt = prompt + "DO NOT make up information.\n\n"
    prompt = prompt + "CONTEXT:\n"
    
    let i = 0
    while i < vec_len(context) {
        let parts = str_split(context[i], "|")
        if vec_len(parts) >= 2 {
            prompt = prompt + "\n--- " + parts[0] + " ---\n"
            prompt = prompt + parts[1] + "\n"
        }
        i = i + 1
        if i >= 3 { break }
    }
    
    prompt = prompt + "\nQUESTION: " + query + "\n\nANSWER:"
    
    // Escape for JSON
    prompt = str_replace(prompt, "\\", "\\\\")
    prompt = str_replace(prompt, "\"", "\\\"")
    prompt = str_replace(prompt, "\n", "\\n")
    
    let json = "{\"messages\":[{\"role\":\"user\",\"content\":\"" + prompt + "\"}],"
    json = json + "\"max_tokens\":256,\"temperature\":0.3,"
    json = json + "\"chat_template_kwargs\":{\"enable_thinking\":false}}"
    
    let cmd = "curl -s http://localhost:" + port + "/v1/chat/completions "
    cmd = cmd + "-H 'Content-Type: application/json' "
    cmd = cmd + "-d '" + json + "'"
    
    let response = exec(cmd)
    return rag_extract_content(response)
}

// Extract "content" field from JSON response
fn rag_extract_content(json) -> str {
    let key = "\"content\":\""
    let start = str_index(json, key)
    if start == -1 { return "[Error parsing response]" }
    
    start = start + str_len(key)
    let end = rag_find_quote(json, start)
    if end == -1 { return "[Error parsing response]" }
    
    let raw = str_substring(json, start, end)
    raw = str_replace(raw, "\\n", "\n")
    raw = str_replace(raw, "\\\"", "\"")
    return raw
}

// Find unescaped double quote
fn rag_find_quote(s, from) -> i64 {
    let i = from
    let n = len(s)
    while i < n {
        let c = mem_load8(s + 8 + i)
        if c == 34 {  // "
            if i == from || mem_load8(s + 8 + i - 1) != 92 {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn main() {
    print("Quanta RAG CLI\n")
    print("==============\n\n")
    
    // Test embedding + search
    let query = "What is IR_CALL in Quanta?"
    print("Query: " + query + "\n")
    
    rag_query(query, "e2b")
}
