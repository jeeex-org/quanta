// CT constants test - no import needed since constants are local
fn ct_version_v1(): i64 { return 0 }
fn ct_sig_ecdsa(): i64 { return 1 }
fn ct_hash_sha256(): i64 { return 4 }
fn ct_entry_x509(): i64 { return 0 }
fn ct_entry_precert(): i64 { return 1 }

fn main() {
    if ct_version_v1() != 0 { return 1 }
    if ct_sig_ecdsa() != 1 { return 2 }
    if ct_hash_sha256() != 4 { return 3 }
    if ct_entry_x509() != 0 { return 4 }
    if ct_entry_precert() != 1 { return 5 }
    return 0
}