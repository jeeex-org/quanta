// SPIFFE constants test
fn spiffe_svid_type_x509(): i64 { return 0 }
fn spiffe_svid_type_jwt(): i64 { return 1 }
fn spiffe_gen_name_uri(): i64 { return 6 }

fn main() {
    if spiffe_svid_type_x509() != 0 { return 1 }
    if spiffe_svid_type_jwt() != 1 { return 2 }
    if spiffe_gen_name_uri() != 6 { return 3 }
    return 0
}