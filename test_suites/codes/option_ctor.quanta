// option_ctor: construct Option::Some and extract the payload via match.
// Real assertion: matches Some(v) -> v == 42.
// (Was a no-op: constructed Some(42), returned 0.)
fn main() {
    let some_val = Option::Some(42)
    let a = match some_val { Option::Some(v) => v, Option::None => 0 }
    return a   // 42
}
