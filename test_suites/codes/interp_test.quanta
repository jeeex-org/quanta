// interp_test: ${name} (global) and $[name] (local) accessors, both bare and
// inside string literals. Exercises the parse-time string-interpolation split.
// Exit code 0 = all prints produced expected output (checked by eye in dev;
// the gate pins exit code only).

global g = "GLOBAL"

fn bare_form() {
    let who = "James"
    // bare form via ..
    print("hi " .. $[who] .. " " .. ${g})
}

fn inside_global() {
    // inside-string, global accessor
    print("g=${g}")
}

fn inside_local() {
    let who = "James"
    print("hi $[who]")
}

fn inside_mixed() {
    let who = "James"
    print("hi $[who] and ${g}")
}

fn inside_multi() {
    let who = "James"
    print("Dear $[who], welcome ${g}!")
}

fn inside_only_global() {
    print("${g}")
}

fn inside_global_suffix() {
    print("${g}!")
}

fn main() {
    bare_form()
    inside_global()
    inside_local()
    inside_mixed()
    inside_multi()
    inside_only_global()
    inside_global_suffix()
    exit(0)
}
