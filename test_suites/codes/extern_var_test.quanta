// extern-C VARIADIC FFI: printf(fmt, ...) with the `...` declaration and
// multiple values incl. 7-arg stack-spill path. Prints a sentinel.
extern "C" fn printf(fmt: i64, ...): i64;
fn main(): i64 {
  let f2 = "%d %d\n"
  printf(f2, 11, 22)
  let f7 = "%d %d %d %d %d %d %d\n"
  printf(f7, 1, 2, 3, 4, 5, 6, 7)
  printf("EXTERN_VAR_OK\n")
  0
}
