import std/math
// Comprehensive coverage of lib/std/math. Asserts exact values.
// exit codes: 0 = all pass, N = (first failing group id) for debugging.
fn main() {
  let ok = 0
  // abs
  if abs(-42) == 42 { ok = ok + 1 }
  if abs(42) == 42 { ok = ok + 1 }
  if abs(0) == 0 { ok = ok + 1 }
  // min / max
  if min(3, 7) == 3 { ok = ok + 1 }
  if max(3, 7) == 7 { ok = ok + 1 }
  if min(-5, -9) == -9 { ok = ok + 1 }
  if max(-5, -9) == -5 { ok = ok + 1 }
  // clamp
  if clamp(15, 0, 10) == 10 { ok = ok + 1 }
  if clamp(-3, 0, 10) == 0 { ok = ok + 1 }
  if clamp(5, 0, 10) == 5 { ok = ok + 1 }
  // pow
  if pow(2, 7) == 128 { ok = ok + 1 }
  if pow(3, 4) == 81 { ok = ok + 1 }
  if pow(10, 0) == 1 { ok = ok + 1 }
  if pow(7, 1) == 7 { ok = ok + 1 }
  // gcd
  if gcd(48, 18) == 6 { ok = ok + 1 }
  if gcd(17, 5) == 1 { ok = ok + 1 }
  if gcd(0, 9) == 9 { ok = ok + 1 }
  // lcm
  if lcm(4, 6) == 12 { ok = ok + 1 }
  if lcm(21, 6) == 42 { ok = ok + 1 }
  // total checks above = 3+4+3+4+3+2 = 19
  exit(ok)   // expect 19
}
