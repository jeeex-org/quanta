// 0.0.125 time core: clock()/now() zero-arg ns wrappers.
//   clock() = CLOCK_MONOTONIC ns; now() = CLOCK_REALTIME epoch ns.
fn main() {
  let ok = 0
  let a = clock()
  if a > 0 { ok = ok + 1 }                      // monotonic ns positive
  let b = now()
  if b > 1600000000000000000 { ok = ok + 1 }     // epoch ns > ~2020
  sleep(1)
  let c = clock()
  if c > a { ok = ok + 1 }                      // monotonic advances
  let d = now()
  if d > b { ok = ok + 1 }                      // realtime later
  if c - a >= 900000000 { ok = ok + 1 }         // delta >= 0.9s
  if d - b >= 900000000 { ok = ok + 1 }
  exit(ok)   // expect 6
}
