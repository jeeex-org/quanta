import std/vec
// Comprehensive coverage of lib/std/vec: new, set, set_len, len, get, push.
fn main() {
  let ok = 0
  let v = vec_new()
  let i = 0
  while i < 8 { vec_put(v, i, i + 1); i = i + 1 }
  vec_set_len(v, 8)
  if vec_len(v) == 8 { ok = ok + 1 }
  if vec_at(v, 0) == 1 { ok = ok + 1 }
  if vec_at(v, 3) == 4 { ok = ok + 1 }
  if vec_at(v, 7) == 8 { ok = ok + 1 }
  // vec_push: append beyond current length
  vec_push(v, 99)
  if vec_len(v) == 9 { ok = ok + 1 }
  if vec_at(v, 8) == 99 { ok = ok + 1 }
  vec_push(v, 100)
  if vec_len(v) == 10 { ok = ok + 1 }
  if vec_at(v, 9) == 100 { ok = ok + 1 }
  // counts: len/get block (4: len==8, at0==1, at3==4, at7==8)
  //          + push 99 (2: len==9, at8==99)
  //          + push 100 (2: len==10, at9==100)  = 8 total
  exit(ok)   // expect 8
}
