// X.509 ASN.1 constants test (using functions like generics_const_test)
fn asn_tag_sequence(): i64 { return 16 }
fn asn_tag_integer(): i64 { return 2 }
fn asn_tag_oid(): i64 { return 6 }
fn asn_tag_utc_time(): i64 { return 23 }
fn asn_tag_generalized_time(): i64 { return 24 }
fn asn_tag_bit_string(): i64 { return 3 }
fn asn_tag_octet_string(): i64 { return 4 }
fn asn_class_context(): i64 { return 2 }

fn main() {
    if asn_tag_sequence() != 16 { return 1 }
    if asn_tag_integer() != 2 { return 2 }
    if asn_tag_oid() != 6 { return 3 }
    if asn_tag_utc_time() != 23 { return 4 }
    if asn_tag_generalized_time() != 24 { return 5 }
    if asn_tag_bit_string() != 3 { return 6 }
    if asn_tag_octet_string() != 4 { return 7 }
    if asn_class_context() != 2 { return 8 }
    return 0
}