import std/fs
import std/gguf

// Test tensor info parsing - verify gguf_load works correctly
fn main() {
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { 
        print("gguf_load failed\n")
        return 1 
    }
    
    let n = gguf_num_tensors()
    print("num_tensors="); print(n); print("\n")
    // 266 is n_tensors; 37 is n_kv (the metadata KV-pair count). Asserting
    // num_tensors against the KV count passed nothing until test_suites/
    // stopped being excluded from CI by .gitignore.
    if n != 266 { 
        print("wrong num_tensors\n")
        return 1 
    }
    
    gguf_close()
    print("PASS\n")
    return 0
}
