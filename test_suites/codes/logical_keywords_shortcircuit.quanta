// `and` / `or` keywords must SHORT-CIRCUIT, exactly like && / ||.
// The right-hand side is a call that would trap (division by zero via a
// deliberate out-of-range index) if it were ever evaluated; short-circuit means
// it never runs.
fn boom() {
    let a = [1]
    return a[99]        // out of bounds -> traps if evaluated
}
fn main() {
    let ok = 0
    // `and` with a FALSE left operand must not evaluate the right operand
    if 1 == 2 and boom() == 0 { ok = ok + 100 }
    ok = ok + 1
    // `or` with a TRUE left operand must not evaluate the right operand
    if 1 == 1 or boom() == 0 { ok = ok + 1 }
    return ok      // 2
}
