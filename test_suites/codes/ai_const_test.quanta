fn ai_dtype_f32(): i64 { return 0 }
fn ai_dtype_i32(): i64 { return 1 }
fn ai_dtype_i64(): i64 { return 2 }
fn ai_dtype_u8(): i64 { return 3 }
fn ai_dtype_bool(): i64 { return 4 }
fn ai_dtype_size(dt: i64): i64 {
    if dt == 0 { return 4 }
    if dt == 1 { return 4 }
    if dt == 2 { return 8 }
    if dt == 3 { return 1 }
    if dt == 4 { return 1 }
    return 4
}

fn main() {
    if ai_dtype_f32() != 0 { exit(1) }
    if ai_dtype_i32() != 1 { exit(2) }
    if ai_dtype_i64() != 2 { exit(3) }
    if ai_dtype_u8() != 3 { exit(4) }
    if ai_dtype_bool() != 4 { exit(5) }
    if ai_dtype_size(0) != 4 { exit(6) }
    if ai_dtype_size(1) != 4 { exit(7) }
    if ai_dtype_size(2) != 8 { exit(8) }
    if ai_dtype_size(3) != 1 { exit(9) }
    if ai_dtype_size(4) != 1 { exit(10) }
    exit(0)
}