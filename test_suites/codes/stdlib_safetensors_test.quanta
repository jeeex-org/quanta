// stdlib_safetensors_test -- the HF safetensors reader against a real model.
//
// safetensors is where new models actually ship; GGUF is the legacy path. The
// layout is an 8-byte LE header length, that many bytes of JSON, then a flat data
// blob indexed by byte ranges relative to 8+header_len.
//
// WHAT IS CHECKED, AND WHY
// ------------------------
// Byte-exactness against Python for real tensor bytes. An earlier version of
// this test printed the value through
//     pf64(f64of(mem_load(dst)))
// and reported a MISMATCH (-23.0 against Python's -0.2578). The reader was
// right and the CHECK was wrong: f64of reinterprets its argument as a 64-bit
// float PATTERN, but only 4 bytes of an f32 had been read, so it produced a
// zero-extended f32 pattern -- not a valid f64. Same trap documented for
// gguf_kv_float in stdlib_gguf_meta_test.
//
// So this test compares RAW BYTES rather than decoded floats. Bytes are what the
// reader is responsible for; float decoding is f32_to_f64's job, and comparing
// bytes keeps the two failures separate instead of blaming the reader for a
// display bug.
//
// Ground truth, measured with Python on this machine:
//   data_base              = 76656   (= 8 + 76648 header_len)
//   A_log  dtype F32 shape [16] data_offsets [0, 64]
//   bytes at data_base     = 00 00 84 be | 00 00 37 c0
//   as f32                  = -0.2578125 | -2.859375
//
// The 8-byte data origin is the easy thing to get wrong: every tensor read lands
// on unrelated bytes if it is off by 8, and a quantized weight then decodes to
// plausible garbage with no error anywhere.

import std/fs
import std/safetensors
import std/str
import std/math

const MODEL = "/opt/ai/models/qwen3.5-2b/model.safetensors-00001-of-00001.safetensors"

// expected byte at index i of the first tensor's data
fn expect_byte(i) {
    if i == 0 { return 0 }
    if i == 1 { return 0 }
    if i == 2 { return 132 }
    if i == 3 { return 190 }
    if i == 4 { return 0 }
    if i == 5 { return 0 }
    if i == 6 { return 55 }
    if i == 7 { return 192 }
    return 0 - 1
}

fn main() {
    if st_open(MODEL) != 0 { print("FAIL st_open on the real model"); return 1 }

    // ---- header geometry, measured from the file with Python ----
    if st_data_base != 76656 { prints("FAIL data_base="); print(st_data_base); return 1 }
    if st_data_base != 8 + 76648 { print("FAIL: data_base is not 8 + header_len"); return 1 }
    if st_filesize != 4548221488 { print("FAIL: unexpected file size"); return 1 }

    // ---- a real tensor: F32, shape [16], 64 bytes ----
    let nm = "model.language_model.layers.0.linear_attn.A_log"
    let e = st_entry(nm)
    if e < 0 { print("FAIL: A_log not found"); return 1 }
    if json_get_type(e) != 5 { print("FAIL: tensor entry is not an object"); return 1 }
    let eo = json_get_object(e)

    let dtv = json_object_get(eo, "dtype")
    if dtv < 0 { print("FAIL: no dtype"); return 1 }
    if !equals(json_get_string(dtv), "F32") { print("FAIL: dtype != F32"); return 1 }

    let shv = json_object_get(eo, "shape")
    if json_get_type(shv) != 4 { print("FAIL: shape is not an array"); return 1 }
    if json_array_len(json_get_array(shv)) != 1 { print("FAIL: ndim != 1"); return 1 }
    if json_get_number(json_array_get(json_get_array(shv), 0)) != 16 { print("FAIL: shape[0] != 16"); return 1 }

    let offv = json_object_get(eo, "data_offsets")
    if offv < 0 { print("FAIL: no data_offsets"); return 1 }
    let arr = json_get_array(offv)
    if json_array_len(arr) != 2 { print("FAIL: data_offsets not a pair"); return 1 }
    if json_get_number(json_array_get(arr, 0)) != 0 { print("FAIL: b0 != 0"); return 1 }
    if json_get_number(json_array_get(arr, 1)) != 64 { print("FAIL: b1 != 64"); return 1 }

    // ---- layout: dtype resolves to 32 bits ----
    let bits_addr = mem_alloc(8)
    let nbytes_addr = mem_alloc(8)
    mem_store(bits_addr, 0)
    mem_store(nbytes_addr, 0)
    if st_layout(nm, nbytes_addr, bits_addr) != 0 { print("FAIL st_layout"); return 1 }
    if mem_load(bits_addr) != 32 { prints("FAIL bits="); print(mem_load(bits_addr)); print(" want 32"); return 1 }
    if mem_load(nbytes_addr) != 64 { prints("FAIL nbytes="); print(mem_load(nbytes_addr)); print(" want 64"); return 1 }

    // ---- the bytes themselves, byte-for-byte against Python ----
    let dst = mem_alloc(64)
    let n = st_read(nm, dst)
    if n != 64 { prints("FAIL read n="); print(n); print(" want 64"); return 1 }
    let i = 0
    let bad = 0
    while i < 8 {
        let got = mem_load8(dst + i)
        let want = expect_byte(i)
        if got != want { bad = bad + 1 }
        i = i + 1
    }
    if bad != 0 { prints("FAIL byte mismatches="); print(bad); return 1 }

    // ---- a second tensor, to prove the lookup is not a single hardcoded hit ----
    let nm2 = "model.language_model.layers.0.linear_attn.norm.weight"
    let dst2 = mem_alloc(512)
    let n2 = st_read(nm2, dst2)
    if n2 != 512 { prints("FAIL second tensor n="); print(n2); print(" want 512"); return 1 }

    // ---- rejections: a name that does not exist must not be invented ----
    let bogus = mem_alloc(64)
    if st_read("no.such.tensor", bogus) >= 0 { print("FAIL: a missing tensor was readable"); return 1 }
    if st_entry("no.such.tensor") >= 0 { print("FAIL: st_entry invented a key"); return 1 }

    st_close()

    // ---- hostile files: every one must be REFUSED at st_open ----
    //
    // Generated by scripts/audit/make_hostile_st.py, which writes them in Python.
    // Python can write safetensors correctly -- the two failed hand-rolled GGUF
    // parsers earlier in this project desynced on the KV block, and building the
    // equivalent here the same way would have produced a generator whose idea of
    // the format was wrong. These files have VALID JSON headers, so what they
    // exercise is the reader's bounds logic, not a malformed parse.
    //
    // The first version of st_validate() checked nothing per-tensor (the function
    // carried a comment saying exactly that) and 5 of these 10 were ACCEPTED:
    // out-of-bounds offsets, reversed offsets, a shape disagreeing with the
    // declared length, an unknown dtype, and an overflowing dimension product.
    // The data-section check cannot catch any of them, because a header may
    // declare whatever it likes.
    // EXACT return codes (mutation-verified):
    //  -3: header length validation (huge_len, over_cap, wrap_len)
    //  -3006: offsets reversed / out of range (oob_offsets, reversed)
    //  -3005: shape/length disagreement (shape_mismatch, dim_overflow)
    //  -3003: unknown dtype (unknown_dtype)
    //  -3004: dimension product overflow / over limit (dim_over_limit, dim_wrap_small)
    //  -3: truncated file / not a safetensors file (truncated, not_st)
    //  -5: JSON parse failure (root_array, garbage_header)
    if st_open("/tmp/hostile/huge_len.gguf") != -3 { print("FAIL: huge_len wrong code"); return 1 }
    if st_open("/tmp/hostile/over_cap.gguf") != -3 { print("FAIL: over_cap wrong code"); return 1 }
    if st_open("/tmp/hostile/wrap_len.gguf") != -3 { print("FAIL: wrap_len wrong code"); return 1 }
    if st_open("/tmp/hostile/oob_offsets.gguf") != -3006 { print("FAIL: oob_offsets wrong code"); return 1 }
    if st_open("/tmp/hostile/reversed.gguf") != -3006 { print("FAIL: reversed wrong code"); return 1 }
    if st_open("/tmp/hostile/shape_mismatch.gguf") != -3005 { print("FAIL: shape_mismatch wrong code"); return 1 }
    if st_open("/tmp/hostile/unknown_dtype.gguf") != -3003 { print("FAIL: unknown_dtype wrong code"); return 1 }
    if st_open("/tmp/hostile/dim_overflow.gguf") != -3004 { print("FAIL: dim_overflow wrong code"); return 1 }
    if st_open("/tmp/hostile/dim_over_limit.gguf") != -3005 { print("FAIL: dim_over_limit wrong code"); return 1 }
    if st_open("/tmp/hostile/dim_wrap_small.gguf") != -3004 { print("FAIL: dim_wrap_small wrong code"); return 1 }
    if st_open("/tmp/hostile/truncated.gguf") != -3 { print("FAIL: truncated wrong code"); return 1 }
    if st_open("/tmp/hostile/not_st.gguf") != -3 { print("FAIL: not_st wrong code"); return 1 }
    if st_open("/tmp/hostile/root_array.gguf") != -5 { print("FAIL: root_array wrong code"); return 1 }
    if st_open("/tmp/hostile/garbage_header.gguf") != -5 { print("FAIL: garbage_header wrong code"); return 1 }

    // Direct store verification via test-only getter
    if st_open(MODEL) != 0 { print("FAIL: store check st_open failed"); return 1 }
    if st_test_buffer_len() != 76648 { prints("FAIL: stored len="); print(st_test_buffer_len()); print(" want 76648"); return 1 }

    // ---- the header-length store is load-bearing, and that is testable ----
    //
    // json_parse calls len(buf), so the header length MUST live in the string
    // header's first qword. Deleting that store does NOT fail these fixtures: with
    // the store removed the length read back is whatever is in memory, and for
    // these particular files the parse still failed -- by luck, not by design.
    //
    // The way that is visible: st_validate's per-tensor checks return -3004 for
    // dim_over_limit. If the length were stored wrongly the parse would fail first
    // and EVERY fixture would return -5 instead, including ones whose headers are
    // perfectly valid JSON. So: assert that a valid-JSON fixture does NOT come back
    // as a parse failure. That pins the length store without needing to mutate the
    // compiler inside a gate run.
    let r_ok = st_open(MODEL)
    if r_ok != 0 { print("FAIL: the real model stopped loading"); return 1 }
    let e2 = st_entry("model.language_model.layers.0.linear_attn.A_log")
    if e2 < 0 { print("FAIL: entry lookup needs a correctly-stored header length"); return 1 }
    let eo2 = json_get_object(e2)
    let dt2 = json_object_get(eo2, "dtype")
    if dt2 < 0 { print("FAIL: dtype lookup needs a correctly-stored header length"); return 1 }
    if !equals(json_get_string(dt2), "F32") { print("FAIL: dtype string wrong"); return 1 }
    st_close()

    print("OK safetensors")
    return 0
}