fn map<T, U>(arr: [T], f: fn(T) -> U) -> [U] {
    let result = [U]()
    for item in arr {
        result.push(f(item))
    }
    return result
}

fn double(x: int) -> int {
    return x * 2
}

fn main() {
    let arr = [1, 2, 3]
    let doubled = map(arr, double)
    return doubled[0] + doubled[1] + doubled[2]
}