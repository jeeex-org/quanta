fn tls13_version(): i64 { return 0x0304 }
fn tls13_cs_x25519_mlkem768_aes128_gcm_sha256(): i64 { return 0xFE01 }
fn tls13_ng_x25519_mlkem768(): i64 { return 0xFE02 }
fn tls13_sig_ml_dsa_65(): i64 { return 0xFE01 }

fn main() {
    let v: i64 = tls13_version()
    let cs: i64 = tls13_cs_x25519_mlkem768_aes128_gcm_sha256()
    let ng: i64 = tls13_ng_x25519_mlkem768()
    let sig: i64 = tls13_sig_ml_dsa_65()
    
    if v != 0x0304 { exit(1) }
    if cs != 0xFE01 { exit(2) }
    if ng != 0xFE02 { exit(3) }
    if sig != 0xFE01 { exit(4) }
    exit(0)
}