fn main() {
  // SHA3-256("") = a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a
  let e = mem_alloc(32)
  sha3_256("" + 8, 0, e+8)
  
  // Verify first byte as quick check (0xa7)
  if mem_load8(e+8) != 0xa7 { exit(1) }
  
  // SHA3-256("abc") = 3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532
  let a = mem_alloc(32)
  sha3_256("abc" + 8, 3, a+8)
  if mem_load8(a+8) != 0x3a { exit(2) }
  
  exit(0)
}

import std/sha3_hash

extern fn malloc(size: u64) -> u64;