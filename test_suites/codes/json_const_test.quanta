// JSON const test
fn main() {
    if 0 != 0 { return 1 }
    if 1 != 1 { return 2 }
    if 2 != 2 { return 3 }
    if 3 != 3 { return 4 }
    if 4 != 4 { return 5 }
    if 5 != 5 { return 6 }
