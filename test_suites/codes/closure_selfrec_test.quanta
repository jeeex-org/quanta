// 0.0.131: closure SELF-RECURSION by name. A named closure body must be able to
// refer to its own name to recurse. `fact(n)` computes n! via self-call `fact`.
// Exit code encodes the result so run_tests.sh can assert:
//   fact(5) = 120 -> return 0 (pass); any other value -> return != 0 (fail).
fn main(): i64 {
  let fact = fn fact(n: i64): i64 {
    if n <= 1 { return 1 }
    return n * fact(n - 1)
  }
  let r = fact(5)
  if r != 120 { return r }
  return 0
}
