// Match guard, taken: `n if cond => expr`. Before 0.0.69 the `if` was never
// consumed (mop('=>') failed silently without advancing), the arm's IR came out
// malformed, and the whole match yielded 0 with no diagnostic.
fn main() {
    let x = 5
    let a = match x { n if n > 3 => 111, _ => 222 }
    return a        // 111
}
