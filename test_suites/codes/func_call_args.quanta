// Regression test for the P0 arity bug: function calls with arguments
// must compile and pass the correct arg count to the callee.
fn add(a i64, b i64) i64 { return a + b }
fn mul(a i64, b i64) i64 { return a * b }
fn main() {
  let s = add(2, 3)        // 5
  let p = mul(add(2, 3), 4) // 5 * 4 = 20
  exit(s + p)              // 5 + 20 = 25
}
