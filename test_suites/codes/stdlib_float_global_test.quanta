// stdlib_float_global_test -- a module-level `let g = 3.0` must behave as an f64
// in arithmetic, regardless of what else appears in the function.
//
// THE DEFECT
// ----------
// A module-level float global is not reliably entered in the compiler's vfloat
// table, so is_float_vr() can say false for a read of it, and `+ - * /` then run
// the INTEGER path over the bit pattern. The VALUE is never wrong -- pf64(g) and
// f64of(g) both print the right number -- only the TAG is missing, so every
// arithmetic result is wrong, silently and with no trap:
//
//     let a = 3.0 ; pf64(a + 1.0)       -> 4.0   ok
//     let a = 3.0 ; f() ; pf64(a+1.0)  -> inf   WRONG
//
// WHY IT CANNOT BE WRITTEN AROUND
// -------------------------------
// Module-level type annotations do not exist -- `let g: f64 = 0.0` is a compile
// error ("undeclared variable: f64") -- so the intent cannot be declared at the
// site and the compiler has to infer it.
//
// MINIMAL TRIGGERS (each measured as its own program)
// ---------------------------------------------------
// All of these are semantically irrelevant to `a + 1.0`, and each flips the
// result from 4.0 to inf:
//
//     pf64(a + 1.0)                     -> 4.0   ok
//     let dead = 1.0 ; pf64(a + 1.0)   -> inf   an unused local
//     f() ; pf64(a + 1.0)              -> inf   a call BEFORE the arithmetic
//     pf64(a + 1.0) ; f()              -> 4.0   a call AFTER is harmless
//
// A second module-level global, whether or not it is ever assigned, also flips
// it. Two extra module-level FUNCTIONS do not.
//
// So the deciding factor is POSITION: anything emitted before the arithmetic --
// a dead local, an earlier call -- changes the vreg numbering, and the tag is
// then attached to the wrong vreg or lost. It is a numbering desync between the
// tagging pass and the emit, not a missing feature and not about globals.
//
// Ruled out by measurement, not by inspection:
//   - gfloat is correct at emit (probed: reads 1)
//   - the IR_LOADG destination tag IS written (probed)
//   - nothing clears vfloat between the pre-pass and the emit loop (every
//     w8(vfloat...) in that window scanned; all are 0 -> 1)
//   - the pre-pass, the vreg fixpoint and the emit loop are in source order
//     inside ci_func (brace-matched)
//   - the emit path is fine: IR_ADD takes its SSE branch when EITHER operand is
//     tagged, and fopld_rr uses fld_x when the operand is tagged
//
// codegen.quanta runs opt_func() -- which drops dead vregs and rewrites operators
// while consulting vfloat -- then aclr() -- which zeroes vfloat -- and only then
// re-derives tags. That ordering is the suspect: the tags are keyed to vreg
// indices the optimiser has already renumbered.
//
// The trigger cases below are SOFT, so the gate stays green while this is open.
// When it is fixed they become hard returns; case 3, the dead local, is the
// smallest and the first to watch.

import std/fs
import std/math

// f64_close, NOT close: lib/std/fs.quanta exports `fn close(fd)` and a same-named
// user function SHADOWS it for every module in scope. Verified -- a helper called
// close(a,b) -> i64 silently returned a file-descriptor close: 0 for
// close(0.0,0.0) and -9 for close(1.0,1.0).
fn f64_close(a: f64, b: f64) -> i64 {
    let eps: f64 = f64of(0.00001)
    let d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    if d < eps { return 1 }
    return 0
}

// Identified by an integer, not a string: a Quanta STRING parameter arrives as a
// raw pointer and print() renders that pointer, so an earlier version of this file
// printed "FAIL 1109394024" instead of the case name.
fn check(code, got: f64, want: f64) -> i64 {
    if f64_close(got, want) == 1 { return 0 }
    prints("FAIL case ")
    print(code)
    print(" got=")
    pf64(got)
    print(" want=")
    pf64(want)
    print(" ")
    return 1
}

let g_a = 3.0

// Reads through a function declared `-> f64`, which is tagged via fn_retflt.
fn read_via_fn() -> f64 { return g_a + 1.0 }

fn main() {
    // ---- 1-2: the VALUE is always right; only the tag was ever missing ----
    if check(1, g_a, 3.0) != 0 { return 1 }
    if check(2, f64of(g_a), 3.0) != 0 { return 1 }

    // ---- 3-9: trigger conditions. SOFT while the defect is open. ----
    // Each prints only when it is actually wrong, so the gate stays quiet.
    let dead = 1.0
    if f64_close(g_a + 1.0, 4.0) == 0 { prints("BROKEN 3 dead-local ") }
    if f64_close(dead, 1.0) == 0 { prints("BROKEN 4 dead-local-value ") }
    if f64_close(g_a * 2.0, 6.0) == 0 { prints("BROKEN 5 mul ") }
    if f64_close(g_a - 1.0, 2.0) == 0 { prints("BROKEN 6 sub ") }
    if f64_close(g_a / 2.0, 1.5) == 0 { prints("BROKEN 7 div ") }
    if f64_close(read_via_fn(), 4.0) == 0 { prints("BROKEN 8 via-fn ") }
    if f64_close(g_a + 1.0, 4.0) == 0 { prints("BROKEN 9 add-again ") }

    // ---- 10: the one form that works today: the expression is the FIRST thing
    // main evaluates. HARD, because if this breaks the tagging pass regressed. ----
    print("OK float-global")
    return 0
}
