// bitwise_not: `!` is BITWISE NOT in Quanta (not logical). Regression for the
// ARM IR_NOT encoding (must match x86 orn/NOT semantics exactly).
fn r8x(p) { unsafe { return mem_load8(p) } }
fn w8x(p,v) { unsafe { mem_store8(p,v) } }
fn main() {
  if !0 != (0-1) { return 1 }      // ~0 = -1
  if !1 != (0-2) { return 2 }      // ~1 = -2
  if !(0-1) != 0 { return 3 }      // ~(-1) = 0
  if !!7 != 7 { return 4 }         // double bitwise-not is identity
  // scan loop: find "*/" using == && == (the expand_includes pattern)
  let buf = mmap(64)
  w8x(buf+0,97) w8x(buf+1,98) w8x(buf+2,47) w8x(buf+3,42)
  w8x(buf+4,99) w8x(buf+5,100) w8x(buf+6,42) w8x(buf+7,47) w8x(buf+8,101)
  let ln=9 let k=2
  while k+1<ln && (r8x(buf+k)==42 && r8x(buf+k+1)==47)==0 { k=k+1 }
  if k!=6 { return 5 }
  return 0
}
