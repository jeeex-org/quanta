// stdlib_lfm2_conv_test -- the short-conv path must match a reference computed
// from the tensors directly, and it must exercise the two things that are easy
// to get wrong: the CAUSAL state prepend (not append) and both gates (b*x before
// the convolution, c on the output).
//
// llama.cpp's own graph (src/models/lfm2.cpp, build_shortconv_block) is:
//
//   bcx  = in_proj @ x                       [d_model, 3*d_model]
//   b, c, x = split(bcx)                    each d_model wide
//   bx   = transpose(b * x)
//   bx   = concat(conv_state, bx)            causal: state PREPENDED
//   st'  = the last 2 positions of the 3-wide bx
//   out  = conv1d(bx, conv.weight)          3 taps = l_cache, in INCREASING time
//   y    = out_proj @ (c * out)
//
// conv.weight is [l_cache, d_model] = [3, 2048], while the state is l_cache - 1
// = 2 wide. ggml_ssm_conv() reads nc = c->ne[0] = 3 taps with
// `sumf += s[i0] * c[i0]`, i.e. a correlation over increasing time.
//
// The expectation here is computed by dequantizing the three tensors with the
// existing read_tensor_f64() and applying that sequence in plain Quanta -- a
// different code path from fc_short_conv(), which goes through the row-wise
// lfm2_mm kernels. Agreement therefore means the layer is right, not merely
// self-consistent.

import std/fs
import std/gguf
import std/lfm2_forward
import std/lfm2_model
import std/lfm2_mm
import std/math

let MODEL = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

// Reference: same graph, tensors materialized whole (6144 / 6144 / 4194304
// elements -- small enough to hold, unlike the FFN weights).
fn conv_reference(L, x: u64, state: u64, out: u64) {
    let dm = fc_d_model
    let dc = fc_conv_width - 1
    let kw = fc_conv_width

    // The reference walks each output row and dequantizes ONLY that row, so its
    // peak memory is one row rather than the whole tensor. This matters: a first
    // version materialized in_proj AND out_proj whole (4.2 M f64 each) and needed
    // 1280 MB, which silently exceeded the gate's 1 GB ulimit -v and failed with
    // NO output at all. The gate's cap is not optional, so a reference that blows
    // it cannot be used to check the row-wise implementation.
    let Wcv = mem_alloc(gguf_tensor_nelements(lfm2_conv_conv(L)) * 8)
    read_tensor_f64(lfm2_conv_conv(L), Wcv)

    let bcx = mem_alloc(3 * dm * 8)
    if ref_matvec(lfm2_conv_in_proj(L), x, 3 * dm, dm, bcx) != 0 { return -1 }

    // bx[t] = b[t] * x[t]; then prepend the state, giving a 3-wide window
    let bx = mem_alloc(kw * dm * 8)
    let t = 0
    while t < dm {
        let bv = f64of(mem_load(bcx + t * 8))
        let xv = f64of(mem_load(bcx + (2 * dm + t) * 8))
        mem_store(bx + (dc * dm + t) * 8, bv * xv)
        t = t + 1
    }
    t = 0
    while t < dc {
        let c = 0
        while c < dm {
            mem_store(bx + (t * dm + c) * 8, f64of(mem_load(state + (t * dm + c) * 8)))
            c = c + 1
        }
        t = t + 1
    }

    // Correlation with all kw taps in INCREASING time order: k0*s0 + k1*s1 + k2*g
    //
    // KERNEL INDEXING -- this is the bug the test previously CONTAINED. It read
    // Wcv[(k*dm + c)] (channel-major, stride 2048), which is what
    // fc_short_conv() also did, so both sides were wrong in the same way and
    // agreed. The whole forward pass then produced a flat, wrong logit
    // distribution (argmax 71 against llama.cpp's 5922) while every conv test
    // passed.
    //
    // conv.weight is [3, 2048] in ggml order: ne[0]=3 is CONTIGUOUS.
    // ggml_compute_forward_ssm_conv_f32 reads `c[i0 + i1*nc]`, so element
    // (channel c, tap k) is at flat index k + c*3 = c*kw + k.
    let k_out = mem_alloc(dm * 8)
    let c = 0
    while c < dm {
        let acc: f64 = 0.0
        let k = 0
        while k < kw {
            acc = acc + f64of(mem_load(Wcv + (c * kw + k) * 8)) * f64of(mem_load(bx + (k * dm + c) * 8))
            k = k + 1
        }
        mem_store(k_out + c * 8, acc)
        c = c + 1
    }

    // y = out_proj @ (c * conv), also row-wise
    let y = mem_alloc(dm * 8)
    c = 0
    while c < dm {
        let cv = f64of(mem_load(bcx + (dm + c) * 8))
        mem_store(y + c * 8, cv * f64of(mem_load(k_out + c * 8)))
        c = c + 1
    }
    return ref_matvec(lfm2_conv_out_proj(L), y, dm, dm, out)
}

// Row-wise matvec that dequantizes ONE row at a time, written out longhand rather
// than calling lfm2_mm's mm_matvec(). It reads each row through the same
// mm_load_row() primitive but indexes the row itself, so a layout mistake in
// mm_matvec() would show up as a disagreement instead of being assumed correct.
fn ref_matvec(idx: u64, x: u64, rows: i64, cols: i64, y: u64) {
    let r = 0
    while r < rows {
        if mm_load_row(idx, r, cols) != 0 { return -1 }
        let acc: f64 = 0.0
        let c = 0
        while c < cols {
            acc = acc + f64of(mem_load(mm_rowbuf + c * 8)) * f64of(mem_load(x + c * 8))
            c = c + 1
        }
        mem_store(y + r * 8, acc)
        r = r + 1
    }
    return 0
}

fn main() {
    if gguf_load(MODEL) != 0 { print("FAIL gguf_load"); return 1 }
    if fc_read_config() != 0 { print("FAIL fc_read_config"); return 1 }
    let dm = fc_d_model
    let dc = fc_conv_width - 1

    // Layer 0 is a conv layer, so it is the cheapest full-size test.
    let L = 0
    if lfm2_layer_is_attn(L) != 0 { print("FAIL layer 0 should be conv"); return 1 }

    // Deterministic, well-scaled inputs: a ramp for x, and a distinct state so a
    // prepend/append swap cannot accidentally agree.
    let x = mem_alloc(dm * 8)
    let st1 = mem_alloc(dc * dm * 8)
    let i = 0
    while i < dm {
        let v: f64 = i2f(i % 17) * 0.0625
        mem_store(x + i * 8, v)
        i = i + 1
    }
    i = 0
    while i < dc * dm {
        let v: f64 = i2f(i % 13) * 0.03125 - 0.1
        mem_store(st1 + i * 8, v)
        i = i + 1
    }

    let st2 = mem_alloc(dc * dm * 8)
    i = 0
    while i < dc * dm { mem_store(st2 + i * 8, f64of(mem_load(st1 + i * 8))); i = i + 1 }

    let yA = mem_alloc(dm * 8)
    let yB = mem_alloc(dm * 8)

    if conv_reference(L, x, st1, yA) != 0 { print("FAIL reference"); return 1 }
    let rc = fc_short_conv(L, x, st2, yB)
    if rc != 0 { prints("FAIL fc_short_conv rc="); print(rc); return 1 }

    let bad = 0
    let worst: f64 = 0.0
    let c = 0
    while c < dm {
        let a = f64of(mem_load(yA + c * 8))
        let b = f64of(mem_load(yB + c * 8))
        let d = a - b
        if d < 0 { d = 0 - d }
        if d > worst { worst = d }
        // Relative to the reference magnitude, since a raw tolerance is meaningless
        // when the expected values are near zero.
        let mag = a
        if mag < 0 { mag = 0 - mag }
        if mag > 1e-6 {
            if d / mag > 1e-6 { bad = bad + 1 }
        } else if d > 1e-6 { bad = bad + 1 }
        c = c + 1
    }
    prints("mismatches=")
    print(bad)
    if bad != 0 { print("FAIL conv"); return 1 }

    // The state must have ADVANCED: after one token the new state is the last d_conv
    // positions, so it must differ from the input state.
    let moved = 0
    i = 0
    while i < dc * dm {
        let a = f64of(mem_load(st1 + i * 8))
        let b = f64of(mem_load(st2 + i * 8))
        let d = a - b
        if d < 0 { d = 0 - d }
        if d > 1e-9 { moved = moved + 1 }
        i = i + 1
    }
    prints("state entries changed=")
    print(moved)
    if moved == 0 { print("FAIL state did not advance"); return 1 }

    // ---- synthetic kernel-indexing check, independent of any tensor --------
    //
    // The real-tensor comparison above CANNOT catch a shared indexing mistake:
    // the reference and the implementation read the same tensor with the same
    // formula, so they agree whether that formula is right or wrong. That is
    // exactly how a wrong stride survived a passing test and only surfaced as a
    // wrong argmax in the full forward pass.
    //
    // This pins the layout directly. conv.weight is [3, n_embd] with ne[0]=3
    // contiguous, so element (channel c, tap k) lives at c*3 + k. Build a kernel
    // whose value encodes its own (c,k) and check the correlation picks the
    // right one: with bx[t][c] = 10^t the correlation for channel c must equal
    // k0 + 10*k1 + 100*k2, where kk = kernel[c*3 + k].
    let kw3 = 3
    let dm3 = 4
    let ksyn = mem_alloc(kw3 * dm3 * 8)
    let bxsyn = mem_alloc(kw3 * dm3 * 8)
    let csyn = 0
    while csyn < dm3 {
        // kernel[c*3 + k] = c*1000 + k  -> channel c, tap k
        let kk = 0
        while kk < kw3 {
            mem_store(ksyn + (csyn * kw3 + kk) * 8, i2f(csyn * 1000 + kk))
            kk = kk + 1
        }
        // bx[t][c] = 10^t so the taps are distinguishable by position
        let tt = 0
        while tt < kw3 {
            let pw = 1
            let e = 0
            while e < tt { pw = pw * 10; e = e + 1 }
            mem_store(bxsyn + (tt * dm3 + csyn) * 8, i2f(pw))
            tt = tt + 1
        }
        csyn = csyn + 1
    }
    let osyn = mem_alloc(dm3 * 8)
    csyn = 0
    while csyn < dm3 {
        let acc: f64 = 0.0
        let kk = 0
        while kk < kw3 {
            acc = acc + f64of(mem_load(ksyn + (csyn * kw3 + kk) * 8)) * f64of(mem_load(bxsyn + (kk * dm3 + csyn) * 8))
            kk = kk + 1
        }
        mem_store(osyn + csyn * 8, acc)
        csyn = csyn + 1
    }
    // channel c: (c*1000+0)*1 + (c*1000+1)*10 + (c*1000+2)*100 = c*1000*111 + 210
    csyn = 0
    while csyn < dm3 {
        let got = f2i(f64of(mem_load(osyn + csyn * 8)))
        let want = csyn * 1000 * 111 + 210
        if got != want { prints("FAIL synthetic conv channel "); print(csyn); prints(" got "); print(got); prints(" want "); print(want); print(""); return 1 }
        csyn = csyn + 1
    }

    print("OK conv")
    return 0
}