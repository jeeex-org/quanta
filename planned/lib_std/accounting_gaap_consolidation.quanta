// Real Implementation: Consolidation (ASC 810)
// Domain: accounting | Category: GAAP | Module: Consolidation

fn is_vie(total_equity: i64, expected_losses: i64, equity_at_risk_pct: i64) -> i64 {
    if total_equity <= 0 { return 1 }
    if expected_losses > total_equity { return 1 }
    if equity_at_risk_pct < 10 { return 1 }
    return 0
}

fn vie_beneficiary(has_power: i64, absorbs_losses: i64, receives_benefits: i64) -> i64 {
    if has_power == 1 and absorbs_losses == 1 { return 1 }
    if has_power == 1 and receives_benefits == 1 { return 1 }
    return 0
}

fn consolidate_voting_interest(percent_voting_rights: i64) -> i64 {
    if percent_voting_rights > 50 { return 1 }
    return 0
}

fn eliminate_upstream_sale(intercompany_revenue: i64, unrealized_profit_pct: i64, nci_pct: i64) -> (i64, i64) {
    let total_eliminated = (intercompany_revenue * unrealized_profit_pct) / 100
    let nci_eliminated = (total_eliminated * nci_pct) / 100
    let controlling_eliminated = total_eliminated - nci_eliminated
    return (controlling_eliminated, nci_eliminated)
}

fn nci_net_income(subsidiary_net_income: i64, nci_ownership_pct: i64) -> i64 {
    return (subsidiary_net_income * nci_ownership_pct) / 100
}

fn step_acquisition_gain(previous_carrying: i64, previous_fair_value: i64) -> i64 {
    let gain = previous_fair_value - previous_carrying
    if gain > 0 { return gain }
    return 0
}

fn eliminate_intercompany_debt(payable_amount: i64, receivable_amount: i64) -> i64 {
    if payable_amount < receivable_amount { return payable_amount }
    return receivable_amount
}

fn allocate_residual_returns(investment_pct: i64, total_residual: i64) -> i64 {
    return (total_residual * investment_pct) / 100
}
