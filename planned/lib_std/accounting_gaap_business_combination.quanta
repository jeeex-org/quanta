// Real Implementation: Business Combination (ASC 805)
// Domain: accounting | Category: GAAP | Module: Business Combination

fn calculate_goodwill(consideration_transferred: i64, nci_fair_value: i64, net_assets_fair_value: i64) -> i64 {
    let total = consideration_transferred + nci_fair_value
    let goodwill = total - net_assets_fair_value
    if goodwill < 0 { return 0 }
    return goodwill
}

fn bargain_purchase_gain(consideration_transferred: i64, net_assets_fair_value: i64) -> i64 {
    let gain = net_assets_fair_value - consideration_transferred
    if gain > 0 { return gain }
    return 0
}

fn nci_proportionate(subsidiary_net_assets: i64, nci_pct_owned: i64) -> i64 {
    return (subsidiary_net_assets * nci_pct_owned) / 100
}

fn stock_consideration(shares_issued: i64, price_per_share: i64) -> i64 {
    return shares_issued * price_per_share
}

fn acquisition_costs_capitalizable(legal_fees: i64, advisory_fees: i64, stock_issuance_costs: i64) -> i64 {
    return stock_issuance_costs
}

fn recognizable_intangible(is_separable: i64, contractual_right: i64) -> i64 {
    if is_separable == 1 { return 1 }
    if contractual_right == 1 { return 1 }
    return 0
}

fn contingent_consideration(outcome_value: i64, probability_pct: i64) -> i64 {
    return (outcome_value * probability_pct) / 100
}
