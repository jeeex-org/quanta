// Match test
fn classify(n) {
    if n == 0 { return "zero" }
    if n > 0 { return "positive" }
    return "negative"
}

fn main() {
    let vals = mem_alloc(5 * 8)
    mem_store(vals + 0, -3)
    mem_store(vals + 8, 0)
    mem_store(vals + 16, 5)
    mem_store(vals + 24, -1)
    mem_store(vals + 32, 10)
    
    let i = 0
    while i < 5 {
        let n = mem_load(vals + i * 8)
        print("classify(")
        print(n)
        print(")=")
        print(classify(n))
        print("\n")
        i = i + 1
    }
    return 0
}
