// File I/O benchmark
const N = 10000
const BUF_SIZE = 1024

fn main() {
    let buf = mem_alloc(BUF_SIZE)
    let i = 0
    while i < BUF_SIZE {
        mem_store8(buf + i, i % 256)
        i = i + 1
    }
    
    let fd = file_open("/tmp/bench_io.dat", 577, 420)  // O_CREAT|O_WRONLY|O_TRUNC
    
    i = 0
    while i < N {
        file_write(fd, buf, BUF_SIZE)
        i = i + 1
    }
    
    file_close(fd)
    
    let fd2 = file_open("/tmp/bench_io.dat", 0, 0)  // O_RDONLY
    let sum = 0
    i = 0
    while i < N {
        file_read(fd2, buf, BUF_SIZE)
        let j = 0
        while j < BUF_SIZE {
            sum = sum + mem_load8(buf + j)
            j = j + 1
        }
        i = i + 1
    }
    
    file_close(fd2)
    
    print(sum)
    print("\n")
    return 0
}