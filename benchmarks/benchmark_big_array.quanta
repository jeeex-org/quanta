// Large array allocation and access
const SIZE = 100000

fn main() {
    let arr = mem_alloc(SIZE * 8)
    
    // Write
    let i = 0
    while i < SIZE {
        mem_store(arr + i * 8, i + 1)
        i = i + 1
    }
    
    // Read and verify
    let sum = 0
    i = 0
    while i < SIZE {
        sum = sum + mem_load(arr + i * 8)
        i = i + 1
    }
    
    // Expected: sum = 1 + 2 + ... + 100000 = 100000 * 100001 / 2 = 5000050000
    let expected = SIZE * (SIZE + 1) / 2
    if sum == expected {
        print("PASS sum=")
        print(sum)
        print("\n")
        return 0
    }
    print("FAIL sum=")
    print(sum)
    print(" expected=")
    print(expected)
    print("\n")
    return 1
}
