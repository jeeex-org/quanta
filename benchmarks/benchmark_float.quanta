// Float arithmetic benchmark (float-preserving)
const N = 5000000

fn main() {
    let sum = i2f(0)
    let i = 0
    while i < N {
        let x = i2f(i)
        sum = faddf(sum, fmulf(x, x))
        sum = faddf(sum, fdivf(x, faddf(x, i2f(1))))
        i = i + 1
    }
    print(sum)
    print("\n")
    return 0
}