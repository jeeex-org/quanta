// Heavy memory benchmark
const N = 1000000

fn main() {
    let arr = mem_alloc(N * 8)
    
    let i = 0
    while i < N {
        mem_store(arr + i * 8, i)
        i = i + 1
    }
    
    let sum = 0
    i = 0
    while i < N {
        sum = sum + mem_load(arr + i * 8)
        i = i + 1
    }
    
    print("sum=")
    print(sum)
    print("\n")
    return 0
}
