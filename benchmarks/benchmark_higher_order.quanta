// Higher-order call: a closure passed as an fn-typed argument and invoked in a loop
// (routes through IR_CLOSURE_CALL, not a direct symbol call).
fn apply(f: fn(i64) i64, x) { return f(x) }

fn main() {
    let d = |x| { x * 2 }
    let s = 0
    let i = 0
    while i < 1000000 {
        s = s + apply(d, i)
        i = i + 1
    }
    print(s)
    print("\n")
    return 0
}
