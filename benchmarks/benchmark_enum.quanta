// Enum test — current syntax: variants are accessed as Color.Variant and matched.
enum Color {
    Red,
    Green,
    Blue
}

fn color_name(c) {
    if c == 0 { return "Red" }
    if c == 1 { return "Green" }
    return "Blue"
}

fn main() {
    let g = Color.Green
    let c = match g { Color.Red => 0, Color.Green => 1, Color.Blue => 2 }
    print(color_name(c))
    print("\n")
    return 0
}
