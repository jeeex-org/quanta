fn main() {
    let a = i2f(3)
    let b = i2f(2)
    
    let r_add = fadd(a, b)
    let r_sub = fsub(b, a)
    let r_mul = fmul(a, b)
    let r_div = fdiv(b, a)
    
    print("fadd=")
    print(r_add)
    print(" fsub=")
    print(r_sub)
    print(" fmul=")
    print(r_mul)
    print(" fdiv=")
    print(r_div)
    print("\n")
    return 0
}
