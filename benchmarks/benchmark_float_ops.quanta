fn main() {
    let a = i2f(3)
    let b = i2f(2)
    
    let r_add = fadd(a, b)
    let r_sub = fsub(b, a)
    let r_mul = fmul(a, b)
    let r_div = fdiv(b, a)
    
    print("fadd=")
    printi(f64bits(r_add))
    print(" fsub=")
    printi(f64bits(r_sub))
    print(" fmul=")
    printi(f64bits(r_mul))
    print(" fdiv=")
    printi(f64bits(r_div))
    print("\n")
    return 0
}
