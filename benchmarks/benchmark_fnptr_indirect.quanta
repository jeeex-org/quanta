// fnptr() + closure_call: two indirect dispatch targets, alternating per iteration.
fn add1(x) { return x + 1 }
fn sub1(x) { return x - 1 }
fn main() {
    let f = fnptr(add1)
    let g = fnptr(sub1)
    let s = 0
    let i = 0
    while i < 1000000 {
        s = s + closure_call(f, i)
        s = s + closure_call(g, i)
        i = i + 1
    }
    print(s)
    print("\n")
    return 0
}
