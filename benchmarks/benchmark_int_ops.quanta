// Integer ops benchmark. NOTE: `mod` is a reserved word — the variable is `rem`.
fn main() {
    let x = 10
    let y = 20
    let sum = x + y
    let diff = y - x
    let prod = x * y
    let div = y / x
    let rem = y - (y / x) * x

    print("sum=")
    print(sum)
    print(" diff=")
    print(diff)
    print(" prod=")
    print(prod)
    print(" div=")
    print(div)
    print(" mod=")
    print(rem)
    print("\n")
    return 0
}
