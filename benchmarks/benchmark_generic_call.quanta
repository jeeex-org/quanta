// Generic function instantiated for i64 and called once per iteration.
fn id<T>(x T) T { return x }
fn addv<T>(a T, b T) T { return a + b }

fn main() {
    let s = 0
    let i = 0
    while i < 1000000 {
        s = addv(id(s), i)
        i = i + 1
    }
    print(s)
    print("\n")
    return 0
}
