// Struct test: Rectangle with area method.
// The struct-typed parameter MUST be annotated, or `r.width` cannot resolve.
struct Rectangle {
    width: i64,
    height: i64
}

fn area(r: Rectangle) {
    return r.width * r.height
}

fn main() {
    let r = Rectangle(10, 20)
    let a = area(r)
    print("area=")
    print(a)
    print("\n")
    return 0
}
