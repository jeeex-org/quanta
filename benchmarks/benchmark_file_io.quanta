// File I/O test
import std/fs

fn main() {
    let fd = open("/etc/hostname", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let buf = mem_alloc(256)
    let n = read_raw(fd, buf, 256)
    
    print("read ")
    print(n)
    print(" bytes: ")
    write_raw(1, buf, n)
    print("\n")
    
    close(fd)
    return 0
}
