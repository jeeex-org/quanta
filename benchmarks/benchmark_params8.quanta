// 8-parameter call per iteration: exercises the >6-argument stack-passing path.
fn s(a,b,c,d,e,f,g,h){ return a+b+c+d+e+f+g+h }

fn main() {
    let t = 0
    let i = 0
    while i < 1000000 {
        t = t + s(i, 1, 2, 3, 4, 5, 6, 7)
        i = i + 1
    }
    print(t)
    print("\n")
    return 0
}
