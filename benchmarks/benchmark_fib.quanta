// Fibonacci: iterative
fn fib(n) {
    if n <= 1 { return n }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    return b
}

fn main() {
    let n = 40
    let r = fib(n)
    print("fib(40)=")
    print(r)
    print("\n")
    return 0
}
