// Memory operations benchmark
const N = 500000

fn main() {
    let arr = mem_alloc(N * 8)
    
    // Write
    let i = 0
    while i < N {
        mem_store(arr + i * 8, i * 7)
        i = i + 1
    }
    
    // Read and sum
    let sum = 0
    i = 0
    while i < N {
        sum = sum + mem_load(arr + i * 8)
        i = i + 1
    }
    
    // Write byte
    i = 0
    while i < N {
        mem_store8(arr + i, i)
        i = i + 1
    }
    
    // Read byte and sum
    let sum8 = 0
    i = 0
    while i < N {
        sum8 = sum8 + mem_load8(arr + i)
        i = i + 1
    }
    
    print(sum)
    print(" ")
    print(sum8)
    print("\n")
    return 0
}