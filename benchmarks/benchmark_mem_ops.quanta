// Memory operations: load/store arrays
const SIZE = 10000

fn main() {
    let arr = mem_alloc(SIZE * 8)
    
    // Initialize
    let i = 0
    while i < SIZE {
        mem_store(arr + i * 8, i * 2)
        i = i + 1
    }
    
    // Sum
    let sum = 0
    i = 0
    while i < SIZE {
        sum = sum + mem_load(arr + i * 8)
        i = i + 1
    }
    
    print("sum=")
    print(sum)
    print("\n")
    return 0
}
