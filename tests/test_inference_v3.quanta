import std/fs
import std/gguf

fn main() {
    print("=== Inference Test ===\n")
    
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    print("rc=")
    print(rc)
    print("\n")
    
    // Use a small tensor: blk.0.attn_norm.weight (idx=2, dtype=0=F32, nelements=2048, offset=215048192)
    let idx = 2
    
    // Read raw data (F32, 4 bytes per element, but mem_load reads 8 bytes)
    // So we allocate nelements * 8 bytes and read as 64-bit values
    let nelements = gguf_tensor_nelements(idx)
    let offset = gguf_tensor_offset(idx)
    
    print("nelements=")
    print(nelements)
    print(" offset=")
    print(offset)
    print("\n")
    
    // Allocate 8 bytes per element (Quanta uses 64-bit memory)
    let buf = mem_alloc(nelements * 8)
    if buf == 0 {
        print("alloc failed\n")
        return 1
    }
    
    // Seek and read raw bytes (4 bytes per F32 element)
    lseek(gguf_fd, offset, 0)
    read_raw(gguf_fd, buf, nelements * 4)
    
    // Print first 8 values (as 64-bit, but each is a 32-bit float cast to 64-bit)
    // Since mem_load reads 8 bytes and each float is 4 bytes, we need to read at offset i*4
    // But that means consecutive loads overlap. Instead, read raw bytes and interpret.
    print("First 8 raw 32-bit values: ")
    let i = 0
    while i < 8 {
        let raw32 = mem_load8(buf + i * 4)  // read first 4 bytes as uint8
        // Actually need to read 4 bytes properly
        let b0 = mem_load8(buf + i * 4)
        let b1 = mem_load8(buf + i * 4 + 1)
        let b2 = mem_load8(buf + i * 4 + 2)
        let b3 = mem_load8(buf + i * 4 + 3)
        let val32 = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
        print(val32)
        print(" ")
        i = i + 1
    }
    print("\n")
    
    // Test matvec: simple 2x2 matrix
    let A = mem_alloc(32)  // 2x2 matrix, 8 bytes per element
    mem_store(A, 1)
    mem_store(A + 8, 2)
    mem_store(A + 16, 3)
    mem_store(A + 24, 4)
    
    let x = mem_alloc(16)  // 2 elements
    mem_store(x, 5)
    mem_store(x + 8, 6)
    
    let y = mem_alloc(16)  // 2 elements
    gguf_matvec(A, x, 2, 2, y)
    
    print("matvec result: y[0]=")
    print(mem_load(y))
    print(" y[1]=")
    print(mem_load(y + 8))
    print("\n")
    print("Expected: y[0]=17 y[1]=39\n")
    
    // Test softmax
    let inp = mem_alloc(24)  // 3 elements
    mem_store(inp, 1)
    mem_store(inp + 8, 2)
    mem_store(inp + 16, 3)
    
    let out = mem_alloc(24)
    gguf_softmax(out, inp, 3)
    
    print("softmax result: ")
    print(mem_load(out))
    print(" ")
    print(mem_load(out + 8))
    print(" ")
    print(mem_load(out + 16))
    print("\n")
    
    gguf_close()
    print("Done\n")
    return 0
}