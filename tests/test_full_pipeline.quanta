import std/fs
import std/gguf

// Complete inference engine for QUANTA-LFM2.5-2.6B
// 4 layers, 2048 hidden, hybrid ShortConv+Attention architecture

const N_HIDDEN = 2048
const N_INTERMEDIATE = 10752
const N_LAYERS = 4

fn main() {
    print("=== QUANTA-LFM2.5-2.6B Full Inference ===\n")
    
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { print("load failed\n"); return 1 }
    
    print("loaded ")
    print(gguf_num_tensors())
    print(" tensors\n")
    
    // Token 0 embedding
    let token_embd = gguf_find_tensor("token_embd.weight")
    let hidden = mem_alloc(N_HIDDEN * 8)
    read_token_embed(token_embd, 0, hidden)
    
    print("token 0: hidden[0]=")
    print(mem_load(hidden))
    print("\n")
    
    // Run all 4 layers
    let li = 0
    while li < N_LAYERS {
        print("layer ")
        print(li)
        print("...\n")
        
        if li == 0 || li == 1 {
            run_shortconv_layer(li, hidden)
        } else {
            run_attention_layer(li, hidden)
        }
        
        print("  hidden[0]=")
        print(mem_load(hidden))
        print("\n")
        
        li = li + 1
    }
    
    // Final output
    print("\n=== Generation Test ===\n")
    
    // Simple greedy decoding: argmax of logits = hidden @ token_embd^T
    // For now, just show that we can compute logits
    let logits = mem_alloc(128000 * 8)
    matvec(token_embd, hidden, 128000, N_HIDDEN, logits)
    
    // Find max logit (greedy)
    let max_idx = 0
    let max_val = mem_load(logits)
    let i = 1
    while i < 128000 {
        let v = mem_load(logits + i * 8)
        if f2i(v) > f2i(max_val) { max_val = v; max_idx = v }
        i = i + 1
    }
    
    print("greedy next token: ")
    print(max_idx)
    print("\n")
    
    print("SUCCESS\n")
    return 0
}

fn run_shortconv_layer(layer_idx, hidden) {
    // ShortConv: in_proj -> SiLU -> out_proj + residual
    let prefix_in = "blk.N.shortconv.in_proj.weight"
    let prefix_out = "blk.N.shortconv.out_proj.weight"
    
    // Build tensor names with layer number
    let in_proj_name = set_char_at("blk..shortconv.in_proj.weight", 4, 48 + layer_idx)
    let out_proj_name = set_char_at("blk..shortconv.out_proj.weight", 4, 48 + layer_idx)
    
    let in_proj = gguf_find_tensor(in_proj_name)
    let out_proj = gguf_find_tensor(out_proj_name)
    
    // Read weights
    let in_w = mem_alloc(6144 * N_HIDDEN * 8)
    read_tensor_f64(in_proj, in_w)
    
    let out_w = mem_alloc(N_HIDDEN * 6144 * 8)
    read_tensor_f64(out_proj, out_w)
    
    // Forward: tmp = in_proj @ hidden^T, tmp = SiLU(tmp), out = out_proj @ tmp^T
    let tmp = mem_alloc(6144 * 8)
    matvec(in_w, hidden, 6144, N_HIDDEN, tmp)
    
    // SiLU: x * sigmoid(x)
    let i = 0
    while i < 6144 {
        let x = mem_load(tmp + i * 8)
        let sig = fdiv(i2f(1), fadd(i2f(1), pow(i2f(2), fsub(i2f(0), x))))
        mem_store(tmp + i * 8, fmul(x, sig))
        i = i + 1
    }
    
    let out = mem_alloc(N_HIDDEN * 8)
    matvec(out_w, tmp, N_HIDDEN, 6144, out)
    
    // Residual
    i = 0
    while i < N_HIDDEN {
        mem_store(hidden + i * 8, fadd(mem_load(hidden + i * 8), mem_load(out + i * 8)))
        i = i + 1
    }
}

fn run_attention_layer(layer_idx, hidden) {
    // Attention: Q, K, V projection -> attention -> output projection + residual
    
    // Build tensor names
    let attn_norm_name = set_char_at("blk..attn_norm.weight", 4, 48 + layer_idx)
    let q_name = set_char_at("blk..attn_q.weight", 4, 48 + layer_idx)
    let k_name = set_char_at("blk..attn_k.weight", 4, 48 + layer_idx)
    let v_name = set_char_at("blk..attn_v.weight", 4, 48 + layer_idx)
    let out_name = set_char_at("blk..attn_output.weight", 4, 48 + layer_idx)
    
    let attn_norm = gguf_find_tensor(attn_norm_name)
    let q_idx = gguf_find_tensor(q_name)
    let k_idx = gguf_find_tensor(k_name)
    let v_idx = gguf_find_tensor(v_name)
    let out_idx = gguf_find_tensor(out_name)
    
    // Read weights
    let norm_w = mem_alloc(N_HIDDEN * 8)
    read_tensor_f64(attn_norm, norm_w)
    
    let q_w = mem_alloc(N_HIDDEN * N_HIDDEN * 8)  // 2048x2048
    read_tensor_f64(q_idx, q_w)
    
    let k_w = mem_alloc(256 * N_HIDDEN * 8)  // 256x2048 (GQA)
    read_tensor_f64(k_idx, k_w)
    
    let v_w = mem_alloc(256 * N_HIDDEN * 8)  // 256x2048
    read_tensor_f64(v_idx, v_w)
    
    let out_w = mem_alloc(N_HIDDEN * N_HIDDEN * 8)  // 2048x2048
    read_tensor_f64(out_idx, out_w)
    
    // RMSNorm
    let normed = mem_alloc(N_HIDDEN * 8)
    rms_norm(normed, hidden, norm_w, N_HIDDEN)
    
    // Q, K, V projections
    let q = mem_alloc(N_HIDDEN * 8)
    matvec(q_w, normed, N_HIDDEN, N_HIDDEN, q)
    
    let k = mem_alloc(256 * 8)
    matvec(k_w, normed, 256, N_HIDDEN, k)
    
    let v = mem_alloc(256 * 8)
    matvec(v_w, normed, 256, N_HIDDEN, v)
    
    // Attention scores: q @ k^T / sqrt(256)
    let score = mem_alloc(256 * 8)
    let i = 0
    while i < N_HIDDEN {
        let qi = mem_load(q + i * 8)
        // Use GQA: 8 groups, each group has 256/8 = 32 query heads sharing 1 KV head
        let kv_head = i / 32
        let ki = mem_load(k + kv_head * 8)
        let prod = fmul(qi, ki)
        mem_store(score + i * 8, prod)
        i = i + 1
    }
    
    // Softmax over scores
    let probs = mem_alloc(N_HIDDEN * 8)
    softmax_arr(probs, score, N_HIDDEN)
    
    // Apply to values
    let attn_out = mem_alloc(N_HIDDEN * 8)
    i = 0
    while i < N_HIDDEN {
        let pi = mem_load(probs + i * 8)
        let vi = mem_load(v + (i / 32) * 8)
        mem_store(attn_out + i * 8, fmul(pi, vi))
        i = i + 1
    }
    
    // Output projection
    let out = mem_alloc(N_HIDDEN * 8)
    matvec(out_w, attn_out, N_HIDDEN, N_HIDDEN, out)
    
    // Residual
    i = 0
    while i < N_HIDDEN {
        mem_store(hidden + i * 8, fadd(mem_load(hidden + i * 8), mem_load(out + i * 8)))
        i = i + 1
    }
    
    // FFN
    let ffn_norm_name = set_char_at("blk..ffn_norm.weight", 4, 48 + layer_idx)
    let ffn_gate_name = set_char_at("blk..ffn_gate.weight", 4, 48 + layer_idx)
    let ffn_up_name = set_char_at("blk..ffn_up.weight", 4, 48 + layer_idx)
    let ffn_down_name = set_char_at("blk..ffn_down.weight", 4, 48 + layer_idx)
    
    let ffn_norm = gguf_find_tensor(ffn_norm_name)
    let ffn_gate = gguf_find_tensor(ffn_gate_name)
    let ffn_up = gguf_find_tensor(ffn_up_name)
    let ffn_down = gguf_find_tensor(ffn_down_name)
    
    let ffn_norm_w = mem_alloc(N_HIDDEN * 8)
    read_tensor_f64(ffn_norm, ffn_norm_w)
    
    let gate_w = mem_alloc(N_INTERMEDIATE * N_HIDDEN * 8)
    read_tensor_f64(ffn_gate, gate_w)
    
    let up_w = mem_alloc(N_INTERMEDIATE * N_HIDDEN * 8)
    read_tensor_f64(ffn_up, up_w)
    
    let down_w = mem_alloc(N_HIDDEN * N_INTERMEDIATE * 8)
    read_tensor_f64(ffn_down, down_w)
    
    transformer_ffn(hidden, ffn_norm_w, gate_w, up_w, down_w)
}

fn transformer_ffn(hidden, norm_weight, gate_weight, up_weight, down_weight) {
    let normed = mem_alloc(N_HIDDEN * 8)
    rms_norm(normed, hidden, norm_weight, N_HIDDEN)
    
    let gate = mem_alloc(N_INTERMEDIATE * 8)
    matvec(gate_weight, normed, N_INTERMEDIATE, N_HIDDEN, gate)
    
    let up = mem_alloc(N_INTERMEDIATE * 8)
    matvec(up_weight, normed, N_INTERMEDIATE, N_HIDDEN, up)
    
    let activated = mem_alloc(N_INTERMEDIATE * 8)
    swiglu(activated, gate, up, N_INTERMEDIATE)
    
    let out = mem_alloc(N_HIDDEN * 8)
    matvec(down_weight, activated, N_HIDDEN, N_INTERMEDIATE, out)
    
    vec_add(hidden, hidden, out, N_HIDDEN)
}

// Set character in string at position
fn set_char_at(s, pos, val) {
    mem_store8(s + 8 + pos, val)
    return s
}

fn read_token_embed(idx, token_id, buf) {
    let dtype = gguf_tensor_dtype(idx)
    let offset = gguf_tensor_offset(idx)
    let row_offset = token_id * N_HIDDEN
    let elem_size = 210  // bytes per 256 elements for Q6_K
    
    if dtype == 14 {
        // Q6_K: read blocks for 2048 elements
        let n_blocks = N_HIDDEN / 256
        let raw = mem_alloc(n_blocks * 210)
        lseek(gguf_fd, offset + row_offset * 210 / 256, 0)
        read_raw(gguf_fd, raw, n_blocks * 210)
        dequant_q6k(raw, N_HIDDEN, buf)
    } else {
        // Generic: read row directly
        let raw = mem_alloc(N_HIDDEN * 4)
        lseek(gguf_fd, offset + row_offset * 4, 0)
        read_raw(gguf_fd, raw, N_HIDDEN * 4)
        let i = 0
        while i < N_HIDDEN {
            mem_store(buf + i * 8, f32_to_f64(raw + i * 4))
            i = i + 1
        }
    }
}

fn read_tensor_f64(idx, buf) {
    let dtype = gguf_tensor_dtype(idx)
    let offset = gguf_tensor_offset(idx)
    let nelem = gguf_tensor_nelements(idx)
    if dtype == 0 {
        let raw = mem_alloc(nelem * 4)
        lseek(gguf_fd, offset, 0)
        read_raw(gguf_fd, raw, nelem * 4)
        let i = 0
        while i < nelem {
            mem_store(buf + i * 8, f32_to_f64(raw + i * 4))
            i = i + 1
        }
    } else if dtype == 12 {
        let raw = mem_alloc(nelem * 144 / 256)
        lseek(gguf_fd, offset, 0)
        read_raw(gguf_fd, raw, nelem * 144 / 256)
        dequant_q4k(raw, nelem, buf)
    } else if dtype == 14 {
        let raw = mem_alloc(nelem * 210 / 256)
        lseek(gguf_fd, offset, 0)
        read_raw(gguf_fd, raw, nelem * 210 / 256)
        dequant_q6k(raw, nelem, buf)
    }
}

fn f32_to_f64(ptr) {
    let b0 = mem_load8(ptr)
    let b1 = mem_load8(ptr + 1)
    let b2 = mem_load8(ptr + 2)
    let b3 = mem_load8(ptr + 3)
    let sign = i2f(b3 / 128)
    let exp32 = i2f(b3 - (b3 / 128) * 128) * i2f(2) + i2f(b2 / 128)
    let mant32 = i2f(b2 - (b2 / 128) * 128) * i2f(65536) + i2f(b1) * i2f(256) + i2f(b0)
    if exp32 == i2f(0) { return i2f(0) }
    if exp32 == i2f(255) { return i2f(0) }
    let new_exp = f2i(exp32 - i2f(127))
    let mant_frac = fdiv(mant32, i2f(8388608))
    let one_plus_mant = fadd(i2f(1), mant_frac)
    let pow2 = i2f(1)
    let i = 0
    if new_exp >= 0 {
        while i < new_exp { pow2 = fmul(pow2, i2f(2)); i = i + 1 }
    } else {
        let neg = 0 - new_exp
        while i < neg { pow2 = fdiv(pow2, i2f(2)); i = i + 1 }
    }
    let result = fmul(pow2, one_plus_mant)
    if sign == i2f(1) { result = fsub(i2f(0), result) }
    return result
}

fn dequant_q4k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 144
        let scale = mem_load8(raw + bo) + mem_load8(raw + bo + 1) * 256
        let vi = 0
        while vi < 256 {
            let byte_val = mem_load8(raw + bo + 8 + vi / 2)
            let nibble = 0
            if vi - (vi / 2) * 2 == 0 { nibble = byte_val / 16 }
            else { nibble = byte_val - (byte_val / 16) * 16 }
            mem_store(out + (bi * 256 + vi) * 8, scale * nibble / 15)
            vi = vi + 1
        }
        bi = bi + 1
    }
}

fn dequant_q6k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 210
        let scale = mem_load8(raw + bo) + mem_load8(raw + bo + 1) * 256
        let gi = 0
        while gi < 64 {
            let b0 = mem_load8(raw + bo + 2 + gi * 3)
            let b1 = mem_load8(raw + bo + 2 + gi * 3 + 1)
            let b2 = mem_load8(raw + bo + 2 + gi * 3 + 2)
            let q0 = b0 - (b0 / 64) * 64
            let q1 = (b0 / 64) + (b1 - (b1 / 16) * 16) * 4
            let q2 = (b1 / 16) + (b2 - (b2 / 4) * 4) * 16
            let q3 = b2 / 4
            mem_store(out + (bi * 256 + gi * 4) * 8, scale * q0 / 63)
            mem_store(out + (bi * 256 + gi * 4 + 1) * 8, scale * q1 / 63)
            mem_store(out + (bi * 256 + gi * 4 + 2) * 8, scale * q2 / 63)
            mem_store(out + (bi * 256 + gi * 4 + 3) * 8, scale * q3 / 63)
            gi = gi + 1
        }
        bi = bi + 1
    }
}

fn rms_norm(out, x, w, n) {
    let ms = i2f(0)
    let i = 0
    while i < n {
        let v = mem_load(x + i * 8)
        ms = fadd(ms, fmul(v, v))
        i = i + 1
    }
    ms = fdiv(ms, i2f(n))
    let ir = fdiv(i2f(1), sqrt(fadd(ms, i2f(1))))
    i = 0
    while i < n {
        mem_store(out + i * 8, fmul(fmul(mem_load(x + i * 8), ir), mem_load(w + i * 8)))
        i = i + 1
    }
}

fn matvec(A, x, rows, cols, y) {
    let i = 0
    while i < rows {
        let sum = i2f(0)
        let j = 0
        while j < cols {
            sum = fadd(sum, fmul(mem_load(A + (i * cols + j) * 8), mem_load(x + j * 8)))
            j = j + 1
        }
        mem_store(y + i * 8, sum)
        i = i + 1
    }
}

fn softmax_arr(out, inp, n) {
    let max_val = mem_load(inp)
    let i = 1
    while i < n {
        let v = mem_load(inp + i * 8)
        if f2i(v) > f2i(max_val) { max_val = v }
        i = i + 1
    }
    let sum = i2f(0)
    i = 0
    while i < n {
        let ev = fadd(i2f(1), fsub(mem_load(inp + i * 8), max_val))
        if f2i(ev) < 0 { ev = i2f(0) }
        sum = fadd(sum, ev)
        mem_store(out + i * 8, ev)
        i = i + 1
    }
    i = 0
    while i < n {
        mem_store(out + i * 8, fdiv(mem_load(out + i * 8), sum))
        i = i + 1
    }
}

fn swiglu(out, x, y, n) {
    let i = 0
    while i < n {
        let xv = mem_load(x + i * 8)
        let yv = mem_load(y + i * 8)
        let neg_x = fsub(i2f(0), xv)
        let sig = fdiv(i2f(1), fadd(i2f(1), pow(i2f(2), neg_x)))
        mem_store(out + i * 8, fmul(fmul(xv, sig), yv))
        i = i + 1
    }
}

fn vec_add(out, a, b, n) {
    let i = 0
    while i < n {
        mem_store(out + i * 8, fadd(mem_load(a + i * 8), mem_load(b + i * 8)))
        i = i + 1
    }
}