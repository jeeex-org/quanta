import std/fs

// Read tensor info with proper absolute seeking
fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { return 1 }
    
    // Read header at offset 0
    let hdr = mem_alloc(24)
    file_read(fd, hdr, 24)
    
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Current position tracker
    let pos = 24
    
    // Skip metadata
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let slen_buf = mem_alloc(8)
    let i = 0
    
    while i < n_kv {
        // Read key length
        lseek(fd, pos, 0)
        file_read(fd, klen_buf, 8)
        let klen = mem_load(klen_buf)
        pos = pos + 8 + klen
        
        // Read value type
        lseek(fd, pos, 0)
        file_read(fd, vtype_buf, 4)
        let vtype = mem_load(vtype_buf)
        pos = pos + 4
        
        // Skip value based on type
        if vtype == 0 || vtype == 1 || vtype == 7 {  // u8, i8, bool
            pos = pos + 1
        } else if vtype == 2 || vtype == 3 {  // u16, i16
            pos = pos + 2
        } else if vtype == 4 || vtype == 5 || vtype == 6 {  // u32, i32, f32
            pos = pos + 4
        } else if vtype == 8 {  // string
            lseek(fd, pos, 0)
            file_read(fd, slen_buf, 8)
            let slen = mem_load(slen_buf)
            pos = pos + 8 + slen
        } else if vtype == 9 {  // array
            lseek(fd, pos, 0)
            file_read(fd, vtype_buf, 4)  // array element type
            pos = pos + 4
            lseek(fd, pos, 0)
            file_read(fd, slen_buf, 8)  // array length
            let alen = mem_load(slen_buf)
            pos = pos + 8
            // Skip array data (assume 4 bytes per element for now)
            pos = pos + alen * 4
        }
        
        i = i + 1
    }
    
    // Align to 32 bytes
    let rem = pos - (pos / 32) * 32
    if rem != 0 { pos = pos + 32 - rem }
    
    print("tensor_info_start=")
    print(pos)
    print("\n")
    
    // Read tensor info
    let nlen_buf = mem_alloc(8)
    let name_buf = mem_alloc(256)
    let ndims_buf = mem_alloc(4)
    let dim_buf = mem_alloc(8)
    let dtype_buf = mem_alloc(4)
    let off_buf = mem_alloc(8)
    
    i = 0
    while i < n_tensors {
        // Read name length
        lseek(fd, pos, 0)
        file_read(fd, nlen_buf, 8)
        let nlen = mem_load(nlen_buf)
        pos = pos + 8
        
        // Read name
        if nlen > 255 { nlen = 255 }
        lseek(fd, pos, 0)
        file_read(fd, name_buf, nlen)
        mem_store8(name_buf + nlen, 0)
        pos = pos + nlen
        
        // Read ndims
        lseek(fd, pos, 0)
        file_read(fd, ndims_buf, 4)
        let ndims = mem_load(ndims_buf)
        pos = pos + 4
        
        // Read dims
        let d = 0
        while d < ndims {
            lseek(fd, pos, 0)
            file_read(fd, dim_buf, 8)
            pos = pos + 8
            d = d + 1
        }
        
        // Read dtype
        lseek(fd, pos, 0)
        file_read(fd, dtype_buf, 4)
        let dtype = mem_load(dtype_buf)
        pos = pos + 4
        
        // Read offset
        lseek(fd, pos, 0)
        file_read(fd, off_buf, 8)
        let offset = mem_load(off_buf)
        pos = pos + 8
        
        // Print tensor info
        print("[")
        print(i)
        print("] dtype=")
        print(dtype)
        print(" ndims=")
        print(ndims)
        print(" offset=")
        print(offset)
        print(" name='")
        // Print name bytes
        let j = 0
        while j < nlen {
            print(mem_load8(name_buf + j))
            print(" ")
            j = j + 1
        }
        print("'\n")
        
        i = i + 1
    }
    
    close(fd)
    return 0
}