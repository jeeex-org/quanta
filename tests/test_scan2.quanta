import std/fs

fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    // Read header
    let hdr = mem_alloc(24)
    file_read(fd, hdr, 24)
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Skip metadata: read 40 config KVs, then handle tokenizer arrays
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let i = 0
    while i < 40 {
        read_raw(fd, klen_buf, 8)
        let klen = mem_load(klen_buf)
        lseek(fd, klen, 1)  // skip key
        read_raw(fd, vtype_buf, 4)
        let vtype = mem_load(vtype_buf)
        // Skip value
        if vtype == 8 {
            read_raw(fd, klen_buf, 8)
            lseek(fd, mem_load(klen_buf), 1)
        } else if vtype == 0 {
            lseek(fd, 1, 1)
        } else if vtype == 1 {
            lseek(fd, 1, 1)
        } else if vtype == 2 {
            lseek(fd, 2, 1)
        } else if vtype == 3 {
            lseek(fd, 2, 1)
        } else if vtype == 4 {
            lseek(fd, 4, 1)
        } else if vtype == 5 {
            lseek(fd, 4, 1)
        } else if vtype == 6 {
            lseek(fd, 4, 1)
        } else if vtype == 7 {
            lseek(fd, 1, 1)
        } else if vtype == 9 {
            // Array: skip atype + alen + data
            lseek(fd, 4, 1)  // atype
            read_raw(fd, klen_buf, 8)  // alen
            lseek(fd, mem_load(klen_buf) * 4, 1)
        } else if vtype == 10 {
            lseek(fd, 8, 1)
        } else if vtype == 11 {
            lseek(fd, 8, 1)
        } else if vtype == 12 {
            lseek(fd, 8, 1)
        }
        i = i + 1
    }
    
    // Now handle remaining KVs (226 more, mostly tokenizer arrays)
    while i < n_kv {
        read_raw(fd, klen_buf, 8)
        let klen = mem_load(klen_buf)
        if klen > 100000 {
            print("big klen at i=")
            print(i)
            print("\n")
            i = n_kv
        } else {
            lseek(fd, klen, 1)  // skip key
            read_raw(fd, vtype_buf, 4)
            let vtype = mem_load(vtype_buf)
            if vtype == 8 {
                read_raw(fd, klen_buf, 8)
                lseek(fd, mem_load(klen_buf), 1)
            } else if vtype == 9 {
                lseek(fd, 4, 1)  // atype
                read_raw(fd, klen_buf, 8)  // alen
                let alen = mem_load(klen_buf)
                // For string arrays, skip each string
                lseek(fd, alen * 8, 1)  // skip all string lengths
                // Then skip string data
                let si = 0
                while si < alen {
                    read_raw(fd, klen_buf, 8)
                    lseek(fd, mem_load(klen_buf), 1)
                    si = si + 1
                }
            } else if vtype == 0 {
                lseek(fd, 1, 1)
            } else if vtype == 1 {
                lseek(fd, 1, 1)
            } else if vtype == 10 {
                lseek(fd, 8, 1)
            } else if vtype == 11 {
                lseek(fd, 8, 1)
            } else if vtype == 12 {
                lseek(fd, 8, 1)
            } else {
                lseek(fd, 4, 1)
            }
            i = i + 1
        }
    }
    
    let meta_end = lseek(fd, 0, 1)
    print("meta_end=")
    print(meta_end)
    print("\n")
    
    // Scan for tensor info starting at meta_end
    // Try different offsets to find the first tensor name
    let scan = mem_alloc(64)
    let offset = 0
    while offset < 256 {
        lseek(fd, meta_end + offset, 0)
        read_raw(fd, scan, 8)
        let nlen = mem_load(scan)
        if nlen > 0 && nlen < 1000 {
            // Potential tensor name found
            let name = mem_alloc(nlen + 1)
            read_raw(fd, name, nlen)
            mem_store8(name + nlen, 0)
            print("offset=")
            print(offset)
            print(" nlen=")
            print(nlen)
            print(" name: ")
            write_raw(1, name, nlen)
            print("\n")
            offset = offset + 100  // skip ahead to find next
        } else {
            offset = offset + 1
        }
    }
    
    close(fd)
    print("DONE\n")
    return 0
}