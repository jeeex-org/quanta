import std/fs

// Test: is it from if-else chain or mem_load?
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let val = 0
    
    print("before loop\n")
    
    let i = 0
    while i < 3 {
        read_raw(fd, buf, 8)
        val = mem_load(buf)
        print("val=")
        print(val)
        print("\n")
        
        // Test if-else chain
        if val == 0 { lseek(fd, 1, 1) }
        else if val == 1 { lseek(fd, 1, 1) }
        else if val == 2 { lseek(fd, 2, 1) }
        else if val == 3 { lseek(fd, 2, 1) }
        else if val == 4 { lseek(fd, 4, 1) }
        else if val == 5 { lseek(fd, 4, 1) }
        else if val == 6 { lseek(fd, 4, 1) }
        else if val == 7 { lseek(fd, 1, 1) }
        else if val == 8 { lseek(fd, 8, 1) }
        else if val == 9 { lseek(fd, 4, 1) }
        else if val == 10 { lseek(fd, 8, 1) }
        else if val == 11 { lseek(fd, 8, 1) }
        else if val == 12 { lseek(fd, 8, 1) }
        
        i = i + 1
    }
    
    print("after loop\n")
    
    close(fd)
    return 0
}