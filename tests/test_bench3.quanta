import std/fs
import std/gguf

// Benchmark: measure actual matmul throughput
const N = 2048

fn main() {
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { return 1 }
    
    // Allocate matrices
    let A = mem_alloc(N * N * 8)
    let x = mem_alloc(N * 8)
    let y = mem_alloc(N * 8)
    
    // Initialize
    let i = 0
    while i < N {
        mem_store(x + i * 8, i2f(1))
        i = i + 1
    }
    i = 0
    while i < N * N {
        mem_store(A + i * 8, i2f(i % 100 / 100))
        i = i + 1
    }
    
    // Run 5 matmul iterations
    let trial = 0
    while trial < 5 {
        i = 0
        while i < N {
            let sum = i2f(0)
            let j = 0
            while j < N {
                sum = fadd(sum, fmul(mem_load(A + (i * N + j) * 8), mem_load(x + j * 8)))
                j = j + 1
            }
            mem_store(y + i * 8, sum)
            i = i + 1
        }
        trial = trial + 1
    }
    
    print("result[0]=")
    print(mem_load(y))
    print("\n")
    gguf_close()
    return 0
}