import std/fs

// Fix: handle all vtypes in metadata skip, including vtype=2 (int16)
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let slen_buf = mem_alloc(8)
    let alen_buf = mem_alloc(8)
    let nlen_buf = mem_alloc(8)
    let name = mem_alloc(256)
    let ndims_buf = mem_alloc(4)
    let dim_buf = mem_alloc(8)
    let dtype_buf = mem_alloc(4)
    let off_buf = mem_alloc(8)
    
    let i = 0
    let klen = 0
    let vtype = 0
    let slen = 0
    let alen = 0
    let tensor_count = 0
    
    while i < n_kv && tensor_count < n_tensors {
        read_raw(fd, klen_buf, 8)
        klen = mem_load(klen_buf)
        
        if klen > 10000 {
            print("BAD klen at i=")
            print(i)
            print("\n")
            i = n_kv
        } else {
            // Read key
            read_raw(fd, name, klen)
            mem_store8(name + klen, 0)
            
            // Read value type
            read_raw(fd, vtype_buf, 4)
            vtype = mem_load(vtype_buf)
            
            // Check if this is a tensor name
            let is_tensor = 0
            if klen > 4 {
                let first4 = mem_load(name)
                if first4 == 0x2e6b6c62 { is_tensor = 1 }  // "blk."
                if first4 == 0x656b6f74 { is_tensor = 1 }  // "toke"
                if first4 == 0x7074756f { is_tensor = 1 }  // "outp"
            }
            
            if is_tensor == 1 {
                // Tensor info: vtype is dtype, then ndims, dims, offset
                let dtype = vtype
                
                read_raw(fd, ndims_buf, 4)
                let ndims = mem_load(ndims_buf)
                
                let d = 0
                while d < ndims {
                    read_raw(fd, dim_buf, 8)
                    d = d + 1
                }
                
                // Skip dtype (4 bytes) - wait, we already read it as vtype
                // Format: name + dtype(4) + ndims(4) + dims + offset(8)
                // We read name, then dtype (as vtype), then ndims, then dims
                // Now read offset
                read_raw(fd, off_buf, 8)
                let offset = mem_load(off_buf)
                
                print("tensor[")
                print(tensor_count)
                print("] name=")
                write_raw(1, name, klen)
                print(" dtype=")
                print(dtype)
                print(" ndims=")
                print(ndims)
                print(" offset=")
                print(offset)
                print("\n")
                
                tensor_count = tensor_count + 1
            } else {
                // Metadata pair - skip value based on vtype
                if vtype == 8 {
                    read_raw(fd, slen_buf, 8)
                    slen = mem_load(slen_buf)
                    lseek(fd, slen, 1)
                } else if vtype == 9 {
                    lseek(fd, 4, 1)
                    read_raw(fd, alen_buf, 8)
                    alen = mem_load(alen_buf)
                    lseek(fd, alen * 4, 1)
                } else if vtype == 0 { lseek(fd, 1, 1) }
                else if vtype == 1 { lseek(fd, 1, 1) }
                else if vtype == 2 { lseek(fd, 2, 1) }
                else if vtype == 3 { lseek(fd, 2, 1) }
                else if vtype == 4 { lseek(fd, 4, 1) }
                else if vtype == 5 { lseek(fd, 4, 1) }
                else if vtype == 6 { lseek(fd, 4, 1) }
                else if vtype == 7 { lseek(fd, 1, 1) }
                else if vtype == 10 { lseek(fd, 8, 1) }
                else if vtype == 11 { lseek(fd, 8, 1) }
                else if vtype == 12 { lseek(fd, 8, 1) }
            }
            
            i = i + 1
        }
    }
    
    print("\nDone. tensor_count=")
    print(tensor_count)
    print("\n")
    
    close(fd)
    return 0
}