import std/fs

// Test: can we stat the file?
fn main() {
    let path = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"
    let stat_buf = mem_alloc(144)
    file_stat(path, stat_buf)
    
    // Read st_size at offset 64 (x86-64)
    let size = mem_load(stat_buf + 64)
    
    print("file_size=")
    print(size)
    print("\n")
    
    // Try to allocate a small buffer first
    let small = mem_alloc(4096)
    if small == 0 { print("small alloc failed\n"); return 1 }
    
    print("small alloc OK\n")
    return 0
}