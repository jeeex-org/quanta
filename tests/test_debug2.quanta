import std/fs

fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let hdr = mem_alloc(24)
    let n = file_read(fd, hdr, 24)
    print("n=")
    print(n)
    print("\n")
    
    // Print raw bytes
    let i = 0
    while i < 24 {
        print(mem_load8(hdr + i))
        print(" ")
        i = i + 1
    }
    print("\n")
    
    close(fd)
    return 0
}