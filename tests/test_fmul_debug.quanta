import std/fs

fn main() {
    let a = i2f(5)
    let b = i2f(10)
    
    // Test fmul (truncating)
    let m = fmul(a, b)
    print("fmul(i2f(5), i2f(10))="); print(m); print("\n")
    print("expected i2f(50)="); print(i2f(50)); print("\n")
    
    let r = f2i(m)
    print("f2i(fmul(5,10))="); print(r); print("\n")
    
    // Test fmulf (preserving)
    let mf = fmulf(a, b)
    print("fmulf(i2f(5), i2f(10))="); print(mf); print("\n")
    
    let rf = f2i(mf)
    print("f2i(fmulf(5,10))="); print(rf); print("\n")
    
    // Test fmul with small values
    let m2 = fmul(i2f(2), i2f(3))
    print("fmul(i2f(2), i2f(3))="); print(m2); print("\n")
    print("f2i(fmul(2,3))="); print(f2i(m2)); print("\n")
    
    return 0
}
