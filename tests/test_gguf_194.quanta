import std/fs
import std/gguf

fn main() {
    print("=== Quanta 0.0.194 GGUF Full Loader Test ===\n")
    
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 {
        print("load failed: rc=")
        print(rc)
        print("\n")
        return 1
    }
    
    print("n_tensors: ")
    print(gguf_num_tensors())
    print("\n")
    
    gguf_print_info()
    
    return 0
}