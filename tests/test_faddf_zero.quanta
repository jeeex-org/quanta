import std/fs

// Test: faddf without flush_all issue
fn main() {
    // Test basic integer ops first
    let a = 1
    let b = 2
    let c = a + b
    if c != 3 { return 1 }
    
    // Test fadd (truncates to int)
    let r1 = fadd(1, 2)
    if r1 != 3 { return 2 }
    
    // Test i2f
    let f1 = i2f(1)
    let f2 = i2f(2)
    
    // Test faddf - should return float bit-pattern
    let r2 = faddf(f1, f2)
    
    // The result should be i2f(3) = 4613937818241073152
    // But we're getting 12, which suggests something is wrong
    
    // Let's try a simpler test: just return faddf(0, 0)
    let r3 = faddf(i2f(0), i2f(0))
    
    print("faddf(0,0)=")
    print(r3)
    print("\n")
    print("i2f(0)=")
    print(i2f(0))
    print("\n")
    
    return 0
}