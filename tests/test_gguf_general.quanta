import std/fs
import std/gguf

fn main() {
    print("=== General GGUF Support ===\n")
    
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { print("load failed\n"); return 1 }
    
    // Verify all 37 tensors
    print("n_tensors: ")
    print(gguf_num_tensors())
    print("\n")
    
    // Verify token_embd.weight
    let idx = gguf_find_tensor("token_embd.weight")
    print("token_embd.weight idx: ")
    print(idx)
    print(" dtype: ")
    print(gguf_tensor_dtype(idx))
    print(" nelem: ")
    print(gguf_tensor_nelements(idx))
    print("\n")
    
    print("SUCCESS\n")
    gguf_close()
    return 0
}