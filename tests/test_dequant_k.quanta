    // ---- F16 (type 1) -----------------------------------------------------
    build_f16(raw)
    let of = mem_alloc(10 * 8)
    dequant_f16(raw, 10, of)
    check_bits(41, f64bits(mem_load(of + 0 * 8)), 0)
    check_bits(42, f64bits(mem_load(of + 2 * 8)), 4607182418800017408)
    check_bits(43, f64bits(mem_load(of + 3 * 8)), -4616189618054758400)
    check_bits(44, f64bits(mem_load(of + 4 * 8)), 4679235614791434240)
    check_bits(45, f64bits(mem_load(of + 5 * 8)), 4544132024016830464)
    check_bits(46, f64bits(mem_load(of + 6 * 8)), 4499096027743125504)
    check_bits(47, f64bits(mem_load(of + 7 * 8)), 9218868437227405312)
    check_bits(48, f64bits(mem_load(of + 8 * 8)), -4503599627370496)
    // -0.0's bit pattern IS i64::MIN: no positive decimal literal exists for it,
    // and `0 - i64::MIN` overflows (the compiler's checked arithmetic traps).
    // Assert the SIGN, which is exactly what "signed zero is preserved" means.
    let nz = f64bits(mem_load(of + 1 * 8))
    check_bits(70, nz >> 63, 1)
    check_bits(70, nz == nz, 1)
    // NaN has no single correct bit pattern. Assert the definition: exponent
    // all ones with a non-zero mantissa.
    // The pattern comes back NEGATIVE, so field extraction has to be done with
    // MASKS, not arithmetic:
    //
    //  * `x >> 52` in Quanta shifts the bit PATTERN (logical), so for a negative
    //    pattern it yields the top 12 bits, not a negative number.
    //  * `x - (x >> 52) * 2^52` OVERFLOWS on a negative pattern -- the compiler
    //    checks arithmetic and traps with ud2, which is exactly what this test
    //    did before the masks replaced it.
    // `x >> 52` in Quanta shifts the bit PATTERN, so for a positive pattern it
    // yields the exponent directly and for a negative one the top 12 bits set.
    // Fold both to the 11 exponent bits, then require a non-zero mantissa.
    let nanbits = f64bits(mem_load(of + 9 * 8))
    let top = nanbits >> 52
    check_bits(71, top - (top / 2048) * 2048, 2047)                 // exponent
    check_bits(71, (nanbits - nanbits / 16) != 0, 1)                 // mantissa

    // ---- int8 helper ------------------------------------------------------
    // The first version subtracted 128 AND 256, turning -16 (0xF0) into -144, so
    // every negative quant in every decoder was off by 128. All 256 byte values
    // are checked rather than a hand-picked few.
    let n = 0
    let bad = 0
    while n < 256 {
        put8(raw, 0, n)
        let got = i8_at(raw)
        let want = n
        if n >= 128 { want = n - 256 }
        if got != want { bad = bad + 1 }
        n = n + 1
    }
    check_bits(80, bad, 0)
    put8(raw, 0, 240)
    check_bits(81, i8_at(raw), -16)
    put8(raw, 0, 255)
    check_bits(82, i8_at(raw), -1)
    put8(raw, 0, 128)
    check_bits(83, i8_at(raw), -128)
    put8(raw, 0, 16)
    check_bits(84, i8_at(raw), 16)

    // ---- Q4_K (type 12) ---------------------------------------------------
    // Correct before this work and unchanged by it. The assertions are here so
    // that stays true.
    build_q4k(raw)
    let o4 = mem_alloc(256 * 8)
    dequant_q4k(raw, 256, o4)
    check_bits(0, f64bits(mem_load(o4 + 0 * 8)), -4598034482056921088)
