// The remaining GGML decoders, against a COMPILED reference.
//
// scripts/audit/dequant_oracle.py extracts dequantize_row_q8_0, _q4_K, _q5_K and
// _q6_K verbatim out of ggml-quants.c, links them against a driver, and dumps raw
// f64 bit patterns for the synthetic blocks built here. Every expected value below
// is one of those numbers. The comparison is BIT-EXACT, because these decoders do
// only exact arithmetic -- a widening, a multiply and a subtract -- so anything
// short of exact is a defect.
//
// Why a compiled oracle rather than hand-written expectations: the first version of
// these decoders was wrong in ways that produced PLAUSIBLE numbers, not crashes.
// dequant_q6k read a 2-byte scale at offset 0, which is not any GGML layout, and
// nothing noticed because it returns floats. Hand-written expectations would have
// been written by the same misreading.
//
// THREE REAL DEFECTS these now pin:
//
//  1. dequant_q6k was not Q6_K at all. It read `d` at +0 and 3-byte quant groups
//     from +2; the real block is ql[128]@0, qh[64]@128, scales[16]@192, d@208. It
//     was used for 19 of the reference model's 266 tensors, including
//     token_embd.weight -- the entire embedding table.
//
//  2. std/fs's f16_to_f64 masked nothing: `exp = bits / 1024` is 0..63 for a
//     16-bit word, so the SIGN BIT leaked into the exponent. Every negative half was
//     wrong by a power of two (0xC000, -2.0, came back as -8589934592.0 = -2*2^32).
//     It also faked Inf as 1e308 and NaN as 0.0, and used the decimal literal 1e-27
//     where 2^-24 belongs. std/gguf imports std/fs, so gguf's own correct
//     f16_to_f64 was being shadowed by this one -- which is why the bug looked
//     like a name-resolution problem rather than an arithmetic one.
//
//  3. int8 conversion subtracted 128 AND 256, turning 240 (-16) into -144. Every
//     negative quant in every decoder was off by 128.
//
// Failures are identified by NUMBER. `print` on a string argument emits the
// string's pointer, which is a separate known defect.

import std/gguf

let failures = 0

fn check_bits(num, got, want) {
    if got != want {
        failures = failures + 1
        print("FAIL check ")
        println(num)
        print("  got bits  ")
        println(got)
        print("  want bits ")
        println(want)
    }
}

fn put8(s, off, b) {
    mem_store8(s + off, b)
}

fn put16(s, off, pat) {
    mem_store8(s + off, pat - (pat / 256) * 256)
    mem_store8(s + off + 1, pat / 256)
}

// build_q6k: ql[128]@0, qh[64]@128, scales[16]@192 (int8 33-i), d f16@208 = 0.5
fn build_q6k(raw) {
    let i = 0
    while i < 128 { put8(raw, i, (i * 7) % 256); i = i + 1 }
    i = 0
    while i < 64 { put8(raw, 128 + i, (i * 5) % 256); i = i + 1 }
    i = 0
    while i < 16 { put8(raw, 192 + i, (33 - i) % 256); i = i + 1 }
    put16(raw, 208, 0x3800)
    return 0
}

// build_q8_0: d f16@0 = 0.5, then int8 qs[32]@2 = -16..15
fn build_q8_0(raw) {
    put16(raw, 0, 0x3800)
    let i = 0
    while i < 32 { put8(raw, 2 + i, (256 + i - 16) % 256); i = i + 1 }
    return 0
}

// build_q5k: d@0 dmin@2 both 0.5, scales[12]@4 = 0x21, qh[32]@16 = i*5, qs[128]@48 = i*7
fn build_q5k(raw) {
    put16(raw, 0, 0x3800)
    put16(raw, 2, 0x3800)
    let i = 0
    while i < 12 { put8(raw, 4 + i, 0x21); i = i + 1 }
    i = 0
    while i < 32 { put8(raw, 16 + i, (i * 5) % 256); i = i + 1 }
    i = 0
    while i < 128 { put8(raw, 48 + i, (i * 7) % 256); i = i + 1 }
    return 0
}

// build_f16: ten patterns covering both zeros, a subnormal, the smallest normal,
// negatives, max finite, both infinities and NaN
fn build_f16(raw) {
    put16(raw, 0, 0x0000)
    put16(raw, 2, 0x8000)
    put16(raw, 4, 0x3C00)
    put16(raw, 6, 0xBC00)
    put16(raw, 8, 0x7BFF)
    put16(raw, 10, 0x0400)
    put16(raw, 12, 0x0001)
    put16(raw, 14, 0x7C00)
    put16(raw, 16, 0xFC00)
    put16(raw, 18, 0x7E00)
    return 0
}

// build_q4k: d@0 dmin@2 both 0.5, scales[12]@4 = 0x21, qs[128]@16 = i*7.
// Q4_K is Q5_K with the 32-byte qh high-bit plane REMOVED, so qs sits at +16
// rather than +48. Feeding build_q5k's bytes to dequant_q4k reads qh's plane as
// quant data; element 0 happens to agree and elements 1..5 do not.
fn build_q4k(raw) {
    put16(raw, 0, 0x3800)
    put16(raw, 2, 0x3800)
    let i = 0
    while i < 12 { put8(raw, 4 + i, 0x21); i = i + 1 }
    i = 0
    while i < 128 { put8(raw, 16 + i, (i * 7) % 256); i = i + 1 }
    return 0
}

// build_q8_0s: THREE Q8_0 blocks (34 bytes each: f16 d + 32 int8). Scales are
// 0.5, 0.25 and 0.125 so a wrong stride or a wrong quant count is visible in the
// LAST element, not just the first block. A one-block test cannot catch that --
// with n_blocks == 1 the stride is never used.
fn build_q8_0s(raw) {
    let b = 0
    while b < 3 {
        let bo = b * 34
        if b == 0 { put16(raw, bo, 0x3800) }         // d = 0.5
        if b == 1 { put16(raw, bo, 0x3400) }         // d = 0.25
        if b == 2 { put16(raw, bo, 0x3000) }         // d = 0.125
        let i = 0
        while i < 32 { put8(raw, bo + 2 + i, (256 + i - 16) % 256); i = i + 1 }
        b = b + 1
    }
    return 0
}

fn main() {
    let raw = mem_alloc(256)

    // ---- Q6_K (type 14) ---------------------------------------------------
    // Was NOT Q6_K: it read a 2-byte scale at offset 0 and 3-byte quant groups
    // from offset 2, which is no GGML layout at all. Used for 19 of the
    // reference model's 266 tensors including token_embd.weight.
    build_q6k(raw)
    let o6 = mem_alloc(256 * 8)
    dequant_q6k(raw, 256, o6)
    check_bits(0, f64bits(mem_load(o6 + 0 * 8)), -4575516483920068608)
    check_bits(1, f64bits(mem_load(o6 + 1 * 8)), -4583943141035343872)
