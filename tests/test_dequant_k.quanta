    check_bits(254, f64bits(mem_load(o4 + 254 * 8)), 4612811918334230528)
    check_bits(255, f64bits(mem_load(o4 + 255 * 8)), 4612811918334230528)

    // ---- Q8_0 stride, across three blocks --------------------------------
    // The single-block case above cannot see the block stride: with
    // n_blocks == 1 the stride is never used, so changing it from 34 to 32
    // still produces correct output for that one block. This decode puts
    // different data in each of three blocks and checks the LAST element of
    // each, which is what a wrong stride moves.
    let raw3 = mem_alloc(3 * 34)
    build_q8_0s(raw3)
    let o3 = mem_alloc(96 * 8)
    dequant_q8_0(raw3, 96, o3)
    check_bits(90, f64bits(mem_load(o3 + 31 * 8)), f64bits(mem_load(o8 + 31 * 8)))
    // Blocks 1 and 2 differ only in their d, so their decoded values must be
    // exactly half and a quarter of block 0's. The expected bit patterns are
    // the compiler's own: 7.5, 3.75, 1.875.
    //
    // NOT derived by halving the PATTERN. Dividing a bit pattern as an integer
    // is meaningless -- `f64of(bits / 2)` is not `value / 2` -- and doing so
    // produced two wrong expectations that looked like decoder failures.
    check_bits(91, f64bits(mem_load(o3 + 63 * 8)), 4615626668101337088)
    check_bits(92, f64bits(mem_load(o3 + 95 * 8)), 4611123068473966592)

    print("test_dequant_k: ")
    if failures == 0 {
        print("PASS\n")
        return 0
    }
    print("FAIL\n")
    return 1
}
