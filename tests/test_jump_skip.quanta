import std/fs

// Test: metadata skip with computed jump table
// Use a simple loop with no allocations
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    print("header read\n")
    
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    
    // Use a jump table approach instead of if-else chain
    // Read vtype, then dispatch based on value
    let i = 0
    let klen = 0
    let vtype = 0
    let skip = 0
    
    while i < 37 {
        read_raw(fd, klen_buf, 8)
        klen = mem_load(klen_buf)
        lseek(fd, klen, 1)
        read_raw(fd, vtype_buf, 4)
        vtype = mem_load(vtype_buf)
        
        // Compute skip amount based on vtype
        skip = 0
        if vtype == 0 { skip = 1 }
        else if vtype == 1 { skip = 1 }
        else if vtype == 2 { skip = 2 }
        else if vtype == 3 { skip = 2 }
        else if vtype == 4 { skip = 4 }
        else if vtype == 5 { skip = 4 }
        else if vtype == 6 { skip = 4 }
        else if vtype == 7 { skip = 1 }
        else if vtype == 8 { skip = 8 }  // will read length separately
        else if vtype == 9 { skip = 4 }  // atype + alen
        
        lseek(fd, skip, 1)
        
        i = i + 1
    }
    
    print("done\n")
    close(fd)
    return 0
}