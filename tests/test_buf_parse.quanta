import std/fs

// Test: read entire file into memory, then parse
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    // Read first 1024 bytes into memory
    let buf = mem_alloc(1024)
    read_raw(fd, buf, 1024)
    print("read 1024 bytes\n")
    
    // Parse header from buffer
    let n_kv = mem_load(buf + 8)
    let n_tensors = mem_load(buf + 16)
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Parse metadata pairs from buffer
    let pos = 24
    let i = 0
    let klen = 0
    let vtype = 0
    
    while i < 37 {
        klen = mem_load(buf + pos)
        pos = pos + 8 + klen
        vtype = mem_load(buf + pos)
        pos = pos + 4
        
        if vtype == 8 {
            let slen = mem_load(buf + pos)
            pos = pos + 8 + slen
        } else if vtype == 0 { pos = pos + 1 }
        else if vtype == 4 { pos = pos + 4 }
        else if vtype == 5 { pos = pos + 4 }
        else if vtype == 6 { pos = pos + 4 }
        else if vtype == 7 { pos = pos + 1 }
        else if vtype == 10 { pos = pos + 8 }
        else if vtype == 11 { pos = pos + 8 }
        else if vtype == 12 { pos = pos + 8 }
        
        i = i + 1
    }
    
    print("skipped 37 pairs, pos=")
    print(pos)
    print("\n")
    
    // Read first tensor from buffer
    let nlen = mem_load(buf + pos)
    pos = pos + 8
    print("nlen=")
    print(nlen)
    print("\n")
    
    // Print name
    print("name: ")
    i = 0
    while i < nlen {
        let c = mem_load8(buf + pos + i)
        file_write(1, c, 1)
        i = i + 1
    }
    print("\n")
    
    pos = pos + nlen
    
    let ndims = mem_load(buf + pos)
    pos = pos + 4
    print("ndims=")
    print(ndims)
    print("\n")
    
    i = 0
    while i < ndims {
        let dim = mem_load(buf + pos)
        print("dim[")
        print(i)
        print("]=")
        print(dim)
        print("\n")
        pos = pos + 8
        i = i + 1
    }
    
    let dtype = mem_load(buf + pos)
    pos = pos + 4
    print("dtype=")
    print(dtype)
    print("\n")
    
    let offset = mem_load(buf + pos)
    print("offset=")
    print(offset)
    print("\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}