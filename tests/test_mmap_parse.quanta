import std/fs

// Test: mmap entire file, parse from memory
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    // Stat for file size
    let stat_buf = mem_alloc(144)
    fstat(fd, stat_buf)
    let file_size = mem_load(stat_buf + 48)
    print("file_size=")
    print(file_size)
    print("\n")
    
    // Mmap entire file
    let data = mmap(0, file_size, 1, 2, fd, 0)
    if data < 0 { print("mmap failed\n"); close(fd); return 1 }
    print("mmap ok\n")
    
    // Parse header
    let n_kv = mem_load(data + 8)
    let n_tensors = mem_load(data + 16)
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Skip metadata pairs
    let pos = 24
    let klen = 0
    let vtype = 0
    let i = 0
    
    while i < 37 {
        klen = mem_load(data + pos)
        pos = pos + 8 + klen
        vtype = mem_load(data + pos)
        pos = pos + 4
        
        if vtype == 8 {
            let slen = mem_load(data + pos)
            pos = pos + 8 + slen
        } else if vtype == 9 {
            let atype = mem_load(data + pos)
            pos = pos + 4
            let alen = mem_load(data + pos)
            pos = pos + 8
            if atype == 8 {
                let j = 0
                while j < alen {
                    let slen = mem_load(data + pos)
                    pos = pos + 8 + slen
                    j = j + 1
                }
            } else {
                pos = pos + alen * 4
            }
        } else if vtype == 0 { pos = pos + 1 }
        else if vtype == 4 { pos = pos + 4 }
        else if vtype == 5 { pos = pos + 4 }
        else if vtype == 6 { pos = pos + 4 }
        else if vtype == 7 { pos = pos + 1 }
        else if vtype == 10 { pos = pos + 8 }
        else if vtype == 11 { pos = pos + 8 }
        else if vtype == 12 { pos = pos + 8 }
        i = i + 1
    }
    
    print("skipped 37 pairs, pos=")
    print(pos)
    print("\n")
    
    // Read first tensor
    let nlen = mem_load(data + pos)
    pos = pos + 8
    print("nlen=")
    print(nlen)
    print("\n")
    
    // Print name
    print("name: ")
    i = 0
    while i < nlen {
        let c = mem_load8(data + pos + i)
        file_write(1, c, 1)
        i = i + 1
    }
    print("\n")
    
    pos = pos + nlen
    
    let ndims = mem_load(data + pos)
    pos = pos + 4
    print("ndims=")
    print(ndims)
    print("\n")
    
    i = 0
    while i < ndims {
        let dim = mem_load(data + pos)
        print("dim[")
        print(i)
        print("]=")
        print(dim)
        print("\n")
        pos = pos + 8
        i = i + 1
    }
    
    let dtype = mem_load(data + pos)
    pos = pos + 4
    print("dtype=")
    print(dtype)
    print("\n")
    
    let offset = mem_load(data + pos)
    print("offset=")
    print(offset)
    print("\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}