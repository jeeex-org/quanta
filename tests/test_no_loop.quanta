import std/fs

// Buffer-based parse - no lseek, no file reads after initial
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    // Read header only (24 bytes)
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Read first metadata pair manually (no loop)
    let klen = mem_load(hdr + 24)
    print("klen=")
    print(klen)
    print("\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}