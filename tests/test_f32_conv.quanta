import std/fs

// f32 bytes (at ptr) -> f64 bits
// f32: 1 sign + 8 exp + 23 mantissa (bias 127)
// f64: 1 sign + 11 exp + 52 mantissa (bias 1023)
//
// 0.0.221: the original used `let u32` (a reserved type keyword, which the
// parser silently read as a garbage name -> binding always 0), and expressed
// the bit extraction as division/multiplication against 2^31 and 2^63. The
// first was wrong code, the second needed std/big. Both are shifts here.
fn f32_to_f64(ptr) {
    // Read little-endian u32
    let b0 = mem_load8(ptr)
    let b1 = mem_load8(ptr + 1)
    let b2 = mem_load8(ptr + 2)
    let b3 = mem_load8(ptr + 3)
    let bits = b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216)

    let sgn = (bits >> 31) << 63            // bit 31 -> bit 63
    let exp32 = (bits >> 23) & 255          // bits 30-23
    let man32 = bits & 8388607              // bits 22-0

    if exp32 == 0 {
        // Zero or denormal -- just return 0
        return 0
    }
    if exp32 == 255 {
        // Inf/NaN
        let inf = sgn + (2047 << 52)
        if man32 == 0 { return inf }
        return inf + (man32 << 29)
    }

    let exp64 = (exp32 - 127 + 1023) << 52  // shift to bits 62-52
    let man64 = man32 << 29                 // shift left by 29 (52-23=29)

    return sgn + exp64 + man64
}

fn main() {
    print("=== f32 Conversion Test ===\n")

    // Test: 1.0f32 = 0x3F800000
    let test = mem_alloc(4)
    mem_store8(test, 0)
    mem_store8(test + 1, 0)
    mem_store8(test + 2, 128)
    mem_store8(test + 3, 63)

    let result = f32_to_f64(test)
    print("1.0f32 = ")
    print(result)
    print(" (expected 4607182418800017408)\n")
    if result != 4607182418800017408 {
        print("FAIL: 1.0f32 conversion wrong\n")
        return 1
    }

    // Test: -1.0f32 = 0xBF800000
    let ntest = mem_alloc(4)
    mem_store8(ntest, 0)
    mem_store8(ntest + 1, 0)
    mem_store8(ntest + 2, 128)
    mem_store8(ntest + 3, 191)
    let nres = f32_to_f64(ntest)
    print("-1.0f32 = ")
    print(nres)
    print(" (expected -4616189618054758400)\n")
    // 0xBFF0000000000000 is the correct f64 bit pattern for -1.0. It does NOT
    // read as -4607182418800017408: that is the UNSIGNED reading of the POSITIVE
    // pattern 0x3FF0000000000000. Setting bit 63 adds 2^63, so the signed i64
    // reading of an f64 pattern is (pattern - 2^64) for negatives. A signed
    // negation of an i64 can never produce an f64 pattern with bit 63 set.
    // Correct signed reading: 0 - 4616189618054758400.
    if nres != 0 - 4616189618054758400 {
        print("FAIL: -1.0f32 conversion wrong\n")
        return 1
    }

    // Test: read actual f32 weight from GGUF
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }

    lseek(fd, 8222781, 0)

    // Skip to tensor 1 (token_embd_norm.weight, f32, 2048)
    let nlen_buf = mem_alloc(8)
    read_raw(fd, nlen_buf, 8)
    let nlen = mem_load(nlen_buf)
    let name = mem_alloc(256)
    read_raw(fd, name, nlen)

    let ndims_buf = mem_alloc(4)
    read_raw(fd, ndims_buf, 4)
    let ndims = mem_load(ndims_buf)
    let dim_buf = mem_alloc(8)
    let d = 0
    while d < ndims {
        read_raw(fd, dim_buf, 8)
        d = d + 1
    }

    let dtype_buf = mem_alloc(4)
    read_raw(fd, dtype_buf, 4)
    let off_buf = mem_alloc(8)
    read_raw(fd, off_buf, 8)
    let offset = mem_load(off_buf)

    print("tensor[1] offset=")
    print(offset)
    print("\n")

    // Read first 4 f32 values
    let raw = mem_alloc(16)
    lseek(fd, offset, 0)
    read_raw(fd, raw, 16)

    let v0 = f32_to_f64(raw)
    let v1 = f32_to_f64(raw + 4)
    let v2 = f32_to_f64(raw + 8)
    let v3 = f32_to_f64(raw + 12)

    print("v0=")
    print(v0)
    print(" v1=")
    print(v1)
    print(" v2=")
    print(v2)
    print(" v3=")
    print(v3)
    print("\n")

    // f32 weights are typically small (< 1.0), so their |value| in bits must be
    // far below the 1.0 pattern (0x3FF0000000000000). A 0 here means the bit
    // extraction collapsed, which is exactly what the reserved-name bug did.
    if v0 == 0 && v1 == 0 && v2 == 0 && v3 == 0 {
        print("FAIL: all tensor values read as zero\n")
        return 1
    }

    print("SUCCESS\n")
    close(fd)
    return 0
}