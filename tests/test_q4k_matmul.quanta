import std/fs

// Integer-only Q4_K matmul for LFM2.5 2.6B
// No float builtins - pure integer arithmetic
// Q4_K block: 144 bytes = 256 values
// Layout: [scale_f16(2)] [scales_8bit(16)] [quads(128)]

const Q8_SCALE = 128  // 1.0 in Q8 = 128

// Dequantize one Q4_K block to Q8 integers
fn dequant_q4k(W_base, out) {
    // Read scale (f16, 2 bytes)
    let scale_raw = mem_load8(W_base) + mem_load8(W_base + 1) * 256
    let scale_q8 = f16_to_q8(scale_raw)
    
    let qi = 0
    while qi < 256 {
        // Get sub-scale (one per 16 elements)
        let sub_byte = mem_load8(W_base + 2 + qi / 16)
        let sub_q8 = sub_byte  // Already in 0-255 range
        
        // Get quad (4-bit value)
        let byte_idx = qi / 2
        let byte_val = mem_load8(W_base + 18 + byte_idx)
        let nibble = 0
        if qi - (qi / 2) * 2 == 0 {
            nibble = byte_val - (byte_val / 16) * 16
        } else {
            nibble = byte_val / 16
        }
        
        // Dequantize: value = scale * sub_scale * (nibble - 8)
        // In Q8: val_q8 = scale_q8 * sub_q8 * (nibble - 8) / Q8_SCALE
        let val_q8 = scale_q8 * sub_q8 * (nibble - 8) / Q8_SCALE
        mem_store(out + qi * 8, val_q8)
        
        qi = qi + 1
    }
}

// Convert f16 to Q8 fixed-point
fn f16_to_q8(f16) {
    let sign = (f16 / 32768) * 32768
    let exp = (f16 - sign) / 1024
    let mant = f16 - sign - exp * 1024
    
    if exp == 0 {
        if mant == 0 { return 0 }
        return mant * Q8_SCALE / 1048576
    }
    if exp == 31 { return 0 }
    
    // Normal: value = 2^(exp-15) * (1 + mant/1024)
    let base = 1024 + mant
    let shift = exp - 15
    if shift >= 0 {
        return base * (1 * shift) * Q8_SCALE / 1024
    } else {
        return base * Q8_SCALE / 1024 / (1 * (-shift))
    }
}

// Q4_K matmul: y = W * x
// W is Q4_K quantized [rows, cols], x is Q8 [cols], y is Q8 [rows]
fn matvec_q4k(W, x, rows, cols, y) {
    let n_blocks = cols / 256
    let i = 0
    while i < rows {
        let sum = 0
        let bi = 0
        while bi < n_blocks {
            // Dequantize one block
            let dequant = mem_alloc(256 * 8)
            dequant_q4k(W + (i * n_blocks + bi) * 144, dequant)
            
            // Dot product with x
            let j = 0
            while j < 256 {
                let w_val = mem_load(dequant + j * 8)
                let x_val = mem_load(x + (bi * 256 + j) * 8)
                sum = sum + w_val * x_val / Q8_SCALE
                j = j + 1
            }
            
            bi = bi + 1
        }
        mem_store(y + i * 8, sum)
        i = i + 1
    }
}

// Test
fn main() {
    // Create a simple Q4_K block (144 bytes for 256 elements)
    let W = mem_alloc(144)
    
    // Set scale to 1.0 (f16 = 0x3C00 = 15360)
    mem_store8(W, 0)
    mem_store8(W + 1, 60)  // 15360 = 0x3C00
    
    // Set sub-scales to 1 (for simplicity)
    let i = 0
    while i < 16 {
        mem_store8(W + 2 + i, 1)
        i = i + 1
    }
    
    // Set quads: alternate between nibble 9 (value = 1) and nibble 7 (value = -1)
    i = 0
    while i < 128 {
        // Each byte has 2 nibbles
        mem_store8(W + 18 + i, 0x97)  // nibble 9, nibble 7
        i = i + 1
    }
    
    // Create input x (256 elements, all 1.0 in Q8 = 128)
    let x = mem_alloc(256 * 8)
    i = 0
    while i < 256 {
        mem_store(x + i * 8, 128)  // 1.0 in Q8
        i = i + 1
    }
    
    // Run matmul
    let y = mem_alloc(8)
    matvec_q4k(W, x, 1, 256, y)
    
    let result = mem_load(y)
    print("result=")
    print(result)
    print("\n")
    
    // Expected: 128 elements with value 1, 128 elements with value -1
    // Sum = 128 * 1 + 128 * (-1) = 0
    if result == 0 { print("PASS\n"); return 0 }
    print("FAIL (expected 0)\n")
    return 1
}