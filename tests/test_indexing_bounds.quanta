// Array, string and slice indexing are bounds-checked.
//
// This exists to protect a behaviour that is CORRECT and easy to mistake for a
// defect. An out-of-range index traps with SIGILL:
//
//     a[3] on a 3-element array   -> SIGILL
//     a[-1]                       -> SIGILL
//     "abc"[3]                    -> SIGILL
//
// That SIGILL is not a missing bounds check -- it IS the check. codegen.quanta's
// IR_IDX handler calls idx_trap_emit(ii) in both the string and the array branch,
// and IR_ISTORE does the same; the trap is `cmp [rax], rcx ; jb +2 ; ud2`, which
// fires when idx >= len.
//
// The test asserts both halves, because a validator that accepts everything is as
// broken as one that rejects everything: every valid index must work, and the
// out-of-range case must be shown to trap rather than silently read adjacent
// memory. The trapping cases run as SEPARATE programs, since a trap takes the
// process down.

let failures = 0

fn check(num, got, want) {
    if got != want {
        failures = failures + 1
        print("FAIL check ")
        println(num)
        print("  got  ")
        println(got)
        print("  want ")
        println(want)
    }
}

fn check_bits(num, got, want) {
    if f64bits(got) != f64bits(want) {
        failures = failures + 1
        print("FAIL check ")
        println(num)
        print("  got bits  ")
        println(f64bits(got))
        print("  want bits ")
        println(f64bits(want))
    }
}

fn main() {
    // ---- every valid array index works ------------------------------------
    let a = [10, 20, 30, 40]
    check(10, len(a), 4)
    check(11, a[0], 10)
    check(12, a[1], 20)
    check(13, a[2], 30)
    check(14, a[3], 40)

    // A runtime index, not a literal: the trap must compare against the header at
    // run time, not a compile-time constant.
    let i = 0
    let sum = 0
    while i < 4 {
        sum = sum + a[i]
        i = i + 1
    }
    check(15, sum, 100)

    // A computed index.
    let k = 3
    check(16, a[k - 1], 30)

    // ---- array writes, which trap on the same condition --------------------
    let m = [0, 0, 0]
    m[0] = 5
    m[1] = 6
    m[2] = 7
    check(20, m[0], 5)
    check(21, m[1], 6)
    check(22, m[2], 7)
    let w = 1
    m[w] = 99
    check(23, m[1], 99)

    // ---- string indexing uses a byte stride and its own length ------------
    let s = "abc"
    check_bits(30, f64of(i2f(s[0])), 97.0)     // 'a'
    check_bits(31, f64of(i2f(s[1])), 98.0)     // 'b'
    check_bits(32, f64of(i2f(s[2])), 99.0)     // 'c'

    // ---- slices ------------------------------------------------------------
    let b = [10, 20, 30, 40, 50]
    let sl = b[1:4]
    check(40, len(sl), 3)
    check(41, sl[0], 20)
    check(42, sl[1], 30)
    check(43, sl[2], 40)
    // An open-ended slice.
    let tail = b[2:]
    check(44, len(tail), 3)
    check(45, tail[0], 30)
    // A slice whose HIGH bound exceeds the length is NOT clamped -- it traps,
    // because the lowering clamps only the low side and then indexes
    // base[lo+idx] for idx in 0..n, which walks past the end when hi > len.
    // Only a bound within range gives a result:
    let inr = b[3:5]
    check(46, len(inr), 2)
    check(47, inr[0], 40)
    check(48, inr[1], 50)
    // An empty slice, which is well defined.
    let empty = b[3:3]
    check(49, len(empty), 0)

    // ---- a string array, where elements are string pointers ---------------
    let parts = ["one", "two", "three"]
    check(50, len(parts), 3)
    check(51, len(parts[0]), 3)
    check(52, len(parts[1]), 3)
    check(53, len(parts[2]), 5)

    // NOTE: parts[i][j] -- indexing INTO a string-array element -- is NOT
    // asserted here because it CRASHES THE COMPILER (SIGILL compiling
    // `println(parts[1][0])`), rather than miscompiling. That is a separate
    // open defect; see WIP.md. Asserting it in this file would take the whole
    // suite down at compile time and hide every other check.

    // ---- report ------------------------------------------------------------
    // The trapping half of this test is tests/run_bounds_trap.py, which compiles
    // each out-of-range case as its own program and asserts the process dies with
    // SIGILL rather than reading adjacent memory. It cannot live here because a
    // trap takes the whole process down.
    print("test_indexing_bounds: ")
    if failures == 0 {
        print("PASS\n")
        return 0
    }
    print("FAIL\n")
    return 1
}