import std/fs
import std/gguf

fn main() {
    print("start\n")
    
    let path = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"
    let fd = open(path, 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    print("opened\n")
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    print("n_kv=")
    print(n_kv)
    print("\n")
    
    print("done\n")
    close(fd)
    return 0
}