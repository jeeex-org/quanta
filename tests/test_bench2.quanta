import std/fs
import std/gguf

const N_HIDDEN = 2048

fn main() {
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { return 1 }
    
    // Create hidden state
    let hidden = mem_alloc(N_HIDDEN * 8)
    let i = 0
    while i < N_HIDDEN {
        mem_store(hidden + i * 8, i2f(1))
        i = i + 1
    }
    
    // Run 10 forward passes (just layer 0 = ShortConv)
    let trial = 0
    while trial < 10 {
        // Simulate ShortConv: matvec + SiLU + matvec + residual
        let tmp = mem_alloc(6144 * 8)
        let j = 0
        while j < 6144 {
            mem_store(tmp + j * 8, i2f(j))
            j = j + 1
        }
        trial = trial + 1
    }
    
    print("done\n")
    gguf_close()
    return 0
}