// tests/lfm2_fused_logits_test.quanta
//
// THE BIT-EXACTNESS GATE FOR THE WIRING: identical LOGITS, not just argmax.
//
// Runs the SAME sequence THREE times in one process and diffs the full 128,000-
// value logits vector element-wise at every step:
//
//   pass 0: fused_q4k = 0   (the existing path)
//   pass 1: fused_q4k = 0   (CONTROL: proves fc_fw_reset() is a clean reset --
//                            without this, "pass 2 differs" would prove nothing,
//                            because two serial runs of a stateful pass differ
//                            just as much when state is carried)
//   pass 2: fused_q4k = 1   (the wired fused route)
//
// pass1-vs-pass0 must be 0 mismatches or the reset is not clean and the whole
// comparison is void; then pass2-vs-pass0 must also be 0.
//
// Build: ./compiler/0.0.246/bin/x86/qc -O tests/lfm2_fused_logits_test.quanta <bin>
// Run (model is 1.67 GB; the VA cap must exceed it):
//   ( ulimit -c 0 -v 32000000; nice -n 0 <bin> </dev/null )
import std/gguf
import std/lfm2_forward
import std/lfm2_model
import std/gguf_mm
import std/gguf_bpe
import std/lfm2_chat
import std/fs

const Q4_PATH = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"
const PROMPT_PATH = "tests/lfm2_prompt.txt"
const NCTX = 2048
const NTOK = 4          // greedy decode steps after the prompt
const CAP = 16384

let plen = 0

fn slurp(fd) {
    if fd < 0 { return 0 }
    let b = mem_alloc(CAP)
    let got = read_raw(fd, b, CAP)
    file_close(fd)
    if got <= 0 { return 0 }
    plen = got
    return b
}

fn as_str(raw, n) {
    let s = mem_alloc(n + 16)
    mem_store(s, n)
    let i = 0
    while i < n { mem_store8(s + 8 + i, mem_load8(raw + i)); i = i + 1 }
    mem_store8(s + 8 + n, 0)
    return s
}

// One full sequence from a clean state. Copies the final logits into `out`
// (n_vocab f64) and the per-step argmax into `am` (NTOK+1 entries).
// Returns 0 on success.
fn run_seq(ids, n, flag, out, am) {
    mm_set_fused_q4k(flag)
    if fc_fw_reset() != 0 { return -1 }
    let i = 0
    let step = 0
    let nexttok = 0
    while i < n {
        let want = 0
        if i == n - 1 { want = 1 }
        if fc_forward_token_ex(mem_load(ids + i * 8), i, want) != 0 { return -1 }
        i = i + 1
    }
    mem_store(am + 0 * 8, fc_argmax(fc_n_vocab))
    // greedy decode steps
    step = 1
    while step <= NTOK {
        let tok = fc_argmax(fc_n_vocab)
        mem_store(am + step * 8, tok)
        let want = 1
        if fc_forward_token_ex(tok, n - 1 + step, want) != 0 { return -1 }
        step = step + 1
    }
    // final logits
    let v = 0
    while v < fc_n_vocab { mem_store(out + v * 8, f64of(mem_load(fc_fw_logits + v * 8))); v = v + 1 }
    return 0
}

fn main() {
    prints("=== fused Q4_K wiring: LOGITS-level bit-exactness ===\n")
    if gguf_load(Q4_PATH) != 0 { prints("FAIL gguf_load\n"); return 1 }
    if fc_read_config() != 0 { prints("FAIL fc_read_config\n"); return 1 }
    if bpe_init_from_gguf() == 0 { prints("FAIL bpe_init\n"); return 1 }
    if fc_kv_init(NCTX) != 0 { prints("FAIL fc_kv_init\n"); return 1 }
    if fc_fw_init() != 0 { prints("FAIL fc_fw_init\n"); return 1 }
    mm_set_workers_uncapped(20)
    mm_set_embed_workers_uncapped(20)
    if mm_attach_mmap_fd(file_open(Q4_PATH, 0)) != 0 { prints("FAIL mm_attach_mmap\n"); return 1 }
    if fc_cache_norms() != 0 { prints("FAIL fc_cache_norms\n"); return 1 }

    let rawprompt = slurp(file_open(PROMPT_PATH, 0))
    if rawprompt == 0 { prints("FAIL read prompt\n"); return 1 }
    let user = as_str(rawprompt, plen)
    let pb = mem_alloc(CAP)
    let pbytes = chat_build(0, user, pb)
    let ids = mem_alloc(8192 * 8)
    mem_store(ids, bpe_bos)
    let n = bpe_encode_special(pb, pbytes, ids + 8, 8000) + 1
    prints("prompt_ids="); print(n); newline()
    if n <= 1 { prints("FAIL encode\n"); return 1 }

    let nv = fc_n_vocab
    let L0 = mem_alloc(nv * 8)
    let L1 = mem_alloc(nv * 8)
    let L2 = mem_alloc(nv * 8)
    let a0 = mem_alloc(64)
    let a1 = mem_alloc(64)
    let a2 = mem_alloc(64)

    mm_pool_begin()
    prints("pass0 (existing path)...\n")
    if run_seq(ids, n, 0, L0, a0) != 0 { prints("FAIL pass0\n"); return 1 }
    prints("  argmax seq: ")
    let s = 0
    while s <= NTOK { print(mem_load(a0 + s * 8)); prints(" "); s = s + 1 }
    newline()

    prints("pass1 (existing path, CONTROL: reset cleanliness)...\n")
    if run_seq(ids, n, 0, L1, a1) != 0 { prints("FAIL pass1\n"); return 1 }
    prints("  argmax seq: ")
    s = 0
    while s <= NTOK { print(mem_load(a1 + s * 8)); prints(" "); s = s + 1 }
    newline()

    prints("pass2 (FUSED route, flag ON)...\n")
    if run_seq(ids, n, 1, L2, a2) != 0 { prints("FAIL pass2\n"); return 1 }
    prints("  fused_used="); print(mm_get_fused_used())
    prints("  argmax seq: ")
    s = 0
    while s <= NTOK { print(mem_load(a2 + s * 8)); prints(" "); s = s + 1 }
    newline()
    mm_pool_end()

    // diff logits element-wise
    let m01 = 0
    let m02 = 0
    let maxd02: f64 = 0.0
    let v = 0
    while v < nv {
        let b0 = mem_load(L0 + v * 8)
        if mem_load(L1 + v * 8) != b0 { m01 = m01 + 1 }
        let b2 = mem_load(L2 + v * 8)
        if b2 != b0 {
            m02 = m02 + 1
            let d: f64 = b2 - b0
            let ad: f64 = d
            if ad < 0.0 { ad = 0.0 - ad }
            if ad > maxd02 { maxd02 = ad }
        }
        v = v + 1
    }
    // argmax sequences
    let ma01 = 0
    let ma02 = 0
    s = 0
    while s <= NTOK {
        if mem_load(a1 + s * 8) != mem_load(a0 + s * 8) { ma01 = ma01 + 1 }
        if mem_load(a2 + s * 8) != mem_load(a0 + s * 8) { ma02 = ma02 + 1 }
        s = s + 1
    }

    prints("---\n")
    prints("logits_n="); print(nv); newline()
    prints("CONTROL pass1-vs-pass0 : logit_mism="); print(m01)
    prints(" argmax_mism="); print(ma01); newline()
    prints("FUSED   pass2-vs-pass0 : logit_mism="); print(m02)
    prints(" argmax_mism="); print(ma02)
    // raw f64 bits of the largest absolute difference (no float printf here)
    let dbits = mem_alloc(8)
    mem_store(dbits, maxd02)
    prints(" max_abs_diff_bits="); print(mem_load(dbits)); newline()
    prints("pass0_argmax0="); print(mem_load(a0)); newline()

    if m01 != 0 || ma01 != 0 {
        prints("FAIL: the CONTROL is not clean -- fc_fw_reset() does not restore state; comparison void\n")
        return 2
    }
    if m02 != 0 || ma02 != 0 {
        prints("FAIL: the fused route is NOT bit-identical to the existing path\n")
        return 1
    }
    prints("PASS: fused and existing paths give IDENTICAL logits (all 128000 values)\n")
    prints("DONE\n")
    return 0
}
