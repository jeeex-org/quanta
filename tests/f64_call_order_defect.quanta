fn reduce(x) -> f64 {
    let ax = 0.0
    if x < 0.0 { ax = 0.0 - x } else { ax = x }
    let nf = qmult(x)

    if ax < 1048576.0 {
        // |n| < 2^20: both products exact.
        return x - nf * pio2_1() - nf * pio2_1t()
    }
    if ax < 68719476736.0 {
        // |n| < 2^36: split so the leading product stays under 2^20.
        let nh = 0.0
        if nf >= 1048576.0 { nh = nf - 1048576.0 } else { if nf <= 0.0 - 1048576.0 { nh = nf + 1048576.0 } else { nh = nf } }
        let nl = nf - nh
        return x - nh * pio2_1() - nh * pio2_1t() - nl * pio2_2() - nl * pio2_2t()
    }
    if ax < 140737488355328.0 {
        // |n| < 2^47: three stages.
        let nh = 0.0
        if nf >= 1048576.0 { nh = nf - 1048576.0 } else { if nf <= 0.0 - 1048576.0 { nh = nf + 1048576.0 } else { nh = nf } }
        let nl = nf - nh
        return x - nh * pio2_1() - nh * pio2_1t() - nl * pio2_2() - nl * pio2_2t() - nf * pio2_3() - nf * pio2_3t()
    }
    // Beyond 2^47 the caller's own argument has lost more precision than a
    // binary64 result can express, so a longer table buys nothing real.
    return x - nf * pio2_1() - nf * pio2_1t()
}
