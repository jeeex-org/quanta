fn check(name: str, ok) {
    if ok {
        print("ok   ")
        print(name)
        print("\n")
        return 0
    }
    print("FAIL ")
    print(name)
    print("\n")
    return 1
}

fn main() {
    let bad = 0

    print("=== GGUF inference path: real model ===\n")

    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 {
        print("load failed: rc=")
        print(rc)
        print("\n")
        return 1
    }
    let n_tensors = gguf_num_tensors()
    print("n_tensors: ")
    print(n_tensors)
    print("\n")
    bad = bad + check("n_tensors == 266", n_tensors == 266)

    // ---- Q4_K tensor metadata -------------------------------------------
    let idx = gguf_find_tensor("blk.0.ffn_gate.weight")
    if idx < 0 {
        print("tensor not found\n")
        return 1
    }
    let dtype = gguf_tensor_dtype(idx)
    print("idx=")
    print(idx)
    print(" dtype=")
    print(dtype)
    print("\n")
    bad = bad + check("dtype is Q4_K (12)", dtype == 12)

    let nelements = gguf_tensor_nelements(idx)
    bad = bad + check("nelements == 22020096", nelements == 22020096)

    // nbytes must be the PACKED size: 144 bytes per 256-value super-block.
    let nbytes = gguf_tensor_nbytes(idx)
    let want_bytes = (nelements / 256) * 144
    bad = bad + check("nbytes is packed Q4_K size", nbytes == want_bytes)

    // ---- Q4_K dequantisation --------------------------------------------
    let raw = gguf_read_tensor(idx)
    if raw == 0 {
        print("read failed\n")
        return 1
    }
    let out = mem_alloc(256 * 8)
    dequant_q4k(raw, 256, out)

    let i = 0
    let dq_bad = 0
    while i < 256 {
        let got = f64bits(mem_load(out + i * 8))
        if got != ref_bits(i) {
            dq_bad = dq_bad + 1
        }
        i = i + 1
    }
    bad = bad + check("Q4_K block 0: 256/256 values bit-exact", dq_bad == 0)

    // ---- matvec (f64, row-major, y = A * x) ------------------------------
    // A = [[1,2],[3,4]] as f64 => 4 slots of 8 bytes.
    let A = mem_alloc(32)
    mem_store(A, 1.0)
    mem_store(A + 8, 2.0)
    mem_store(A + 16, 3.0)
    mem_store(A + 24, 4.0)

    let x = mem_alloc(16)
    mem_store(x, 5.0)
    mem_store(x + 8, 6.0)

    let y = mem_alloc(16)
    gguf_matvec(A, x, 2, 2, y)

    let y0 = mem_load(y)
    let y1 = mem_load(y + 8)
    print("matvec y[0]=")
    printi(f64bits(f64of(y0)))
    print(" y[1]=")
    printi(f64bits(f64of(y1)))
    print("\n")
    bad = bad + check("matvec y[0] == 17.0", f64bits(y0) == 4625478292286210048)
    bad = bad + check("matvec y[1] == 39.0", f64bits(y1) == 4630685579355357184)

    // ---- softmax (f64) ---------------------------------------------------
    // 3 f64 values need 24 bytes, not the 12 the old test allocated.
    let inp = mem_alloc(24)
    mem_store(inp, 1.0)
    mem_store(inp + 8, 2.0)
    mem_store(inp + 16, 3.0)

    let sout = mem_alloc(24)
    gguf_softmax(sout, inp, 3)

    let s0 = f64of(mem_load(sout))
    let s1 = f64of(mem_load(sout + 8))
    let s2 = f64of(mem_load(sout + 16))
    print("softmax: ")
    printi(f64bits(s0))
    print(" ")
    printi(f64bits(s1))
    print(" ")
    printi(f64bits(s2))
    print("\n")

    // softmax must sum to 1 and be monotonically ordered.
    let sum = s0 + s1 + s2
    let sum_err = sum - 1.0
    if sum_err < 0.0 { sum_err = 0.0 - sum_err }
    print("softmax sum: ")
    printi(f64bits(sum))
    print("\n")
    bad = bad + check("softmax sums to 1", sum_err < 1.0e-12)
    bad = bad + check("softmax is descending", s0 < s1 && s1 < s2)

    gguf_close()

    if bad != 0 {
        print("FAILED checks: ")
        print(bad)
        print("\n")
        return 1
    }
    print("PASS: inference path (Q4_K dequant, matvec, softmax)\n")
    return 0
}