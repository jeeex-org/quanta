import std/fs

fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    // Read header
    let hdr = mem_alloc(24)
    file_read(fd, hdr, 24)
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Read metadata + tensor info in one pass
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let tensor_count = 0
    let i = 0
    
    while i < n_kv && tensor_count < n_tensors {
        read_raw(fd, klen_buf, 8)
        let klen = mem_load(klen_buf)
        
        // Sanity check
        if klen > 10000 {
            print("BAD klen at i=")
            print(i)
            print("\n")
            i = n_kv
        } else {
            // Read key
            let key = mem_alloc(klen + 1)
            read_raw(fd, key, klen)
            mem_store8(key + klen, 0)
            
            // Read value type (or tensor dtype if this is a tensor info)
            read_raw(fd, vtype_buf, 4)
            let vtype = mem_load(vtype_buf)
            
            // Check if this is a tensor info entry
            // Tensor names start with "blk.", "token_embd", "output", "token_embd_norm"
            let is_tensor = 0
            if klen > 4 {
                let first4 = mem_load(key)
                // "blk." = 0x2e6b6c62
                if first4 == 0x2e6b6c62 { is_tensor = 1 }
                // "toke" = 0x656b6f74
                if first4 == 0x656b6f74 { is_tensor = 1 }
                // "outp" = 0x7074756f
                if first4 == 0x7074756f { is_tensor = 1 }
            }
            
            if is_tensor == 1 {
                // This is a tensor info entry
                // vtype is actually the tensor dtype
                let dtype = vtype
                
                // Read ndims (4 bytes)
                let ndims_buf = mem_alloc(4)
                read_raw(fd, ndims_buf, 4)
                let ndims = mem_load(ndims_buf)
                
                // Read dims (ndims * 8 bytes)
                let d = 0
                while d < ndims {
                    let dim_buf = mem_alloc(8)
                    read_raw(fd, dim_buf, 8)
                    d = d + 1
                }
                
                // Skip dtype (4 bytes) - we already have it
                // Actually the format is: name + dtype + ndims + dims + offset
                // We read name, then dtype (as vtype), then ndims, then dims
                // Now read offset (8 bytes)
                let off_buf = mem_alloc(8)
                read_raw(fd, off_buf, 8)
                let offset = mem_load(off_buf)
                
                // Print tensor info
                print("tensor[")
                print(tensor_count)
                print("] name=")
                write_raw(1, key, klen)
                print(" dtype=")
                print(dtype)
                print(" ndims=")
                print(ndims)
                print(" offset=")
                print(offset)
                print("\n")
                
                tensor_count = tensor_count + 1
            } else {
                // This is a real metadata pair, skip the value
                if vtype == 8 {
                    read_raw(fd, klen_buf, 8)
                    lseek(fd, mem_load(klen_buf), 1)
                } else if vtype == 9 {
                    read_raw(fd, vtype_buf, 4)
                    let atype = mem_load(vtype_buf)
                    read_raw(fd, klen_buf, 8)
                    let alen = mem_load(klen_buf)
                    if atype == 8 {
                        let j = 0
                        while j < alen {
                            read_raw(fd, klen_buf, 8)
                            lseek(fd, mem_load(klen_buf), 1)
                            j = j + 1
                        }
                    } else {
                        lseek(fd, alen * 4, 1)
                    }
                } else if vtype == 0 { lseek(fd, 1, 1) }
                else if vtype == 1 { lseek(fd, 1, 1) }
                else if vtype == 4 { lseek(fd, 4, 1) }
                else if vtype == 5 { lseek(fd, 4, 1) }
                else if vtype == 6 { lseek(fd, 4, 1) }
                else if vtype == 7 { lseek(fd, 1, 1) }
                else if vtype == 10 { lseek(fd, 8, 1) }
                else if vtype == 11 { lseek(fd, 8, 1) }
                else if vtype == 12 { lseek(fd, 8, 1) }
            }
            
            i = i + 1
        }
    }
    
    print("\nDone. tensor_count=")
    print(tensor_count)
    print("\n")
    
    close(fd)
    return 0
}