import std/fs
import std/gguf

fn main() {
    print("=== Full Inference with Token Embedding ===\n")
    
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { print("load failed\n"); return 1 }
    
    // Read token_embd.weight (Q6_K, 2048x128000)
    let token_embd_idx = gguf_find_tensor("token_embd.weight")
    let emb_nelem = gguf_tensor_nelements(token_embd_idx)
    print("emb_nelem=")
    print(emb_nelem)
    print("\n")
    
    // Dequant first 2048 elements (token 0)
    let emb_off = gguf_tensor_offset(token_embd_idx)
    let raw = mem_alloc(2048 * 210 / 256)
    lseek(gguf_fd, emb_off, 0)
    read_raw(gguf_fd, raw, 2048 * 210 / 256)
    
    let hidden = mem_alloc(2048 * 8)
    dequant_q6k(raw, 2048, hidden)
    
    print("hidden[0]=")
    print(mem_load(hidden))
    print(" hidden[1]=")
    print(mem_load(hidden + 8))
    print("\n")
    
    // Load FFN weights
    let ffn_norm_w = mem_alloc(2048 * 8)
    read_tensor_f64(gguf_find_tensor("blk.0.ffn_norm.weight"), ffn_norm_w)
    
    let gate_w = mem_alloc(10752 * 2048 * 8)
    read_tensor_f64(gguf_find_tensor("blk.0.ffn_gate.weight"), gate_w)
    
    let up_w = mem_alloc(10752 * 2048 * 8)
    read_tensor_f64(gguf_find_tensor("blk.0.ffn_up.weight"), up_w)
    
    let down_w = mem_alloc(2048 * 10752 * 8)
    read_tensor_f64(gguf_find_tensor("blk.0.ffn_down.weight"), down_w)
    
    // Run FFN
    transformer_ffn(0, hidden, ffn_norm_w, gate_w, up_w, down_w)
    
    print("after FFN: hidden[0]=")
    print(mem_load(hidden))
    print("\n")
    
    print("SUCCESS\n")
    return 0
}

fn dequant_q6k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 210
        let scale = mem_load8(raw + bo) + mem_load8(raw + bo + 1) * 256
        let gi = 0
        while gi < 64 {
            let b0 = mem_load8(raw + bo + 2 + gi * 3)
            let b1 = mem_load8(raw + bo + 2 + gi * 3 + 1)
            let b2 = mem_load8(raw + bo + 2 + gi * 3 + 2)
            let q0 = b0 - (b0 / 64) * 64
            let q1 = (b0 / 64) + (b1 - (b1 / 16) * 16) * 4
            let q2 = (b1 / 16) + (b2 - (b2 / 4) * 4) * 16
            let q3 = b2 / 4
            mem_store(out + (bi * 256 + gi * 4) * 8, scale * q0 / 63)
            mem_store(out + (bi * 256 + gi * 4 + 1) * 8, scale * q1 / 63)
            mem_store(out + (bi * 256 + gi * 4 + 2) * 8, scale * q2 / 63)
            mem_store(out + (bi * 256 + gi * 4 + 3) * 8, scale * q3 / 63)
            gi = gi + 1
        }
        bi = bi + 1
    }
}

fn read_tensor_f64(idx, buf) {
    let dtype = gguf_tensor_dtype(idx)
    let offset = gguf_tensor_offset(idx)
    let nelem = gguf_tensor_nelements(idx)
    if dtype == 0 {
        let raw = mem_alloc(nelem * 4)
        lseek(gguf_fd, offset, 0)
        read_raw(gguf_fd, raw, nelem * 4)
        let i = 0
        while i < nelem {
            mem_store(buf + i * 8, f32_to_f64(raw + i * 4))
            i = i + 1
        }
    } else if dtype == 12 {
        let raw = mem_alloc(nelem * 144 / 256)
        lseek(gguf_fd, offset, 0)
        read_raw(gguf_fd, raw, nelem * 144 / 256)
        dequant_q4k(raw, nelem, buf)
    } else if dtype == 14 {
        let raw = mem_alloc(nelem * 210 / 256)
        lseek(gguf_fd, offset, 0)
        read_raw(gguf_fd, raw, nelem * 210 / 256)
        dequant_q6k(raw, nelem, buf)
    }
}

fn f32_to_f64(ptr) {
    let b0 = mem_load8(ptr)
    let b1 = mem_load8(ptr + 1)
    let b2 = mem_load8(ptr + 2)
    let b3 = mem_load8(ptr + 3)
    let sign = i2f(b3 / 128)
    let exp32 = i2f(b3 - (b3 / 128) * 128) * i2f(2) + i2f(b2 / 128)
    let mant32 = i2f(b2 - (b2 / 128) * 128) * i2f(65536) + i2f(b1) * i2f(256) + i2f(b0)
    if exp32 == i2f(0) { return i2f(0) }
    if exp32 == i2f(255) { return i2f(0) }
    let new_exp = f2i(exp32 - i2f(127))
    let mant_frac = fdiv(mant32, i2f(8388608))
    let one_plus_mant = fadd(i2f(1), mant_frac)
    let pow2 = i2f(1)
    let i = 0
    if new_exp >= 0 {
        while i < new_exp { pow2 = fmul(pow2, i2f(2)); i = i + 1 }
    } else {
        let neg = 0 - new_exp
        while i < neg { pow2 = fdiv(pow2, i2f(2)); i = i + 1 }
    }
    let result = fmul(pow2, one_plus_mant)
    if sign == i2f(1) { result = fsub(i2f(0), result) }
    return result
}

fn dequant_q4k(raw, nelements, out) {
    let n_blocks = nelements / 256
    let bi = 0
    while bi < n_blocks {
        let bo = bi * 144
        let scale = mem_load8(raw + bo) + mem_load8(raw + bo + 1) * 256
        let vi = 0
        while vi < 256 {
            let byte_val = mem_load8(raw + bo + 8 + vi / 2)
            let nibble = 0
            if vi - (vi / 2) * 2 == 0 { nibble = byte_val / 16 }
            else { nibble = byte_val - (byte_val / 16) * 16 }
            mem_store(out + (bi * 256 + vi) * 8, scale * nibble / 15)
            vi = vi + 1
        }
        bi = bi + 1
    }
}

fn rms_norm(out, x, w, n) {
    let ms = i2f(0)
    let i = 0
    while i < n {
        let v = mem_load(x + i * 8)
        ms = fadd(ms, fmul(v, v))
        i = i + 1
    }
    ms = fdiv(ms, i2f(n))
    let ir = fdiv(i2f(1), sqrt(fadd(ms, i2f(1))))
    i = 0
    while i < n {
        mem_store(out + i * 8, fmul(fmul(mem_load(x + i * 8), ir), mem_load(w + i * 8)))
        i = i + 1
    }
}

fn matvec(A, x, rows, cols, y) {
    let i = 0
    while i < rows {
        let sum = i2f(0)
        let j = 0
        while j < cols {
            sum = fadd(sum, fmul(mem_load(A + (i * cols + j) * 8), mem_load(x + j * 8)))
            j = j + 1
        }
        mem_store(y + i * 8, sum)
        i = i + 1
    }
}

fn swiglu(out, x, y, n) {
    let i = 0
    while i < n {
        let xv = mem_load(x + i * 8)
        let yv = mem_load(y + i * 8)
        let neg_x = fsub(i2f(0), xv)
        let sig = fdiv(i2f(1), fadd(i2f(1), pow(i2f(2), neg_x)))
        mem_store(out + i * 8, fmul(fmul(xv, sig), yv))
        i = i + 1
    }
}

fn vec_add(out, a, b, n) {
    let i = 0
    while i < n {
        mem_store(out + i * 8, fadd(mem_load(a + i * 8), mem_load(b + i * 8)))
        i = i + 1
    }
}

fn transformer_ffn(layer_idx, hidden, norm_weight, gate_weight, up_weight, down_weight) {
    let n_hidden = 2048
    let n_intermediate = 10752
    let normed = mem_alloc(n_hidden * 8)
    rms_norm(normed, hidden, norm_weight, n_hidden)
    let gate = mem_alloc(n_intermediate * 8)
    matvec(gate_weight, normed, n_intermediate, n_hidden, gate)
    let up = mem_alloc(n_intermediate * 8)
    matvec(up_weight, normed, n_intermediate, n_hidden, up)
    let activated = mem_alloc(n_intermediate * 8)
    swiglu(activated, gate, up, n_intermediate)
    let out = mem_alloc(n_hidden * 8)
    matvec(down_weight, activated, n_hidden, n_intermediate, out)
    vec_add(hidden, hidden, out, n_hidden)
}