import std/fs
import std/gguf

fn main() {
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { print("load failed\n"); return 1 }
    
    print("n_tensors: ")
    print(gguf_num_tensors())
    print("\n")
    
    // Print first 5 tensors
    let i = 0
    while i < 5 {
        print("[")
        print(i)
        print("] dtype=")
        print(gguf_tensor_dtype(i))
        print(" off=")
        print(gguf_tensor_offset(i))
        print(" ne=")
        print(gguf_tensor_nelements(i))
        print("\n")
        i = i + 1
    }
    
    gguf_close()
    return 0
}