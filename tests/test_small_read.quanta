import std/fs

// Read file, print first value
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let buf = mem_alloc(256)
    print("allocated\n")
    
    let n = read_raw(fd, buf, 256)
    print("read n=")
    print(n)
    print("\n")
    
    let val = mem_load(buf + 8)
    print("val at 8=")
    print(val)
    print("\n")
    
    close(fd)
    return 0
}