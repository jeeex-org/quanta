import std/fs

fn main() {
    print("=== Debug Metadata Skip ===\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Skip all metadata
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let slen_buf = mem_alloc(8)
    let i = 0
    
    while i < n_kv {
        read_raw(fd, klen_buf, 8)
        let klen = mem_load(klen_buf)
        lseek(fd, klen, 1)
        
        read_raw(fd, vtype_buf, 4)
        let vtype = mem_load(vtype_buf)
        
        if vtype == 0 { lseek(fd, 1, 1) }
        else if vtype == 1 { lseek(fd, 1, 1) }
        else if vtype == 2 { lseek(fd, 2, 1) }
        else if vtype == 3 { lseek(fd, 2, 1) }
        else if vtype == 4 { lseek(fd, 4, 1) }
        else if vtype == 5 { lseek(fd, 4, 1) }
        else if vtype == 6 { lseek(fd, 4, 1) }
        else if vtype == 7 { lseek(fd, 1, 1) }
        else if vtype == 8 {
            read_raw(fd, slen_buf, 8)
            lseek(fd, mem_load(slen_buf), 1)
        } else if vtype == 9 {
            read_raw(fd, vtype_buf, 4)
            read_raw(fd, slen_buf, 8)
            let alen = mem_load(slen_buf)
            let etype = mem_load(vtype_buf)
            let esize = 1
            if etype == 4 || etype == 5 || etype == 6 { esize = 4 }
            lseek(fd, alen * esize, 1)
        }
        
        i = i + 1
    }
    
    // Check current position by reading first 8 bytes
    let test = mem_alloc(8)
    read_raw(fd, test, 8)
    
    print("after metadata: bytes=")
    let j = 0
    while j < 8 {
        print(mem_load8(test + j))
        print(" ")
        j = j + 1
    }
    print("\n")
    
    // Try to read first tensor name length
    let nlen_buf2 = mem_alloc(8)
    read_raw(fd, nlen_buf2, 8)
    print("first nlen: ")
    print(mem_load(nlen_buf2))
    print("\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}