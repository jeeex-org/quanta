import std/fs

// Fix: handle vtype=2 (int16) and proper array skip
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let i = 0
    let klen = 0
    let vtype = 0
    
    // Skip first 37 metadata pairs with ALL vtypes handled
    while i < 37 {
        read_raw(fd, klen_buf, 8)
        klen = mem_load(klen_buf)
        lseek(fd, klen, 1)
        read_raw(fd, vtype_buf, 4)
        vtype = mem_load(vtype_buf)
        
        // Handle ALL value types
        if vtype == 0 { lseek(fd, 1, 1) }      // uint8
        else if vtype == 1 { lseek(fd, 1, 1) }  // int8
        else if vtype == 2 { lseek(fd, 2, 1) }  // uint16
        else if vtype == 3 { lseek(fd, 2, 1) }  // int16
        else if vtype == 4 { lseek(fd, 4, 1) }  // uint32
        else if vtype == 5 { lseek(fd, 4, 1) }  // int32
        else if vtype == 6 { lseek(fd, 4, 1) }  // float32
        else if vtype == 7 { lseek(fd, 1, 1) }  // bool
        else if vtype == 8 {                     // string
            read_raw(fd, klen_buf, 8)
            lseek(fd, mem_load(klen_buf), 1)
        } else if vtype == 9 {                    // array
            lseek(fd, 4, 1)  // atype
            read_raw(fd, klen_buf, 8)  // alen
            let alen = mem_load(klen_buf)
            // For numeric arrays, skip alen * elem_size
            // For string arrays, need to skip each string individually
            // Approximate: skip alen * 8 (pointers) then read each string
            let j = 0
            while j < alen {
                read_raw(fd, klen_buf, 8)
                lseek(fd, mem_load(klen_buf), 1)
                j = j + 1
            }
        } else if vtype == 10 { lseek(fd, 8, 1) } // uint64
        else if vtype == 11 { lseek(fd, 8, 1) }   // int64
        else if vtype == 12 { lseek(fd, 8, 1) }   // float64
        
        i = i + 1
    }
    
    print("skipped 37\n")
    
    // Read first tensor
    let nlen_buf = mem_alloc(8)
    read_raw(fd, nlen_buf, 8)
    let nlen = mem_load(nlen_buf)
    print("nlen=")
    print(nlen)
    print("\n")
    
    let name = mem_alloc(256)
    read_raw(fd, name, nlen)
    print("name: ")
    write_raw(1, name, nlen)
    print("\n")
    
    let ndims_buf = mem_alloc(4)
    read_raw(fd, ndims_buf, 4)
    let ndims = mem_load(ndims_buf)
    print("ndims=")
    print(ndims)
    print("\n")
    
    let dim_buf = mem_alloc(8)
    let d = 0
    while d < ndims {
        read_raw(fd, dim_buf, 8)
        d = d + 1
    }
    
    let dtype_buf = mem_alloc(4)
    read_raw(fd, dtype_buf, 4)
    
    let off_buf = mem_alloc(8)
    read_raw(fd, off_buf, 8)
    
    print("SUCCESS\n")
    close(fd)
    return 0
}