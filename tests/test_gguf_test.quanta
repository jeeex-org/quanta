import std/fs
import std/gguf

fn main() {
    print("=== GGUF Test ===\n")
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    print("rc=")
    print(rc)
    print("\n")
    if rc == 0 {
        print("n_tensors: ")
        print(gguf_num_tensors())
        print("\n")
        gguf_print_info()
    }
    return 0
}