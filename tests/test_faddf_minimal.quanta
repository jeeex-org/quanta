import std/fs

// Minimal faddf test
fn main() {
    let a = i2f(1)
    let b = i2f(2)
    let r = faddf(a, b)
    
    print("i2f(1)=")
    print(a)
    print("\n")
    print("i2f(2)=")
    print(b)
    print("\n")
    print("faddf(i2f(1), i2f(2))=")
    print(r)
    print("\n")
    print("i2f(3)=")
    print(i2f(3))
    print("\n")
    
    if r == i2f(3) { print("MATCH\n"); return 0 }
    print("MISMATCH\n")
    return 1
}