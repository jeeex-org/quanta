import std/fs

// Minimal faddf test
fn main() {
    let a = i2f(1)
    let b = i2f(2)
    let r = faddf(a, b)
    
    print("i2f(1)=")
    printi(f64bits(a))
    print("\n")
    print("i2f(2)=")
    printi(f64bits(b))
    print("\n")
    print("faddf(i2f(1), i2f(2))=")
    printi(f64bits(r))
    print("\n")
    print("i2f(3)=")
    printi(f64bits(i2f(3)))
    print("\n")
    
    if r == i2f(3) { print("MATCH\n"); return 0 }
    print("MISMATCH\n")
    return 1
}