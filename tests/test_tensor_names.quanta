// Tensor-name enumeration via gguf_tensor_name_str().
//
// gguf_tensor_name() returns a RAW C pointer into the mmap'd header region. That
// is fine for byte comparison -- it is how gguf_find_tensor matches -- but it is
// not a string: printing it emits an address ("name@140353555505152"), and it
// carries no length prefix, so len() on it reads the 8 bytes preceding it. The
// weight table has to key on real strings, which is what this test exercises.
//
// Checks:
//   - every one of the 266 descriptors materialises a non-empty string;
//   - each body is NUL-terminated at exactly its reported length;
//   - all names are distinct (a duplicate would make the table ambiguous);
//   - a known name round-trips byte-for-byte and find_tensor agrees.
//
//   Q4 model: /opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf
//
// Exit 0 = all names materialised cleanly.

import std/gguf

const Q4_PATH = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"

let failures = 0

fn fail(msg) {
    print("FAIL: ", msg, "\n")
    failures = failures + 1
}

// Byte-compare a materialised string's body against raw bytes at `b`, for `n`
// bytes. Both sides are handled as raw bytes so no string is ever passed as a
// parameter (a string parameter is an opaque pointer in Quanta).
fn body_equals(s, b, n) {
    let i = 0
    while i < n {
        if mem_load8(s + 8 + i) != mem_load8(b + i) { return 0 }
        i = i + 1
    }
    return 1
}

fn main() {
    print("=== tensor name enumeration ===\n")
    if gguf_load(Q4_PATH) < 0 { print("FAIL: cannot open model\n"); return 1 }

    let n = gguf_num_tensors()
    print("  tensors=", n, "\n")
    if n != 266 { fail("expected 266 tensors") }

    let names = mem_alloc(n * 8)
    let lens = mem_alloc(n * 8)
    let total = 0
    let empty = 0
    let unterm = 0
    let i = 0
    while i < n {
        let s = gguf_tensor_name_str(i)
        let l = gguf_tensor_name_len(i)
        if s == 0 || l == 0 { empty = empty + 1 }
        // The body must be NUL-terminated at exactly l. A mismatch means the
        // length scan overran into the next descriptor's name.
        if s != 0 && mem_load8(s + 8 + l) != 0 { unterm = unterm + 1 }
        mem_store(names + i * 8, s)
        mem_store(lens + i * 8, l)
        total = total + l
        i = i + 1
    }
    print("  materialised=", n, " total_name_bytes=", total, "\n")
    if empty > 0 { print("FAIL: ", empty, " names were empty\n"); failures = failures + 1 }
    if unterm > 0 { print("FAIL: ", unterm, " names not NUL-terminated at their length\n"); failures = failures + 1 }

    // Distinctness. 266^2/2 = 35k byte comparisons over short names; cheap.
    let dup = 0
    i = 0
    while i < n {
        let j = i + 1
        while j < n {
            let li = mem_load(lens + i * 8)
            if li == mem_load(lens + j * 8) {
                if body_equals(mem_load(names + i * 8), mem_load(names + j * 8) + 8, li) == 1 { dup = dup + 1 }
            }
            j = j + 1
        }
        i = i + 1
    }
    print("  duplicate_pairs=", dup, "\n")
    if dup > 0 { fail("tensor names are not unique") }

    // prints() takes a real string, which is exactly what the materialiser is
    // for -- these lines could not be produced from gguf_tensor_name() at all.
    print("  first descriptors:\n")
    i = 0
    while i < 4 {
        prints("    ")
        prints(mem_load(names + i * 8))
        print("  len=", mem_load(lens + i * 8), "\n")
        i = i + 1
    }
    print("  last descriptor:\n    ")
    prints(mem_load(names + (n - 1) * 8))
    print("  len=", mem_load(lens + (n - 1) * 8), "\n")

    // Round-trip: the materialised bytes equal the literal, and find_tensor on
    // the literal returns the same index.
    let idx0 = gguf_find_tensor("blk.0.ffn_gate.weight")
    if idx0 < 0 {
        fail("blk.0.ffn_gate.weight not found")
    } else {
        let want = "blk.0.ffn_gate.weight"
        let wl = len(want)
        if mem_load(lens + idx0 * 8) != wl {
            fail("round-trip length mismatch")
        } else {
            if body_equals(mem_load(names + idx0 * 8), want + 8, wl) == 0 { fail("round-trip bytes mismatch") }
        }
        prints("  round-trip ok: ")
        prints(mem_load(names + idx0 * 8))
        print(" len=", wl, " idx=", idx0, "\n")
    }

    gguf_close()

    print("\n")
    if failures > 0 {
        print("test_tensor_names: ", failures, " FAILURES\n")
        return 1
    }
    print("test_tensor_names: all pass\n")
    return 0
}