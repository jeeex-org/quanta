import std/fs

fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let hdr = mem_alloc(24)
    file_read(fd, hdr, 24)
    
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Skip metadata
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let i = 0
    while i < n_kv {
        read_raw(fd, klen_buf, 8)
        let klen = mem_load(klen_buf)
        if klen > 100000 {
            print("end at kv ")
            print(i)
            print("\n")
            i = n_kv
        } else {
            lseek(fd, klen, 1)
            read_raw(fd, vtype_buf, 4)
            let vtype = mem_load(vtype_buf)
            if vtype == 8 {
                read_raw(fd, klen_buf, 8)
                lseek(fd, mem_load(klen_buf), 1)
            } else if vtype == 9 {
                read_raw(fd, klen_buf, 8)  // atype
                read_raw(fd, klen_buf, 8)  // alen
                let alen = mem_load(klen_buf)
                lseek(fd, alen * 4, 1)
            } else if vtype == 0 { lseek(fd, 1, 1) }
            else if vtype == 1 { lseek(fd, 1, 1) }
            else if vtype == 10 { lseek(fd, 8, 1) }
            else if vtype == 11 { lseek(fd, 8, 1) }
            else if vtype == 12 { lseek(fd, 8, 1) }
            i = i + 1
        }
    }
    
    let meta_end = lseek(fd, 0, 1)
    print("meta_end=")
    print(meta_end)
    print("\n")
    
    // Read raw bytes at current position to see what's there
    let scan = mem_alloc(32)
    read_raw(fd, scan, 32)
    print("Raw bytes at meta_end: ")
    i = 0
    while i < 32 {
        print(mem_load8(scan + i))
        print(" ")
        i = i + 1
    }
    print("\n")
    
    // Now try seeking to meta_end + 80
    lseek(fd, meta_end + 80, 0)
    read_raw(fd, scan, 32)
    print("Raw bytes at meta_end+80: ")
    i = 0
    while i < 32 {
        print(mem_load8(scan + i))
        print(" ")
        i = i + 1
    }
    print("\n")
    
    close(fd)
    return 0
}