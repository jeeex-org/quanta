// read_tensor_f64() dispatch across every dtype the loader must support:
// F32 (0), F16 (1), Q4_K (12), Q6_K (14).
//
// This is a LOADER test, not a dequant test. dequant_f16/dequant_f32/
// dequant_q4k/dequant_q6k each have their own oracle coverage; what is
// unverified here is the dispatch and byte-count plumbing that feeds them:
//
//   - that read_tensor_f64() reaches each branch at all (it previously
//     dispatched on gguf_type_size(), which returns 1 for BOTH F32 and F16 and
//     so matched no branch at all, silently loading nothing);
//   - that it seeks to data_start + relative offset (the pre-fix version used
//     bare `offset`, landing 8239136 bytes early);
//   - that gguf_tensor_nbytes() is the right read length for the k-quants,
//     rather than an inline nelem*144/256 that cannot express a partial block.
//
// Only one model may be open at a time (gguf_* state is global), so this test
// cannot compare a quantised tensor against its unquantised twin directly. It
// instead prints a summary of each tensor -- first values plus sum/sumsq/min/max
// -- which scripts/audit/read_formats_oracle.py reproduces independently from the
// file with Python. That comparison is the real assertion; the values printed here
// are the evidence.
//
//   Q4 model: /opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf
//   F16 ref:  /opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1.gguf
//
// Exit 0 = dispatch reached every branch and no NaN/Inf was produced.
//
// 0.0.225: this file previously carried two workarounds for compiler defects
// that are now fixed, both noted inline below -- const paths (which evaluated to
// the integer 0 and segfaulted) and single-argument print() calls (which silently
// dropped every non-string argument). Both are gone, so this file now exercises
// const strings and variadic print against the real loader path.

import std/gguf
import std/math

const Q4_PATH = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf"
const F16_PATH = "/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1.gguf"
const Q5Q8_PATH = "/opt/ai/models/quanta/QUANTA-GW38-27B-IQ4.gguf"
const Q40_PATH = "/opt/ai/models/quanta/QUANTA-GG4-30B-Q4KXL.gguf"
const BF16_PATH = "/opt/ai/models/quanta/QUANTA-GG4-E4B-Q4_K_M.gguf"

let failures = 0

// NOTE: three print arguments, not two. `print(a, b)` with two arguments is the
// documented print(buf, len) raw-byte-dump alias (see prints_family.quanta), so
// a two-argument call is NOT variadic. Three or more is.
fn fail(msg) {
    print("FAIL: ", msg, "\n")
    failures = failures + 1
}

// Load one tensor and report its shape, dtype, and value summary.
//
// `nelem_full` is the tensor's real element count, used for the read length.
// `nprobe` is the number of leading elements to summarise, which may be fewer:
// a full blk.0.ffn_gate.weight expands to 176 MB of f64 and its 22M-element
// reduction is minutes of work, which is the dequant harness's job, not the
// loader-dispatch test's. Reading a prefix still proves the dispatch branch ran
// and produced finite values at the right offset.
fn probe(idx, nelem_full, nprobe) {
    let dt = gguf_tensor_dtype(idx)
    let nb = gguf_tensor_nbytes(idx)

    print("      dtype=", dt, " nelem=", gguf_tensor_nelements(idx), " nbytes=", nb, "\n")

    let buf = mem_alloc(nelem_full * 8)
    // 1/0 success flag -- 0 means unsupported dtype or read failure.
    let r = read_tensor_f64(idx, buf)
    if r == 0 {
        print("FAIL: read_tensor_f64 returned 0 (unsupported dtype ", dt, ")\n")
        failures = failures + 1
        mem_free(buf)
        return
    }
    let sum = 0.0
    let sumsq = 0.0
    let mn = 0.0
    let mx = 0.0
    let bad = 0
    let i = 0
    while i < nprobe {
        // mem_load() returns the raw 8 bytes as an INTEGER; f64of() turns a
        // stored binary64 back into a number. Without it every comparison and
        // sum below is integer arithmetic on bit patterns.
        let v = f64of(mem_load(buf + i * 8))
        if v != v { bad = bad + 1 }                  // NaN
        if v > 1e300 || v < -1e300 { bad = bad + 1 } // Inf
        sum = sum + v
        sumsq = sumsq + v * v
        if i == 0 { mn = v; mx = v }
        if v < mn { mn = v }
        if v > mx { mx = v }
        i = i + 1
    }
    if bad > 0 {
        print("FAIL: ", bad, " NaN/Inf of ", nprobe, "\n")
        failures = failures + 1
    }
    print("      first: ")
    i = 0
    while i < 6 {
        if i < nprobe { pf64(f64of(mem_load(buf + i * 8))); print(" ") }
        i = i + 1
    }
    // Floats go through pf64(), NOT print(): a bare float argument prints its
    // raw bit pattern (1.5 came out as 4609434218613702656) because the lowered
    // single-argument path does not apply the 1-arg emitter's vfloat tag.
    print("\n      sum="); pf64(sum)
    print(" sumsq="); pf64(sumsq)
    print(" min="); pf64(mn)
    print(" max="); pf64(mx)
    print("\n")
    mem_free(buf)
}

// Report the tensor count / kv count for whichever model is open, and check the
// descriptor count. The model is named by `path` purely so the failure line says
// which one failed.
fn report_counts(path) {
    print("  tensors=", gguf_num_tensors(), " kv=", gguf_num_kv(), "\n")
    if gguf_num_tensors() != 266 { fail(path) }
    if gguf_num_kv() != 37 { fail(path) }
}

// absf does not exist in std/math (only pf64 lives there), and this test must
// not import an extern C libm. Relative tolerance needs it.
fn ab(v: f64) -> f64 {
    if v < 0.0 { return 0.0 - v }
    return v
}

// Assert the reduction of the first `nprobe` elements against the independent
// Python oracle (scripts/audit/read_formats_oracle.py).
//
// This is the assertion that actually pins a dequantizer: `probe()` only proves
// the values are finite, so a dequantizer that returns the right SHAPE of wrong
// numbers would pass. The tolerance is relative, because f64 accumulation order
// differs between the two implementations.
fn check_oracle(idx, nelem_full, nprobe, exp_sum, exp_sumsq, exp_min, exp_max, label) {
    let buf = mem_alloc(nelem_full * 8)
    // 1/0 success flag -- 0 means unsupported dtype or read failure.
    let r = read_tensor_f64(idx, buf)
    if r == 0 {
        print("FAIL: ", label, " read_tensor_f64 returned 0\n")
        failures = failures + 1
        mem_free(buf)
        return
    }
    let sum = 0.0
    let sumsq = 0.0
    let mn = 0.0
    let mx = 0.0
    let i = 0
    while i < nprobe {
        let v = f64of(mem_load(buf + i * 8))
        sum = sum + v
        sumsq = sumsq + v * v
        if i == 0 { mn = v; mx = v }
        if v < mn { mn = v }
        if v > mx { mx = v }
        i = i + 1
    }
    mem_free(buf)

    // Relative tolerance: sums near zero need absolute slack, large sums need
    // proportional slack.
    let atol = 1e-4
    let rtol = 1e-6
    let ds = ab(sum - exp_sum)
    let dq = ab(sumsq - exp_sumsq)
    let dm = ab(mn - exp_min)
    let dx = ab(mx - exp_max)
    let ts = atol + rtol * ab(exp_sum)
    let tq = atol + rtol * ab(exp_sumsq)
    print("      got sum="); pf64(sum)
    print(" sumsq="); pf64(sumsq)
    print(" min="); pf64(mn)
    print(" max="); pf64(mx)
    print("\n")
    if ds > ts {
        print("FAIL: ", label, " sum off by "); pf64(ds); print("\n")
        failures = failures + 1
    }
    if dq > tq {
        print("FAIL: ", label, " sumsq off by "); pf64(dq); print("\n")
        failures = failures + 1
    }
    if dm > atol { print("FAIL: ", label, " min mismatch\n"); failures = failures + 1 }
    if dx > atol { print("FAIL: ", label, " max mismatch\n"); failures = failures + 1 }
}

fn main() {
    print("=== read_tensor_f64 dtype dispatch ===\n")

    print("-- Q4_K_M model (F32, Q4_K, Q6_K) --\n")
    if gguf_load(Q4_PATH) < 0 { print("FAIL: cannot open Q4 model\n"); return 1 }
    report_counts("Q4 model: wrong descriptor or kv count")

    // The tensor NAME is never passed into probe(). A string parameter in Quanta
    // is a raw pointer, not a usable string, so every gguf_find_tensor() call
    // runs here on a LITERAL and only the integer index is passed down. The
    // const strings above work because a const is materialised by the compiler,
    // not passed as a parameter.
    let i_norm = gguf_find_tensor("blk.0.ffn_norm.weight")
    let i_gate = gguf_find_tensor("blk.0.ffn_gate.weight")
    let i_down = gguf_find_tensor("blk.0.ffn_down.weight")
    let i_conv = gguf_find_tensor("blk.0.shortconv.conv.weight")
    let i_tenorm = gguf_find_tensor("token_embd_norm.weight")
    if i_norm < 0 || i_gate < 0 || i_down < 0 || i_conv < 0 || i_tenorm < 0 {
        print("FAIL: a required tensor was not found\n")
        return 1
    }

    print("  blk.0.ffn_norm.weight (F32)\n")
    probe(i_norm, 2048, 2048)

    print("  blk.0.ffn_gate.weight (Q4_K, 22020096 elems)\n")
    probe(i_gate, 2048 * 10752, 8192)

    print("  blk.0.ffn_down.weight (Q6_K)\n")
    // 4096 elements, matching the oracle's window for this tensor, so the two
    // sum/sumsq figures are directly comparable rather than over different
    // lengths.
    probe(i_down, 10752 * 2048, 4096)

    print("  blk.0.shortconv.conv.weight (F32, [3,2048])\n")
    probe(i_conv, 3 * 2048, 3 * 2048)

    print("  token_embd_norm.weight (F32)\n")
    probe(i_tenorm, 2048, 2048)
    gguf_close()

    print("-- F16 model (F16 branch) --\n")
    if gguf_load(F16_PATH) < 0 { print("FAIL: cannot open F16 model\n"); return 1 }
    report_counts("F16 model: wrong descriptor or kv count")

    // The F16 branch had NO coverage at all before this fix: read_tensor_f64
    // had no `dtype == 1` case, so every F16 model silently loaded nothing.
    let f_norm = gguf_find_tensor("blk.0.ffn_norm.weight")
    let f_gate = gguf_find_tensor("blk.0.ffn_gate.weight")
    let f_tenorm = gguf_find_tensor("token_embd_norm.weight")

    print("  blk.0.ffn_norm.weight (F32 cross-check)\n")
    probe(f_norm, 2048, 2048)

    print("  blk.0.ffn_gate.weight (F16)\n")
    probe(f_gate, 2048 * 10752, 8192)

    print("  token_embd_norm.weight (F32 cross-check)\n")
    probe(f_tenorm, 2048, 2048)
    gguf_close()

    // ---------------------------------------------------------------
    // Q5_K and Q8_0. These dtypes exist in NO LFM2 tensor, so they need a
    // model that actually carries them. Both live in QUANTA-GW38-27B-IQ4,
    // which also has Q4_K/Q6_K/IQ3_S/IQ4_XS -- so this load also proves the
    // branch dispatch is per-tensor dtype, not per-model.
    //
    // Expected values are NOT from the Python oracle. Two hand-written Python
    // transcriptions of Q5_K disagreed with each other on sum while agreeing on
    // min/max, so these come from scripts/audit/c_oracle.c, which calls the real
    // dequantize_row_q5_K / dequantize_row_q8_0 out of libggml-base. See the
    // script's header for why that indirection is load-bearing.
    print("-- Q5_K / Q8_0 model --\n")
    if gguf_load(Q5Q8_PATH) < 0 { print("FAIL: cannot open Q5_K/Q8_0 model\n"); return 1 }
    print("  tensors=", gguf_num_tensors(), " kv=", gguf_num_kv(), "\n")

    let q5a = gguf_find_tensor("blk.3.attn_k.weight")
    let q5b = gguf_find_tensor("blk.11.attn_k.weight")
    let q8a = gguf_find_tensor("blk.1.ssm_beta.weight")
    let q8b = gguf_find_tensor("blk.16.ssm_beta.weight")
    if q5a < 0 || q5b < 0 || q8a < 0 || q8b < 0 {
        print("FAIL: a required Q5_K/Q8_0 tensor was not found\n")
        return 1
    }

    print("  blk.3.attn_k.weight (Q5_K, [5120,1024])\n")
    //          sum        sumsq      min        max        window
    check_oracle(q5a, 5120 * 1024, 4096,
                 0.615401, 0.932176, -0.068733, 0.079718, "Q5_K blk.3.attn_k")
    print("  blk.11.attn_k.weight (Q5_K, second layer)\n")
    check_oracle(q5b, 5120 * 1024, 4096,
                 -0.303321, 0.725723, -0.056386, 0.066370, "Q5_K blk.11.attn_k")
    print("  blk.1.ssm_beta.weight (Q8_0, [5120,48])\n")
    check_oracle(q8a, 5120 * 48, 4096,
                 0.816602, 0.580516, -0.064434, 0.044934, "Q8_0 blk.1.ssm_beta")
    print("  blk.16.ssm_beta.weight (Q8_0, second)\n")
    check_oracle(q8b, 5120 * 48, 2048,
                 -1.099899, 0.334722, -0.076667, 0.061769, "Q8_0 blk.16.ssm_beta")

    // This model also carries IQ3_S (dtype 21, 75 tensors) and IQ4_XS
    // (dtype 23, 293 tensors). Neither is implemented natively, so both must
    // fail EXPLICITLY -- a silent zero-fill is indistinguishable from a real
    // all-zero tensor and would poison the forward pass.
    //
    // Note this also proves dispatch is per-tensor dtype, not per-model: one
    // file, five dtypes, four wired.
    let iq4 = gguf_find_tensor("blk.0.attn_qkv.weight")
    let iq3 = gguf_find_tensor("token_embd.weight")
    if iq4 < 0 { print("FAIL: IQ4_XS probe tensor missing\n"); return 1 }
    if iq3 < 0 { print("FAIL: IQ3_S probe tensor missing\n"); return 1 }
    if gguf_tensor_dtype(iq4) != 23 { print("FAIL: IQ4_XS probe is dtype ", gguf_tensor_dtype(iq4), "\n"); return 1 }
    if gguf_tensor_dtype(iq3) != 21 { print("FAIL: IQ3_S probe is dtype ", gguf_tensor_dtype(iq3), "\n"); return 1 }

    // gguf_tensor_supported() must let a caller refuse BEFORE allocating. Using
    // token_embd.weight (dtype 21, 1.27e9 elements) as the probe is deliberate:
    // materializing it as f64 would need 10.2 GB and blow the 6 GB scope, so
    // this also pins the check-ahead-of-allocation contract.
    if gguf_tensor_supported(iq3) != 0 {
        print("FAIL: IQ3_S (dtype 21) reports supported -- it is not implemented\n")
        failures = failures + 1
    }
    if gguf_tensor_supported(iq4) != 0 {
        print("FAIL: IQ4_XS (dtype 23) reports supported -- it is not implemented\n")
        failures = failures + 1
    }
    print("  IQ3_S (dtype 21, 1.27e9 elem) refused before allocating\n")
    print("  IQ4_XS (dtype 23) refused before allocating\n")

    // And the wired dtypes in the SAME file must still report supported and
    // read -- if the guard were too broad it would swallow everything.
    let okq = gguf_find_tensor("blk.3.attn_k.weight")
    if gguf_tensor_supported(okq) != 1 {
        print("FAIL: Q5_K does not report supported\n")
        failures = failures + 1
    }
    // read_tensor_f64 returns a 1/0 SUCCESS FLAG, not an element count.
    // A Q5_K [5120,1024] tensor reads 5242880 elements; do not assert on rok.
    let nok = gguf_tensor_nelements(okq)
    let bok = mem_alloc(nok * 8)
    let rok = read_tensor_f64(okq, bok)
    if rok != 1 { print("FAIL: Q5_K in the same file did not report success\n"); failures = failures + 1 }
    else { print("  Q5_K in the same file still reads (", nok, " elements)\n") }
    mem_free(bok)
    gguf_close()


// ------------------------------------------------------------ Q4_0 and BF16
//
// Neither LFM2 nor the 27B fixture uses these, so the fixtures are:
//   Q4_0  QUANTA-GG4-30B-Q4KXL.gguf  blk.5.attn_k.weight [5376,2048] = 11,010,048 elems
//   BF16  QUANTA-GG4-E4B-Q4_K_M.gguf per_layer_model_proj.weight [2560,10752] = 27,525,120
//
// Expected values come from scripts/audit/c_oracle.c, which calls the real
// dequantize_row_q4_0 out of libggml-base and widens BF16 as fp32 << 16.

if gguf_load(Q40_PATH) < 0 { fail("cannot open Q4_0 model") }
{
    let q40 = gguf_find_tensor("blk.5.attn_k.weight")
    if q40 == -1 { fail("Q4_0 tensor not found") }
    else {
        if gguf_tensor_supported(q40) != 1 { fail("Q4_0 dtype not reported supported") }
        // check_oracle allocates the WHOLE tensor by design, so the read length
        // comes from gguf_tensor_nbytes() rather than hand arithmetic that
        // could be wrong independently of the dequantizer.
        print("  loaded Q4_0 model, probing...\n")
        check_oracle(q40, 11010048, 11010048,
                     -781.592564, 1960.441500, -0.135376, 0.134583, "Q4_0 blk.5.attn_k")
        print("  Q4_0 probe done\n")
    }
}
gguf_close()

if gguf_load(BF16_PATH) < 0 { fail("cannot open BF16 model") }
{
    let bf = gguf_find_tensor("per_layer_model_proj.weight")
    if bf == -1 { fail("BF16 tensor not found") }
    else {
        if gguf_tensor_supported(bf) != 1 { fail("BF16 dtype not reported supported") }
        check_oracle(bf, 27525120, 10240,
                     -0.511763, 6.810468, -0.121582, 0.100586, "BF16 per_layer_model_proj")
    }
}
gguf_close()


    print("\n")
    if failures > 0 {
        print("test_read_formats: ", failures, " FAILURES\n")
        return 1
    }
    print("test_read_formats: all pass\n")
    return 0
}