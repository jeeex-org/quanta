import std/fs

// Direct faddf test with debug
fn main() {
    let a = i2f(1)
    let b = i2f(2)
    
    // Test fadd with float args
    let r1 = fadd(a, b)
    print("fadd(i2f(1), i2f(2))=")
    print(r1)
    print(" (expect 3)\n")
    
    // Test fadd with integer args  
    let r2 = fadd(1, 2)
    print("fadd(1,2)=")
    print(r2)
    print(" (expect 3)\n")
    
    // Test faddf with float args
    let r3 = faddf(a, b)
    print("faddf(i2f(1), i2f(2))=")
    print(r3)
    print(" (expect i2f(3)=")
    print(i2f(3))
    print(")\n")
    
    // Check equality
    print("r3 == i2f(3): ")
    if r3 == i2f(3) { print("YES\n") } else { print("NO\n") }
    print("r3 == i2f(2): ")
    if r3 == i2f(2) { print("YES\n") } else { print("NO\n") }
    
    return 0
}