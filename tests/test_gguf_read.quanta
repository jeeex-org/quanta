import std/fs

// Test: can we read the GGUF file at all?
fn main() {
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let buf = mem_alloc(256)
    let n = file_read(fd, buf, 256)
    
    print("read ")
    print(n)
    print(" bytes\n")
    
    if n < 24 { return 1 }
    
    let magic = mem_load8(buf)
    print("magic=")
    print(magic)
    print("\n")
    
    close(fd)
    return 0
}