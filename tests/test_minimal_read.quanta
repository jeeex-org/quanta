import std/fs

fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    print("reading magic...\n")
    let magic_buf = mem_alloc(4)
    read_raw(fd, magic_buf, 4)
    print("magic read\n")
    
    print("done\n")
    close(fd)
    return 0
}