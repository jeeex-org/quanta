import std/fs

// Optimized Q4_K matmul using a custom q4k_dot builtin
// This eliminates per-element dequantization loops

// q4k_dot(Q4_block_ptr, x_ptr, sub_scales_ptr, n_blocks)
// Computes dot product of one Q4_K row against x
// Args: rdi=block_ptr, rsi=x_ptr, rdx=sub_scales_ptr (in weights), rcx=n_blocks
// Returns: sum in rax

// Since we can't easily add new builtins right now, let's optimize
// by reducing the inner loop overhead

// Simple test: just measure raw integer matmul speed
fn main() {
    let N = 2048
    let A = mem_alloc(N * N * 8)
    let x = mem_alloc(N * 8)
    let y = mem_alloc(N * 8)
    
    // Initialize
    let i = 0
    while i < N * N {
        mem_store(A + i * 8, i2f(i % 100 - 50))
        i = i + 1
    }
    i = 0
    while i < N {
        mem_store(x + i * 8, i2f(1))
        i = i + 1
    }
    
    // Run matmul once
    i = 0
    while i < N {
        let sum = i2f(0)
        let j = 0
        while j < N {
            sum = fadd(sum, fmul(mem_load(A + (i * N + j) * 8), mem_load(x + j * 8)))
            j = j + 1
        }
        mem_store(y + i * 8, sum)
        i = i + 1
    }
    
    print("result[0]=")
    print(mem_load(y))
    print("\n")
    return 0
}