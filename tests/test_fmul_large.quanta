import std/fs

fn main() {
    let a = i2f(5)
    let b = i2f(10)
    print("i2f(5)="); printi(f64bits(a)); print("\n")
    print("i2f(10)="); printi(f64bits(b)); print("\n")
    
    let m = fmulf(a, b)
    print("fmulf(a,b)="); printi(f64bits(m)); print("\n")
    print("expected i2f(50)="); printi(f64bits(i2f(50))); print("\n")
    
    let r = f2i(m)
    print("f2i(result)="); print(r); print("\n")
    
    return 0
}
