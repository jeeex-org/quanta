import std/fs

// Test faddf with various values
fn main() {
    let a = i2f(1)
    let b = i2f(2)
    
    // faddf should return float bit-pattern
    let r = faddf(a, b)
    
    print("i2f(1)=")
    print(a)
    print("\n")
    print("i2f(2)=")
    print(b)
    print("\n")
    print("faddf(i2f(1), i2f(2))=")
    print(r)
    print("\n")
    print("i2f(3)=")
    print(i2f(3))
    print("\n")
    
    // Check if r == i2f(3)
    if r == i2f(3) {
        print("MATCH\n")
        return 0
    }
    
    // Check if r == i2f(2) (which would mean it's returning the second arg)
    if r == i2f(2) {
        print("RETURNS SECOND ARG\n")
        return 1
    }
    
    // Check if r == i2f(1) (which would mean it's returning the first arg)
    if r == i2f(1) {
        print("RETURNS FIRST ARG\n")
        return 1
    }
    
    print("UNKNOWN: ")
    print(r)
    print("\n")
    return 1
}