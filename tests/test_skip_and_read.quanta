import std/fs

// Test: metadata skip + first tensor read
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    
    let klen_buf = mem_alloc(8)
    let vtype_buf = mem_alloc(4)
    let i = 0
    let klen = 0
    let vtype = 0
    let alen = 0
    
    while i < 37 {
        read_raw(fd, klen_buf, 8)
        klen = mem_load(klen_buf)
        lseek(fd, klen, 1)
        read_raw(fd, vtype_buf, 4)
        vtype = mem_load(vtype_buf)
        
        if vtype == 8 {
            read_raw(fd, klen_buf, 8)
            lseek(fd, mem_load(klen_buf), 1)
        } else if vtype == 9 {
            lseek(fd, 4, 1)
            read_raw(fd, klen_buf, 8)
            alen = mem_load(klen_buf)
            lseek(fd, alen * 4, 1)
        } else if vtype == 0 { lseek(fd, 1, 1) }
        else if vtype == 4 { lseek(fd, 4, 1) }
        else if vtype == 5 { lseek(fd, 4, 1) }
        else if vtype == 6 { lseek(fd, 4, 1) }
        else if vtype == 7 { lseek(fd, 1, 1) }
        else if vtype == 10 { lseek(fd, 8, 1) }
        else if vtype == 11 { lseek(fd, 8, 1) }
        else if vtype == 12 { lseek(fd, 8, 1) }
        i = i + 1
    }
    
    print("skipped 37\n")
    
    // Read first tensor
    let nlen_buf = mem_alloc(8)
    read_raw(fd, nlen_buf, 8)
    let nlen = mem_load(nlen_buf)
    print("nlen=")
    print(nlen)
    print("\n")
    
    let name = mem_alloc(256)
    read_raw(fd, name, nlen)
    print("name: ")
    write_raw(1, name, nlen)
    print("\n")
    
    // Read ndims
    let ndims_buf = mem_alloc(4)
    read_raw(fd, ndims_buf, 4)
    let ndims = mem_load(ndims_buf)
    print("ndims=")
    print(ndims)
    print("\n")
    
    // Read dims
    let dim_buf = mem_alloc(8)
    let d = 0
    while d < ndims {
        read_raw(fd, dim_buf, 8)
        d = d + 1
    }
    print("read dims\n")
    
    // Read dtype
    let dtype_buf = mem_alloc(4)
    read_raw(fd, dtype_buf, 4)
    print("read dtype\n")
    
    // Read offset
    let off_buf = mem_alloc(8)
    read_raw(fd, off_buf, 8)
    print("read offset\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}