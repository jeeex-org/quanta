import std/fs

// Test: minimal crash case
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    print("before loop\n")
    
    // Minimal loop - just lseek
    let i = 0
    while i < 3 {
        lseek(fd, 1, 1)
        i = i + 1
    }
    
    print("after loop\n")
    
    close(fd)
    return 0
}