import std/fs

// Test the fused q4k_dot builtin
// This bypasses the per-element Quanta loop and calls the native kernel

const Q8_SCALE = 128

// Create a simple Q4_K block where all values are 1.0
// scale=1.0 (f16=0x3C00), sub_scales=1, nibbles=9 (value = (9-8)*1*1 = 1)
fn create_test_block() {
    let W = mem_alloc(144)
    
    // scale = 1.0 in f16 = 0x3C00 = 15360
    mem_store8(W, 0)
    mem_store8(W + 1, 60)
    
    // sub-scales = 1
    let i = 0
    while i < 16 {
        mem_store8(W + 2 + i, 1)
        i = i + 1
    }
    
    // nibbles = 9 (value = 1)
    i = 0
    while i < 128 {
        mem_store8(W + 18 + i, 0x99)  // both nibbles = 9
        i = i + 1
    }
    
    return W
}

fn main() {
    // Create input x = all 1.0 in Q8 (128)
    let x = mem_alloc(256 * 8)
    let i = 0
    while i < 256 {
        mem_store(x + i * 8, 128)  // 1.0 in Q8
        i = i + 1
    }
    
    // Create weight block
    let W = create_test_block()
    
    // Call q4k_dot: dot product of one block (256 elements, all 1.0 * 1.0)
    // Expected: 256 * 128 * 128 / 128 = 256 * 128 = 32768
    let result = q4k_dot(W, x, 1)
    
    print("result=")
    print(result)
    print("\n")
    
    // Check
    if result == 32768 { print("PASS\n"); return 0 }
    print("FAIL (expected 32768)\n")
    return 1
}
