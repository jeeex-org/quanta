import std/fs

// Test: is it from lseek with computed value (mem_load * 4)?
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let buf = mem_alloc(8)
    read_raw(fd, buf, 8)
    let val = mem_load(buf)
    print("val=")
    print(val)
    print("\n")
    
    print("before lseek computed\n")
    lseek(fd, val * 4, 1)
    print("after lseek computed\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}