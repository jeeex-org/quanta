import std/fs

fn main() {
    let a = i2f(2)
    let b = i2f(3)
    
    let r_add = faddf(a, b)
    let r_sub = fsubf(b, a)
    let r_mul = fmulf(a, b)
    let r_div = fdivf(b, a)
    
    print("faddf(2,3)="); print(r_add); print("\n")
    print("fsubf(3,2)="); print(r_sub); print("\n")
    print("fmulf(2,3)="); print(r_mul); print("\n")
    print("fdivf(3,2)="); print(r_div); print("\n")
    
    let ok = 1
    if r_add != 4617315517961601024 { print("FAIL faddf "); ok = 0 }  // 5.0
    if r_sub != 4607182418800017408 { print("FAIL fsubf "); ok = 0 }  // 1.0
    if r_mul != 4618441417868443648 { print("FAIL fmulf "); ok = 0 }  // 6.0
    if r_div != 4609434218613702656 { print("FAIL fdivf "); ok = 0 }  // 1.5
    
    if ok == 1 { print("ALL PASS\n"); return 0 }
    return 1
}
