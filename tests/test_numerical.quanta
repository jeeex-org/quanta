import std/fs
import std/gguf

fn main() {
    print("=== Numerical Correctness Test ===\n")
    
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { print("load failed\n"); return 1 }
    
    // Test 1: Token embedding values
    let token_embd = gguf_find_tensor("token_embd.weight")
    let emb_off = gguf_tensor_offset(token_embd)
    
    // Read first block (256 elements)
    let raw = mem_alloc(210)
    lseek(gguf_fd, emb_off, 0)
    read_raw(gguf_fd, raw, 210)
    
    print("Q6_K block test:\n")
    let scale = mem_load8(raw) + mem_load8(raw + 1) * 256
    print("scale = ")
    print(scale)
    print("\n")
    
    // First 6-bit quant
    let b0 = mem_load8(raw + 2)
    let b1 = mem_load8(raw + 3)
    let b2 = mem_load8(raw + 4)
    
    let q0 = b0 - (b0 / 64) * 64
    let q1 = (b0 / 64) + (b1 - (b1 / 16) * 16) * 4
    let q2 = (b1 / 16) + (b2 - (b2 / 4) * 4) * 16
    let q3 = b2 / 4
    
    print("quants: ")
    print(q0)
    print(" ")
    print(q1)
    print(" ")
    print(q2)
    print(" ")
    print(q3)
    print("\n")
    
    print("dequant: ")
    print(scale * q0 / 63)
    print(" ")
    print(scale * q1 / 63)
    print("\n")
    
    // Test 2: f32 conversion
    print("\nf32 conversion test:\n")
    let test = mem_alloc(4)
    mem_store8(test, 0)
    mem_store8(test + 1, 0)
    mem_store8(test + 2, 128)
    mem_store8(test + 3, 63)
    
    print("1.0f32 = ")
    printi(f64bits(f32_to_f64(test)))
    print(" (expect 1.0)\n")
    
    // Test 3: Matvec
    print("\nmatvec test:\n")
    let A = mem_alloc(16)
    mem_store(A, i2f(1))
    mem_store(A + 8, i2f(2))
    mem_store(A + 16, i2f(3))
    mem_store(A + 24, i2f(4))
    
    let x = mem_alloc(16)
    mem_store(x, i2f(5))
    mem_store(x + 8, i2f(6))
    
    let y = mem_alloc(16)
    matvec_test(A, x, 2, 2, y)
    
    print("y[0]=")
    print(mem_load(y))
    print(" y[1]=")
    print(mem_load(y + 8))
    print(" (expect: 17, 39)\n")
    
    print("SUCCESS\n")
    return 0
}

fn f32_to_f64(ptr) {
    let b0 = mem_load8(ptr)
    let b1 = mem_load8(ptr + 1)
    let b2 = mem_load8(ptr + 2)
    let b3 = mem_load8(ptr + 3)
    let sign = i2f(b3 / 128)
    let exp32 = i2f(b3 - (b3 / 128) * 128) * i2f(2) + i2f(b2 / 128)
    let mant32 = i2f(b2 - (b2 / 128) * 128) * i2f(65536) + i2f(b1) * i2f(256) + i2f(b0)
    if exp32 == i2f(0) { return i2f(0) }
    if exp32 == i2f(255) { return i2f(0) }
    let new_exp = f2i(exp32 - i2f(127))
    let mant_frac = fdiv(mant32, i2f(8388608))
    let one_plus_mant = fadd(i2f(1), mant_frac)
    let pow2 = i2f(1)
    let i = 0
    if new_exp >= 0 {
        while i < new_exp { pow2 = fmul(pow2, i2f(2)); i = i + 1 }
    } else {
        let neg = 0 - new_exp
        while i < neg { pow2 = fdiv(pow2, i2f(2)); i = i + 1 }
    }
    let result = fmul(pow2, one_plus_mant)
    if sign == i2f(1) { result = fsub(i2f(0), result) }
    return result
}

fn matvec_test(A, x, rows, cols, y) {
    let i = 0
    while i < rows {
        let sum = i2f(0)
        let j = 0
        while j < cols {
            sum = fadd(sum, fmul(mem_load(A + (i * cols + j) * 8), mem_load(x + j * 8)))
            j = j + 1
        }
        mem_store(y + i * 8, sum)
        i = i + 1
    }
}