// tests/env_cores_probe.quanta -- validate the two primitives the politeness
// policy depends on, BEFORE wiring them into lib/std/lfm2_mm.quanta:
//   (1) hardware core count, via sched_getaffinity (syscall 204) + popcount,
//       cross-checked against /sys/devices/system/cpu/online;
//   (2) an environment-variable lookup, scanning /proc/self/environ (getenv is a
//       STUB in this compiler -- emitter.quanta:3879 returns 0 -- so it cannot be
//       used; /proc/self/environ is a "K=V\0K=V\0..." file, read with the same
//       file_open/read_raw path already proven in tests/park_cpu_probe.quanta).
//
// Run: ( ulimit -c 0 -v 8000000; <bin> </dev/null )  from the repo root.
import std/fs

let glen = 0

fn slurp(path, cap) -> i64 {
    let fd = file_open(path, 0)
    if fd < 0 { glen = 0; return 0 }
    let buf = mem_alloc(cap)
    let got = read_raw(fd, buf, cap)
    file_close(fd)
    if got <= 0 { glen = 0; return 0 }
    glen = got
    return buf
}

fn popcount_byte(b) -> i64 {
    let n = 0
    let i = 0
    while i < 8 {
        if (b & (1 << i)) != 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

// cores via sched_getaffinity(0, len, mask) = syscall 204
fn cores_affinity() -> i64 {
    let mask = mem_alloc(128)
    let i = 0
    while i < 128 { mem_store8(mask + i, 0); i = i + 1 }
    let r = syscall(204, 0, 128, mask)
    prints("  sched_getaffinity rc=")
    print(r)
    newline()
    let n = 0
    i = 0
    while i < 128 { n = n + popcount_byte(mem_load8(mask + i)); i = i + 1 }
    return n
}

// cores via /sys/devices/system/cpu/online ("0-19" or "0-N,M,...")
fn cores_online() -> i64 {
    let buf = slurp("/sys/devices/system/cpu/online", 256)
    if buf == 0 { return 0 - 1 }
    let n = glen
    prints("  online string bytes=")
    print(n)
    prints(" : ")
    let i = 0
    while i < n && mem_load8(buf + i) != 10 { let c = mem_load8(buf + i); if c >= 32 { prints("-") }; i = i + 1 }
    newline()
    // parse "a-b" -> b+1, or a single "a" -> a+1; take the max endpoint + 1
    let hi = 0 - 1
    i = 0
    while i < n {
        let c = mem_load8(buf + i)
        if c >= 48 && c <= 57 {
            let v = 0
            while i < n && mem_load8(buf + i) >= 48 && mem_load8(buf + i) <= 57 {
                v = v * 10 + (mem_load8(buf + i) - 48); i = i + 1
            }
            if v > hi { hi = v }
        } else { i = i + 1 }
    }
    return hi + 1
}

fn main() -> i64 {
    prints("cores_affinity:\n")
    let ca = cores_affinity()
    prints("  -> cores=")
    print(ca)
    newline()

    prints("cores_online:\n")
    let co = cores_online()
    prints("  -> cores=")
    print(co)
    newline()

    // env lookup: scan /proc/self/environ for a key followed by '='
    let env = slurp("/proc/self/environ", 65536)
    prints("environ bytes=")
    print(glen)
    newline()
    if env != 0 {
        // find byte offset of "PATH=" (guaranteed present) and "PROBE_KEY="
        let n = glen
        let i = 0
        let found_path = 0 - 1
        while i < n {
            if i + 5 <= n && mem_load8(env + i) == 80 && mem_load8(env + i + 1) == 65 && mem_load8(env + i + 2) == 84 && mem_load8(env + i + 3) == 72 && mem_load8(env + i + 4) == 61 {
                if found_path < 0 { found_path = i }
            }
            i = i + 1
        }
        prints("PATH= offset=")
        print(found_path)
        newline()
        let fk = 0 - 1
        // QUANTA_MM_ALL_CORES= search
        i = 0
        while i < n {
            if i + 19 <= n && mem_load8(env + i) == 81 && mem_load8(env + i + 1) == 85 && mem_load8(env + i + 2) == 65 && mem_load8(env + i + 3) == 78 && mem_load8(env + i + 4) == 84 && mem_load8(env + i + 5) == 65 && mem_load8(env + i + 6) == 95 && mem_load8(env + i + 7) == 77 && mem_load8(env + i + 8) == 77 && mem_load8(env + i + 9) == 95 && mem_load8(env + i + 10) == 65 && mem_load8(env + i + 11) == 76 && mem_load8(env + i + 12) == 76 && mem_load8(env + i + 13) == 95 && mem_load8(env + i + 14) == 67 && mem_load8(env + i + 15) == 79 && mem_load8(env + i + 16) == 82 && mem_load8(env + i + 17) == 69 && mem_load8(env + i + 18) == 83 {
                if mem_load8(env + i + 19) == 61 { fk = i + 20 }
            }
            i = i + 1
        }
        prints("QUANTA_MM_ALL_CORES value_offset=")
        print(fk)
        if fk >= 0 { prints(" value=") ; print(mem_load8(env + fk) - 48) }
        newline()
    }
    prints("DONE\n")
    return 0
}
