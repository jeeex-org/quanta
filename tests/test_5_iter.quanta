import std/fs

// Narrow down crash: how many iterations?
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    let stat_buf = mem_alloc(144)
    fstat(fd, stat_buf)
    let file_size = mem_load(stat_buf + 48)
    
    let data = mem_alloc(file_size)
    read_raw(fd, data, file_size)
    print("file read\n")
    
    let pos = 24
    let klen = 0
    let vtype = 0
    let i = 0
    
    // Try just 5 iterations
    while i < 5 {
        klen = mem_load(data + pos)
        pos = pos + 8 + klen
        vtype = mem_load(data + pos)
        pos = pos + 4
        
        if vtype == 8 {
            let slen = mem_load(data + pos)
            pos = pos + 8 + slen
        } else if vtype == 0 { pos = pos + 1 }
        else if vtype == 4 { pos = pos + 4 }
        
        i = i + 1
    }
    
    print("5 iterations done, pos=")
    print(pos)
    print("\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}