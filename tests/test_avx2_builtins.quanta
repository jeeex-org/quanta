// Test AVX2 float builtins
const N = 4

fn main() {
    let dst = mem_alloc(32)
    let a = mem_alloc(32)
    let b = mem_alloc(32)
    
    // Initialize a = [1.0, 2.0, 3.0, 4.0]
    mem_store(a + 0*8, i2f(4607182418800017408))  // 1.0 as bits
    mem_store(a + 1*8, i2f(4611686018427387904))  // 2.0 as bits
    mem_store(a + 2*8, i2f(4613937818241073152))  // 3.0 as bits
    mem_store(a + 3*8, i2f(4616189618054758400))  // 4.0 as bits
    
    // Initialize b = [5.0, 6.0, 7.0, 8.0]
    mem_store(b + 0*8, i2f(4618441417868443648))  // 5.0
    mem_store(b + 1*8, i2f(4620693217682128896))  // 6.0
    mem_store(b + 2*8, i2f(4622945017495814144))  // 7.0
    mem_store(b + 3*8, i2f(4624914877006643200))  // 8.0
    
    faddf_avx2(dst, a, b)
    
    // Check result
    let r0 = mem_load(dst + 0*8)
    let r1 = mem_load(dst + 1*8)
    let r2 = mem_load(dst + 2*8)
    let r3 = mem_load(dst + 3*8)
    
    print(r0); print(" ")
    print(r1); print(" ")
    print(r2); print(" ")
    print(r3); print("\n")
    
    return 0
}