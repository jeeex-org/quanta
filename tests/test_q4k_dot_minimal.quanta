import std/fs

// Minimal q4k_dot test
// Creates a simple Q4_K block where all 256 elements have value 1.0
// x[i] = 1.0 (Q8 = 128)
// Expected result: 256 * 128 * 128 = 4194304

const Q8_SCALE = 128
const Q4K_BLOCK_SIZE = 144

fn main() {
    // Allocate one Q4_K block
    let W = mem_alloc(Q4K_BLOCK_SIZE)
    
    // scale = 1.0 in f16 = 0x3C00
    mem_store8(W, 0)
    mem_store8(W + 1, 60)
    
    // sub_scales = 1 (16 bytes at offset 2)
    let i = 0
    while i < 16 {
        mem_store8(W + 2 + i, 1)
        i = i + 1
    }
    
    // quads: 128 bytes at offset 18, each byte = 0x99 (both nibbles = 9, value = 9-8 = 1)
    i = 0
    while i < 128 {
        mem_store8(W + 18 + i, 0x99)
        i = i + 1
    }
    
    // Allocate x (256 elements, each = 128 = 1.0 Q8)
    let x = mem_alloc(256 * 8)
    i = 0
    while i < 256 {
        mem_store(x + i * 8, 128)
        i = i + 1
    }
    
    // Call q4k_dot
    let result = q4k_dot(W, x, 1)
    
    print("result="); print(result); print("\n")
    print("expected=4194304\n")
    
    if result == 4194304 {
        print("PASS\n")
        return 0
    }
    print("FAIL\n")
    return 1
}
