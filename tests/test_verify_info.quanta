import std/fs
import std/gguf

fn main() {
    print("=== Verify Tensor Info ===\n")
    
    let rc = gguf_load("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf")
    if rc != 0 { print("load failed\n"); return 1 }
    
    print("n_tensors: ")
    print(gguf_num_tensors())
    print("\n")
    
    // Print first 5 tensors
    let i = 0
    while i < 5 {
        let dtype = gguf_tensor_dtype(i)
        let offset = gguf_tensor_offset(i)
        let nelem = gguf_tensor_nelements(i)
        
        print("[")
        print(i)
        print("] dtype=")
        print(dtype)
        print(" off=")
        print(offset)
        print(" ne=")
        print(nelem)
        print("\n")
        
        i = i + 1
    }
    
    print("SUCCESS\n")
    return 0
}