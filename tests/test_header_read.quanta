import std/fs

fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    print("reading header...\n")
    let hdr = mem_alloc(24)
    let n = read_raw(fd, hdr, 24)
    print("read n=")
    print(n)
    print("\n")
    
    let n_kv = mem_load(hdr + 8)
    let n_tensors = mem_load(hdr + 16)
    print("n_kv=")
    print(n_kv)
    print(" n_tensors=")
    print(n_tensors)
    print("\n")
    
    print("done\n")
    close(fd)
    return 0
}