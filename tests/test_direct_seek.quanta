import std/fs

// Direct seek to known tensor info offset, skip metadata parsing entirely
// This is the fastest approach - no parsing, just seek + read
fn main() {
    print("start\n")
    
    let fd = open("/opt/ai/models/quanta/QUANTA-LFM2.5-2.6Bv1-Q4_K_M.gguf", 0, 0)
    if fd < 0 { print("open failed\n"); return 1 }
    
    // Read header
    let hdr = mem_alloc(24)
    read_raw(fd, hdr, 24)
    
    let n_tensors = mem_load(hdr + 16)
    print("n_tensors=")
    print(n_tensors)
    print("\n")
    
    // Seek directly to tensor info section (offset from Python analysis)
    lseek(fd, 8222781, 0)
    
    // Read first tensor
    let nlen_buf = mem_alloc(8)
    read_raw(fd, nlen_buf, 8)
    let nlen = mem_load(nlen_buf)
    print("nlen=")
    print(nlen)
    print("\n")
    
    let name = mem_alloc(256)
    read_raw(fd, name, nlen)
    print("name: ")
    write_raw(1, name, nlen)
    print("\n")
    
    let ndims_buf = mem_alloc(4)
    read_raw(fd, ndims_buf, 4)
    let ndims = mem_load(ndims_buf)
    print("ndims=")
    print(ndims)
    print("\n")
    
    let dim_buf = mem_alloc(8)
    let d = 0
    let dim_val = 0
    while d < ndims {
        read_raw(fd, dim_buf, 8)
        dim_val = mem_load(dim_buf)
        print("dim[")
        print(d)
        print("]=")
        print(dim_val)
        print("\n")
        d = d + 1
    }
    
    let dtype_buf = mem_alloc(4)
    read_raw(fd, dtype_buf, 4)
    print("dtype=")
    print(mem_load(dtype_buf))
    print("\n")
    
    let off_buf = mem_alloc(8)
    read_raw(fd, off_buf, 8)
    print("offset=")
    print(mem_load(off_buf))
    print("\n")
    
    print("SUCCESS\n")
    close(fd)
    return 0
}