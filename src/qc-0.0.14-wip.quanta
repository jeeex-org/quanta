// Quanta Compiler - Self Hosting Bootstrap
// Written in a minimal Quanta subset: no bitwise ops, no string literals, no arrays
// Uses: functions, vars, arithmetic, if/while, builtins

// === TOKEN TYPES ===
let TT_EOF = 0
let TT_ID = 1
let TT_NUM = 2
let TT_STR = 3
let TT_OP = 4
let TT_PNCT = 5
let TT_KEY = 6
// P6.1a: float literal
let TT_FNUM = 7
// P6.1b: unsigned/bool/char/byte types
let TT_U8 = 8
let TT_U16 = 9
let TT_U32 = 10
let TT_U64 = 11
let TT_USIZE = 12
let TT_BOOL = 13
let TT_CHAR = 14
let TT_BYTE = 15
// P6.1b: enum/match/generics/interface/Option/Result keywords
let TT_ENUM = 16
let TT_MATCH = 17
let TT_TYPE = 18
let TT_INTERFACE = 19
let TT_IMPL = 20
let TT_TRAIT = 21
let TT_WHERE = 22
let TT_OPTION = 23
let TT_SOME = 24
let TT_NONE = 25
let TT_RESULT = 26
let TT_OK = 27
let TT_ERR = 28
let TT_STRING = 29
let TT_REF = 30
let TT_MUT = 31
let TT_MOVE = 32
// P6: Low-level keywords
let TT_RAW = 33
let TT_VOLATILE = 34
let TT_ASM = 35
let TT_AS = 36
let TT_USIZE = 37
// P7: panic keyword
let TT_PANIC = 38
// P8: struct keyword
let TT_STRUCT = 39
// P10: for-in loop keyword
let TT_IN = 40

// === KEYWORD HASHES ===
// h = h*31 + byte for each character
// We use arithmetic only: no string literals needed
let H_FN = 102*31 + 110
let H_LET = (((108*31) + 101)*31) + 116
let H_RET = (((((114*31 + 101)*31 + 116)*31 + 117)*31 + 114)*31 + 110)
let H_IF = 105*31 + 102
let H_ELSE = ((((101*31 + 108)*31 + 115)*31 + 101))
let H_LOOP = ((((108*31 + 111)*31 + 111)*31 + 112))
let H_WHILE = ((((((119*31 + 104)*31 + 105)*31 + 108)*31 + 101)))
let H_FOR = ((102*31 + 111)*31 + 114)
let H_BREAK = ((((((98*31 + 114)*31 + 101)*31 + 97)*31 + 107)))
let H_CONT = (((((((99*31 + 111)*31 + 110)*31 + 116)*31 + 105)*31 + 110)*31 + 117)*31 + 101)
let H_TRUE = ((((116*31 + 114)*31 + 117)*31 + 101))
let H_FALSE = ((((((102*31 + 97)*31 + 108)*31 + 115)*31 + 101)))
let H_ALIAS = 17
let H_AND = (97*31 + 110)*31 + 100
let H_OR = 111*31 + 114
let H_NOT = (((110*31 + 111)*31 + 116))

// P6.1b: unsigned type keywords
let H_U8 = 117*31 + 56
let H_U16 = ((117*31 + 49)*31) + 54
let H_U32 = ((117*31 + 51)*31) + 50
let H_U64 = ((117*31 + 54)*31) + 52
let H_USIZE = (((((117*31 + 115)*31 + 105)*31 + 122)*31 + 101)))
// P6.1b: bool/char/byte type keywords
let H_BOOL = (((98*31 + 111)*31 + 111)*31 + 108)
let H_CHAR = (((99*31 + 104)*31 + 97)*31 + 114)
let H_BYTE = (((98*31 + 121)*31 + 116)*31 + 101)
// P6.1b: enum/match/type/interface/impl/trait/where/Option/Result keywords
let H_ENUM = (((((101*31 + 110)*31 + 117)*31 + 109))))
let H_MATCH = (((((109*31 + 97)*31 + 116)*31 + 99)*31 + 104))
let H_TYPE = (((116*31 + 121)*31 + 112)*31 + 101)
let H_INTERFACE = ((((((((105*31 + 110)*31 + 116)*31 + 101)*31 + 114)*31 + 102)*31 + 97)*31 + 99)*31 + 101)
let H_IMPL = ((((105*31 + 109)*31 + 112)*31 + 108))
let H_TRAIT = (((((116*31 + 114)*31 + 97)*31 + 105)*31 + 116))
let H_WHERE = (((((119*31 + 104)*31 + 101)*31 + 114)*31 + 101))
let H_OPTION = 28   // ktext("Option")
let H_SOME = 29     // ktext("Some")
let H_NONE = 30     // ktext("None")
let H_RESULT = 31   // ktext("Result")
let H_OK = 32       // ktext("Ok")
let H_ERR = 33      // ktext("Err")
let H_REF = (114*31 + 101)*31 + 102
let H_MUT = (((109*31 + 117)*31 + 116)))
let H_MOVE = (((((109*31 + 111)*31 + 118)*31 + 101)))))
let H_STRING = (((((83*31 + 116)*31 + 114)*31 + 105)*31 + 110)*31 + 103)
// P6: Low-level keyword hashes
let H_RAW = (114*31 + 97)*31 + 119
let H_VOLATILE = (((((((118*31 + 111)*31 + 108)*31 + 97)*31 + 116)*31 + 105)*31 + 108)*31 + 101)
let H_ASM = (97*31 + 115)*31 + 109
let H_AS = 97*31 + 115
let H_USIZE = (((((117*31 + 115)*31 + 105)*31 + 122)*31 + 101))))
// P7: unwrap/expect keywords
let H_UNWRAP = (((((117*31 + 110)*31 + 119)*31 + 114)*31 + 97)*31 + 112)
let H_EXPECT = (((((101*31 + 120)*31 + 112)*31 + 101)*31 + 99)*31 + 116)
// P7: panic keyword
let H_PANIC = (((((112*31 + 97)*31 + 110)*31 + 105)*31 + 99))
// P8: struct keyword
let H_STRUCT = (((((115*31 + 116)*31 + 114)*31 + 117)*31 + 99)*31 + 116)
// P10: 'in' keyword for for-in loops
let H_IN = 43

// === IR OPS ===
let IR_CONST = 0; let IR_MOV = 1; let IR_ADD = 2; let IR_SUB = 3
let IR_MUL = 4; let IR_DIV = 5; let IR_MOD = 6
let IR_EQ = 7; let IR_NE = 8; let IR_LT = 9; let IR_GT = 10
let IR_LE = 11; let IR_GE = 12; let IR_AND = 13; let IR_OR = 14
let IR_NEG = 15; let IR_NOT = 16; let IR_CALL = 17; let IR_LABEL = 18
let IR_JMP = 19; let IR_BR = 20; let IR_RET = 21; let IR_PARAM = 22
let IR_STR = 23
let IR_BAND = 24; let IR_BOR = 25; let IR_BXOR = 26; let IR_BNOT = 27; let IR_SHL = 28; let IR_SHR = 29
let IR_LOADG = 30; let IR_STOREG = 31
// t10: closure-call IR — fnb is a mk_any tuple (tag=codeptr, val=env).
// IR_CLOSURE_CALL carries (fnb_vreg, caller-arg MOV-start, caller-argc);
// its codegen does the env-shift + indirect call. Bound to 36 to avoid
// colliding with the inline field-index 32 and the existing 33/34/35 ops.
let IR_CLOSURE_CALL = 36
// P3: extern linkage flag for function table (C ABI, no name mangling)
let FN_EXTERN = 1
// IR_IDX = 32 (a[idx] / t.N: 8-byte load at base+idx*8) — inlined constant, not a global
// IR_ISTORE = 33 (a[idx]=v / t.N=v: 8-byte store at base+idx*8)
let IR_ISTORE = 33
// IR_TALLOC = 34 (t.N tuple return): allocate n*8 bytes (mmap) -> pointer in res
let IR_TALLOC = 34
// t10: fnptr(FNAME) -> code pointer as a runtime value.
// IR_FNPTR carries the function index; codegen emits PIC lea rax,[rip+disp].
let IR_FNPTR = 35
// IR_FREE = 37 (P2 ownership): free the mem_alloc-owned binding in a0 at scope end.
// Compiler inserts these automatically (ownership-by-default); app code never calls free.
let IR_FREE = 37
// P6.1a: f64 float support. A float value lives in the SAME 64-bit vreg slot as an
// int (both 64 bits), but is tagged via vreg_is_flt[vr]=1 so codegen routes it to the
// FP register file (xmm on x86, v/d on ARM) instead of GP regs.
let IR_FCONST = 38   // a0 = IEEE-754 f64 bit pattern; result vreg tagged float
let IR_FADD = 39; let IR_FSUB = 40; let IR_FMUL = 41; let IR_FDIV = 42
let IR_F2I = 43      // double -> int64 (truncate): result vreg tagged INT
let IR_I2F = 44      // int64 -> double: result vreg tagged FLOAT
// float comparison ops reuse IR_EQ/IR_NE/IR_LT/IR_GT/IR_LE/IR_GE but on float vregs
// (codegen checks vreg_is_flt to pick comisd / fcmp instead of cmp).

// P6.1b: enum/match/Option/Result IR ops
// Enum: sum type with discriminant + payload. Tag stored at offset 0, payload at 8+
let IR_ENUM = 45     // create enum variant: (tag, payload...) -> IR_TALLOC + store tag
let IR_MATCH = 46    // match expression: discriminant + arms -> jump table
let IR_SOME = 47     // Option::Some(payload) - variant tag 1
let IR_NONE = 48     // Option::None - variant tag 0
let IR_OK = 49       // Result::Ok(payload) - variant tag 1
let IR_ERR = 50      // Result::Err(payload) - variant tag 0
let IR_UNWRAP = 51   // unwrap / ? operator - panic if None/Err
// Generics: monomorphization handled at compile time via type substitution
// Interfaces: vtable-based dispatch (trait objects)
let IR_VTABLE = 52   // construct vtable for trait impl
let IR_DYN = 53      // dyn Trait: fat pointer (data, vtable)

// P6: Low-level IR ops (raw pointers, inline asm, volatile)
let IR_RAW_PTR = 54      // *T type (immutable raw pointer)
let IR_MUT_PTR = 55      // *mut T type (mutable raw pointer)
let IR_DEREF = 56        // *p (load through raw pointer)
let IR_DEREF_MUT = 57    // *p = v (store through raw pointer)
let IR_PTR_ADD = 58      // p + n (element-sized pointer arithmetic)
let IR_PTR_SUB = 59      // p - n
let IR_PTR_DIFF = 60     // p - q (elements)
let IR_PTR_CAST = 61     // p as usize / usize as *T
let IR_IS_NULL = 62      // p == 0
let IR_VOLATILE_LOAD = 63   // volatile load (MMIO)
let IR_VOLATILE_STORE = 64  // volatile store (MMIO)
let IR_ASM = 65          // inline assembly
let IR_FFI_CALL = 66     // FFI call
let IR_VEC128 = 67       // SIMD vec128
let IR_UNSAFE_BLOCK = 68 // unsafe block marker (no-op)
let IR_ARRAY_LEN = 69    // get array length from header [base]

// === GLOBAL BUFFERS ===
// Source
let src = mmap(16777216); let srclen = 0
// include NAME  (compile-time inline expansion of internal stdlib, e.g. std/*)
let mainsrc = mmap(16777216)            // the primary source file
let impbufs = mmap(134217728)           // 8 x 16MB, indexed by include depth (avoids clobber)
let imp_full = mmap(4096)               // resolved include path (NUL-terminated)
let imp_dir = mmap(4096)                // current include dir (NUL-term); relative quoted paths resolve here
let imp_dirlen = 0
let imp_dir_stack = mmap(4096*9)        // saved include dirs per recursion depth
let imp_dir_stacklen = mmap(8*9)
// prefix byte buffers (string literals can't be used as byte-src in r8(); fill at startup)
let imp_std_pfx = mmap(8)
let imp_ext_pfx = mmap(8)
let imp_seen = mmap(8192); let imp_seenc = 0   // dedup: hashes of resolved paths
let imp_err = 0
// Tokens: 40 bytes each [type,value,line,col,len]
let toks = mmap(160000000); let tokc = 0; let tokp = 0
// NEW-3: parser recursion-depth guard. parse_expr->parse_primary->'('->parse_expr
// is unbounded native-stack recursion; a few hundred nested parens segfaults qc.
// pdepth tracks current expression nesting; parse_primary aborts past PDEPTH_MAX.
let pdepth = 0; let PDEPTH_MAX = 30
let unsafe_count = 0   // G1: total `unsafe {}` blocks parsed (CI gate counter)
let dot_guard = 0   // DBG: guards against runaway dot-chain recursion
// IR: 40 bytes each [op,res,a0,a1,a2]
let ir = mmap(1073741824); let irc = 0
let ir_dbg = mmap(64)
// G2: per-IR-record "inside unsafe{}" flag (1 byte per record). Set in iremit
// from unsafe_depth; read at emit so `unsafe {}` opts OUT of the overflow trap.
// Parallel to `ir` (record i -> ir_unsafe[i]) because the IR record is full.
let ir_unsafe = mmap(1073741824)   // sized to IR_CAP (26000000)
let unsafe_depth = 0   // >0 while parsing inside an `unsafe {}` block
// P7: track function body nesting for implicit match return
let in_fn_body = 0    // 1 while parsing the outermost block of a function
let blk_depth = 0     // nesting depth of braces inside the function (1 = function body)
// DCE liveness byte-flags, allocated ONCE (per-function mmap collides with ir/code arenas)
let live_bits = mmap(1000000)
// Functions: 40 bytes each [name_ptr,name_len,body_tok,code_ofs,param_c]
let fns = mmap(2000000); let fnc = 0
let fn_var = mmap(2000000)   // per-fn variadic flag (1 if fn ends in ...)
let fn_pcount = mmap(2000000)  // per-fn fixed param count
// t4: param names for named-argument call resolution.
let fn_pnames = mmap(4000000)   // flat [name_ptr,name_len] per param, fn_pbase-indexed
let fn_pncnt = mmap(2000000)    // per-fn param count
let fn_pbase = mmap(2000000)    // per-fn base offset into fn_pnames
let fn_retstruct = mmap(2000000) // per-fn: struct index returned by `return StructCtor(...)` (-1 if none)
// Phase 4.3: per-fn-param struct type. fn_partype[(fi*200 + z)*8] = struct
// index of param z's declared `: Type` annotation (-1 if scalar/none).
let fn_partype = mmap(2000000)
let alias_tab = mmap(8000000)   // t6: [name_ptr,name_len,target_idx]*N (24B each)
let alias_c = 0
let fn_poff = 0
// P3: per-fn extern linkage flag (1 = extern "C", 0 = internal)
let fn_extern = mmap(2000000)
// === STRUCT TYPES (Phase 4.3) — named-field tuples ===
// A struct is a compile-time record: name + ordered field names. Construction
// `Name(a,b,...)` emits IR_TALLOC(n)+stores and tags the result vreg with the
// struct index. Field access `obj.field` resolves field->index via the vreg's
// struct tag. These helpers call ONLY builtins/wrappers (no user-fn calls while
// locals are live) to avoid the allocator's caller-saved clobber.
let struct_max = 256
let structc = 0
let sdefs = mmap(256 * 64)        // 64B/struct: [nameptr,namelen,fldcount,fldbase,0,0,0,0]
let struct_max = 256
let structc = 0
let sdefs = mmap(256 * 64)        // 64B/struct: [nameptr,namelen,fldcount,fldbase,0,0,0,0]
let sfldtab = mmap(256 * 64 * 16) // flat field names: [fldptr,fldlen]*N (64 slots/struct max)
let sfldtyp = mmap(256 * 64 * 8)  // per-field struct-type index (-1 if scalar); parallels sfldtab slots
let vreg_struct = mmap(8192 * 8)  // vreg -> struct index (-1 if none)
let vreg_is_str = mmap(8192 * 8)  // vreg -> 1 if it holds a byte-stride string (els -1)
let tdefs = mmap(256 * 80)
let tmethods = mmap(256 * 32 * 24)
let idefs = mmap(256 * 96)
let imethods = mmap(256 * 32 * 32)
let vreg_trait = mmap(8192 * 8)
let g_traitc = 0
let g_implc = 0
// P2 ownership: vreg_owned[vr]=1 iff vr was bound by `let p = mem_alloc(...)`...
let vreg_owned = mmap(8192 * 8)
let owned_stk = mmap(8192 * 8)
let owned_top = 0
let owned_scopes = mmap(8192 * 8)
let owned_sctop = 0
// P6.1a: vreg_is_flt[vr]=1 iff vr holds an f64 (routed to FP register file).
let vreg_is_flt = mmap(8192 * 8)
// P6.1b: vreg_type[vr] = type tag for unsigned/bool/char/byte (0=signed, 1=u8, 2=u16, 3=u32, 4=u64, 5=usize, 6=bool, 7=char, 8=byte)
let vreg_type = mmap(8192 * 8)
fn findstruct(nm, nl) {
  let i = 0
  while i < structc {
    let onm = r64(sdefs + i*64); let onl = r64(sdefs + i*64 + 8)
    if onl == nl {
      let ok = 1; let j = 0
      while j < nl { if r8(src+onm+j) != r8(src+nm+j) { ok = 0; break }; j = j+1 }
      if ok == 1 { return i }
    }
    i = i+1
  }
  return -1
}
fn sfield_idx(si, fld, fl) {
  let fc = r64(sdefs + si*64 + 16)
  let fb = r64(sdefs + si*64 + 24)
  let j = 0
  while j < fc {
    let fp = r64(sfldtab + (fb+j)*16); let fl2 = r64(sfldtab + (fb+j)*16 + 8)
    if fl2 == fl {
      let ok = 1; let k = 0
      while k < fl { if r8(src+fp+k) != r8(src+fld+k) { ok = 0; break }; k = k+1 }
      if ok == 1 { return j }
    }
    j = j+1
  }
  return -1
}
fn sfield_type(si, fidx) {
  let fb = r64(sdefs + si*64 + 24)
  return r64(sfldtyp + (fb+fidx)*8)
}

// P6.1b: enum types — sum types with discriminant + payload
let enum_max = 64
let enumc = 0
let enums = mmap(64 * 96)     // 96B/enum: [nameptr,namelen,varcount,varbase,0,0,0,0,0,0,0,0]
let evartab = mmap(64 * 32 * 40) // variants: [nameptr,namelen,tag,fcount,fldbase] (40B/variant, 32 variants/enum max)
let evfldtab = mmap(64 * 32 * 8 * 16) // variant fields: [fldptr,fldlen]*N (8 fields/variant max)
let evfldtyp = mmap(64 * 32 * 8 * 8)  // per-field struct type index (-1 if scalar)
let vreg_enum = mmap(8192 * 8)  // vreg -> enum index (-1 if none)
let vreg_enum_var = mmap(8192 * 8) // vreg -> variant tag (0..n) when known
fn findenum(nm, nl) {
  let i = 0
  while i < enumc {
    let onm = r64(enums + i*96); let onl = r64(enums + i*96 + 8)
    if onl == nl {
      let ok = 1; let j = 0
      while j < nl { if r8(src+onm+j) != r8(src+nm+j) { ok = 0; break }; j = j+1 }
      if ok == 1 { return i }
    }
    i = i+1
  }
  return -1
}
fn evariant_idx(ei, vnm, vnl) {
  let vc = r64(enums + ei*96 + 16)
  let vb = r64(enums + ei*96 + 24)
  let j = 0
  while j < vc {
    let vp = r64(evartab + (vb+j)*40); let vl = r64(evartab + (vb+j)*40 + 8)
    if vl == vnl {
      let ok = 1; let k = 0
      while k < vl { if r8(src+vp+k) != r8(src+vnm+k) { ok = 0; break }; k = k+1 }
      if ok == 1 { return j }
    }
    j = j+1
  }
  return -1
}
fn evariant_tag(ei, vidx) {
  return r64(evartab + (r64(enums + ei*96 + 24) + vidx)*40 + 16)
}
fn evariant_fields(ei, vidx) {
  let vb = r64(enums + ei*96 + 24)
  return r64(evartab + (vb+vidx)*40 + 32)  // fldbase
}
fn evariant_fcount(ei, vidx) {
  return r64(evartab + (r64(enums + ei*96 + 24) + vidx)*40 + 24)
}
fn scannenums() {
  let p = 0
  while p < tokc {
    if tokt(p) == TT_ENUM {
      let nt = p+1
      if nt<tokc && tokt(nt)==TT_ID {
        let onm = tokv(nt); let onl = tokln(nt)
        let bp = nt+1
                while bp<tokc && !(tokt(bp)==TT_PNCT && tokv(bp)==123) { bp = bp+1 }
                if bp<tokc {
                  let ei = enumc; enumc = ei+1
                  w64(enums + ei*96, onm); w64(enums + ei*96 + 8, onl)
                  w64(enums + ei*96 + 24, ei*32)   // varbase = ei*32 (32 variant slots/enum)
                  let vc = 0; let cp = bp+1
          while cp<tokc && !(tokt(cp)==TT_PNCT && tokv(cp)==125) {
            if tokt(cp)==TT_ID {
              let vnm = tokv(cp); let vnl = tokln(cp)
              let slot = (ei*32 + vc)*40
              w64(evartab + slot, vnm); w64(evartab + slot + 8, vnl)
              w64(evartab + slot + 16, vc)   // tag = variant index (0-based)
              w64(evartab + slot + 32, ei*32*8 + vc*8)   // fldbase
              // Check for tuple-style payload: `Variant(Type)` or `Variant { field: Type, ... }`
              let fc = 0; let np = cp+1
              if np<tokc && tokt(np)==TT_PNCT && tokv(np)==40 {  // '(' tuple
                np = np+1
                while np<tokc && !(tokt(np)==TT_PNCT && tokv(np)==41) {
                  if tokt(np)==TT_ID || tokt(np)==TT_KEY {
                    let fldp = tokv(np); let fldl = tokln(np)
                    let fslot = (ei*32*8 + vc*8 + fc)*16
                    w64(evfldtab + fslot, fldp); w64(evfldtab + fslot + 8, fldl)
                    // optional type annotation
                    let ftyp = -1
                    let tp = np+1
                    if tp<tokc && tokt(tp)==TT_PNCT && tokv(tp)==58 { // ':'
                      let typ = tp+1
                      if typ<tokc && (tokt(typ)==TT_ID || tokt(typ)==TT_KEY) {
                        let su = 0
                        while su<structc {
                          if r64(sdefs + su*64 + 8)==tokln(typ) {
                            let sp=r64(sdefs + su*64); let sl=tokln(typ); let sm=0; let smatch=1
                            while sm<sl { if r8(src+sp+sm)!=r8(src+tokv(typ)+sm) { smatch=0; break }; sm=sm+1 }
                            if smatch==1 { ftyp=su; break }
                          }
                          su=su+1
                        }
                        if ftyp==-1 {
                          let eu = 0
                          while eu<enumc {
                            if r64(enums + eu*96 + 8)==tokln(typ) {
                              let ep=r64(enums + eu*96); let el=tokln(typ); let em=0; let ematch=1
                              while em<el { if r8(src+ep+em)!=r8(src+tokv(typ)+em) { ematch=0; break }; em=em+1 }
                              if ematch==1 { ftyp = eu | (1<<30); break }  // tag as enum
                            }
                            eu=eu+1
                          }
                        }
                      }
                      np = tp+1
                    }
                    w64(evfldtyp + (ei*32*8 + vc*8 + fc)*8, ftyp)
                    fc = fc+1
                  }
                  np = np+1
                  if np<tokc && tokt(np)==TT_PNCT && tokv(np)==44 { np = np+1 } // ','
                }
                w64(evartab + slot + 24, fc)  // fcount
                cp = np
              } else if np<tokc && tokt(np)==TT_PNCT && tokv(np)==123 {  // '{' struct-style
                np = np+1
                while np<tokc && !(tokt(np)==TT_PNCT && tokv(np)==125) {
                  if tokt(np)==TT_ID {
                    let fldp = tokv(np); let fldl = tokln(np)
                    let fslot = (ei*32*8 + vc*8 + fc)*16
                    w64(evfldtab + fslot, fldp); w64(evfldtab + fslot + 8, fldl)
                    let ftyp = -1
                    let tp = np+1
                    if tp<tokc && tokt(tp)==TT_PNCT && tokv(tp)==58 { // ':'
                      let typ = tp+1
                      if typ<tokc && (tokt(typ)==TT_ID || tokt(typ)==TT_KEY) {
                        let su = 0
                        while su<structc {
                          if r64(sdefs + su*64 + 8)==tokln(typ) {
                            let sp=r64(sdefs + su*64); let sl=tokln(typ); let sm=0; let smatch=1
                            while sm<sl { if r8(src+sp+sm)!=r8(src+tokv(typ)+sm) { smatch=0; break }; sm=sm+1 }
                            if smatch==1 { ftyp=su; break }
                          }
                          su=su+1
                        }
                        if ftyp==-1 {
                          let eu = 0
                          while eu<enumc {
                            if r64(enums + eu*96 + 8)==tokln(typ) {
                              let ep=r64(enums + eu*96); let el=tokln(typ); let em=0; let ematch=1
                              while em<el { if r8(src+ep+em)!=r8(src+tokv(typ)+em) { ematch=0; break }; em=em+1 }
                              if ematch==1 { ftyp = eu | (1<<30); break }
                            }
                            eu=eu+1
                          }
                        }
                      }
                      np = tp+1
                    }
                    w64(evfldtyp + (ei*32*8 + vc*8 + fc)*8, ftyp)
                    fc = fc+1
                  }
                  np = np+1
                  if np<tokc && tokt(np)==TT_PNCT && tokv(np)==44 { np = np+1 }
                }
                w64(evartab + slot + 24, fc)
                cp = np
              } else {
                w64(evartab + slot + 24, 0)  // unit variant
              }
              vc = vc+1
            }
            cp = cp+1
          }
          w64(enums + ei*96 + 16, vc)
        }
      }
    }
    p = p+1
  }
}

fn scanstructs() {
  let p = 0
  while p < tokc {
    if (tokt(p)==TT_KEY || tokt(p)==TT_ID) {
      let nm = tokv(p); let nl = tokln(p)
      // match keyword/ident "struct" (len 6)
      if nl==6 && r8(src+nm)=='s'&&r8(src+nm+1)=='t'&&r8(src+nm+2)=='r'&&r8(src+nm+3)=='u'&&r8(src+nm+4)=='c'&&r8(src+nm+5)=='t' {
        let nt = p+1
        if nt<tokc && tokt(nt)==TT_ID {
          let onm = tokv(nt); let onl = tokln(nt)
          let bp = nt+1
          while bp<tokc && !(tokt(bp)==TT_PNCT && tokv(bp)==123) { bp = bp+1 }
          if bp<tokc {
            let si = structc; structc = si+1
            w64(sdefs + si*64, onm); w64(sdefs + si*64 + 8, onl)
            w64(sdefs + si*64 + 24, si*64)   // fldbase = si*64 (64 field slots/struct)
            let fc = 0; let cp = bp+1
            while cp<tokc && !(tokt(cp)==TT_PNCT && tokv(cp)==125) {
              if tokt(cp)==TT_ID {
                let fldp = tokv(cp); let fldl = tokln(cp)
                let slot = (si*64 + fc)*16
                w64(sfldtab + slot, fldp); w64(sfldtab + slot + 8, fldl)
                // optional `: Type` annotation -> field holds a struct of that type
                                let ftyp = 0-1
                                let np = cp+1
                                if np<tokc && tokt(np)==TT_PNCT && tokv(np)==58 {  // ':' separator
                                  let tp = np+1
                                  if tp<tokc && (tokt(tp)==TT_ID || tokt(tp)==TT_KEY) {
                    // inline findstruct(tokv(tp), tokln(tp)) — must not call the
                    // user fn here (live locals would be clobbered).
                    let su=0
                    while su<structc {
                      if r64(sdefs + su*64 + 8)==tokln(tp) {
                        let sp=r64(sdefs + su*64); let sl=tokln(tp); let sm=0; let smatch=1
                        while sm<sl { if r8(src+sp+sm)!=r8(src+tokv(tp)+sm) { smatch=0; break }; sm=sm+1 }
                        if smatch==1 { ftyp=su; break }
                      }
                      su=su+1
                    }
                  }
                  // skip the ':' and the type-name token so the loop doesn't
                  // re-scan them as field names
                  cp = tp
                  if cp<tokc { cp = cp+1 }
                }
                w64(sfldtyp + (si*64 + fc)*8, ftyp)
                fc = fc+1
              }
              cp = cp+1
            }
            w64(sdefs + si*64 + 16, fc)
          }
        }
      }
    }
    p = p+1
  }
  // Phase 4.3: scan each fn signature for param `: Type` annotations and record
  // the param's struct type in fn_partype, so `area(r)` params get tagged and
  // `r.field` resolves inside the function body.
  let fi = 0
  while fi < fnc {
    let pbase = r64(fn_pbase + fi*8)
    let pcount = r64(fn_pcount + fi*8)
    let z = 0
    while z < pcount {
      // recover this param's declared name token by re-scanning the signature
      let pnm = r64(fn_pnames + pbase + z*16)
      let pnl = r64(fn_pnames + pbase + z*16 + 8)
      // find the param's token index in the signature (match name, first at depth)
      let bt = fn_btok(fi)
      // The signature `(` precedes the body `{`. Scan backward from the body
      // to the `)` that closes the signature, then to its matching `(`.
      let rp = bt
      while rp>=0 {
        if tokt(rp)==TT_PNCT && tokv(rp)==41 { break }
        rp = rp-1
      }
      let lp = rp
      while lp>=0 {
        if tokt(lp)==TT_PNCT && tokv(lp)==40 { break }
        lp = lp-1
      }
      if lp>=0 {
        // find the z-th ID param at depth 1 (mirrors scanfns param scan)
        let k = lp+1; let depth = 1; let seen = 0; let ptok = -1
        while k < tokc {
          let tk = tokt(k)
          if tk==TT_PNCT {
            let tv = tokv(k)
            if tv==40 { depth = depth+1 }
            else if tv==41 { break }
            else if depth==1 && tv==44 { /* next param */ }
          }
          if depth==1 && tk==TT_ID {
            // match this param's name
            if seen==z {
              let nm = tokv(k); let nln = tokln(k)
              let mok = 1; let mm = 0
              while mm < nln { if r8(src+nm+mm) != r8(src+pnm+mm) { mok=0; break }; mm=mm+1 }
              if mok==1 { ptok = k; break }
            }
            seen = seen+1
          }
          k = k+1
        }
        if ptok>=0 {
          // check ptok+1 == ':' and ptok+2 == TT_KEY Type
          let ptyp = 0-1
          if ptok+2<tokc && tokt(ptok+1)==TT_PNCT && tokv(ptok+1)==58 && (tokt(ptok+2)==TT_ID || tokt(ptok+2)==TT_KEY || tokt(ptok+2)==TT_TRAIT) {
            let tnm = tokv(ptok+2); let tln = tokln(ptok+2)
            let su = 0
            while su < structc {
              if r64(sdefs + su*64 + 8)==tln {
                let sp = r64(sdefs + su*64); let sm = 0; let smatch = 1
                while sm < tln { if r8(src+sp+sm) != r8(src+tnm+sm) { smatch=0; break }; sm=sm+1 }
                if smatch==1 { ptyp = su; break }
              }
              su = su+1
            }
            // P9: also check for trait type
            if ptyp == 0-1 {
              let ti = 0
              while ti < g_traitc {
                let onm = r64(tdefs + ti*80); let onl = r64(tdefs + ti*80 + 8)
                if onl == tln {
                  let ok = 1; let k = 0
                  while k < tln { if r8(src+onm+k) != r8(src+tnm+k) { ok = 0; break }; k = k+1 }
                  if ok == 1 { ptyp = 0 - (ti + 2); break }  // negative = trait type
                }
                ti = ti+1
              }
            }
          }
          w64(fn_partype + (fi*200 + z)*8, ptyp)
        }
      }
      z = z+1
    }
    fi = fi+1
  }
}
// Phase 4.3: record, per function, the struct index it returns (when its body
// has `return StructName(...)`). This lets `let q = make(...)` tag q's
// call-result vreg with make's return struct, so `q.field` resolves.
// NOTE: the struct-name comparison is INLINED (not a findstruct() call) because
// this function keeps many locals live across the scan; a user-fn call would
// trigger the allocator's caller-saved clobber and corrupt the loop state.
fn scan_retstructs() {
  let fi = 0
  while fi < fnc {
    w64(fn_retstruct + fi*8, 0-1)   // default: no struct return
    let bt = fn_btok(fi)
    // find the matching '}' that closes this fn body
    let depth = 0; let p = bt; let end = tokc; let started = 0
    while p < tokc {
      if tokt(p)==TT_PNCT&&tokv(p)==123 { depth = depth+1; started = 1 }
      else if tokt(p)==TT_PNCT&&tokv(p)==125 { depth = depth-1; if started==1&&depth==0 { end = p; break } }
      p = p+1
    }
    // scan body for `return StructName(` -> record struct index
    let q = bt
    while q < end {
      // `return` keyword: name len 6, bytes 'return'
      if tokt(q)==TT_KEY && tokln(q)==6 && r8(src+tokv(q))=='r'&&r8(src+tokv(q)+1)=='e'&&r8(src+tokv(q)+2)=='t'&&r8(src+tokv(q)+3)=='u'&&r8(src+tokv(q)+4)=='r'&&r8(src+tokv(q)+5)=='n' {
        let r = q+1
        if r<end && tokt(r)==TT_ID {
          // inline findstruct(tokv(r), tokln(r))
          let si = 0; let found = 0
          while si < structc {
            let onm = r64(sdefs + si*64); let onl = r64(sdefs + si*64 + 8)
            if onl == tokln(r) {
              let ok = 1; let k = 0
              while k < tokln(r) { if r8(src+onm+k) != r8(src+tokv(r)+k) { ok = 0; break }; k = k+1 }
              if ok == 1 { found = 1; break }
            }
            si = si+1
          }
          if found == 1 { w64(fn_retstruct + fi*8, si) }
        }
      }
      q = q+1
    }
    fi = fi+1
  }
}
                 // running byte offset into fn_pnames
// t5: default-argument token ranges. For fn fi, param z with a default,
// fn_defargs[(fi*64+z)*16] = token-start, +8 = token-end (exclusive) of the
// default expression (the text after '=' up to ',', ')', '...', or EOF within
// the signature). fn_pdfixed[fi] = number of leading params that have NO
// default (the mandatory minimum arg count at the call site).
let fn_defargs = mmap(8000000)
let fn_pdfixed = mmap(2000000)
// Variadic args are stored FRAME-LOCAL (not in a global table) so that a
// variadic function calling another variadic function nests correctly.
// For each variadic function, ci_func reserves 64 bytes at the bottom of its
// stack frame: 8 bytes for the saved arg count (va_cnt) and 48 bytes holding
// the first 6 incoming register-args (rdi..r9) copied on entry. Args arriving
// on the stack (index >= 6) stay on the stack at [rbp+16+...] and are read
// directly. These rbp-relative offsets are set per-function below.
let g_va_cnt_off = 0   // rbp-relative offset of saved arg count
let g_va_reg_off = 0   // rbp-relative offset of saved reg-arg[0..5] area
// Code
let code = mmap(33554432); let codelen = 0
// Patches: 24 bytes each [code_ofs,target,type]
let patches = mmap(8000000); let patchc = 0
// Global RIP-relative patches: [code_offset, global_index, is_internal]
let gpatches = mmap(2000000); let gpatchc = 0
// t11: ARM64 fnptr patches: [adrp_ofs, add_ofs, fn_index, 0]
// recorded by the ARM IR_FNPTR handler; resolved at finalize (exec mode) or as
// R_AARCH64_ADR_PREL_PG_HI21 + R_AARCH64_ADD_ABS_LO12_NC relocs (object mode).
let fnptr_patches = mmap(8000000); let fnptr_patchc = 0

// Compiler-internal global names to skip in scan_globals
// Per-function
let vars = mmap(2000000); let varc = 0; let vreg_n = 0; let lbl_n = 0
let argstack = mmap(2000000); let argsp = 0
// t4: temp buffers for named-argument reordering (collect args in argument
// order, then permute into callee parameter order after the loop).
let arg_tmp = mmap(2000000)   // reordered arg values
let arg_tgt = mmap(2000000)   // per-argument target param index (pidx)
let arg_filled = mmap(8000000) // t5: per-call bitmap of supplied param indices (base*64 + z)
// Global-variable table: gvars holds (name-src-index, name-len) pairs; ginit
// holds the token index of each global's initializer expression.  Globals live
// at absolute address GDATA + index*8 in a dedicated writable segment.
let gvars = mmap(2000000); let ginit = mmap(2000000); let gvarc = 0
// P5.1 cross-TU data globals: per-global named-symbol encoding in `g_named`:
//   0 = legacy `let NAME = EXPR` top-level global (lives under `_gdata`)
//   1 = named global DEFINED in this TU (`global NAME [= init]`) -> GLOBAL def sym
//   2 = named global IMPORTED (`extern "C" global NAME`) -> UNDEF GLOBAL sym
// Drives whether the named ELF symbol is emitted as UNDEF or GLOBAL def, and
// whether __init skips the slot (imported globals have no initializer here).
let g_named = mmap(2000000)
// Map global index (0..gvarc-1) -> .symtab index of its named ELF symbol
// (GLOBAL def for `global NAME`, UNDEF GLOBAL for `extern "C" global NAME`).
// -1 if the global is not named (legacy `let` top-level global).
let g_symidx = mmap(2000000)
let GDATA = 1109393408  // 0x42200000: fixed BSS base (x86-64 ET_EXEC, absolute addressing)
// P4 ARM64 PIC: the gdata (globals + string literals) region is placed at a FIXED
// link-time vaddr GDATA_ARM, adjacent to code (within 128MB so adrp/bl stay PC-relative).
// For ET_DYN the loader adds a random base B; arm_gptr() computes addresses via
// PC-relative adrp/add so the result self-relocates. Must equal write_elf's gdata LOAD vaddr.
let GDATA_ARM = 5242880   // 0x500000: link-time vaddr of gdata region for ARM64 output
let LINK_BASE = 4194304  // 0x400000: link-time base of the code region (ARM64)
let LINK_HT = 400         // ELF header + 6 program headers (64 + 56*6) — must match write_elf ht
// P4 (ARM64 backend): target architecture selector. 0 = x86-64 (default), 1 = ARM64 aarch64.
// Set from the --target=arm64 CLI flag in main(); all ARM-specific codegen/ELF paths
// branch on this. x86-64 path is completely unaffected when target_arch==0.
let target_arch = 0
// P4: code-buffer offsets of __init and main, recorded at emit time, used by the
// startup-stub bl patcher. Globals (cannot be shadowed by block-scoped lets).
let g_init_ofs = 0
let g_main_ofs = 0
let g_main_fi = 0   // function index of `main` (set in finalize; used by P5 .o emit)
let g_init_call_ofs = 0   // code offset of the 'bl __init' placeholder in the startup stub
let g_main_call_ofs = 0   // code offset of the 'bl main' placeholder in the startup stub

// P5: object-format mode. When emit_obj==1, finalize emits a relocatable ELF64
// .o (ET_REL) with .text/.rel.text/.symtab/.strtab/.shstrtab, plus section
// header table, and leaves the calls (__init/main/extern) as RELA relocations
// instead of patching them. An external `ld` links the .o (see rebuild.sh).
// x86-64 + ARM64 (aarch64) object emission is supported; the relocation
// type (R_X86_64_PLT32 vs R_AARCH64_CALL26) and e_machine are chosen by
// target_arch at emit time.
let emit_obj = 0
let no_start = 0   // P5.1: secondary object TU — suppress _start/__init entry
let has_main = 0  // P5.1: set in finalize; visible to p5_elf_obj for no_start
let objcode = mmap(16777216)   // relocatable .text image (copy of code buffer at finalize)
let objcodelen = 0
let symtab = mmap(2000000)     // 24-byte ELF64 symbol entries
let symc = 0                   // symbol count
let strtab = mmap(4000000)     // .strtab string pool (starts with NUL)
let strtablen = 1              // first byte is NUL
let reldyn = mmap(4000000)     // 24-byte RELA relocations (.rel.text)
let relc = 0
let fn_symidx = mmap(2000000)  // map function index -> .symtab index (for relocations)
// ARM64 object-mode global patches: arm_gptr records, for each global access,
// the adrp instruction offset, the (optional) add instruction offset, the
// global index, and whether the add was emitted — so p5_elf_obj can emit
// R_AARCH64_ADR_PREL_PG_HI21 + R_AARCH64_ADD_ABS_LO12_NC relocations against
// the _gdata symbol. Layout: [adrp_ofs, add_ofs, gidx, has_add] (each 8 bytes).
let gpatches_a = mmap(8000000)
let gapatchc = 0
let gdata_sym = 0            // .symtab index of the _gdata symbol (set in p5_elf_obj)
// unified data segment at GDATA holds: [internal globals][source globals][string data].
let INTERNAL_GLOBAL_COUNT = 38
// Output binary data section (string literals) - mmap'd so IR_STR writes are valid.
let data = mmap(33554432); let data_off = 0  // 32MB string-literal buffer
// Label map: 16 bytes [label,ir_pos]
let lblmap = mmap(2000000); let lblc = 0

let TKS = 40; let IRS = 40; let FNS = 40; let VRS = 24; let PCS = 24; let LBS = 16

// === HELPERS ===
fn r8(p) { return mem_load8(p) }
fn r16(p) { return mem_load8(p) | (mem_load8(p+1) << 8) }
fn r32(p) { return mem_load8(p) | (mem_load8(p+1) << 8) | (mem_load8(p+2) << 16) | (mem_load8(p+3) << 24) }
fn r64(p) { return mem_load(p) }
fn w8(p,v) { if p!=0 { mem_store8(p,v) } }
fn w16(p,v) { if p!=0 { mem_store8(p, v & 255); mem_store8(p+1, (v>>8) & 255) } }
fn w64(p,v) { mem_store(p,v) }
// Host runtime intrinsics for compiler's own memory access (self-host fix for ARM64 3-char fn names)
fn mem_load8(p) { return r8(p) }
fn mem_load(p) { return r64(p) }
fn mem_store8(p,v) { if p!=0 { w8(p,v) } }
fn mem_store(p,v) { if p!=0 { w64(p,v) } }


fn tokt(i) { return r64(toks + i*TKS) }
fn tokv(i) { return r64(toks + i*TKS + 8) }
fn tokl(i) { return r64(toks + i*TKS + 16) }
fn tokc(i) { return r64(toks + i*TKS + 24) }
fn tokln(i) { return r64(toks + i*TKS + 32) }
// Emitters below (stok/tkemit, iremit, vadd, sfn, aset) were previously
// UNBOUNDED: their counters (tokc/irc/varc/fnc/allocfc) could run past the
// fixed mmap arenas, causing an out-of-bounds write into an unmapped guard
// page -> SIGSEGV (a crafted ≤16MB source with very high token density could
// trigger this). As of 1.1.0 each emitter bounds its counter and aborts with a
// clean error (exit 17) instead of corrupting memory.
let TOK_CAP = 4000000      // toks arena 160MB / 40B per token
let IR_CAP  = 26000000     // ir arena 1024MB / 40B per record
let VAR_CAP = 250000       // vars arena 2MB / 24B (VRS=24? keep headroom)
let FN_CAP  = 250000       // fns arena 2MB / 40B (FNS=40)
let ALLOC_CAP = 131000     // alloc arena 2MB / 16B

// Clean abort when an emit arena is exhausted: write a clear message to stderr
// and exit(17) instead of writing out-of-bounds (which previously SIGSEGV'd).
fn emit_ovf() {
    let msg = mmap(64)
    // "error: source too large to compile (token/IR limit)\n"
    w8(msg+0,101);w8(msg+1,114);w8(msg+2,114);w8(msg+3,111);w8(msg+4,114);w8(msg+5,58)
    w8(msg+6,32);w8(msg+7,115);w8(msg+8,111);w8(msg+9,117);w8(msg+10,114);w8(msg+11,99)
    w8(msg+12,101);w8(msg+13,32);w8(msg+14,116);w8(msg+15,111);w8(msg+16,111);w8(msg+17,32)
    w8(msg+18,109);w8(msg+19,97);w8(msg+20,110);w8(msg+21,121);w8(msg+22,32);w8(msg+23,116)
    w8(msg+24,111);w8(msg+25,107);w8(msg+26,101);w8(msg+27,110);w8(msg+28,115);w8(msg+29,47)
    w8(msg+30,73);w8(msg+31,82);w8(msg+32,32);w8(msg+33,108);w8(msg+34,105);w8(msg+35,109)
    w8(msg+36,105);w8(msg+37,116);w8(msg+38,10)
    file_write(2, msg, 39)
    exit(17)
}

fn stok(i,t,v,l,c,ln) {
    if i >= TOK_CAP { emit_ovf() }
    w64(toks + i*TKS, t); w64(toks + i*TKS + 8, v)
    w64(toks + i*TKS + 16, l); w64(toks + i*TKS + 24, c)
    w64(toks + i*TKS + 32, ln)
}

fn khash(p,ln) {
    let h = 0; let i = 0
    while i < ln { h = h*31 + r8(src+p+i); i = i+1 }
    return h
}

// Keyword detection by EXACT TEXT (not hash) — hash collisions (e.g. the
// compiler's own globals H_FN, H_LET, H_RET, ...) must never be mistaken
// for keywords. Returns 1..15 for a keyword, 0 otherwise.
fn ktext(sv, ln) {
    if ln==2 && r8(src+sv)==102 && r8(src+sv+1)==110 { return 1 }            // fn
    if ln==3 && r8(src+sv)==108 && r8(src+sv+1)==101 && r8(src+sv+2)==116 { return 2 } // let
    if ln==2 && r8(src+sv)==105 && r8(src+sv+1)==102 { return 3 }            // if
    if ln==4 && r8(src+sv)==101 && r8(src+sv+1)==108 && r8(src+sv+2)==115 && r8(src+sv+3)==101 { return 4 } // else
    if ln==4 && r8(src+sv)==108 && r8(src+sv+1)==111 && r8(src+sv+2)==111 && r8(src+sv+3)==112 { return 5 } // loop
    if ln==5 && r8(src+sv)==119 && r8(src+sv+1)==104 && r8(src+sv+2)==105 && r8(src+sv+3)==108 && r8(src+sv+4)==101 { return 6 } // while
    if ln==3 && r8(src+sv)==102 && r8(src+sv+1)==111 && r8(src+sv+2)==114 { return 7 } // for
    if ln==5 && r8(src+sv)==98 && r8(src+sv+1)==114 && r8(src+sv+2)==101 && r8(src+sv+3)==97 && r8(src+sv+4)==107 { return 8 } // break
    if ln==8 && r8(src+sv)==99 && r8(src+sv+1)==111 && r8(src+sv+2)==110 && r8(src+sv+3)==116 && r8(src+sv+4)==105 && r8(src+sv+5)==110 && r8(src+sv+6)==117 && r8(src+sv+7)==101 { return 9 } // continue
    if ln==4 && r8(src+sv)==116 && r8(src+sv+1)==114 && r8(src+sv+2)==117 && r8(src+sv+3)==101 { return 10 } // true
    if ln==5 && r8(src+sv)==102 && r8(src+sv+1)==97 && r8(src+sv+2)==108 && r8(src+sv+3)==115 && r8(src+sv+4)==101 { return 11 } // false
    if ln==4 && r8(src+sv)==110 && r8(src+sv+1)==111 && r8(src+sv+2)==110 && r8(src+sv+3)==101 { return 12 } // none
    if ln==3 && r8(src+sv)==97 && r8(src+sv+1)==110 && r8(src+sv+2)==100 { return 13 } // and
    if ln==2 && r8(src+sv)==111 && r8(src+sv+1)==114 { return 14 }            // or
    if ln==3 && r8(src+sv)==110 && r8(src+sv+1)==111 && r8(src+sv+2)==116 { return 15 } // not
    if ln==6 && r8(src+sv)==114 && r8(src+sv+1)==101 && r8(src+sv+2)==116 && r8(src+sv+3)==117 && r8(src+sv+4)==114 && r8(src+sv+5)==110 { return 16 } // return
    if ln==5 && r8(src+sv)==97 && r8(src+sv+1)==108 && r8(src+sv+2)==105 && r8(src+sv+3)==97 && r8(src+sv+4)==115 { return 17 } // alias
    if ln==6 && r8(src+sv)==117 && r8(src+sv+1)==110 && r8(src+sv+2)==115 && r8(src+sv+3)==97 && r8(src+sv+4)==102 && r8(src+sv+5)==101 { return 18 } // unsafe
    if ln==6 && r8(src+sv)==101 && r8(src+sv+1)==120 && r8(src+sv+2)==116 && r8(src+sv+3)==101 && r8(src+sv+4)==114 && r8(src+sv+5)==110 { return 19 } // extern
    if ln==6 && r8(src+sv)==103 && r8(src+sv+1)==108 && r8(src+sv+2)==111 && r8(src+sv+3)==98 && r8(src+sv+4)==97 && r8(src+sv+5)==108 { return 20 } // global
    // P6.1b: new keywords
    if ln==4 && r8(src+sv)==101 && r8(src+sv+1)==110 && r8(src+sv+2)==117 && r8(src+sv+3)==109 { return 21 } // enum
    if ln==5 && r8(src+sv)==109 && r8(src+sv+1)==97 && r8(src+sv+2)==116 && r8(src+sv+3)==99 && r8(src+sv+4)==104 { return 22 } // match
    if ln==4 && r8(src+sv)==116 && r8(src+sv+1)==121 && r8(src+sv+2)==112 && r8(src+sv+3)==101 { return 23 } // type
    if ln==9 && r8(src+sv)==105 && r8(src+sv+1)==110 && r8(src+sv+2)==116 && r8(src+sv+3)==101 && r8(src+sv+4)==114 && r8(src+sv+5)==102 && r8(src+sv+6)==97 && r8(src+sv+7)==99 && r8(src+sv+8)==101 { return 24 } // interface
    if ln==4 && r8(src+sv)==105 && r8(src+sv+1)==109 && r8(src+sv+2)==112 && r8(src+sv+3)==108 { return 25 } // impl
    if ln==5 && r8(src+sv)==116 && r8(src+sv+1)==114 && r8(src+sv+2)==97 && r8(src+sv+3)==105 && r8(src+sv+4)==116 { return 26 } // trait
    if ln==5 && r8(src+sv)==119 && r8(src+sv+1)==104 && r8(src+sv+2)==101 && r8(src+sv+3)==114 && r8(src+sv+4)==101 { return 27 } // where
    if ln==6 && r8(src+sv)==79 && r8(src+sv+1)==112 && r8(src+sv+2)==116 && r8(src+sv+3)==105 && r8(src+sv+4)==111 && r8(src+sv+5)==110 { return 28 } // Option
    if ln==4 && r8(src+sv)==83 && r8(src+sv+1)==111 && r8(src+sv+2)==109 && r8(src+sv+3)==101 { return 29 } // Some
    if ln==4 && r8(src+sv)==78 && r8(src+sv+1)==111 && r8(src+sv+2)==110 && r8(src+sv+3)==101 { return 30 } // None
    if ln==6 && r8(src+sv)==82 && r8(src+sv+1)==101 && r8(src+sv+2)==115 && r8(src+sv+3)==117 && r8(src+sv+4)==108 && r8(src+sv+5)==116 { return 31 } // Result
    if ln==2 && r8(src+sv)==79 && r8(src+sv+1)==107 { return 32 } // Ok
    if ln==3 && r8(src+sv)==69 && r8(src+sv+1)==114 && r8(src+sv+2)==114 { return 33 } // Err
    if ln==4 && r8(src+sv)==114 && r8(src+sv+1)==101 && r8(src+sv+2)==102 { return 34 } // ref
    if ln==3 && r8(src+sv)==109 && r8(src+sv+1)==117 && r8(src+sv+2)==116 { return 35 } // mut
    if ln==4 && r8(src+sv)==109 && r8(src+sv+1)==111 && r8(src+sv+2)==118 && r8(src+sv+3)==101 { return 36 } // move
    if ln==6 && r8(src+sv)==83 && r8(src+sv+1)==116 && r8(src+sv+2)==114 && r8(src+sv+3)==105 && r8(src+sv+4)==110 && r8(src+sv+5)==103 { return 37 } // String
    if ln==2 && r8(src+sv)==97 && r8(src+sv+1)==115 { return 41 } // as
    // P10: 'in' keyword for for-in loops
    if ln==2 && r8(src+sv)==105 && r8(src+sv+1)==110 { return 43 } // in
    if ln==3 && r8(src+sv)==114 && r8(src+sv+1)==97 && r8(src+sv+2)==119 { return 38 } // raw
    if ln==3 && r8(src+sv)==97 && r8(src+sv+1)==115 && r8(src+sv+2)==109 { return 40 } // asm
    if ln==5 && r8(src+sv)==117 && r8(src+sv+1)==115 && r8(src+sv+2)==105 && r8(src+sv+3)==122 && r8(src+sv+4)==101 { return 42 } // usize
    if ln==8 && r8(src+sv)==118 && r8(src+sv+1)==111 && r8(src+sv+2)==108 && r8(src+sv+3)==97 && r8(src+sv+4)==116 && r8(src+sv+5)==105 && r8(src+sv+6)==108 && r8(src+sv+7)==101 { return 39 } // volatile
    // P6: new unsigned/bool/char/byte/low-level keywords (added after original 43)
    if ln==2 && r8(src+sv)==117 && r8(src+sv+1)==56 { return 44 }             // u8
    if ln==3 && r8(src+sv)==117 && r8(src+sv+1)==49 && r8(src+sv+2)==54 { return 45 }  // u16
    if ln==3 && r8(src+sv)==117 && r8(src+sv+1)==51 && r8(src+sv+2)==50 { return 46 } // u32
    if ln==3 && r8(src+sv)==117 && r8(src+sv+1)==54 && r8(src+sv+2)==52 { return 47 } // u64
    if ln==5 && r8(src+sv)==117 && r8(src+sv+1)==115 && r8(src+sv+2)==105 && r8(src+sv+2)==122 && r8(src+sv+3)==101 { return 48 } // usize
    if ln==4 && r8(src+sv)==98 && r8(src+sv+1)==111 && r8(src+sv+2)==111 && r8(src+sv+3)==108 { return 49 } // bool
    if ln==4 && r8(src+sv)==99 && r8(src+sv+1)==104 && r8(src+sv+2)==97 && r8(src+sv+3)==114 { return 50 } // char
    if ln==4 && r8(src+sv)==98 && r8(src+sv+1)==121 && r8(src+sv+2)==116 && r8(src+sv+3)==101 { return 51 } // byte
    if ln==4 && r8(src+sv)==114 && r8(src+sv+1)==97 && r8(src+sv+2)==119 { return 52 } // raw
    if ln==3 && r8(src+sv)==97 && r8(src+sv+1)==115 && r8(src+sv+2)==109 { return 53 } // asm
    if ln==4 && r8(src+sv)==118 && r8(src+sv+1)==111 && r8(src+sv+2)==108 && r8(src+sv+3)==97 && r8(src+sv+4)==116 && r8(src+sv+5)==105 && r8(src+sv+6)==108 && r8(src+sv+7)==101 { return 54 } // volatile
    return 0
}

fn iremit(op,res,a0,a1,a2) {
    if irc >= IR_CAP { emit_ovf() }
    let i = irc; irc = i+1
    w64(ir + i*IRS, op); w64(ir + i*IRS + 8, res)
    w64(ir + i*IRS + 16, a0); w64(ir + i*IRS + 24, a1)
    w64(ir + i*IRS + 32, a2)
    w8(ir_unsafe + i, unsafe_depth)   // G2: record whether this op is inside `unsafe {}`
}

fn irop(i) { return r64(ir + i*IRS) }
fn irres(i) { return r64(ir + i*IRS + 8) }
fn ira0(i) { return r64(ir + i*IRS + 16) }
fn ira1(i) { return r64(ir + i*IRS + 24) }
fn ira2(i) { return r64(ir + i*IRS + 32) }

fn fn_name(i) { return r64(fns + i*FNS) }
fn fn_nlen(i) { return r64(fns + i*FNS + 8) }
fn fn_btok(i) { return r64(fns + i*FNS + 16) }
fn fn_cofs(i) { return r64(fns + i*FNS + 24) }
fn fn_pc(i) { return r64(fns + i*FNS + 32) }
fn sfn(i,nm,nl,bt,co,pc) {
    if i >= FN_CAP { emit_ovf() }
    w64(fns + i*FNS, nm); w64(fns + i*FNS + 8, nl)
    w64(fns + i*FNS + 16, bt); w64(fns + i*FNS + 24, co)
    w64(fns + i*FNS + 32, pc)
}

fn vadd(nm,nl,vr) {
    if varc >= VAR_CAP { emit_ovf() }
    let i = varc; varc = i+1
    w64(vars + i*VRS, nm); w64(vars + i*VRS + 8, vr); w64(vars + i*VRS + 16, nl)
}
fn vfind(nm,nl) {
    // Scan from the NEWEST binding backward so that a re-`let` of the same
    // name (e.g. `val` reset inside a loop/branch) resolves to the current
    // scope, not the oldest one.  Scanning oldest-first made
    // `val = val*10 + d` in the 2nd number write into the 1st number's
    // vreg (which still held 10), so "20" parsed as 10*100+20 = 1020.
    let i = varc-1
    while i >= 0 {
        let vnm = r64(vars + i*VRS); let vnl = r64(vars + i*VRS + 16)
        if vnl == nl {
            let ok = 1; let j = 0
            while j < nl { if r8(src+vnm+j) != r8(src+nm+j) { ok=0; break }; j=j+1 }
            if ok { return r64(vars + i*VRS + 8) }
        }
        i = i-1
    }
    return -1
}
fn vclr() { varc = 0; vreg_n = 0 }

// === P2 OWNERSHIP: compiler-inserted free of mem_alloc-owned bindings ===
// A binding `let p = mem_alloc(...)` is compiler-owned: on every exit edge of
// the scope that introduced it, the compiler emits IR_FREE(p). Scope handling is
// INDEX-BASED and IDEMPOTENT so that early exits (break/return) which jump past a
// block's trailing pop cannot double-free: a scope's frees are emitted exactly
// once, tracked by restoring owned_top straight to the scope's base.
fn owned_scope_push() {
    w64(owned_scopes + owned_sctop*8, owned_top)
    owned_sctop = owned_sctop + 1
}
// Free exactly scope index `sc` (the one a parse_block pushed). Idempotent: if sc
// was already collapsed by an earlier break/return, owned_top is already at its
// base, so no IR_FREE is re-emitted and counters are left consistent.
fn owned_scope_pop_one(sc) {
    if sc<0 || sc>=owned_sctop { return }
    let base = r64(owned_scopes + sc*8)
    let i = owned_top - 1
    while i >= base {
        let ov = r64(owned_stk + i*8)
        iremit(IR_FREE, 0, ov, 0, 0)
        i = i - 1
    }
    owned_top = base
    owned_sctop = sc
}
fn owned_pop_all() {
    while owned_sctop>0 { owned_scope_pop_one(owned_sctop-1) }
}
fn owned_pop_to(base_sctop) {
    while owned_sctop > base_sctop { owned_scope_pop_one(owned_sctop-1) }
}
fn owned_add(vr) {
    w64(owned_stk + owned_top*8, vr)
    owned_top = owned_top + 1
}

fn gfind(nm,nl) {
    let i=0
    while i<gvarc {
        if r64(gvars+i*16+8)==nl {
            let gnm=r64(gvars+i*16); let ok=1; let j=0
            while j<nl { if r8(src+gnm+j)!=r8(src+nm+j) { ok=0; break }; j=j+1 }
            if ok { return i }
        }
        i=i+1
    }
    return -1
}

// Scan for top-level `let NAME = EXPR` declarations (brace depth 0) and record
// each as a global with its initializer token position.
// Compiler-internal global names to skip in scan_globals
let INTERNAL_GLOBALS = mmap(400)
// Compiler-internal global addresses (absolute BSS addresses). Declared as a
// real global so the undeclared-variable check passes and codegen writes to
// the mmap'd buffer (not address 0, which the old silent-0 path did).
let CGLOBALS = mmap(512)
// Returns the internal-global GDATA index (0..INTERNAL_GLOBAL_COUNT-1) for a
// name, or -1 if it is not an internal global.  Internal globals occupy the
// first INTERNAL_GLOBAL_COUNT slots of the GDATA segment; source (program)
// globals follow at INTERNAL_GLOBAL_COUNT + source_index.
fn is_internal_global(nm,nl) {
    let i=0; let entry=0
    while i<400 {
        let p=INTERNAL_GLOBALS+i
        let c=r8(p)
        if c==0 { break }
        let matchvar=1
        let j=0
        while j<nl {
            if r8(p+j)!=r8(nm+j) { matchvar=0; break }
            j=j+1
        }
        if matchvar!=0&&r8(p+nl)==0 { return entry }
        // skip to next null-terminated entry, counting entries
        while r8(p)!=0 { p=p+1 }
        i=p-INTERNAL_GLOBALS+1
        entry=entry+1
    }
    return -1
}

fn scan_globals() {
    gvarc=0; let depth=0; let p=0
    while p<tokc {
        if tokt(p)==TT_PNCT {
            if tokv(p)==123 { depth=depth+1 }
            if tokv(p)==125 { depth=depth-1 }
        }
        if depth==0&&tokt(p)==TT_KEY {
            let kt=ktext(tokv(p),tokln(p))
            // ktext==2 -> `let NAME = EXPR` (legacy top-level global)
            // ktext==20 -> `global NAME [= init]` (exported cross-TU global)
            if kt==2||kt==20 {
                let nt=p+1
                if nt<tokc&&tokt(nt)==TT_ID {
                    w64(gvars+gvarc*16, tokv(nt)); w64(gvars+gvarc*16+8, tokln(nt))
                    if kt==20 { w64(g_named+gvarc*8, 1) } else { w64(g_named+gvarc*8, 0) }
                    // ginit: skip name and '='; for `global NAME` with no init it
                    // still points past '=', harmless (initializer is empty / 0).
                    w64(ginit+gvarc*8, nt+2)
                    gvarc=gvarc+1
                }
            }
            // ktext==19 -> `extern "C" global NAME` (imported cross-TU global)
            else if kt==19 {
                // Token stream: extern(KEY) "C"(STR) global(KEY) NAME(ID).
                // The string literal "C" is a single STR token at p+1.
                if p+3<tokc&&tokt(p+1)==TT_STR {
                    if tokt(p+2)==TT_KEY&&ktext(tokv(p+2),tokln(p+2))==20 {  // global
                        let nt=p+3
                        if nt<tokc&&tokt(nt)==TT_ID {
                            w64(gvars+gvarc*16, tokv(nt)); w64(gvars+gvarc*16+8, tokln(nt))
                            w64(g_named+gvarc*8, 2)   // imported (UNDEF named symbol)
                            w64(ginit+gvarc*8, 0)       // no initializer
                            gvarc=gvarc+1
                            // FIX (1.1.14): consume the whole `extern "C" global NAME`
                            // construct. Otherwise the inner `global` keyword (at p+2,
                            // depth 0) is re-scanned below as a fresh top-level
                            // `global NAME` and registered AGAIN as a DEFINED global
                            // (g_named=1). That spurious entry's __init initializer then
                            // spans the rest of the file (e.g. `fn bar(d){...}`), which
                            // references `d` with no binding -> "undeclared variable: d".
                            // Advance p to the NAME token; the loop's trailing p=p+1
                            // then lands just past it, skipping the inner `global`.
                            p = nt
                        }
                    }
                }
            }
        }
        p=p+1
    }
}

fn lbladd(l,ip) { let i=lblc; lblc=i+1; w64(lblmap+i*LBS,l); w64(lblmap+i*LBS+8,ip) }

fn lblf(l) { let i=0; while i<lblc { if r64(lblmap+i*LBS)==l { return r64(lblmap+i*LBS+8) }; i=i+1 }; return -1 }
// Record a forward/backward branch patch for the current function. ty: 0=jmp, 1=je.
// Resolved by ci_func's per-function label fixup (after emit_bltn runs).
fn emit_patch(po, lbl, ty) { w64(patches+patchc*PCS, po); w64(patches+patchc*PCS+8, lbl); w64(patches+patchc*PCS+16, ty); patchc=patchc+1 }

fn nv() { let v=vreg_n; vreg_n=vreg_n+1; w64(vreg_is_str + v*8, 0-1); return v }
fn nl() { let l=lbl_n; lbl_n=lbl_n+1; return l }

fn findfn(nm,nl) {
    let ai=0
    while ai<alias_c {
        if r64(alias_tab + ai*24 + 8)==nl {
            let ap=r64(alias_tab + ai*24); let m=0; let mm=1
            while m<nl { if r8(src+ap+m)!=r8(src+nm+m) { mm=0; break }; m=m+1 }
            if mm==1 { return r64(alias_tab + ai*24 + 16) }
        }
        ai=ai+1
    }
    let i=0
    while i<fnc {
        if fn_nlen(i)==nl {
            let ok=1; let j=0
            while j<nl { if r8(src+fn_name(i)+j)!=r8(src+nm+j) { ok=0; break }; j=j+1 }
            if ok { return i }
        }
        i=i+1
    }
    return -1
}
// t4: return the declared-param index of name (nm,nl) in function fi, or -1.
fn findparam(fi, nm, nl) {
    let base = r64(fn_pbase + fi*8)
    let pc = r64(fn_pcount + fi*8)
    let z=0
    while z<pc {
        let pnm = r64(fn_pnames + base + z*16)
        let pln = r64(fn_pnames + base + z*16 + 8)
        if pln==nl {
            let ok=1; let j=0
            while j<nl { if r8(src+pnm+j)!=r8(src+nm+j) { ok=0; break }; j=j+1 }
            if ok { return z }
        }
        z=z+1
    }
    return -1
}
// t4: length of a call-site named-arg name: scan from nm until ':' (58) or a
// generic delimiter. (nm points at the name ID, which is immediately followed
// by ': value' at the call site — so the name stops at the ':'.)
fn len_name_colon(nm) {
    let l=0
    while l<256 {
        let c0=r8(src+nm+l)
        if c0==58||c0==0||c0==40||c0==59||c0==123||c0==125||c0==44||c0==32||c0==9||c0==10||c0==13 { break }
        l=l+1
    }
    return l
}
// Length of a token-name stored as a raw source slice (up to the next
// delimiter: null, '(', ',', ';', '{', '}', space/tab/newline). Used to
// recover a function name's length from the IR_CALL name pointer.
fn len_name(nm) {
    let n=0
    while n<256 {
        let c=r8(src+nm+n)
        if c==0||c==40||c==59||c==123||c==125||c==44||c==32||c==9||c==10||c==13 { break }
        n=n+1
    }
    return n
}

// is_bltn: true if name (nm,nl) is a builtin that emit_bltn inlines at codegen.
// Mirrors emit_bltn's name checks so parse_primary emits IR_CALL for builtins.
// compile_error: record a hard compile error (call to undeclared function).
// We CANNOT call exit() from inside the parser (it would be emitted as a
// deferred target-call, not abort the compiler). Instead set had_error and
// print to stderr; main() checks had_error after the compile and exits(1).
let had_error = 0
fn compile_error(kind, nm, nl) {
    // kind: 0 = undeclared function call, 1 = undeclared variable, 2 = arity mismatch
    if kind==0 {
        let msg = "error: call to undeclared function: "
        file_write(2, msg+8, len(msg)); file_write(2, src+nm, nl)
    } else if kind==1 {
        let msg = "error: undeclared variable: "
        file_write(2, msg+8, len(msg)); file_write(2, src+nm, nl)
    } else {
        let msg = "error: wrong argument count for: "
        file_write(2, msg+8, len(msg)); file_write(2, src+nm, nl)
    }
    let nlch = "\n"
    file_write(2, nlch+8, 1)
    had_error = 1
}

fn is_bltn(nm,nl) {
    if nl>=8&&r8(src+nm)=='m'&&r8(src+nm+1)=='e'&&r8(src+nm+2)=='m'&&r8(src+nm+3)=='_' { return 1 } // mem_*
    if nl>=8&&r8(src+nm)=='f'&&r8(src+nm+1)=='i'&&r8(src+nm+2)=='l'&&r8(src+nm+3)=='e'&&r8(src+nm+4)=='_' { return 1 } // file_*
    if nl==4&&r8(src+nm)=='e'&&r8(src+nm+1)=='x'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='t' { return 1 } // exit
    if nl==4&&r8(src+nm)=='f'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='e'&&r8(src+nm+3)=='e' { return 1 } // free(ptr)
    if nl==4&&r8(src+nm)=='m'&&r8(src+nm+1)=='m'&&r8(src+nm+2)=='a'&&r8(src+nm+3)=='p' { return 1 } // mmap
    if nl==9&&r8(src+nm)=='m'&&r8(src+nm+1)=='e'&&r8(src+nm+2)=='m'&&r8(src+nm+3)=='_'&&r8(src+nm+4)=='a'&&r8(src+nm+5)=='l'&&r8(src+nm+6)=='l'&&r8(src+nm+7)=='o'&&r8(src+nm+8)=='c' { return 1 } // mem_alloc(n) -> ptr to n*8 bytes
    if nl==7&&r8(src+nm)=='p'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='n'&&r8(src+nm+4)=='t'&&r8(src+nm+5)=='s'&&r8(src+nm+6)=='p' { return 1 } // printsp(i)
    if nl==7&&r8(src+nm)=='p'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='n'&&r8(src+nm+4)=='t'&&r8(src+nm+5)=='l'&&r8(src+nm+6)=='n' { return 1 } // println(i)
    if nl==7&&r8(src+nm)=='n'&&r8(src+nm+1)=='e'&&r8(src+nm+2)=='w'&&r8(src+nm+3)=='l'&&r8(src+nm+4)=='i'&&r8(src+nm+5)=='n'&&r8(src+nm+6)=='e' { return 1 } // newline()
    if nl==6&&r8(src+nm)=='p'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='n'&&r8(src+nm+4)=='t'&&r8(src+nm+5)=='s' { return 1 } // prints(s)
    if nl==6&&r8(src+nm)=='p'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='n'&&r8(src+nm+4)=='t'&&r8(src+nm+5)=='i' { return 1 } // printi
    if nl==5&&r8(src+nm)=='p'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='n'&&r8(src+nm+4)=='t' { return 1 } // print(val) alias
    if nl==3&&r8(src+nm)=='l'&&r8(src+nm+1)=='e'&&r8(src+nm+2)=='n' { return 1 } // len
    if nl==3&&r8(src+nm)=='s'&&r8(src+nm+1)=='t'&&r8(src+nm+2)=='r' { return 1 } // str
    if nl==4&&r8(src+nm)=='p'&&r8(src+nm+1)=='u'&&r8(src+nm+2)=='s'&&r8(src+nm+3)=='h' { return 1 } // push
    if nl==3&&r8(src+nm)=='p'&&r8(src+nm+1)=='o'&&r8(src+nm+2)=='p' { return 1 } // pop
    if nl==6&&r8(src+nm)=='m'&&r8(src+nm+1)=='k'&&r8(src+nm+2)=='_'&&r8(src+nm+3)=='a'&&r8(src+nm+4)=='n'&&r8(src+nm+5)=='y' { return 1 } // mk_any(tag,val) -> 2-tuple
    if nl==3&&r8(src+nm)=='a'&&r8(src+nm+1)=='r'&&r8(src+nm+2)=='g' { return 1 } // arg(i) (variadic read)
    if nl==12&&r8(src+nm)=='c'&&r8(src+nm+1)=='l'&&r8(src+nm+2)=='o'&&r8(src+nm+3)=='s'&&r8(src+nm+4)=='u'&&r8(src+nm+5)=='r'&&r8(src+nm+6)=='e'&&r8(src+nm+7)=='_'&&r8(src+nm+8)=='c'&&r8(src+nm+9)=='a'&&r8(src+nm+10)=='l'&&r8(src+nm+11)=='l' { return 1 } // closure_call(fnb,args...)
    if nl==5&&r8(src+nm)=='f'&&r8(src+nm+1)=='n'&&r8(src+nm+2)=='p'&&r8(src+nm+3)=='t'&&r8(src+nm+4)=='r' { return 1 } // fnptr(FNAME) -> code ptr
    // --- Phase A1: unsigned arithmetic builtins (emit true unsigned x86) ---
    if nl==4&&r8(src+nm)=='u'&&r8(src+nm+1)=='d'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='v' { return 1 } // udiv(a,b): unsigned a/b
    if nl==4&&r8(src+nm)=='u'&&r8(src+nm+1)=='m'&&r8(src+nm+2)=='o'&&r8(src+nm+3)=='d' { return 1 } // umod(a,b): unsigned a%b
    if nl==3&&r8(src+nm)=='u'&&r8(src+nm+1)=='l'&&r8(src+nm+2)=='t' { return 1 } // ult(a,b): unsigned a<b -> 0/1
    if nl==3&&r8(src+nm)=='u'&&r8(src+nm+1)=='g'&&r8(src+nm+2)=='t' { return 1 } // ugt(a,b): unsigned a>b -> 0/1
    if nl==4&&r8(src+nm)=='u'&&r8(src+nm+1)=='l'&&r8(src+nm+2)=='t'&&r8(src+nm+3)=='e' { return 1 } // ulte(a,b): unsigned a<=b
    if nl==4&&r8(src+nm)=='u'&&r8(src+nm+1)=='g'&&r8(src+nm+2)=='t'&&r8(src+nm+3)=='e' { return 1 } // ugte(a,b): unsigned a>=b
    if nl==2&&r8(src+nm)=='u'&&r8(src+nm+1)=='8' { return 1 } // u8(x): mask to 8 bits
    if nl==3&&r8(src+nm)=='u'&&r8(src+nm+1)=='3'&&r8(src+nm+2)=='2' { return 1 } // u32(x): mask to 32 bits
    if nl==3&&r8(src+nm)=='u'&&r8(src+nm+1)=='6'&&r8(src+nm+2)=='4' { return 1 } // u64(x): identity at 64-bit runtime
    if nl==5&&r8(src+nm)=='p'&&r8(src+nm+1)=='a'&&r8(src+nm+2)=='n'&&r8(src+nm+3)=='i'&&r8(src+nm+4)=='c' { return 1 } // panic() -> exit(1)
    // P6.1a: float builtins (SSE on x86, NEON/FP on ARM). Args/results are raw
    // 64-bit bit-patterns; emit_bltn/arm_emit_bltn inline the FP op.
    if nl==3&&r8(src+nm)=='i'&&r8(src+nm+1)=='2'&&r8(src+nm+2)=='f' { return 1 } // i2f(x)
    if nl==3&&r8(src+nm)=='f'&&r8(src+nm+1)=='2'&&r8(src+nm+2)=='i' { return 1 } // f2i(x)
    if nl==4&&r8(src+nm)=='f'&&r8(src+nm+1)=='a'&&r8(src+nm+2)=='d'&&r8(src+nm+3)=='d' { return 1 } // fadd(a,b)
    if nl==4&&r8(src+nm)=='f'&&r8(src+nm+1)=='s'&&r8(src+nm+2)=='u'&&r8(src+nm+3)=='b' { return 1 } // fsub(a,b)
    if nl==4&&r8(src+nm)=='f'&&r8(src+nm+1)=='m'&&r8(src+nm+2)=='u'&&r8(src+nm+3)=='l' { return 1 } // fmul(a,b)
    if nl==4&&r8(src+nm)=='f'&&r8(src+nm+1)=='d'&&r8(src+nm+2)=='i'&&r8(src+nm+3)=='v' { return 1 } // fdiv(a,b)
    return 0
}

// === LEXER ===
fn isoc(c) {
    if c==33||c==37||c==38||c==42||c==43||c==45||c==47 { return 1 }
    if c==60||c==61||c==62||c==94||c==124||c==126 { return 1 }
    return 0
}

fn ispnct(c) {
    if c==40||c==41||c==44||c==46||c==58||c==59 { return 1 }
    if c==91||c==93||c==123||c==125 { return 1 }
    if c==63 { return 1 }  // '?' for unwrap/try operator
    return 0
}

fn isws(c) {
    if c==32||c==9||c==10||c==13 { return 1 }
    return 0
}

fn ialpha(c) {
    if c>=65 && c<=90 { return 1 }; if c>=97 && c<=122 { return 1 }
    if c==95 { return 1 }; return 0
}

fn idigit(c) { if c>=48 && c<=57 { return 1 }; return 0 }

fn ismop(p) {
    if p+1>=srclen { return 0 }
    let b1=r8(src+p); let b2=r8(src+p+1)
    if b1==61&&b2==61||b1==33&&b2==61 { return 1 }
    if b1==60&&b2==61||b1==62&&b2==61 { return 1 }
    if b1==61&&b2==62 { return 1 }  // => for match arms
    if b1==38&&b2==38||b1==124&&b2==124 { return 1 }
    if b1==60&&b2==60||b1==62&&b2==62 { return 1 }
    if b1==43&&b2==43||b1==45&&b2==45 { return 1 }
    if b1==43&&b2==61||b1==45&&b2==61 { return 1 }
    if b1==42&&b2==61||b1==47&&b2==61||b1==37&&b2==61 { return 1 }
    if b1==45&&b2==62 { return 1 }
    if b1==58&&b2==58 { return 1 }  // ::
    return 0
}

fn mopv(p) { return r8(src+p)*256+r8(src+p+1) }

fn tokenize() {
    tokc=0; let p=0; let l=1; let c=1
    while p<srclen {
        let ch=r8(src+p)
        if isws(ch) {
            p=p+1; if ch==10 { l=l+1; c=1 } else { c=c+1 }
        } else if ch==47&&p+1<srclen&&r8(src+p+1)==42 {   // /* block comment */
            p=p+2
            while p+1<srclen {
                if r8(src+p)==42 && r8(src+p+1)==47 { p=p+2; break }
                if r8(src+p)==10 { l=l+1; c=1 } else { c=c+1 }
                p=p+1
            }
        } else if ch==47&&p+1<srclen&&r8(src+p+1)==47 {
            p=p+2; while p<srclen&&r8(src+p)!=10 { p=p+1 }
            if p<srclen { p=p+1 }; l=l+1; c=1
        } else if ch==35 {   // '#' line comment (bash/python-style): skip to EOL
            p=p+1; while p<srclen&&r8(src+p)!=10 { p=p+1 }
            if p<srclen { p=p+1 }; l=l+1; c=1
        } else if ch==34 {
            let sl=l; let sc=c; let sp=p; p=p+1; c=c+1
            while p<srclen&&r8(src+p)!=34 {
                if r8(src+p)==92&&p+1<srclen { p=p+2; c=c+2 } else { p=p+1; c=c+1 }
            }
            if p>=srclen { exit(11) }; p=p+1; c=c+1
            stok(tokc,TT_STR,sp,sl,sc,p-sp); tokc=tokc+1
        } else if ch==39 {
            let sc=c; let cval=0
            if r8(src+p+1)==92 {
                let ec=r8(src+p+2)
                if ec==110 { cval=10 } else if ec==116 { cval=9 } else if ec==114 { cval=13 } else if ec==48 { cval=0 } else if ec==92 { cval=92 } else if ec==39 { cval=39 } else { cval=ec }
                p=p+4; c=c+4
            } else {
                cval=r8(src+p+1); p=p+3; c=c+3
            }
            stok(tokc,TT_NUM,cval,l,sc,1); tokc=tokc+1
        } else if idigit(ch) {
            let sp=p; let sc=c
            if ch==48 && p+1<srclen && (r8(src+p+1)==120 || r8(src+p+1)==88) {
                // hex literal 0x... / 0X...
                p=p+2; c=c+2
                let val=0
                let hdig=0
                while p<srclen {
                    let d=r8(src+p)
                    if d>=48&&d<=57 { val=(val*16 + (d-48)) & 0xFFFFFFFFFFFFFFFF; p=p+1; c=c+1; hdig=hdig+1 }
                    else if d>=97&&d<=102 { val=(val*16 + (d-87)) & 0xFFFFFFFFFFFFFFFF; p=p+1; c=c+1; hdig=hdig+1 }
                    else if d>=65&&d<=70 { val=(val*16 + (d-55)) & 0xFFFFFFFFFFFFFFFF; p=p+1; c=c+1; hdig=hdig+1 }
                    else { break }
                }
                // NEW-5: a bare `0x` / `0X` with no hex digits must not silently
                // compile to 0 — reject it as a malformed numeric literal.
                if hdig==0 {
                    let mh = "error: malformed hex literal (no digits after 0x)\n"
                    file_write(2, mh+8, len(mh)); exit(1)
                }
                stok(tokc,TT_NUM,val,l,sc,p-sp); tokc=tokc+1
            } else {
                let val=0
                while p<srclen {
                    let dch=r8(src+p)
                    if idigit(dch)==0 { break }
                    val=val*10+(dch-48)
                    p=p+1; c=c+1
                }
                let nlen=p-sp
                // Disambiguate float vs field-access '.':
                // A trailing '.' is a decimal point (float) ONLY when the
                // integer is a genuine literal (previous token is NOT '.')
                // AND the '.' is followed by a digit OR is at end-of-input
                // ('3.14' or dangling '1.'). Otherwise it is a field-access/
                // range dot ('.N', '.field', '..') and must be left for the
                // parser - never rejected here.
                if p<srclen&&r8(src+p)==46 {
                    let prevdot = (tokc>0 && tokt(tokc-1)==TT_PNCT && tokv(tokc-1)==46)
                    if prevdot==0 && ((p+1<srclen && idigit(r8(src+p+1))==1) || p+1>=srclen) {
                        let mf = "error: floating-point literals are not supported\n"
                        file_write(2, mf+8, len(mf)); exit(1)
                    }
                }
                stok(tokc,TT_NUM,val,l,sc,nlen); tokc=tokc+1
            }
        } else if ialpha(ch) {
            let sp=p; let sc=c
            while p<srclen {
                let c2=r8(src+p)
                if ialpha(c2)||idigit(c2)||c2==95 { p=p+1; c=c+1 } else { break }
            }
            let nl=p-sp
            let ty=TT_ID
            let kt = ktext(sp,nl)
            if kt!=0 { ty=TT_KEY }
            // P6.1b: check for unsigned/bool/char/byte type keywords
            if kt==8 || kt==9 || kt==10 || kt==11 || kt==12 { ty=TT_KEY }
            if kt==13 || kt==14 || kt==15 { ty=TT_KEY }
            // P6.1b: check for enum/match/type/interface/impl/trait/where/Option/Result keywords
            if kt==21 { 
              ty=TT_ENUM 
            }
            else if kt==22 { ty=TT_MATCH }
            else if kt==23 { ty=TT_TYPE }
            else if kt==24 { ty=TT_INTERFACE }
            else if kt==25 { ty=TT_IMPL }
            else if kt==26 { ty=TT_TRAIT }
            else if kt==27 { ty=TT_WHERE }
            else if kt==28 { ty=TT_ID }   // Option: plain ID; parse paths use ktext()
            else if kt==29 { ty=TT_ID }   // Some
            else if kt==30 { ty=TT_ID }   // None
            else if kt==31 { ty=TT_ID }   // Result
            else if kt==32 { ty=TT_ID }   // Ok
            else if kt==33 { ty=TT_ID }   // Err
            else if kt==34 { ty=TT_REF }
            else if kt==35 { ty=TT_MUT }
            else if kt==36 { ty=TT_MOVE }
            else if kt==37 { ty=TT_STRING }
            // P9: "for" keyword (ktext=7)
            else if kt==7 { ty=TT_KEY }
            // P6: Low-level keywords
            else if kt==38 { ty=TT_RAW }      // raw
            else if kt==39 { ty=TT_VOLATILE } // volatile
            else if kt==40 { ty=TT_ASM }      // asm
            else if kt==41 { ty=TT_AS }       // as
            else if kt==42 { ty=TT_USIZE }    // usize
            // P7: panic keyword
            else if kt==H_PANIC { ty=TT_PANIC }
            // P8: struct keyword
            else if kt==H_STRUCT { ty=TT_STRUCT }
            // P10: 'in' keyword for for-in loops
            else if kt==H_IN { ty=TT_IN }
        stok(tokc,ty,sp,l,sc,nl); tokc=tokc+1
        } else if ismop(p) {
            stok(tokc,TT_OP,mopv(p),l,c,2); tokc=tokc+1; p=p+2; c=c+2
        } else if isoc(ch) {
            stok(tokc,TT_OP,ch,l,c,1); tokc=tokc+1; p=p+1; c=c+1
        } else if ispnct(ch) {
            stok(tokc,TT_PNCT,ch,l,c,1); tokc=tokc+1; p=p+1; c=c+1
        } else { exit(12) }
    }
}

// === FUNCTION SCANNER ===
fn scanfns() {
    fnc=0; let p=0
    while p<tokc {
        // P9: skip trait/interface blocks entirely (their `fn`s are body-less
        // method declarations, not top-level functions).
        if tokt(p)==TT_TRAIT || tokt(p)==TT_INTERFACE {
            let sd=0; let sj=p
            while sj<tokc {
                if tokt(sj)==TT_PNCT {
                    if tokv(sj)==123 { sd=sd+1 }
                    else if tokv(sj)==125 { sd=sd-1; if sd==0 { sj=sj+1; break } }
                }
                sj=sj+1
            }
            p=sj
            continue
        }
        // P3: check for extern "C" fn
        let is_extern = 0
        if tokt(p)==TT_KEY&&ktext(tokv(p),tokln(p))==19 {
            // extern keyword found - check for "C"
            // The string literal "C" is a SINGLE STR token (no separate quote
            // tokens), so it sits at p+1. Advance p to p+2 to land on the next
            // keyword. ONLY treat it as a function extern if that keyword is
            // `fn` (ktext 1); `extern "C" global NAME` is a DATA import and is
            // handled by scan_globals, not here.
            let np = p+1
            if np<tokc && tokt(np)==TT_STR {
                let nk = p+2
                if nk<tokc && tokt(nk)==TT_KEY && ktext(tokv(nk),tokln(nk))==1 {
                    // Found `extern "C" fn` - advance past extern + the "C" token.
                    is_extern = 1
                    p = np + 1
                }
            }
        }
        if tokt(p)==TT_KEY&&ktext(tokv(p),tokln(p))==1 {
            let nt=p+1
            // Capture the signature-scan start IMMEDIATELY, before any other
            // local assignment can alias the slot qc-1.0.1 places `nt` in.
            let kstart = nt + 1
            if nt<tokc&&tokt(nt)==TT_ID {
                let nm=tokv(nt); let nl=tokln(nt)
                let d=0; let bp=0; let j=nt+1
                // Scan signature: count fixed params + detect trailing ...
                let pcnt=0; let isvar=0; let depth=0; let k=kstart
                let pnbase = fn_poff   // capture START offset BEFORE storing params
                let saw_param = 0
                let last_param_tok = -1   // t5: token index of the most recent param ID
                let pdfixed = 0           // t5: count of leading params with NO default
                let in_default = 0        // t5: 1 while scanning a '= expr' (skip its IDs/...)
                while k<tokc {
                    let tk=tokt(k)
                    // t5: a default expression ends at the param terminator.
                    if in_default==1 && tk==TT_PNCT {
                        let tv=tokv(k)
                        if tv==44 { in_default=0 }       // ',' -> next param starts
                        else if tv==41 { in_default=0 }   // ')' -> end of signature
                        else if tv==46 && k+2<tokc && tokt(k+1)==TT_PNCT && tokv(k+1)==46 && tokt(k+2)==TT_PNCT && tokv(k+2)==46 { in_default=0 }  // '...' -> next param
                    }
                    if tk==TT_PNCT {
                        let tv=tokv(k)
                        if tv==40 { depth=depth+1 }       // '('
                        else if tv==41 { break }          // ')'
                        else if depth==1 && tv==44 { pcnt=pcnt+1 }  // top-level ','
                        // detect '...' = three consecutive '.' puncts (value 46)
                        else if depth==1 && in_default==0 && tv==46 && k+2<tokc && tokt(k+1)==TT_PNCT && tokv(k+1)==46 && tokt(k+2)==TT_PNCT && tokv(k+2)==46 {
                            isvar=1; k=k+2   // skip the next two dots
                        }
                    }
                    // t5: detect '= default' for the current param.
                    // NOTE: '=' is TT_OP (value 61), not TT_PNCT.
                    if tk==TT_OP && tokv(k)==61 && last_param_tok>=0 {
                        // default expr spans [k+1 .. end of this param].
                        // end = next ',' / ')' / '...' at depth 1, or tokc.
                        let de=k+1; let dend=de
                        while dend<tokc {
                            let dtk=tokt(dend); let dtv=tokv(dend)
                            if dtk==TT_PNCT {
                                if dtv==44 { dend=dend+1; break }       // ','
                                if dtv==41 { dend=dend+1; break }       // ')'
                                if dtv==46 && dend+2<tokc && tokt(dend+1)==TT_PNCT && tokv(dend+1)==46 && tokt(dend+2)==TT_PNCT && tokv(dend+2)==46 { dend=dend+1; break }  // '...'
                            }
                            dend=dend+1
                        }
                        w64(fn_defargs + (fnc*64 + saw_param - 1)*16, de)
                        w64(fn_defargs + (fnc*64 + saw_param - 1)*16 + 8, dend)
                        in_default = 1   // t5: skip the default expr's IDs/... until terminator
                    }
                    if depth==1 && in_default==0 && tk==TT_ID {
                        w64(fn_pnames + fn_poff, tokv(k)); fn_poff=fn_poff+8; w64(fn_pnames + fn_poff, tokln(k)); fn_poff=fn_poff+8
                        saw_param=saw_param+1
                        last_param_tok=k
                        // Phase 4.3: skip an optional `: Type` annotation so the
                        // type name is NOT counted as a phantom parameter.
                        if k+2<tokc && tokt(k+1)==TT_PNCT && tokv(k+1)==58 && (tokt(k+2)==TT_ID || tokt(k+2)==TT_KEY) {
                            k = k+2   // skip ':' and the type name
                        }
                    }
                    k=k+1
                }
                // t4: store param names into fn_pnames (flat [ptr,len] per param).
                // Use saw_param (direct param-ID count) for the true param count,
                // not the comma count (comma count = N-1 and is fragile here).
                w64(fn_pcount + fnc*8, saw_param)
                w64(fn_pbase + fnc*8, pnbase)
                // t5: count leading params (from index 0) that have NO default ->
                // the mandatory minimum arg count at the call site.
                let pfz=0
                while pfz<saw_param {
                    let dr = r64(fn_defargs + (fnc*64 + pfz)*16)
                    if dr==0 { pfz=pfz+1 } else { break }
                }
                w64(fn_pdfixed + fnc*8, pfz)
                while j<tokc {
                    if tokt(j)==TT_PNCT {
                        if tokv(j)==123 { if d==0&&bp==0 { bp=j }; d=d+1 }
                        if tokv(j)==125 { d=d-1; if d<=0 { j=j+1; break } }
                        // extern "C" fn decl has no body; terminate at ';'
                        if is_extern==1 && tokv(j)==59 { j=j+1; break }
                    }
                    j=j+1
                }
                sfn(fnc,nm,nl,bp,0,saw_param)
            fnc=fnc+1; p=j
            } else { p=p+1 }
        } else { p=p+1 }
    }
}

fn scan_aliases() {
    let p=0
    while p<tokc {
        if tokt(p)==TT_KEY && ktext(tokv(p),tokln(p))==17 {
            if p+3<tokc && tokt(p+1)==TT_ID && tokt(p+2)==TT_OP && tokv(p+2)==61 && tokt(p+3)==TT_ID {
                let anm=tokv(p+1); let anl=tokln(p+1)
                let tnm=tokv(p+3); let tnl=tokln(p+3)
                let tfi=findfn(tnm, tnl)
                if tfi>=0 {
                    w64(alias_tab + alias_c*24, anm); w64(alias_tab + alias_c*24 + 8, anl)
                    w64(alias_tab + alias_c*24 + 16, tfi)
                    alias_c=alias_c+1
                }
            }
        }
        p=p+1
    }
}

// P9: Scan for trait declarations (trait Name { fn method(...) ... })
fn scantraits() {
  let p = 0
  while p < tokc {
    if tokt(p) == TT_TRAIT {
      let nt = p+1
      if nt<tokc && tokt(nt)==TT_ID {
        let onm = tokv(nt); let onl = tokln(nt)
        let bp = nt+1
        while bp<tokc && !(tokt(bp)==TT_PNCT && tokv(bp)==123) { bp = bp+1 }
        if bp<tokc {
          let ti = g_traitc; g_traitc = ti + 1
          w64(tdefs + ti*80, onm); w64(tdefs + ti*80 + 8, onl)
          w64(tdefs + ti*80 + 24, ti*32)   // method base = ti*32 (32 method slots/trait)
          let mc = 0; let cp = bp+1
          while cp<tokc && !(tokt(cp)==TT_PNCT && tokv(cp)==125) {
            if tokt(cp)==TT_KEY && ktext(tokv(cp),tokln(cp))==1 {  // fn keyword
              let mnm = tokv(cp+1); let mnl = tokln(cp+1)
              if mc < 32 {  // bounds check
                let slot = (ti*32 + mc)*24
                w64(tmethods + slot, mnm); w64(tmethods + slot + 8, mnl)
                // count params and check return type (simplified for now)
                let pc = 0; let rp = cp+2
                let depth = 0
                while rp<tokc {
                  let tk = tokt(rp); let tv = tokv(rp)
                  if tk==TT_PNCT {
                    if tv==40 { depth = depth+1 }
                    else if tv==41 { depth = depth-1; if depth==0 { break } }
                    else if depth==1 && tv==44 { pc = pc+1 }
                  }
                  rp = rp+1
                }
                w64(tmethods + slot + 16, pc)  // param count
                w64(tmethods + slot + 24, 0-1) // ret struct (simplified)
                mc = mc+1
              }
              cp = rp
            }
            cp = cp+1
          }
          w64(tdefs + ti*80 + 16, mc)
        }
      }
    }
    p = p+1
  }
}

// P9: Scan for impl blocks (impl Trait for Struct { fn method(...) ... })
fn scanimpls() {
  let p = 0
  while p < tokc {
    if tokt(p) == TT_IMPL {
      let nt = p+1
      if nt<tokc && tokt(nt)==TT_ID {  // trait name is an ID, not TT_TRAIT
        let tnm = tokv(nt); let tnl = tokln(nt)
        let nf = nt+1
        if nf<tokc && ktext(tokv(nf),tokln(nf))==7 {  // "for" keyword (ktext=7)
          let snm = tokv(nf+1); let snl = tokln(nf+1)
          let bp = nf+2
          while bp<tokc && !(tokt(bp)==TT_PNCT && tokv(bp)==123) { bp = bp+1 }
          if bp<tokc {
            // find trait index
            let ti = 0; let found_t = 0
            let tcv = g_traitc
            while ti < tcv {
              let onm = r64(tdefs + ti*80); let onl = r64(tdefs + ti*80 + 8)
              if onl == tnl {
                let ok = 1; let k = 0
                while k < tnl { if r8(src+onm+k) != r8(src+tnm+k) { ok = 0; break }; k = k+1 }
                if ok == 1 { found_t = 1; break }
              }
              ti = ti+1
            }
            // find struct index
            let si = 0; let found_s = 0
            while si < structc {
              let onm = r64(sdefs + si*64); let onl = r64(sdefs + si*64 + 8)
              if onl == snl {
                let ok = 1; let k = 0
                while k < snl { if r8(src+onm+k) != r8(src+snm+k) { ok = 0; break }; k = k+1 }
                if ok == 1 { found_s = 1; break }
              }
              si = si+1
            }
            if found_t == 1 && found_s == 1 {
              let ii = g_implc; g_implc = ii + 1
              w64(idefs + ii*96, ti); w64(idefs + ii*96 + 8, si)
              w64(idefs + ii*96 + 24, ii*32)   // method base = ii*32
              let mc = 0; let cp = bp+1
              while cp<tokc && !(tokt(cp)==TT_PNCT && tokv(cp)==125) {
                if tokt(cp)==TT_KEY && ktext(tokv(cp),tokln(cp))==1 {  // fn keyword
                  let mnm = tokv(cp+1); let mnl = tokln(cp+1)
                  let slot = (ii*32 + mc)*32
                  // find matching trait method index
                  let tmi = 0; let found_tm = 0
                  while tmi < r64(tdefs + ti*80 + 16) {
                    let tmnm = r64(tmethods + (ti*32 + tmi)*24)
                    let tmnl = r64(tmethods + (ti*32 + tmi)*24 + 8)
                    if tmnl == mnl {
                      let ok = 1; let k = 0
                      while k < mnl { if r8(src+tmnm+k) != r8(src+mnm+k) { ok = 0; break }; k = k+1 }
                      if ok == 1 { found_tm = 1; break }
                    }
                    tmi = tmi+1
                  }
                  if found_tm == 1 {
                    if mc < 32 {  // bounds check
                      w64(imethods + slot, tmi)  // trait method index
                      // find function index
                      let fi = 0; let found_f = 0
                      while fi < fnc {
                        if fn_nlen(fi) == mnl {
                          let fnm = fn_name(fi)
                          let ok = 1; let k = 0
                          while k < mnl { if r8(src+fnm+k) != r8(src+mnm+k) { ok = 0; break }; k = k+1 }
                          if ok == 1 { found_f = 1; break }
                        }
                        fi = fi+1
                      }
                      w64(imethods + slot + 8, fi)
                      // P9: tag impl method `self` (param 0) with the struct
                      w64(fn_partype + (fi*200 + 0)*8, si)
                      mc = mc+1
                    }
                  }
                  cp = cp+1
                }
                cp = cp+1
              }
              w64(idefs + ii*96 + 16, mc)
            }
          }
        }
      }
    }
    p = p+1
  }
}

// P9: struct literal `Name { f: e, ... }` -> rewrite to `Name(e, ...)`
// constructor-call tokens IN PLACE, so parse_primary (which only understands
// `Name(...)`) never sees the new syntax. Runs after scanstructs so struct
// names are known. The parser then treats it exactly like a constructor call.
fn rewrite_struct_literals() {
    let p = 0
    while p < tokc {
        if tokt(p)==TT_ID {
            // inline findstruct(tokv(p), tokln(p)) — no user-fn calls (clobber)
            let nm = tokv(p); let nl = tokln(p)
            let si = 0-1
            let su = 0
            while su < structc {
                if r64(sdefs + su*64 + 8)==nl {
                    let sp = r64(sdefs + su*64); let sm = 0; let smatch = 1
                    while sm < nl { if r8(src+sp+sm)!=r8(src+nm+sm) { smatch=0; break }; sm=sm+1 }
                    if smatch==1 { si = su; break }
                }
                su = su+1
            }
            // skip declaration contexts: `struct Name {`, `impl ... for Name {`,
            // `trait Name {` — only rewrite in EXPRESSION position.
            let prev_ok = 1
            if p>=1 {
                let pv = tokv(p-1); let pl = tokln(p-1)
                // byte-compare regardless of token type (struct/impl/trait/for
                // are TT_ID here)
                if pl==6 && r8(src+pv)=='s'&&r8(src+pv+1)=='t'&&r8(src+pv+2)=='r'&&r8(src+pv+3)=='u'&&r8(src+pv+4)=='c'&&r8(src+pv+5)=='t' { prev_ok = 0 }  // struct
                if pl==4 && r8(src+pv)=='i'&&r8(src+pv+1)=='m'&&r8(src+pv+2)=='p'&&r8(src+pv+3)=='l' { prev_ok = 0 }  // impl
                if pl==5 && r8(src+pv)=='t'&&r8(src+pv+1)=='r'&&r8(src+pv+2)=='a'&&r8(src+pv+3)=='i'&&r8(src+pv+4)=='t' { prev_ok = 0 }  // trait
                if pl==3 && r8(src+pv)=='f'&&r8(src+pv+1)=='o'&&r8(src+pv+2)=='r' { prev_ok = 0 }  // for (impl Trait for Struct)
                if pl==9 && r8(src+pv)=='i'&&r8(src+pv+1)=='n'&&r8(src+pv+2)=='t'&&r8(src+pv+3)=='e'&&r8(src+pv+4)=='r'&&r8(src+pv+5)=='f'&&r8(src+pv+6)=='a'&&r8(src+pv+7)=='c'&&r8(src+pv+8)=='e' { prev_ok = 0 }  // interface
            }
            if si>=0 && prev_ok==1 && p+1<tokc && tokt(p+1)==TT_PNCT && tokv(p+1)==123 {
                // scan to matching '}' (depth-tracked, skip nested)
                let depth = 1
                let end = 0-1
                let q = p+2
                while q<tokc {
                    if tokt(q)==TT_PNCT {
                        if tokv(q)==123 { depth = depth+1 }
                        else if tokv(q)==125 { depth = depth-1; if depth==0 { end = q; break } }
                    }
                    q = q+1
                }
                if end>=0 {
                    // rewrite '{' -> '(' and '}' -> ')'
                    w64(toks + (p+1)*TKS, TT_PNCT); w64(toks + (p+1)*TKS + 8, 40)
                    w64(toks + end*TKS, TT_PNCT); w64(toks + end*TKS + 8, 41)
                    // drop field-name + ':' token pairs inside the braces.
                    // Pattern: TT_ID followed by ':' (58) is a field name.
                    let w = p+2
                    let r = p+2
                    while r < end {
                        if tokt(r)==TT_ID && r+1<end && tokt(r+1)==TT_PNCT && tokv(r+1)==58 {
                            r = r+2   // skip the field name and ':'
                        } else {
                            if w != r {
                                // copy token r -> w (5 qwords)
                                w64(toks + w*TKS,     tokt(r))
                                w64(toks + w*TKS + 8,  tokv(r))
                                w64(toks + w*TKS + 16, tokl(r))
                                w64(toks + w*TKS + 24, tokc(r))
                                w64(toks + w*TKS + 32, tokln(r))
                            }
                            w = w+1
                            r = r+1
                        }
                    }
                    // move the rewritten ')' token to position w
                    if w != end {
                        w64(toks + w*TKS,     TT_PNCT)
                        w64(toks + w*TKS + 8,  41)
                        w64(toks + w*TKS + 16, tokl(end))
                        w64(toks + w*TKS + 24, tokc(end))
                        w64(toks + w*TKS + 32, tokln(end))
                        // shift everything after end down by (end - w)
                        let gap = end - w
                        let s = end + 1
                        while s < tokc {
                            w64(toks + (s-gap)*TKS,     tokt(s))
                            w64(toks + (s-gap)*TKS + 8,  tokv(s))
                            w64(toks + (s-gap)*TKS + 16, tokl(s))
                            w64(toks + (s-gap)*TKS + 24, tokc(s))
                            w64(toks + (s-gap)*TKS + 32, tokln(s))
                            s = s+1
                        }
                        tokc = tokc - gap
                    }
                }
            }
        }
        p = p+1
    }
}

// === PARSER STATE ===
fn peek() { if tokp>=tokc { return TT_EOF }; return tokt(tokp) }
fn pval() { if tokp>=tokc { return 0 }; return tokv(tokp) }
fn plen() { if tokp>=tokc { return 0 }; return tokln(tokp) }
fn adv() { if tokp<tokc { tokp=tokp+1 } }

fn mkw(h) {
    if peek()!=TT_KEY { return 0 }
    if khash(pval(),plen())!=h { return 0 }; adv(); return 1
}

fn mpnct(v) {
    if peek()!=TT_PNCT||pval()!=v { return 0 }; adv(); return 1
}

fn mop(v) {
    if peek()!=TT_OP||pval()!=v { return 0 }; adv(); return 1
}

// === PARSE BLOCK → IR ===
let lbl_brk = mmap(800); let lbl_cont = mmap(800); let lbl_stk = 0
// P2 ownership: per-loop scope-count stack for break/continue (free the loop
// body scope + nested scopes when jumping out).
let loop_scope_stk = mmap(256*8); let loop_scope_top = 0

fn parse_block() {
    let my_scope = owned_sctop
    owned_scope_push()
    // P7: track block nesting depth (function body = 1, nested blocks > 1) so
    // match-as-last-statement only emits IR_RET at the function-body level.
    let was_fn = in_fn_body
    if in_fn_body==0 { in_fn_body = 1 }
    blk_depth = blk_depth + 1
    while true {
        if peek()==TT_EOF { break }
        if peek()==TT_PNCT&&pval()==125 { break }
        if peek()==TT_PNCT&&pval()==59 { adv(); continue }
        let t=peek(); let v=pval(); let ln=plen()
        if t==TT_KEY {
            let h=ktext(v,ln)
            if h==16 { parse_ret() }
            else if h==2 { parse_let() }
            else if h==3 { parse_if() }
            else if h==6 { parse_while() }
            else if h==5 { parse_loop() }
            else if h==7 { parse_for() }
            else if h==8 {
                adv()
                if lbl_stk>0 { owned_pop_to(r64(loop_scope_stk+(loop_scope_top-1)*8)); let lb=r64(lbl_brk+(lbl_stk-1)*8); iremit(IR_JMP,0,lb,0,0) }
            } else if h==9 {
                adv()
                if lbl_stk>0 { owned_pop_to(r64(loop_scope_stk+(loop_scope_top-1)*8)); let lb=r64(lbl_cont+(lbl_stk-1)*8); iremit(IR_JMP,0,lb,0,0) }
            } else if h==17 { adv(); adv(); adv(); adv() }   // t6: alias NAME = FNNAME (skip; registered by scan_aliases)
            else if h==18 { parse_unsafe() }   // G1: unsafe { ... } block (safe-by-default fence)
            else if h==22 { 
                let mv = parse_match()
                // P7: implicit return — if this match is the last statement of a
                // function body (next token is '}' closing the body), emit IR_RET
                // with the match result. Without this, the function-end IR_RET -1
                // relies on "last op leaves result in rax", which match breaks
                // (arms store res_vr then jmp to the shared end label).
                if in_fn_body==1 && blk_depth==1 && peek()==TT_PNCT && pval()==125 { iremit(IR_RET,0,mv,0,0) }
            }
            else { adv() }
        } else if t==TT_MATCH {
            let mv = parse_match()
            // P7: implicit return (same as the h==22 keyword path): if this match
            // is the last statement of the function body, return its value.
            if in_fn_body==1 && blk_depth==1 && peek()==TT_PNCT && pval()==125 { iremit(IR_RET,0,mv,0,0) }
        } else if t==TT_ID {
            let nxt=tokp+1
            // G2: a[idx] = v  (subscript assignment) — look past one [..] bracket
            if nxt<tokc&&tokt(nxt)==TT_PNCT&&tokv(nxt)==91 {
                let close=tokp+2; let depth=1
                while close<tokc&&depth>0 { if tokt(close)==TT_PNCT&&tokv(close)==91 { depth=depth+1 } else if tokt(close)==TT_PNCT&&tokv(close)==93 { depth=depth-1 }; close=close+1 }
                if close<tokc&&tokt(close)==TT_OP&&tokv(close)==61 { parse_assign() }
                else { parse_expr() }
            } else if nxt<tokc&&tokt(nxt)==TT_OP&&tokv(nxt)==61 { parse_assign() }
            else { parse_expr() }
        } else if t==TT_PNCT&&v==123 {    // nested bare block: { ... }
            adv(); parse_block(); mpnct(125)
        } else if t==TT_NUM||t==TT_STR||t==TT_OP||t==TT_PNCT {
            parse_expr()
        } else { break }
    }
    owned_scope_pop_one(my_scope)
    blk_depth = blk_depth - 1
    if was_fn==0 { in_fn_body = 0 }
}

fn parse_unsafe() {
    // G1/G2: `unsafe { ... }` — the opt-in escape for low-level primitives AND
    // the opt-OUT of runtime safety checks (overflow trap). Sets unsafe_depth so
    // every IR op emitted while parsing the inner block is flagged in ir_unsafe
    // and the overflow trap is suppressed for it. User code outside unsafe{} stays
    // trapped (secure by default). The compiler wraps its own deliberate-overflow
    // internals (compute_magic, loop-strength) in unsafe{} so self-host stays green.
    adv()                                   // consume `unsafe`
    unsafe_count = unsafe_count + 1
    if !(peek()==TT_PNCT && pval()==123) {  // require `{`
        let mb = "error: malformed 'unsafe' — expected '{'\n"
        file_write(2, mb+8, len(mb)); had_error = 1
        return
    }
    adv()                                    // consume `{`
    unsafe_depth = unsafe_depth + 1
    parse_block()                            // parse inner statements (flagged)
    mpnct(125)                               // consume `}`
    unsafe_depth = unsafe_depth - 1
}

fn parse_ret() {
  adv()
  // P2 ownership: return exits the function -> free ALL compiler-owned bindings
  // (every live scope). Idempotent: the function-body block's trailing pop then
  // becomes a no-op.
  owned_pop_all()
  // bare 'return;' or 'return}' (no expression) -> IR_RET with no value (-1)
  if peek()==TT_PNCT&&(pval()==59||pval()==125) { iremit(IR_RET,0,-1,0,0); return }
  // t7: multiple-return: `return a, b, c` packs values into a tuple and
  // returns the pointer. This comma path never runs during self-host
  // (compiler source uses single-value returns), so it is hazard-safe.
  let e0=parse_expr(); let vals=e0; let cnt=1
  if peek()==TT_PNCT&&pval()==44 {
    let arr=mmap(8000)
    w64(arr+0*8, e0); let acc=1
    while peek()==TT_PNCT&&pval()==44 {
      adv(); let ev=parse_expr(); w64(arr+acc*8, ev); acc=acc+1
    }
    vals=arr; cnt=acc
  }
  if cnt>1 {
    let tr=nv(); iremit(IR_TALLOC,tr,cnt,0,0)   // tr = mem_alloc(cnt)
    let ci=0
    while ci<cnt {
      let vv=r64(vals+ci*8); let fi=nv(); iremit(IR_CONST,fi,ci,0,0)
      iremit(IR_ISTORE,0,tr,fi,vv)
      ci=ci+1
    }
    iremit(IR_RET,0,tr,0,0)
  } else {
    iremit(IR_RET,0,e0,0,0)
  }
}

fn parse_let() {
    adv(); let nm=pval(); let nl=plen(); adv()
    // t7: multiple-return destructuring: `let a, b, c = f()` binds each name
    // to tup.<i>. This comma path never runs during self-host (compiler source
    // uses single-name let), so it is hazard-safe.
    if peek()==TT_PNCT&&pval()==44 {
        let names=mmap(8000); let lens=mmap(8000); w64(names+0*8,nm); w64(lens+0*8,nl); let nc=1
        while peek()==TT_PNCT&&pval()==44 {
            adv()
            if peek()==TT_ID { let nn=pval(); let nl2=plen(); adv(); w64(names+nc*8,nn); w64(lens+nc*8,nl2); nc=nc+1 }
        }
        mop(61)
        let rv=parse_expr()   // rv = the tuple pointer returned by f()
        let ci=0
        while ci<nc {
            let nn=r64(names+ci*8); let nl2=r64(lens+ci*8)
            let vr=nv(); let fi=nv(); iremit(IR_CONST,fi,ci,0,0)
            iremit(32,vr,rv,fi,0); vadd(nn,nl2,vr)
            ci=ci+1
        }
        return
    }
    
    // P6.1b: optional type annotation after name: `let x: u64 = 5`
    // Must check for type annotation BEFORE consuming '=' and parsing expression
    let vtype = 0
    if peek()==TT_PNCT && pval()==58 {
        adv()  // consume ':'
        if peek()==TT_KEY {
            let hk = ktext(pval(), plen())
            // ktext returns small keyword IDs: u8=44, u16=45, u32=46, u64=47, usize=48, bool=49, char=50, byte=51, mut=35
            if hk==44 { vtype = 1 }
            else if hk==45 { vtype = 2 }
            else if hk==46 { vtype = 3 }
            else if hk==47 { vtype = 4 }
            else if hk==48 { vtype = 5 }
            else if hk==49 { vtype = 6 }
            else if hk==50 { vtype = 7 }
            else if hk==51 { vtype = 8 }
            else if hk==35 { vtype = 9 }  // mut
            else { vtype = 0 }
            adv()  // consume type keyword
        }
    }
    
    mop(61)
    let v=parse_expr(); let vr=nv(); iremit(IR_MOV,vr,v,0,0); vadd(nm,nl,vr)
    let vsi = r64(vreg_struct + v*8)
    if vsi>=0 { w64(vreg_struct + vr*8, vsi) }
    let vss = r64(vreg_is_str + v*8)
    if vss>=0 { w64(vreg_is_str + vr*8, vss) }
    // P6.1b: tag the vreg with its declared type (if any)
    if vtype>0 { w64(vreg_type + vr*8, vtype) }
    // P2 ownership: if RHS was a direct `mem_alloc(...)` call, this binding is
    // compiler-owned -> free it automatically at scope exit. Detect by peeking
    // the last IR record: IR_CALL whose callee name is `mem_alloc` (9 chars).
    let last = irc - 1
    if last>=0 {
        let lop = irop(last)
        if lop==IR_CALL {
            let cnm = ira1(last); let cnl = ira2(last)
            if cnl==9 && r8(src+cnm)=='m' && r8(src+cnm+1)=='e' && r8(src+cnm+2)=='m' && r8(src+cnm+3)=='_' && r8(src+cnm+4)=='a' && r8(src+cnm+5)=='l' && r8(src+cnm+6)=='l' && r8(src+cnm+7)=='o' && r8(src+cnm+8)=='c' {
                w64(vreg_owned + vr*8, 1)
                owned_add(vr)
            }
        }
    }
}

fn parse_assign() {
    let nm=pval(); let nl=plen()
    adv()                     // consume the name
    // G2: detect a[idx] = v  (subscript assignment, local array only)
    if peek()==TT_PNCT&&pval()==91 {
        adv()                     // consume '['
        let idx=parse_expr()
        mpnct(93)                 // ']'
        mop(61)                   // '='
        let v=parse_expr()
        let f=vfind(nm,nl)
        if f>=0 { iremit(IR_ISTORE, 0, f, idx, v); return 0 }
        compile_error(1, nm, nl)  // undeclared base (global subscript-assign not impl)
    }
    mop(61); let v=parse_expr()
    let f=vfind(nm,nl); if f>=0 { iremit(IR_MOV,f,v,0,0); return 0 }
    let g=gfind(nm,nl); if g>=0 { iremit(IR_STOREG,0,v,g) }
}

fn parse_if() {
    adv(); let cv=parse_expr(); let el=nl(); let en=nl()
    iremit(IR_BR,0,cv,el,en)
    mpnct(123); parse_block(); mpnct(125)
    iremit(IR_JMP,0,en,0,0); iremit(IR_LABEL,0,el,0,0)
    if peek()==TT_KEY&&ktext(pval(),plen())==4 {
        adv()
        if peek()==TT_KEY&&ktext(pval(),plen())==3 { parse_if() }
        else if peek()==TT_PNCT&&pval()==123 { mpnct(123); parse_block(); mpnct(125) }
    }
    iremit(IR_LABEL,0,en,0,0)
}

fn parse_while() {
    adv()
    let st=nl(); let en2=nl(); let ct=nl()
    lbl_stk=lbl_stk+1; let bi=lbl_stk-1
    w64(lbl_brk+bi*8,en2); w64(lbl_cont+bi*8,ct)
    iremit(IR_LABEL,0,st,0,0); let cv=parse_expr()
    iremit(IR_BR,0,cv,en2,ct); iremit(IR_LABEL,0,ct,0,0)
    w64(loop_scope_stk + loop_scope_top*8, owned_sctop); loop_scope_top=loop_scope_top+1
    mpnct(123); parse_block(); mpnct(125)
    loop_scope_top=loop_scope_top-1
    iremit(IR_JMP,0,st,0,0); iremit(IR_LABEL,0,en2,0,0)
    lbl_stk=bi
}

fn parse_loop() {
    adv(); let st=nl(); let en2=nl()
    lbl_stk=lbl_stk+1; let bi=lbl_stk-1
    w64(lbl_brk+bi*8,en2); w64(lbl_cont+bi*8,st)
    iremit(IR_LABEL,0,st,0,0)
    mpnct(123); parse_block(); mpnct(125)
    iremit(IR_JMP,0,st,0,0); iremit(IR_LABEL,0,en2,0,0)
    lbl_stk=bi
}

fn parse_for() {
    adv(); let nm=pval(); let nl2=plen(); adv()
    // P10: check for for-in syntax: `for item in arr`
    // After the loop variable, if next token is 'in' (TT_IN), use for-in path.
    if peek()==TT_IN {  // 'in'
        adv()  // consume 'in'
        let iter=parse_expr()  // the array/iterable expression
        mpnct(123)  // consume '{'
        // Register the loop variable
        let vr=nv(); vadd(nm,nl2,vr)
        // For-in loop: DO-WHILE pattern with condition at bottom (like while's parse_expr at label)
        // entry: JMP -> cond
        // cond: IR_LABEL(cond), IR_LT(idx_vr, len_vr), IR_BR -> body/end
        // body: load element -> user body -> increment -> JMP cond
        // end: exit
        let cond=nl(); let body=nl(); let end=nl(); let cont=nl()
        lbl_stk=lbl_stk+1; let bi=lbl_stk-1
        w64(lbl_brk+bi*8,end); w64(lbl_cont+bi*8,cont)
        // Load array length from header [base] using IR_ARRAY_LEN (op=69)
        let len_vr=nv()
        iremit(IR_ARRAY_LEN, len_vr, iter, 0, 0)
        // Initialize idx_vr via MOV from zero to avoid optimizer constant-folding
        let zero_vr=nv(); iremit(IR_CONST, zero_vr, 0, 0, 0)
        let idx_vr=nv(); iremit(IR_MOV, idx_vr, zero_vr, 0, 0)
        // Entry: JMP to condition check at bottom (first iteration evaluates condition)
        iremit(IR_JMP,0,cond,0,0)
        // Condition label - RE-EMIT condition here so JMP back re-evaluates
        iremit(IR_LABEL,0,cond,0,0)
        let cmp=nv(); iremit(IR_LT, cmp, idx_vr, len_vr, 0)
        iremit(IR_BR,0,cmp,end,body)  // false -> end, true -> body
        // Body label
        iremit(IR_LABEL,0,body,0,0)
        // Load element using CURRENT idx_vr (0-based element index)
        iremit(32, vr, iter, idx_vr, 0)
        // Parse body with owned scope
        w64(loop_scope_stk + loop_scope_top*8, owned_sctop); loop_scope_top=loop_scope_top+1
        let my_scope = owned_sctop
        owned_scope_push()
        let was_fn = in_fn_body
        if in_fn_body==0 { in_fn_body = 1 }
        blk_depth = blk_depth + 1
        while true {
            if peek()==TT_EOF { break }
            if peek()==TT_PNCT&&pval()==125 { break }
            if peek()==TT_PNCT&&pval()==59 { adv(); continue }
            let t=peek(); let v=pval(); let ln=plen()
            if t==TT_KEY {
                let h=ktext(v,ln)
                if h==16 { parse_ret() }
                else if h==2 { parse_let() }
                else if h==3 { parse_if() }
                else if h==6 { parse_while() }
                else if h==5 { parse_loop() }
                else if h==7 { parse_for() }
                else if h==8 { adv(); if lbl_stk>0 { owned_pop_to(r64(loop_scope_stk+(loop_scope_top-1)*8)); let lb=r64(lbl_brk+(lbl_stk-1)*8); iremit(IR_JMP,0,lb,0,0) } }
                else if h==9 { adv(); if lbl_stk>0 { owned_pop_to(r64(loop_scope_stk+(loop_scope_top-1)*8)); let lb=r64(lbl_cont+(lbl_stk-1)*8); iremit(IR_JMP,0,lb,0,0) } }
                else if h==17 { adv(); adv(); adv(); adv() }
                else if h==18 { parse_unsafe() }
                else { adv() }
            } else if t==TT_ID {
                let nxt=tokp+1
                if nxt<tokc&&tokt(nxt)==TT_PNCT&&tokv(nxt)==91 {
                    let close=tokp+2; let depth=1
                    while close<tokc&&depth>0 { if tokt(close)==TT_PNCT&&tokv(close)==91 { depth=depth+1 } else if tokt(close)==TT_PNCT&&tokv(close)==93 { depth=depth-1 }; close=close+1 }
                    if close<tokc&&tokt(close)==TT_OP&&tokv(close)==61 { parse_assign() }
                    else { parse_expr() }
                } else if nxt<tokc&&tokt(nxt)==TT_OP&&tokv(nxt)==61 { parse_assign() }
                else { parse_expr() }
            } else if t==TT_PNCT&&v==123 {
                adv(); parse_block(); mpnct(125)
            } else if t==TT_NUM||t==TT_STR||t==TT_OP||t==TT_PNCT {
                parse_expr()
            } else { break }
        }
        // Increment idx_vr HERE - inside SAME owned scope as body (like while loop's user-written increment)
        iremit(IR_LABEL,0,cont,0,0)  // continue target: run increment then re-check
        let one=nv(); iremit(IR_CONST, one, 1, 0, 0)
        let nidx=nv(); iremit(IR_ADD, nidx, idx_vr, one, 0)
        let idx_vr2=nv(); iremit(IR_MOV, idx_vr2, nidx, 0, 0)
        iremit(IR_MOV, idx_vr, idx_vr2, 0, 0)
        // JMP back to condition check (which re-evaluates with UPDATED idx_vr)
        iremit(IR_JMP,0,cond,0,0)
        // Pop body scope
        owned_scope_pop_one(my_scope)
        blk_depth = blk_depth - 1
        if in_fn_body==0 && was_fn==0 { in_fn_body = 0 }
        // Close brace
        mpnct(125)
        iremit(IR_LABEL,0,end,0,0)
        lbl_stk=bi
        return
    }
    // C-style for loop (original implementation)
    // Register the loop variable BEFORE parsing the init/condition/step
    // expressions, so references to it in those expressions are not flagged
    // as undeclared. (Same ordering fix as a `let` for an expression body.)
    let vr=nv(); vadd(nm,nl2,vr)
    mop(61)  // consume '=' after loop var name (for `for i = 0; ...`)
    let sv=parse_expr(); mpnct(59)
    let cond_pos=tokp; parse_expr(); mpnct(59)   // record + skip condition expr
    let step_pos=tokp; adv(); mop(61); parse_expr()  // skip step expr "nm = RHS" (consume '=' like parse_assign)
    let st=nl(); let en2=nl(); let ct=nl(); let ci=nl()
    lbl_stk=lbl_stk+1; let bi=lbl_stk-1
    w64(lbl_brk+bi*8,en2); w64(lbl_cont+bi*8,ci)
    iremit(IR_MOV,vr,sv,0,0)
    iremit(IR_LABEL,0,st,0,0)
    // condition: re-parse each iteration; BR jumps to en2 when it is 0 (false)
    let s1=tokp; tokp=cond_pos; let cv=parse_expr(); tokp=s1
    iremit(IR_BR,0,cv,en2,ct)
    iremit(IR_LABEL,0,ct,0,0)
    w64(loop_scope_stk + loop_scope_top*8, owned_sctop); loop_scope_top=loop_scope_top+1
    mpnct(123); parse_block(); mpnct(125)
    loop_scope_top=loop_scope_top-1
    iremit(IR_LABEL,0,ci,0,0)                     // continue target = increment
    // step: re-parse each iteration; its value becomes the new loop variable
    let s2=tokp; tokp=step_pos
    // assignment step "nm = RHS" (skip var + '='); expr step "nm+RHS" (parse whole expression)
    tokp=step_pos+1; let isa=0; if peek()==TT_OP&&pval()==61 { isa=1 }; tokp=step_pos
    if isa==1 { adv(); mop(61) }
    let ivr=parse_expr(); tokp=s2
    iremit(IR_MOV,vr,ivr,0,0)
    iremit(IR_JMP,0,st,0,0); iremit(IR_LABEL,0,en2,0,0)
    lbl_stk=bi
}

// P6.1b: parse_match — match expression with pattern matching
fn parse_match() {
    adv(); let disc=parse_expr()  // discriminant expression
    mpnct(123)  // '{'
    let end=nl()
    // Result vreg for the match expression - allocated once, each arm writes to it
    let res_vr = nv()
    while true {
        if peek()==TT_PNCT&&pval()==125 { adv(); break }
        // match arm: pattern => expr
        // Pattern: can be identifier (variant), wildcard '_', or literal
            // Check for bare Some/None/Ok/Err first (built-in enum variants without prefix)
            let hk_bare = ktext(pval(), plen())
            if hk_bare==H_SOME || hk_bare==H_NONE || hk_bare==H_OK || hk_bare==H_ERR {
                // Bare built-in enum variant pattern
                let is_some_ok = 0
                if hk_bare==H_SOME || hk_bare==H_OK { is_some_ok = 1 }
                adv()  // consume the bare variant
                let arm_skip=nl()
                let zib=nv(); iremit(IR_CONST,zib,0,0,0)
                let tag_vr=nv(); iremit(32,tag_vr,disc,zib,0)
                let tag_c=nv(); iremit(IR_CONST,tag_c,is_some_ok,0,0)
                let cmp=nv(); iremit(IR_EQ,cmp,tag_vr,tag_c,0)
                iremit(IR_BR,0,cmp,arm_skip,0)
                // Optional payload binder ( id )
                if peek()==TT_PNCT && pval()==40 {
                    adv()
                    let pci=0
                    while !(peek()==TT_PNCT && pval()==41) {
                        if peek()==TT_ID {
                            let pn=pval(); let pl=plen(); adv()
                            let fld_vr=nv()
                            let fi=nv(); iremit(IR_CONST,fi,1+pci,0,0)
                            iremit(32,fld_vr,disc,fi,0)
                            vadd(pn,pl,fld_vr)
                            pci=pci+1
                        } else { adv() }
                        if peek()==TT_PNCT && pval()==44 { adv() }
                    }
                    adv()  // ')'
                }
                mop(61*256+62)  // '=>'
                let arm_val=parse_expr()
                iremit(IR_MOV,res_vr,arm_val,0,0)
                iremit(IR_JMP,0,end,0,0)
                iremit(IR_LABEL,0,arm_skip,0,0)
            } else {
            // Peek ahead to check for enum variant pattern (ID :: ID or ID . ID)
            // without consuming tokens if it's not a known enum variant
            let is_enum_variant = 0
            let is_enum_variant = 0
            if (tokp+2<tokc && tokt(tokp+1)==TT_OP && tokv(tokp+1)==58*256+58 && tokt(tokp+2)==TT_ID) ||
               (tokp+2<tokc && tokt(tokp+1)==TT_PNCT && tokv(tokp+1)==46 && tokt(tokp+2)==TT_ID) {
                let enum_nm = tokv(tokp); let enum_nl = tokln(tokp)
                let variant_nm = tokv(tokp+2); let variant_nl = tokln(tokp+2)
                let ei = findenum(enum_nm, enum_nl)
                if ei>=0 {
                    let vidx = evariant_idx(ei, variant_nm, variant_nl)
                    if vidx>=0 {
                        is_enum_variant = 1
                    }
                } else {
                    // Builtin Option/Result variant pattern
                    let hk_e = ktext(enum_nm, enum_nl)
                    let hk_v = ktext(variant_nm, variant_nl)
                    if hk_e==H_OPTION && (hk_v==H_SOME || hk_v==H_NONE) { is_enum_variant = 2 }
                    if hk_e==H_RESULT && (hk_v==H_OK || hk_v==H_ERR) { is_enum_variant = 2 }
                }
            }
            
            if is_enum_variant == 2 {
                // Builtin Option/Result pattern: tag Some/Ok=1, None/Err=0
                let hk_v2 = ktext(tokv(tokp+2), tokln(tokp+2))
                adv(); adv(); adv()   // consume ID sep ID
                let btag = 0
                if hk_v2==H_SOME || hk_v2==H_OK { btag = 1 }
                let arm_skip=nl()
                let zib=nv(); iremit(IR_CONST,zib,0,0,0)
                let tag_vr=nv(); iremit(32,tag_vr,disc,zib,0)
                let tag_c=nv(); iremit(IR_CONST,tag_c,btag,0,0)
                let cmp=nv(); iremit(IR_EQ,cmp,tag_vr,tag_c,0)
                iremit(IR_BR,0,cmp,arm_skip,0)
                // Optional payload binder ( id )
                if peek()==TT_PNCT && pval()==40 {
                    adv()
                    let pci=0
                    while !(peek()==TT_PNCT && pval()==41) {
                        if peek()==TT_ID {
                            let pn=pval(); let pl=plen(); adv()
                            let fld_vr=nv()
                            let fi=nv(); iremit(IR_CONST,fi,1+pci,0,0)
                            iremit(32,fld_vr,disc,fi,0)
                            vadd(pn,pl,fld_vr)
                            pci=pci+1
                        } else { adv() }
                        if peek()==TT_PNCT && pval()==44 { adv() }
                    }
                    adv()  // ')'
                }
                mop(61*256+62)  // '=>'
                let arm_val=parse_expr()
                iremit(IR_MOV,res_vr,arm_val,0,0)
                iremit(IR_JMP,0,end,0,0)
                iremit(IR_LABEL,0,arm_skip,0,0)
            } else if is_enum_variant == 1 {
                // Now consume the tokens for real
                let enm=pval(); let enml=plen(); adv()
                if (peek()==TT_OP && pval()==58*256+58) || (peek()==TT_PNCT && pval()==46) {
                    adv()
                    if peek()==TT_ID {
                        let vnm=pval(); let vnl=plen(); adv()
                        // Recompute ei and vidx since they were local to peek-ahead block
                        let ei=findenum(enm,enml)
                        let vidx=evariant_idx(ei,vnm,vnl)
                        // Check tag: extract tag from disc, compare
                        let arm_skip=nl()
                        let zi0=nv(); iremit(IR_CONST,zi0,0,0,0)
                        let tag_vr=nv(); iremit(32,tag_vr,disc,zi0,0)
                        let tag_c=nv(); iremit(IR_CONST,tag_c,evariant_tag(ei,vidx),0,0)
                        let cmp=nv(); iremit(IR_EQ,cmp,tag_vr,tag_c,0)
                        iremit(IR_BR,0,cmp,arm_skip,0)
                        // Payload pattern: optional ( id, id, ... ) — bind each field
                        if peek()==TT_PNCT && pval()==40 {
                            adv()
                            let pci=0
                            while !(peek()==TT_PNCT && pval()==41) {
                                if peek()==TT_ID {
                                    let pn=pval(); let pl=plen(); adv()
                                    let fld_vr=nv()
                                    let fi=nv(); iremit(IR_CONST,fi,1+pci,0,0)
                                    iremit(32,fld_vr,disc,fi,0)
                                    vadd(pn,pl,fld_vr)
                                    pci=pci+1
                                } else { adv() }
                                if peek()==TT_PNCT && pval()==44 { adv() }
                            }
                            adv()  // ')'
                        }
                        mop(61*256+62)  // '=>'
                        let arm_val=parse_expr()
                        iremit(IR_MOV,res_vr,arm_val,0,0)
                        iremit(IR_JMP,0,end,0,0)
                        iremit(IR_LABEL,0,arm_skip,0,0)
                    }
                }
            } else {
                // Simple identifier binding - match any value and bind
                let bnm=pval(); let bnl=plen(); adv()
                let arm_skip=nl()
                let vr=nv(); iremit(IR_MOV,vr,disc,0,0)
                vadd(bnm,bnl,vr)
                mop(61*256+62)  // '=>'
                let arm_val=parse_expr()
                iremit(IR_MOV,res_vr,arm_val,0,0)
                iremit(IR_JMP,0,end,0,0)
                iremit(IR_LABEL,0,arm_skip,0,0)
            }
        } else if peek()==TT_PNCT && pval()==95 {  // '_' wildcard
            adv()
            let arm_skip=nl()
            mop(61*256+62)  // '=>'
            let arm_val=parse_expr()
            iremit(IR_MOV,res_vr,arm_val,0,0)
            iremit(IR_JMP,0,end,0,0)
            iremit(IR_LABEL,0,arm_skip,0,0)
        } else {
            // Literal or other pattern - treat as equality check
            let pat=parse_expr()
            mop(61*256+62)  // '=>'
            let arm_skip=nl()
            let cmp=nv(); iremit(IR_EQ,cmp,pat,disc,0)
            iremit(IR_BR,0,cmp,arm_skip,0)
            let arm_val=parse_expr()
            iremit(IR_MOV,res_vr,arm_val,0,0)
            iremit(IR_JMP,0,end,0,0)
            iremit(IR_LABEL,0,arm_skip,0,0)
        }
        if peek()==TT_PNCT&&pval()==44 { adv() }  // optional comma
    }
    iremit(IR_LABEL,0,end,0,0)
    return res_vr
}

// === EXPRESSION PARSING ===
fn parse_expr() { return parse_or() }

fn parse_or() {
    let l=parse_and()
    while peek()==TT_OP&&pval()==124*256+124 {
        adv()
        let vr=nv(); iremit(IR_MOV,vr,l,0,0)
        let leval=nl(); let lend=nl()
        iremit(IR_BR,0,vr,leval,0)   // if vr==0, need to eval RHS
        iremit(IR_JMP,0,lend,0,0)    // vr!=0: short-circuit, keep truthy vr
        iremit(IR_LABEL,0,leval,0,0)
        let r=parse_and(); iremit(IR_MOV,vr,r,0,0)
        iremit(IR_LABEL,0,lend,0,0)
        l=vr
    }
    return l
}
fn parse_and() {
    let l=parse_bor()
    while peek()==TT_OP&&pval()==38*256+38 {
        adv()
        let vr=nv(); iremit(IR_MOV,vr,l,0,0)
        let lend=nl()
        iremit(IR_BR,0,vr,lend,0)    // if vr==0: short-circuit, keep vr=0
        let r=parse_bxor(); iremit(IR_MOV,vr,r,0,0)
        iremit(IR_LABEL,0,lend,0,0)
        l=vr
    }
    return l
}
fn parse_bor() {
    let l=parse_bxor()
    while peek()==TT_OP&&pval()==124 { adv(); let r=parse_bxor(); let vr=nv(); iremit(IR_BOR,vr,l,r,0); l=vr }
    return l
}
fn parse_bxor() {
    let l=parse_band()
    while peek()==TT_OP&&pval()==94 { adv(); let r=parse_band(); let vr=nv(); iremit(IR_BXOR,vr,l,r,0); l=vr }
    return l
}
fn parse_band() {
    let l=parse_cmp()
    while peek()==TT_OP&&pval()==38 { adv(); let r=parse_cmp(); let vr=nv(); iremit(IR_BAND,vr,l,r,0); l=vr }
    return l
}

fn parse_cmp() {
    let l=parse_as()  // P6: 'as' cast binds tighter than comparison
    while peek()==TT_OP {
        let v=pval(); let rr=nv()
        if v==61*256+61 { adv(); let r=parse_as(); iremit(IR_EQ,rr,l,r,0); l=rr }
        else if v==33*256+61 { adv(); let r=parse_as(); iremit(IR_NE,rr,l,r,0); l=rr }
        else if v==60 { adv(); let r=parse_as(); iremit(IR_LT,rr,l,r,0); l=rr }
        else if v==62 { adv(); let r=parse_as(); iremit(IR_GT,rr,l,r,0); l=rr }
        else if v==60*256+61 { adv(); let r=parse_as(); iremit(IR_LE,rr,l,r,0); l=rr }
        else if v==62*256+61 { adv(); let r=parse_as(); iremit(IR_GE,rr,l,r,0); l=rr }
        else { break }
    }
    return l
}

fn parse_shift() {
    let l=parse_add()
    while peek()==TT_OP {
        let v=pval(); let rr=nv()
        if v==60*256+60 { adv(); let r=parse_add(); iremit(IR_SHL,rr,l,r,0); l=rr }
        else if v==62*256+62 { adv(); let r=parse_add(); iremit(IR_SHR,rr,l,r,0); l=rr }
        else { break }
    }
    return l
}

// P6: parse 'as' cast operator (lower precedence than shift, higher than add)
fn parse_as() {
    let l=parse_shift()
    while peek()==TT_KEY&&ktext(pval(),plen())==41 {  // 'as' keyword (H_AS = 41)
        adv()
        // inline type parsing (like parse_let does)
        let vtype = 0
        if peek()==TT_KEY {
            let hk = ktext(pval(), plen())
            // ktext returns small keyword IDs: u8=44, u16=45, u32=46, u64=47, usize=48, bool=49, char=50, byte=51, mut=35
            if hk==44 { vtype = 1 }
            else if hk==45 { vtype = 2 }
            else if hk==46 { vtype = 3 }
            else if hk==47 { vtype = 4 }
            else if hk==48 { vtype = 5 }
            else if hk==49 { vtype = 6 }
            else if hk==50 { vtype = 7 }
            else if hk==51 { vtype = 8 }
            else if hk==35 { vtype = 9 }  // mut
            else { vtype = 0 }
            adv()  // consume type keyword
        }
        let vr=nv()
        iremit(IR_PTR_CAST, vr, l, vtype, 0)  // cast value to type
        l=vr
    }
    return l
}

fn parse_add() {
    let l=parse_mul()  // add binds looser than mul
    while peek()==TT_OP {
        let v=pval(); let rr=nv()
        if v==43 { adv(); let r=parse_mul(); iremit(IR_ADD,rr,l,r,0); l=rr }
        else if v==45 { adv(); let r=parse_mul(); iremit(IR_SUB,rr,l,r,0); l=rr }
        else { break }
    }
    return l
}

fn parse_mul() {
    let l=parse_unary()
    while peek()==TT_OP {
        let v=pval(); let rr=nv()
        if v==42 { adv(); let r=parse_unary(); iremit(IR_MUL,rr,l,r,0); l=rr }
        else if v==47 { adv(); let r=parse_unary(); iremit(IR_DIV,rr,l,r,0); l=rr }
        else if v==37 { adv(); let r=parse_unary(); iremit(IR_MOD,rr,l,r,0); l=rr }
        else { break }
    }
    return l
}

fn parse_unary() {
    // P6: raw pointer dereference: *p
    if peek()==TT_OP&&pval()==42 {
        adv()
        let o=parse_unary()
        let vr=nv()
        iremit(IR_DEREF, vr, o, 0, 0)
        return vr
    }
    // P6: mutable raw pointer dereference: *p = v (handled in parse_expr via assignment)
    // P6: address-of: &p (for raw pointers)
    if peek()==TT_OP&&pval()==38 {
        adv()
        let o=parse_unary()
        let vr=nv()
        iremit(IR_PTR_CAST, vr, o, 0, 1)  // 1 = address-of (cast to raw pointer)
        return vr
    }
    if peek()==TT_OP {
        let v=pval()
        if v==45 { adv(); let o=parse_unary(); let vr=nv(); iremit(IR_NEG,vr,o,0,0); return vr }
        if v==33 { adv(); let o=parse_unary(); let vr=nv(); iremit(IR_NOT,vr,o,0,0); return vr }
        if v==126 { adv(); let o=parse_unary(); let vr=nv(); iremit(IR_BNOT,vr,o,0,0); return vr }
    }
    if peek()==TT_KEY&&ktext(pval(),plen())==15 {
        adv(); let o=parse_unary(); let vr=nv(); iremit(IR_NOT,vr,o,0,0); return vr
    }
    // P6: volatile keyword prefix
    if peek()==TT_KEY&&ktext(pval(),plen())==39 {  // volatile
        adv()
        let o=parse_unary()
        let vr=nv()
        // tag as volatile load
        iremit(IR_VOLATILE_LOAD, vr, o, 0, 0)
        return vr
    }
    // Generic postfix: `.N` (numeric field) on any value vreg (inline tuple
    // literal, fn result, etc). Name-bound `.field`/`.N` is still handled in
    // parse_primary's TT_ID branch; this covers the value-not-yet-named case.
    let v0 = parse_primary()
    // P7: postfix `?` operator (try/unwrap) - binds tighter than `.field`
    if peek()==TT_PNCT&&pval()==63 {  // '?'
        adv()
        let vr=nv(); iremit(IR_UNWRAP, vr, v0, 0, 0)
        v0 = vr
    }
    while peek()==TT_PNCT&&pval()==46 {
        adv()
        if peek()==TT_NUM {
            let fld=pval(); adv()
            let fi=nv(); iremit(IR_CONST,fi,fld,0,0)
            if peek()==TT_OP&&pval()==61 { adv(); let val=parse_expr(); iremit(IR_ISTORE,0,v0,fi,val); return v0 }
            let vr=nv(); iremit(32,vr,v0,fi,0); v0=vr
        } else { break }
    }
    return v0
}

// === METHOD / SELF (t8) ===
// obj.method(args) desugars to method(obj, args...): `self` is just the
// method's first parameter (a regular name, no new keyword). The method-call
// path only runs when user code uses `obj.NAME` (alpha); the compiler source
// never does, so it does not trip the allocator hazard.

// parse_call(nm, nl): parse `name(args)` using the shared arg machinery and
// emit IR_CALL. Returns the result vreg. Accepts an optional leading `selfv`
// (a vreg to prepend as param 0) for method calls.
fn parse_call(nm, nl) {
    let selfv = -1
    return parse_call_impl(nm, nl, selfv)
}

fn parse_method_call(selfv, mnm, ml) {
    return parse_call_impl(mnm, ml, selfv)
}

fn parse_call_impl(nm, nl, selfv) {
    // t10: fnptr(FNAME) -> code pointer as a runtime value. Special-cased
    // because its argument is a compile-time function NAME, not a value expr.
    if nl==5&&r8(src+nm)=='f'&&r8(src+nm+1)=='n'&&r8(src+nm+2)=='p'&&r8(src+nm+3)=='t'&&r8(src+nm+4)=='r' {
        adv()  // consume '('
        if !(peek()==TT_ID) { compile_error(0, nm, nl) }
        let fnnm = pval(); let fnln = plen(); adv()  // consume FNAME
        mpnct(41)  // ')'
        let fi = findfn(fnnm, fnln)
        if fi<0 { compile_error(0, fnnm, fnln) }
        let vr = nv(); iremit(IR_FNPTR, vr, fi, 0, 0); return vr
    }
    adv()   // consume '('
    let base=argsp
    let ac=0
    // t8: if this is a method call, prepend self as the first argument (param 0).
    if selfv>=0 {
        w64(argstack + argsp*8, selfv)
        w64(arg_tgt + (base+ac)*8, ac)
        w8(arg_filled + (base*64 + ac), 1)
        argsp = argsp + 1
        ac = ac + 1
    }
    if !(peek()==TT_PNCT&&pval()==41) {
        while true {
            // t4: detect a named argument: ID immediately followed by ':'.
            let anm = 0
            if peek()==TT_ID && tokp+1<tokc && tokt(tokp+1)==TT_PNCT && tokv(tokp+1)==58 {
                anm = tokv(tokp)   // remember name src-ptr
                adv()              // consume name ID
                adv()              // consume ':'
            }
            let a=parse_expr()
            // target slot = argument order by default; remapped if named.
            let tgt = ac
            if anm!=0 {
                let callee = findfn(nm, nl)
                if callee>=0 {
                    let pidx = findparam(callee, anm, len_name_colon(anm))
                    if pidx>=0 { tgt = pidx } else { compile_error(2, nm, nl) }
                }
            }
            // Collect in ARGUMENT order (increment argsp so nested calls
            // get distinct bases), recording the target param index.
            w64(argstack + argsp*8, a)
            w64(arg_tgt + (base+ac)*8, tgt)
            w8(arg_filled + (base*64 + tgt), 1)   // t5: mark param index tgt as supplied
            argsp = argsp + 1
            ac = ac + 1
            if peek()==TT_PNCT&&pval()==44 { adv() } else { break }
        }
    }
    mpnct(41)
    let nargs=argsp-base
    // t5: fill omitted params with their default expressions.
    let dfn = findfn(nm, nl)
    if dfn>=0 {
        let dfull = r64(fn_pcount + dfn*8)
        let zz=0
        while zz<dfull {
            if r8(arg_filled + (base*64 + zz))==0 {
                let dr0 = r64(fn_defargs + (dfn*64 + zz)*16)
                let dr1 = r64(fn_defargs + (dfn*64 + zz)*16 + 8)
                if dr0!=0 && dr1>dr0 {
                    let saved_p = tokp; let saved_c = tokc; let saved_a = argsp
                    tokp = dr0; tokc = dr1
                    let dval = parse_expr()
                    tokp = saved_p; tokc = saved_c; argsp = saved_a
                    w64(argstack + argsp*8, dval)
                    w64(arg_tgt + (base+nargs)*8, zz)
                    argsp = argsp + 1
                    nargs = nargs + 1
                }
            }
            zz = zz + 1
        }
        let cz=0
        while cz<dfull {
            if r8(arg_filled + (base*64 + cz))==0 {
                let cdr0 = r64(fn_defargs + (dfn*64 + cz)*16)
                if cdr0==0 { compile_error(2, nm, nl) }
            }
            cz = cz + 1
        }
    }
    // t4: permute collected args from argument order into callee
    // parameter order so the MOV-emit below loads them correctly.
    let rk=0
    while rk<nargs {
        let p = r64(arg_tgt + (base+rk)*8)
        w64(arg_tmp + (base+p)*8, r64(argstack + (base+rk)*8))
        rk = rk + 1
    }
    let ck=0
    while ck<nargs { w64(argstack + (base+ck)*8, r64(arg_tmp + (base+ck)*8)); ck=ck+1 }
    let fchk=findfn(nm,nl)
    let do_call=0
    if fchk>=0 { do_call=1 }
    if do_call==0 { if is_bltn(nm,nl)==1 { do_call=1 } }
    if do_call==1 {
        let avs=irc
        let k=base
        while k<argsp { let mv=nv(); iremit(IR_MOV,mv,r64(argstack+k*8),0,0); k=k+1 }
        argsp=base
        // t10: closure_call(fnb, args...) -> dedicated IR (env-shift + indirect call).
        if nl==12&&r8(src+nm)=='c'&&r8(src+nm+1)=='l'&&r8(src+nm+2)=='o'&&r8(src+nm+3)=='s'&&r8(src+nm+4)=='u'&&r8(src+nm+5)=='r'&&r8(src+nm+6)=='e'&&r8(src+nm+7)=='_'&&r8(src+nm+8)=='c'&&r8(src+nm+9)=='a'&&r8(src+nm+10)=='l'&&r8(src+nm+11)=='l' {
            // fnb is the first collected arg (argstack[base]); caller args start at avs+1.
            let fnbv = irres(avs)
            let vr2=nv(); iremit(IR_CLOSURE_CALL, vr2, fnbv, avs+1, nargs-1); return vr2
        }
        let vr2=nv(); iremit(IR_CALL,vr2,nm,nargs,avs)
        // G2: builtins str()/push() return a byte-stride string -> tag vr2.
        // nm is an offset; builtin names are at src+nm (same as is_bltn()).
        if vr2>=0 && vr2<8192 {
            if nl==3&&r8(src+nm)=='s'&&r8(src+nm+1)=='t'&&r8(src+nm+2)=='r' { w64(vreg_is_str + vr2*8, 1) }
            if nl==4&&r8(src+nm)=='p'&&r8(src+nm+1)=='u'&&r8(src+nm+2)=='s'&&r8(src+nm+3)=='h' { w64(vreg_is_str + vr2*8, 1) }
        }
        // Phase 4.3: if the callee returns a struct, tag vr2 so `q.field` works.
        if fchk>=0 {
            let rsi = r64(fn_retstruct + fchk*8)
            if rsi>=0 { w64(vreg_struct + vr2*8, rsi) }
        }
        return vr2
    } else {
        // Undeclared, non-builtin call: hard compile error (no silent 0).
        compile_error(0, nm, nl)
    }
}

fn parse_primary() {
    if peek()==TT_MATCH { return parse_match() }   // P6.1b: match in expression position
    if peek()==TT_NUM { let v=pval(); adv(); let vr=nv(); iremit(IR_CONST,vr,v,0,0); return vr }
    if peek()==TT_STR { let v=pval(); adv(); let vr=nv(); iremit(IR_STR,vr,v,0,0); w64(vreg_is_str + vr*8, 1); return vr }
    // G2 containers: array literal [e1, e2, ...] -> IR_TALLOC(n), IR_ISTORE each.
    if peek()==TT_PNCT&&pval()==91 {
        adv()
        let elems=mmap(8000)   // stash element vregs
        let cnt=0
        if peek()!=TT_PNCT || pval()!=93 {  // non-empty literal
            let e0=parse_expr(); w64(elems+cnt*8, e0); cnt=cnt+1
            while peek()==TT_PNCT&&pval()==44 { adv(); let e=parse_expr(); w64(elems+cnt*8, e); cnt=cnt+1 }
        }
        mpnct(93)  // ']'
        let tr=nv(); iremit(IR_TALLOC,tr,cnt,0,0)
        let ci=0
        while ci<cnt {
            let ev=r64(elems+ci*8); let fi=nv(); iremit(IR_CONST,fi,ci,0,0)
            iremit(IR_ISTORE,0,tr,fi,ev)
            ci=ci+1
        }
        return tr
    }
    if peek()==TT_PNCT&&pval()==40 {
        pdepth=pdepth+1
        if pdepth>PDEPTH_MAX {
            let mn = "error: expression nesting too deep\n"
            file_write(2, mn+8, len(mn)); exit(1)
        }
        adv(); let e=parse_expr()
        // G2 Part A: tuple literal (e1, e2, ...) -> IR_TALLOC(n) + IR_ISTORE each.
        // Reuses the B aggregate layout (header-carrying, qword stride); elements
        // are read back via the existing '.N' postfix (IR_IDX, base+idx*8).
        if peek()==TT_PNCT&&pval()==44 {
            let elems=mmap(8000); let cnt=0
            w64(elems+cnt*8, e); cnt=cnt+1
            while peek()==TT_PNCT&&pval()==44 { adv(); let ev=parse_expr(); w64(elems+cnt*8, ev); cnt=cnt+1 }
            if mpnct(41)==0 { let mn="error: expected ')' in tuple literal\n"; file_write(2,mn+8,len(mn)); exit(1) }
            let tr=nv(); iremit(IR_TALLOC, tr, cnt, 0, 0)
            let ci=0
            while ci<cnt { let ev=r64(elems+ci*8); let fi=nv(); iremit(IR_CONST,fi,ci,0,0); iremit(IR_ISTORE,0,tr,fi,ev); ci=ci+1 }
            pdepth=pdepth-1; return tr
        }
        if mpnct(41)==0 {
            // No matching ')'. Reading a comma (e.g. `(1,2)`) is now a tuple
            // literal handled above; reaching here means a dangling '('.
            let mn = "error: expected ')' in parenthesized expression\n"
            file_write(2, mn+8, len(mn)); exit(1)
        }
        pdepth=pdepth-1; return e
    }
    if peek()==TT_KEY {
        let v=pval(); let ln=plen(); let h=ktext(v,ln); let vr=nv()
        if h==10 { adv(); iremit(IR_CONST,vr,1,0,0); return vr }
        if h==11 { adv(); iremit(IR_CONST,vr,0,0,0); return vr }
        if h==12 { adv(); iremit(IR_CONST,vr,0,0,0); return vr }
        // P7 fix: type keywords (u8/u16/u32/u64/...) used as BUILTIN CALLS,
        // e.g. `u8(511)`. The tokenizer marks them TT_KEY for `let x: u64 = 5`
        // annotations, but as expression-primary they must route to parse_call
        // when followed by '(' — otherwise `u8(511)` silently became CONST 0
        // (phantom value, `(511)` left unparsed). is_bltn matches the name at
        // src+v (same source-offset layout as TT_ID tokens). Consume the
        // keyword first (parse_call_impl's adv() then eats the '(').
        if tokp+1<tokc && tokt(tokp+1)==TT_PNCT && tokv(tokp+1)==40 && is_bltn(v,ln)==1 {
            adv(); return parse_call(v, ln)
        }
        adv(); iremit(IR_CONST,vr,0,0,0); return vr
    }
    if peek()==TT_ID {
            // Check for struct constructor: StructName(args) - MUST BE FIRST before enum lookahead
            let nm = pval(); let nl = plen()
            let si = findstruct(nm, nl)
            if si >= 0 {
                adv()  // consume struct name
                if peek()==TT_PNCT && pval()==40 {
                    adv()  // consume '('
                    let fc = r64(sdefs + si*64 + 16)  // field count
                    let vr = nv(); iremit(IR_TALLOC, vr, fc, 0, 0)
                    let ac = 0
                    if !(peek()==TT_PNCT&&pval()==41) {
                        while true {
                            let a = parse_expr()
                            if ac < fc {
                                let fi = nv(); iremit(IR_CONST, fi, ac, 0, 0)
                                iremit(IR_ISTORE, 0, vr, fi, a)
                            }
                            ac = ac + 1
                            if peek()==TT_PNCT&&pval()==44 { adv() } else { break }
                        }
                    }
                    mpnct(41)  // consume ')'
                    w64(vreg_struct + vr*8, si)
                    return vr
                }
            }
            // P6.1b: Check for enum variant constructor BEFORE consuming the ID token.
            // We need to peek ahead: ID followed by '::' or '.' followed by ID.
            if tokp+1<tokc && (tokt(tokp+1)==TT_OP || tokt(tokp+1)==TT_PNCT) && (tokv(tokp+1)==58*256+58 || tokv(tokp+1)==46) && tokp+2<tokc && tokt(tokp+2)==TT_ID {
                let nm=tokv(tokp); let nl=tokln(tokp)
                let sep = tokv(tokp+1)  // 58*256+58='::' or 46='.'
                let vnm=tokv(tokp+2); let vnl=tokln(tokp+2)
                // Check if this is an enum variant before consuming tokens
                let ei=findenum(nm,nl)
                if ei>=0 {
                    let vidx=evariant_idx(ei,vnm,vnl)
                    if vidx>=0 {
                        // It's a real enum variant - consume the three tokens
                        adv(); adv(); adv()
                        // It's a real enum variant
                        if peek()==TT_PNCT && pval()==40 {  // tuple payload
                            adv()
                            let fc=evariant_fcount(ei,vidx)
                            let vr=nv(); iremit(IR_TALLOC, vr, 1+fc, 0, 0)  // 1 word tag + payload
                            let ti=nv(); iremit(IR_CONST,ti,evariant_tag(ei,vidx),0,0)
                            let zi=nv(); iremit(IR_CONST,zi,0,0,0)
                            iremit(IR_ISTORE,0,vr,zi,ti)
                            let ac=0
                            if !(peek()==TT_PNCT&&pval()==41) {
                                while true {
                                    let a=parse_expr()
                                    if ac<fc {
                                        let fi=nv(); iremit(IR_CONST,fi,1+ac,0,0)
                                        iremit(IR_ISTORE,0,vr,fi,a)
                                    }
                                    ac=ac+1
                                    if peek()==TT_PNCT&&pval()==44 { adv() } else { break }
                                }
                            }
                            mpnct(41)
                        } else {
                            // unit variant (no payload)
                            let vr=nv(); iremit(IR_TALLOC, vr, 1, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,evariant_tag(ei,vidx),0,0)
                            let zi=nv(); iremit(IR_CONST,zi,0,0,0)
                            iremit(IR_ISTORE,0,vr,zi,ti)
                        }
                        w64(vreg_enum + vr*8, ei)
                        w64(vreg_enum_var + vr*8, vidx)
                        return vr
                    }
                }
                // Check for Option::Some / Option::None / Result::Ok / Result::Err
                // (builtins: NOT declared enums, so this must run even if findenum<0)
                let hk_enum = ktext(nm,nl)
                let hk_var = ktext(vnm,vnl)
                if hk_enum==H_OPTION || hk_enum==H_RESULT {
                    // consume the three tokens: Enum Variant  (Option :: Some)
                    adv(); adv(); adv()
                    // It's an Option or Result variant
                    if hk_enum==H_OPTION {
                        if hk_var==H_SOME {
                            if peek()==TT_PNCT && pval()==40 {
                                adv(); let a=parse_expr(); mpnct(41)
                                let vr=nv(); iremit(IR_SOME, vr, a, 0, 0)
                                w64(vreg_enum + vr*8, -2)  // tag as Option
                                w64(vreg_enum_var + vr*8, 1)  // Some = tag 1
                                return vr
                            }
                        } else if hk_var==H_NONE {
                            let vr=nv(); iremit(IR_NONE, vr, 0, 0, 0)
                            w64(vreg_enum + vr*8, -2)
                            w64(vreg_enum_var + vr*8, 0)
                            return vr
                        }
                    } else if hk_enum==H_RESULT {
                        if hk_var==H_OK {
                            if peek()==TT_PNCT && pval()==40 {
                                adv(); let a=parse_expr(); mpnct(41)
                                let vr=nv(); iremit(IR_OK, vr, a, 0, 0)
                                w64(vreg_enum + vr*8, -3)
                                w64(vreg_enum_var + vr*8, 1)
                                return vr
                            }
                        } else if hk_var==H_ERR {
                            if peek()==TT_PNCT && pval()==40 {
                                adv(); let a=parse_expr(); mpnct(41)
                                let vr=nv(); iremit(IR_ERR, vr, a, 0, 0)
                                w64(vreg_enum + vr*8, -3)
                                w64(vreg_enum_var + vr*8, 0)
                                return vr
                            }
                        }
                    }
                }
            }
                    // Check for bare Some/None/Ok/Err (built-in enum variants without Option:: prefix)
                    let hk_bare = ktext(nm, nl)
                    if hk_bare==H_SOME {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_TALLOC, vr, 2, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,1,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                            let fi=nv(); iremit(IR_CONST,fi,1,0,0); iremit(IR_ISTORE,0,vr,fi,a)
                            w64(vreg_enum + vr*8, -2)  // tag as Option
                            w64(vreg_enum_var + vr*8, 1)  // Some = tag 1
                            return vr
                        }
                    }
                    if hk_bare==H_NONE {
                        let vr=nv(); iremit(IR_TALLOC, vr, 1, 0, 0)
                        let ti=nv(); iremit(IR_CONST,ti,0,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                        w64(vreg_enum + vr*8, -2)
                        w64(vreg_enum_var + vr*8, 0)
                        return vr
                    }
                    if hk_bare==H_OK {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_TALLOC, vr, 2, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,1,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                            let fi=nv(); iremit(IR_CONST,fi,1,0,0); iremit(IR_ISTORE,0,vr,fi,a)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 1)
                            return vr
                        }
                    }
                    if hk_bare==H_ERR {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_TALLOC, vr, 2, 0, 0)
                            let ti=nv(); iremit(IR_CONST,ti,0,0,0); let zi=nv(); iremit(IR_CONST,zi,0,0,0); iremit(IR_ISTORE,0,vr,zi,ti)
                            let fi=nv(); iremit(IR_CONST,fi,1,0,0); iremit(IR_ISTORE,0,vr,fi,a)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 0)
                            return vr
                        }
                    }
                    // Check for function call: name(args) - this comes AFTER enum/struct checks
                        // Not an enum variant, now consume the ID token for regular handling
                        let nm=pval(); let nl=plen(); adv()
                    // Check for bare Some/None/Ok/Err (built-in enum variants without Option:: prefix)
                    let hk_bare = ktext(nm, nl)
                    if hk_bare==H_SOME {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_SOME, vr, a, 0, 0)
                            w64(vreg_enum + vr*8, -2)  // tag as Option
                            w64(vreg_enum_var + vr*8, 1)  // Some = tag 1
                            return vr
                        }
                    }
                    if hk_bare==H_NONE {
                        let vr=nv(); iremit(IR_NONE, vr, 0, 0, 0)
                        w64(vreg_enum + vr*8, -2)
                        w64(vreg_enum_var + vr*8, 0)
                        return vr
                    }
                    if hk_bare==H_OK {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_OK, vr, a, 0, 0)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 1)
                            return vr
                        }
                    }
                    if hk_bare==H_ERR {
                        if peek()==TT_PNCT && pval()==40 {
                            adv(); let a=parse_expr(); mpnct(41)
                            let vr=nv(); iremit(IR_ERR, vr, a, 0, 0)
                            w64(vreg_enum + vr*8, -3)
                            w64(vreg_enum_var + vr*8, 0)
                            return vr
                        }
                    }
                    // Check for function call: name(args) - this comes AFTER enum/struct checks
        if peek()==TT_PNCT&&pval()==40 {
            return parse_call(nm, nl)
        }
        if peek()==TT_PNCT&&pval()==91 {  // index: a[idx]
            adv(); let idx=parse_expr(); mpnct(93)
            let f=vfind(nm,nl)
            if f>=0 { let vr=nv(); iremit(32,vr,f,idx,0); return vr }
            let g=gfind(nm,nl)
            if g>=0 { let pg=nv(); iremit(IR_LOADG,pg,g,0,0); let vr=nv(); iremit(32,vr,pg,idx,0); return vr }
            compile_error(1, nm, nl)  // undeclared array/string index -> error
        }
        // Phase 4.3: postfix `.N` (tuple), `.field` (struct), `.method` (t8) —
        // CHAINED (e.g. r.topleft.x). `selfv` holds the object vreg: for the
        // first `.` it is resolved from the name `nm`/`nl`; for later chain
        // links it is the previous field's result vreg (tagged via sfldtyp so
        // the next `.` resolves). All name lookups are INLINED — calling a
        // user-fn with live locals trips the allocator clobber bug.
        let selfv = -1
        while peek()==TT_PNCT&&pval()==46 {
            adv()
            if peek()==TT_NUM {
                let fld=pval(); adv()
                let fi=nv(); iremit(IR_CONST,fi,fld,0,0)
                if selfv<0 {
                    // inline vfind(nm,nl)
                    let i = varc-1
                    while i>=0 {
                        let vnm = r64(vars + i*VRS); let vnl = r64(vars + i*VRS + 16)
                        if vnl==nl {
                            let ok=1; let j=0
                            while j<nl { if r8(src+vnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                            if ok==1 { selfv=r64(vars+i*VRS+8); break }
                        }
                        i=i-1
                    }
                    if selfv<0 {
                        // inline gfind(nm,nl)
                        let gi=0
                        while gi<gvarc {
                            if r64(gvars+gi*16+8)==nl {
                                let gnm=r64(gvars+gi*16); let ok=1; let j=0
                                while j<nl { if r8(src+gnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                                if ok==1 { selfv=nv(); iremit(IR_LOADG,selfv,gi,0,0); break }
                            }
                            gi=gi+1
                        }
                    }
                }
                if selfv<0 { compile_error(1, nm, nl); return 0 }
                if peek()==TT_OP&&pval()==61 { adv(); let v=parse_expr(); iremit(IR_ISTORE,0,selfv,fi,v); return 0 }
                let vr=nv(); iremit(32,vr,selfv,fi,0); selfv=vr
            } else if peek()==TT_ID {
                if selfv<0 {
                    // inline vfind(nm,nl)
                    let i = varc-1
                    while i>=0 {
                        let vnm = r64(vars + i*VRS); let vnl = r64(vars + i*VRS + 16)
                        if vnl==nl {
                            let ok=1; let j=0
                            while j<nl { if r8(src+vnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                            if ok==1 { selfv=r64(vars+i*VRS+8); break }
                        }
                        i=i-1
                    }
                    if selfv<0 {
                        // inline gfind(nm,nl)
                        let gi=0
                        while gi<gvarc {
                            if r64(gvars+gi*16+8)==nl {
                                let gnm=r64(gvars+gi*16); let ok=1; let j=0
                                while j<nl { if r8(src+gnm+j)!=r8(src+nm+j){ok=0;break}; j=j+1 }
                                if ok==1 { selfv=nv(); iremit(IR_LOADG,selfv,gi,0,0); break }
                            }
                            gi=gi+1
                        }
                    }
                }
                if selfv<0 { compile_error(1, nm, nl); return 0 }
                let mnm=pval(); let ml=plen()
                let si=r64(vreg_struct + selfv*8)
                if si>=0 {
                    // inline sfield_idx(si, mnm, ml)
                    let fc=r64(sdefs + si*64 + 16); let fb=r64(sdefs + si*64 + 24)
                    let fidx=-1; let fj=0
                    while fj<fc {
                        let fp=r64(sfldtab + (fb+fj)*16); let fl2=r64(sfldtab + (fb+fj)*16 + 8)
                        if fl2==ml {
                            let ok=1; let fk=0
                            while fk<ml { if r8(src+fp+fk)!=r8(src+mnm+fk){ok=0;break}; fk=fk+1 }
                            if ok==1 { fidx=fj; break }
                        }
                        fj=fj+1
                    }
                    if fidx>=0 {
                        adv()
                        let fi=nv(); iremit(IR_CONST,fi,fidx,0,0)
                        if peek()==TT_OP&&pval()==61 { adv(); let v=parse_expr(); iremit(IR_ISTORE,0,selfv,fi,v); return 0 }
                        let vr=nv(); iremit(32,vr,selfv,fi,0)
                        // tag result with field's struct type (enables next chain link)
                        let ftype=r64(sfldtyp + (fb+fidx)*8)
                        if ftype>=0 { w64(vreg_struct + vr*8, ftype) }
                        selfv=vr
                    } else {
                        adv(); return parse_method_call(selfv, mnm, ml)
                    }
                } else {
                    // P9: dyn-trait receiver -> dispatch via impl table. The
                    // impl method is registered in the fn table under its own
                    // name, so the standard method-call path (findfn by name)
                    // already resolves and calls it with selfv prepended as
                    // arg 0. The vreg_trait tag marks it as a dyn trait so a
                    // real vtable dispatch can replace this later.
                    adv(); return parse_method_call(selfv, mnm, ml)
                }
            } else {
                compile_error(1, nm, nl); return 0
            }
        }
        if selfv>=0 { return selfv }
        let f=vfind(nm,nl); if f>=0 { return f }
        let g=gfind(nm,nl); if g>=0 { let vr=nv(); iremit(IR_LOADG,vr,g,0,0); return vr }
        compile_error(1, nm, nl)  // undeclared variable -> hard error (no silent 0)
    }
    if peek()==TT_PNCT&&(pval()==91||pval()==123) {
        let mu = "error: unexpected token in expression\n"
        file_write(2, mu+8, len(mu)); exit(1)
    }
    let vr5=nv(); iremit(IR_CONST,vr5,0,0,0); return vr5
}

// === X86-64 CODE EMITTER ===
// All arithmetic, no bitwise ops
// Registers: RAX=0, RCX=1, RDX=2, RBX=3, RSP=4, RBP=5, RSI=6, RDI=7, R8..R15=8..15
let R_RAX=0; let R_RCX=1; let R_RDX=2; let R_RBX=3; let R_RSP=4; let R_RBP=5
let R_RSI=6; let R_RDI=7; let R_R8=8; let R_R9=9; let R_R10=10; let R_R11=11
let R_R12=12; let R_R13=13; let R_R14=14; let R_R15=15

let cs = 0  // caller-saved count for save/restore

// Emit helpers (use builtins emit_byte, emit_i32, emit_i64)
fn eb(v) { let a=codelen; codelen=a+1; w8(code+a,v%256) }
fn ei(v) { let a=codelen; codelen=a+4; w32(code+a,v) }
fn eq(v) { let a=codelen; codelen=a+8; w64(code+a,v) }

// Write a 4-byte little-endian value into the code buffer (used for patching
// relative offsets without disturbing the following bytes).
fn w32(p,v) {
    w8(p, v&255); w8(p+1, (v>>8)&255); w8(p+2, (v>>16)&255); w8(p+3, (v>>24)&255)
}

fn mr(mod, reg, rm) { eb(mod*64 + (reg&7)*8 + (rm&7)) }
fn rw(reg, rm) {
    let v=72; if reg>=8 { v=v+4 }; if rm>=8 { v=v+1 }; eb(v)
}
fn ri(reg, imm) {
    if reg>=8 { eb(65); eb(184+(reg%8)) } else { eb(184+reg) }; ei(imm)
}
fn ri64(reg, imm) {
    if reg>=8 { eb(73); eb(184+(reg%8)) } else { eb(72); eb(184+reg) }; eq(imm)
}
fn rr(d,s) {
    if d==s { return }
    if s<8&&d<8 { rw(s,d); eb(137); mr(3,s,d) } else { rw(s,d); eb(137); mr(3,s%8,d%8) }
}
fn ra(d,s) { rw(s,d); eb(1); mr(3,s%8,d%8) }
fn rs(d,s) { rw(s,d); eb(41); mr(3,s%8,d%8) }
fn rm(d,s) { rw(d,s); eb(15); eb(175); mr(3,d%8,s%8) }
fn rxor(d,s) { rw(s,d); eb(49); mr(3,s%8,d%8) }
fn rand(d,s) { rw(s,d); eb(33); mr(3,s%8,d%8) }
fn ror(d,s) { rw(s,d); eb(9); mr(3,s%8,d%8) }
fn rcmp(r1,r2) { rw(r2,r1); eb(57); mr(3,r2%8,r1%8) }
fn rtest(r1,r2) { rw(r1,r2); eb(133); mr(3,r1%8,r2%8) }
fn rcqo() { eb(72); eb(153) }
fn smov(memreg, srcreg) { rw(srcreg, memreg); eb(137); mr(0, srcreg%8, memreg%8) }  // mov [memreg], srcreg
fn rneg(r) { if r>=8 { eb(73) } else { eb(72) }; eb(247); mr(3,3,r%8) }
fn rnot(r) { if r>=8 { eb(73) } else { eb(72) }; eb(247); mr(3,2,r%8) }
fn ridiv(r) { if r>=8 { eb(73) } else { eb(72) }; eb(247); mr(3,7,r%8) }
fn rshl(d,s) { if s!=1 { rr(1,s) }; eb(72); eb(211); mr(3,4,d%8) }
fn rshr(d,s) { if s!=1 { rr(1,s) }; eb(72); eb(211); mr(3,5,d%8) }

fn rsetc(cc,r) {
    let c=0
    if cc==0 { c=148 } else if cc==1 { c=149 } else if cc==2 { c=156 } else if cc==3 { c=159 } else if cc==4 { c=158 } else if cc==5 { c=157 }
    if r<4 { eb(15); eb(c); mr(3,0,r) } else if r<8 { eb(64); eb(15); eb(c); mr(3,0,r%8) } else { eb(65); eb(15); eb(c); mr(3,0,r%8) }
}
fn rzx(d,s) {
    if d<8&&s<8 { eb(72); eb(15); eb(182); mr(3,d%8,s%8); return }
    rw(d,s); eb(15); eb(182); mr(3,d%8,s%8)
}
fn xpush(r) { if r<8 { eb(80+r) } else { eb(65); eb(80+(r%8)) } }
fn xpop(r) { if r<8 { eb(88+r) } else { eb(65); eb(88+(r%8)) } }
fn ret() { eb(195) }
fn sysc() { eb(15); eb(5) }
fn callr(r) { if r<8 { eb(255); mr(3,2,r) } else { eb(65); eb(255); mr(3,2,r%8) } }
fn sbi(imm) { eb(72); eb(129); mr(3,5,4); ei(imm) }
fn abi(imm) { eb(72); eb(129); mr(3,0,4); ei(imm) }
fn wbp(d,r) { rw(r,5); eb(137); if r>=8 { mr(2,r%8,4); eb(37) } else { mr(2,r%8,5) }; ei(d) }
fn rbp(r,d) { rw(r,5); eb(139); if r>=8 { mr(2,r%8,4); eb(37) } else { mr(2,r%8,5) }; ei(d) }
fn wsp(d,r) { rw(r,4); eb(137); mr(2,r%8,4); eb(36); ei(d) }
fn rsp(r,d) { rw(r,4); eb(139); mr(2,r%8,4); eb(36); ei(d) }
// wbase(d, vr): mov [r11+d], vr  -- r11 is an explicit base reg (NOT rbp), so it
// avoids the REX.B/rbp conflict that breaks rbp+extended-reg encodings.
fn wbase(d, vr) { let rex=73; if vr>=8 { rex=77 }; eb(rex); eb(137); mr(2, vr%8, 3); ei(d) }
// lbase(d, vr): mov vr, [r11+d]
fn lbase(d, vr) { let rex=73; if vr>=8 { rex=77 }; eb(rex); eb(139); mr(2, vr%8, 3); ei(d) }
fn leabp(r,d) { let v=72; if r>=8 { v=73 }; eb(v); eb(141); if r>=8 { mr(2,r%8,4); eb(37) } else { mr(2,r%8,5) }; ei(d) }
fn rmr(rd,ad) { rw(rd,ad); eb(139); mr(0,rd%8,ad%8) }
fn wmr(ad,vl) { rw(vl,ad); eb(137); mr(0,vl%8,ad%8) }
fn rmr8(rd,ad) { rw(rd,ad); eb(15); eb(182); mr(0,rd%8,ad%8) }
fn wmr8(ad,vl) { if vl<4 { eb(72) }; eb(136); mr(0,vl%8,ad%8) }
fn lesp(r,d) { rw(r,4); eb(141); mr(2,r%8,4); eb(36); ei(d) }
fn wmi(b,d,i) { if b>=8 { eb(73) } else { eb(72) }; eb(199); mr(2,0,b%8); ei(d); ei(i) }
fn wm8i(b,d,i) { if b>=8 { eb(65) } else { eb(64) }; eb(198); mr(2,0,b%8); ei(d); eb(i%256) }
fn jmp32(o) { eb(233); ei(o) }
fn jcc32(cc,o) {
    let c=0; if cc==0 { c=132 } else if cc==1 { c=133 } else if cc==2 { c=140 } else if cc==3 { c=143 } else if cc==4 { c=142 } else if cc==5 { c=141 }
    eb(15); eb(c); ei(o)
}
// G2: inline overflow trap. After a signed arithmetic op sets OF, a short `jno`
// skips a 2-byte `ud2` (0F 0B). On overflow (OF=1) we fall into ud2 -> #UD ->
// SIGILL (signal 4): deterministic death. No rel32 relocation needed (rel8).
// `ii` = current IR record index; if it was emitted inside `unsafe {}`
// (ir_unsafe[ii]!=0) the trap is suppressed (user opted out).
fn ovf_trap_emit(ii) { if ovf_trap==1 && r8(ir_unsafe+ii)==0 { eb(113); eb(2); eb(15); eb(11) } }
// G2p3: shift-COUNT UB trap. x86 `shl/shr r/m64, cl` masks the count to 6 bits,
// so `x << 64` silently == `x << 0`. With the count already in rcx, emit:
//   cmp rcx,64 ; jb +2 ; ud2   (48 83 F9 40 / 72 02 / 0F 0B)
// count>=64 (or negative -> huge unsigned) falls into ud2 -> SIGILL. Suppressed
// inside unsafe{} (same ir_unsafe gate as the overflow trap).
fn shl_trap_emit(ii) { if ovf_trap==1 && r8(ir_unsafe+ii)==0 { eb(72); eb(131); eb(249); eb(64); eb(114); eb(2); eb(15); eb(11) } }
// G2 containers: bounds-check for indexed access `a[idx]`. At the call site the
// base pointer is in rax and idx is in rcx. Emit `cmp [rax], rcx; jb +2; ud2`:
//   unsigned idx >= len (or negative -> huge unsigned) falls through into ud2 ->
//   SIGILL rc=132. Suppressed inside unsafe{} (same ir_unsafe gate). The +8 data
//   offset is applied in the lea that follows this check.
fn idx_trap_emit(ii) { if ovf_trap==1 && r8(ir_unsafe+ii)==0 { eb(72); eb(59); eb(8); eb(114); eb(2); eb(15); eb(11) } }

// === REGISTER ALLOCATOR (corrected: reload on use, persist results) ===
let REGS = mmap(112)  // 14 physical regs (all except RSP=4, RBP=5)
fn init_regs() {
    w64(REGS+0, 0); w64(REGS+8, 1); w64(REGS+16, 2); w64(REGS+24, 3)
    w64(REGS+32, 6); w64(REGS+40, 7); w64(REGS+48, 8); w64(REGS+56, 9)
    w64(REGS+64, 10); w64(REGS+72, 12); w64(REGS+80, 13); w64(REGS+88, 14)
    w64(REGS+96, 15)
}

let alloc = mmap(2000000); let allocfc = 0
let vr_init = mmap(2000000)
let vr_spill = mmap(2000000)
let SPILL_BASE = 48
fn spill_home(v) { return -(SPILL_BASE + (v + 1) * 8) }

// aphys(vr): return a physical reg holding vr's value. On first use, allocate a
// reg and reload from the home slot if the vreg has a defined value.
fn aphys(vr) {
    let f=afind(vr); if f>=0 { return f }
    let p=afree()
    if r8(vr_init+vr)!=0 { rbp(p, spill_home(vr)) }
    aset(vr,p); return p
}

// adistinct(res, a1, a2): like aphys(res) but guarantees the returned physical
// register is NOT a1 and NOT a2 (the operand registers).  This prevents a
// binary result dst from aliasing an operand, which would let the zeroing /
// read-modify-write (xor dst,dst / or dst,r2 / and dst,r2) clobber the operand
// before it is consumed.  Operands must be loaded with aphys FIRST (so they
// own their registers), then adistinct picks a distinct register for the result.
fn adistinct(res, a1, a2) {
    let f=afind(res); if f>=0 { if f!=a1&&f!=a2 { return f } }
    // evict everything mapped to a1 or a2 so the result cannot reuse them
    let i=0
    while i<allocfc {
        let pr=r64(alloc+i*16+8)
        if pr==a1||pr==a2 {
            let ev_vr=r64(alloc+i*16)
            if r8(vr_init+ev_vr)!=0 { wbp(spill_home(ev_vr), pr) }
            w8(vr_spill+ev_vr, 1)
            // remove this entry by overwriting with last
            allocfc=allocfc-1
            w64(alloc+i*16, r64(alloc+allocfc*16))
            w64(alloc+i*16+8, r64(alloc+allocfc*16+8))
        } else { i=i+1 }
    }
    // Pick a free physical reg that is NEITHER a1 NOR a2.  afree()
    // would otherwise hand back a just-evicted operand register as the
    // result, aliasing rd with an operand so the xor/or/and rd,rd
    // clobbers the operand before cmp consumes it.
    let p=-1; let k=0
    while k<14 {
        let pr=r64(REGS+k*8)
        if pr!=a1 && pr!=a2 {
            let used=0; let j=0
            while j<allocfc { if r64(alloc+j*16+8)==pr { used=1; break }; j=j+1 }
            if used==0 { p=pr; break }
        }
        k=k+1
    }
    if p<0 {
        // Degenerate: only a1/a2 still mapped. Evict a vreg that is NEITHER a1
        // NOR a2 and reuse its register, so the result never aliases an operand.
        allocfc=allocfc-1
        let ev_vr=r64(alloc+allocfc*16); let ev_pr=r64(alloc+allocfc*16+8)
        while ev_pr==a1 || ev_pr==a2 {
            w64(alloc+allocfc*16, r64(alloc+(allocfc-1)*16))
            w64(alloc+allocfc*16+8, r64(alloc+(allocfc-1)*16+8))
            allocfc=allocfc-1
            ev_vr=r64(alloc+allocfc*16); ev_pr=r64(alloc+allocfc*16+8)
        }
        if r8(vr_init+ev_vr)!=0 { wbp(spill_home(ev_vr), ev_pr) }
        w8(vr_spill+ev_vr, 1)
        p=ev_pr
    }
    if r8(vr_init+res)!=0 { rbp(p, spill_home(res)) }
    aset(res,p); return p
}

fn afind(vr) {
    let i=0; while i<allocfc { if r64(alloc+i*16)==vr { return r64(alloc+i*16+8) }; i=i+1 }; return -1
}

fn aset(vr,pr) {
    if allocfc >= ALLOC_CAP { emit_ovf() }
    w64(alloc+allocfc*16,vr); w64(alloc+allocfc*16+8,pr); allocfc=allocfc+1
}

fn aclr() { allocfc=0; let i=0; while i<vreg_n { w8(vr_init+i,0); w8(vr_spill+i,0); i=i+1 } }

// afree(): return a free physical reg, evicting a mapped vreg (spilling it) if needed.
fn afree() {
    let k=0
    while k<14 {
        let pr=r64(REGS+k*8)
        let used=0; let j=0
        while j<allocfc { if r64(alloc+j*16+8)==pr { used=1; break }; j=j+1 }
        if used==0 { return pr }
        k=k+1
    }
    allocfc=allocfc-1
    let ev_vr=r64(alloc+allocfc*16); let ev_pr=r64(alloc+allocfc*16+8)
    if r8(vr_init+ev_vr)!=0 { wbp(spill_home(ev_vr), ev_pr) }
    w8(vr_spill+ev_vr, 1)
    return ev_pr
}

fn flush_all() {
    let i=0
    while i<allocfc {
        let vr=r64(alloc+i*16); let pr=r64(alloc+i*16+8)
        if r8(vr_init+vr)!=0 { wbp(spill_home(vr), pr) }
        w8(vr_spill+vr, 1)
        i=i+1
    }
    allocfc=0
}

// flush_clob(r0,r1,r2): target clobber-save for arithmetic ops (idiv/shl/shr)
// that only destroy the given physical regs (rax=0, rcx=1, rdx=2). Spills just
// those vregs to their home slots (already current via sdef) and frees the
// physical regs, leaving every OTHER live vreg resident -> far fewer downstream
// reloads than flush_all(). Home slots stay current, so the existing
// rbp(0,home)/rbp(1,home) reloads after the op remain correct.
fn flush_clob(r0,r1,r2) {
    let i=0
    while i<allocfc {
        let vr=r64(alloc+i*16); let pr=r64(alloc+i*16+8)
        if pr==r0 || pr==r1 || pr==r2 {
            if r8(vr_init+vr)!=0 { wbp(spill_home(vr), pr) }
            w8(vr_spill+vr, 1)
            allocfc=allocfc-1
            w64(alloc+i*16, r64(alloc+allocfc*16))
            w64(alloc+i*16+8, r64(alloc+allocfc*16+8))
        } else { i=i+1 }
    }
}

// === FLOAT REGISTER ALLOCATOR (x86: xmm0-7; ARM: v0-7) ===
// Mirrors the integer allocator but routes float vregs to the FP register file.
// Float homes live in a SEPARATE spill region (fspill_home) so they never collide
// with integer homes (which use spill_home). Both write 8 bytes; a float vreg vr
// and an int vreg vr with the same index must NOT share a slot.
let FREGS = mmap(64)   // 8 xmm/v physical regs
fn init_fregs() {
    w64(FREGS+0, 0); w64(FREGS+8, 1); w64(FREGS+16, 2); w64(FREGS+24, 3)
    w64(FREGS+32, 4); w64(FREGS+40, 5); w64(FREGS+48, 6); w64(FREGS+56, 7)
}
let falloc = mmap(2000000); let fallocfc = 0
let fvr_init = mmap(2000000)
let fvr_spill = mmap(2000000)
fn fspill_home(v) { return -(SPILL_BASE + 8192 + (v + 1) * 8) }

fn fphys(vr) {
    let f=ffind(vr); if f>=0 { return f }
    let p=ffree()
    if r8(fvr_init+vr)!=0 { frld(p, fspill_home(vr)) }
    fset(vr,p); return p
}
fn fdistinct(res, a1, a2) {
    let f=ffind(res); if f>=0 { if f!=a1&&f!=a2 { return f } }
    let i=0
    while i<fallocfc {
        let pr=r64(falloc+i*16+8)
        if pr==a1||pr==a2 {
            let ev_vr=r64(falloc+i*16)
            if r8(fvr_init+ev_vr)!=0 { frld(pr, fspill_home(ev_vr)) }
            w8(fvr_spill+ev_vr, 1)
            fallocfc=fallocfc-1
            w64(falloc+i*16, r64(falloc+fallocfc*16))
            w64(falloc+i*16+8, r64(falloc+fallocfc*16+8))
        } else { i=i+1 }
    }
    let p=-1; let k=0
    while k<8 {
        let pr=r64(FREGS+k*8)
        if pr!=a1 && pr!=a2 {
            let used=0; let j=0
            while j<fallocfc { if r64(falloc+j*16+8)==pr { used=1; break }; j=j+1 }
            if used==0 { p=pr; break }
        }
        k=k+1
    }
    if p<0 {
        fallocfc=fallocfc-1
        let ev_vr=r64(falloc+fallocfc*16); let ev_pr=r64(falloc+fallocfc*16+8)
        while ev_pr==a1 || ev_pr==a2 {
            w64(falloc+fallocfc*16, r64(falloc+(fallocfc-1)*16))
            w64(falloc+fallocfc*16+8, r64(falloc+(fallocfc-1)*16+8))
            fallocfc=fallocfc-1
            ev_vr=r64(falloc+fallocfc*16); ev_pr=r64(falloc+fallocfc*16+8)
        }
        if r8(fvr_init+ev_vr)!=0 { frld(ev_pr, fspill_home(ev_vr)) }
        w8(fvr_spill+ev_vr, 1)
        p=ev_pr
    }
    if r8(fvr_init+res)!=0 { frld(p, fspill_home(res)) }
    fset(res,p); return p
}
fn ffind(vr) {
    let i=0; while i<fallocfc { if r64(falloc+i*16)==vr { return r64(falloc+i*16+8) }; i=i+1 }; return -1
}
fn fset(vr,pr) {
    if fallocfc >= ALLOC_CAP { emit_ovf() }
    w64(falloc+fallocfc*16,vr); w64(falloc+fallocfc*16+8,pr); fallocfc=fallocfc+1
}
fn fclr() { fallocfc=0; let i=0; while i<vreg_n { w8(fvr_init+i,0); w8(fvr_spill+i,0); i=i+1 } }
fn ffree() {
    let k=0
    while k<8 {
        let pr=r64(FREGS+k*8)
        let used=0; let j=0
        while j<fallocfc { if r64(falloc+j*16+8)==pr { used=1; break }; j=j+1 }
        if used==0 { return pr }
        k=k+1
    }
    fallocfc=fallocfc-1
    let ev_vr=r64(falloc+fallocfc*16); let ev_pr=r64(falloc+fallocfc*16+8)
    if r8(fvr_init+ev_vr)!=0 { frld(ev_pr, fspill_home(ev_vr)) }
    w8(fvr_spill+ev_vr, 1)
    return ev_pr
}
fn fflush_all() {
    let i=0
    while i<fallocfc {
        let vr=r64(falloc+i*16); let pr=r64(falloc+i*16+8)
        if r8(fvr_init+vr)!=0 { frld(pr, fspill_home(vr)) }
        w8(fvr_spill+vr, 1)
        i=i+1
    }
    fallocfc=0
}
fn fdef(vr, reg) { frld(reg, fspill_home(vr)); w8(fvr_init+vr, 1) }
// frld(xmm, off): movsd xmm, [rbp+off]  (REX.W F2 0F 10 /r with rbp base)
fn frld(xmm, off) { eb(0xF2); eb(73); eb(15); eb(16); mr(2, xmm, 5); ei(off) }

// x86 SSE emit helpers (target_arch==0)
// xmm reg encoding in ModRM/reg fields: just the index 0-7.
fn frr(d,s) { if d==s { return }; eb(0xF2); eb(15); eb(16); mr(3,d,s) }   // movsd xmm(d), xmm(s)
fn fadd(d,s) { eb(0xF2); eb(15); eb(88); mr(3,d,s) }   // addsd xmm(d), xmm(s)
fn fsub(d,s) { eb(0xF2); eb(15); eb(92); mr(3,d,s) }   // subsd xmm(d), xmm(s)
fn fmul(d,s) { eb(0xF2); eb(15); eb(89); mr(3,d,s) }   // mulsd xmm(d), xmm(s)
fn fdiv(d,s) { eb(0xF2); eb(15); eb(94); mr(3,d,s) }   // divsd xmm(d), xmm(s)
fn fld_x(rdx_gp, xmm) { eb(0xF2); eb(15); eb(16); mr(2, xmm, rdx_gp%8) }   // movsd xmm, [gp]  (REX.W + F2 0F 10 /r)
fn fst_x(gp, xmm) { eb(0xF2); eb(15); eb(17); mr(2, xmm, gp%8) }           // movsd [gp], xmm
fn fi2f(xmm, gp) { eb(0xF2); eb(15); eb(42); mr(2, xmm, gp%8) }  // cvtsi2sd xmm, gp  (REX.W F2 0F 2A /r)
fn ff2i(gp, xmm) { eb(0xF2); eb(15); eb(46); mr(2, gp%8, xmm) }  // cvttsd2si gp, xmm (REX.W F2 0F 2C /r)
fn fcomi(xmm1, xmm2) { eb(0x66); eb(15); eb(44); mr(3, xmm1, xmm2) }  // comisd xmm1, xmm2 (sets EFLAGS)


// === divide-by-const signed magic (strength reduction for IR_DIV by constant) ===
let magicM = 0
let magicSh = 0
// unsigned >= without xor: if signs equal use signed compare; else the
// non-negative operand is larger in unsigned order.
fn uge(a, b) {
  if a >= 0 {
    if b >= 0 { return a >= b }
    return 1
  }
  if b >= 0 { return 0 }
  return a >= b
}
// compute signed-division magic (M, sh) for nonzero divisor d.
// M is negated when d<0 so the mul-add recovery needs no separate negation.
fn compute_magic(d) {
  // G2: signed-division magic-number recovery does deliberate 64-bit
  // wraparound (H = 2^63-1, shifts past bit 63, negations). Wrap in unsafe{}
  // so it is exempt from the overflow trap during self-host bootstrapping.
  unsafe {
  let ad = d
  if d < 0 { ad = -d }
  let H = 9223372036854775807   // 2^63 - 1 (literal: avoids (1<<63)-1 overflow trap)
  let anc = H - (H % ad)
  let q1 = H / anc
  let r1 = H - q1 * anc + 1
  let q2 = H / ad
  let r2 = H - q2 * ad + 1
  let p = 63
  while 1 == 1 {
    p = p + 1
    q1 = q1 << 1
    r1 = r1 << 1
    if uge(r1, anc) { q1 = q1 + 1; r1 = r1 - anc }
    q2 = q2 << 1
    r2 = r2 << 1
    if uge(r2, ad) { q2 = q2 + 1; r2 = r2 - ad }
    let delta = ad - r2
    let brk = uge(q1, delta)
    if brk == 1 {
      if q1 == delta && r1 == 0 { brk = 0 }
    }
    if brk == 1 { break }
  }
  let M = q2 + 1
  if d < 0 { M = -M }
  let sh = p - 64
  magicM = M
  magicSh = sh
  return 0
  }
}

// sdef(vr, reg): store result to home slot AND mark vreg defined (so later
// aphys reloads the correct value after a flush_all).
fn sdef(vr, reg) { wbp(spill_home(vr), reg); w8(vr_init+vr, 1) }
// === BUILD IN NAME CHECK ===

// Emit inline machine code for a built-in call.  Arguments have already been
// placed in the ABI registers (rdi,rsi,rdx,rcx,r8,r9); the result is left in
// rax.  Returns 1 if a built-in was emitted, 0 otherwise.
fn emit_bltn(nmi,nl) {
    let nm=src+nmi
    // exit(code): mov eax,60; syscall   (arg0 already in rdi from IR_CALL arg load)
    if nl==4&&r8(nm)=='e'&&r8(nm+1)=='x'&&r8(nm+2)=='i'&&r8(nm+3)=='t' {
        eb(184); ei(60); sysc(); return 1
    }
    // free(ptr): munmap(ptr, len) where len = *(ptr) (the header = element count).
    //   mmap rounds the base up to a page, so the region starting at the user
    //   pointer (mapped length n*8+8) is exactly one page; unmapping len bytes
    //   (the kernel rounds len up to a page) frees the whole allocation.
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='r'&&r8(nm+2)=='e'&&r8(nm+3)=='e' {
        flush_all()
        // free(ptr): munmap(ptr, len).  The allocation carries a header word
        // ([ptr] = element count n); munmap rounds len up to a page so passing
        // n frees the whole page-granular region.  arg0 (ptr) is in rdi from
        // the IR_CALL arg load; we read the header into rsi for the length.
        eb(72); eb(139); eb(55)        // mov rsi, [rdi]   (len = header; munmap rounds up)
        eb(184); ei(11)                // mov eax, 11      (munmap)
        sysc(); return 1
    }
    // P6.1a: float builtins. Args arrive as raw 64-bit bit-patterns in rdi (arg0)
    // / rsi (arg1) from the IR_CALL arg load. Float results are returned as raw
    // 64-bit bit-patterns in rax (so callers chain them through i2f/f2i and the
    // arithmetic builtins below with no FP register-file involvement in the IR).
    // Encoding notes (REX.W=48):
    //   movq xmmN, rM  = 66 48 0F 6E modrm   (GP -> xmm, raw 64b)
    //   movq rM, xmmN  = 66 48 0F 7E modrm   (xmm -> GP, raw 64b)
    //   cvtsi2sd xmmN, rM = 48 F2 0F 2A modrm (int64 -> double)
    //   cvttsd2si rM, xmmN = 48 F2 0F 2C modrm (double -> int64 truncate)
    //   addsd/subsd/mulsd/divsd xmmD, xmmS = F2 0F 58/5C/59/5E modrm
    if nl==3&&r8(nm)=='i'&&r8(nm+1)=='2'&&r8(nm+2)=='f' {  // i2f(x): int64 -> f64
        flush_all()
        eb(72); eb(242); eb(15); eb(42); eb(199)  // 48 F2 0F 2A C7  cvtsi2sd xmm0, rdi
        eb(102); eb(72); eb(15); eb(126); eb(192) // 66 48 0F 7E C0  movq rax, xmm0
        return 1
    }
    if nl==3&&r8(nm)=='f'&&r8(nm+1)=='2'&&r8(nm+2)=='i' {  // f2i(x): f64 -> int64 (trunc)
        flush_all()
        eb(102); eb(72); eb(15); eb(110); eb(199) // 66 48 0F 6E C7  movq xmm0, rdi
        eb(72); eb(242); eb(15); eb(44); eb(192)  // 48 F2 0F 2C C0  cvttsd2si rax, xmm0
        return 1
    }
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='a'&&r8(nm+2)=='d'&&r8(nm+3)=='d' {  // fadd(a,b): int args -> truncated int
        flush_all()
        eb(72); eb(242); eb(15); eb(42); eb(199)  // cvtsi2sd xmm0, rdi
        eb(72); eb(242); eb(15); eb(42); eb(206)  // cvtsi2sd xmm1, rsi
        eb(242); eb(15); eb(88); eb(193)          // addsd xmm0, xmm1
        eb(72); eb(242); eb(15); eb(44); eb(192)  // cvttsd2si rax, xmm0  (48 F2 0F 2C C0)
        return 1
    }
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='s'&&r8(nm+2)=='u'&&r8(nm+3)=='b' {  // fsub(a,b)
        flush_all()
        eb(72); eb(242); eb(15); eb(42); eb(199)  // cvtsi2sd xmm0, rdi
        eb(72); eb(242); eb(15); eb(42); eb(206)  // cvtsi2sd xmm1, rsi
        eb(242); eb(15); eb(92); eb(193)          // subsd xmm0, xmm1
        eb(72); eb(242); eb(15); eb(44); eb(192)  // cvttsd2si rax, xmm0
        return 1
    }
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='m'&&r8(nm+2)=='u'&&r8(nm+3)=='l' {  // fmul(a,b)
        flush_all()
        eb(72); eb(242); eb(15); eb(42); eb(199)  // cvtsi2sd xmm0, rdi
        eb(72); eb(242); eb(15); eb(42); eb(206)  // cvtsi2sd xmm1, rsi
        eb(242); eb(15); eb(89); eb(193)          // mulsd xmm0, xmm1
        eb(72); eb(242); eb(15); eb(44); eb(192)  // cvttsd2si rax, xmm0
        return 1
    }
    if nl==4&&r8(nm)=='f'&&r8(nm+1)=='d'&&r8(nm+2)=='i'&&r8(nm+3)=='v' {  // fdiv(a,b)
        flush_all()
        eb(72); eb(242); eb(15); eb(42); eb(199)  // cvtsi2sd xmm0, rdi
        eb(72); eb(242); eb(15); eb(42); eb(206)  // cvtsi2sd xmm1, rsi
        eb(242); eb(15); eb(94); eb(193)          // divsd xmm0, xmm1
        eb(72); eb(242); eb(15); eb(44); eb(192)  // cvttsd2si rax, xmm0
        return 1
    }
    // mem_alloc(n): G2 containers. Returns a header-carrying array:
    //   [base] = n (element count); base+8 .. base+8+n*8 = n qwords.
    //   Layout matches IR_TALLOC so a[i]/a[i]=v work.  arg0 (n) arrives in
    //   rdi from the IR_CALL arg load (same path as mmap(64), which works).
    if nl==9&&r8(nm)=='m'&&r8(nm+1)=='e'&&r8(nm+2)=='m'&&r8(nm+3)=='_'&&r8(nm+4)=='a'&&r8(nm+5)=='l'&&r8(nm+6)=='l'&&r8(nm+7)=='o'&&r8(nm+8)=='c' {
        flush_all()
        eb(72); eb(137); eb(251)        // mov rbx, rdi   (rbx = n, saved across hint-set + syscall)
        eb(72); eb(137); eb(249)        // mov rcx, rdi   (rcx = n)
        eb(72); eb(107); eb(201); eb(8)   // imul rcx, rcx, 8   (n*8)
        eb(72); eb(131); eb(193); eb(8)   // add rcx, 8           (n*8+8 = len)
        eb(72); eb(137); eb(206)         // mov rsi, rcx   (rsi = len)
        eb(191); ei(0x60000001)          // mov edi, 0x60000001 (hint addr)
        eb(186); ei(3)                   // mov edx, 3     (PROT_READ|WRITE)
        eb(65); eb(186); ei(34)          // mov r10d, 0x22 (MAP_PRIVATE|ANON)
        eb(65); eb(184); ei(0-1)         // mov r8d, -1    (fd)
        eb(69); eb(49); eb(201)          // xor r9d, r9d   (offset=0)
        eb(184); ei(9)                   // mov eax, 9
        sysc()                           // rax = ptr
        eb(72); eb(137); eb(24)          // mov [rax], rbx   ([base] = n header; rbx preserved)
        return 1
    }
    // mk_any(tag, val): t9 generics primitive. Returns a STACK-LOCAL 2-tuple
    // (ptr, len=16); [ptr]=tag, [ptr+8]=val. Caller may copy it (w64) if it
    // must outlive this frame (tuple/return semantics handle the copy).
    if nl==6&&r8(nm)=='m'&&r8(nm+1)=='k'&&r8(nm+2)=='_'&&r8(nm+3)=='a'&&r8(nm+4)=='n'&&r8(nm+5)=='y' {
        // mk_any(tag, val): allocate a 16-byte tagged tuple via mmap and store
        // (tag, val). Args arrive in rdi=tag, rsi=val (loaded by IR_CALL).
        // SYSCALL clobbers r11/rcx, and any other register may be reused or
        // clobbered by an interleaved helper call. The only spill guaranteed
        // safe across the syscall AND any call is the stack, so push tag/val,
        // do the mmap, pop into scratch, and store.
        eb(87)                            // push rdi   (save tag)
        eb(86)                            // push rsi   (save val)
        ri(7, 16)                          // rdi = 16 bytes
        eb(72); eb(137); eb(254)          // mov rsi, rdi   (len)
        eb(191); ei(0x60000001)          // mov edi, 0x60000000 (hint addr)
        eb(186); ei(3)                    // mov edx, 3     (PROT_READ|WRITE)
        eb(65); eb(186); ei(34)           // mov r10d, 0x22 (MAP_PRIVATE|ANON)
        eb(65); eb(184); ei(0-1)          // mov r8d, -1    (fd)
        eb(69); eb(49); eb(201)           // xor r9d, r9d   (offset=0)
        eb(184); ei(9)                    // mov eax, 9
        sysc()                            // rax = ptr to 16-byte buffer
        eb(90)                            // pop rdx    (val)
        eb(89)                            // pop rcx    (tag)
        eb(72); eb(137); eb(8)            // 48 89 08 = mov [rax], rcx   (tag)
        eb(72); eb(137); eb(80); eb(8)    // 48 89 50 08 = mov [rax+8], rdx  (val)
        return 1                          // result (ptr) already in rax -> IR_CALL saves it
    }
    if nl==4&&r8(nm)=='m'&&r8(nm+1)=='m'&&r8(nm+2)=='a'&&r8(nm+3)=='p' {
        eb(72); eb(137); eb(254)      // mov rsi, rdi   (len)
        eb(191); ei(0x60000001)       // mov edi, 0x60000000 (addr HINT: high, away from fixed GDATA@0x42200000)
        eb(186); ei(3)                // mov edx, 3     (PROT_READ|WRITE)
        eb(65); eb(186); ei(34)       // mov r10d, 0x22 (MAP_PRIVATE|ANON)
        eb(65); eb(184); ei(0-1)      // mov r8d, -1    (fd)
        eb(69); eb(49); eb(201)       // xor r9d, r9d   (offset=0)
        eb(184); ei(9)                // mov eax, 9
        sysc(); return 1
    }
    // mem_load / mem_load8 / mem_store / mem_store8
    if nl>=8&&r8(nm)=='m'&&r8(nm+1)=='e'&&r8(nm+2)=='m'&&r8(nm+3)=='_' {
        if r8(nm+4)=='l' {
            if nl==9 { eb(72); eb(15); eb(182); eb(7); return 1 }  // mem_load8: movzx rax,byte[rdi]
            eb(72); eb(139); eb(7); return 1                       // mem_load:  mov rax,[rdi]
        }
        if r8(nm+4)=='s' {
            if nl==10 { 
                eb(72); eb(133); eb(255)       // test rdi, rdi
                eb(116); eb(3)                 // jz +3 (skip the store when rdi==0)
                eb(64); eb(136); eb(55)        // mov [rdi], sil
                eb(72); eb(137); eb(240)       // mov rax, rsi  (return value)
                return 1 
            }        // mem_store8 (inline): null-guarded store, no ret
            eb(72); eb(137); eb(55); return 1                      // mem_store:  mov [rdi],rsi
        }
    }
// file_open / file_read / file_write / file_close
    if nl>=8&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='l'&&r8(nm+3)=='e'&&r8(nm+4)=='_' {
        let c5=r8(nm+5)
        if c5=='o' { eb(184); ei(2); sysc(); return 1 }  // open: rdi=path rsi=flags rdx=mode (caller sets); mov eax,2; syscall
        if c5=='r' { eb(184); ei(0); sysc(); return 1 }                    // read
        if c5=='w' { eb(184); ei(1); sysc(); return 1 }                    // write
        if c5=='c' { eb(184); ei(3); sysc(); return 1 }                    // close
    }
    // print(buf, len): write(1, buf, len)
    // call convention leaves rdi=buf, rsi=len. Need: rax=1, rdi=1, rsi=buf, rdx=len.
    if nl==5&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t' {
        eb(72); eb(137); eb(242)     // mov rdx, rsi   (count = len)
        eb(72); eb(137); eb(254)     // mov rsi, rdi   (buf = buf)
        eb(191); ei(1)               // mov edi, 1     (fd = stdout; zero-extends to rdi)
        eb(184); ei(1)               // mov eax, 1     (sys_write)
        sysc(); return 1
    }
    // printi(val): write decimal representation of the integer in rdi to stdout.
    if nl==6&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='i' {
        flush_all()   // spill all live vregs; after this any register is safe to clobber
        let l_pos=nl(); let l_zero=nl(); let l_loop=nl(); let l_done=nl(); let l_signprep=nl(); let l_write=nl()
        rr(0,7)                          // rax = rdi (value)
        sbi(32)                          // sub rsp, 32  (decimal digit buffer)
        lesp(10, 23)                      // r10 = rsp + 23  (direct buffer pointer, high end)
        rxor(8,8)                        // r8 = len = 0
        rxor(9,9)                        // r9 = sign = 0
        rr(9,0)                          // r9 = value (for sign-bit extraction)
        eb(77); eb(193); eb(233); eb(63) // shr r9, 63   (sign bit)
        rtest(9,9)
        let p=codelen; jcc32(0,0); emit_patch(p, l_pos, 1)   // je l_pos (non-negative)
        rneg(0)                          // neg rax (make positive)
        lbladd(l_pos, codelen)
        rtest(0,0)
        let p=codelen; jcc32(0,0); emit_patch(p, l_zero, 1)  // je l_zero (value == 0)
        let p=codelen; jmp32(0); emit_patch(p, l_loop, 0)    // jmp l_loop
        lbladd(l_zero, codelen)
        eb(178); eb(48)                  // mov dl, '0'  (0x30)
        eb(65); eb(136); eb(18)          // mov [r10], dl  (REX.B->r10, reg=2=dl)
        eb(73); eb(255); eb(202)         // dec r10
        eb(73); eb(255); eb(192)         // inc r8
        let p=codelen; jmp32(0); emit_patch(p, l_signprep, 0) // jmp l_signprep
        lbladd(l_loop, codelen)
        rtest(0,0)
        let p=codelen; jcc32(0,0); emit_patch(p, l_done, 1)   // je l_done (no more digits)
        rxor(2,2)                        // xor rdx, rdx
        ri(1,10)                         // rcx = 10
        ridiv(1)                         // rax = quotient, rdx = remainder (digit)
        eb(72); eb(129); eb(194); ei(48) // add rdx, 0x30  (digit -> ascii)
        eb(65); eb(136); eb(18)          // mov [r10], dl  (REX.B->r10, reg=2=dl)
        eb(73); eb(255); eb(202)         // dec r10
        eb(73); eb(255); eb(192)         // inc r8
        let p=codelen; jmp32(0); emit_patch(p, l_loop, 0)     // jmp l_loop
        lbladd(l_done, codelen)
        lbladd(l_signprep, codelen)
        rtest(9,9)
        let p=codelen; jcc32(0,0); emit_patch(p, l_write, 1)  // je l_write (skip if positive)
        eb(178); eb(45)                  // mov dl, '-'  (0x2D)
        eb(65); eb(136); eb(18)          // mov [r10], dl  (REX.B->r10, reg=2=dl)
        eb(73); eb(255); eb(202)         // dec r10
        eb(73); eb(255); eb(192)         // inc r8
        lbladd(l_write, codelen)
        eb(73); eb(141); eb(114); eb(1)  // lea rsi, [r10+1]  (buffer start = rsp+24-len)
        rr(2,8)                          // rdx = r8 (length)
        ri(7,1)                          // rdi = 1 (stdout)
        ri(0,1)                          // rax = 1 (sys_write)
        sysc()
        abi(32)
        return 1
    }
    // println(i): print integer i (decimal) followed by a newline to stdout.
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='l'&&r8(nm+6)=='n' {
        flush_all()
        let lp_pos=nl(); let lp_zero=nl(); let lp_loop=nl(); let lp_done=nl(); let lp_signprep=nl(); let lp_write=nl()
        rr(0,7)                          // rax = rdi (value)
        sbi(32)                          // sub rsp, 32
        lesp(10, 23)                     // r10 = rsp + 23
        rxor(8,8); rxor(9,9); rr(9,0)
        eb(77); eb(193); eb(233); eb(63) // shr r9, 63
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp_pos, 1)   // je lp_pos (non-negative)
        rneg(0)                          // neg rax
        lbladd(lp_pos, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp_zero, 1)   // je lp_zero (value == 0)
        let p=codelen; jmp32(0); emit_patch(p, lp_loop, 0)                // jmp lp_loop
        lbladd(lp_zero, codelen)
        eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192) // '0', dec r10, inc r8
        let p=codelen; jmp32(0); emit_patch(p, lp_signprep, 0)            // jmp lp_signprep
        lbladd(lp_loop, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp_done, 1)   // je lp_done
        rxor(2,2); ri(1,10); ridiv(1)
        eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp_loop, 0)                // jmp lp_loop
        lbladd(lp_done, codelen); lbladd(lp_signprep, codelen)
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp_write, 1)  // je lp_write (skip if positive)
        eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192) // '-'
        lbladd(lp_write, codelen)
        eb(73); eb(141); eb(114); eb(1)   // lea rsi, [r10+1]
        rr(2,8); ri(7,1); ri(0,1); sysc()  // write integer
        // write '\n'
        sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)
        abi(32)
        return 1
    }
    // newline(): emit a single '\n' to stdout.
    if nl==7&&r8(nm)=='n'&&r8(nm+1)=='e'&&r8(nm+2)=='w'&&r8(nm+3)=='l'&&r8(nm+4)=='i'&&r8(nm+5)=='n'&&r8(nm+6)=='e' {
        flush_all()
        sbi(8); lesp(10,0); eb(178); eb(10); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8)
        return 1
    }
    // printsp(i): print integer i followed by a space.
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s'&&r8(nm+6)=='p' {
        flush_all(); let lp3_pos=nl(); let lp3_zero=nl(); let lp3_loop=nl(); let lp3_done=nl(); let lp3_signprep=nl(); let lp3_write=nl()
        rr(0,7); sbi(32); lesp(10,23); rxor(8,8); rxor(9,9); rr(9,0)
        eb(77); eb(193); eb(233); eb(63); rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp3_pos, 1)
        rneg(0); lbladd(lp3_pos, codelen); rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp3_zero, 1)
        let p=codelen; jmp32(0); emit_patch(p, lp3_loop, 0); lbladd(lp3_zero, codelen)
        eb(178); eb(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp3_signprep, 0); lbladd(lp3_loop, codelen)
        rtest(0,0); let p=codelen; jcc32(0,0); emit_patch(p, lp3_done, 1); rxor(2,2); ri(1,10); ridiv(1)
        eb(72); eb(129); eb(194); ei(48); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        let p=codelen; jmp32(0); emit_patch(p, lp3_loop, 0); lbladd(lp3_done, codelen); lbladd(lp3_signprep, codelen)
        rtest(9,9); let p=codelen; jcc32(0,0); emit_patch(p, lp3_write, 1)
        eb(178); eb(45); eb(65); eb(136); eb(18); eb(73); eb(255); eb(202); eb(73); eb(255); eb(192)
        lbladd(lp3_write, codelen); eb(73); eb(141); eb(114); eb(1); rr(2,8); ri(7,1); ri(0,1); sysc()
        sbi(8); lesp(10,0); eb(178); eb(32); eb(65); eb(136); eb(18)
        rr(6,10); ri(2,1); ri(7,1); ri(0,1); sysc(); abi(8); abi(32); return 1
    }
    // prints(s): write header-string s (bytes at s+8, length len(s)) to stdout.
    if nl==6&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s' {
        flush_all()
        rr(6,7)                          // rsi = rdi (string ptr)
        eb(72); eb(129); eb(198); ei(8)  // rsi = ptr + 8 (byte start)  [modrm 0xC6 = add rsi, imm32]
        eb(72); eb(139); eb(23)          // rdx = [rdi] = len(s) (count)  [modrm 0x17 = mov rdx,[rdi]]
        ri(7,1); ri(0,1); sysc()         // sys_write(1, ptr+8, len)
        return 1
    }
    // --- Phase A1: unsigned arithmetic builtins (true unsigned x86) ---
    // IR_CALL has already flush_all()'d and loaded a=rdi, b=rsi. Do NOT call
    // flush_all() again here: emit_bltn's scratch spill relocates rsi -> rbx,
    // corrupting arg1. Use rdi/rsi directly.
    // udiv(a,b): unsigned a/b.
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='d'&&r8(nm+2)=='i'&&r8(nm+3)=='v' {
        rr(0,7)                            // rax = rdi = a (dividend low)
        rxor(2,2)                          // xor edx,edx (clear dividend high)
        eb(72); eb(247); eb(246)           // 48 F7 F6 = div rsi  (rax = a/b unsigned)
        return 1
    }
    // umod(a,b): unsigned a%b
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='m'&&r8(nm+2)=='o'&&r8(nm+3)=='d' {
        rr(0,7)                            // rax = rdi = a
        rxor(2,2)
        eb(72); eb(247); eb(246)           // div rsi
        rr(0,2)                            // rax = rdx (remainder)
        return 1
    }
    // ult/ugt/ulte/ugte(a,b): unsigned compares -> 0/1 in rax (low byte)
    // a=rdi(7), b=rsi(6); rcmp(r1,r2)=cmp r1,r2.
    // UNSIGNED setcc (rsetc uses the SIGNED setl/setg, so emit bytes directly).
    // Each setcc is "0F OP C0" = eb(15); eb(OP); mr(3,0,0)  (setX %al)
    //   0F 92=setb(<)  0F 97=seta(>)  0F 96=setbe(<=)  0F 93=setae(>=)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t' {
        rxor(0,0); rcmp(7,6); eb(15); eb(146); mr(3,0,0); return 1
    }
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t' {
        rxor(0,0); rcmp(7,6); eb(15); eb(151); mr(3,0,0); return 1
    }
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t'&&r8(nm+3)=='e' {
        rxor(0,0); rcmp(7,6); eb(15); eb(150); mr(3,0,0); return 1
    }
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t'&&r8(nm+3)=='e' {
        rxor(0,0); rcmp(7,6); eb(15); eb(147); mr(3,0,0); return 1
    }
    if nl==3&&r8(nm)=='l'&&r8(nm+1)=='e'&&r8(nm+2)=='n' {
        rmr(0,7); return 1
    }
    // u8/u32/u64(x): reinterpret x as unsigned of N bits (mask). Identity at the
    // 64-bit runtime; the mask bounds the value to the named unsigned width so
    // unsigned arithmetic/comparisons stay in range. Self-host neutral (emit is a
    // mov+and, well-defined regardless of optimizer state).
    if nl==2&&r8(nm)=='u'&&r8(nm+1)=='8' { flush_all(); rr(0,7); eb(72); eb(129); mr(3,4,0); ei(255); return 1 }   // rax=rdi; and rax,0xFF (0x81 imm32: 0xFF sign-extends, so MUST use imm32 form)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='3'&&r8(nm+2)=='2' { flush_all(); rr(0,7); eb(37); eb(255); eb(255); eb(255); eb(255); return 1 }  // and eax,0xFFFFFFFF (opcode 0x25 + imm32)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='6'&&r8(nm+2)=='4' { flush_all(); rr(0,7); return 1 }                          // 64-bit: identity (mov rax,rdi)
    // str(a,b): a=rdi, b=rsi. returns header ptr (len at [new], bytes at new+8)
    if nl==3&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r' {
        flush_all()
        rr(3,7)            // rbx = a
        rr(14,6)           // r14 = b
        rmr(0,3)           // rax = [rbx] = la
        rr(15,0)           // r15 = la
        rmr(0,14)          // rax = [r14] = lb
        rr(13,0)           // r13 = lb
        rr(7,15); ra(7,13) // rdi = la + lb = total
        eb(72);eb(255);eb(199)   // inc rdi -> total+1
        eb(72);eb(131);eb(199);eb(8)  // rdi += 8 -> size = total+9
        rr(6,7)            // rsi = size
        ri(7,0x60000000); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        rr(12,0)           // r12 = new
        rr(0,15); ra(0,13) // rax = total
        rr(7,12); eb(72);eb(137);eb(7)   // [new] = total
        // copy la bytes a+8 -> new+8
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = a+8 (rbx+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,15); eb(243);eb(164)    // rcx = la; rep movsb
        // copy lb bytes b+8 -> new+8+la
        rr(6,14); eb(72);eb(131);eb(198);eb(8)  // rsi = b+8 (r14+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,15)          // rdi += r15 (la) -- dest for b's bytes = new+8+la
        rr(1,13); eb(243);eb(164)    // rcx = lb; rep movsb
        // nul at new+8+total
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,15)          // rdi += r15 (la)
        ra(7,13)          // rdi += r13 (lb)
        eb(198);eb(7);eb(0)    // mov byte [rdi], 0  (C6 07 00)
        rr(0,12)           // rax = new
        return 1
    }
    // push(v,e): append byte e to v (byte-oriented, matches str). v=rdi, e=rsi. returns new header ptr.
    if nl==4&&r8(nm)=='p'&&r8(nm+1)=='u'&&r8(nm+2)=='s'&&r8(nm+3)=='h' {
        flush_all()
        rr(3,7)            // rbx = v
        rr(13,6)           // r13 = e
        rmr(14,3)          // r14 = oldlen = [v]
        rr(7,14)           // rdi = oldlen
        eb(72);eb(131);eb(199);eb(9)      // add rdi, 9 -> size = oldlen+1(byte)+8(header) (48 83 C7 09)
        rr(6,7)            // rsi = size
        ri(7,0x60000000); ri(2,3); ri(10,0x22); ri(8,-1); rxor(9,9); ri(0,9); sysc()  // rax = new
        rr(12,0)           // r12 = new
        rr(0,14); eb(72);eb(255);eb(192)  // rax = oldlen+1 = newlen (inc rax -> 48 FF C0)
        rr(7,12); eb(72);eb(137);eb(7)    // [new] = newlen
        // copy oldlen bytes v+8 -> new+8 via rep movsb
        rr(6,3); eb(72);eb(131);eb(198);eb(8)   // rsi = v+8 (rbx+8)
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        rr(1,14); eb(243);eb(164)               // rcx = oldlen; rep movsb
        // store byte e at new+8+oldlen
        rr(7,12); eb(72);eb(131);eb(199);eb(8)  // rdi = new+8
        ra(7,14)          // rdi += r14 (oldlen) -> new+8+oldlen
        eb(68);eb(136);eb(47)  // mov [rdi], r13b  (44 88 2F: REX.R->r13, byte store)
        rr(0,12)           // rax = new
        return 1
    }
    // pop(v): remove last byte, return it (or 0 if empty). byte-oriented (matches str). v=rdi.
    if nl==3&&r8(nm)=='p'&&r8(nm+1)=='o'&&r8(nm+2)=='p' {
        flush_all()
        rr(3,7)            // rbx = v
        rmr(14,3)          // r14 = oldlen
        let lz=nl(); let lret=nl()
        rtest(14,14)
        let p=codelen; jcc32(0,0); emit_patch(p, lz, 1)  // je lz (empty)
        rr(7,3)            // rdi = v
        eb(72);eb(131);eb(199);eb(7)   // add rdi, 7 (48 83 C7 07)
        ra(7,14)          // rdi += r14 (oldlen) -> v+7+oldlen = &last byte
        eb(72);eb(15);eb(182);eb(7)    // movzx rax, byte [rdi] (48 0F B6 07)
        rr(15,0)          // r15 = elem (save)
        rr(7,3)           // rdi = v
        rr(0,14); eb(72);eb(131);eb(232);eb(1)  // rax = oldlen-1 (sub rax,1)
        eb(72);eb(137);eb(7)   // [v] = rax
        rr(0,15)          // rax = elem
        let p2=codelen; jmp32(0); emit_patch(p2, lret, 0)
        lbladd(lz, codelen)
        rxor(0,0)         // rax = 0
        lbladd(lret, codelen)
        return 1
    }
    // argc(): return saved variadic arg count (frame-local, set by prologue).
    if nl==4&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g'&&r8(nm+3)=='c' {
        rbp(0, g_va_cnt_off)   // rax = [rbp + g_va_cnt_off]
        return 1
    }
    // arg(i): return variadic arg i (0-based, includes named params).
    //   i < 6  -> saved reg-arg area:  [r11 + g_va_reg_off + i*8]
    //   i >= 6 -> stack arg still there: [r11 + 16 + (i-6)*8]   (r11 = rbp)
    // i arrives in rdi (arg0). PRESERVE rdi (loop var) via push/pop.
    if nl==3&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g' {
        let lstack=nl(); let ldone=nl()
        eb(72); eb(129); mr(3,7,7); ei(6)   // cmp rdi, 6 (immediate)
        let p=codelen; jcc32(2, 0); emit_patch(p, lstack, 1)  // jl lstack (i<6)
        // --- i >= 6: r11 = rbp + 16 + (i-6)*8 ---
        eb(87)                          // push rdi (preserve index)
        rr(11, 5)                       // r11 = rbp
        eb(73); eb(129); mr(3,0,3); ei(16)   // add r11, 16
        rr(1, 7)                        // rcx = rdi (i)
        eb(72); eb(131); mr(3,5,1); eb(6)    // sub rcx, 6   -> rcx = i - 6
        eb(72); eb(193); eb(225); eb(3) // shl rcx, 3  (48 C1 E1 03) -> (i-6)*8
        ra(11, 1)                       // r11 += rcx
        lbase(0, 0)                     // rax = [r11]
        eb(95)                          // pop rdi
        let p1=codelen; jmp32(0); emit_patch(p1, ldone, 0)
        lbladd(lstack, codelen)
        // --- i < 6: r11 = rbp + g_va_reg_off + i*8 ---
        eb(87)                          // push rdi (preserve index)
        rr(11, 5)                       // r11 = rbp
        eb(73); eb(129); mr(3,0,3); ei(g_va_reg_off)  // add r11, g_va_reg_off
        eb(72); eb(193); eb(231); eb(3) // shl rdi, 3  (48 C1 E7 03) -> i*8
        ra(11, 7)                       // r11 += rdi
        lbase(0, 0)                     // rax = [r11]
        eb(95)                          // pop rdi
        lbladd(ldone, codelen)
        return 1
    }
    return 0
}

// === COMPILE IR → X86-64 ===
// Per function - emits code, records labels and patches
let func_code_starts = mmap(2000000)  // start offset of each func's code

// === OPTIMIZER (Tier-1, behind -O) ===
// Hard constraint: if opt_on==0, opt_func returns immediately and touches ZERO IR.
// As of 1.0.12 `opt_on` defaults to 1 (optimizer ON for every build); it is no
// longer opt-in. opt_func is called AFTER parse fills [0,irc) for the current
// function and BEFORE ci_func emits it. All rewrites are in-place (no IR record
// deletion — label fixups in ci_func rely on indices and irc staying stable).
let opt_on = 1
// G2: overflow-trap gate. ON by default (secure by default): emits `jno +2; ud2`
// after signed add/sub/mul/neg -> SIGILL on overflow, eliminating the
// wraparound UB class from safe code. `unsafe {}` blocks suppress the trap for
// the ops they contain (so low-level primitives / compiler internals opt out).
// The flag `--no-overflow-trap` turns it OFF if a program deliberately relies on
// two's-complement wraparound and hasn't been ported.
let ovf_trap = 1
let cur_fnname = 0
let cur_fnnlen = 0

// opt_func iterates over IR records with the GLOBAL loop counter `i` so the
// const-resolution helpers (op_is_const / op_const_val) can read it.
let opt_i = 0

fn op_is_const(vr) {
    let k = opt_i-1
    while k>=0 {
        if irres(k)==vr && irop(k)==IR_CONST { return 1 }
        k=k-1
    }
    return 0
}
fn op_const_val(vr) {
    let k = opt_i-1
    while k>=0 {
        if irres(k)==vr && irop(k)==IR_CONST { return ira0(k) }
        k=k-1
    }
    return 0
}

fn constfold(i, op, r0, a0, a1) {
    // both operands foldable -> fold to a MOV r0, f
    // G2: when overflow trapping is ON, do NOT fold signed add/sub/mul — the
    // emitted `jo` is a deliberate side effect that must survive. (Bitwise and
    // logical compares have no trap, so they still fold.)
    if ovf_trap==1 {
        if op==IR_ADD || op==IR_SUB || op==IR_MUL { return 0 }
    }
    let c0 = op_is_const(a0); let c1 = op_is_const(a1)
    if c0==1 && c1==1 {
        let v0 = op_const_val(a0); let v1 = op_const_val(a1); let f=0
        if op==IR_ADD { f=v0+v1 }
        else if op==IR_SUB { f=v0-v1 }
        else if op==IR_MUL { f=v0*v1 }
        else if op==IR_BAND { f=v0&v1 }
        else if op==IR_BOR { f=v0|v1 }
        else if op==IR_BXOR { f=v0^v1 }
        else if op==IR_OR { if v0!=0||v1!=0 { f=1 } else { f=0 } }
        else if op==IR_AND { if v0!=0&&v1!=0 { f=1 } else { f=0 } }
        else if op==IR_EQ { if v0==v1 { f=1 } else { f=0 } }
        else if op==IR_NE { if v0!=v1 { f=1 } else { f=0 } }
        else if op==IR_LT { if v0<v1 { f=1 } else { f=0 } }
        else if op==IR_GT { if v0>v1 { f=1 } else { f=0 } }
        else if op==IR_LE { if v0<=v1 { f=1 } else { f=0 } }
        else if op==IR_GE { if v0>=v1 { f=1 } else { f=0 } }
        w64(ir+opt_i*IRS, IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,f); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0)
        return 1
    }
    return 0
}

fn opt_func() {
    if opt_on==0 { return }
    if had_error==1 { return }
    // --- A: constant folding + algebraic identity (per-record, index-safe) ---
    opt_i=0
    while opt_i<irc {
        let op=irop(opt_i); let r0=irres(opt_i); let a0=ira0(opt_i); let a1=ira1(opt_i)
        if op==IR_ADD || op==IR_SUB || op==IR_MUL || op==IR_BAND || op==IR_BOR || op==IR_BXOR || op==IR_OR || op==IR_AND
          || op==IR_EQ || op==IR_NE || op==IR_LT || op==IR_GT || op==IR_LE || op==IR_GE {
            if constfold(opt_i,op,r0,a0,a1)==1 { opt_i=opt_i+1; continue }
            // algebraic identities on a single constant operand (resolve via def)
            if op_is_const(a1)==1 {
                let v1 = op_const_val(a1)
                if op==IR_MUL && v1==1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_MUL && v1==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v1==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v1==-1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_ADD||op==IR_SUB||op==IR_BOR||op==IR_BXOR) && v1==0 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_DIV && v1==1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_SHL||op==IR_SHR) && v1==0 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_SHL||op==IR_SHR) && v1>0 && v1<64 {
                    let va0 = a0; if op_is_const(a0)==1 { va0 = op_const_val(a0) }
                    let f=0; if op==IR_SHL { f=va0<<v1 } else { f=va0>>v1 }
                    w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,f); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0)
                }
            }
            if op_is_const(a0)==1 {
                let v0 = op_const_val(a0)
                if op==IR_MUL && v0==1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_MUL && v0==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v0==0 { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_BAND && v0==-1 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if (op==IR_ADD||op==IR_BOR||op==IR_BXOR) && v0==0 { w64(ir+opt_i*IRS,IR_MOV); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_SUB && v0==0 { w64(ir+opt_i*IRS,IR_NEG); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,a1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
            }
            // x==x -> 1 ; x!=x -> 0  (same vreg operand)
            if a0==a1 {
                if op==IR_EQ { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,1); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
                else if op==IR_NE { w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,0); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0) }
            }
        } else if op==IR_NEG || op==IR_NOT || op==IR_BNOT {
            if op_is_const(a0)==1 {
                let f=0
                if op==IR_NEG { f=0-op_const_val(a0) } else { f=~op_const_val(a0) }
                w64(ir+opt_i*IRS,IR_CONST); w64(ir+opt_i*IRS+8,r0); w64(ir+opt_i*IRS+16,f); w64(ir+opt_i*IRS+24,0); w64(ir+opt_i*IRS+32,0)
            }
        }
        opt_i=opt_i+1
    }
    // --- B: tail-call elimination (self-recursive, tail position only) ---
    // Detect IR_RET whose operand is the result of an IR_CALL to the SAME function
    // (name-pointer equality with cur_fnname). Rewrite into: move each call arg
    // into the corresponding incoming PARAM home slot, then JMP to a freshly
    // injected entry label (front-inserted; labels are by-id so index shift is safe).
    // We never delete records; the orphaned IR_CALL/temps are neutralized: the CALL
    // is rewritten to MOV res,res (harmless), and any remaining dead temps are
    // cleaned by the DCE no-op pass that runs AFTER this (but DCE already ran above,
    // so we neutralize the CALL here directly).
    opt_tailcall()

    // --- D: loop strength reduction (arithmetic-progression `while` loops) ---
    opt_loop_strength()

    // --- C: dead-code elimination (best-effort, index-safe, no record deletion) ---
    // A vreg V is LIVE if it is read by any op other than its defining op, or is
    // a RET operand, a CALL argument, or a PARAM target. Any op whose `res` is a
    // non-live vreg AND has no side effects (not CALL/RET/STR/STOREG) is turned
    // into a harmless `MOV res,res` no-op. We never delete records (label fixups
    // in ci_func rely on indices), so irc stays stable and the fixed point holds.
    // live_bits is a global (allocated once) to avoid per-function mmap collisions.
    // Scan 1: mark live vregs (clear [0,maxvr+1) first).
    let maxvr2=0
    let cl=0
    while cl<irc { let cr=irres(cl); if cr>maxvr2 { maxvr2=cr }; cl=cl+1 }
    let clr=0
    while clr<=maxvr2 { w8(live_bits+clr,0); clr=clr+1 }
    let j=0
    while j<irc {
        let op=irop(j)
        // operands that read vregs
        let o0=ira0(j); let o1=ira1(j); let o2=ira2(j)
        // every op reads o0,o1 (and o2 where relevant); mark them live
        if op!=IR_CONST { w8(live_bits+o0,1) }
        if op!=IR_CONST && op!=IR_BR && op!=IR_JMP { w8(live_bits+o1,1) }
        if op==IR_CALL { w8(live_bits+o2,1) }
        if op==IR_RET { w8(live_bits+o0,1) }
        if op==IR_PARAM { w8(live_bits+o0,1) }   // PARAM target vreg is live
        if op==IR_STOREG { w8(live_bits+o0,1) }  // STOREG reads o0
        // NOTE: a defining op's own res is not auto-live; only marked if read above
        j=j+1
    }
    // Scan 2: no-op dead defs.
    let k=0
    while k<irc {
        let op=irop(k)
        if op==IR_CALL || op==IR_RET || op==IR_STR || op==IR_STOREG || op==IR_LABEL || op==IR_JMP || op==IR_BR || op==IR_FREE { k=k+1; continue }
        let res=irres(k)
        if w8(live_bits+res)==0 {
            // dead def -> no-op (MOV res,res). Keep index; harmless.
            w64(ir+k*IRS, IR_MOV); w64(ir+k*IRS+8,res); w64(ir+k*IRS+16,res); w64(ir+k*IRS+24,0); w64(ir+k*IRS+32,0)
        }
        k=k+1
    }
}

// Return the home vreg of PARAM slot `idx` in the current function's IR, else -1.
fn param_home_of(idx) {
    let p=0
    while p<irc {
        if irop(p)==IR_PARAM && ira0(p)==idx { return irres(p) }
        p=p+1
    }
    return -1
}

// Identifier length at src offset `a` (scan while [A-Za-z0-9_]).
fn sidlen(a) {
    let n=0
    while n<64 {
        let c=r8(src+a+n)
        if c>=97 && c<=122 { n=n+1; continue }
        if c>=65 && c<=90 { n=n+1; continue }
        if n>0 && c>=48 && c<=57 { n=n+1; continue }
        if c==95 { n=n+1; continue }
        break
    }
    return n
}
// Compare src-string at `a` (an identifier) against cur_fnname (fns-table string).
fn sname_eq(a) {
    if sidlen(a) != cur_fnnlen { return 0 }
    let n=0
    while n<cur_fnnlen {
        if r8(src+a+n) != r8(src+cur_fnname+n) { return 0 }
        n=n+1
    }
    return 1
}

// Pass B: tail-call elimination (self-recursive, tail position only).
fn def_is_constval(vr) {
    let k = irc - 1
    while k >= 0 {
        if irres(k) == vr {
            if irop(k) == IR_MOV { return def_is_constval(ira0(k)) }
            if irop(k) == IR_CONST { return ira0(k) }
            return -1
        }
        k = k - 1
    }
    return -1
}

// Pass D: strength-reduce an arithmetic-progression `while` loop to closed form.
// Real IR shape emitted by parse_while for `while iv < C { sv = sv+iv; iv = iv+1 }`:
//   [p]   LABEL st
//   [p+1] CONST cvreg, C          (C compile-time constant)
//   [p+2] LT    cmp, iv, cvreg
//   [p+3] BR    cmp, en2, ct
//   [p+4] LABEL ct
//   [p+5] ADD   t1, sv, iv        (accumulator: operands {sv,iv})
//   [p+6] MOV   sv, t1
//   [p+7] CONST onev, 1
//   [p+8] ADD   t2, iv, onev      (counter: iv + 1)
//   [p+9] MOV   iv, t2
//   [p+10] JMP  st
//   [p+11] LABEL en2
// with iv initialized to a compile-time constant `lo` (resolved via def_is_constval)
// before the loop. Since lo and C are constants, count/sum are computed here and
// emitted as CONSTs (no runtime MUL/DIV):
//   count = max(0, C-lo);  sum = count*(2*lo+count-1)/2;  sv += sum;  iv = lo+count.
// Rewrites BR -> JMP Lc (skip the body) and appends the closed-form epilogue.
//
// CORRECTNESS / SCOPE: matches the 12-record pattern by opcode+operand identity;
// any deviation => loop left untouched (always correct). Closed form is valid for
// ANY integer lo, C (count clamped at 0 when C<=lo). Product count*(2lo+count-1)
// is always even => exact integer division.
//
fn opt_loop_strength() {
    // G2: the closed-form `sum = count*(2*lo+count-1)/2` is computed at COMPILE
    // time; for very large iteration counts it deliberately overflows i64. Wrap
    // in unsafe{} so the bootstrapping compiler (which runs this on user loops)
    // is exempt from the overflow trap during self-host.
    unsafe {
    if opt_on == 0 { return }
    if had_error == 1 { return }
    let n0 = irc
    let p = 0
    while p < n0 {
        let ok = 1
        if irop(p) != IR_LABEL { ok = 0 }
        if ok == 1 { if p + 11 >= n0 { ok = 0 } }
        if ok == 1 {
            let stl = ira0(p)
            if irop(p+1) != IR_CONST { ok = 0 }
            if ok == 1 { if irop(p+2) != IR_LT { ok = 0 } }
            if ok == 1 { if irop(p+3) != IR_BR { ok = 0 } }
            if ok == 1 { if irop(p+4) != IR_LABEL { ok = 0 } }
            if ok == 1 { if irop(p+5) != IR_ADD { ok = 0 } }
            if ok == 1 { if irop(p+6) != IR_MOV { ok = 0 } }
            if ok == 1 { if irop(p+7) != IR_CONST { ok = 0 } }
            if ok == 1 { if irop(p+8) != IR_ADD { ok = 0 } }
            if ok == 1 { if irop(p+9) != IR_MOV { ok = 0 } }
            if ok == 1 { if irop(p+10) != IR_JMP { ok = 0 } }
            if ok == 1 { if irop(p+11) != IR_LABEL { ok = 0 } }
            if ok == 1 {
                let cvreg = irres(p+1)
                let Cval  = ira0(p+1)
                let iv    = ira0(p+2)
                let cmp   = irres(p+2)
                let en2   = ira1(p+3)
                let ct    = ira2(p+3)
                if ira1(p+2) != cvreg { ok = 0 }
                if ok == 1 { if ira0(p+3) != cmp { ok = 0 } }
                if ok == 1 { if ira0(p+4) != ct { ok = 0 } }
                if ok == 1 { if ira0(p+10) != stl { ok = 0 } }
                if ok == 1 { if ira0(p+11) != en2 { ok = 0 } }
                let t1  = irres(p+5)
                let ad0 = ira0(p+5)
                let ad1 = ira1(p+5)
                let sv  = irres(p+6)
                if ira0(p+6) != t1 { ok = 0 }
                if ok == 1 {
                    let accok = 0
                    if ad0 == sv && ad1 == iv { accok = 1 }
                    if ad0 == iv && ad1 == sv { accok = 1 }
                    if accok == 0 { ok = 0 }
                }
                let onev = irres(p+7)
                if ok == 1 { if ira0(p+7) != 1 { ok = 0 } }
                let t2 = irres(p+8)
                if ok == 1 {
                    let stepok = 0
                    if ira0(p+8) == iv && ira1(p+8) == onev { stepok = 1 }
                    if ira0(p+8) == onev && ira1(p+8) == iv { stepok = 1 }
                    if stepok == 0 { ok = 0 }
                }
                if ok == 1 { if irres(p+9) != iv { ok = 0 } }
                if ok == 1 { if ira0(p+9) != t2 { ok = 0 } }
                if ok == 1 { if sv == iv { ok = 0 } }
                if ok == 1 {
                    let lo = 0
                    let found = 0
                    let s = p - 1
                    while s >= 0 {
                        if irop(s) == IR_MOV && irres(s) == iv {
                            let lv = def_is_constval(ira0(s))
                            if lv != -1 { lo = lv; found = 1 }
                            s = 0
                        }
                        s = s - 1
                    }
                    if found == 1 {
                        let count = Cval - lo
                        if count < 0 { count = 0 }
                        let sum = 0
                        if count > 0 { sum = count * (2 * lo + count - 1) / 2 }
                        let ivfinal = lo + count
                        let sumv = nv()
                        let Lc = nl()
                        w64(ir+(p+3)*IRS, IR_JMP); w64(ir+(p+3)*IRS+8,0); w64(ir+(p+3)*IRS+16,Lc); w64(ir+(p+3)*IRS+24,0); w64(ir+(p+3)*IRS+32,0)
                        w64(ir+irc*IRS, IR_LABEL); w64(ir+irc*IRS+8,0); w64(ir+irc*IRS+16,Lc); w64(ir+irc*IRS+24,0); w64(ir+irc*IRS+32,0); irc=irc+1
                        w64(ir+irc*IRS, IR_CONST); w64(ir+irc*IRS+8,sumv); w64(ir+irc*IRS+16,sum); w64(ir+irc*IRS+24,0); w64(ir+irc*IRS+32,0); irc=irc+1
                        w64(ir+irc*IRS, IR_ADD); w64(ir+irc*IRS+8,sv); w64(ir+irc*IRS+16,sv); w64(ir+irc*IRS+24,sumv); w64(ir+irc*IRS+32,0); irc=irc+1
                        w64(ir+irc*IRS, IR_CONST); w64(ir+irc*IRS+8,iv); w64(ir+irc*IRS+16,ivfinal); w64(ir+irc*IRS+24,0); w64(ir+irc*IRS+32,0); irc=irc+1
                        w64(ir+irc*IRS, IR_JMP); w64(ir+irc*IRS+8,0); w64(ir+irc*IRS+16,en2); w64(ir+irc*IRS+24,0); w64(ir+irc*IRS+32,0); irc=irc+1
                    }
                }
            }
        }
        p = p + 1
    }
    }
}

fn opt_tailcall() {
    if opt_on==0 { return }
    if had_error==1 { return }
    if cur_fnname==0 { return }
    // Find a RETURN whose operand is the result vreg of a self CALL.
    let ri=0
    while ri<irc {
        if irop(ri)==IR_RET {
            let rv=ira0(ri)
            let ci2=0
            while ci2<irc {
                if irop(ci2)==IR_CALL && irres(ci2)==rv {
                    if sname_eq(ira0(ci2))==1 {
                        // === transform ===
                        let acnt=ira1(ci2); let avs=ira2(ci2)
                        let L=nl()  // entry label
                        // Reuse the CALL's arg-MOV record slots [avs..avs+acnt-1] as the
                        // param-moves (MOV param_home[i], argvr[i]). No mid-array shift.
                        let bad=0
                        let w=0
                        while w<acnt {
                            let argrec=avs+w
                            let argvr=0
                            if argrec>=0 && argrec<irc { argvr=ira0(argrec) }
                            let ph=param_home_of(w)
                            if ph<0 { bad=1 }
                            w64(ir+argrec*IRS, IR_MOV); w64(ir+argrec*IRS+8, ph); w64(ir+argrec*IRS+16, argvr); w64(ir+argrec*IRS+24,0); w64(ir+argrec*IRS+32,0)
                            w=w+1
                        }
                        if bad==1 { return }  // param slot missing; bail (no corruption)
                        // CALL@ci2 -> JMP L
                        w64(ir+ci2*IRS, IR_JMP); w64(ir+ci2*IRS+8,0); w64(ir+ci2*IRS+16,L); w64(ir+ci2*IRS+24,0); w64(ir+ci2*IRS+32,0)
                        // RET@ri -> JMP L (base-case RET elsewhere stays)
                        w64(ir+ri*IRS, IR_JMP); w64(ir+ri*IRS+8,0); w64(ir+ri*IRS+16,L); w64(ir+ri*IRS+24,0); w64(ir+ri*IRS+32,0)
                        // Insert LABEL L AFTER the last IR_PARAM so the loop-back skips
                        // the param-from-stack reload (otherwise it clobbers our args).
                        // Single safe shift (+1) at (lastparam+1) <= front of body.
                        let lastparam=-1
                        let pp=0
                        while pp<irc {
                            if irop(pp)==IR_PARAM { lastparam=pp }
                            pp=pp+1
                        }
                        let ins=lastparam+1
                        let s2=irc-1
                        while s2>=ins {
                            w64(ir+(s2+1)*IRS, irop(s2))
                            w64(ir+(s2+1)*IRS+8, irres(s2))
                            w64(ir+(s2+1)*IRS+16, ira0(s2))
                            w64(ir+(s2+1)*IRS+24, ira1(s2))
                            w64(ir+(s2+1)*IRS+32, ira2(s2))
                            s2=s2-1
                        }
                        irc=irc+1
                        w64(ir+ins*IRS, IR_LABEL); w64(ir+ins*IRS+8,0); w64(ir+ins*IRS+16,L); w64(ir+ins*IRS+24,0); w64(ir+ins*IRS+32,0)
                        return
                    }
                }
                ci2=ci2+1
            }
        }
        ri=ri+1
    }
}

fn ci_func(fi, is_main) {
    vreg_n = 0
    let pstart = patchc
    // Pre-scan IR to compute total string buffer size AND the true max vreg,
    // so the spill frame is sized to hold every vreg's home slot.  (compiler.py
    // sizes the frame from max_vreg; ci_func must match or spills for functions
    // with >2041 vregs run past the min_spill frame and corrupt locals.)
    let total_str=0
    let maxvr=0
    let psi=0
    while psi<irc {
        let pres=irres(psi); if pres>maxvr { maxvr=pres }
        if irop(psi)==IR_STR {
            let sp2=ira0(psi)+1; let ln2=0; let scp2=sp2
            while scp2<srclen&&r8(src+scp2)!=34 {
                ln2=ln2+1; if r8(src+scp2)==92&&scp2+1<srclen { scp2=scp2+2 } else { scp2=scp2+1 }
            }
            let bsz2=8+ln2+1; let pad2=bsz2%16; if pad2>0 { bsz2=bsz2+(16-pad2) }
            total_str=total_str+bsz2
        }
        psi=psi+1
    }
    vreg_n = maxvr + 1
    aclr()
    fclr()
    // Prologue
    xpush(5); rr(5,4)
    let mi=0; while mi<5 { xpush(r64(mather_saved+mi*8)); mi=mi+1 }  // push RBX,R12-R15
    // Dynamic frame size based on max vreg count - ensure enough space for spill slots
    let spill_region = 48 + vreg_n * 8
    let frame_size = spill_region + total_str + 80
    // Minimum spill region to handle register pressure (like Python compiler)
    let min_spill = 16384
    if spill_region < min_spill { spill_region = min_spill; frame_size = spill_region + total_str + 80 }
    // Variadic functions: reserve a frame-local va area at the bottom of the
    // frame so nested variadic calls don't clobber each other. Layout (from the
    // lowest address upward): va_cnt (8 bytes) then va_reg[0..5] (48 bytes).
    let isvar = r64(fn_var + fi*8)
    if isvar==1 {
        frame_size = frame_size + 64   // va_cnt(8) + 6 regs(48) = 56, round to 64
        let rem2 = frame_size % 16
        if rem2 > 0 { frame_size = frame_size + (16 - rem2) }
    }
    let rem = frame_size % 16
    if rem > 0 { frame_size = frame_size + (16 - rem) }
    // Single frame allocation: spill slots + string buffers + 80-byte save area.
    sbi(frame_size)  // sub rsp, frame_size (matches the single "add rsp, frame_size" epilogue)
    let csi = 80; wsp(csi * -1, 0)
    // Variadic prologue: snapshot arg count (r10) and the first 6 register args
    // (rdi,rsi,rdx,rcx,r8,r9) into the frame-local va area. Stack args (i>=6)
    // remain on the stack at [rbp+16+...] and are read directly by arg().
    // We use r11 as the frame base (mov r11,rbp) so all stores avoid the
    // REX.B/rbp encoding conflict for extended destination registers.
    if isvar==1 {
        g_va_cnt_off = -frame_size + 8               // [r11 + g_va_cnt_off]
        g_va_reg_off = -frame_size + 16              // va_reg[0] at [r11 + g_va_reg_off]
        rr(11, 5)                        // r11 = rbp
        wbase(g_va_cnt_off, 10)          // [r11 + g_va_cnt_off] = r10 (arg_cnt)
        wbase(g_va_reg_off + 0,  7)      // va_reg[0] = rdi
        wbase(g_va_reg_off + 8,  6)      // va_reg[1] = rsi
        wbase(g_va_reg_off + 16, 2)      // va_reg[2] = rdx
        wbase(g_va_reg_off + 24, 1)      // va_reg[3] = rcx
        wbase(g_va_reg_off + 32, 8)      // va_reg[4] = r8
        wbase(g_va_reg_off + 40, 9)      // va_reg[5] = r9
    }

    let str_off = -(frame_size - total_str)  // string buffer offset from frame base (below spill)
    let r1=0; let ii=0
    while ii<irc {
        let op=irop(ii); let res=irres(ii); let a0=ira0(ii); let a1=ira1(ii); let a2=ira2(ii)
        if op==IR_CONST { let rd=aphys(res); if a0<0||a0>4294967295 { ri64(rd,a0) } else { ri(rd,a0) }; sdef(res, rd) }
        else if op==IR_MOV { let rd=aphys(res); let rs=aphys(a0); if rd!=rs { rr(rd,rs) }; sdef(res, rd) }
        else if op==IR_ADD { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; ra(rd,r2); ovf_trap_emit(ii); sdef(res, rd) }
        else if op==IR_SUB { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; rs(rd,r2); ovf_trap_emit(ii); sdef(res, rd) }
        else if op==IR_MUL { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; rm(rd,r2); ovf_trap_emit(ii); sdef(res, rd) }
        else if op==IR_DIV {
          opt_i = ii+1
          let dv_isconst = op_is_const(a1)
          if dv_isconst==1 {
            let dv = op_const_val(a1)
            if dv!=0 && ((dv & (dv-1)) != 0) {
              compute_magic(dv)
              let M = magicM; let sh = magicSh
              flush_clob(0,1,2)
              let rd = aphys(res)
              // adjustment (q+=n / q-=n) only needed for some signs; spare
              // rbx unless actually required, so loop-live regs stay resident.
              let need_adj = 0
              if dv>0 && M<0 { need_adj = 1 }
              if dv<0 && M>0 { need_adj = 1 }
              if need_adj==1 { flush_clob(3,3,3); rbp(3, spill_home(a0)) }
              rbp(0, spill_home(a0))
              ri64(1, M)
              eb(72); eb(247); eb(233)
              rr(rd, 2)
              if need_adj==1 {
                if dv>0 && M<0 { ra(rd, 3) }
                if dv<0 && M>0 { rs(rd, 3) }
              }
              if sh>0 { ri(1, sh); eb(72); eb(211); eb(248 + (rd%8)) }
              rr(2, rd); ri(1, 63); eb(72); eb(211); eb(234); ra(rd, 2)
              sdef(res, rd)
            } else {
              flush_clob(0,1,2); rbp(0, spill_home(a0)); rbp(1, spill_home(a1)); rcqo(); ridiv(1); let rd=aphys(res); if rd!=0 { rr(rd,0) }; sdef(res, rd)
            }
          } else {
            flush_clob(0,1,2); rbp(0, spill_home(a0)); rbp(1, spill_home(a1)); rcqo(); ridiv(1); let rd=aphys(res); if rd!=0 { rr(rd,0) }; sdef(res, rd)
          }
        }
        else if op==IR_MOD { flush_clob(0,1,2); rbp(0, spill_home(a0)); rbp(1, spill_home(a1)); rcqo(); ridiv(1); let rd=aphys(res); if rd!=2 { rr(rd,2) }; sdef(res, rd) }
        else if op==IR_EQ { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); rxor(rd,rd); rcmp(r1,r2); rsetc(0,rd); rzx(rd,rd); sdef(res, rd) }
        else if op==IR_NE { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); rxor(rd,rd); rcmp(r1,r2); rsetc(1,rd); rzx(rd,rd); sdef(res, rd) }
        else if op==IR_LT { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); rxor(rd,rd); rcmp(r1,r2); rsetc(2,rd); rzx(rd,rd); sdef(res, rd) }
        else if op==IR_GT { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); rxor(rd,rd); rcmp(r1,r2); rsetc(3,rd); rzx(rd,rd); sdef(res, rd) }
        else if op==IR_LE { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); rxor(rd,rd); rcmp(r1,r2); rsetc(4,rd); rzx(rd,rd); sdef(res, rd) }
        else if op==IR_GE { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); rxor(rd,rd); rcmp(r1,r2); rsetc(5,rd); rzx(rd,rd); sdef(res, rd) }
        else if op==IR_NEG { let r1=aphys(a0); let rd=adistinct(res,r1,r1); if rd!=r1 { rr(rd,r1) }; rneg(rd); ovf_trap_emit(ii); sdef(res, rd) }
        else if op==IR_NOT { let r1=aphys(a0); flush_clob(0,1,2); let rd=adistinct(res,r1,r1); rxor(rd,rd); rcmp(r1,rd); rsetc(0,0); rzx(rd,0); sdef(res, rd) }
        else if op==IR_OR { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; ror(rd,r2); sdef(res, rd) }
        else if op==IR_AND { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; rand(rd,r2); sdef(res, rd) }
        else if op==IR_BAND { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; rand(rd,r2); sdef(res, rd) }
        else if op==IR_BOR { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; ror(rd,r2); sdef(res, rd) }
        else if op==IR_BXOR { let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2); if rd!=r1 { rr(rd,r1) }; rxor(rd,r2); sdef(res, rd) }
        else if op==IR_BNOT { let r1=aphys(a0); let rd=adistinct(res,r1,r1); if rd!=r1 { rr(rd,r1) }; rnot(rd); sdef(res, rd) }
        else if op==IR_SHL { flush_clob(0,1,2); rbp(0, spill_home(a0)); rbp(1, spill_home(a1)); shl_trap_emit(ii); rshl(0,1); let rd=aphys(res); if rd!=0 { rr(rd,0) }; sdef(res, rd) }
        else if op==IR_SHR { flush_clob(0,1,2); rbp(0, spill_home(a0)); rbp(1, spill_home(a1)); shl_trap_emit(ii); rshr(0,1); let rd=aphys(res); if rd!=0 { rr(rd,0) }; sdef(res, rd) }
        else if op==IR_LOADG {
            // Uniform RIP-relative load: mov rd, [rip+disp32]; patched in patch_globals.
            let rd=aphys(res)
            let rex=72; if rd>=8 { rex=76 }
            eb(rex); eb(139); eb(5 + (rd%8)*8); ei(0)   // REX.W 8B mod=00 rm=rip disp32
            let pofs=codelen-4
            w64(gpatches+gpatchc*24, pofs)
            w64(gpatches+gpatchc*24+8, a0)
            w8(gpatches+gpatchc*24+16, 0)
            gpatchc=gpatchc+1
            sdef(res, rd)
        }
        else if op==IR_STOREG {
            // Uniform RIP-relative store: mov [rip+disp32], rs; patched in patch_globals.
            let rs=aphys(a0)
            let rex=72; if rs>=8 { rex=76 }
            eb(rex); eb(137); eb(5 + (rs%8)*8); ei(0)   // REX.W 89 mod=00 rm=rip disp32
            let pofs=codelen-4
            w64(gpatches+gpatchc*24, pofs)
            w64(gpatches+gpatchc*24+8, a1)
            w8(gpatches+gpatchc*24+16, 1)
            gpatchc=gpatchc+1
        }
        else if op==32 {
            // IR_IDX  a[idx]: header-carrying [base]=len. Strings (vreg_is_str>=0)
            // use byte stride [base+8+i]; arrays use qword stride [base+8+i*8].
            flush_all()
            rbp(0, spill_home(a0))   // rax = base
            rbp(1, spill_home(a1))   // rcx = idx
            let isstr = r64(vreg_is_str + a0*8)
            if isstr>=0 {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(8); eb(8)   // lea rax,[rax+rcx*1+8]
                eb(72); eb(15); eb(182); eb(0)          // movzx rax, byte [rax]
            } else {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(200); eb(8)  // lea rax,[rax+rcx*8+8]
                eb(72); eb(139); eb(0)                    // mov rax,[rax]
            }
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            sdef(res, rd)
        }
        else if op==IR_ISTORE {
            // a[idx] = v : header-carrying [base]=len. String base -> byte store.
            flush_all()
            rbp(0, spill_home(a0))   // rax = base
            rbp(1, spill_home(a1))   // rcx = idx
            let isstr = r64(vreg_is_str + a0*8)
            if isstr>=0 {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(8); eb(8)   // lea rax,[rax+rcx*1+8]
                rbp(2, spill_home(a2))   // rdx = val
                eb(72); eb(136); eb(16)           // mov [rax], dl   (byte store)
            } else {
                idx_trap_emit(ii)        // cmp [rax], rcx ; jb +2 ; ud2
                eb(72); eb(141); eb(68); eb(200); eb(8)  // lea rax,[rax+rcx*8+8]
                rbp(2, spill_home(a2))   // rdx = val
                eb(72); eb(137); eb(16)           // mov [rax], rdx
            }
        }
        else if op==IR_TALLOC {
            // G2 containers: tuple/array alloc -> header-carrying [base]=len,
            // [base+8 .. +8+cnt*8]=elements. mmap(cnt*8 + 8); store [base]=cnt.
            flush_all()
            ri(7, a0*8 + 8)                      // rdi = cnt*8 + 8 (header + elems)
            eb(72); eb(137); eb(254)            // mov rsi, rdi   (len)
            eb(191); ei(0x60000001)             // mov edi, 0x60000000 (hint addr)
            eb(186); ei(3)                      // mov edx, 3     (PROT_READ|WRITE)
            eb(65); eb(186); ei(34)             // mov r10d, 0x22 (MAP_PRIVATE|ANON)
            eb(65); eb(184); ei(0-1)            // mov r8d, -1    (fd)
            eb(69); eb(49); eb(201)             // xor r9d, r9d   (offset=0)
            eb(184); ei(9)                      // mov eax, 9
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, a0)                            // rdx = cnt (element count)
            eb(72); eb(137); eb(16)             // mov [rax], rdx   ([base] = len header)
            sdef(res, rd)
        }
        // P7: IR_SOME - Option::Some(payload) -> header layout [base]=len=2, [base+8]=tag=1, [base+16]=payload
        else if op==IR_SOME {
            flush_all()
            ri(7, 24)                          // rdi = 24 bytes (header + tag + payload)
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0x60000001)             // mov edi, 0x60000000 (hint)
            eb(186); ei(3)                      // mov edx, 3
            eb(65); eb(186); ei(34)             // mov r10d, 0x22
            eb(65); eb(184); ei(0-1)            // mov r8d, -1
            eb(69); eb(49); eb(201)             // xor r9d, r9d
            eb(184); ei(9)                      // mov eax, 9
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 2); eb(72); eb(137); eb(16)   // [rax] = len header 2
            ri(2, 1); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 1
            let rv=aphys(a0); if rv!=0 { rr(2,rv) }; eb(72); eb(137); mr(1, 2, 0); eb(16)  // [rax+16] = payload
            sdef(res, rd)
        }
        // P7: IR_NONE - Option::None -> header layout [base]=len=1, [base+8]=tag=0
        else if op==IR_NONE {
            flush_all()
            ri(7, 16)                          // rdi = 16 bytes (header + tag)
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0x60000001)             // mov edi, 0x60000000
            eb(186); ei(3)
            eb(65); eb(186); ei(34)
            eb(65); eb(184); ei(0-1)
            eb(69); eb(49); eb(201)
            eb(184); ei(9)
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 1); eb(72); eb(137); eb(16)   // [rax] = len header 1
            ri(2, 0); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 0
            sdef(res, rd)
        }
        // P7: IR_OK - Result::Ok(payload) -> header layout [base]=len=2, [base+8]=tag=1, [base+16]=payload
        else if op==IR_OK {
            flush_all()
            ri(7, 24)                          // rdi = 24 bytes
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0x60000001)             // mov edi, 0x60000000
            eb(186); ei(3)
            eb(65); eb(186); ei(34)
            eb(65); eb(184); ei(0-1)
            eb(69); eb(49); eb(201)
            eb(184); ei(9)
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 2); eb(72); eb(137); eb(16)   // [rax] = len header 2
            ri(2, 1); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 1
            let rv=aphys(a0); if rv!=0 { rr(2,rv) }; eb(72); eb(137); mr(1, 2, 0); eb(16)  // [rax+16] = payload
            sdef(res, rd)
        }
        // P7: IR_ERR - Result::Err(payload) -> header layout [base]=len=2, [base+8]=tag=0, [base+16]=payload
        else if op==IR_ERR {
            flush_all()
            ri(7, 24)                          // rdi = 24 bytes
            eb(72); eb(137); eb(254)            // mov rsi, rdi
            eb(191); ei(0x60000001)             // mov edi, 0x60000000
            eb(186); ei(3)
            eb(65); eb(186); ei(34)
            eb(65); eb(184); ei(0-1)
            eb(69); eb(49); eb(201)
            eb(184); ei(9)
            sysc()
            let rd=aphys(res); if rd!=0 { rr(rd,0) }
            ri(2, 2); eb(72); eb(137); eb(16)   // [rax] = len header 2
            ri(2, 0); eb(72); eb(137); mr(1, 2, 0); eb(8)    // [rax+8] = tag 0
            let rv=aphys(a0); if rv!=0 { rr(2,rv) }; eb(72); eb(137); mr(1, 2, 0); eb(16)  // [rax+16] = payload
            sdef(res, rd)
        }
        // P7: IR_UNWRAP - extract payload; panic (exit 1) if tag==0
        else if op==IR_UNWRAP {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            // load tag from [base+8]
            if rs!=0 { rbp(0, spill_home(a0)) } else { ri(0, 0) }  // rax = base
            // mov rdx, [rax+8]  -> 48 8B 50 08
            eb(72); eb(139); eb(80); eb(8)
            // cmp rdx, 0; je panic
            rtest(2, 2)
            let panic_lbl = nl()
            jcc32(0, 0)  // je panic
            w64(patches+patchc*PCS, codelen-6); w64(patches+patchc*PCS+8, panic_lbl); w64(patches+patchc*PCS+16, 1); patchc=patchc+1
            // load payload from [base+16] (base still in rax)
            // mov rdx, [rax+16] -> 48 8B 50 10
            eb(72); eb(139); eb(80); eb(16)
            if rd!=0 { rr(rd, 2) }
            sdef(res, rd)
            let done_lbl = nl()
            jmp32(0)
            w64(patches+patchc*PCS, codelen-5); w64(patches+patchc*PCS+8, done_lbl); w64(patches+patchc*PCS+16, 0); patchc=patchc+1
            lbladd(panic_lbl, codelen)
            // panic: exit(1)
            ri(7, 1); eb(184); ei(60); sysc()  // mov edi,1; mov eax,60; syscall
            lbladd(done_lbl, codelen)
        }
        else if op==IR_PARAM {
            if a0<6 {
                let preg=0
                if a0==0 { preg=7 }
                if a0==1 { preg=6 }
                if a0==2 { preg=2 }
                if a0==3 { preg=1 }
                if a0==4 { preg=8 }
                if a0==5 { preg=9 }
                sdef(res, preg)
            } else {
                // args 6+ arrive on the stack (SysV). After prologue (push rbp;
                // mov rbp,rsp) the incoming stack args live above the return addr:
                // [rbp+16]=arg6, [rbp+24]=arg7, ...  Load to rax, spill to home.
                rbp(0, 16 + (a0-6)*8)   // rax = [rbp + 16 + (idx-6)*8]
                sdef(res, 0)
            }
        }
        else if op==IR_LABEL {
            flush_all()
            lbladd(a0,codelen)
        }
        else if op==IR_JMP {
            flush_all()
            let po=codelen; jmp32(0)
            w64(patches+patchc*PCS,po); w64(patches+patchc*PCS+8,a0); w64(patches+patchc*PCS+16,0); patchc=patchc+1
        }
        else if op==IR_BR {
            flush_all()
            let cv=aphys(a0); rtest(cv,cv)
            let po1=codelen; jcc32(0,0)  // je a1
            w64(patches+patchc*PCS,po1); w64(patches+patchc*PCS+8,a1); w64(patches+patchc*PCS+16,1); patchc=patchc+1
        }
        else if op==IR_RET {
            flush_all()
            if a0>=0 { let rv=aphys(a0); if rv!=0 { rr(0,rv) } }
            // add rsp, frame_size  (7 bytes: REX.W 81 C4 imm32), emitted into CODE.
            let af=frame_size
            w8(code+codelen, 72); w8(code+codelen+1, 129); w8(code+codelen+2, 196)
            w8(code+codelen+3, af & 255)
            w8(code+codelen+4, (af >> 8) & 255)
            w8(code+codelen+5, (af >> 16) & 255)
            w8(code+codelen+6, (af >> 24) & 255)
            codelen = codelen + 7
            let mj=4; while mj>=0 { xpop(r64(mather_saved+mj*8)); mj=mj-1 }
            xpop(5); ret()
        }
        else if op==IR_FNPTR {
            // fnptr(FNAME): load the function's code pointer as a runtime value.
            // Deferred like IR_CALL: emit placeholder lea, patch the disp at the
            // end (func_code_starts may not be set yet for forward refs).
            let fi=a0
            let lea_ofs=codelen
            eb(72); eb(141); eb(5)        // 48 8D 05 = lea rax,[rip+disp32]
            ei(0)                            // placeholder disp
            w64(patches+patchc*PCS, lea_ofs); w64(patches+patchc*PCS+8, fi); w64(patches+patchc*PCS+16, 4); patchc=patchc+1
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
        }
        else if op==IR_CLOSURE_CALL {
            // closure_call(fnb, args...): fnb is a mk_any tuple (tag=codeptr, val=env).
            // FIX: the callee is a NORMAL function (e.g. add(a,b)) using the standard
            // SysV ABI, so caller args must land in the STANDARD arg registers
            // (rdi,rsi,rdx,rcx,r8,r9). The previous code shifted args by one and put
            // env in rdi, which collided with the callee's first param (add read
            // a=env, b=arg0 -> wrong result). Env now goes to r10 (caller-saved
            // scratch the callee ignores). Result returns in rax.
            let fnb=a0; let avs2=a1; let nargc=a2
            if nargc>5 { compile_error(2, cur_fnname, cur_fnnlen) }  // arity: too many closure args (v1 cap)
            flush_all()
            // rax = fnb tuple pointer
            rbp(R_RAX, spill_home(fnb))
            // rdx = fnb.0 (codeptr)  -- 64-bit load [rax]
            eb(72); eb(139); mr(0, R_RDX, R_RAX)        // 48 8B 10 = mov rdx,[rax]
            // r10 = fnb.1 (env)  -- 64-bit load [rax+8]; scratch reg, callee ignores it
            eb(76); eb(139); mr(1, 2, 0); eb(8)         // 4C 8B 50 08 = mov r10,[rax+8] (REX.WR for r10)
            // stash codeptr in r11 (caller-saved scratch; safe, no syscall here)
            eb(76); eb(139); mr(3, 3, 2)               // 4C 8B DA = mov r11, rdx
            // load caller args into STANDARD SysV positions rdi,rsi,rdx,rcx,r8,r9
            let j=0
            while j<nargc {
                let av=irres(avs2+j)
                let hm=spill_home(av)
                if j==0 { rbp(R_RDI, hm) }
                if j==1 { rbp(R_RSI, hm) }
                if j==2 { rbp(R_RDX, hm) }
                if j==3 { rbp(R_RCX, hm) }
                if j==4 { rbp(R_R8, hm) }
                if j==5 { rbp(R_R9, hm) }
                j=j+1
            }
            // call r11
            eb(65); eb(255); mr(3, 2, R_R11%8)              // 41 FF D3 = call r11
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
        }
        else if op==IR_CALL {
            flush_all()
            // Load arguments from their home slots directly into ABI registers.
            // flush_all() above spilled every live vreg to its home, so the
            // sources are distinct memory locations and destinations are distinct
            // registers -- no aliasing hazard (matches the Python oracle).
            let arg_start = a2; let arg_cnt = a1
            // args 6+ go on the stack (SysV). Push them highest-index-first so
            // arg6 ends up on top -> lands at [rbp+16] in the callee. Keep rsp
            // 16-byte aligned across the call; caller cleans up afterwards.
            let nstack=0
            if arg_cnt>6 { nstack=arg_cnt-6 }
            let pad=0
            if nstack>0 {
                if nstack%2==1 { pad=8; sbi(8) }   // align rsp to 16 before pushes
                let sj=arg_cnt-1
                while sj>=6 {
                    let arg_ir2=arg_start+sj
                    if arg_ir2<irc {
                        let av2=irres(arg_ir2)
                        rbp(0, spill_home(av2))   // rax = arg
                        xpush(0)                  // push rax
                    }
                    sj=sj-1
                }
            }
            // Load register args 0..5 from home slots into the ABI registers.
            let arg_i=0
            while arg_i<arg_cnt {
                if arg_i<6 {
                    let arg_ir = arg_start + arg_i
                    if arg_ir < irc {
                        let av=irres(arg_ir)
                        let preg=0
                        if arg_i==0 { preg=7 }
                        if arg_i==1 { preg=6 }
                        if arg_i==2 { preg=2 }
                        if arg_i==3 { preg=1 }
                        if arg_i==4 { preg=8 }
                        if arg_i==5 { preg=9 }
                        rbp(preg, spill_home(av))
                    }
                }
                arg_i=arg_i+1
            }

            // Compute function name length by scanning from source index a0
            let nm=a0; let nl=0
            while nl<256 {
                let c0=r8(src+nm+nl)
                if c0==0||c0==40||c0==59||c0==123||c0==125||c0==44 { break }
                if c0==32||c0==9||c0==10||c0==13 { break }
                nl=nl+1
            }
            // Variadic callee: pass total arg count in r10 so its prologue can
            // snapshot the incoming args into its own frame-local va area.
            let callee=findfn(nm,nl)
            if callee>=0 && r64(fn_var + callee*8)==1 {
                ri(10, arg_cnt)
            }
            // P3: if callee is extern "C", emit direct call to external symbol
            // (needs PLT/GOT in full impl; for now skip patching internal call)
            if callee>=0 && r64(fn_extern + callee*8)==1 {
                // extern "C" function - call via external symbol
                // For now, emit a call to the external name (will need PLT/GOT)
                // In a real impl we'd emit a PLT entry; for now just leave a call
                // with the external symbol name that the dynamic linker resolves
                let call_ofs = codelen
                eb(232)  // E8 = call
                ei(0)    // placeholder - would be PLT entry in full impl
                // Record as extern call type for later PLT resolution
                w64(patches+patchc*PCS,call_ofs); w64(patches+patchc*PCS+8,nm); w64(patches+patchc*PCS+16,3)
                patchc=patchc+1
            }
            // Built-ins are emitted inline; source functions get a patched call.
            else if emit_bltn(nm,nl)==0 {
                // Emit call with placeholder
                let call_ofs = codelen
                eb(232)  // E8 = call
                ei(0)    // placeholder
                // Record patch: target = function index, type=2
                w64(patches+patchc*PCS,call_ofs); w64(patches+patchc*PCS+8,nm); w64(patches+patchc*PCS+16,2)
                patchc=patchc+1
            }

            // Caller cleanup: reclaim stack space used for args 6+ (and pad).
            if nstack>0 { abi(nstack*8 + pad) }   // add rsp, nstack*8+pad

            // Save result - allocate result register
            let rres=aphys(res)
            if rres!=0 { rr(rres,0) }; sdef(res, rres)
        }
        else if op==IR_FREE {
            // P2 ownership: compiler-inserted free of a mem_alloc-owned binding.
            // a0 = the owned vreg. Load it into rdi (munmap addr), read the header
            // into rsi for the length, then munmap (same bytes as builtin free()).
            flush_all()
            let fv=irres(a0)
            rbp(R_RDI, spill_home(fv))        // rdi = ptr
            eb(72); eb(139); eb(55)            // mov rsi, [rdi]   (len = header; munmap rounds up)
            eb(184); ei(11)                    // mov eax, 11      (munmap)
            sysc()
        }
        else if op==IR_DEREF {  // P6: *p - raw pointer dereference (load)
            flush_all()
            let rd=aphys(res)
            let rs=aphys(a0)
            eb(72); mr(1, rd, rs)   // mov (rd), [rs]  (64-bit load)
            sdef(res, rd)
        }
        else if op==IR_DEREF_MUT {  // P6: *p = v (store through raw pointer)
            flush_all()
            let rs=aphys(a0)   // pointer
            let rv=aphys(a1)   // value
            eb(72); mr(0, rs, rv)   // mov [rs], rv  (64-bit store)
        }
        else if op==IR_PTR_ADD {  // P6: p + n (element-sized)
            let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            // Scale by 8: lea rd, [r1 + r2*8]
            if r2!=0 {
                // Use LEA with scale=8: lea rd, [r1 + r2*8]
                // encoding: 8D /r (lea r64, m) with SIB byte for scale=8
                // For x86-64: lea rd, [r1 + r2*8] = REX.W 8D mod=00 SIB disp32=0
                // SIB = scale(3)<<6 | index(r2)<<3 | base(r1)
                let sib = 0x80 | ((r2 & 7) << 3) | (r1 & 7)
                let rexl = 0x48 | ((rd>>3) & 1) | ((r1>>3) & 1)<<1 | ((r2>>3) & 1)<<2
                eb(rexl); eb(0x8D); eb(sib); ei(0)
            } else {
                if rd!=r1 { rr(rd,r1) }
            }
            sdef(res, rd)
        }
        else if op==IR_PTR_SUB {  // P6: p - n (element-sized)
            let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            // Scale by 8: lea rd, [r1 - r2*8] = lea rd, [r1 + r2*(-8)]
            // Use LEA with negative scale trick: sub then LEA, or use SUB directly
            if r2!=0 {
                // LEA with negative displacement: lea rd, [r1 - r2*8]
                // Can do: sub temp, r2*8; lea rd, [r1 + temp]
                // Simpler: use SUB after LEA for positive, or use scaled index with negative disp
                // For now: compute r2*8 into temp, then sub
                let temp = nv()
                rr(temp, r2)
                eb(0xD1); mr(3, temp, temp)  // shl temp, 3  (multiply by 8)
                if rd!=r1 { rr(rd, r1) }
                rs(rd, temp)
            } else {
                if rd!=r1 { rr(rd,r1) }
            }
            sdef(res, rd)
        }
        else if op==IR_PTR_DIFF {  // P6: p - q (elements)
            let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            rs(rd, r2)
            // Divide by 8: sar rd, 3 (arithmetic shift right)
            eb(0xD1); mr(7, rd, rd)  // sar rd, 3
            sdef(res, rd)
        }
        else if op==IR_PTR_CAST {  // P6: &p or cast to raw pointer
            // a1: 1 = address-of, 0 = cast (no-op, just type change)
            // For address-of, a0 is the vreg of a local; we need its stack address.
            // The backend already has the vreg in a register or spill slot.
            // Just move the value through (address-of handled by using spill_home).
            let rd=aphys(res)
            let rs=aphys(a0)
            if rd!=rs { rr(rd, rs) }
            sdef(res, rd)
        }
        else if op==IR_IS_NULL {  // P6: p == 0
            let r1=aphys(a0); let rd=adistinct(res,r1,r1)
            // cmp r1, 0; sete rd
            eb(0x48); eb(0x83); mr(7, r1, r1); ei(0)  // cmp r1, 0
            eb(0x0F); eb(0x94); mr(0, rd, r1)  // sete rd
            sdef(res, rd)
        }
        else if op==IR_VOLATILE_LOAD {  // P6: volatile load
            flush_all()
            let rd=aphys(res)
            let rs=aphys(a0)
            eb(72); mr(1, rd, rs)   // mov (rd), [rs]  (64-bit load)
            // Compiler barrier: asm volatile("" ::: "memory")
            eb(0x0F); eb(0xAE); eb(0xF0)  // mfence (full barrier)
            sdef(res, rd)
        }
        else if op==IR_VOLATILE_STORE {  // P6: volatile store
            flush_all()
            let rs=aphys(a0)
            let rt=aphys(a1)
            eb(72); mr(0, rs, rt)   // mov [rs], rt  (64-bit store)
            // Compiler barrier
            eb(0x0F); eb(0xAE); eb(0xF0)  // mfence
        }
        // P10: IR_ARRAY_LEN (op 69) — get array length from header [base]
        else if op==IR_ARRAY_LEN {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            eb(0x48); eb(0x8B); mr(0, rd, rs)  // mov rd, [rs]  (64-bit load from header)
            sdef(res, rd)
        }
        else if op==IR_STR {
            // a0 = pointer to string in source (including opening quote)
            let sp=a0+1  // skip quote
            // Find length by scanning to closing quote
            let ln=0; let scp=sp
            while scp<srclen&&r8(src+scp)!=34 {
                ln=ln+1; if r8(src+scp)==92&&scp+1<srclen { scp=scp+2 } else { scp=scp+1 }
            }
            // Emit to output binary's data section (absolute address). String literals
            // live AFTER all global slots: GDATA + (INTERNAL_GLOBAL_COUNT+gvarc)*8 + data_off.
            let gdata_size = (INTERNAL_GLOBAL_COUNT + gvarc)*8
            let str_addr = GDATA + gdata_size + data_off
            let rd=aphys(res)
            if emit_obj == 1 {
                // OBJECT mode: RIP-relative lea rd, [rip+disp32]; disp32 patched by an
                // R_X86_64_PC32 reloc against _gdata, addend = gdata_size+data_off-4.
                let rexl=72; if rd>=8 { rexl=76 }
                eb(rexl); eb(141); eb(5 + (rd%8)*8); ei(0)   // REX.W 8D mod=00 rm=rip disp32
                w64(gpatches+gpatchc*24, codelen-4)
                w64(gpatches+gpatchc*24+8, gdata_size + data_off)
                w8(gpatches+gpatchc*24+16, 2)
                gpatchc=gpatchc+1
            } else {
                ri64(rd, str_addr)
            }
            if data!=0 && data!=0xFFFFFFFFFFFFFFFF {
                let ci=0
                let si=sp
                while ci<ln {
                    let sv=r8(src+si)
                    if sv==92&&si+1<srclen {
                        let nx=r8(src+si+1)
                        if nx==110 { sv=10 }
                        else if nx==116 { sv=9 }
                        else if nx==114 { sv=13 }
                        else if nx==48 { sv=0 }
                        else if nx==92 { sv=92 }
                        else if nx==34 { sv=34 }
                        else if nx==39 { sv=39 }
                        else { sv=nx }
                        si=si+2
                    } else {
                        si=si+1
                    }
                    w8(data+data_off+8+ci, sv)
                    ci=ci+1
                }
                w64(data+data_off, ln)
                w8(data+data_off+8+ln, 0)
                let bsz=8+ln+1; let pad=bsz%16; if pad>0 { bsz=bsz+(16-pad) }
                data_off=data_off+bsz
            }
            sdef(res, rd)
        }
        // P6: Raw pointer dereference (*p)
        else if op==IR_DEREF {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            eb(72); eb(139); mr(0, rd, rs)   // mov rd, [rs]
            sdef(res, rd)
        }
        // P6: Mutable raw pointer dereference (*p = v)
        else if op==IR_DEREF_MUT {
            flush_all()
            let rs=aphys(a0)   // pointer
            let rv=aphys(a1)   // value
            eb(72); eb(137); mr(0, rs, rv)   // mov [rs], rv
        }
        // P6: Pointer arithmetic p + n (element-sized)
        else if op==IR_PTR_ADD {
            let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            // Scale by element size (8 bytes for pointers)
            if r2!=0 { ra(rd,r2) }  // assume already scaled or use shift
            sdef(res, rd)
        }
        // P6: Pointer arithmetic p - n
        else if op==IR_PTR_SUB {
            let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            rs(rd,r2)
            sdef(res, rd)
        }
        // P6: Pointer diff p - q (elements)
        else if op==IR_PTR_DIFF {
            let r1=aphys(a0); let r2=aphys(a1); let rd=adistinct(res,r1,r2)
            if rd!=r1 { rr(rd,r1) }
            rs(rd,r2)
            // Divide by 8 (element size) - use shr for unsigned
            eb(72); eb(139); mr(0, 1, rd)  // mov rcx, rd
            eb(72); eb(193); eb(249); eb(3)  // shr rcx, 3
            rr(rd, 1)
            sdef(res, rd)
        }
        // P6: Pointer cast (p as usize / usize as *T / address-of)
        else if op==IR_PTR_CAST {
            // a0 = value, a1 = type tag (0=to usize, 1=address-of)
            if a1==1 {
                // address-of: just use the value as a pointer
                let rs=aphys(a0)
                let rd=aphys(res)
                if rd!=rs { rr(rd,rs) }
                sdef(res, rd)
            } else {
                // cast to usize (identity for raw pointers)
                let rs=aphys(a0)
                let rd=aphys(res)
                if rd!=rs { rr(rd,rs) }
                sdef(res, rd)
            }
        }
        // P6: is_null check
        else if op==IR_IS_NULL {
            let r1=aphys(a0)
            let rd=adistinct(res,r1,r1)
            // cmp r1, 0; sete rd
            eb(72); eb(131); eb(248 + (r1%8)); eb(0)  // cmp r1, 0
            eb(15); eb(148 + (rd%8)); eb(0)  // sete rd (8-bit)
            rzx(rd,rd)
            sdef(res, rd)
        }
        // P6: Volatile load (MMIO)
        else if op==IR_VOLATILE_LOAD {
            flush_all()
            let rs=aphys(a0)
            let rd=aphys(res)
            // Use mov with volatile semantics (compiler barrier)
            eb(72); eb(139); mr(0, rd, rs)   // mov rd, [rs]
            // Compiler barrier: asm volatile("" ::: "memory") - skip for now
            sdef(res, rd)
        }
        // P6: Volatile store (MMIO)
        else if op==IR_VOLATILE_STORE {
            flush_all()
            let rs=aphys(a0)
            let rv=aphys(a1)
            eb(72); eb(137); mr(0, rs, rv)   // mov [rs], rv
            // Compiler barrier
        }
        // P6: Inline assembly (placeholder - emit as no-op for now)
        // P6: Raw pointer type markers (no runtime codegen)
        else if op==IR_RAW_PTR {
            // No-op: raw pointer type annotation
        }
        else if op==IR_MUT_PTR {
            // No-op: mutable raw pointer type annotation
        }
        // P6: Raw pointer type markers (no runtime codegen)
        else if op==IR_RAW_PTR {
            // No-op: raw pointer type annotation
        }
        else if op==IR_MUT_PTR {
            // No-op: mutable raw pointer type annotation
        }
        else if op==IR_FFI_CALL {  // P6: FFI call - System V AMD64 ABI
            flush_all()
            // a0 = function pointer (address), a1 = number of args, a2 = args array pointer
            // For now, implement simple FFI call with up to 6 integer args in registers
            let fn_ptr = aphys(a0)
            let nargs = aphys(a1)
            let args_ptr = aphys(a2)
            
            // Save caller-saved registers that we'll use
            // SysV: RDI, RSI, RDX, RCX, R8, R9 for first 6 args
            // AAPCS64: X0-X7 for first 8 args
            // We'll implement a simple version: load args from memory into registers
            
            // For x86-64: load args from args_ptr array into RDI, RSI, RDX, RCX, R8, R9
            // Stack must be 16-byte aligned before call
            
            // Align stack to 16 bytes
            eb(0x48); eb(0x83); eb(0xEC); ei(8)  // sub rsp, 8 (align)
            
            // Load up to 6 args from args_ptr array into registers
            // args_ptr points to array of 64-bit values
            let arg0 = nv(); let arg1 = nv(); let arg2 = nv()
            let arg3 = nv(); let arg4 = nv(); let arg5 = nv()
            
            // Load args: mov reg, [args_ptr + offset]
            aldr(arg0, args_ptr, 0)
            aldr(arg1, args_ptr, 8)
            aldr(arg2, args_ptr, 16)
            aldr(arg3, args_ptr, 24)
            aldr(arg4, args_ptr, 32)
            aldr(arg5, args_ptr, 40)
            
            // Move to SysV ABI argument registers
            rr(7, arg0)   // RDI
            rr(6, arg1)   // RSI
            rr(2, arg2)   // RDX
            rr(1, arg3)   // RCX
            rr(8, arg4)   // R8
            rr(9, arg5)   // R9
            
            // Call function pointer
            // mov rax, fn_ptr; call rax
            if fn_ptr != 0 { araw(0xAA0003E0 | (fn_ptr << 16)) }  // mov rax, fn_ptr
            araw(0xFF); araw(0xD0)  // call rax
            
            // Restore stack
            eb(0x48); eb(0x83); eb(0xC4); ei(8)  // add rsp, 8
            
            // Return value in RAX
            let rd = aphys(res)
            if rd != 0 { araw(0xAA0003E0 | (0 << 16) | rd) }  // mov rd, rax
            sdef(res, rd)
        }
        else if op==IR_VEC128 {  // P6: SIMD vec128 (placeholder)
            flush_all()
            eb(144)
            let rd=aphys(res)
            rxor(rd, rd)
            sdef(res, rd)
        }
        else if op==IR_UNSAFE_BLOCK {  // P6: unsafe block marker (no-op at runtime)
            // No-op: unsafe{} is a compile-time construct
        }
        else if op==IR_ASM {
            // TODO: parse asm template, constraints, emit instructions
            // For now, emit nop
            eb(144)  // nop
            let rd=aphys(res)
            rxor(rd,rd)
            sdef(res, rd)
        }
        ii=ii+1
    }

    // Resolve this function's label jumps/branches (ty 0 = jmp, ty 1 = je).
    // Label offsets live in the per-function lblmap, so this must happen before
    // the next function resets it.
    let pk=pstart
    while pk<patchc {
        let pty=r64(patches+pk*PCS+16)
        if pty==0 {
            let ppo=r64(patches+pk*PCS); let plbl=lblf(r64(patches+pk*PCS+8))
            if plbl>=0 { w32(code+ppo+1, plbl-(ppo+5)) }
        } else if pty==1 {
            let ppo=r64(patches+pk*PCS); let plbl=lblf(r64(patches+pk*PCS+8))
            if plbl>=0 { w32(code+ppo+2, plbl-(ppo+6)) }
        }
        pk=pk+1
    }

    // Epilogue (should not reach here for normal functions)
    abi(4096+total_str+80); xpop(5); ret()
}

let call_saved = mmap(80)
let mather_saved = mmap(40)

fn init_cs() {
    w64(call_saved+0, 0); w64(call_saved+8, 1); w64(call_saved+16, 2)
    w64(call_saved+24, 6); w64(call_saved+32, 7); w64(call_saved+40, 8)
    w64(call_saved+48, 9); w64(call_saved+56, 10)
    w64(mather_saved+0, 3); w64(mather_saved+8, 12); w64(mather_saved+16, 13)
    w64(mather_saved+24, 14); w64(mather_saved+32, 15)
}

// Global variable addresses for compiler internals (absolute addresses in BSS)
fn init_cglobals() {
    w64(CGLOBALS+0, 4362076160);   // code        = 0x42200000
    w64(CGLOBALS+8, 4362076168);   // codelen     = 0x42200008
    w64(CGLOBALS+16, 4362076176);  // patches     = 0x42200010
    w64(CGLOBALS+24, 4362076184);  // patchc      = 0x42200018
    w64(CGLOBALS+32, 4362076192);  // src         = 0x42200020
    w64(CGLOBALS+40, 4362076200);  // srclen      = 0x42200028
    w64(CGLOBALS+48, 4362076208);  // toks        = 0x42200030
    w64(CGLOBALS+56, 4362076216);  // tokc        = 0x42200038
    w64(CGLOBALS+64, 4362076224);  // tokp        = 0x42200040
    w64(CGLOBALS+72, 4362076232);  // gvars       = 0x42200048
    w64(CGLOBALS+80, 4362076240);  // ginit       = 0x42200050
    w64(CGLOBALS+88, 4362076248);  // gvarc       = 0x42200058
    w64(CGLOBALS+96, 4362076256);  // data        = 0x42200060
    w64(CGLOBALS+104, 4362076264); // data_off    = 0x42200068
    w64(CGLOBALS+112, 4362076272); // lblmap      = 0x42200070
    w64(CGLOBALS+120, 4362076280); // lblc        = 0x42200078
    w64(CGLOBALS+128, 4362076288); // REGS        = 0x42200080
    w64(CGLOBALS+136, 4362076304); // alloc       = 0x422000F0
    w64(CGLOBALS+144, 4362112496); // allocfc     = 0x429DF0
    w64(CGLOBALS+152, 4362112504); // mather_saved= 0x429DF8
}

let CALLER_SAVED = call_saved

// ============================================================================
// P4 ARM64 (aarch64) BACKEND
// Self-contained module mirroring the x86-64 codegen. All touches into the
// shared code buffer via eb/ei/w8/w32/w64 (which append at codelen). Register
// allocator spills to the function stack frame at [sp + 8 + vr*8] (AAPCS64:
// x29/x30 are frame/link, so we never use them as allocatable; x19-x28 are
// callee-saved and preserved across our own calls by the prologue/epilogue).
// Allocatable pool = x1..x7, x9..x15 (14 regs, matches x86 REGS count).
// ============================================================================

// --- ARM64 instruction emit helpers (encodings are little-endian 32-bit) ---
fn aeb(b) { eb(b) }                                  // append 1 raw byte
fn araw(w) { w32(code+codelen, w); codelen=codelen+4 } // append full 32-bit instruction
fn amovz(rd, imm16) { araw(0xD2800000 | ((imm16 & 0xFFFF) << 5) | (rd & 31)) }
fn amovk(rd, imm16, lsl) { araw(0xF2800000 | ((imm16 & 0xFFFF) << 5) | ((lsl & 3) << 21) | (rd & 31)) }
// arm_gptr(rd, gaddr): load a PC-relative pointer to link-time gdata address gaddr
// into rd. Used for GOT-less PIC on ARM64: adrp rd, page(gaddr-pc); add rd, rd, lo(gaddr).
// pclink = LINK_BASE + LINK_HT + codelen (link-time address of this instruction).
// In OBJECT mode (emit_obj==1) the absolute address cannot be baked — instead we
// record the adrp/add sites and emit R_AARCH64_ADR_PREL_PG_HI21 /
// R_AARCH64_ADD_ABS_LO12_NC relocations against _gdata at finalize time.
fn arm_gptr(rd, gaddr) {
    if emit_obj == 1 {
        let adrp_ofs = codelen
        let gidx = (gaddr - GDATA_ARM) / 8
        araw(0x90000000 | (rd & 31))          // adrp rd, #0  (placeholder; reloc fills it)
        let add_ofs = codelen
        // Final link address is unknown here, so the low-12 add must ALWAYS be
        // emitted; the ADD_ABS_LO12_NC reloc fills the immediate (may be 0).
        araw(0x91000000 | ((rd & 31) << 5) | (rd & 31))
        let has_add = 1
        // record [adrp_ofs, add_ofs, gidx, has_add]
        w64(gpatches_a + gapatchc*32 + 0, adrp_ofs)
        w64(gpatches_a + gapatchc*32 + 8, add_ofs)
        w64(gpatches_a + gapatchc*32 + 16, gidx)
        w64(gpatches_a + gapatchc*32 + 24, has_add)
        gapatchc = gapatchc + 1
        return
    }
    let pclink = LINK_BASE + LINK_HT + codelen
    let imm = (gaddr >> 12) - (pclink >> 12)   // adrp: PAGE delta, not byte delta >> 12
    let immlo = imm & 3
    let immhi = (imm >> 2) & 0x1FFFF
    araw(0x90000000 | (immlo << 29) | (immhi << 5) | (rd & 31))   // adrp rd, #imm
    let lo = gaddr & 0xFFF
    if lo != 0 { araw(0x91000000 | (lo << 10) | ((rd & 31) << 5) | (rd & 31)) }  // add rd, rd, #lo
}

// amov_imm64: load a 64-bit constant via movz + up to 3 movk. lsl in {0,16,32,48}.
fn amov_imm64(rd, v) {
    amovz(rd, (v & 0xFFFF))
    if (v >> 16) != 0 {
        amovk(rd, ((v >> 16) & 0xFFFF), 1)
        if (v >> 32) != 0 {
            amovk(rd, ((v >> 32) & 0xFFFF), 2)
            if (v >> 48) != 0 { amovk(rd, ((v >> 48) & 0xFFFF), 3) }
        }
    }
}
fn aadd(rd, rn, rm) { araw(0x8B000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn asub(rd, rn, rm) { araw(0xCB000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn aand(rd, rn, rm) { araw(0x8A000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn aorr(rd, rn, rm) { araw(0xAA000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn aeor(rd, rn, rm) { araw(0xCA000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn amul(rd, rn, rm) { araw(0x9B007C00 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn asdiv(rd, rn, rm) { araw(0x9AC00C00 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn audiv(rd, rn, rm) { araw(0x9AC00800 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) }
fn amod(rd, rn, rm) { // rd = rn % rm (signed): sdiv q; msub rd, q, rm, rn
    let q=rd; if q==rn||q==rm { q=9 } // avoid clobber if rd aliases operand (caller ensures distinct)
    asdiv(q, rn, rm); araw(0x9B008000 | ((rm & 31) << 16) | ((rn & 31) << 10) | ((q & 31) << 5) | (rd & 31)) // msub rd, q, rm, rn
}
fn aneg(rd, rn) { araw(0xCB000000 | ((rn & 31) << 16) | ((31) << 5) | (rd & 31)) } // sub rd, XZR, rn
fn alsr(rd, rn, rm) { araw(0x9AC02800 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) } // asrv (arithmetic shift right by register)
fn alsl(rd, rn, rm) { araw(0x9AC02000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)) } // lsl (register shift)
fn alsli(rd, rn, sh) { araw(0xD3400000 | (((64-sh) & 63) << 16) | (((63-sh) & 63) << 10) | ((rn & 31) << 5) | (rd & 31)) } // lsl rd,rn,#sh (immediate, 64-bit)
fn acmp(rn, rm) { araw(0xEB00001F | ((rm & 31) << 16) | ((rn & 31) << 5)) } // subs xzr, rn, rm
fn acmp_imm(rn, imm) { // subs xzr, rn, #imm (imm 0..4095)
    araw(0xF100001F | ((imm & 0xFFF) << 10) | ((rn & 31) << 5))
}
fn acbz(rn, off) { // cbz rn, +off (off is byte offset from cbz itself). off must be multiple of 4, signed 19-bit.
    let o=(off >> 2) & 0x7FFFF; araw(0x34000000 | (o << 5) | (rn & 31))
}
fn acbnz(rn, off) { let o=(off >> 2) & 0x7FFFF; araw(0x35000000 | (o << 5) | (rn & 31)) }
fn ab(imm26) { araw(0x94000000 | (imm26 & 0x3FFFFFF)) } // bl (patched later with full disp)
fn aret() { araw(0xD65F03C0) } // ret
fn asvc() { araw(0xD4000001) } // svc #0 (imm16=0 in bits 20:5, bit0 of opcode LL=01)
fn astp_pre(r1, r2) { araw(0xA9BF7BFD) } // stp x29,x30,[sp,#-16]!  (fixed; we always push x29,x30)
fn astp_fix(rd, rt, off) { araw(0xA9000000 | ((rt & 31) << 10) | ((off/8 & 0x3F) << 12) | (rd & 31)) } // stp
fn aldpx(rd, rt, off) { araw(0xA9400000 | ((rt & 31) << 10) | ((off/8 & 0x3F) << 12) | (rd & 31)) } // ldp (post-index base)
fn aldp_fix(rd, rt, off) { araw(0xA9400000 | ((rt & 31) << 10) | ((off/8 & 0x3F) << 12) | (rd & 31)) }
fn astr(rd, rn, off) { araw(0xF9000000 | ((rn & 31) << 5) | (rd & 31) | ((off/8 & 0xFFF) << 10)) } // str xd,[xn,#off]
fn aldr(rd, rn, off) { araw(0xF9400000 | ((rn & 31) << 5) | (rd & 31) | ((off/8 & 0xFFF) << 10)) } // ldr xd,[xn,#off]
fn astrb(rd, rn, off) { araw(0x39000000 | ((rn & 31) << 5) | (rd & 31) | ((off & 0xFFF) << 10)) } // strb
fn aldrb(rd, rn, off) { araw(0x39400000 | ((rn & 31) << 5) | (rd & 31) | ((off & 0xFFF) << 10)) } // ldrb
fn aaddi(rd, rn, imm) { araw(0x91000000 | ((imm & 0xFFF) << 10) | ((rn & 31) << 5) | (rd & 31)) } // add rd,rn,#imm (Rn=31 -> SP)
fn asubi(rd, rn, imm) { araw(0xD1000000 | ((imm & 0xFFF) << 10) | ((rn & 31) << 5) | (rd & 31)) } // sub rd,rn,#imm
fn amovr(rd, rn) { araw(0xAA0003E0 | ((rn & 31) << 16) | (rd & 31)) } // mov rd, rn (orr rd,xzr,rn)
// arm_bcopy(sr, dr, cr): inline byte-copy loop. Copies cr bytes [sr]->[dr].
// Advances sr/dr past the copied region, cr -> 0. Clobbers x9. 7 instructions.
fn arm_bcopy(sr, dr, cr) {
    acbz(cr, 28)             // done when count==0 (skip 6 instrs)
    aldrb(9, sr, 0)          // x9 = [sr]
    astrb(9, dr, 0)          // [dr] = x9
    aaddi(sr, sr, 1)
    aaddi(dr, dr, 1)
    asubi(cr, cr, 1)
    araw(0x17FFFFFA)         // b -24 (back to cbz)
}

// --- ARM64 register allocator (parallel to x86; spills to frame at [sp+8+vr*8]) ---
let AREGS = mmap(112)  // 14 physical ARM regs (x1..x7, x9..x15)
fn init_aregs() {
    w64(AREGS+0, 1); w64(AREGS+8, 2); w64(AREGS+16, 3); w64(AREGS+24, 4)
    w64(AREGS+32, 5); w64(AREGS+40, 6); w64(AREGS+48, 7)
    w64(AREGS+56, 9); w64(AREGS+64, 10); w64(AREGS+72, 11); w64(AREGS+80, 12)
    w64(AREGS+88, 13); w64(AREGS+96, 14); w64(AREGS+104, 15)
}
let aalloc = mmap(2000000); let aallocfc = 0
let av_init = mmap(2000000)
let av_spill = mmap(2000000)
fn ahome(v) { return 8 + (v + 1) * 8 }  // frame offset for vreg v (bytes from sp)
fn afind_a(vr) { let i=0; while i<aallocfc { if r64(aalloc+i*16)==vr { return r64(aalloc+i*16+8) }; i=i+1 }; return -1 }
fn aset_a(vr, pr) { w64(aalloc+aallocfc*16, vr); w64(aalloc+aallocfc*16+8, pr); aallocfc=aallocfc+1 }
fn aphys_a(vr) {
    let f=afind_a(vr); if f>=0 { return f }
    let p=afree_a()
    if r8(av_init+vr)!=0 { aldr(p, 31, ahome(vr)) }  // x31=sp as base
    aset_a(vr, p); return p
}
fn afree_a() {
    let k=0
    while k<14 { let pr=r64(AREGS+k*8); let used=0; let j=0
        while j<aallocfc { if r64(aalloc+j*16+8)==pr { used=1; break }; j=j+1 }
        if used==0 { return pr }
        k=k+1
    }
    aallocfc=aallocfc-1
    let ev_vr=r64(aalloc+aallocfc*16); let ev_pr=r64(aalloc+aallocfc*16+8)
    if r8(av_init+ev_vr)!=0 { astr(ev_pr, 31, ahome(ev_vr)) }
    w8(av_spill+ev_vr, 1)
    return ev_pr
}
fn adistinct_a(res, a1, a2) {
    let f=afind_a(res); if f>=0 { if f!=a1 && f!=a2 { return f } }
    let i=0
    while i<aallocfc {
        let pr=r64(aalloc+i*16+8)
        if pr==a1 || pr==a2 {
            let ev_vr=r64(aalloc+i*16)
            if r8(av_init+ev_vr)!=0 { astr(pr, 31, ahome(ev_vr)) }
            w8(av_spill+ev_vr, 1)
            aallocfc=aallocfc-1
            w64(aalloc+i*16, r64(aalloc+aallocfc*16)); w64(aalloc+i*16+8, r64(aalloc+aallocfc*16+8))
        } else { i=i+1 }
    }
    let p=-1; let k=0
    while k<14 { let pr=r64(AREGS+k*8)
        if pr!=a1 && pr!=a2 { let used=0; let j=0
            while j<aallocfc { if r64(aalloc+j*16+8)==pr { used=1; break }; j=j+1 }
            if used==0 { p=pr; break }
        }
        k=k+1
    }
    if p<0 {
        aallocfc=aallocfc-1
        let ev_vr=r64(aalloc+aallocfc*16); let ev_pr=r64(aalloc+aallocfc*16+8)
        if r8(av_init+ev_vr)!=0 { astr(ev_pr, 31, ahome(ev_vr)) }
        w8(av_spill+ev_vr, 1)
        p=ev_pr
    }
    if r8(av_init+res)!=0 { aldr(p, 31, ahome(res)) }
    aset_a(res, p); return p
}
fn aclr_a() { aallocfc=0; let i=0; while i<vreg_n { w8(av_init+i,0); w8(av_spill+i,0); i=i+1 } }
fn afind_a_flush(vr) { return afind_a(vr) }
fn aflsuh_all() {
    let i=0
    while i<aallocfc { let vr=r64(aalloc+i*16); let pr=r64(aalloc+i*16+8)
        if r8(av_init+vr)!=0 { astr(pr, 31, ahome(vr)) }
        w8(av_spill+vr, 1); i=i+1
    }
    aallocfc=0
}
fn asdef(vr, reg) { astr(reg, 31, ahome(vr)); w8(av_init+vr, 1) }  // define vreg = persist to home

// arm_printi_core(): emit the decimal-print sequence (value in x0). Shared by
// printi/println/printsp. Preserves nothing; clobbers x1..x15,x19.
fn arm_printi_core() {
    araw(0xAA0003F3)                              // mov x19, x0  (SAVE arg)
    araw(0xD10083FF)                              // sub sp, sp, #32
    let l_loop=nl(); let l_done=nl(); let l_skipneg=nl(); let l_write=nl()
    amovz(1, 0)                                  // x1 = len = 0
    amovz(3, 0)                                  // x3 = sign = 0
    amovz(5, 10)                                 // x5 = 10 (divisor)
    amovz(7, 0x30)                               // x7 = '0'
    amovz(11, 1)                                 // x11 = 1 (constant)
    amovz(12, 63)                                // x12 = 63 (shift for sign)
    araw(0x91007FE2)                             // add x2, sp, #31 (bufend)
    amovz(9, 1); amovz(10, 3)                   // x9 = shift 1, x10 = shift 3
    alsr(3, 19, 12)
    acmp_imm(3, 0)
    let p_sn=codelen; ab(0); emit_patch(p_sn, l_skipneg, 1)   // b.eq -> skipneg
    aneg(19, 19)                                 // x19 = -x19
    audiv(4, 19, 5)                              // x4 = x19 / 10   (LOOP TOP)
    lbladd(l_skipneg, codelen)                   // skipneg lands here (past neg)
    lbladd(l_loop, codelen)                      // l_loop = loop top
    alsl(14, 4, 9)                               // x14 = q<<1
    alsl(15, 4, 10)                              // x15 = q<<3
    aadd(14, 14, 15)                             // x14 = q*10
    asub(6, 19, 14)                              // x6 = remainder
    aadd(6, 6, 7)                                // x6 = digit + '0'
    astrb(6, 2, 0)                               // store byte at [x2]
    asub(2, 2, 11)                               // x2--
    aadd(1, 1, 11)                               // len++
    aorr(19, 4, 4)                               // x19 = quotient (x4)
    acmp_imm(19, 0)
    let p_dn=codelen; ab(0); emit_patch(p_dn, l_done, 1)    // b.eq -> done
    let p_bk=codelen; ab(0); emit_patch(p_bk, l_loop, 0)    // b -> loop
    acmp_imm(3, 0)
    lbladd(l_done, codelen)                      // l_done (past back-branch)
    let p_sp=codelen; ab(0); emit_patch(p_sp, l_write, 1)    // b.eq -> skip '-'
    amovz(7, 0x2D)
    astrb(7, 2, 0)                               // store '-'
    asub(2, 2, 11)                               // x2-- (negative only)
    aadd(2, 2, 11)                               // x2 = start (COMMON)
    let wpos=codelen
    lbladd(l_write, wpos)
    araw(0x910083E1)                             // add x1, sp, #32
    araw(0xCB020021)                             // sub x1, x1, x2 (len)
    araw(0xAA0103E9)                             // mov x9, x1
    araw(0xAA0203E1)                             // mov x1, x2  (buf)
    araw(0xAA0903E2)                             // mov x2, x9  (len)
    amovz(0, 1)                                  // fd = 1
    amovz(8, 64)                                 // write
    asvc()
    araw(0x910083FF)                             // add sp, sp, #32
}

// arm_putc(ch): write one literal byte ch to stdout via a 16-byte stack slot.
fn arm_putc(ch) {
    araw(0xD10043FF)          // sub sp, sp, #16
    amovz(9, ch)
    astrb(9, 31, 0)           // [sp] = ch
    amovz(0, 1)               // fd
    araw(0x910003E1)          // mov x1, sp (add x1, sp, #0)
    amovz(2, 1)               // len = 1
    amovz(8, 64); asvc()
    araw(0x910043FF)          // add sp, sp, #16
}

// arm_mmap_seq(): mmap(len in x1) -> x0. Sets hint/prot/flags/fd/off, syscall 222.
fn arm_mmap_seq() {
    amov_imm64(0, 0x60000000)  // hint
    amovz(2, 3); amovz(3, 0x22)
    araw(0x92800004)           // movn x4, #0  -> x4 = -1 (fd)
    amovz(5, 0)
    amovz(8, 222); asvc()
}

// ============================================================================
// arm_emit_bltn(nmi, nl): inline ARM64 machine code for builtins. Returns 1 if
// emitted (builtin), 0 if caller should emit a patched bl to a source function.
// AAPCS64: args in x0..x7; result in x0. Syscall: x8=num, svc #0.
// IR_CALL has already called aflsuh_all() and loaded args into x0..x7.
// We use x19,x20,x21,x22 as scratch (callee-saved, preserved by our prologue).
// ============================================================================
fn arm_emit_bltn(nmi, nl) {
    let nm=src+nmi

    // exit(code): x8=93; svc #0. arg0 (code) already in x0.
    if nl==4 && r8(nm)=='e' && r8(nm+1)=='x' && r8(nm+2)=='i' && r8(nm+3)=='t' {
        amovz(8, 93); asvc(); return 1
    }
    // P6.1a: ARM64 float builtins. Args in x0 (arg0)/x1 (arg1) as raw 64-bit
    // bit-patterns; results returned in x0. Scalar double registers d0/d1.
    //   fmov d0, x0  = 0x9E670000   (int -> FP raw 64b)
    //   fmov x0, d0  = 0x9E660000   (FP -> int raw 64b)
    //   scvtf d0, x0 = 0x1E620000   (int64 -> double)
    //   fcvtzs x0, d0 = 0x9E620000  (double -> int64 truncate)
    //   fadd d0,d0,d1 = 0x1E612800 ; fsub=0x1E612C00 ; fmul=0x1E612A00 ; fdiv=0x1E612E00
    if nl==3 && r8(nm)=='i' && r8(nm+1)=='2' && r8(nm+2)=='f' {  // i2f(x)
        araw(0x1E620000)   // scvtf d0, x0
        araw(0x9E670000)   // fmov x0, d0
        return 1
    }
    if nl==3 && r8(nm)=='f' && r8(nm+1)=='2' && r8(nm+2)=='i' {  // f2i(x)
        araw(0x9E670000)   // fmov d0, x0
        araw(0x9E780000)   // fcvtzs x0, d0
        return 1
    }
    if nl==4 && r8(nm)=='f' && r8(nm+1)=='a' && r8(nm+2)=='d' && r8(nm+3)=='d' {  // fadd(a,b): int args -> truncated int
        araw(0x1E620000)   // scvtf d0, x0
        araw(0x1E620021)   // scvtf d1, x1
        araw(0x1E612800)   // fadd d0, d0, d1
        araw(0x9E780000)   // fcvtzs x0, d0
        return 1
    }
    if nl==4 && r8(nm)=='f' && r8(nm+1)=='s' && r8(nm+2)=='u' && r8(nm+3)=='b' {  // fsub(a,b)
        araw(0x1E620000); araw(0x1E620021); araw(0x1E613800); araw(0x9E780000); return 1
    }
    if nl==4 && r8(nm)=='f' && r8(nm+1)=='m' && r8(nm+2)=='u' && r8(nm+3)=='l' {  // fmul(a,b)
        araw(0x1E620000); araw(0x1E620021); araw(0x1E610800); araw(0x9E780000); return 1
    }
    if nl==4 && r8(nm)=='f' && r8(nm+1)=='d' && r8(nm+2)=='i' && r8(nm+3)=='v' {  // fdiv(a,b)
        araw(0x1E620000); araw(0x1E620021); araw(0x1E611800); araw(0x9E780000); return 1
    }
    // free(ptr): munmap(ptr, len). ptr in x0; len=[x0]; x8=215 (munmap).
    if nl==4 && r8(nm)=='f' && r8(nm+1)=='r' && r8(nm+2)=='e' && r8(nm+3)=='e' {
        aflsuh_all()
        aldr(1, 0, 0)        // x1 = [x0] (len header)
        amovz(8, 215); asvc(); return 1
    }
    // mem_alloc(n): header-carrying [base]=n; base+8.. = n qwords. n in x0.
    if nl==9 && r8(nm)=='m' && r8(nm+1)=='e' && r8(nm+2)=='m' && r8(nm+3)=='_' && r8(nm+4)=='a' && r8(nm+5)=='l' && r8(nm+6)=='l' && r8(nm+7)=='o' && r8(nm+8)=='c' {
        aflsuh_all()
        amovz(19, 0); aadd(19, 19, 0)   // x19 = 0 (will hold n copy safety)
        // keep n: copy x0 -> x19 (n)
        araw(0xAA0003F3)                // mov x19, x0  (orr x19,x0,x0)
        amovz(1, 8); amul(1, 0, 1)      // x1 = n*8
        amovz(2, 8); aadd(1, 1, 2)      // x1 = n*8 + 8 (len)
        amov_imm64(2, 0x60000000)       // x2 = hint
        amovz(3, 3)                     // x3 = PROT_READ|WRITE
        amovz(4, 0x22)                  // x4 = MAP_PRIVATE|ANON
        amovz(5, 0-1)                   // x5 = fd = -1
        amovz(6, 0)                     // x6 = offset = 0
        amovz(8, 9); asvc()             // mmap -> x0 = ptr
        astr(19, 0, 0)                  // [x0] = n (header)
        return 1
    }
    // mmap(len): x0=len already; set x1..x6 and syscall 222.
    if nl==4 && r8(nm)=='m' && r8(nm+1)=='m' && r8(nm+2)=='a' && r8(nm+3)=='p' {
        aflsuh_all()
        amov_imm64(1, 0x60000000)
        amovz(2, 3); amovz(3, 0x22); amovz(4, 0-1); amovz(5, 0)
        amovz(8, 222); asvc(); return 1
    }
    // mem_load: rax=[rdi]  -> x0 = [x0]
    if nl==8 && r8(nm)=='m' && r8(nm+1)=='e' && r8(nm+2)=='m' && r8(nm+3)=='_' && r8(nm+4)=='l' && r8(nm+5)=='o' && r8(nm+6)=='a' && r8(nm+7)=='d' {
        aflsuh_all(); aldr(0, 0, 0); return 1
    }
    // mem_load8: movzx rax,byte[rdi] -> x0 = byte [x0]
    if nl==9 && r8(nm)=='m' && r8(nm+1)=='e' && r8(nm+2)=='m' && r8(nm+3)=='_' && r8(nm+4)=='l' && r8(nm+5)=='o' && r8(nm+6)=='a' && r8(nm+7)=='d' && r8(nm+8)=='8' {
        aflsuh_all(); aldrb(0, 0, 0); return 1
    }
    // mem_store: [rdi]=rsi -> [x0]=x1
    if nl==9 && r8(nm)=='m' && r8(nm+1)=='e' && r8(nm+2)=='m' && r8(nm+3)=='_' && r8(nm+4)=='s' && r8(nm+5)=='t' && r8(nm+6)=='o' && r8(nm+7)=='r' && r8(nm+8)=='e' {
        aflsuh_all(); astr(1, 0, 0); return 1
    }
    // mem_store8: [rdi]=sil (null-guarded) -> if x0!=0 { [x0]=x1(b0) }
    if nl==10 && r8(nm)=='m' && r8(nm+1)=='e' && r8(nm+2)=='m' && r8(nm+3)=='_' && r8(nm+4)=='s' && r8(nm+5)=='t' && r8(nm+6)=='o' && r8(nm+7)=='r' && r8(nm+8)=='e' && r8(nm+9)=='8' {
        aflsuh_all()
        acbz(0, 8)                     // if x0==0 skip store (+8 bytes to past strb)
        astrb(1, 0, 0)                 // [x0] = x1 (low byte)
        return 1
    }
    // print(buf, len): write(1, buf, len). buf=x0, len=x1. -> x8=64, x0=1, x1=buf, x2=len
    if nl==5 && r8(nm)=='p' && r8(nm+1)=='r' && r8(nm+2)=='i' && r8(nm+3)=='n' && r8(nm+4)=='t' {
        aflsuh_all()
        amovz(19, 1)                    // x19 = fd = 1 (saved)
        amovz(2, 0); aadd(2, 2, 1)     // x2 = len (x1)
        amovz(20, 0); aadd(20, 20, 0)  // x20 = buf (x0)
        amovz(0, 1)                    // x0 = 1 (fd)
        amovz(1, 0); aadd(1, 1, 20)    // x1 = buf (x20)
        amovz(8, 64); asvc()           // write(1, buf, len)
        return 1
    }
    // printi(val): inline decimal digit loop (AAPCS64). value in x0.
    // Emits digits (LSB-first) into a 32-byte stack buffer, then write(1, buf, len).
    if nl==6 && r8(nm)=='p' && r8(nm+1)=='r' && r8(nm+2)=='i' && r8(nm+3)=='n' && r8(nm+4)=='t' && r8(nm+5)=='i' {
        aflsuh_all()
        arm_printi_core()
        return 1
    }
    // file_open(path, flags, mode): openat(AT_FDCWD=-100, path, flags, mode)
    //   AAPCS64 IR_CALL leaves path=x0, flags=x1, mode=x2. openat wants (dirfd,x0,x1,x2).
    if nl>=8&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='l'&&r8(nm+3)=='e'&&r8(nm+4)=='_'&&r8(nm+5)=='o' {
        aflsuh_all()
        araw(0xAA0203E3)            // mov x3, x2   (mode)
        araw(0xAA0103E2)            // mov x2, x1   (flags)
        araw(0xAA0003E1)            // mov x1, x0   (path)
        araw(0x92800C60)            // movn x0, #99 -> x0 = -100 (AT_FDCWD)
        amovz(8, 56); asvc()        // openat
        return 1
    }
    // file_read(fd, buf, n): x0=fd,x1=buf,x2=n; syscall 63.
    if nl>=8&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='l'&&r8(nm+3)=='e'&&r8(nm+4)=='_'&&r8(nm+5)=='r' {
        aflsuh_all(); amovz(8, 63); asvc(); return 1
    }
    // file_write(fd, buf, n): x8=64.
    if nl>=8&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='l'&&r8(nm+3)=='e'&&r8(nm+4)=='_'&&r8(nm+5)=='w' {
        aflsuh_all(); amovz(8, 64); asvc(); return 1
    }
    // file_close(fd): x8=57.
    if nl>=8&&r8(nm)=='f'&&r8(nm+1)=='i'&&r8(nm+2)=='l'&&r8(nm+3)=='e'&&r8(nm+4)=='_'&&r8(nm+5)=='c' {
        aflsuh_all(); amovz(8, 57); asvc(); return 1
    }
    // println(i): printi + '\n'
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='l'&&r8(nm+6)=='n' {
        aflsuh_all(); arm_printi_core(); arm_putc(10); return 1
    }
    // printsp(i): printi + ' '
    if nl==7&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s'&&r8(nm+6)=='p' {
        aflsuh_all(); arm_printi_core(); arm_putc(32); return 1
    }
    // newline(): single '\n'
    if nl==7&&r8(nm)=='n'&&r8(nm+1)=='e'&&r8(nm+2)=='w'&&r8(nm+3)=='l'&&r8(nm+4)=='i'&&r8(nm+5)=='n'&&r8(nm+6)=='e' {
        aflsuh_all(); arm_putc(10); return 1
    }
    // prints(s): write(1, s+8, [s]). s in x0.
    if nl==6&&r8(nm)=='p'&&r8(nm+1)=='r'&&r8(nm+2)=='i'&&r8(nm+3)=='n'&&r8(nm+4)=='t'&&r8(nm+5)=='s' {
        aflsuh_all()
        aldr(2, 0, 0)              // x2 = [s] = len
        aaddi(1, 0, 8)             // x1 = s + 8 (bytes)
        amovz(0, 1)                // fd = 1
        amovz(8, 64); asvc()
        return 1
    }
    // udiv(a,b): unsigned a/b. a=x0, b=x1.
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='d'&&r8(nm+2)=='i'&&r8(nm+3)=='v' {
        audiv(0, 0, 1); return 1
    }
    // umod(a,b): a - (a udiv b)*b
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='m'&&r8(nm+2)=='o'&&r8(nm+3)=='d' {
        audiv(9, 0, 1)
        araw(0x9B008000 | (1<<16) | (0<<10) | (9<<5) | 0)  // msub x0, x9, x1, x0
        return 1
    }
    // ult/ugt/ulte/ugte(a,b): unsigned compares -> 0/1. cmp a,b then cset.
    // ARM unsigned conds: lo=3, hi=8, ls=9, hs=2. cset(rd,c) uses csinc with inverted cond:
    // cset(rd,F) = csinc rd,xzr,xzr,F -> rd=1 when F FALSE. So set-on-LO needs
    // field HS(2), set-on-HI needs LS(9), set-on-LS needs HI(8), set-on-HS
    // needs LO(3). (Verified: GNU as cset x3,lo = field hs = 2.)
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t' { acmp(0,1); cset(0,2); return 1 }   // set on lo (cc) -> field hs
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t' { acmp(0,1); cset(0,9); return 1 }   // set on hi -> field ls
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='l'&&r8(nm+2)=='t'&&r8(nm+3)=='e' { acmp(0,1); cset(0,8); return 1 } // set on ls -> field hi
    if nl==4&&r8(nm)=='u'&&r8(nm+1)=='g'&&r8(nm+2)=='t'&&r8(nm+3)=='e' { acmp(0,1); cset(0,3); return 1 } // set on hs (cs) -> field lo
    // len(v): x0 = [x0] (header word)
    if nl==3&&r8(nm)=='l'&&r8(nm+1)=='e'&&r8(nm+2)=='n' { aldr(0, 0, 0); return 1 }
    // u8/u32/u64(x): mask to width. x in x0.
    if nl==2&&r8(nm)=='u'&&r8(nm+1)=='8' { araw(0x92401C00); return 1 }               // and x0, x0, #0xFF
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='3'&&r8(nm+2)=='2' { araw(0x92407C00); return 1 } // and x0, x0, #0xFFFFFFFF
    if nl==3&&r8(nm)=='u'&&r8(nm+1)=='6'&&r8(nm+2)=='4' { return 1 }                    // identity
    // mk_any(tag, val): mmap 16 bytes, [p]=tag, [p+8]=val. tag=x0, val=x1.
    if nl==6&&r8(nm)=='m'&&r8(nm+1)=='k'&&r8(nm+2)=='_'&&r8(nm+3)=='a'&&r8(nm+4)=='n'&&r8(nm+5)=='y' {
        aflsuh_all()
        amovr(19, 0)               // x19 = tag
        amovr(20, 1)               // x20 = val
        amovz(1, 16)               // len = 16
        arm_mmap_seq()             // x0 = ptr
        astr(19, 0, 0)             // [p] = tag
        astr(20, 0, 8)             // [p+8] = val
        return 1
    }
    // str(a,b): concat header-strings. a=x0, b=x1. New buffer via mmap.
    if nl==3&&r8(nm)=='s'&&r8(nm+1)=='t'&&r8(nm+2)=='r' {
        aflsuh_all()
        amovr(19, 0)               // x19 = a
        amovr(20, 1)               // x20 = b
        aldr(21, 19, 0)            // x21 = la
        aldr(22, 20, 0)            // x22 = lb
        aadd(1, 21, 22)            // x1 = total
        aaddi(1, 1, 9)             // x1 = total + 9 (header + nul)
        arm_mmap_seq()             // x0 = new
        amovr(23, 0)               // x23 = new
        aadd(9, 21, 22)            // x9 = total  (careful: arm_bcopy clobbers x9 later; store now)
        astr(9, 23, 0)             // [new] = total
        // copy a: src=x10=a+8, dst=x11=new+8, cnt=x12=la
        aaddi(10, 19, 8); aaddi(11, 23, 8); amovr(12, 21)
        arm_bcopy(10, 11, 12)      // after: x11 = new+8+la
        // copy b: src=x10=b+8, dst continues at x11, cnt=x12=lb
        aaddi(10, 20, 8); amovr(12, 22)
        arm_bcopy(10, 11, 12)      // after: x11 = new+8+total
        amovz(9, 0); astrb(9, 11, 0)  // nul terminator
        amovr(0, 23)               // return new
        return 1
    }
    // push(v,e): append byte e. v=x0, e=x1.
    if nl==4&&r8(nm)=='p'&&r8(nm+1)=='u'&&r8(nm+2)=='s'&&r8(nm+3)=='h' {
        aflsuh_all()
        amovr(19, 0)               // x19 = v
        amovr(20, 1)               // x20 = e
        aldr(21, 19, 0)            // x21 = oldlen
        aaddi(1, 21, 9)            // x1 = oldlen + 9
        arm_mmap_seq()             // x0 = new
        amovr(23, 0)               // x23 = new
        aaddi(9, 21, 1)            // x9 = newlen
        astr(9, 23, 0)             // [new] = newlen
        aaddi(10, 19, 8); aaddi(11, 23, 8); amovr(12, 21)
        arm_bcopy(10, 11, 12)      // after: x11 = new+8+oldlen
        astrb(20, 11, 0)           // [new+8+oldlen] = e
        amovr(0, 23)
        return 1
    }
    // pop(v): remove+return last byte (0 if empty). v=x0. In-place (len--).
    if nl==3&&r8(nm)=='p'&&r8(nm+1)=='o'&&r8(nm+2)=='p' {
        aflsuh_all()
        aldr(9, 0, 0)              // x9 = oldlen
        acbz(9, 28)                // empty -> skip 6 instrs to the zero-result
        aaddi(10, 0, 7)            // x10 = v + 7
        aadd(10, 10, 9)            // x10 = v + 7 + oldlen = &last byte
        asubi(9, 9, 1)             // x9 = oldlen - 1
        astr(9, 0, 0)              // [v] = newlen
        aldrb(0, 10, 0)            // x0 = last byte
        acbnz(0, 8)                // if x0!=0 skip the zeroing (harmless if byte==0)
        amovz(0, 0)                // x0 = 0 (empty case lands here)
        return 1
    }
    // argc(): saved variadic count at [x29 - frame + 8]... ARM frame: [sp+16] region.
    // ARM prologue stores arg count? Not yet implemented on ARM — return 0 count.
    if nl==4&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g'&&r8(nm+3)=='c' {
        aldr(0, 31, 96)            // x0 = [sp+96] = saved va count (see arm prologue)
        return 1
    }
    // arg(i): variadic arg i from the saved reg-arg area at [sp+104+i*8] (i<8).
    if nl==3&&r8(nm)=='a'&&r8(nm+1)=='r'&&r8(nm+2)=='g' {
        amovz(9, 3); alsl(9, 0, 9) // x9 = i*8
        aaddi(9, 9, 104)           // x9 = 104 + i*8
        araw(0x8B2963E9)           // add x9, sp, x9 (extended reg UXTX, Rn=SP)
        aldr(0, 9, 0)              // x0 = [x9]
        return 1
    }
    return 0
}

// ============================================================================
// arm_ci_func(fi, is_main): compile one function's IR to ARM64 code.
// Mirrors x86 ci_func but uses the ARM allocator (aphys_a/adistinct_a/aflsuh_all)
// and AAPCS64 register usage. Function frame: [sp]..[sp+frame] holds spill homes
// at [sp + 8 + vr*8]; callee-saved x19-x22 preserved by prologue/epi.
// ============================================================================
fn arm_ci_func(fi, is_main) {
    vreg_n = 0
    let pstart = patchc
    // pre-scan IR for max vreg (frame sizing) + string buffer size
    let total_str=0; let maxvr=0; let psi=0
    while psi<irc {
        let pres=irres(psi); if pres>maxvr { maxvr=pres }
        if irop(psi)==IR_STR {
            let sp2=ira0(psi)+1; let ln2=0; let scp2=sp2
            while scp2<srclen&&r8(src+scp2)!=34 { ln2=ln2+1; if r8(src+scp2)==92&&scp2+1<srclen { scp2=scp2+2 } else { scp2=scp2+1 } }
            let bsz2=8+ln2+1; let pad2=bsz2%16; if pad2>0 { bsz2=bsz2+(16-pad2) }
            total_str=total_str+bsz2
        }
        psi=psi+1
    }
    vreg_n = maxvr + 1
    init_aregs()
    aclr_a()
    // Prologue: stp x29,x30,[sp,#-16]!; mov x29,sp; sub sp,sp,frame
    astp_pre(29,30)
    araw(0x910003FD)                // mov x29, sp
    let spill_region = 48 + vreg_n * 8
    let frame_size = spill_region + total_str + 80
    let min_spill = 16384
    if frame_size < min_spill { frame_size = min_spill }
    let rem = frame_size % 16; if rem>0 { frame_size = frame_size + (16-rem) }
    // sub sp, sp, #frame  (encode via movz/movk to x9 then sub)
    amov_imm64(9, frame_size)
    araw(0xCB2963FF)                  // sub sp, sp, x9  (SUB extended reg: Rm=9 UXTX, Rn=sp, Rd=sp)
    let csi = 80; astr(0, 31, csi)    // save x0 (arg0) at [sp + 80]

    // If this is the __init function (fi==0), emit keyword table initialization first
    if fi == 0 {
        // DEBUG: Emit a NOP pattern we can search for to confirm this code runs
        araw(0xD503201F)  // NOP with specific pattern
        araw(0xD503201F)
        araw(0xD503201F)
        
        // Emit keyword table initialization for ARM64 output binary
        // Keywords in order matching ktext(): 1=fn, 2=let, 3=if, 4=else, 5=loop, 6=while, 7=for,
        // 8=break, 9=continue, 10=true, 11=false, 12=none, 13=and, 14=or, 15=not,
        // 16=return, 17=alias, 18=unsafe, 19=extern, 20=global, 21=enum, 22=match,
        // 23=type, 24=interface, 25=impl, 26=trait, 27=where, 28=Option, 29=Some,
        // 30=None, 31=Result, 32=Ok, 33=Err, 34=ref, 35=mut, 36=move, 37=String,
        // 38=raw, 39=volatile, 40=asm, 41=as, 42=usize, 43=dyn
        let kt_base = GDATA_ARM + 0x4e0
        let i = 0
        let str_ptr = GDATA_ARM + 0x800
        // Output binary: code at BASE=0x400000, GDATA at GDATA_ARM=0x500000
        // Page delta is constant: (0x500000>>12) - (0x400000>>12) = 0x500 - 0x400 = 0x100 (256 pages)
        // adrp immediate: imm = 256 -> immlo=0, immhi=64
        // adrp encoding: 0x90000000 | (0<<29) | (64<<5) | rd = 0x90000800 | rd
        
        // fn\0 (102, 110, 0)
        amovz(9, 102); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 110); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 3; i = i + 1
        // let\0 (108, 101, 116, 0)
        amovz(9, 108); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 116); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 4; i = i + 1
        // if\0 (105, 102, 0)
        amovz(9, 105); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 102); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 3; i = i + 1
        // else\0 (101, 108, 115, 101, 0)
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 108); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 115); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 5; i = i + 1
        // loop\0 (108, 111, 111, 112, 0)
        amovz(9, 108); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 111); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 111); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 112); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 5; i = i + 1
        // while\0 (119, 104, 105, 108, 101, 0)
        amovz(9, 119); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 104); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 105); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 108); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (5 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 6; i = i + 1
        // for\0 (102, 111, 114, 0)
        amovz(9, 102); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 111); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 114); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 4; i = i + 1
        // break\0 (98, 114, 101, 97, 107, 0)
        amovz(9, 98); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 114); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 97); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 107); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (5 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 6; i = i + 1
        // continue\0 (99, 111, 110, 116, 105, 110, 117, 101, 0)
        amovz(9, 99); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 111); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 110); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 116); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 105); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        amovz(9, 110); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (5 << 10))
        amovz(9, 117); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (6 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (7 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (8 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 9; i = i + 1
        // true\0 (116, 114, 117, 101, 0)
        amovz(9, 116); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 114); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 117); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 5; i = i + 1
        // false\0 (102, 97, 108, 115, 101, 0)
        amovz(9, 102); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 97); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 108); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 115); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (5 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 6; i = i + 1
        // none\0 (110, 111, 110, 101, 0)
        amovz(9, 110); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (0 << 10))
        amovz(9, 111); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (1 << 10))
        amovz(9, 110); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (2 << 10))
        amovz(9, 101); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (3 << 10))
        amovz(9, 0); arm_gptr(10, str_ptr); araw(0x39000000 | ((10 & 31) << 5) | (9 & 31) | (4 << 10))
        arm_gptr(9, str_ptr); arm_gptr(10, kt_base + i * 8); araw(0xF9000000 | ((10 & 31) << 5) | (9 & 31)); str_ptr = str_ptr + 5; i = i + 1
    }
    
    let ii=0
    while ii<irc {
        let op=irop(ii); let res=irres(ii); let a0=ira0(ii); let a1=ira1(ii); let a2=ira2(ii)
        if op==IR_CONST {
            let rd=aphys_a(res); if a0<0||a0>0xFFFFFFFF { amov_imm64(rd, a0) } else { amovz(rd, a0 & 0xFFFF); if (a0>>16)!=0 { amovk(rd, (a0>>16)&0xFFFF, 1) } }; asdef(res, rd)
        }
        else if op==IR_MOV { let rd=aphys_a(res); let rs=aphys_a(a0); if rd!=rs { araw(0xAA0003E0 | (rs<<16) | rd) }; asdef(res, rd) }
        else if op==IR_ADD { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; aadd(rd,rd,r2); asdef(res, rd) }
        else if op==IR_SUB { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; asub(rd,rd,r2); asdef(res, rd) }
        else if op==IR_MUL { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; amul(rd,rd,r2); asdef(res, rd) }
        else if op==IR_DIV { aflsuh_all(); aldr(0,31,ahome(a0)); aldr(1,31,ahome(a1)); asdiv(0,0,1); let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }; asdef(res, rd) }
        else if op==IR_MOD { aflsuh_all(); aldr(0,31,ahome(a0)); aldr(1,31,ahome(a1)); amod(0,0,1); let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }; asdef(res, rd) }
        else if op==IR_EQ { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); acmp(r1,r2); cset(rd,1); asdef(res, rd) }  // set on EQ -> field NE
        else if op==IR_NE { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); acmp(r1,r2); cset(rd,0); asdef(res, rd) }  // set on NE -> field EQ
        else if op==IR_LT { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); acmp(r1,r2); cset(rd,10); asdef(res, rd) }  // set on LT -> field GE
        else if op==IR_GT { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); acmp(r1,r2); cset(rd,13); asdef(res, rd) }  // set on GT -> field LE
        else if op==IR_LE { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); acmp(r1,r2); cset(rd,12); asdef(res, rd) }  // set on LE -> field GT
        else if op==IR_GE { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); acmp(r1,r2); cset(rd,11); asdef(res, rd) }  // set on GE -> field LT
        else if op==IR_NEG { let r1=aphys_a(a0); let rd=adistinct_a(res,r1,r1); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; aneg(rd,rd); asdef(res, rd) }
        else if op==IR_NOT { let r1=aphys_a(a0); let rd=adistinct_a(res,r1,r1); acmp_imm(r1,0); cset(rd,1) /* logical not: rd = (r1==0)?1:0 -> set on EQ -> field NE */; asdef(res, rd) }
        else if op==IR_AND { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; aand(rd,rd,r2); asdef(res, rd) }
        else if op==IR_OR { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; aorr(rd,rd,r2); asdef(res, rd) }
        else if op==IR_BAND { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; aand(rd,rd,r2); asdef(res, rd) }
        else if op==IR_BOR { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; aorr(rd,rd,r2); asdef(res, rd) }
        else if op==IR_BXOR { let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; aeor(rd,rd,r2); asdef(res, rd) }
        else if op==IR_BNOT { let r1=aphys_a(a0); let rd=adistinct_a(res,r1,r1); if rd!=r1 { araw(0xAA0003E0|(r1<<16)|rd) }; araw(0xAA2003E0|(r1<<16)|rd); asdef(res, rd) }
        else if op==IR_SHL { aflsuh_all(); aldr(0,31,ahome(a0)); aldr(1,31,ahome(a1)); alsl(0,0,1); let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }; asdef(res, rd) }
        else if op==IR_SHR { aflsuh_all(); aldr(0,31,ahome(a0)); aldr(1,31,ahome(a1)); alsr(0,0,1); let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }; asdef(res, rd) }
        else if op==IR_LOADG {
            let rd=aphys_a(res)
            if target_arch==1 { arm_gptr(10, GDATA_ARM + a0*8); aldr(rd, 10, 0) }
            else { amov_imm64(9, GDATA + a0*8); aldr(rd, 9, 0) }
            asdef(res, rd)
        }
        else if op==IR_STOREG {
            let rs=aphys_a(a0)
            if target_arch==1 { arm_gptr(10, GDATA_ARM + a1*8); astr(rs, 10, 0) }
            else { amov_imm64(9, GDATA + a1*8); astr(rs, 9, 0) }
        }
        else if op==32 {  // IR_IDX  base[idx]: struct field (qword stride idx*8) or string (byte stride idx*1)
            aflsuh_all()
            aldr(0, 31, ahome(a0))            // x0 = base ptr (reload from spill-home, SP-relative to match asdef/aflsuh_all)
            aldr(1, 31, ahome(a1))            // x1 = field/element idx
            let isstr = r64(vreg_is_str + a0*8)
            if isstr>=0 { aadd(1, 0, 1); aaddi(1, 1, 8) }   // byte stride: x1 = base + idx + 8 (skip header)
            else { amovz(9, 3); alsl(1, 1, 9); aadd(1, 0, 1); aaddi(1, 1, 8) }  // qword stride: x1 = base + idx*8 + 8
            let rd=aphys_a(res)
            if isstr>=0 { aldrb(rd, 1, 0) }   // x_rd = byte[x1]
            else { aldr(rd, 1, 0) }           // x_rd = [x1]
            asdef(res, rd)
        }
        else if op==IR_ISTORE {  // base[idx] = v
            aflsuh_all()
            aldr(0, 31, ahome(a0))            // x0 = base ptr
            aldr(1, 31, ahome(a1))            // x1 = field/element idx
            aldr(2, 31, ahome(a2))            // x2 = value
            let isstr2 = r64(vreg_is_str + a0*8)
            if isstr2>=0 { aadd(1, 0, 1); aaddi(1, 1, 8); astrb(2, 1, 0) }     // byte[x1+8] = x2
            else { amovz(9, 3); alsl(1, 1, 9); aadd(1, 0, 1); aaddi(1, 1, 8); astr(2, 1, 0) }  // [base+idx*8+8] = x2
        }
        else if op==IR_TALLOC {
            // ARM64 mmap: x0=hint(0x60000000), x1=len, x2=PROT_RW(3), x3=MAP_PRIV|ANON(0x22), x4=-1, x5=0, syscall 222.
            aflsuh_all(); amov_imm64(0, 0x60000000); amovz(1, a0*8+8); amovz(2,3); amovz(3,0x22); araw(0x92800004); amovz(5,0); amovz(8,222); asvc()
            let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }
            amovz(2, a0); astr(2, 0, 0); asdef(res, rd)
        }
        // P10: IR_ARRAY_LEN (op 69) — get array length from header [base]
        else if op==IR_ARRAY_LEN {
            aflsuh_all()
            aldr(0, 31, ahome(a0))   // x0 = base ptr
            araw(0xF9400000)          // ldr x0, [x0]  ; x0 = length header
            let rd=aphys_a(res)
            if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }  // x_rd = x0
            asdef(res, rd)
        }
        // P7: IR_SOME - Option::Some(payload) -> header layout [base]=len=2, [base+8]=tag=1, [base+16]=payload
        else if op==IR_SOME {
            aflsuh_all(); amov_imm64(0, 0x60000000); amovz(1, 24); amovz(2,3); amovz(3,0x22); araw(0x92800004); amovz(5,0); amovz(8,222); asvc()
            let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }
            amovz(2, 2); astr(2, 0, 0)   // [rd] = len header 2
            let sc=9; if sc==rd { sc=10 }; amovz(sc, 1); astr(sc, rd, 8)   // [rd+8] = tag 1
            let sc2=11; if sc2==rd { sc2=12 }; aldr(sc2, 31, ahome(a0)); astr(sc2, rd, 16)   // [rd+16] = payload
            asdef(res, rd)
        }
        // P7: IR_NONE - Option::None -> header layout [base]=len=1, [base+8]=tag=0
        else if op==IR_NONE {
            aflsuh_all(); amov_imm64(0, 0x60000000); amovz(1, 16); amovz(2,3); amovz(3,0x22); araw(0x92800004); amovz(5,0); amovz(8,222); asvc()
            let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }
            amovz(2, 1); astr(2, 0, 0)   // [rd] = len header 1
            let sc=9; if sc==rd { sc=10 }; amovz(sc, 0); astr(sc, rd, 8)   // [rd+8] = tag 0
            asdef(res, rd)
        }
        // P7: IR_OK - Result::Ok(payload) -> header layout [base]=len=2, [base+8]=tag=1, [base+16]=payload
        else if op==IR_OK {
            aflsuh_all(); amov_imm64(0, 0x60000000); amovz(1, 24); amovz(2,3); amovz(3,0x22); araw(0x92800004); amovz(5,0); amovz(8,222); asvc()
            let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }
            amovz(2, 2); astr(2, 0, 0)   // [rd] = len header 2
            let sc=9; if sc==rd { sc=10 }; amovz(sc, 1); astr(sc, rd, 8)   // [rd+8] = tag 1
            let sc2=11; if sc2==rd { sc2=12 }; aldr(sc2, 31, ahome(a0)); astr(sc2, rd, 16)   // [rd+16] = payload
            asdef(res, rd)
        }
        // P7: IR_ERR - Result::Err(payload) -> header layout [base]=len=2, [base+8]=tag=0, [base+16]=payload
        else if op==IR_ERR {
            aflsuh_all(); amov_imm64(0, 0x60000000); amovz(1, 24); amovz(2,3); amovz(3,0x22); araw(0x92800004); amovz(5,0); amovz(8,222); asvc()
            let rd=aphys_a(res); if rd!=0 { araw(0xAA0003E0|(0<<16)|rd) }
            amovz(2, 2); astr(2, 0, 0)   // [rd] = len header 2
            let sc=9; if sc==rd { sc=10 }; amovz(sc, 0); astr(sc, rd, 8)   // [rd+8] = tag 0
            let sc2=11; if sc2==rd { sc2=12 }; aldr(sc2, 31, ahome(a0)); astr(sc2, rd, 16)   // [rd+16] = payload
            asdef(res, rd)
        }
        // P7: IR_UNWRAP - extract payload; panic (exit 1) if tag==0
        else if op==IR_UNWRAP {
            aflsuh_all()
            let rs=aphys_a(a0)
            let rd=aphys_a(res)
            let sc=9
            if sc==rs || sc==rd { sc=10 }
            if sc==rs || sc==rd { sc=11 }
            if sc==rs || sc==rd { sc=12 }
            aldr(sc, rs, 8)                // sc = [rs+8] (tag)
            acmp_imm(sc, 0)                // cmp sc, 0
            let panic_lbl = nl()
            let po1=codelen; ab(0)         // b.eq placeholder
            w64(patches+patchc*PCS,po1); w64(patches+patchc*PCS+8,panic_lbl); w64(patches+patchc*PCS+16,1); patchc=patchc+1
            aldr(rd, rs, 16)               // rd = [rs+16] (payload)
            asdef(res, rd)
            let done_lbl = nl()
            let po2=codelen; ab(0)         // b placeholder
            w64(patches+patchc*PCS,po2); w64(patches+patchc*PCS+8,done_lbl); w64(patches+patchc*PCS+16,0); patchc=patchc+1
            lbladd(panic_lbl, codelen)
            amovz(0, 1); amovz(8, 93); asvc()   // exit(1): x0=1, x8=93 (exit), svc
            lbladd(done_lbl, codelen)
        }
        else if op==IR_PARAM {
            if a0<8 { let preg=0; if a0==0 { preg=0 } else if a0==1 { preg=1 } else if a0==2 { preg=2 } else if a0==3 { preg=3 } else if a0==4 { preg=4 } else if a0==5 { preg=5 } else if a0==6 { preg=6 } else { preg=7 }
                asdef(res, preg) }
            else { aldr(0, 29, 16 + (a0-8)*8); asdef(res, 0) }   // stack args live above stp x29,x30 frame: [x29+16+...]
        }
        else if op==IR_LABEL { aflsuh_all(); let lp=codelen; lbladd(a0, lp+4) }
        else if op==IR_JMP { aflsuh_all(); let po=codelen; araw(0x94000000); w64(patches+patchc*PCS,po); w64(patches+patchc*PCS+8,a0); w64(patches+patchc*PCS+16,0); patchc=patchc+1 }
        else if op==IR_BR {
            aflsuh_all(); let cv=aphys_a(a0); acmp_imm(cv,0)
            let po1=codelen; araw(0x94000000)
            w64(patches+patchc*PCS,po1); w64(patches+patchc*PCS+8,a1); w64(patches+patchc*PCS+16,1); patchc=patchc+1
        }
        else if op==IR_RET {
            aflsuh_all()
            if a0>=0 { let rv=aphys_a(a0); if rv!=0 { araw(0xAA0003E0|(rv<<16)|0) } }  // mov x0, rv
            // epilogue: mov sp, x29; ldp x29,x30,[sp],#16; ret
            araw(0x910003BF)            // mov sp, x29  (add sp, x29, #0)
            araw(0xA8C17BFD)            // ldp x29,x30,[sp],#16
            aret()
        }
        else if op==IR_CALL {
            aflsuh_all()
            let arg_start=a2; let arg_cnt=a1
            // args 8+ go on the stack (AAPCS64): carve a 16-byte-aligned block
            // below sp and store them at [sp+0], [sp+8], ... The callee reads
            // them at [x29+16+...] after its own stp-frame. NOTE: vreg homes are
            // sp-relative, so loads after the sp move must add the block size.
            let nstack=0
            if arg_cnt>8 { nstack=arg_cnt-8 }
            let blk=0
            if nstack>0 {
                blk=nstack*8; let brem=blk%16; if brem>0 { blk=blk+(16-brem) }
                amov_imm64(9, blk); araw(0xCB2963FF)   // sub sp, sp, x9
                let sj=0
                while sj<nstack {
                    let sav=irres(arg_start+8+sj)
                    if (arg_start+8+sj)<irc { aldr(10, 31, ahome(sav)+blk); astr(10, 31, sj*8) }
                    sj=sj+1
                }
            }
            // load args a0..a7 from homes into x0..x7 (offsets shifted by blk)
            let nm=a0; let nl=0
            while nl<256 { let c0=r8(src+nm+nl); if c0==0||c0==40||c0==59||c0==123||c0==125||c0==44 { break }; if c0==32||c0==9||c0==10||c0==13 { break }; nl=nl+1 }
            
            // compute name length
            let ai2=0
            while ai2<arg_cnt { if ai2<8 { let av=irres(arg_start+ai2); if (arg_start+ai2)<irc { aldr(ai2, 31, ahome(av)+blk) } }; ai2=ai2+1 }if arm_emit_bltn(nm,nl)==0 {
                let call_ofs=codelen; ab(0)
                w64(patches+patchc*PCS,call_ofs); w64(patches+patchc*PCS+8,nm); w64(patches+patchc*PCS+16,2); patchc=patchc+1
            }
            if nstack>0 { amov_imm64(9, blk); araw(0x8B2963FF) }   // add sp, sp, x9 (restore)
            let rres=aphys_a(res); if rres!=0 { araw(0xAA0003E0|(0<<16)|rres) }; asdef(res, rres)
        }
        else if op==IR_FNPTR {
            // ARM64 fnptr(FNAME): load the function's code pointer via PC-relative
            // adrp rd,#0 / add rd,rd,#0 (placeholders). The sites are recorded in
            // fnptr_patches and resolved at finalize (exec mode, PC-relative) or as
            // R_AARCH64_ADR_PREL_PG_HI21 + R_AARCH64_ADD_ABS_LO12_NC relocs (object mode).
            let fi=a0
            let rd=aphys_a(res)
            let adrp_ofs=codelen
            araw(0x90000000 | (rd & 31))                 // adrp rd, #0  (placeholder)
            let add_ofs=codelen
            araw(0x91000000 | ((rd & 31) << 5) | (rd & 31))  // add rd, rd, #0  (placeholder)
            w64(fnptr_patches + fnptr_patchc*32 + 0, adrp_ofs)
            w64(fnptr_patches + fnptr_patchc*32 + 8, add_ofs)
            w64(fnptr_patches + fnptr_patchc*32 + 16, fi)
            w64(fnptr_patches + fnptr_patchc*32 + 24, 0)
            fnptr_patchc = fnptr_patchc + 1
            asdef(res, rd)
        }
        else if op==IR_CLOSURE_CALL {
            // ARM64 closure_call(fnb, args...): fnb is a mk_any tuple (codeptr, env).
            // FIX: callee uses standard AAPCS, so caller args go in x0..x5. Env goes
            // to x10 (scratch, callee ignores). Result returns in x0.
            let fnb=a0; let avs2=a1; let nargc=a2
            if nargc>5 { compile_error(2, cur_fnname, cur_fnnlen) }
            aflsuh_all()
            aldr(0, 31, ahome(fnb))          // x0 = fnb tuple ptr
            aldr(9, 0, 0)                    // x9 = codeptr = [x0]
            aldr(10, 0, 8)                   // x10 = env = [x0, #8]
            let j=0
            while j<nargc {
                let av=irres(avs2+j)
                let hm=ahome(av)
                if j==0 { aldr(0, 31, hm) }
                if j==1 { aldr(1, 31, hm) }
                if j==2 { aldr(2, 31, hm) }
                if j==3 { aldr(3, 31, hm) }
                if j==4 { aldr(4, 31, hm) }
                if j==5 { aldr(5, 31, hm) }
                j=j+1
            }
            araw(0xD63F0000 | (9 << 5))      // blr x9
            let rres=aphys_a(res); if rres!=0 { araw(0xAA0003E0|(0<<16)|rres) }; asdef(res, rres)
        }
        else if op==IR_FREE {
            aflsuh_all(); aldr(0,31,ahome(irres(a0))); aldr(1,0,0); amovz(8,215); asvc()
        }
        else if op==IR_DEREF {  // P6: *p - raw pointer dereference (load)
            aflsuh_all()
            let rd=aphys_a(res)
            let rs=aphys_a(a0)
            aldr(rd, rs, 0)
            asdef(res, rd)
        }
        else if op==IR_DEREF_MUT {  // P6: *p = v (store through raw pointer)
            aflsuh_all()
            let rs=aphys_a(a0)   // pointer
            let rv=aphys_a(a1)   // value
            astr(rv, rs, 0)
        }
        else if op==IR_PTR_ADD {  // P6: p + n (element-sized)
            let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2)
            if rd!=r1 { amovr(rd, r1) }
            if r2!=0 { alsl(r2, r2, 3) }
            aadd(rd, rd, r2)
            asdef(res, rd)
        }
        else if op==IR_PTR_SUB {  // P6: p - n (element-sized)
            let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2)
            if rd!=r1 { amovr(rd, r1) }
            if r2!=0 { alsl(r2, r2, 3) }
            asub(rd, rd, r2)
            asdef(res, rd)
        }
        else if op==IR_PTR_DIFF {  // P6: p - q (elements)
            let r1=aphys_a(a0); let r2=aphys_a(a1); let rd=adistinct_a(res,r1,r2)
            if rd!=r1 { amovr(rd, r1) }
            asub(rd, r1, r2)
            alsr(rd, rd, 3)
            asdef(res, rd)
        }
        else if op==IR_PTR_CAST {  // P6: &p or cast to raw pointer
            let rd=aphys_a(res)
            let rs=aphys_a(a0)
            if rd!=rs { araw(0xAA0003E0 | (rs << 16) | rd) }
            asdef(res, rd)
        }
        else if op==IR_IS_NULL {  // P6: p == 0
            let r1=aphys_a(a0); let rd=aphys_a(res)
            araw(0xF100001F | ((r1 & 31) << 5))
            araw(0x9A9F17E0 | (rd & 31))
            asdef(res, rd)
        }
        else if op==IR_VOLATILE_LOAD {  // P6: volatile load
            aflsuh_all()
            let rd=aphys_a(res)
            let rs=aphys_a(a0)
            aldr(rd, rs, 0)
            asdef(res, rd)
        }
        else if op==IR_VOLATILE_STORE {  // P6: volatile store
            aflsuh_all()
            let rs=aphys_a(a0)
            let rt=aphys_a(a1)
            astr(rt, rs, 0)
        }
        else if op==IR_FFI_CALL {  // P6: FFI call - AAPCS64
            aflsuh_all()
            let fn_ptr = aphys_a(a0)
            let args_ptr = aphys_a(a2)
            let arg0 = nv(); let arg1 = nv(); let arg2 = nv()
            let arg3 = nv(); let arg4 = nv(); let arg5 = nv()
            let arg6 = nv(); let arg7 = nv()
            aldr(arg0, aphys_a(a2), 0)
            aldr(arg1, aphys_a(a2), 8)
            aldr(arg2, aphys_a(a2), 16)
            aldr(arg3, aphys_a(a2), 24)
            aldr(arg4, aphys_a(a2), 32)
            aldr(arg5, aphys_a(a2), 40)
            aldr(arg6, aphys_a(a2), 48)
            aldr(arg7, aphys_a(a2), 56)
            if arg0 != 0 { araw(0xAA0003E0 | (arg0 << 16) | 0) }
            if arg1 != 0 { araw(0xAA0003E0 | (arg1 << 16) | 1) }
            if arg2 != 0 { araw(0xAA0003E0 | (arg2 << 16) | 2) }
            if arg3 != 0 { araw(0xAA0003E0 | (arg3 << 16) | 3) }
            if arg4 != 0 { araw(0xAA0003E0 | (arg4 << 16) | 4) }
            if arg5 != 0 { araw(0xAA0003E0 | (arg5 << 16) | 5) }
            if arg6 != 0 { araw(0xAA0003E0 | (arg6 << 16) | 6) }
            if arg7 != 0 { araw(0xAA0003E0 | (arg7 << 16) | 7) }
            let fn_ptr2 = aphys_a(a0)
            if fn_ptr2 != 0 { araw(0xAA0003E0 | (fn_ptr2 << 16) | 16) }
            araw(0xD63F0100)  // blr x16
            let rd = aphys_a(res)
            if rd != 0 { araw(0xAA0003E0 | (0 << 16) | rd) }
            asdef(res, rd)
        }
        else if op==IR_VEC128 {  // P6: SIMD vec128 (placeholder)
            aflsuh_all()
            araw(0xD503201F)  // nop
            let rd=aphys_a(res)
            rxor(rd, rd)
            sdef(res, rd)
        }
        else if op==IR_UNSAFE_BLOCK {  // P6: unsafe block marker (no-op at runtime)
        }
        else if op==IR_ASM {  // P6: inline assembly (placeholder)
            aflsuh_all()
            araw(0xD503201F)  // nop
            let rd=aphys_a(res)
            rxor(rd,rd)
            sdef(res, rd)
        }
        else if op==IR_STR {
            let sp2=a0+1; let ln=0; let scp=sp2
            while scp<srclen&&r8(src+scp)!=34 { ln=ln+1; if r8(src+scp)==92&&scp+1<srclen { scp=scp+2 } else { scp=scp+1 } }
            let gdata_size=(INTERNAL_GLOBAL_COUNT+gvarc)*8
            let str_addr=GDATA_ARM+gdata_size+data_off
            let rd=aphys_a(res)
            if target_arch==1 { arm_gptr(rd, str_addr) } else { amov_imm64(rd, str_addr) }
            if data!=0 { let ci=0; let si=sp2
                while ci<ln { let sv=r8(src+si); if sv==92&&si+1<srclen { let nx=r8(src+si+1); if nx==110 { sv=10 } else if nx==116 { sv=9 } else if nx==114 { sv=13 } else if nx==48 { sv=0 } else if nx==92 { sv=92 } else if nx==34 { sv=34 } else if nx==39 { sv=39 } else { sv=nx }; si=si+2 } else { si=si+1 }
                    w8(data+data_off+8+ci, sv); ci=ci+1 }
                w64(data+data_off, ln); w8(data+data_off+8+ln, 0)
                let bsz=8+ln+1; let pad=bsz%16; if pad>0 { bsz=bsz+(16-pad) }; data_off=data_off+bsz }
            asdef(res, rd)
        }
        ii=ii+1
    }
    // resolve label jumps (ty 0 = jmp, ty 1 = br) with ARM bl-range patch
    let pk=pstart
    let arm_cond_for_br = 0  // EQ for b.eq (branch if zero)
    while pk<patchc {
        let pty=r64(patches+pk*PCS+16)
        if pty==0 { let ppo=r64(patches+pk*PCS); let plbl=lblf(r64(patches+pk*PCS+8)); if plbl>=0 { let disp=(plbl-(ppo+4))/4; if disp<0 { disp=disp+0x4000000 }; w32(code+ppo, 0x14000000 | (disp & 0x3FFFFFF)) } }
        else if pty==1 { let ppo=r64(patches+pk*PCS); let plbl=lblf(r64(patches+pk*PCS+8)); if plbl>=0 { let disp=(plbl-(ppo+4))/4; if disp<0 { disp=disp+0x80000 }; w32(code+ppo, 0x54000000 | (0 & 0x1F) | ((disp & 0x7FFFF) << 5)) } }
        pk=pk+1
    }
    // epilogue fallback (should not reach for normal returns)
    araw(0x9100003F); araw(0xA8C17BFD); aret()
}

fn cset(rd, arm_field) {
    // cset rd, <cond>: csinc rd, xzr, xzr, INVERTED(cond).
    // CSINC rd,xzr,xzr,<F> yields rd=1 when <F> is FALSE — so to set rd=1 on
    // condition C, the CSINC field must be the inverse of C. Verified against
    // GNU as: cset x3,lt = 9a9fa7e3 (field GE), cset x3,ge = 9a9fb7e3 (field LT),
    // cset x3,eq = 9a9f17e3 (field NE), cset x3,ne = 9a9f07e3 (field EQ).
    // Callers pass the INVERTED ARM field: EQ->NE(1), NE->EQ(0), LT->GE(10),
    // GT->LE(13), LE->GT(12), GE->LT(11); unsigned lo->HS(2), hi->LS(9),
    // ls->HI(8), hs->LO(3).
    araw(0x9A800400 | (31 << 16) | (31 << 5) | ((arm_field & 15) << 12) | rd)
}

// === ELF WRITER ===
let BASE = 4194304

fn write_elf(outp) {
    let hsz=64; let phsz=56; let phc=4
    // ARM64 static PIE needs 2 extra PHDRs (PT_DYNAMIC + SHT page LOAD) → 6 total.
    if target_arch==1 { phc=6 }
    let ht=hsz+phsz*phc
    let tsz=ht+codelen; let pg=4096; let tp=tsz+data_off
    // Both x86-64 and ARM64: gdata LOAD requires p_offset ≡ p_vaddr (mod pagesize).
    // GDATA/GDATA_ARM are page-aligned, so tp must be too — a misaligned offset makes
    // the loader reject/fault the RW segment (x86) or skew gdata content (ARM bionic).
    { let trm=tp%pg; if trm>0 { tp=tp+(pg-trm) } }
    // Size of the global data segment (bss), page aligned. Include internal globals
    // so the compiler's own globals are mapped in the output binary.
    let gsz=(gvarc+INTERNAL_GLOBAL_COUNT)*8 + data_off; let grm=gsz%pg; if grm>0 { gsz=gsz+(pg-grm) }
    if gsz<pg { gsz=pg }
    if gsz<pg { gsz=pg }
    // ARM64 static PIE: reserve a dynamic tail in the gdata region for bionic:
    // .dynamic(144) + .dynstr(1) + .dynsym(24) + .gnu.hash(32) + .hash(16) = 217 -> 224.
    let gsz_arm = gsz
    if target_arch==1 { gsz_arm = gsz + 256 }   // gdata + dynamic tail (96+144=240, round to 256)
    // ARM64 static PIE: section-header table must be page-aligned (bionic requires
    // e_shoff page-aligned). Compute its file offset up-front so PH5 (the SHT LOAD)
    // and the SHT writing block share the same value.
    let sh_page_aligned = tp + gsz_arm
    if target_arch==1 {
        let rem = (tp + gsz_arm) % pg
        sh_page_aligned = (tp + gsz_arm) + (pg - rem)
        if rem == 0 { sh_page_aligned = (tp + gsz_arm) + pg }
    }
    let shoff = sh_page_aligned
    let shstr_off = shoff + 192     // 3 * 64-byte section headers precede the string table
    let dynname_off = 1
    let shstrname_off = 10
    // Total file buffer size: code+gdata+dynamic tail, plus (ARM) the page-aligned
    // section-header table (one page) and .shstrtab. Must size the mmap before writing SHT.
    let bufsz = tp + gsz_arm
    if target_arch==1 {
        let spa = (tp + gsz_arm) + (pg - ((tp + gsz_arm) % pg))
        if spa == (tp + gsz_arm) { spa = (tp + gsz_arm) + pg }
        bufsz = spa + pg + 64
    }
    let elfb=mmap(bufsz)
    // Zero the ELF buffer (mmap may return uninitialized memory; BSS region and
    // section headers must start zeroed, or stale bytes cause loader/host errors).
    let zi0=0; while zi0<bufsz { w8(elfb+zi0, 0); zi0=zi0+1 }

    // ELF header
    w8(elfb,127); w8(elfb+1,69); w8(elfb+2,76); w8(elfb+3,70)
    w8(elfb+4,2); w8(elfb+5,1); w8(elfb+6,1)
    let i2=7; while i2<16 { w8(elfb+i2,0); i2=i2+1 }
    // e_type: ARM64 output must be ET_DYN (3) so Android's loader accepts it
    // (Android rejects ET_EXEC since 5.0). x86-64 stays ET_EXEC (2) on Linux.
    if target_arch==1 { w16(elfb+16,3) } else { w16(elfb+16,2) }   // e_type
    if target_arch==1 { w16(elfb+18,183) } else { w16(elfb+18,62) }; w32(elfb+20,1)
    w64(elfb+24,BASE+ht)
    w64(elfb+32,64); w64(elfb+40,0); w64(elfb+48,0)
    w16(elfb+52,hsz); w16(elfb+54,phsz); w16(elfb+56,phc)
    // Stripped binary (no sections). bionic needs e_shentsize=0x40 (it validates
    // the field) but e_shnum=0 and e_shstrndx=SHN_UNDEF(0) so it's a valid empty table.
    w16(elfb+58,64); w16(elfb+60,0); w16(elfb+62,0)

    // PH 0: PT_PHDR — must precede PT_LOAD and be covered by the first LOAD.
    // (bionic requires this; absence → loader maps segments wrong → SIGILL)
    let pho=hsz
    w64(elfb+pho,6); w64(elfb+pho+4,4)            // type=PT_PHDR, flags=R
    w64(elfb+pho+8,hsz); w64(elfb+pho+16,BASE+hsz) // offset=64 (PHDR table start), vaddr
    w64(elfb+pho+24,BASE+hsz); w64(elfb+pho+32,phsz*phc)
    w64(elfb+pho+40,phsz*phc); w64(elfb+pho+48,pg)

    // PH 1: LOAD R|X (code) — covers ELF header + PHDRs + code (filesz=tp)
    let phco=pho+phsz
    w64(elfb+phco,1); w64(elfb+phco+4,5)           // type=PT_LOAD, flags=R|X
    w64(elfb+phco+8,0); w64(elfb+phco+16,BASE)
    w64(elfb+phco+24,BASE); w64(elfb+phco+32,tp)
    w64(elfb+phco+40,tp); w64(elfb+phco+48,pg)

    // PH 2: LOAD R|W (global data + string literals)
    let src_globals = gvarc
    if src_globals > INTERNAL_GLOBAL_COUNT { src_globals = src_globals - INTERNAL_GLOBAL_COUNT }
    let src_data_off = data_off  // string literals from source program
    let gdata_size = (INTERNAL_GLOBAL_COUNT + gvarc)*8
    // memsz must cover globals + literals (>= filesz). Do NOT clobber the page-aligned
    // gsz used for the dynamic-table math — use a separate name.
    let gdata_memsz = gdata_size + src_data_off
    if gdata_memsz < gsz { gdata_memsz = gsz }
    // ARM64 static PIE: memsz must also include the dynamic tail (so filesz <= memsz).
    if target_arch==1 { gdata_memsz = gsz_arm }
    let phdo=phco+phsz
    // gdata (BSS) segment vaddr: ARM64 uses the PIC link-time base GDATA_ARM so
    // arm_gptr()'s adrp math matches; x86-64 uses absolute GDATA.
    let gdata_vaddr = GDATA
    if target_arch==1 { gdata_vaddr = GDATA_ARM }
    // filesz includes the dynamic table tail for ARM (so PT_DYNAMIC maps correctly).
    let gdata_filesz = gdata_size + src_data_off
    if target_arch==1 { gdata_filesz = gsz_arm }
    w64(elfb+phdo,1); w64(elfb+phdo+4,6)           // type=PT_LOAD, flags=R|W
    w64(elfb+phdo+8,tp); w64(elfb+phdo+16,gdata_vaddr)
    w64(elfb+phdo+24,gdata_vaddr); w64(elfb+phdo+32,gdata_filesz)
    w64(elfb+phdo+40,gdata_memsz); w64(elfb+phdo+48,pg)

    // PH 3: GNU_STACK R|W (type 0x6474e551)
    let ph2o=phdo+phsz
    w64(elfb+ph2o,0x6474e551); w64(elfb+ph2o+4,6)
    w64(elfb+ph2o+8,0); w64(elfb+ph2o+16,BASE+tp)
    w64(elfb+ph2o+24,BASE+tp); w64(elfb+ph2o+32,0)
    w64(elfb+ph2o+40,pg); w64(elfb+ph2o+48,pg)

    // PH 4 (ARM64 only): PT_DYNAMIC — required by bionic for a static PIE.
    // The dynamic tables (non-overlapping) live in the gdata region tail:
    //   .hash     @ gsz+0   (16 bytes)
    //   .gnu.hash @ gsz+16  (32 bytes)
    //   .dynsym   @ gsz+48  (24 bytes, one null symbol)
    //   .dynstr   @ gsz+72  (1 byte: "\0")
    //   .dynamic  @ gsz+96  (144 bytes, 9 entries)
    if target_arch==1 {
        let phd4o=ph2o+phsz
        w64(elfb+phd4o,2); w64(elfb+phd4o+4,6)   // type=PT_DYNAMIC, flags=R|W
        w64(elfb+phd4o+8,tp+gsz+96)              // offset of .dynamic array
        w64(elfb+phd4o+16,gdata_vaddr+gsz+96)    // vaddr
        w64(elfb+phd4o+24,gdata_vaddr+gsz+96); w64(elfb+phd4o+32,144)  // filesz=9*16
        w64(elfb+phd4o+40,144); w64(elfb+phd4o+48,16)               // memsz=144, align=16
        // .dynamic entries (tag at +0, val at +8), each 16 bytes. DT values are VADDRS.
        w64(elfb+tp+gsz+96,  4); w64(elfb+tp+gsz+104, gdata_vaddr+gsz)          // DT_HASH     -> .hash @gsz+0
        w64(elfb+tp+gsz+112, 0x6ffffef5); w64(elfb+tp+gsz+120, gdata_vaddr+gsz+16) // DT_GNU_HASH -> .gnu.hash @gsz+16
        w64(elfb+tp+gsz+128, 5); w64(elfb+tp+gsz+136, gdata_vaddr+gsz+72)       // DT_STRTAB   -> .dynstr @gsz+72
        w64(elfb+tp+gsz+144, 6); w64(elfb+tp+gsz+152, gdata_vaddr+gsz+48)       // DT_SYMTAB   -> .dynsym @gsz+48
        w64(elfb+tp+gsz+160, 0x0a); w64(elfb+tp+gsz+168, 1)       // DT_STRSZ    = 1
        w64(elfb+tp+gsz+176, 0x0b); w64(elfb+tp+gsz+184, 24)      // DT_SYMENT   = 24
        w64(elfb+tp+gsz+192, 0x15); w64(elfb+tp+gsz+200, 0)       // DT_DEBUG    = 0
        w64(elfb+tp+gsz+208,0x6ffffffb); w64(elfb+tp+gsz+216,0x1) // DT_FLAGS_1 = PIE
        w64(elfb+tp+gsz+224,0); w64(elfb+tp+gsz+232, 0)           // DT_NULL
        // .dynstr @gsz+72 (1 byte "\0"); .dynsym @gsz+48 (24 zero bytes) — buffer pre-zeroed.
        // .gnu.hash @gsz+16 (32 bytes): nbuckets=1, symoffset=1, bloom_size=1, bloom_shift=0,
        //   bloom[0]=0, buckets[0]=0, chain[0]=0  (matches real static-PIE layout)
        w32(elfb+tp+gsz+16,1); w32(elfb+tp+gsz+20,1); w32(elfb+tp+gsz+24,1); w32(elfb+tp+gsz+28,0)
        // remaining 16 bytes stay zero (bloom[0]=0, buckets[0]=0, chain[0]=0)
        // .hash @gsz+0 (16 bytes): nbucket=1, nchain=1, buckets[0]=0, chain[0]=0
        w32(elfb+tp+gsz,1); w32(elfb+tp+gsz+4,1)
        // PH 5: PT_LOAD for the page-aligned section-header table (bionic needs e_shoff page-aligned).
        w64(elfb+phd4o+phsz,1); w64(elfb+phd4o+phsz+4,6)        // type=PT_LOAD, flags=R|W
        w64(elfb+phd4o+phsz+8,sh_page_aligned)                  // offset
        w64(elfb+phd4o+phsz+16,gdata_vaddr+sh_page_aligned-tp)  // vaddr (relative to gdata base)
        w64(elfb+phd4o+phsz+24,gdata_vaddr+sh_page_aligned-tp); w64(elfb+phd4o+phsz+32, shstr_off+20 - sh_page_aligned)
        w64(elfb+phd4o+phsz+40, pg); w64(elfb+phd4o+phsz+48,pg)
    }

    // Copy code
    let dst=elfb+ht
    let i3=0
    while i3<codelen { w8(dst+i3,r8(code+i3)); i3=i3+1 }
    while i3<tp-ht { w8(dst+i3,0); i3=i3+1 }

    // Copy data section (string literals from source program only)
    let src_globals = gvarc
    if src_globals > INTERNAL_GLOBAL_COUNT { src_globals = src_globals - INTERNAL_GLOBAL_COUNT }
    let src_data_off = data_off
    // String literals live AFTER all global slots in the data segment.
    let gdata_size = (INTERNAL_GLOBAL_COUNT + gvarc)*8
    let dstd=elfb+tp+gdata_size
    let i4=0
    while i4<src_data_off { w8(dstd+i4,r8(data+i4)); i4=i4+1 }

    // ARM64: emit a minimal section-header table so bionic's loader accepts the
    // binary (it rejects e_shstrndx unless a valid SHT with a section name string
    // table is present). x86-64 path is left as a stripped binary (glibc tolerates it).
    let elf_total = tp + gsz
    if target_arch==1 {
        elf_total = shstr_off + 20      // extend file to cover SHT+shstrtab (no shadowing)
        // section 1: .dynamic  (array lives at gsz+96 in the gdata region)
        let s1 = elfb + shoff + 64
        w32(s1+0, dynname_off)          // sh_name = 1 (".dynamic")
        w32(s1+4, 6)                    // sh_type = SHT_DYNAMIC
        w32(s1+8, 0)                    // sh_flags = 0
        w32(s1+40, 2)                   // sh_link = 2 (.shstrtab) — required by bionic
        w64(s1+16, gdata_vaddr+gsz+96)  // sh_addr  = dynamic array vaddr
        w64(s1+24, tp+gsz+96)           // sh_offset = dynamic array file offset
        w64(s1+32, 144)                 // sh_size = 9 * 16
        w64(s1+48, 16)                  // sh_addralign = 16
        // section 2: .shstrtab
        let s2 = elfb + shoff + 128
        w32(s2+0, shstrname_off)        // sh_name = 10 (".shstrtab")
        w32(s2+4, 3)                    // sh_type = SHT_STRTAB
        w64(s2+16, 0)                   // sh_addr = 0
        w64(s2+24, shstr_off)           // sh_offset
        w64(s2+32, 20)                  // sh_size
        w64(s2+48, 1)                   // sh_addralign = 1
        // write the shstrtab string content
        w8(elfb+shstr_off, 0)
        let dn=".dynamic"
        let di=0; while di<7 { w8(elfb+shstr_off+1+di, r8(dn+di)); di=di+1 }
        w8(elfb+shstr_off+8, 0)
        let sn=".shstrtab"
        let si=0; while si<9 { w8(elfb+shstr_off+10+si, r8(sn+si)); si=si+1 }
        w8(elfb+shstr_off+19, 0)
        // ELF header section fields
        w64(elfb+40, shoff)             // e_shoff
        w16(elfb+60, 3)                 // e_shnum = 3
        w16(elfb+62, 2)                 // e_shstrndx = 2
    }

    // Write file
    let ofd=1
    // Hardcode output filename "out.exe" as bytes
    let outbuf=mmap(16)
    w8(outbuf,111); w8(outbuf+1,117); w8(outbuf+2,116); w8(outbuf+3,46)
    w8(outbuf+4,101); w8(outbuf+5,120); w8(outbuf+6,101); w8(outbuf+7,0)

    if outp==0 { ofd=file_open(outbuf,577,493) } else { ofd=file_open(outp,577,493) }
    if ofd>=0 { file_write(ofd,elfb,elf_total); file_close(ofd) }
}

// === PATCH CODE ===
fn patch_it() {
    let i=0
    while i<patchc {
        let po=r64(patches+i*PCS); let tg=r64(patches+i*PCS+8); let ty=r64(patches+i*PCS+16)
        let tofs=0
        if ty==0 || ty==1 {
            tofs=lblf(tg)
        } else if ty==2 || ty==3 {
            // tg is a source index to the function name (ty==2) or a fn
            // index (ty==3). Resolve the function's code start.
            let fi=-1
            if ty==2 {
                let tg_nl=0
                while tg_nl<256 {
                    let c0=r8(src+tg+tg_nl)
                    if c0==0||c0==40||c0==59||c0==123||c0==125||c0==44 { break }
                    if c0==32||c0==9||c0==10||c0==13 { break }
                    tg_nl=tg_nl+1
                }
                fi=findfn(tg,tg_nl)
            } else { fi=tg }   // ty==3: tg is already the fn index
            if fi>=0 { tofs=r64(func_code_starts+(fi+1)*8) }
        }
        else if ty==3 {
            // (handled above: cof already resolved into tofs)
        }
        let ilen=5; if ty==1 { ilen=6 }
        let rel=tofs-(po+ilen)
        if ty==0||ty==2 {
            w8(code+po,233)
            w32(code+po+1,rel)
        } else if ty==1 {
            w8(code+po,15); w8(code+po+1,132)
            w32(code+po+2,rel)
        }
        i=i+1
    }
}

// Patch global RIP-relative displacements
fn patch_globals() {
    let i=0
    while i<gpatchc {
        let gp = r64(gpatches+i*24)
        let gidx = r64(gpatches+i*24+8)
        let is_store = r8(gpatches+i*24+16)
        if emit_obj == 1 {
            // OBJECT mode: emit an R_X86_64_PC32 relocation against _gdata so the
            // external linker binds the global to wherever it places .data. The
            // disp32 field is left as whatever it is (don't-care) — the linker
            // overwrites it. r_offset = gp (the 4-byte disp field). addend = gidx*8-4
            // (RIP points 4 bytes past the disp field, so S+A-P yields the right disp).
            w64(reldyn + relc*24 + 0, gp)
            w64(reldyn + relc*24 + 8, (gdata_sym<<32) | 2)   // r_info = (sym<<32)|R_X86_64_PC32
            w32(reldyn + relc*24 + 16, gidx*8 - 4)   // r_addend low  = gidx*8 - 4
            w32(reldyn + relc*24 + 20, 0xFFFFFFFF)   // r_addend high = 0 (unsigned)
            relc = relc+1
            i=i+1
            continue
        }
        // Uniform global addressing: every global (internal + source) lives in the
        // single data segment at GDATA; index directly. Patched to RIP-relative disp.
        let gaddr = GDATA + gidx*8
        // Code is loaded at vaddr (BASE + ht) where ht = ELF header + phdr
        // size = 64 + 56*3 = 232, matching write_elf's p_vaddr=BASE,
        // file offset 0, code copied to elfb+ht.  A code byte at buffer
        // offset gp therefore executes at vaddr (BASE + 232 + gp).
        // gp points at the 4-byte disp (byte 3 of the 7-byte
        // REX.W 8B mod=00 disp32 instruction), so the instruction end is
        // at (BASE + 232 + gp + 4).  The RIP-relative disp is measured
        // from there, matching the Python oracle (rip = base + patch_ofs + 4).
        let rip = BASE + 232 + gp + 4
        let disp = gaddr - rip
        w32(code+gp, disp)
        i=i+1
    }
}



// === P5: object-format (.o) emission (corrected) ===
// When emit_obj==1, finalize() calls p5_elf_obj instead of write_elf: it emits
// a relocatable ET_REL .o with .text / .rela.text / .symtab / .strtab /
// .shstrtab + section headers, leaving call targets as RELA relocations.
// Relocation: x86-64 uses R_X86_64_PLT32 (type 4, addend -4); AArch64 uses
// R_AARCH64_CALL26 (type 0x11b, addend 0). e_machine mirrors target_arch.
// An external `ld`/`gcc` links the .o (see rebuild.sh). x86-64 + ARM64 both
// supported.

// add a symbol whose name lives at src+nm for nl bytes. returns symbol index.
fn p5_add_symbol_b(nm, nl) {
    let idx = symc
    w32(symtab + idx*24 + 0, strtablen)        // st_name -> .strtab offset
    let j=0
    while j<nl { w8(strtab + strtablen + j, r8(src+nm+j)); j=j+1 }
    w8(strtab + strtablen + nl, 0); strtablen = strtablen + nl + 1
    symc = symc+1
    return idx
}
// add a symbol whose name is a literal string header at sptr (sptr+8, NUL-term).
fn p5_add_symbol_l(sptr) {
    let nlen = 0
    while r8(sptr+8+nlen) != 0 { nlen = nlen+1 }
    return p5_add_symbol_b(sptr+8, nlen)
}
// find an existing symbol by src name, else add it as UNDEFINED (st_shndx=0).
fn p5_sym_for_name(tg, nl) {
    let k=0
    while k<symc {
        let soff = r32(symtab + k*24 + 0)
        let ok=1; let m=0
        while m<nl { if r8(strtab+soff+m) != r8(src+tg+m) { ok=0; break }; m=m+1 }
        if ok==1 && r8(strtab+soff+nl)==0 { return k }
        k=k+1
    }
    let idx = p5_add_symbol_b(tg, nl)
    w16(symtab + idx*24 + 6, 0)        // st_shndx = SHN_UNDEF
    w8(symtab + idx*24 + 4, 0x10)      // STT_FUNC|STB_GLOBAL
    return idx
}
// append a RELA relocation for a call site.
// x86-64: R_X86_64_PLT32 (type 4) at r_offset = po+1 (rel32 field), r_addend = -4.
//   (GCC emits PLT32, not PC32, for call sites; PC32 triggers "relocation
//   truncated to fit" under PIE.)
// AArch64: R_AARCH64_CALL26 (type 0x11b=283) at r_offset = po (whole 4-byte
//   `bl` instruction), r_addend = 0. The linker computes imm26 = (S+A-P)>>2.
// po = call instruction start (recorded before the bl/call placeholder).
fn p5_add_reloc(po, symidx) {
    if target_arch == 1 {
        w64(reldyn + relc*24 + 0, po)                 // r_offset = bl instruction start
        w64(reldyn + relc*24 + 8, (symidx<<32) | 0x11b)  // r_info = (symidx<<32)|R_AARCH64_CALL26
        w32(reldyn + relc*24 + 16, 0)                 // r_addend = 0
        w32(reldyn + relc*24 + 20, 0)
    } else {
        w64(reldyn + relc*24 + 0, po+1)               // r_offset = rel32 field
        // R_X86_64_PLT32 (type 4)
        w64(reldyn + relc*24 + 8, (symidx<<32) | 4)   // r_info = (symidx<<32)|R_X86_64_PLT32
        // r_addend = -4. Quanta truncates 64-bit literals to 32 bits, so write the
        // two 32-bit halves explicitly: -4 = 0xFFFFFFFFFFFFFFFC
        w32(reldyn + relc*24 + 16, 0xFFFFFFFC)        // r_addend low  = 0xFFFFFFFC
        w32(reldyn + relc*24 + 20, 0xFFFFFFFF)        // r_addend high = 0xFFFFFFFF (-4)
    }
    relc = relc+1
}
// x86-64 fnptr lea relocation: R_X86_64_PC32 (type 2) at r_offset = po+3 (the
// disp32 field of `lea rax,[rip+disp32]`), addend = -4. At runtime lea computes
// rip(po+7) + disp; linker sets disp = S + A - P with P = po+3, so the result is
// (po+7) + (S - 4 - (po+3)) = S. (PLT32 with r_offset=po+1 is for `call`, not lea.)
fn p5_add_reloc_pc32(po, symidx) {
    w64(reldyn + relc*24 + 0, po+3)               // r_offset = lea disp32 field
    w64(reldyn + relc*24 + 8, (symidx<<32) | 2)   // r_info = (symidx<<32)|R_X86_64_PC32
    w32(reldyn + relc*24 + 16, 0xFFFFFFFC)        // r_addend low  = 0xFFFFFFFC (-4)
    w32(reldyn + relc*24 + 20, 0xFFFFFFFF)        // r_addend high = 0xFFFFFFFF (-4)
    relc = relc+1
}
// return the .strtab offset stored in symbol idx's st_name field.
fn symc_stname(idx) { return r32(symtab + idx*24 + 0) }

fn p5_elf_obj(out_p) {
    let i=0
    // 1. copy code buffer -> objcode (relocatable image)
    while i<codelen { w8(objcode+i, r8(code+i)); i=i+1 }
    objcodelen = codelen

    // 2. symbol table (index 0 = null symbol). Use a helper that writes the
    // name bytes into .strtab and returns the symbol index, so the st_name
    // offset is always correct (no manual strtab surgery).
    // p5_mksym(namep, namen, info, shndx, value) -> symidx
    symc = 0; strtablen = 1
    let s_null = p5_add_symbol_b(0,0)          // index 0: null symbol
    // _gdata (STB_LOCAL) — start of the .data region (globals + string literals).
    // LOCAL binding keeps it before any globals (ELF ordering) and prevents a
    // "multiple definition of _gdata" collision when linking multiple Quanta
    // object files (each TU gets its own local _gdata; ld resolves this TU's
    // global-access relocations against its own local symbol).
    let sg = p5_add_symbol_b(0,0)
    let psgn = symc_stname(sg)
    w8(strtab+psgn+0,95); w8(strtab+psgn+1,103); w8(strtab+psgn+2,100); w8(strtab+psgn+3,97); w8(strtab+psgn+4,116); w8(strtab+psgn+5,97); w8(strtab+psgn+6,0)
    strtablen = strtablen + 6
    w8(symtab + sg*24 + 4, 0x00)              // STT_NOTYPE|STB_LOCAL (info=(bind<<4)|type => 0x00)
    w16(symtab + sg*24 + 6, 3)                // st_shndx = .data (section 3)
    w64(symtab + sg*24 + 8, 0)                // offset 0 within .data
    gdata_sym = sg
    // first non-local symbol index (set when we add the first GLOBAL symbol)
    let symtab_shinfo = -1
    // __init (STB_LOCAL) — only the entry TU's _start calls it internally;
    // LOCAL avoids a cross-TU collision on the name.
    let si = p5_add_symbol_b(0,0)
    w8(strtab + symc_stname(si), 95); w8(strtab + symc_stname(si)+1, 95); w8(strtab + symc_stname(si)+2, 105)
    w8(strtab + symc_stname(si)+3, 110); w8(strtab + symc_stname(si)+4, 105); w8(strtab + symc_stname(si)+5, 116); w8(strtab + symc_stname(si)+6, 0)
    strtablen = strtablen + 6
    w8(symtab + si*24 + 4, 0x02)              // STT_FUNC|STB_LOCAL (info=0x02)
    w16(symtab + si*24 + 6, 1)                // st_shndx = .text
    w64(symtab + si*24 + 8, r64(func_code_starts+0))
    w64(fn_symidx + 0*8, si)
    // main: LOCAL in the entry TU (called only by _start); GLOBAL in a
    // --no-start TU (library export). Skip if the TU has no main at all.
    let sm = -1
    if has_main==1 {
        sm = p5_add_symbol_b(0,0)
        let pmn = symc_stname(sm)
        w8(strtab+pmn+0,109); w8(strtab+pmn+1,97); w8(strtab+pmn+2,105); w8(strtab+pmn+3,110); w8(strtab+pmn+4,0)
        strtablen = strtablen + 4
        if no_start==1 { w8(symtab + sm*24 + 4, 0x12) }  // GLOBAL export
        else { w8(symtab + sm*24 + 4, 0x02) }            // LOCAL FUNC
        w16(symtab + sm*24 + 6, 1)              // st_shndx = .text
        w64(symtab + sm*24 + 8, g_main_ofs)     // main's code offset
        w64(fn_symidx + g_main_fi*8, sm)         // g_main_fi = main fn index
        if symtab_shinfo<0 && no_start==1 { symtab_shinfo = sm }
    }
    // per user fn: GLOBAL symbols (exported for cross-TU calls), mapped via
    // fn_symidx. __init/main handled above; _start created last (sole GLOBAL
    // in the entry TU). All LOCALs (__init, main, _gdata) already precede these.
    let fi=0
    while fi<fnc {
        let nm=fn_name(fi); let nl=fn_nlen(fi)
        if nl==4 && r8(src+nm)==109 && r8(src+nm+1)==97 && r8(src+nm+2)==105 && r8(src+nm+3)==110 {
            if sm>=0 { w64(fn_symidx + fi*8, sm) }
        } else if nl==6 && r8(src+nm)==95 && r8(src+nm+1)==95 && r8(src+nm+2)==105 && r8(src+nm+3)==110 && r8(src+nm+4)==105 && r8(src+nm+5)==116 {
            w64(fn_symidx + fi*8, si)
        } else if nl==6 && r8(src+nm)==95 && r8(src+nm+1)==115 && r8(src+nm+2)==116 && r8(src+nm+3)==97 && r8(src+nm+4)==114 && r8(src+nm+5)==116 {
            // _start: created below as the (sole) GLOBAL symbol in the entry TU.
        } else {
            // P5.1: extern "C" fns are UNDEF symbols (created at their call
            // sites via p5_sym_for_name), NOT defined here — so linking a TU
            // that declares `extern "C" fn foo` against a TU that DEFINES foo
            // gives exactly one definition.
            if r64(fn_extern + fi*8)==1 { fi=fi+1; continue }
            let s = p5_add_symbol_b(nm, nl)
            w8(symtab + s*24 + 4, 0x12)       // STT_FUNC|STB_GLOBAL
            w16(symtab + s*24 + 6, 1)         // st_shndx = .text
            w64(symtab + s*24 + 8, r64(func_code_starts+(fi+1)*8))
            w64(fn_symidx + fi*8, s)
            if symtab_shinfo<0 { symtab_shinfo = s }
        }
        fi=fi+1
    }
    // _start (STB_GLOBAL) — ONLY in the entry TU (no_start==0). It is the sole
    // GLOBAL symbol there; all locals (__init, main, _gdata) precede it, so the
    // ELF locals-before-globals ordering holds.
    let ss = -1
    if no_start==0 {
        ss = p5_add_symbol_b(0,0)
        let psn = symc_stname(ss)
        w8(strtab+psn+0,95); w8(strtab+psn+1,115); w8(strtab+psn+2,116); w8(strtab+psn+3,97); w8(strtab+psn+4,114); w8(strtab+psn+5,116); w8(strtab+psn+6,0)
        strtablen = strtablen + 6
        w8(symtab + ss*24 + 4, 0x12)              // STT_FUNC|STB_GLOBAL
        w16(symtab + ss*24 + 6, 1)                // st_shndx = .text
        w64(symtab + ss*24 + 8, 0)                // _start at offset 0
        if symtab_shinfo<0 { symtab_shinfo = ss }
    }
    // P5.1 cross-TU DATA globals: emit one named ELF symbol per named global.
    // `global NAME`   -> GLOBAL definition at st_value = gidx*8 (its slot in
    //                    .data), st_shndx = .data. The linker merges all TUs'
    //                    .data and binds cross-TU accesses to the single def.
    // `extern "C" global NAME` -> UNDEF GLOBAL symbol (st_shndx=SHN_UNDEF),
    // resolved by the external linker to the defining TU's symbol.
    // Named globals' access relocations (below) target THIS symbol with addend
    // -4 instead of `_gdata` with gidx*8-4, so the linker computes the right
    // RIP-relative disp to the (merged) .data slot.
    let gi=0
    while gi<gvarc {
        if r64(g_named + gi*8)>=1 {
            let gnm = r64(gvars + gi*16)
            let gnl = r64(gvars + gi*16 + 8)
            let s = p5_add_symbol_b(gnm, gnl)
            if r64(g_named + gi*8)==2 {
                w8(symtab + s*24 + 4, 0x10)      // STT_NOTYPE|STB_GLOBAL (UNDEF import)
                w16(symtab + s*24 + 6, 0)        // st_shndx = SHN_UNDEF
                w64(symtab + s*24 + 8, 0)        // no value (defined elsewhere)
            } else {
                w8(symtab + s*24 + 4, 0x12)      // STT_NOTYPE|STB_GLOBAL (def)
                w16(symtab + s*24 + 6, 3)        // st_shndx = .data (section 3)
                w64(symtab + s*24 + 8, gi*8)  // slot offset in .data (source globals at gi*8; internals reserved at 38+)
            }
            w64(g_symidx + gi*8, s)
            if symtab_shinfo<0 && r64(g_named + gi*8)!=2 { symtab_shinfo = s }
        } else {
            w64(g_symidx + gi*8, -1)
        }
        gi=gi+1
    }
    // 3. relocations for intra-TU and extern calls (ty==2 patches)
    relc = 0
    // x86 object-mode global relocations: inline loop (no patch_globals call) —
    // for each recorded RIP-relative global access emit R_X86_64_PC32 against
    // _gdata with addend gidx*8 - 4 (RIP is 4 bytes past the disp32 field).
    if target_arch == 0 {
        let xgi=0
        while xgi<gpatchc {
            let xgp = r64(gpatches+xgi*24)
            let xgidx = r64(gpatches+xgi*24+8)
            let xkind = r8(gpatches+xgi*24+16)
            if xkind == 0||xkind == 1 {
                // LOADG / STOREG. `xgidx` is the global index emitted by the IR
                // instruction (gfind result for source globals, a reserved index
                // 0..INTERNAL_GLOBAL_COUNT-1 for compiler-internal globals such as
                // file handles). The .data layout is:
                //   slots [0, INTERNAL_GLOBAL_COUNT)     -> internal globals
                //   slots [INTERNAL_GLOBAL_COUNT, ...)    -> source globals (slot 38+gi)
                // Three cases:
                //   (a) named source (xgidx<gvarc && g_named[xgidx]>=1): emit reloc
                //       against the named GLOBAL symbol, addend -4.
                //   (b) legacy source (xgidx<gvarc && g_named==0): _gdata slot (38+xgidx)*8, addend -4.
                //   (c) internal (xgidx>=gvarc): _gdata slot xgidx*8, addend -4.
                // (Do NOT test `xgidx>=INTERNAL_GLOBAL_COUNT` to detect named: source
                // global indices are 0..gvarc-1 and never reach 38, so that check
                // silently forced every named global down the legacy path.)
                let gsym = -1
                if xgidx<gvarc && r64(g_named + xgidx*8)>=1 { gsym = r64(g_symidx + xgidx*8) }
                if gsym>=0 {
                    w64(reldyn + relc*24 + 0, xgp)
                    w64(reldyn + relc*24 + 8, (gsym<<32) | 2)
                    w32(reldyn + relc*24 + 16, 0xFFFFFFFC)   // addend = -4
                    w32(reldyn + relc*24 + 20, 0xFFFFFFFF)
                    relc = relc+1
                } else {
                    let xadd = xgidx*8 - 4
                    w64(reldyn + relc*24 + 0, xgp)
                    w64(reldyn + relc*24 + 8, (gdata_sym<<32) | 2)
                    w32(reldyn + relc*24 + 16, xadd)
                    w32(reldyn + relc*24 + 20, 0xFFFFFFFF)
                    if xadd >= 0 { w32(reldyn + relc*24 + 20, 0) }
                    relc = relc+1
                }
            } else {
                // kind 2 (string lea): raw offset into .data - 4, against _gdata.
                let xadd = xgidx - 4
                w64(reldyn + relc*24 + 0, xgp)
                w64(reldyn + relc*24 + 8, (gdata_sym<<32) | 2)
                w32(reldyn + relc*24 + 16, xadd)
                w32(reldyn + relc*24 + 20, 0xFFFFFFFF)
                if xadd >= 0 { w32(reldyn + relc*24 + 20, 0) }
                relc = relc+1
            }
            xgi=xgi+1
        }
    }
    let pi=0
    while pi<patchc {
        if r64(patches+pi*PCS+16)==2 {
            let po=r64(patches+pi*PCS)
            let tg=r64(patches+pi*PCS+8)
            let tg_nl=0
            while tg_nl<256 { let c0=r8(src+tg+tg_nl)
                if c0==0||c0==40||c0==59||c0==123||c0==125||c0==44 { break }
                if c0==32||c0==9||c0==10||c0==13 { break }; tg_nl=tg_nl+1 }
            let tfi=findfn(tg,tg_nl)
            if tfi>=0 {
                if r64(fn_extern + tfi*8)==1 {
                    let es = p5_sym_for_name(tg, tg_nl)
                    p5_add_reloc(po, es)
                } else {
                    p5_add_reloc(po, r64(fn_symidx + tfi*8))
                }
            }
        } else if r64(patches+pi*PCS+16)==3 {
            // extern "C" call in OBJECT mode — resolve to the UNDEF GLOBAL symbol
            // (created on demand by p5_sym_for_name) and emit a PLT32/CALL26
            // relocation. This is what the external linker binds to the defining
            // TU's GLOBAL symbol at link time.
            let po=r64(patches+pi*PCS)
            let tg=r64(patches+pi*PCS+8)
            let tg_nl=0
            while tg_nl<256 { let c0=r8(src+tg+tg_nl)
                if c0==0||c0==40||c0==59||c0==123||c0==125||c0==44 { break }
                if c0==32||c0==9||c0==10||c0==13 { break }; tg_nl=tg_nl+1 }
            let es = p5_sym_for_name(tg, tg_nl)
            p5_add_reloc(po, es)
        } else if r64(patches+pi*PCS+16)==4 {
            // fnptr in OBJECT mode (x86). patches+8 = function index (fi). Emit a
            // PC-relative R_X86_64_PC32 relocation against the function's symbol.
            let po=r64(patches+pi*PCS)
            let fi=r64(patches+pi*PCS+8)
            let fsym=r64(fn_symidx + fi*8)
            if fsym>=0 {
                if target_arch == 1 {
                    // ARM64: relocations emitted by the fnptr_patches loop instead.
                } else {
                    p5_add_reloc_pc32(po, fsym)
                }
            }
        }
        pi=pi+1
    }
    // startup stub: _start calls __init and main (entry TU only)
    if no_start == 0 {
        p5_add_reloc(g_init_call_ofs, si)
        p5_add_reloc(g_main_call_ofs, sm)
    }
    // object-mode global relocations (ARM64): for each recorded global access,
    // emit R_AARCH64_ADR_PREL_PG_HI21 (275) at the adrp site and
    // R_AARCH64_ADD_ABS_LO12_NC (277) at the add site, both against _gdata with
    // addend gidx*8. x86 global relocs were emitted in patch_globals().
    let agi=0
    while agi<gapatchc {
        let adrp_ofs = r64(gpatches_a + agi*32 + 0)
        let add_ofs  = r64(gpatches_a + agi*32 + 8)
        let gidx     = r64(gpatches_a + agi*32 + 16)
        let has_add  = r64(gpatches_a + agi*32 + 24)
        // gidx is the global index emitted by the IR instruction (gfind result
        // for source globals at .data slot gidx*8, or a reserved 38..37+INTERNAL_GLOBAL_COUNT
        // index for compiler-internal globals at slot gidx*8). Named cross-TU globals
        // (g_named[gidx]>=1) target their named GLOBAL symbol (addend 0); others target
        // _gdata at slot gidx*8 (addend gidx*8).
        let asym = gdata_sym
        let aadd = gidx*8
        if gidx<gvarc && r64(g_named + gidx*8)>=1 { asym = r64(g_symidx + gidx*8); aadd = 0 }
        // ADR_PREL_PG_HI21: r_offset = adrp instruction, addend = aadd (slot offset)
        w64(reldyn + relc*24 + 0, adrp_ofs)
        w64(reldyn + relc*24 + 8, (asym<<32) | 275)
        w32(reldyn + relc*24 + 16, aadd)
        w32(reldyn + relc*24 + 20, 0)
        relc = relc+1
        if has_add == 1 {
            w64(reldyn + relc*24 + 0, add_ofs)
            w64(reldyn + relc*24 + 8, (asym<<32) | 277)
            w32(reldyn + relc*24 + 16, aadd)
            w32(reldyn + relc*24 + 20, 0)
            relc = relc+1
        }
        agi=agi+1
    }
    // ARM64 fnptr relocations (object mode only): for each recorded IR_FNPTR site,
    // emit R_AARCH64_ADR_PREL_PG_HI21 (275) at the adrp instruction and
    // R_AARCH64_ADD_ABS_LO12_NC (277) at the add instruction, both against the
    // function's symbol (fn_symidx[fi]) with addend 0. x86-64 fnptr relocs are
    // emitted by the patches ty==3 handler via p5_add_reloc_pc32.
    if target_arch == 1 {
        let fp=0
        while fp<fnptr_patchc {
            let adrp_ofs = r64(fnptr_patches + fp*32 + 0)
            let add_ofs  = r64(fnptr_patches + fp*32 + 8)
            let tfi      = r64(fnptr_patches + fp*32 + 16)
            let fsym = r64(fn_symidx + tfi*8)
            w64(reldyn + relc*24 + 0, adrp_ofs)
            w64(reldyn + relc*24 + 8, (fsym<<32) | 275)
            w32(reldyn + relc*24 + 16, 0)
            w32(reldyn + relc*24 + 20, 0)
            relc = relc+1
            w64(reldyn + relc*24 + 0, add_ofs)
            w64(reldyn + relc*24 + 8, (fsym<<32) | 277)
            w32(reldyn + relc*24 + 16, 0)
            w32(reldyn + relc*24 + 20, 0)
            relc = relc+1
            fp = fp+1
        }
    }

    // 4. section header string table
    let shstr = mmap(256); let shl=0
    w8(shstr+shl,0); shl=shl+1
    let o_text=shl;   w8(shstr+shl,46);w8(shstr+shl+1,116);w8(shstr+shl+2,101);w8(shstr+shl+3,120);w8(shstr+shl+4,116);w8(shstr+shl+5,0); shl=shl+6
    let o_rel =shl;   w8(shstr+shl,46);w8(shstr+shl+1,114);w8(shstr+shl+2,101);w8(shstr+shl+3,108);w8(shstr+shl+4,97);w8(shstr+shl+5,46);w8(shstr+shl+6,116);w8(shstr+shl+7,101);w8(shstr+shl+8,120);w8(shstr+shl+9,116);w8(shstr+shl+10,0); shl=shl+11
    let o_data=shl;   w8(shstr+shl,46);w8(shstr+shl+1,100);w8(shstr+shl+2,97);w8(shstr+shl+3,116);w8(shstr+shl+4,97);w8(shstr+shl+5,0); shl=shl+6
    let o_sym =shl;   w8(shstr+shl,46);w8(shstr+shl+1,115);w8(shstr+shl+2,121);w8(shstr+shl+3,109);w8(shstr+shl+4,116);w8(shstr+shl+5,97);w8(shstr+shl+6,98);w8(shstr+shl+7,0); shl=shl+8
    let o_str =shl;   w8(shstr+shl,46);w8(shstr+shl+1,115);w8(shstr+shl+2,116);w8(shstr+shl+3,114);w8(shstr+shl+4,116);w8(shstr+shl+5,97);w8(shstr+shl+6,98);w8(shstr+shl+7,0); shl=shl+8
    let o_shs =shl;   w8(shstr+shl,46);w8(shstr+shl+1,115);w8(shstr+shl+2,104);w8(shstr+shl+3,115);w8(shstr+shl+4,116);w8(shstr+shl+5,114);w8(shstr+shl+6,116);w8(shstr+shl+7,97);w8(shstr+shl+8,98);w8(shstr+shl+9,0); shl=shl+10
    let o_note=shl;   w8(shstr+shl,46);w8(shstr+shl+1,110);w8(shstr+shl+2,111);w8(shstr+shl+3,116);w8(shstr+shl+4,101);w8(shstr+shl+5,46);w8(shstr+shl+6,71);w8(shstr+shl+7,78);w8(shstr+shl+8,85);w8(shstr+shl+9,45);w8(shstr+shl+10,115);w8(shstr+shl+11,116);w8(shstr+shl+12,97);w8(shstr+shl+13,99);w8(shstr+shl+14,107);w8(shstr+shl+15,0); shl=shl+16

    // 5. file layout  (8 sections: NULL,.text,.rela.text,.data,.symtab,.strtab,.shstrtab,.note.GNU-stack)
    let ehsize=64
    let text_off=ehsize
    let rel_off =text_off + objcodelen
    let datasz = (INTERNAL_GLOBAL_COUNT + gvarc)*8 + data_off   // globals(zero) + string literals
    let data_off_sec = rel_off + relc*24
    let sym_off =data_off_sec + datasz
    let str_off =sym_off + symc*24
    let shdr_off =str_off + strtablen
    let shstr_off =shdr_off + 8*64
    let note_off = shstr_off + shl
    let total = note_off + 1
    let e=mmap(total)

    // 6. ELF header (ET_REL)
    let z=0
    while z<total { w8(e+z,0); z=z+1 }
    w8(e+0,127); w8(e+1,69); w8(e+2,76); w8(e+3,70); w8(e+4,2); w8(e+5,1); w8(e+6,1)
    w16(e+16, 1)          // e_type = ET_REL
    if target_arch == 1 { w16(e+18, 183) }   // e_machine = EM_AARCH64
    else { w16(e+18, 62) }                   // e_machine = EM_X86_64
    w32(e+20, 1)          // e_version
    w64(e+24, 0)          // e_entry = 0
    w64(e+32, 0)          // e_phoff = 0
    w64(e+40, shdr_off)    // e_shoff
    w32(e+48, 0)          // e_flags
    w16(e+52, 64)         // e_ehsize
    w16(e+54, 0)          // e_phentsize
    w16(e+56, 0)          // e_phnum
    w16(e+58, 64)         // e_shentsize
    w16(e+60, 8)          // e_shnum (8 sections)
    w16(e+62, 6)          // e_shstrndx = .shstrtab index

    // data sections
    let t=0
    while t<objcodelen { w8(e+text_off+t, r8(objcode+t)); t=t+1 }
    let r=0
    while r<relc*24 { w8(e+rel_off+r, r8(reldyn+r)); r=r+1 }
    // .data content: globals region zero-filled, then string-literal bytes.
    let d=0
    while d<datasz { w8(e+data_off_sec+d, 0); d=d+1 }
    let d2=0
    while d2<data_off { w8(e+data_off_sec + (INTERNAL_GLOBAL_COUNT+gvarc)*8 + d2, r8(data+d2)); d2=d2+1 }
    let sm2=0
    while sm2<symc*24 { w8(e+sym_off+sm2, r8(symtab+sm2)); sm2=sm2+1 }
    let st=0
    while st<strtablen { w8(e+str_off+st, r8(strtab+0+st)); st=st+1 }
    let ss2=0
    while ss2<shl { w8(e+shstr_off+ss2, r8(shstr+ss2)); ss2=ss2+1 }
    // .note.GNU-stack content: a single byte = 0 (non-executable stack).
    w8(e+note_off, 0)

    // 7. section header table (8 entries)
    // sec0 NULL
    // sec1 .text
    w32(e+shdr_off + 1*64 + 0, o_text)
    w32(e+shdr_off + 1*64 + 4, 1)            // SHT_PROGBITS
    w64(e+shdr_off + 1*64 + 8, 6)            // SHF_ALLOC|SHF_EXECINSTR
    w64(e+shdr_off + 1*64 + 16, 0)           // sh_addr
    w64(e+shdr_off + 1*64 + 24, text_off)
    w64(e+shdr_off + 1*64 + 32, objcodelen)
    w32(e+shdr_off + 1*64 + 40, 0)           // sh_link
    w32(e+shdr_off + 1*64 + 44, 0)           // sh_info
    w64(e+shdr_off + 1*64 + 48, 1)          // sh_addralign (1, like gcc output)
    w64(e+shdr_off + 1*64 + 56, 0)           // sh_entsize
    // sec2 .rela.text
    w32(e+shdr_off + 2*64 + 0, o_rel)
    w32(e+shdr_off + 2*64 + 4, 4)            // SHT_RELA
    w64(e+shdr_off + 2*64 + 8, 0)
    w64(e+shdr_off + 2*64 + 16, 0)
    w64(e+shdr_off + 2*64 + 24, rel_off)
    w64(e+shdr_off + 2*64 + 32, relc*24)
    w32(e+shdr_off + 2*64 + 40, 4)           // sh_link = .symtab index
    w32(e+shdr_off + 2*64 + 44, 1)           // sh_info = .text index
    w64(e+shdr_off + 2*64 + 48, 8)           // sh_addralign
    w64(e+shdr_off + 2*64 + 56, 24)          // sh_entsize
    // sec3 .data
    w32(e+shdr_off + 3*64 + 0, o_data)
    w32(e+shdr_off + 3*64 + 4, 1)            // SHT_PROGBITS
    w64(e+shdr_off + 3*64 + 8, 3)            // SHF_ALLOC|SHF_WRITE
    w64(e+shdr_off + 3*64 + 16, 0)           // sh_addr
    w64(e+shdr_off + 3*64 + 24, data_off_sec)
    w64(e+shdr_off + 3*64 + 32, datasz)
    w32(e+shdr_off + 3*64 + 40, 0)           // sh_link
    w32(e+shdr_off + 3*64 + 44, 0)           // sh_info
    w64(e+shdr_off + 3*64 + 48, 8)           // sh_addralign
    w64(e+shdr_off + 3*64 + 56, 1)           // sh_entsize
    // sec4 .symtab
    w32(e+shdr_off + 4*64 + 0, o_sym)
    w32(e+shdr_off + 4*64 + 4, 2)            // SHT_SYMTAB
    w64(e+shdr_off + 4*64 + 8, 0)
    w64(e+shdr_off + 4*64 + 16, 0)
    w64(e+shdr_off + 4*64 + 24, sym_off)
    w64(e+shdr_off + 4*64 + 32, symc*24)
    w32(e+shdr_off + 4*64 + 40, 5)           // sh_link = .strtab index
    if symtab_shinfo < 0 { symtab_shinfo = symc }   // no globals: sh_info = symc (valid)
    w32(e+shdr_off + 4*64 + 44, symtab_shinfo) // sh_info = first non-local
    w64(e+shdr_off + 4*64 + 48, 8)
    w64(e+shdr_off + 4*64 + 56, 24)
    // sec5 .strtab
    w32(e+shdr_off + 5*64 + 0, o_str)
    w32(e+shdr_off + 5*64 + 4, 3)            // SHT_STRTAB
    w64(e+shdr_off + 5*64 + 8, 0)
    w64(e+shdr_off + 5*64 + 16, 0)
    w64(e+shdr_off + 5*64 + 24, str_off)
    w64(e+shdr_off + 5*64 + 32, strtablen)
    w32(e+shdr_off + 5*64 + 40, 0)
    w32(e+shdr_off + 5*64 + 44, 0)
    w64(e+shdr_off + 5*64 + 48, 1)
    w64(e+shdr_off + 5*64 + 56, 0)
    // sec6 .shstrtab
    w32(e+shdr_off + 6*64 + 0, o_shs)
    w32(e+shdr_off + 6*64 + 4, 3)            // SHT_STRTAB
    w64(e+shdr_off + 6*64 + 8, 0)
    w64(e+shdr_off + 6*64 + 16, 0)
    w64(e+shdr_off + 6*64 + 24, shstr_off)
    w64(e+shdr_off + 6*64 + 32, shl)
    w32(e+shdr_off + 6*64 + 40, 0)
    w32(e+shdr_off + 6*64 + 44, 0)
    w64(e+shdr_off + 6*64 + 48, 1)
    w64(e+shdr_off + 6*64 + 56, 0)
    // sec7 .note.GNU-stack (non-exec stack; sh_flags=0). Conventionally SHT_PROGBITS
    // (type 1) with a single content byte (0 = non-executable), matching gcc output.
    w32(e+shdr_off + 7*64 + 0, o_note)
    w32(e+shdr_off + 7*64 + 4, 1)            // SHT_PROGBITS (NOT SHT_NOTE)
    w64(e+shdr_off + 7*64 + 8, 0)
    w64(e+shdr_off + 7*64 + 16, 0)
    w64(e+shdr_off + 7*64 + 24, note_off)
    w64(e+shdr_off + 7*64 + 32, 1)           // size = 1 byte (0 = non-exec)
    w32(e+shdr_off + 7*64 + 40, 0)
    w32(e+shdr_off + 7*64 + 44, 0)
    w64(e+shdr_off + 7*64 + 48, 1)           // sh_addralign = 1
    w64(e+shdr_off + 7*64 + 56, 0)           // sh_entsize = 0

    // 8. write the .o to out_p
    let ofd=file_open(out_p,577,493)
    if ofd>=0 { file_write(ofd, e, total); file_close(ofd) }
    // Linker invocation is delegated to an external driver (rebuild.sh / the
    // future `quanta build` tool). Quanta has no system()/execve; the .o is the
    // deliverable. From the shell: `ld <out_p> -o <exe>` (or `gcc <out_p>`).
}

// `include io` (no quotes) resolves `io.q`, searching: cwd, std/, ext/.
// Honored ONLY at line-start and OUTSIDE // comments, so it can never match
// prose/comments. Quanta is flat-global: included text is concatenated into
// the single 'src' buffer before tokenizing. Used for internal stdlib
// (std/*). `import` (external, namespaced) is reserved for later.
fn imp_strlen() {
  let i=0
  while r8(imp_full+i) != 0 { i=i+1 }
  return i
}
fn imp_hash() {            // hash of NUL-terminated imp_full
  // G2: masked to 32 bits so the djb2 accumulator never overflows a signed
  // i64 (long include paths would otherwise trip --overflow-trap at self-host
  // time). Only used for dedup self-equality, so the reduced range is fine.
  let h=0; let i=0
  while r8(imp_full+i) != 0 { h = (h*31 + r8(imp_full+i)) & 4294967295; i=i+1 }
  return h
}
fn imp_already() {
  let k=0
  while k<imp_seenc { if r64(imp_seen+k*8)==imp_hash() { return 1 }; k=k+1 }
  return 0
}
fn src_strlen(p) {           // length of NUL-terminated string at p
  let i=0
  while r8(p+i) != 0 { i=i+1 }
  return i
}
// Set imp_dir = dirname of path[0..len) (everything up to and including the last
// '/'); if no '/', imp_dirlen=0 (cwd). Used so relative quoted includes resolve
// against the directory of the file that contains them.
fn imp_dir_from(path, len) {
  let last = -1; let k=0
  while k<len { if r8(path+k)==47 { last=k }; k=k+1 }
  if last<0 { imp_dirlen=0 }
  else { let c=0; while c<=last { w8(imp_dir+c, r8(path+c)); c=c+1 }; imp_dirlen=last+1 }
}
// Save current imp_dir into the depth-indexed stack slot.
fn imp_dir_save(d) {
  let c=0
  while c<imp_dirlen { w8(imp_dir_stack + d*4096 + c, r8(imp_dir+c)); c=c+1 }
  w64(imp_dir_stacklen + d*8, imp_dirlen)
}
fn imp_dir_restore(d) {
  imp_dirlen = r64(imp_dir_stacklen + d*8)
  let c=0
  while c<imp_dirlen { w8(imp_dir+c, r8(imp_dir_stack + d*4096 + c)); c=c+1 }
}
// Build imp_full = prefix[0..pl-1] + NAME[0..nl-1]  (NO extension; files are
// extensionless, e.g. 'std/io', 'std/string'). Returns fd or -1.
fn imp_try(name, nl, pfx, pl) {
  let k=0
  while k<pl { w8(imp_full+k, r8(pfx+k)); k=k+1 }
  let j=0
  while j<nl { w8(imp_full+k, r8(name+j)); k=k+1; j=j+1 }
  w8(imp_full+k, 0)
  return file_open(imp_full, 0)
}

fn imp_load(fd, depth) {     // read fd into depth buffer, dedup, recurse-expand
  if imp_already()==0 {
    w64(imp_seen + imp_seenc*8, imp_hash()); imp_seenc=imp_seenc+1
    let ib = impbufs + (depth%8)*16777216
    let n = file_read(fd, ib, 16777216); file_close(fd)
    if n>0 { expand_includes(ib, n, depth+1) }
  } else { file_close(fd) }
}

fn expand_includes(buf, len, depth) {
  if depth>8 { imp_err=1; return }
  let i=0
  while i<len {
    let ch = r8(buf+i)
    if ch==47 && i+1<len && r8(buf+i+1)==42 {
      // /* block comment */ -> skip to closing */
      i=i+2; while i+1<len && !(r8(buf+i)==42 && r8(buf+i+1)==47) { i=i+1 }
      if i+1<len { i=i+2 }
    } else if ch==47 && i+1<len && r8(buf+i+1)==47 {
      // // comment -> skip whole line (so 'include' inside prose is invisible)
      i=i+2; while i<len && r8(buf+i)!=10 { i=i+1 }
    } else if (i==0 || r8(buf+i-1)==10 || r8(buf+i-1)==32 || r8(buf+i-1)==9) && ch==105 && r8(buf+i+1)==110 && r8(buf+i+2)==99 && r8(buf+i+3)==108 && r8(buf+i+4)==117 && r8(buf+i+5)==100 && r8(buf+i+6)==101 {
      // 'include' at line start. Require it be a standalone word.
      let nx = r8(buf+i+7)
      if nx==32 || nx==9 || nx==10 || nx==0 || nx==47 || nx==34 {
        let j=i+7
        while j<len && (r8(buf+j)==32 || r8(buf+j)==9) { j=j+1 }
        if r8(buf+j)==34 {
          // quoted form: include "path/file.q"
          //   - absolute path (starts with '/') -> open verbatim
          //   - relative path -> resolve against the current include dir (imp_dir)
          let q=j+1
          while q<len && r8(buf+q)!=34 { q=q+1 }
          let ql = q - (j+1)
          if ql>0 {
            let first = r8(buf+j+1)
            if first==47 {
              // absolute: imp_full = verbatim path
              let k=0
              while k<ql { w8(imp_full+k, r8(buf+j+1+k)); k=k+1 }
              w8(imp_full+k, 0)
            } else {
              // relative: imp_full = imp_dir + path
              let k=0
              while k<imp_dirlen { w8(imp_full+k, r8(imp_dir+k)); k=k+1 }
              let m=0
              while m<ql { w8(imp_full+k+m, r8(buf+j+1+m)); m=m+1 }
              w8(imp_full+k+m, 0)
            }
            let fd = file_open(imp_full, 0)
            if fd>=0 {
              // save parent dir, switch to this file's dir for nested includes,
              // load (recurse), then restore the parent dir.
              imp_dir_save(depth)
              imp_dir_from(imp_full, src_strlen(imp_full))
              imp_load(fd, depth)
              imp_dir_restore(depth)
            } else { imp_err=1 }
          } else { imp_err=1 }
          i=q+1
        } else {
          // bare form: include NAME -> resolve via cwd/std/ext prefixes
          let ns=j; let nl=0
          while j<len && r8(buf+j)!=32 && r8(buf+j)!=9 && r8(buf+j)!=10 && r8(buf+j)!=0 { nl=nl+1; j=j+1 }
          let fd = imp_try(buf+ns, nl, 0, 0)
          if fd<0 { fd = imp_try(buf+ns, nl, imp_std_pfx, 4) }
          if fd<0 { fd = imp_try(buf+ns, nl, imp_ext_pfx, 4) }
          if fd>=0 { imp_load(fd, depth) } else { imp_err=1 }
          i=j
        }
      } else {
        w8(src+srclen, ch); srclen=srclen+1; i=i+1
      }
    } else {
      w8(src+srclen, ch); srclen=srclen+1; i=i+1
    }
  }
}

// === MAIN ===
fn main(argc, argv) {
    kregs(); init_regs(); init_fregs(); init_cs(); 
    // Phase 4.3: mark all vregs as "not a struct" (-1). mmap zero-fills, which
    // would collide with struct index 0, so explicitly init to -1.
    let vsi_init = 0
    while vsi_init < 8192 { w64(vreg_struct + vsi_init*8, 0-1); w64(vreg_is_str + vsi_init*8, 0-1); vsi_init = vsi_init+1 }
    if argc<2 { exit(13) }
    // --- A: optimization is ALWAYS ON (1.0.12). `-O` is accepted as a harmless
    // no-op flag for backward compatibility; opt_on is already 1 (global default).
    // Source/output use the simple convention: first non-flag argv = source,
    // next non-flag argv = output.
    let out_p = 0
    let srcp = 0
    let ai = 1
    // Android/Termux runs our ET_DYN via the bionic linker, which inserts the
    // program's own path as an extra argv slot (argc+1, self path at argv[1]).
    // Detect that by sniffing argv[1] for our own ELF magic and skip it.
    if argc>=2 {
        let sfp = r64(argv+1*8)
        let sfd = file_open(sfp, 0)
        if sfd>=0 {
            let magbuf = mmap(16)
            let mn = file_read(sfd, magbuf, 4)
            file_close(sfd)
            if mn==4 && r8(magbuf)==127 && r8(magbuf+1)==69 && r8(magbuf+2)==76 && r8(magbuf+3)==70 { ai = 2 }
        }
    }
    while ai<argc {
        let ap=r64(argv+ai*8)
        // ignore any "-O" (and other "-X" flags) when picking source/output
        if !(r8(ap)==45 && r8(ap+1)==79) {
            // G2: overflow trap is ON by default (secure by default). Two flags:
            //   --overflow-trap      : accepted as a no-op (explicit opt-in)
            //   --no-overflow-trap   : turn the trap OFF (for code that relies on
            //                          two's-complement wraparound and isn't ported)
            if r8(ap)==45 && r8(ap+1)==45 {
                let is_ovf = 1; let ki=0
                let ovfstr = "overflow-trap"
                // argv strings are raw (no header); Quanta string literals carry an
                // 8-byte header, so read ovfstr starting at +8.
                while ki<13 { if r8(ap+2+ki) != r8(ovfstr+8+ki) { is_ovf=0; break }; ki=ki+1 }
                if is_ovf==1 { ovf_trap = 1 }
                else {
                    // try "--no-overflow-trap" (16 chars)
                    let is_novf = 1; let kj=0
                    let novfstr = "no-overflow-trap"
                    while kj<17 { if r8(ap+2+kj) != r8(novfstr+8+kj) { is_novf=0; break }; kj=kj+1 }
                    if is_novf==1 { ovf_trap = 0 }
                    else {
                        // P4: try "--target=arm64" (12 chars: "target=arm64")
                        let is_arm = 1; let ka=0
                        let armstr = "target=arm64"
                        while ka<12 { if r8(ap+2+ka) != r8(armstr+8+ka) { is_arm=0; break }; ka=ka+1 }
                        if is_arm==1 { target_arch = 1 }
                        else {
                          // P5: try "--emit-obj" (relocatable .o + linker, object-format pillar)
                          let is_obj=1; let oa=0
                          let emobj = "emit-obj"
                          while oa<8 { if r8(ap+2+oa) != r8(emobj+8+oa) { is_obj=0; break }; oa=oa+1 }
                          if is_obj==1 { emit_obj=1 }
                          else {
                            // P5.1: try "--no-start" (9 chars) — secondary object TU
                            let is_nostart=1; let kc=0
                            let nostr = "no-start"
                            while kc<9 { if r8(ap+2+kc) != r8(nostr+8+kc) { is_nostart=0; break }; kc=kc+1 }
                            if is_nostart==1 { no_start=1 }
                            else { if srcp==0 { srcp=ap } else if out_p==0 { out_p=ap } }
                          }
                        }
                    }
                }
            } else {
                if srcp==0 { srcp=ap }
                else if out_p==0 { out_p=ap }
            }
        }
        ai=ai+1
    }
    let fd=file_open(srcp,0)
    if fd<0 { exit(14) }
    let mlen = file_read(fd, mainsrc, 16777216); file_close(fd)
    if mlen<=0 { exit(15) }
    // Compile-time #import expansion: inline all imported sources into 'src'.
    // fill include prefix byte-buffers: "std/" and "ext/"
    w8(imp_std_pfx+0, 115); w8(imp_std_pfx+1, 116); w8(imp_std_pfx+2, 100); w8(imp_std_pfx+3, 47)  // "std/"
    w8(imp_ext_pfx+0, 101); w8(imp_ext_pfx+1, 120); w8(imp_ext_pfx+2, 116); w8(imp_ext_pfx+3, 47)  // "ext/"
    imp_err = 0; imp_seenc = 0
    srclen = 0
    // top-level include dir = dirname of the main source path (so a relative
    // quoted include in the main file resolves next to it).
    imp_dir_from(srcp, src_strlen(srcp))
    expand_includes(mainsrc, mlen, 0)
    if imp_err==1 { exit(16) }
    // 7.F / NEW-1: detect source truncation. The expanded source must fit the
    // src buffer; a source that fills it was truncated -> abort immediately.
    if srclen >= 16777216 {
        let mt = "error: source exceeds 16MB limit (truncated)\n"
        file_write(2, mt+8, len(mt)); exit(1)
    }
    tokenize()
    // 7.A part 2: unbalanced-brace check over the token stream. Track depth of
    // '{' (123) / '}' (125) TT_PNCT tokens; a nonzero end depth (or a negative
    // dip) means the braces don't balance -> hard compile error, no ELF.
    let bd=0; let bi=0
    while bi<tokc {
        if tokt(bi)==TT_PNCT {
            let tv=tokv(bi)
            if tv==123 { bd=bd+1 }
            if tv==125 { bd=bd-1; if bd<0 { bd=0-999 } }
        }
        bi=bi+1
    }
    if bd!=0 {
        let mb = "error: unbalanced braces\n"
        file_write(2, mb+8, len(mb)); had_error=1
    }
    scantraits()
    scanfns()
    scanstructs()
    rewrite_struct_literals()
    scanimpls()
    scannenums()
    scan_retstructs()
    scan_aliases()
    scan_globals()
    // 7.A part 1: require a 'main' function. Without it the startup stub would
    // patch to the first user fn and emit a binary that silently returns 0.
    has_main=0; let mmi=0
    while mmi<fnc {
        if fn_nlen(mmi)==4 {
            let mmn=fn_name(mmi)
            if r8(src+mmn)==109 { if r8(src+mmn+1)==97 { if r8(src+mmn+2)==105 { if r8(src+mmn+3)==110 { has_main=1 } } } }
        }
        mmi=mmi+1
    }
    if has_main==0 && no_start==0 {
        let mm = "error: no 'main' function found\n"
        file_write(2, mm+8, len(mm)); had_error=1
    }
    // Startup stub at code offset 0: set up argc/argv, run global initializers,
    // then call main, then exit(rax). Suppressed in --no-start (secondary TU):
    // the TU is a library exporting functions; the entry TU's _start calls them.
    if no_start == 0 {
    if target_arch == 1 {
        // ARM64 Linux _start: argc at [sp], argv at sp+8 (NOT x0/x1 — AAPCS
        // applies to calls, not process entry). Load BEFORE pushing the frame.
        araw(0xF94003F3)                // ldr x19, [sp]      (argc)
        araw(0x910023F4)                // add x20, sp, #8    (argv)
        araw(0xA9BF7BFD)                // stp x29,x30,[sp,#-16]!
        araw(0x910003FD)                // mov x29, sp
        let init_call = codelen
        g_init_call_ofs = codelen
        araw(0x94000000)                // bl __init (placeholder, patched below)
        araw(0xAA1303E0)                // mov x0, x19   (argc)
        araw(0xAA1403E1)                // mov x1, x20   (argv)
        let stub_call = codelen
        g_main_call_ofs = codelen
        araw(0x94000000)                // bl main (placeholder, patched below)
        araw(0xD2800BC8)                // movz x8, #93  (exit syscall number)
        araw(0xD4000001)                // svc #0
    } else {
        eb(95)                       // pop rdi          (argc)
        eb(72); eb(137); eb(230)     // mov rsi, rsp     (argv)
        eb(87)                       // push rdi         (save argc)
        eb(86)                       // push rsi         (save argv)
        let init_call = codelen
        g_init_call_ofs = codelen
        eb(232); ei(0)               // call __init      (patched below)
        eb(94)                       // pop rsi          (restore argv)
        eb(95)                       // pop rdi          (restore argc)
        let stub_call = codelen
        g_main_call_ofs = codelen
        eb(232); ei(0)               // call main        (patched below)
        eb(72); eb(137); eb(199)     // mov rdi, rax
        eb(184); ei(60)              // mov eax, 60
        sysc()                       // syscall (exit)
    }
    }   // end if no_start==0 (entry stub suppressed in secondary TU)

    // Compile __init: evaluate each global's initializer and store it.
    vclr(); irc=0; lblc=0

    // Write function names into src buffer for IR_CALL lookup
    let knoff=srclen
    w8(src+knoff,107); w8(src+knoff+1,114); w8(src+knoff+2,101)
    w8(src+knoff+3,103); w8(src+knoff+4,115); w8(src+knoff+5,0)

    let irnoff=knoff+6
    w8(src+irnoff,105); w8(src+irnoff+1,110); w8(src+irnoff+2,105)
    w8(src+irnoff+3,116); w8(src+irnoff+4,95); w8(src+irnoff+5,114)
    w8(src+irnoff+6,101); w8(src+irnoff+7,103); w8(src+irnoff+8,115)
    w8(src+irnoff+9,0)

    let icnoff=irnoff+10
    w8(src+icnoff,105); w8(src+icnoff+1,110); w8(src+icnoff+2,105)
    w8(src+icnoff+3,116); w8(src+icnoff+4,95); w8(src+icnoff+5,99)
    w8(src+icnoff+6,115); w8(src+icnoff+7,0)

    let gi=0
    while gi<gvarc {
        // Imported (extern "C" global NAME) globals have no initializer in
        // THIS TU - they are defined by another TU. Their ginit slot is 0,
        // so we must NOT call parse_expr() at tokp=0 (file start) or it would
        // consume the next function's tokens. Detect imported via g_named==2 and
        // emit a zero-store instead.
        if r64(g_named + gi*8)==2 {
            // imported: no initializer in this TU -> emit nothing for this slot
        } else {
            tokp = r64(ginit+gi*8)
            let gv = parse_expr()
            let initop = irop(irc-1)
            iremit(IR_STOREG, 0, gv, gi)
        }
        flush_all()
        gi=gi+1
    }
    let init_ofs = codelen
    iremit(IR_RET,0,-1,0,0)
    if target_arch == 1 { arm_ci_func(0,0) } else { ci_func(0,0) }
    w64(func_code_starts+0,init_ofs)  // record __init at index 0
    g_init_ofs = init_ofs

    // For each fn: parse body → IR, then compile IR → code, record offset
    let fi=0
    while fi<fnc {
    // P5.1: extern "C" fns have no body — skip compilation/codegen here;
    // their UNDEF symbol is emitted by p5_elf_obj and resolved at link time.
    if r64(fn_extern + fi*8)==1 { fi=fi+1; continue }
        // Parse params and body
        tokp=fn_btok(fi)+1  // skip {
        vclr(); irc=0; lblc=0

        // Bind params from the canonical record (fn_pnames/fn_pcount) written by
        // scanfns.  Re-scanning the signature tokens here is fragile: a call-valued
        // default like `b = g(5)` leaks `g` (and nested ids) in as phantom params.
        let pc=0
        let pbase=r64(fn_pbase + fi*8)
        let pcount=r64(fn_pcount + fi*8)
        let pz=0
        while pz<pcount {
            let pnm=r64(fn_pnames + pbase + pz*16)
            let pnl=r64(fn_pnames + pbase + pz*16 + 8)
            let vr=nv(); iremit(IR_PARAM,vr,pc,0,0); vadd(pnm,pnl,vr)
            // Phase 4.3: tag param vreg with its declared struct type (enables `param.field`)
            let ptyp = r64(fn_partype + (fi*200 + pz)*8)
            if ptyp>=0 { w64(vreg_struct + vr*8, ptyp) }
            // P9: tag param vreg with trait type (negative encoding)
            if ptyp < 0-1 { w64(vreg_trait + vr*8, (ptyp * -1) - 2) }
            pc=pc+1
            pz=pz+1
        }

        parse_block()
        iremit(IR_RET,0,-1,0,0)

        // Save IR start and param count
        sfn(fi,fn_name(fi),fn_nlen(fi),fn_btok(fi),0,pc)
        cur_fnname=fn_name(fi); cur_fnnlen=fn_nlen(fi)

        // Compile IR to code.  fn_cofs must be the START offset of the code.
        let cstart=codelen
        w64(func_code_starts+(fi+1)*8,cstart)
        // P4: record main's code offset for the startup-stub bl patch (global, unshadowable)
        if fn_nlen(fi)==4 && r8(src+fn_name(fi))==109 && r8(src+fn_name(fi)+1)==97 && r8(src+fn_name(fi)+2)==105 && r8(src+fn_name(fi)+3)==110 { g_main_ofs = cstart }
        opt_func()      // Tier-1 IR opt (constant folding). No-op when opt_on==0.
        cur_fnname=fn_name(fi); cur_fnnlen=fn_nlen(fi)
        if target_arch == 1 { arm_ci_func(fi,0) } else { ci_func(fi,0) }
        sfn(fi,fn_name(fi),fn_nlen(fi),fn_btok(fi),cstart,pc)

        fi=fi+1
    }

    // Resolve function-call patches (ty==2) now that all offsets are known.
    // In object mode (emit_obj==1) these are NOT resolved here — p5_elf_obj
    // emits R_X86_64_PC32 relocations against the function symbols instead.
    if emit_obj == 0 {
    let pi=0
    while pi<patchc {
        if r64(patches+pi*PCS+16)==2 {
            let po=r64(patches+pi*PCS)
            let tg=r64(patches+pi*PCS+8)
            let tg_nl=0
            while tg_nl<256 {
                let c0=r8(src+tg+tg_nl)
                if c0==0||c0==40||c0==59||c0==123||c0==125||c0==44 { break }
                if c0==32||c0==9||c0==10||c0==13 { break }
                tg_nl=tg_nl+1
            }
            let tfi=findfn(tg,tg_nl)
            if tfi>=0 {
                // P3: skip extern functions (resolved at link time, not via internal patching)
                if r64(fn_extern + tfi*8)==1 {
                    // extern "C" function - leave as-is for dynamic linker
                    // In a full implementation we'd emit a PLT/GOT entry here
                    // For now, emit a call through an unresolved call (will need dynamic linking)
                    // Leave the placeholder; a real impl would add PLT/GOT
                } else {
                    // func_code_starts[tfi+1] = code start for user function tfi (0=__init, 1=first user fn)
                    let tofs=r64(func_code_starts+(tfi+1)*8)
                    if target_arch == 1 {
                        // ARM64 'bl': imm26 = (target - callsite) >> 2 (own-address PC-relative)
                        let disp = (tofs - po) >> 2
                        w32(code+po, 0x94000000 | (disp & 0x3FFFFFF))
                    } else {
                        w8(code+po,232); w32(code+po+1, tofs-(po+5))
                    }
                }
            } else { file_write(2, src+tg, tg_nl); file_write(2, 0x100000+0, 1); exit(7) }
        } else if r64(patches+pi*PCS+16)==4 {
            // fnptr lea (x86 exec mode): patch rip-relative disp. patches+8 = fi.
            // OFFSETS (same convention as ty==2). The lea is 7 bytes; both cof and the
            // patch offset are code-buffer offsets, so disp = cof - (po3+7).
            let po3=r64(patches+pi*PCS)
            let tfi=r64(patches+pi*PCS+8)
            let cof=r64(func_code_starts+(tfi+1)*8)
            let disp=cof-(po3+7)
            w32(code+po3+3, disp)
        }
        pi=pi+1
    }
    // ARM64 fnptr patches (exec mode only): resolve the adrp/add PC-relative to
    // the function's link-time code address. func_code_starts[fi+1] is the code-
    // buffer offset; link-time address = LINK_BASE + LINK_HT + offset. The adrp/add
    // immediates are patched with the same math as arm_gptr (PAGE delta for adrp,
    // low-12 for add). Object mode emits relocations in p5_elf_obj instead.
    if target_arch == 1 {
        let fp=0
        while fp<fnptr_patchc {
            let adrp_ofs = r64(fnptr_patches + fp*32 + 0)
            let add_ofs  = r64(fnptr_patches + fp*32 + 8)
            let tfi      = r64(fnptr_patches + fp*32 + 16)
            let rd = r32(code+adrp_ofs) & 31
            let fbase = LINK_BASE + LINK_HT + r64(func_code_starts + (tfi+1)*8)
            let pclink = LINK_BASE + LINK_HT + adrp_ofs
            let imm = (fbase >> 12) - (pclink >> 12)
            let immlo = imm & 3
            let immhi = (imm >> 2) & 0x1FFFF
            w32(code+adrp_ofs, 0x90000000 | (immlo << 29) | (immhi << 5) | rd)
            let lo = fbase & 0xFFF
            w32(code+add_ofs, 0x91000000 | (lo << 10) | (rd << 5) | rd)
            fp = fp+1
        }
    }
    patch_globals()
    }   // end if emit_obj==0 (call-patch resolution skipped in object mode)

    // Post-parse arity check (single-pass parser can't check during parse:
    // forward calls / recursion reference a function whose param count is
    // only recorded after its body is parsed). Now that all fns are known,
    // scan IR_CALL instructions (a0=name, a1=arg count) and verify the call
    // count matches the callee's declared param count.
    let pi2=0
    while pi2<irc {
        if irop(pi2)==17 {
            let cnm=ira0(pi2); let carc=ira1(pi2)
            let cnl=len_name(cnm)
            let cfi=findfn(cnm, cnl)
            if cfi>=0 {
                let cpc = fn_pc(cfi)
                if r64(fn_var + cfi*8)==1 {
                    if carc < cpc { compile_error(2, cnm, cnl) }  // variadic: need >= fixed
                } else {
                    // t5: allow omitting trailing defaulted params.
                    let cmin = r64(fn_pdfixed + cfi*8)
                    if carc != cpc && carc < cmin { compile_error(2, cnm, cnl) }
                }
            }
        }
        pi2=pi2+1
    }

    // If a hard compile error was recorded (e.g. call to an undeclared
    // function), abort the compiler here BEFORE writing any ELF output.
    // Returning N makes the startup stub exit(N); this is the reliable
    // abort path (exit() builtin is unreliable inside the compiler).
    if had_error==1 { return 1 }

    // G1: secure-by-default audit report (stderr, non-intrusive). A CI gate can
    // parse this line; a non-zero count on stdlib/app-core is actionable. The
    // compiler's own source uses zero unsafe (verified), so WIP self-host keeps it 0.
    if unsafe_count > 0 {
        let ua = "note: "
        let ub = " 'unsafe' block(s) parsed (secure-by-default audit)\n"
        file_write(2, ua+8, len(ua))
        // write unsafe_count as decimal to stderr (no itoa builtin available)
        let n = unsafe_count; let buf = mmap(32); let bi = 0
        if n == 0 { w8(buf, 48); bi = 1 }
        else {
            while n > 0 { w8(buf+bi, 48 + (n - (n/10)*10)); bi=bi+1; n=n/10 }
        }
        // digits were stored least-significant-first; write them most-significant-first
        let wi = 0
        while wi < bi { file_write(2, buf + (bi-1-wi), 1); wi = wi+1 }
        file_write(2, ub+8, len(ub))
    }

    // Patch the startup stub's call to __init and main's code offset.
    let mfi=0; let mk=0
    while mk<fnc {
        if fn_nlen(mk)==4 {
            let mnm=fn_name(mk)
            if r8(src+mnm)==109&&r8(src+mnm+1)==97&&r8(src+mnm+2)==105&&r8(src+mnm+3)==110 { mfi=mk }
        }
        mk=mk+1
    }
    g_main_fi = mfi
    // ARM64: object mode -> emit .o with relocations (defer to p5_elf_obj,
    // which emits R_AARCH64_CALL26 relocs + EM_AARCH64). Otherwise patch the
    // startup stub's bl __init / bl main to absolute offsets and emit a
    // whole-program static-PIE ELF.
    if target_arch == 1 {
        if emit_obj == 1 { p5_elf_obj(out_p); exit(0) }
        let init_disp = (g_init_ofs - g_init_call_ofs) >> 2
        w32(code+g_init_call_ofs, 0x94000000 | (init_disp & 0x3FFFFFF))
        let main_disp = (g_main_ofs - g_main_call_ofs) >> 2
        w32(code+g_main_call_ofs, 0x94000000 | (main_disp & 0x3FFFFFF))
        write_elf(out_p)
        exit(0)
    }
    // x86-64: object mode -> emit .o with relocations; else whole-program ELF.
    if emit_obj == 1 {
        p5_elf_obj(out_p)
        exit(0)
    }
    w32(code+init_call+1, r64(func_code_starts+0)-(init_call+5))
    w32(code+stub_call+1, r64(func_code_starts+(mfi+1)*8)-(stub_call+5))
    write_elf(out_p)
    exit(0)
}

// Quick init
fn kregs() {
    return 0
}
