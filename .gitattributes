# Linguist: teach GitHub that .quanta files are the Quanta language.
# This makes CodeRabbit / PR review parse and highlight .quanta source.
*.quanta linguist-language=Quanta
*.quanta linguist-detectable=true

# --- External / dev tooling: keep OUT of the repository language bar ---
# tree-sitter-quanta is an external grammar generator (JS/Python/Shell).
# It is tracked for CI but must NOT appear in the language statistics.
tree-sitter-quanta/** linguist-vendored

# Internal dev tools (Python fuzz / diff harnesses).
tools/** linguist-vendored

# Test-runner shell scripts (dev infra, not the language itself).
test_suites/scripts/** linguist-vendored
